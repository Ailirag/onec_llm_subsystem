
Функция ОпределитьДоступТекущегоПользователя(Агент) Экспорт

	Возврат ОпределитьДоступ(
		ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор,
		Агент);

КонецФункции

Функция ОпределитьДоступ(ИдентификаторПользователя, Агент) Экспорт

	ИсходныйПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ОпределитьДоступВнутренне(ИдентификаторПользователя, Агент);
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
	Возврат Результат;

КонецФункции

Функция ОпределитьДоступВнутренне(ИдентификаторПользователя, Агент)

	Если Не ЗначениеЗаполнено(Агент) Тогда
		Возврат РезультатДоступа(Истина, Справочники.AI_ПрофилиДоступаКДанным.ПустаяСсылка(),
			"Без агента", "");
	КонецЕсли;
	Если ТипЗнч(Агент) <> Тип("СправочникСсылка.AI_Агенты") Тогда
		Возврат РезультатДоступа(Ложь, Справочники.AI_ПрофилиДоступаКДанным.ПустаяСсылка(),
			"", "Передан некорректный агент.");
	КонецЕсли;

	ДанныеАгента = ПолучитьДанныеАгента(Агент);
	Если ДанныеАгента = Неопределено Или ДанныеАгента.ПометкаУдаления Тогда
		Возврат РезультатДоступа(Ложь, Справочники.AI_ПрофилиДоступаКДанным.ПустаяСсылка(),
			"", "Агент не найден или помечен на удаление.");
	КонецЕсли;

	РежимДоступа = ДанныеАгента.РежимДоступа;
	Если РежимДоступа = Перечисления.AI_РежимДоступаАгента.Отключен Тогда
		Возврат РезультатДоступа(Ложь, Справочники.AI_ПрофилиДоступаКДанным.ПустаяСсылка(),
			"", "Доступ к агенту отключен администратором.");
	КонецЕсли;

	Результат = НайтиПерсональноеНазначение(
		Агент,
		ИдентификаторПользователя,
		ДанныеАгента.ПрофильДоступаКДанным);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = НайтиГрупповоеНазначение(
		Агент,
		ИдентификаторПользователя,
		ДанныеАгента.ПрофильДоступаКДанным);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(РежимДоступа)
		Или РежимДоступа = Перечисления.AI_РежимДоступаАгента.ВсемПользователямLLM Тогда
		Возврат РезультатДоступа(
			Истина,
			ДанныеАгента.ПрофильДоступаКДанным,
			"Режим общего доступа",
			"");
	КонецЕсли;

	Возврат РезультатДоступа(
		Ложь,
		Справочники.AI_ПрофилиДоступаКДанным.ПустаяСсылка(),
		"",
		"Агент не назначен текущему пользователю или его группе.");

КонецФункции

Функция ПроверитьДоступТекущегоПользователя(Агент) Экспорт

	Результат = ОпределитьДоступТекущегоПользователя(Агент);
	Если Не Результат.Разрешен Тогда
		ВызватьИсключение Результат.Причина;
	КонецЕсли;
	Возврат Результат.ПрофильДоступаКДанным;

КонецФункции

Функция ПолучитьДоступныхАгентовТекущегоПользователя() Экспорт

	ИдентификаторПользователя =
		ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
	Возврат ПолучитьДоступныхАгентов(ИдентификаторПользователя);

КонецФункции

Функция ПолучитьДоступныхАгентов(ИдентификаторПользователя) Экспорт

	ИсходныйПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ПолучитьДоступныхАгентовВнутренне(ИдентификаторПользователя);
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
	Возврат Результат;

КонецФункции

Функция ПолучитьДоступныхАгентовВнутренне(ИдентификаторПользователя)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|  Агенты.Ссылка КАК Агент,
		|  Агенты.Наименование КАК Наименование
		|ИЗ
		|  Справочник.AI_Агенты КАК Агенты
		|ГДЕ
		|  НЕ Агенты.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|  Наименование";

	Список = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = ОпределитьДоступВнутренне(ИдентификаторПользователя, Выборка.Агент);
		Если Результат.Разрешен Тогда
			Список.Добавить(Выборка.Агент, Выборка.Наименование);
		КонецЕсли;
	КонецЦикла;
	Возврат Список;

КонецФункции

Функция ПолучитьДанныеАгента(Агент)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|  Агенты.ПометкаУдаления КАК ПометкаУдаления,
		|  Агенты.РежимДоступа КАК РежимДоступа,
		|  Агенты.ПрофильДоступаКДанным КАК ПрофильДоступаКДанным
		|ИЗ
		|  Справочник.AI_Агенты КАК Агенты
		|ГДЕ
		|  Агенты.Ссылка = &Агент";
	Запрос.УстановитьПараметр("Агент", Агент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура(
			"ПометкаУдаления,РежимДоступа,ПрофильДоступаКДанным",
			Выборка.ПометкаУдаления,
			Выборка.РежимДоступа,
			Выборка.ПрофильДоступаКДанным);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция НайтиПерсональноеНазначение(Агент, ИдентификаторПользователя, ПрофильАгента)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|  Назначения.ПрофильДоступаКДанным КАК ПрофильДоступаКДанным
		|ИЗ
		|  Справочник.AI_Агенты.ДоступПользователей КАК Назначения
		|ГДЕ
		|  Назначения.Ссылка = &Агент
		|  И Назначения.ИдентификаторПользователя = &ИдентификаторПользователя
		|  И Назначения.Активен";
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.УстановитьПараметр("ИдентификаторПользователя", ИдентификаторПользователя);

	Профиль = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекущийПрофиль = ЭффективныйПрофиль(Выборка.ПрофильДоступаКДанным, ПрофильАгента);
		Если Профиль = Неопределено Тогда
			Профиль = ТекущийПрофиль;
		ИначеЕсли Профиль <> ТекущийПрофиль Тогда
			Возврат РезультатДоступа(
				Ложь,
				Справочники.AI_ПрофилиДоступаКДанным.ПустаяСсылка(),
				"",
				"Найдены противоречащие персональные назначения агента. Обратитесь к администратору.");
		КонецЕсли;
	КонецЦикла;
	Если Профиль <> Неопределено Тогда
		Возврат РезультатДоступа(Истина, Профиль, "Персональное назначение", "");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция НайтиГрупповоеНазначение(Агент, ИдентификаторПользователя, ПрофильАгента)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|  Назначения.Группа КАК Группа,
		|  Назначения.ПрофильДоступаКДанным КАК ПрофильДоступаКДанным,
		|  Назначения.Приоритет КАК Приоритет
		|ИЗ
		|  Справочник.AI_Агенты.ДоступГрупп КАК Назначения
		|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.AI_ГруппыПользователей КАК Группы
		|    ПО Назначения.Группа = Группы.Ссылка
		|    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.AI_ГруппыПользователей.Участники КАК СоставГруппы
		|    ПО Группы.Ссылка = СоставГруппы.Ссылка
		|ГДЕ
		|  Назначения.Ссылка = &Агент
		|  И Назначения.Активна
		|  И Группы.Активна
		|  И СоставГруппы.ИдентификаторПользователя = &ИдентификаторПользователя
		|УПОРЯДОЧИТЬ ПО
		|  Приоритет УБЫВ";
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.УстановитьПараметр("ИдентификаторПользователя", ИдентификаторПользователя);

	МаксимальныйПриоритет = Неопределено;
	Профиль = Неопределено;
	Источники = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если МаксимальныйПриоритет = Неопределено Тогда
			МаксимальныйПриоритет = Выборка.Приоритет;
		ИначеЕсли Выборка.Приоритет < МаксимальныйПриоритет Тогда
			Прервать;
		КонецЕсли;

		ТекущийПрофиль = ЭффективныйПрофиль(Выборка.ПрофильДоступаКДанным, ПрофильАгента);
		Если Профиль = Неопределено Тогда
			Профиль = ТекущийПрофиль;
		ИначеЕсли Профиль <> ТекущийПрофиль Тогда
			Возврат РезультатДоступа(
				Ложь,
				Справочники.AI_ПрофилиДоступаКДанным.ПустаяСсылка(),
				"",
				"Группы с одинаковым приоритетом задают разные профили данных. Обратитесь к администратору.");
		КонецЕсли;
		Источники.Добавить(Строка(Выборка.Группа));
	КонецЦикла;
	Если Профиль <> Неопределено Тогда
		Возврат РезультатДоступа(
			Истина,
			Профиль,
			"Групповое назначение: " + СтрСоединить(Источники, ", "),
			"");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ЭффективныйПрофиль(ПрофильНазначения, ПрофильАгента)

	Если ЗначениеЗаполнено(ПрофильНазначения) Тогда
		Возврат ПрофильНазначения;
	КонецЕсли;
	Возврат ПрофильАгента;

КонецФункции

Функция РезультатДоступа(Разрешен, ПрофильДоступаКДанным, Источник, Причина)

	Возврат Новый Структура(
		"Разрешен,ПрофильДоступаКДанным,Источник,Причина",
		Разрешен,
		ПрофильДоступаКДанным,
		Источник,
		Причина);

КонецФункции
