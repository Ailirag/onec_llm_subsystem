
// Диспетчер выполняется от имени инициатора. Задание регламента обслуживает
// операции своего пользователя; пользовательский опрос обслуживает свою очередь.
Процедура ОбработатьОчередь() Экспорт

	Если ТранзакцияАктивна() Тогда
		Возврат;
	КонецЕсли;
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ВосстановитьПрерванныеОперации();
		ДоставитьОжидающиеРезультаты();
		ОчиститьУстаревшиеДанные();
		AI_НаблюдаемостьОпераций.ОчиститьТекстыОценок();
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 100
			| Операции.ИдентификаторОперации
			|ИЗ РегистрСведений.AI_АгентскиеОперации КАК Операции
			|ГДЕ Операции.Статус = &Очередь
			| И Операции.ИдентификаторПользователя = &Пользователь
			| И Операции.СледующаяПопытка <= &Сейчас
			|УПОРЯДОЧИТЬ ПО Операции.Приоритет УБЫВ, Операции.ДатаСоздания");
		Запрос.УстановитьПараметр("Очередь", Перечисления.AI_СтатусАгентскойОперации.ВОчереди);
		Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
		Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Токен = Захватить(Выборка.ИдентификаторОперации);
			Если Токен = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Аргументы = Новый Массив;
			Аргументы.Добавить(Выборка.ИдентификаторОперации);
			Аргументы.Добавить(Токен);
			Попытка
				Задание = ФоновыеЗадания.Выполнить(
					"AI_АгентскиеОперацииСервер.ВыполнитьОперацию",
					Аргументы, "AI_Операция_" + Строка(Выборка.ИдентификаторОперации),
					"Агентская операция");
				НачатьТранзакцию();
				ЗаблокироватьОчередь();
				Запись = ПрочитатьОперацию(Выборка.ИдентификаторОперации);
				Если Запись.ТокенВыполнения = Токен Тогда
					Запись.ИдентификаторФоновогоЗадания = Задание.УникальныйИдентификатор;
					Запись.Записать();
				КонецЕсли;
				ЗафиксироватьТранзакцию();
			Исключение
				Если ТранзакцияАктивна() Тогда
					ОтменитьТранзакцию();
				КонецЕсли;
				// Запись сохранена. Истекшая незапущенная аренда будет восстановлена.
				ЗаписьЖурналаРегистрации("AI.Диспетчер", УровеньЖурналаРегистрации.Ошибка,
					, , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);

КонецПроцедуры

// Короткая общая блокировка сериализует только распределение слотов.
Процедура ЗаблокироватьОчередь() Экспорт
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.AI_АгентскиеОперации");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция Захватить(ИдентификаторОперации) Экспорт
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь();
		Запись = ПрочитатьОперацию(ИдентификаторОперации);
		Если Не Запись.Выбран()
			Или Запись.Статус <> Перечисления.AI_СтатусАгентскойОперации.ВОчереди
			Или Запись.ОтменаЗапрошена
			Или Запись.СледующаяПопытка > ТекущаяДатаСеанса()
			Или Запись.ИдентификаторПользователя <> ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор Тогда
			ЗафиксироватьТранзакцию();
			Возврат Неопределено;
		КонецЕсли;
		ЛимитВсего = Константы.AI_КоличествоПотоковОбработкиОчереди.Получить();
		Если ЛимитВсего <= 0 Тогда
			ЛимитВсего = 4;
		КонецЕсли;
		ЛимитПровайдера = Запись.Провайдер.МаксКоличествоПотоков;
		Если ЛимитПровайдера <= 0 Тогда
			ЛимитПровайдера = 1;
		КонецЕсли;
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего,
			| ЕСТЬNULL(СУММА(ВЫБОР КОГДА О.Провайдер = &Провайдер ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Провайдер
			|ИЗ РегистрСведений.AI_АгентскиеОперации КАК О
			|ГДЕ О.Статус В (&Выполняется, &Отмена)");
		Запрос.УстановитьПараметр("Провайдер", Запись.Провайдер);
		Запрос.УстановитьПараметр("Выполняется", Перечисления.AI_СтатусАгентскойОперации.Выполняется);
		Запрос.УстановитьПараметр("Отмена", Перечисления.AI_СтатусАгентскойОперации.ОтменаЗапрошена);
		Слоты = Запрос.Выполнить().Выбрать();
		Слоты.Следующий();
		Если Слоты.Всего >= ЛимитВсего Или Слоты.Провайдер >= ЛимитПровайдера Тогда
			ЗафиксироватьТранзакцию();
			Возврат Неопределено;
		КонецЕсли;
		Токен = Новый УникальныйИдентификатор;
		Запись.ТокенВыполнения = Токен;
		Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.Выполняется;
		Запись.ТекущийЭтап = "Ожидание запуска обработчика";
		Запись.НачалоПопытки = Дата(1, 1, 1);
		Запись.АрендаДо = ТекущаяДатаСеанса() + 120;
		Запись.ИдентификаторФоновогоЗадания = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Версия = Запись.Версия + 1;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Токен;
КонецФункции

Функция НачатьПопытку(ИдентификаторОперации, Токен) Экспорт
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь();
		Запись = ПрочитатьОперацию(ИдентификаторОперации);
		Допустима = Запись.Выбран()
			И Запись.ТокенВыполнения = Токен
			И Не ЗначениеЗаполнено(Запись.НачалоПопытки)
			И Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.Выполняется
			И Запись.ИдентификаторПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
		Если Допустима Тогда
			Запись.НачалоПопытки = ТекущаяДатаСеанса();
			Если Не ЗначениеЗаполнено(Запись.ДатаПервогоЗапуска) Тогда
				Запись.ДатаПервогоЗапуска = Запись.НачалоПопытки;
			КонецЕсли;
			Запись.КоличествоПопыток = Запись.КоличествоПопыток + 1;
			Запись.АрендаДо = ТекущаяДатаСеанса() + 3600;
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Допустима;
КонецФункции

Процедура ВосстановитьПрерванныеОперации()
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 100 О.ИдентификаторОперации
		|ИЗ РегистрСведений.AI_АгентскиеОперации КАК О
		|ГДЕ О.Статус В (&Выполняется, &Отмена)
		| И О.АрендаДо < &Сейчас И О.ИдентификаторПользователя = &Пользователь");
	Запрос.УстановитьПараметр("Выполняется", Перечисления.AI_СтатусАгентскойОперации.Выполняется);
	Запрос.УстановитьПараметр("Отмена", Перечисления.AI_СтатусАгентскойОперации.ОтменаЗапрошена);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьОчередь();
			Запись = ПрочитатьОперацию(Выборка.ИдентификаторОперации);
			Если Не Запись.Выбран() Или Запись.АрендаДо >= ТекущаяДатаСеанса()
				Или (Запись.Статус <> Перечисления.AI_СтатусАгентскойОперации.Выполняется
				И Запись.Статус <> Перечисления.AI_СтатусАгентскойОперации.ОтменаЗапрошена) Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			Задание = Неопределено;
			Если ЗначениеЗаполнено(Запись.ИдентификаторФоновогоЗадания) Тогда
				Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Запись.ИдентификаторФоновогоЗадания);
			КонецЕсли;
			Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			Если Запись.ОтменаЗапрошена Тогда
				Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.Отменена;
				Запись.ТекущийЭтап = "Операция отменена";
				Запись.ДатаЗавершения = ТекущаяДатаСеанса();
			ИначеЕсли Не ЗначениеЗаполнено(Запись.НачалоПопытки) Тогда
				Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.ВОчереди;
				Запись.ТекущийЭтап = "Повтор запуска обработчика";
			Иначе
				Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.Ошибка;
				Запись.ТекстОшибки = "Обработчик прерван. Результат внешних действий неизвестен; автоматический повтор запрещен.";
				Запись.ТекущийЭтап = "Обработчик прерван";
				Запись.ДатаЗавершения = ТекущаяДатаСеанса();
			КонецЕсли;
			Запись.ТокенВыполнения = Новый УникальныйИдентификатор;
			Запись.ДатаИзменения = ТекущаяДатаСеанса();
			Запись.Версия = Запись.Версия + 1;
			Запись.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция ПрочитатьОперацию(ИдентификаторОперации)
	Запись = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторОперации = ИдентификаторОперации;
	Запись.Прочитать();
	Возврат Запись;
КонецФункции

// Сохраняем tombstone и идемпотентный ключ. Вложения имеют отдельную политику хранения.
Процедура ОчиститьУстаревшиеДанные()
	Дней = Константы.AI_СрокХраненияОперацийДней.Получить();
	Если Дней <= 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 100 О.ИдентификаторОперации
		|ИЗ РегистрСведений.AI_АгентскиеОперации КАК О
		|ГДЕ О.КодСценария <> """" И НЕ О.ДанныеОчищены
		| И О.СтатусДоставки <> ""Ожидает""
		| И О.ИдентификаторПользователя = &Пользователь
		| И О.ДатаЗавершения > &ПустаяДата И О.ДатаЗавершения < &Граница
		| И О.Статус В (&Завершена, &Ошибка, &Отменена)");
	Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - Дней * 86400);
	Запрос.УстановитьПараметр("Завершена", Перечисления.AI_СтатусАгентскойОперации.Завершена);
	Запрос.УстановитьПараметр("Ошибка", Перечисления.AI_СтатусАгентскойОперации.Ошибка);
	Запрос.УстановитьПараметр("Отменена", Перечисления.AI_СтатусАгентскойОперации.Отменена);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьОчередь();
			Запись = ПрочитатьОперацию(Выборка.ИдентификаторОперации);
			Запись.Промт = "";
			Запись.СистемныйПромт = "";
			Запись.ДанныеКонтекста = "";
			Запись.КонтекстJSON = "";
			Запись.СхемаОтветаJSON = "";
			Запись.ОшибкаДоставки = "";
			Запись.Результат = "";
			Запись.ТекстОшибки = "";
			Запись.КлючИсточника = "";
			Запись.ПредставлениеИсточника = "";
			Запись.Источник = Неопределено;
			Запись.ДанныеОчищены = Истина;
			Запись.Версия = Запись.Версия + 1;
			Запись.ДатаИзменения = ТекущаяДатаСеанса();
			Запись.Записать();
			Шаги = РегистрыСведений.AI_ШагиАгентскихОпераций.СоздатьНаборЗаписей();
			Шаги.Отбор.ИдентификаторОперации.Установить(Выборка.ИдентификаторОперации);
			Шаги.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура ДоставитьОжидающиеРезультаты()
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 100 ИдентификаторОперации
		|ИЗ РегистрСведений.AI_АгентскиеОперации
		|ГДЕ СтатусДоставки = ""Ожидает"" И ИдентификаторПользователя = &Пользователь");
	Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Аргументы = Новый Массив;
		Аргументы.Добавить(Выборка.ИдентификаторОперации);
		Попытка
			ФоновыеЗадания.Выполнить("AI_КонтрактыОпераций.ДоставитьРезультат", Аргументы,
				"AI_Доставка_" + Строка(Выборка.ИдентификаторОперации), "Доставка результата агента");
		Исключение
			ЗаписьЖурналаРегистрации("AI.Доставка", УровеньЖурналаРегистрации.Предупреждение,
				, , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры
