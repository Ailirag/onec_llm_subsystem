#Область ОбработчикиКомандФормы

// Мастер открывается на объекте текущей строки: новое действие чаще всего
// заводят рядом с уже настроенными.
&НаКлиенте
Процедура НовоеДействиеОбработка(Команда)

	ПараметрыФормы = Новый Структура;
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено
		И ТекущиеДанные.ТипМеста <> "Глобально"
		И ЗначениеЗаполнено(ТекущиеДанные.ПолноеИмяМетаданных)
		И ТекущиеДанные.ПолноеИмяМетаданных <> "*" Тогда
		ПараметрыФормы.Вставить("ПолноеИмяМетаданных", ТекущиеДанные.ПолноеИмяМетаданных);
	КонецЕсли;
	ОткрытьФорму("Обработка.AI_НовоеДействие.Форма", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти
