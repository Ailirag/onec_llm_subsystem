			Политика);
		Проверить(Не Проверка.ok, "Запрос ограниченного поля ИНН должен быть отклонен.");

		НекорректныйЗапрос =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДЛИНА(Контрагенты.Наименование) КАК Длина
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты";
		Проверка = AI_БезопасныеЗапросы.ПроверитьЗапрос(
			НекорректныйЗапрос,
			Параметры,
			Политика);
		Проверить(Не Проверка.ok, "Синтаксически некорректный запрос должен быть отклонен.");

		Подсчет = AI_БезопасныеЗапросы.ПосчитатьЗаписиСправочников(
			Объекты,
			10,
			Истина,
			Политика);
		Проверить(Подсчет.ok И Подсчет.leader.count = 37,
			"Подсчет записей справочника должен вернуть 37.");
		ДобавитьРезультат(
			Результаты,
			"metadata_and_queries",
			Истина,
			"Метаданные, whitelist, restricted field, validate, execute и count работают.");
	Исключение
		ДобавитьОшибкуТеста(Результаты, "metadata_and_queries");
