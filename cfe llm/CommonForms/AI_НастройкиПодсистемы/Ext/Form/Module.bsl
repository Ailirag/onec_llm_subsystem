#Область ОбработчикиСобытийЭлементовШапкиФормы

// Адаптер выбирается из реестра дополнительных обработок: имя, набранное с
// опечаткой, молча оставило бы ядро без знания о типах конфигурации.
// Обработку самой конфигурации указывают вручную: «Обработка.<Имя>».
&НаКлиенте
Процедура АдаптерКонфигурацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Варианты = ЗарегистрированныеОбработкиНаСервере();
	Если Варианты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "В реестре дополнительных отчетов и обработок нет обработок."
			+ " Зарегистрируйте адаптер или укажите обработку конфигурации как «Обработка.<Имя>».");
		Возврат;
	КонецЕсли;
	Варианты.ПоказатьВыборЭлемента(
		Новый ОписаниеОповещения("ВыборАдаптераЗавершение", ЭтотОбъект),
		"Выберите адаптер конфигурации",
		Варианты.НайтиПоЗначению(НаборКонстант.AI_АдаптерКонфигурации));

КонецПроцедуры

&НаКлиенте
Процедура ВыборАдаптераЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НаборКонстант.AI_АдаптерКонфигурации = ВыбранныйЭлемент.Значение;
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ЗарегистрированныеОбработкиНаСервере()

	Возврат AI_ИнтерфейсныеСценарии.ЗарегистрированныеОбработки();

КонецФункции

#КонецОбласти
