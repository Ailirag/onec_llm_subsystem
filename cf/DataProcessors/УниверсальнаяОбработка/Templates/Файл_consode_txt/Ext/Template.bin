{"S","Формирование документа полученного на основании рс"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,85996431-f524-4abe-81b9-e994cd14360f},
{"B",0},
{"S","// Знак вопроса перед символом говорит о его не обязательности
// допустимый символы указывается в [], если допустимым может быть какой то символ из последовательности
// тогда указываем список всех возможных без разделителей. Например: ""[./\]""
// \s - означает пробел
// Количество символов указывается в {минимум раз, максимум раз}

RegExp = Новый COMОбъект(""VBScript.RegExp"");
RegExp.Global = Истина;
RegExp.Pattern = ""[№]\s{0,15}?[0-9]+\s{0,15}?[о]?[т]?\s{0,15}[0-9]{2}[./\]{1}[0-9]{2}[./\]{1}[0-9]{2,4}"";


Текст = ""Комисс.за перев.ср.по заявл.на вал.пер. № 2707 от 01.06.20 (1200601/2032899) 130445.70 USD VO80150"";

Finded = RegExp.Execute(Текст);
Сообщить(Finded.Count);

Если Finded.Count > 0 Тогда
	Сообщить(Finded.item(0).value);
КонецЕсли;	"},0}
}
