{"S","//e1cib/data/Документ.ОперацияНМЦ?ref=a971001a64a3730c11e72fcc4a03b83c

Ссылка1 = СсылкаПоНавигации(""e1cib/data/Документ.ОперацияНМЦ?ref=a971001a64a3730c11e72fcc4a03b83c"");

