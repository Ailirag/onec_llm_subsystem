
Функция ЗаписатьОценку(ИдентификаторОперации, Решение, Комментарий = "", ИсправленныйОтвет = "", ИдентификаторОценки = Неопределено) Экспорт
	Если Решение <> "Принято" И Решение <> "Отклонено" И Решение <> "Исправлено" Тогда
		ВызватьИсключение "Решение должно быть: Принято, Отклонено или Исправлено.";
	КонецЕсли;
	Если ТипЗнч(Комментарий) <> Тип("Строка") Или ТипЗнч(ИсправленныйОтвет) <> Тип("Строка") Тогда
		ВызватьИсключение "Комментарий и исправленный ответ должны быть строками.";
	КонецЕсли;
	Если СтрДлина(Комментарий) > 10000 Или СтрДлина(ИсправленныйОтвет) > 1000000 Тогда
		ВызватьИсключение "Превышен размер обратной связи.";
	КонецЕсли;
	Если Решение = "Исправлено" И Не ЗначениеЗаполнено(ИсправленныйОтвет) Тогда
		ВызватьИсключение "Укажите исправленный ответ.";
	КонецЕсли;
	Если ИдентификаторОценки = Неопределено Тогда
		ИдентификаторОценки = Новый УникальныйИдентификатор;
	КонецЕсли;
	Если ТипЗнч(ИдентификаторОценки) <> Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение "Идентификатор оценки должен быть UUID.";
	КонецЕсли;
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		AI_ДиспетчерОпераций.ЗаблокироватьОчередь();
		Операция = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
		Операция.ИдентификаторОперации = ИдентификаторОперации;
		Операция.Прочитать();
		Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
		Если Не Операция.Выбран() Или Операция.ИдентификаторПользователя <> Пользователь Тогда
			ВызватьИсключение "Операция недоступна текущему пользователю.";
		КонецЕсли;
		Если Операция.Статус <> Перечисления.AI_СтатусАгентскойОперации.Завершена Или Операция.ДанныеОчищены Тогда
			ВызватьИсключение "Оценить можно только сохраненный успешный результат.";
		КонецЕсли;
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.AI_ОценкиРезультатов");
		Элемент.УстановитьЗначение("ИдентификаторОценки", ИдентификаторОценки);
		Блокировка.Заблокировать();
		Оценка = РегистрыСведений.AI_ОценкиРезультатов.СоздатьМенеджерЗаписи();
		Оценка.ИдентификаторОценки = ИдентификаторОценки;
		Оценка.Прочитать();
		Если Оценка.Выбран() Тогда
			Если Оценка.ИдентификаторПользователя <> Пользователь Или Оценка.ИдентификаторОперации <> ИдентификаторОперации
				Или Оценка.Решение <> Решение Или Оценка.Комментарий <> Комментарий Или Оценка.ИсправленныйОтвет <> ИсправленныйОтвет Тогда
				ВызватьИсключение "Идентификатор оценки уже использован для других данных.";
			КонецЕсли;
		Иначе
			Оценка.ИдентификаторОценки = ИдентификаторОценки;
			Оценка.ИдентификаторОперации = ИдентификаторОперации;
			Оценка.ИдентификаторПользователя = Пользователь;
			Оценка.ДатаОценки = ТекущаяДатаСеанса();
			Оценка.Решение = Решение;
			Оценка.Комментарий = Комментарий;
			Оценка.ИсправленныйОтвет = ИсправленныйОтвет;
			Оценка.ОтветМодели = Операция.Результат;
			Оценка.КодСценария = Операция.КодСценария;
			Оценка.ВерсияКонтракта = Операция.ВерсияКонтракта;
			Оценка.Агент = Операция.Агент;
			Оценка.Модель = Операция.Модель;
			Оценка.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат ИдентификаторОценки;
КонецФункции

Функция ПолучитьСтатистику() Экспорт
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Статус, КОЛИЧЕСТВО(*) КАК Количество,
			| СУММА(ВходящиеТокены + ВходящиеТокеныВложений) КАК ВходящиеТокены,
			| СУММА(ВыходящиеТокены + ВыходящиеТокеныВложений) КАК ВыходящиеТокены,
			| СУММА(ВЫБОР КОГДА СтатусДоставки = ""Ошибка"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК ОшибокДоставки,
			| ЕСТЬNULL(СРЕДНЕЕ(ВЫБОР КОГДА ДатаПервогоЗапуска > &ПустаяДата
			| ТОГДА РАЗНОСТЬДАТ(ДатаСоздания, ДатаПервогоЗапуска, СЕКУНДА) ИНАЧЕ NULL КОНЕЦ), 0) КАК ОжиданиеСекунд
			|ИЗ РегистрСведений.AI_АгентскиеОперации
			|ГДЕ ИдентификаторПользователя = &Пользователь
			|СГРУППИРОВАТЬ ПО Статус");
		Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
		Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
		Выборка = Запрос.Выполнить().Выбрать();
		Результат = Новый Массив;
		Пока Выборка.Следующий() Цикл
			СтрокаСтатистики = Новый Структура("Статус,Количество,ВходящиеТокены,ВыходящиеТокены,ОшибокДоставки,ОжиданиеСекунд");
			ЗаполнитьЗначенияСвойств(СтрокаСтатистики, Выборка);
			Результат.Добавить(СтрокаСтатистики);
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Результат;
КонецФункции

Процедура ОчиститьТекстыОценок() Экспорт
	Дней = Константы.AI_СрокХраненияОценокДней.Получить();
	Если Дней <= 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 100 ИдентификаторОценки
		|ИЗ РегистрСведений.AI_ОценкиРезультатов
		|ГДЕ ИдентификаторПользователя = &Пользователь И НЕ ДанныеОчищены И ДатаОценки < &Граница");
	Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - Дней * 86400);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить("РегистрСведений.AI_ОценкиРезультатов");
			Элемент.УстановитьЗначение("ИдентификаторОценки", Выборка.ИдентификаторОценки);
			Блокировка.Заблокировать();
			Запись = РегистрыСведений.AI_ОценкиРезультатов.СоздатьМенеджерЗаписи();
			Запись.ИдентификаторОценки = Выборка.ИдентификаторОценки;
			Запись.Прочитать();
			Запись.Комментарий = "";
			Запись.ОтветМодели = "";
			Запись.ИсправленныйОтвет = "";
			Запись.ДанныеОчищены = Истина;
			Запись.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьОшибкиДоставки() Экспорт
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 100 ИдентификаторОперации, КодСценария, ОшибкаДоставки, ДатаЗавершения
			|ИЗ РегистрСведений.AI_АгентскиеОперации
			|ГДЕ ИдентификаторПользователя = &Пользователь И СтатусДоставки = ""Ошибка""
			|УПОРЯДОЧИТЬ ПО ДатаЗавершения УБЫВ");
		Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
		Выборка = Запрос.Выполнить().Выбрать();
		Результат = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ОшибкаДоставки = Новый Структура("ИдентификаторОперации,КодСценария,ОшибкаДоставки,ДатаЗавершения");
			ЗаполнитьЗначенияСвойств(ОшибкаДоставки, Выборка);
			Результат.Добавить(ОшибкаДоставки);
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Результат;
КонецФункции

// Последние операции пользователя. Кроме статуса и токенов — по какому объекту
// шла операция, сколько файлов ушло модели и сколько она длилась: без этого
// пачка, ушедшая без файлов, выглядела в мониторе двумя успешными операциями.
Функция ПолучитьПоследниеОперации() Экспорт
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 100
			|	Операции.ИдентификаторОперации КАК ИдентификаторОперации,
			|	Операции.ДатаСоздания КАК ДатаСоздания,
			|	Операции.ДатаЗавершения КАК ДатаЗавершения,
			|	Операции.КодСценария КАК КодСценария,
			|	ЕСТЬNULL(Сценарии.Наименование, Операции.КодСценария) КАК Сценарий,
			|	Операции.ПредставлениеИсточника КАК Объект,
			|	Операции.Статус КАК Статус,
			|	Операции.Результат КАК Результат,
			|	Операции.ТекстОшибки КАК ТекстОшибки,
			|	Операции.СтатусДоставки КАК СтатусДоставки,
			|	Операции.ОшибкаДоставки КАК ОшибкаДоставки,
			|	Операции.КоличествоВложений КАК Вложений,
			|	ВЫБОР
			|		КОГДА Операции.ДатаЗавершения > ДАТАВРЕМЯ(1, 1, 1)
			|			ТОГДА РАЗНОСТЬДАТ(Операции.ДатаСоздания, Операции.ДатаЗавершения, СЕКУНДА)
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ДлительностьСекунд,
			|	Операции.ВходящиеТокены + Операции.ВходящиеТокеныВложений КАК ВходящиеТокены,
			|	Операции.ВыходящиеТокены + Операции.ВыходящиеТокеныВложений КАК ВыходящиеТокены
			|ИЗ
			|	РегистрСведений.AI_АгентскиеОперации КАК Операции
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.AI_Сценарии КАК Сценарии
			|		ПО Сценарии.Код = Операции.КодСценария
			|			И НЕ Сценарии.ПометкаУдаления
			|ГДЕ
			|	Операции.ИдентификаторПользователя = &Пользователь
			|	И Операции.КодСценария <> """"
			|УПОРЯДОЧИТЬ ПО
			|	Операции.ДатаСоздания УБЫВ");
		Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
		Результат = Запрос.Выполнить().Выгрузить();
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Результат;
КонецФункции

// Все, что известно об одной операции: запрос и контекст, файлы с итогом их
// анализа, ответ, ошибка, токены и шаги агента. По этой карточке разбирают
// «модель ответила пусто»: ушел ли файл, что из него прочитано, что вернулось.
//
// Чужую операцию видит только администратор. Возвращает Неопределено, если
// операции нет или смотреть ее нельзя.
Функция ПолучитьОписаниеОперации(ИдентификаторОперации) Экспорт

	Администратор = ПравоДоступа("Администрирование", Метаданные);
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;

	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ОписаниеОперации(ИдентификаторОперации, ТекущийПользователь, Администратор);
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Результат;

КонецФункции

Функция ОписаниеОперации(ИдентификаторОперации, ТекущийПользователь, Администратор)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Операции.ИдентификаторПользователя КАК ИдентификаторПользователя,
		|	Операции.ИдентификаторДиалога КАК ИдентификаторДиалога,
		|	Операции.ДатаСоздания КАК ДатаСоздания,
		|	Операции.ДатаЗавершения КАК ДатаЗавершения,
		|	ПРЕДСТАВЛЕНИЕ(Операции.Статус) КАК Статус,
		|	Операции.ТекущийЭтап КАК ТекущийЭтап,
		|	Операции.КодСценария КАК КодСценария,
		|	ЕСТЬNULL(Сценарии.Наименование, """") КАК Сценарий,
		|	ПРЕДСТАВЛЕНИЕ(Операции.Провайдер) КАК Провайдер,
		|	ПРЕДСТАВЛЕНИЕ(Операции.Модель) КАК Модель,
		|	ПРЕДСТАВЛЕНИЕ(Операции.Агент) КАК Агент,
		|	Операции.ПредставлениеИсточника КАК Объект,
		|	Операции.Промт КАК Промт,
		|	Операции.ДанныеКонтекста КАК ДанныеКонтекста,
		|	Операции.Результат КАК Результат,
		|	Операции.ТекстОшибки КАК ТекстОшибки,
		|	Операции.ВходящиеТокены КАК ВходящиеТокены,
		|	Операции.ВыходящиеТокены КАК ВыходящиеТокены,
		|	Операции.ВходящиеТокеныВложений КАК ВходящиеТокеныВложений,
		|	Операции.ВыходящиеТокеныВложений КАК ВыходящиеТокеныВложений,
		|	Операции.КоличествоВложений КАК КоличествоВложений,
		|	Операции.КоличествоПопыток КАК КоличествоПопыток,
		|	Операции.СтатусДоставки КАК СтатусДоставки,
		|	Операции.ОшибкаДоставки КАК ОшибкаДоставки,
		|	Операции.ДанныеОчищены КАК ДанныеОчищены
		|ИЗ
		|	РегистрСведений.AI_АгентскиеОперации КАК Операции
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.AI_Сценарии КАК Сценарии
		|		ПО Сценарии.Код = Операции.КодСценария
		|			И НЕ Сценарии.ПометкаУдаления
		|ГДЕ
		|	Операции.ИдентификаторОперации = &ИдентификаторОперации
		|;
		|ВЫБРАТЬ
		|	Вложения.ПорядковыйНомер КАК Номер,
		|	Вложения.Вложение.ИмяФайла КАК ИмяФайла,
		|	Вложения.Вложение.РазмерБайт КАК РазмерБайт,
		|	ПРЕДСТАВЛЕНИЕ(Вложения.Вложение.Статус) КАК Статус,
		|	Вложения.Вложение.МодельАнализа КАК МодельАнализа,
		|	Вложения.Вложение.РезультатАнализа КАК РезультатАнализа,
		|	Вложения.Вложение.ТекстОшибки КАК ТекстОшибки,
		|	Вложения.Вложение.ВходящиеТокены + Вложения.Вложение.ВыходящиеТокены КАК Токены
		|ИЗ
		|	РегистрСведений.AI_ВложенияАгентскихОпераций КАК Вложения
		|ГДЕ
		|	Вложения.ИдентификаторОперации = &ИдентификаторОперации
		|УПОРЯДОЧИТЬ ПО
		|	Номер
		|;
		|ВЫБРАТЬ
		|	Шаги.НомерШага КАК Номер,
		|	Шаги.Инструмент КАК Инструмент,
		|	Шаги.Статус КАК Статус,
		|	Шаги.ДлительностьМс КАК ДлительностьМс,
		|	Шаги.Аргументы КАК Аргументы,
		|	Шаги.Результат КАК Результат
		|ИЗ
		|	РегистрСведений.AI_ШагиАгентскихОпераций КАК Шаги
		|ГДЕ
		|	Шаги.ИдентификаторОперации = &ИдентификаторОперации
		|УПОРЯДОЧИТЬ ПО
		|	Шаги.ПорядковыйНомер");
	Запрос.УстановитьПараметр("ИдентификаторОперации", ИдентификаторОперации);
	Пакет = Запрос.ВыполнитьПакет();

	Выборка = Пакет[0].Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Выборка.ИдентификаторПользователя <> ТекущийПользователь И Не Администратор Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура(
		"ИдентификаторДиалога,ДатаСоздания,ДатаЗавершения,Статус,ТекущийЭтап,КодСценария,Сценарий,"
			+ "Провайдер,Модель,Агент,Объект,Промт,ДанныеКонтекста,Результат,ТекстОшибки,"
			+ "ВходящиеТокены,ВыходящиеТокены,ВходящиеТокеныВложений,ВыходящиеТокеныВложений,"
			+ "КоличествоВложений,КоличествоПопыток,СтатусДоставки,ОшибкаДоставки,ДанныеОчищены");
	ЗаполнитьЗначенияСвойств(Описание, Выборка);
	Описание.Вставить("Вложения", ТаблицаВМассив(Пакет[1].Выгрузить()));
	Описание.Вставить("Шаги", ТаблицаВМассив(Пакет[2].Выгрузить()));
	Возврат Описание;

КонецФункции

Функция ТаблицаВМассив(Таблица)

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Элемент = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Элемент.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
		КонецЦикла;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции
