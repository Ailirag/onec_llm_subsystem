
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ЗначениеЗаполнено(Объект.РежимДоступа) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.РежимДоступа = Перечисления.AI_РежимДоступаАгента.ВсемПользователямLLM;
	Иначе
		Объект.РежимДоступа = Перечисления.AI_РежимДоступаАгента.ПоНазначениям;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НуженВебПоискПриИзмененииНаСервере()

КонецПроцедуры

&НаКлиенте
Процедура НуженВебПоискПриИзменении(Элемент)
	НуженВебПоискПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПользователя(Команда)

	СписокПользователей = AI_ДоступКАгентамКлиентСервер.ПолучитьПользователейИнформационнойБазы();
	Если СписокПользователей.Количество() = 0 Тогда
		Сообщить("В информационной базе нет доступных для выбора пользователей.");
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения(
		"ДобавитьПользователяЗавершение",
		ЭтотОбъект);
	ПоказатьВыборИзСписка(
		Оповещение,
		СписокПользователей,
		Элементы.ДоступПользователей);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПользователяЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДанныеПользователя = ВыбранноеЗначение.Значение;
	Для Каждого Назначение Из Объект.ДоступПользователей Цикл
		Если Назначение.ИдентификаторПользователя = ДанныеПользователя.ИдентификаторПользователя Тогда
			Сообщить("Этот пользователь уже добавлен в назначения агента.");
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Назначение = Объект.ДоступПользователей.Добавить();
	Назначение.ИдентификаторПользователя = ДанныеПользователя.ИдентификаторПользователя;
	Назначение.Имя = ДанныеПользователя.Имя;
	Назначение.ПолноеИмя = ДанныеПользователя.ПолноеИмя;
	Назначение.Активен = Истина;

КонецПроцедуры
