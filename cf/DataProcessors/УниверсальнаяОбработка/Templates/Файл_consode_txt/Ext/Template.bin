|	ВТ_ЦелевыеДокументыПР.ДатаБУ
|ИТОГИ ПО
|	Период"";

Субаренда = сн(""e1cib/data/Справочник.ТипыТМЦ?ref=b43e00093d12899d11daa6c58749ba44"");
РазмещениеРИМ = сн(""e1cib/data/Справочник.ТипыТМЦ?ref=b32c001a64a36af011ddd30ea0253ece"");
ПредоставлениеВАрендуПомещения = сн(""e1cib/data/Справочник.ТипыТМЦ?ref=b1cf5ef3fce04e3f11e5ffd83e9a3b1b"");

Запрос.УстановитьПараметр(""Субаренда"", Субаренда);
Запрос.УстановитьПараметр(""РазмещениеРИМ"", РазмещениеРИМ);
Запрос.УстановитьПараметр(""ПредоставлениеВАрендуПомещения"", ПредоставлениеВАрендуПомещения); 
Запрос.УстановитьПараметр(""НачалоПериода"", ДАТА(1,1,2017));
Запрос.УстановитьПараметр(""КонецПериода"", КонецДня(ДАТА(31,12,2017)));

РезультатЗапроса = Запрос.ВыполнитьПакет();
Сторно = РезультатЗапроса[РезультатЗапроса.Количество-2].Выбрать();

Сообщить(Сторно.Количество());"},0}
}
