// ============================================================
// ОБРАБОТКА: AI_RAG_ТестовыеДанные
// Назначение: создать тестовых контрагентов, запустить
// полный цикл RAG и проверить результат поиска.
//
// Порядок работы:
//   1. Кнопка "Создать контрагентов" — создаёт 10 тестовых
//      контрагентов с разными отраслями в справочнике
//   2. Кнопка "Запустить векторизацию" — вызывает оба РЗ:
//      AI_ОбработкаОчередиПодготовкиКВекторизации
//      AI_ОбработкаОчередиВекторизации
//   3. Кнопка "Проверить поиск" — выполняет тестовые
//      запросы через AI_RAG.ПоискПохожихВQdrant и
//      выводит результаты в табличное поле
//   4. Кнопка "Очистить тестовые данные" — помечает
//      созданных контрагентов на удаление
//
// Форма содержит:
//   Реквизиты: КомпонентRAG (СправочникСсылка.AI_RAG),
//              Коллекция (СправочникСсылка.AI_RAGКоллекции),
//              ТестовыйЗапрос (Строка),
//              Результаты (ТаблицаЗначений)
// ============================================================

// ============================================================
// МОДУЛЬ ОБЪЕКТА ОБРАБОТКИ (ObjectModule)
// ============================================================

#Область ПрограммныйИнтерфейс

// СоздатьТестовыхКонтрагентов
// Создаёт 10 контрагентов с разными отраслями.
// Каждый сразу попадает в подписку AI_RAG_ПередЗаписью
// → AI_ОчередьПодготовкиКВекторизации.
//
// Возвращаемое значение:
//   Массив - созданные ссылки Справочник.Контрагенты
Функция СоздатьТестовыхКонтрагентов() Экспорт

	ТестовыеДанные = ПолучитьТестовыеДанные();
	СозданныеСсылки = Новый Массив;

	Для Каждого Данные Из ТестовыеДанные Цикл

		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();

		НовыйКонтрагент.Наименование              = Данные.Наименование;
		НовыйКонтрагент.ИНН                       = Данные.ИНН;
		НовыйКонтрагент.КПП                       = Данные.КПП;
		НовыйКонтрагент.ОГРН                      = Данные.ОГРН;
		НовыйКонтрагент.Адрес                     = Данные.Адрес;
		НовыйКонтрагент.ОбластьДеятельностьКомпании = Данные.ОбластьДеятельности;

		// Добавляем префикс чтобы легко найти и удалить тестовые данные
		НовыйКонтрагент.Комментарий = "[AI_RAG_ТЕСТ]";

		НовыйКонтрагент.Записать();
		СозданныеСсылки.Добавить(НовыйКонтрагент.Ссылка);

	КонецЦикла;

	Возврат СозданныеСсылки;

КонецФункции

// ЗапуститьВекторизацию
// Последовательно выполняет оба шага пайплайна:
//   1. Подготовка — раскладывает объекты по чанкам в AI_ОчередьВекторизации
//   2. Векторизация — отправляет в Qdrant
Процедура ЗапуститьВекторизацию() Экспорт

	// Шаг 1: подготовка объектов к векторизации
	AI_RAG.AI_ОбработкаОчередиПодготовкиКВекторизации();

	// Шаг 2: получение векторов и запись в Qdrant
	AI_RAG.AI_ОбработкаОчередиВекторизации();

КонецПроцедуры

// ВыполнитьТестовыйПоиск
// Отправляет запрос через весь стек RAG и возвращает таблицу результатов.
//
// Параметры:
//   КомпонентRAG - Структура - данные компонента (из AI_RAG)
//   ИмяКоллекции - Строка
//   ТекстЗапроса - Строка
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: Score, Заголовок, Текст, Источник
Функция ВыполнитьТестовыйПоиск(КомпонентRAG, ИмяКоллекции, ТекстЗапроса) Экспорт

	Результаты = НоваяТаблицаРезультатов();

	// Получаем вектор запроса
	ВекторЗапроса = AI_RAG.ПолучитьВектор(КомпонентRAG, ТекстЗапроса);

	// Ищем похожие фрагменты
	Фрагменты = AI_RAG.ПоискПохожихВQdrant(
		КомпонентRAG,
		ИмяКоллекции,
		ВекторЗапроса,
		10,            // лимит
		0.3,           // низкий порог для тестирования
		Неопределено); // без фильтра по правам — тестовый поиск

	Для Каждого Точка Из Фрагменты Цикл

		Payload = Точка["payload"];
		Если Не ЗначениеЗаполнено(Payload) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результаты.Добавить();
		НоваяСтрока.Score     = Точка["score"];
		НоваяСтрока.Заголовок = ?(Payload.Свойство("header"),  Payload["header"],  "");
		НоваяСтрока.Текст     = ?(Payload.Свойство("text"),    Payload["text"],    "");
		НоваяСтрока.НавСсылка = ?(Payload.Свойство("nav_ref"), Payload["nav_ref"], "");

	КонецЦикла;

	// Сортируем по убыванию score
	Результаты.Сортировать("Score Убыв");

	Возврат Результаты;

КонецФункции

// ОчиститьТестовыеДанные
// Помечает на удаление всех контрагентов с Комментарий = "[AI_RAG_ТЕСТ]"
//
// Возвращаемое значение:
//   Число - количество помеченных элементов
Функция ОчиститьТестовыеДанные() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Комментарий = &Метка
		|	И НЕ Контрагенты.ПометкаУдаления";

	Запрос.УстановитьПараметр("Метка", "[AI_RAG_ТЕСТ]");
	Выборка = Запрос.Выполнить().Выбрать();

	Счётчик = 0;

	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.УстановитьПометкуУдаления(Истина);
		Счётчик = Счётчик + 1;
	КонецЦикла;

	Возврат Счётчик;

КонецФункции

// ПроверитьСтатусQdrant
// Проверяет доступность Embedding и Qdrant для выбранного компонента.
//
// Возвращаемое значение:
//   Структура - { EmbeddingДоступен, EmbeddingСтатус, QdrantДоступен, QdrantСтатус }
Функция ПроверитьСтатусQdrant(КомпонентRAG) Экспорт
	Возврат AI_RAG.ПолучитьСтатусRAG(КомпонентRAG);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

