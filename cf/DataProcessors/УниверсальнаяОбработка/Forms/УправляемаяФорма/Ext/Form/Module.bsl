&НаКлиентеНаСервереБезКонтекста
Функция ПреобразоватьJSONВСтруктуруДанных(СтрокаJSON) Экспорт
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Возврат ПрочитатьJSON(Чтение);
	Исключение
		ТекстОшибки = НСтр("ru='Нарушена структура JSON строки'") + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение ТекстОшибки;	
	КонецПопытки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПреобразоватьСтруктуруДанныхВJSON(СтруктураДанных) Экспорт

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, СтруктураДанных);
	Попытка
		Возврат Запись.Закрыть();
	Исключение
		ТекстОшибки = НСтр("ru='В структуре данных недопустимый тип для записи в JSON строку'") + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение ТекстОшибки;	
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ПанельСпискаКодов(Команда)
	
	Если Не ЗначениеЗаполнено(ТекущийИдентификаторКода) Тогда
		ТекущийИдентификаторКода = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Если ОкнаКонсолиКода.Количество() = 0 Тогда
		НоваяСтрокаСписка = ОкнаКонсолиКода.Добавить();
		НоваяСтрокаСписка.Идентификатор = ТекущийИдентификаторКода;
	КонецЕсли;
	
	// Актуализация кода в хранилище
	ИнтересующаяСтрока = ОкнаКонсолиКода.НайтиСтроки(Новый Структура("Идентификатор", ТекущийИдентификаторКода))[0];
	ИнтересующаяСтрока.ТекстКода = ПроизвольныйКод.ПолучитьТекст();
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораТекущегоКода", ЭтаФорма);
	
	ОкнаКонсолиКодаСер = ОкнаКонсолиКодаВСтрокуВнутр();
	
	ПараметрыОткрытия = Новый Структура("ВходящаяТаблица, ТекущийИдентификатор", ОкнаКонсолиКодаСер, ТекущийИдентификаторКода);
	
	ОткрытьФорму("ВнешняяОбработка.УниверсальнаяОбработка.Форма.СписокКодов", ПараметрыОткрытия, , , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ОкнаКонсолиКодаВСтрокуВнутр()
	Возврат ЗначениеВСтрокуВнутр(ОкнаКонсолиКода.Выгрузить());
КонецФункции

&НаСервере
Процедура ОкнаКонсолиКодаИзСтрокиВнутр(СтрокаВнутр)
	ОкнаКонсолиКода.Загрузить(ЗначениеИзСтрокиВнутр(СтрокаВнутр));
КонецПроцедуры
	
&НаКлиенте
Процедура ПослеВыбораТекущегоКода(ПараметрыЗакрытия, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ПараметрыЗакрытия) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийИдентификаторКода = ПараметрыЗакрытия.Идентификатор;
	ОкнаКонсолиКодаИзСтрокиВнутр(ПараметрыЗакрытия.ВесьСписок);
	ПроизвольныйКод.УстановитьТекст(ПараметрыЗакрытия.ТекущийКод);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьТекстДляКонфигуратора(Команда)
	ВыделенныеТекст = Элементы.ПроизвольныйКод.ВыделенныйТекст;
	Если Не ЗначениеЗаполнено(ВыделенныеТекст) Тогда
		ВыделенныеТекст = ПроизвольныйКод.ПолучитьТекст();
	КонецЕсли;
	
	Результат = ТекстДляКонфигуратора(ВыделенныеТекст);
	ПоказатьРезультатВОкне(Результат);
	
КонецПроцедуры

&НаСервере    
Процедура ВывестиСтроку(СтрокаПоказа)
	КонсольКодаРезультат.Очистить();
	КонсольКодаРезультат.УстановитьТекст(СтрокаПоказа);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультатВОкне(СтрокаПоказа)
	
	ОткрытьФорму("ВнешняяОбработка.УниверсальнаяОбработка.Форма.ФормаВыводаСтроки", Новый Структура("Результат", СтрокаПоказа),,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция РегулярноеВыражениеНайтиВсе(СтрокаИсточник, Выражение, ОтключатьЗащиту = Ложь) Экспорт
	
	Если ОтключатьЗащиту Тогда
		ОписаниеБезопасности = Новый ОписаниеЗащитыОтОпасныхДействий;
		ОписаниеБезопасности.ПредупреждатьОбОпасныхДействиях = Ложь;
		ЗаписьЖурналаРегистрации("Отключение предупреждения об опасных действиях.", УровеньЖурналаРегистрации.Предупреждение, , , 
																		"Регулярное выражение. " + ПараметрыСеанса.ПользовательОС);
	КонецЕсли;
	
	RegExp = Новый COMОбъект("VBScript.RegExp");
	RegExp.Global = Истина;
	RegExp.Pattern = Выражение;
	
	Finded = RegExp.Execute(СтрокаИсточник);
	
	ГлавныйМассив = Новый Массив;
	
	
	Для Индекс = 0 По Finded.Count - 1 Цикл
		
		Массив = Новый Массив;
		
		ТекущаяГруппа = Finded.item(Индекс).SubMatches;
		Для ИндексГруппы = 0 По ТекущаяГруппа.Count - 1 Цикл
			Значение = ТекущаяГруппа.item(ИндексГруппы);
			Если НЕ Значение = Неопределено Тогда
				Массив.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
		
		ГлавныйМассив.Добавить(Массив);
	КонецЦикла;
	
	Возврат ГлавныйМассив;
	
КонецФункции

Функция РегулярноеВыражениеТест(СтрокаИсточник, Выражение) Экспорт
	
	ОписаниеБезопасности = Новый ОписаниеЗащитыОтОпасныхДействий;
	ОписаниеБезопасности.ПредупреждатьОбОпасныхДействиях = Ложь;
	
	RegExp = Новый COMОбъект("VBScript.RegExp");
	RegExp.Global = Истина;
	RegExp.Pattern = Выражение;
	
	Результат = RegExp.Test(СтрокаИсточник);
	
	ОписаниеБезопасности.ПредупреждатьОбОпасныхДействиях = Истина;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция Пинг(Адрес) Экспорт
	
	objShell = Новый COMОбъект("WScript.Shell") ;
	objScriptExec = objShell.Exec("ping.exe -n 1 " + Адрес);
	strPingResults = НРег(objScriptExec.StdOut.ReadAll());
	
	Успешно = СтрНайти(strPingResults, "ttl") >0;
	
	Возврат Успешно
	
КонецФункции

&НаКлиенте
Процедура ДеревоОбъектовМетаданныхПодробностиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоОбъектовМетаданныхПодробности.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ПроизвольныйКод.ВыделенныйТекст = ТекущиеДанные.Имя;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОбъектовМетаданныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоОбъектовМетаданных.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ПроизвольныйКод.ВыделенныйТекст = ТекущиеДанные.Имя;
	
КонецПроцедуры

Функция ОтправитьСообщениеВТГ(ТекстСообщения) Экспорт
	
	Ресурс = СтрШаблон("bot%1/sendMessage?chat_id=%2&text=%3", telegram_api_key, telegram_chat_id, ТекстСообщения);
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	
	АдресСервера	= "api.telegram.org";
	ЗащитаСвязи		= Новый ЗащищенноеСоединениеOpenSSL();
	ТаймАут			= 30;
	
	Попытка
		
		Соединение	= Новый HTTPСоединение(АдресСервера, , , , , ТаймАут, ЗащитаСвязи);
		
		Запрос		= Новый HTTPЗапрос(Ресурс);
		
		Ответ = Соединение.Получить(Запрос);
		Если Не Ответ.КодСостояния = 200 Тогда
			Шаблон = 
			"При отправке сообщения в Telegram для %1 сервер вернул код:%1
			|Подробный ответ:%2";
			ОписаниеРезультата = СтрШаблон(Шаблон, Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
			
			Сообщить(ОписаниеРезультата);
		КонецЕсли;
		
	Исключение
		
		Шаблон("При отправке сообщения в ТГ, произошла ошибка: %1", ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

