		Элементы.КонсольКода_ПоказатьСкрытьСохраненные.ЦветФона = ЦветаСтиля.ЦветФонаКнопки;
	КонецЕсли;
	
	Элементы.КонсольКода_ГруппаСохраненные.Видимость			= Элементы.КонсольКода_ПоказатьСкрытьСохраненные.Пометка;
	Элементы.СписокАлгоритмовСохранитьТекущийАлгоритм.Видимость	= Элементы.КонсольКода_ПоказатьСкрытьСохраненные.Пометка;
	Элементы.Заменить.Видимость									= Элементы.КонсольКода_ПоказатьСкрытьСохраненные.Пометка;
	
КонецПроцедуры

&НаСервере
Процедура КонсольКода_ДеревоМетаданныхНаСервере()
	
	Если Не КонсольКода_МетаданныеЗагружены Тогда
		ДеревоОбъектовМетаданныхЗаполнить();
		КонсольКода_МетаданныеЗагружены = Истина;
	КонецЕсли;
	
	Элементы.КонсольКода_ДеревоМетаданных.Пометка = НЕ Элементы.КонсольКода_ДеревоМетаданных.Пометка;
	Если Элементы.КонсольКода_ДеревоМетаданных.Пометка Тогда
		Элементы.КонсольКода_ДеревоМетаданных.ЦветФона = WebЦвета.НебесноГолубой;
	Иначе
		Элементы.КонсольКода_ДеревоМетаданных.ЦветФона = ЦветаСтиля.ЦветФонаКнопки;
	КонецЕсли;
	
	Элементы.ДеревоОбъектовМетаданных.Видимость				= Элементы.КонсольКода_ДеревоМетаданных.Пометка;
	Элементы.ДеревоОбъектовМетаданныхПодробности.Видимость	= Элементы.КонсольКода_ДеревоМетаданных.Пометка;
КонецПроцедуры

