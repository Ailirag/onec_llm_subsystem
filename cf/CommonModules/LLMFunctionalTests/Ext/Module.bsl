	СтрокаОбъекта.ТребоватьПериод = Ложь;
	Объект.ОграниченныеПоля.Очистить();
	СтрокаПоля = Объект.ОграниченныеПоля.Добавить();
	СтрокаПоля.ПолноеИмяОбъекта = "Справочник.Контрагенты";
	СтрокаПоля.ИмяПоля = "ИНН";
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ОбеспечитьАгента(Профиль)

