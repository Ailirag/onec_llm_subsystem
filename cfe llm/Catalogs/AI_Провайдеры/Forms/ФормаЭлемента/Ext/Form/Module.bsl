
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ApiКлюч = ТекущийОбъект.ApiКлюч.Получить();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьНастройкиZAI();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.APIКлюч = Новый ХранилищеЗначения(ApiКлюч);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ЗагрузитьМодели(Команда)

	Записать();
	ПараметрыФормы = Новый Структура("Провайдер", Объект.Ссылка);
	ОткрытьФорму(
		"Справочник.AI_Провайдеры.Форма.ВыборМоделей",
		ПараметрыФормы,
		ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНастройкиZAI()

	Если Объект.Ссылка <> Справочники.AI_Провайдеры.ZAI Тогда
		Возврат;
	КонецЕсли;

	СтрокаАдреса = Объект.АдресаСервисов.Найти(
		Перечисления.AI_ТипAPI.ChatCompletions, "Тип");
	Если СтрокаАдреса = Неопределено Тогда
		СтрокаАдреса = Объект.АдресаСервисов.Добавить();
		СтрокаАдреса.Тип = Перечисления.AI_ТипAPI.ChatCompletions;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаАдреса.БазовыйURL) Тогда
		СтрокаАдреса.БазовыйURL = Справочники.AI_Провайдеры.БазовыйURLZAI();
		СтрокаАдреса.Описание = "Z.AI Chat Completions API";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
