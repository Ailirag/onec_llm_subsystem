
Функция ПроверитьПодключение(Знач Сервер) Экспорт

	Сессия = Неопределено;
	Попытка
		Сессия = Инициализировать(Сервер);
		Результат = Новый Структура(
			"ok,protocolVersion,serverInfo,capabilities",
			Истина,
			Сессия.ВерсияПротокола,
			Сессия.ИнформацияСервера,
			Сессия.Возможности);
		Завершить(Сессия);
		Возврат Результат;
	Исключение
		Если Сессия <> Неопределено Тогда
			Завершить(Сессия);
		КонецЕсли;
		Возврат Новый Структура(
			"ok,error",
			Ложь,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция ПолучитьИнструменты(Знач Сервер) Экспорт

	Сессия = Неопределено;
	Попытка
		Сессия = Инициализировать(Сервер);
		Если ПолучитьСвойство(Сессия.Возможности, "tools", Неопределено) = Неопределено Тогда
			ВызватьИсключение "MCP-сервер не объявил возможность tools.";
		КонецЕсли;

		Инструменты = Новый Массив;
		Курсор = "";
		Пока Истина Цикл
			Параметры = Новый Структура;
			Если ЗначениеЗаполнено(Курсор) Тогда
				Параметры.Вставить("cursor", Курсор);
			КонецЕсли;
			РезультатСтраницы = ВыполнитьМетод(Сессия, "tools/list", Параметры);
			Для Каждого Инструмент Из ПолучитьСвойство(
					РезультатСтраницы,
					"tools",
					Новый Массив) Цикл
				Инструменты.Добавить(Инструмент);
			КонецЦикла;
			Курсор = ПолучитьСвойство(РезультатСтраницы, "nextCursor", "");
			Если Не ЗначениеЗаполнено(Курсор) Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Завершить(Сессия);
		Возврат Инструменты;
	Исключение
		Если Сессия <> Неопределено Тогда
			Завершить(Сессия);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Функция ВыполнитьИнструмент(
		Знач Сервер,
		Знач ИмяИнструмента,
		Знач Аргументы,
		Знач ОбщийТаймаутСекунд = 0) Экспорт

	Сессия = Неопределено;
	Попытка
		Сессия = Инициализировать(Сервер, ОбщийТаймаутСекунд);
		Параметры = Новый Структура;
		Параметры.Вставить("name", ИмяИнструмента);
		Параметры.Вставить("arguments", Аргументы);
		Результат = ВыполнитьМетод(Сессия, "tools/call", Параметры);
		Завершить(Сессия);
		Возврат Результат;
	Исключение
		Если Сессия <> Неопределено Тогда
			Завершить(Сессия);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Функция Инициализировать(Знач Сервер, Знач ОбщийТаймаутСекунд = 0)

	Настройки = ПолучитьНастройкиСервера(Сервер);
	Сессия = НоваяСессия(Сервер, Настройки, ОбщийТаймаутСекунд);
	РезультатСовременногоПротокола = ИнициализироватьСовременныйПротокол(Сессия);
	Если РезультатСовременногоПротокола.Успех Тогда
		Возврат Сессия;
	КонецЕсли;

	Попытка
		ИнициализироватьУстаревшийПротокол(Сессия);
		Возврат Сессия;
	Исключение
		ВызватьИсключение СтрШаблон(
			"MCP-сервер не принял современный и совместимый устаревший протокол. "
				+ "Современный: %1. Устаревший: %2.",
			РезультатСовременногоПротокола.Ошибка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция НоваяСессия(Знач Сервер, Знач Настройки, Знач ОбщийТаймаутСекунд)

	КрайнийСрокМиллисекунды = 0;
	Если ОбщийТаймаутСекунд > 0 Тогда
		КрайнийСрокМиллисекунды = ТекущаяУниверсальнаяДатаВМиллисекундах()
			+ ОбщийТаймаутСекунд * 1000;
	КонецЕсли;

	Сессия = Новый Структура;
	Сессия.Вставить("Сервер", Сервер);
	Сессия.Вставить("Настройки", Настройки);
	Сессия.Вставить("Идентификатор", "");
	Сессия.Вставить("ВерсияПротокола", "2026-07-28");
	Сессия.Вставить("СовременныйПротокол", Истина);
	Сессия.Вставить("СледующийID", 1);
	Сессия.Вставить("ИнформацияСервера", Новый Структура);
	Сессия.Вставить("Возможности", Новый Структура);
	Сессия.Вставить("КрайнийСрокМиллисекунды", КрайнийСрокМиллисекунды);
	Возврат Сессия;

КонецФункции

Функция ИнициализироватьСовременныйПротокол(Знач Сессия)

	// Ключ _meta не является допустимым именем поля Структуры 1С.
	Параметры = Новый Соответствие;
	ДобавитьМетаданныеСовременногоЗапроса(Параметры, Сессия.ВерсияПротокола);
	Сообщение = СообщениеJSONRPC("server/discover", Параметры, Сессия.СледующийID);
	Сессия.СледующийID = Сессия.СледующийID + 1;
	ОбновитьТаймаутСессии(Сессия);
	Ответ = AI_MCPТранспортHTTP.ВыполнитьJSONRPC(
		Сессия.Настройки,
		Сообщение,
		Сессия,
		Истина);
	Если Ответ.КодСостояния >= 400 Тогда
		Если Ответ.КодСостояния = 400
			И Не ЭтоРаспознаннаяОшибкаСовременногоПротокола(Ответ.JSON) Тогда
			Возврат Новый Структура(
				"Успех,Ошибка",
				Ложь,
				СтрШаблон("HTTP 400: %1", Лев(Ответ.Тело, 2000)));
		КонецЕсли;
		ВызватьИсключение СтрШаблон(
			"MCP-сервер вернул HTTP %1 при согласовании современного протокола: %2",
			Ответ.КодСостояния,
			Лев(Ответ.Тело, 2000));
	КонецЕсли;
	Результат = ПолучитьРезультатJSONRPC(Ответ.JSON);
	Версии = ПолучитьСвойство(Результат, "supportedVersions", Новый Массив);
	Если Версии.Найти(Сессия.ВерсияПротокола) = Неопределено Тогда
		ВызватьИсключение "MCP-сервер не объявил поддержку протокола 2026-07-28.";
	КонецЕсли;
	Сессия.Возможности = ПолучитьСвойство(Результат, "capabilities", Новый Структура);
	МетаданныеОтвета = ПолучитьСвойство(Результат, "_meta", Новый Соответствие);
	Сессия.ИнформацияСервера = ПолучитьСвойство(
		МетаданныеОтвета,
		"io.modelcontextprotocol/serverInfo",
		Новый Структура);
	Возврат Новый Структура("Успех,Ошибка", Истина, "");

КонецФункции

Функция ЭтоРаспознаннаяОшибкаСовременногоПротокола(Знач JSON)

	Ошибка = ПолучитьСвойство(JSON, "error", Неопределено);
	КодОшибки = ПолучитьСвойство(Ошибка, "code", 0);
	Возврат КодОшибки = -32020
		Или КодОшибки = -32021
		Или КодОшибки = -32022;

КонецФункции

Процедура ИнициализироватьУстаревшийПротокол(Знач Сессия)

	Сессия.ВерсияПротокола = "2025-11-25";
	Сессия.СовременныйПротокол = Ложь;
	Сессия.Идентификатор = "";

	ИнформацияКлиента = Новый Структура;
	ИнформацияКлиента.Вставить("name", "1c-llm-subsystem");
	ИнформацияКлиента.Вставить("version", "1.0.0");
	Параметры = Новый Структура;
	Параметры.Вставить("protocolVersion", Сессия.ВерсияПротокола);
	Параметры.Вставить("capabilities", Новый Структура);
	Параметры.Вставить("clientInfo", ИнформацияКлиента);
	Сообщение = СообщениеJSONRPC("initialize", Параметры, Сессия.СледующийID);
	Сессия.СледующийID = Сессия.СледующийID + 1;

	ОбновитьТаймаутСессии(Сессия);
	Ответ = AI_MCPТранспортHTTP.ВыполнитьJSONRPC(Сессия.Настройки, Сообщение);
	Результат = ПолучитьРезультатJSONRPC(Ответ.JSON);
	Сессия.Идентификатор = Ответ.ИдентификаторСессии;
	Сессия.ВерсияПротокола = ПолучитьСвойство(
		Результат,
		"protocolVersion",
		Сессия.ВерсияПротокола);
	Если Не ПоддерживаетсяВерсияПротокола(Сессия.ВерсияПротокола) Тогда
		ВызватьИсключение "MCP-сервер согласовал неподдерживаемую версию протокола: "
			+ Строка(Сессия.ВерсияПротокола);
	КонецЕсли;
	Сессия.ИнформацияСервера = ПолучитьСвойство(
		Результат,
		"serverInfo",
		Новый Структура);
	Сессия.Возможности = ПолучитьСвойство(
		Результат,
		"capabilities",
		Новый Структура);

	Уведомление = СообщениеJSONRPC("notifications/initialized", Новый Структура);
	ОбновитьТаймаутСессии(Сессия);
	AI_MCPТранспортHTTP.ВыполнитьJSONRPC(Сессия.Настройки, Уведомление, Сессия);

КонецПроцедуры

Функция ВыполнитьМетод(Знач Сессия, Знач Метод, Знач Параметры)

	Если Сессия.СовременныйПротокол Тогда
		ПараметрыСовременногоПротокола = Новый Соответствие;
		Для Каждого Параметр Из Параметры Цикл
			ПараметрыСовременногоПротокола.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		Параметры = ПараметрыСовременногоПротокола;
		ДобавитьМетаданныеСовременногоЗапроса(Параметры, Сессия.ВерсияПротокола);
	КонецЕсли;
	ID = Сессия.СледующийID;
	Сессия.СледующийID = Сессия.СледующийID + 1;
	Сообщение = СообщениеJSONRPC(Метод, Параметры, ID);
	ОбновитьТаймаутСессии(Сессия);
	Ответ = AI_MCPТранспортHTTP.ВыполнитьJSONRPC(
		Сессия.Настройки,
		Сообщение,
		Сессия);
	Возврат ПолучитьРезультатJSONRPC(Ответ.JSON);

КонецФункции

Процедура ДобавитьМетаданныеСовременногоЗапроса(Знач Параметры, Знач ВерсияПротокола)

	ИнформацияКлиента = Новый Структура("name,version", "1c-llm-subsystem", "1.0.0");
	МетаданныеЗапроса = Новый Соответствие;
	МетаданныеЗапроса.Вставить("io.modelcontextprotocol/protocolVersion", ВерсияПротокола);
	МетаданныеЗапроса.Вставить("io.modelcontextprotocol/clientInfo", ИнформацияКлиента);
	МетаданныеЗапроса.Вставить("io.modelcontextprotocol/clientCapabilities", Новый Структура);
	Параметры.Вставить("_meta", МетаданныеЗапроса);

КонецПроцедуры

Функция ПоддерживаетсяВерсияПротокола(Знач Версия)

	Возврат Версия = "2025-11-25"
		Или Версия = "2025-06-18"
		Или Версия = "2025-03-26"
		Или Версия = "2026-07-28";

КонецФункции

Процедура ОбновитьТаймаутСессии(Знач Сессия)

	КрайнийСрок = ПолучитьСвойство(Сессия, "КрайнийСрокМиллисекунды", 0);
	Если КрайнийСрок <= 0 Тогда
		Сессия.Настройки.ТаймаутСекунд = Сессия.Настройки.БазовыйТаймаутСекунд;
		Возврат;
	КонецЕсли;
	ОсталосьМиллисекунд = КрайнийСрок - ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если ОсталосьМиллисекунд <= 0 Тогда
		ВызватьИсключение "Истек общий таймаут выполнения MCP-инструмента.";
	КонецЕсли;
	ОсталосьСекунд = Макс(1, Цел(ОсталосьМиллисекунд / 1000));
	Сессия.Настройки.ТаймаутСекунд = Мин(
		Сессия.Настройки.БазовыйТаймаутСекунд,
		ОсталосьСекунд);

КонецПроцедуры

Процедура Завершить(Знач Сессия)

	Если Сессия.СовременныйПротокол Тогда
		Возврат;
	КонецЕсли;
	AI_MCPТранспортHTTP.ЗавершитьСессию(Сессия.Настройки, Сессия);

КонецПроцедуры

Функция СообщениеJSONRPC(Знач Метод, Знач Параметры, Знач ID = Неопределено)

	Сообщение = Новый Структура;
	Сообщение.Вставить("jsonrpc", "2.0");
	Если ID <> Неопределено Тогда
		Сообщение.Вставить("id", ID);
	КонецЕсли;
	Сообщение.Вставить("method", Метод);
	Сообщение.Вставить("params", Параметры);
	Возврат Сообщение;

КонецФункции

Функция ПолучитьРезультатJSONRPC(Знач JSON)

	Если JSON = Неопределено Тогда
		ВызватьИсключение "MCP-сервер вернул пустой JSON-RPC ответ.";
	КонецЕсли;
	Ошибка = ПолучитьСвойство(JSON, "error", Неопределено);
	Если Ошибка <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Ошибка MCP JSON-RPC %1: %2",
			ПолучитьСвойство(Ошибка, "code", ""),
			ПолучитьСвойство(Ошибка, "message", "Неизвестная ошибка"));
	КонецЕсли;
	Результат = ПолучитьСвойство(JSON, "result", Неопределено);
	Если Результат = Неопределено Тогда
		ВызватьИсключение "MCP JSON-RPC ответ не содержит result.";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПолучитьНастройкиСервера(Знач Сервер)

	Если Не ЗначениеЗаполнено(Сервер) Тогда
		ВызватьИсключение "Не указан MCP-сервер.";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| AI_MCPСерверы.Активен КАК Активен,
		| AI_MCPСерверы.Endpoint КАК Endpoint,
		| AI_MCPСерверы.ТипАвторизации КАК ТипАвторизации,
		| AI_MCPСерверы.ИмяЗаголовкаАвторизации КАК ИмяЗаголовкаАвторизации,
		| AI_MCPСерверы.ТаймаутСекунд КАК ТаймаутСекунд,
		| AI_MCPСерверы.МаксимальныйРазмерОтветаБайт КАК МаксимальныйРазмерОтветаБайт,
		| AI_MCPСерверы.РазрешитьНезащищенныйHTTP КАК РазрешитьНезащищенныйHTTP
		|ИЗ
		| Справочник.AI_MCPСерверы КАК AI_MCPСерверы
		|ГДЕ
		| AI_MCPСерверы.Ссылка = &Сервер";
	Запрос.УстановитьПараметр("Сервер", Сервер);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "MCP-сервер не найден.";
	КонецЕсли;
	Если Не Выборка.Активен Тогда
		ВызватьИсключение "MCP-сервер отключен.";
	КонецЕсли;
	Настройки = Новый Структура;
	Настройки.Вставить("Endpoint", Выборка.Endpoint);
	Настройки.Вставить("ТипАвторизации", Выборка.ТипАвторизации);
	Настройки.Вставить("ИмяЗаголовкаАвторизации", Выборка.ИмяЗаголовкаАвторизации);
	ТаймаутСекунд = Выборка.ТаймаутСекунд;
	Если ТаймаутСекунд <= 0 Тогда
		ТаймаутСекунд = 60;
	КонецЕсли;
	Настройки.Вставить("ТаймаутСекунд", ТаймаутСекунд);
	Настройки.Вставить("БазовыйТаймаутСекунд", Настройки.ТаймаутСекунд);
	МаксимальныйРазмерОтветаБайт = Выборка.МаксимальныйРазмерОтветаБайт;
	Если МаксимальныйРазмерОтветаБайт <= 0 Тогда
		МаксимальныйРазмерОтветаБайт = 5242880;
	КонецЕсли;
	Настройки.Вставить("МаксимальныйРазмерОтветаБайт", МаксимальныйРазмерОтветаБайт);
	Настройки.Вставить("РазрешитьНезащищенныйHTTP", Выборка.РазрешитьНезащищенныйHTTP);
	Настройки.Вставить("Секрет", AI_MCPСекреты.Получить(Сервер));
	Возврат Настройки;

КонецФункции

Функция ПолучитьСвойство(Знач Источник, Знач Имя, Знач ПоУмолчанию)

	Если Источник = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Источник) = Тип("Структура")
		Или ТипЗнч(Источник) = Тип("ФиксированнаяСтруктура") Тогда
		Значение = Неопределено;
		Если Источник.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Источник) = Тип("Соответствие")
		Или ТипЗнч(Источник) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Источник.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции
