&НаСервере
Функция ДанныеЛокальногоПутиИзСервера(ИмяПапкиДляСохранения = "")
	
	ИмяКлючаНастроек			= "ПутьКАлгоритмам_conscode";
	ИмяПользователя				= ПараметрыСеанса.ТекущийПользователь;
	ИмяПользователяБезПробелов	= СтрЗаменить(ИмяПользователя, " ", "_");
	
	Если ИмяПапкиДляСохранения = "" Тогда
		
		ПутьИзНастроек = ХранилищеОбщихНастроек.Загрузить(ИмяПользователяБезПробелов, "ПутьКАлгоритмам_conscode", , ИмяПользователяБезПробелов);
		
		Если ЗначениеЗаполнено(ПутьИзНастроек) Тогда
			Сообщить("Настройки успешно загружены");
			Возврат ПутьИзНастроек;
		Иначе
			Сообщить("Настройки не обнаружены");
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		ХранилищеОбщихНастроек.Сохранить(ИмяПользователяБезПробелов, ИмяКлючаНастроек, ИмяПапкиДляСохранения, , ИмяПользователяБезПробелов);
		
		Сообщить("Путь сохранен на сервере");
		
	КонецЕсли;
	
КонецФункции


