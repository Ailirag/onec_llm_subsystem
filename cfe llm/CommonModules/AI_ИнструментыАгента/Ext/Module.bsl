
Функция ПолучитьОписания(Знач ПрофильДоступа, Знач ДляResponses = Ложь) Экспорт

	Политика = AI_ПолитикиАгента.Получить(ПрофильДоступа);
	Инструменты = Новый Массив;
	Инструменты.Добавить(ОписаниеИнструмента(
		"metadata_search",
		"Найти доступные пользователю объекты метаданных 1С по имени или синониму.",
		СхемаПоискаМетаданных(),
		ДляResponses));
	Инструменты.Добавить(ОписаниеИнструмента(
		"metadata_describe",
		"Получить поля и табличные части объектов метаданных 1С. Вызывай перед построением запроса.",
		СхемаОписанияМетаданных(),
		ДляResponses));

	Если AI_ПолитикиАгента.ДоступныЗапросы(Политика) Тогда
		Инструменты.Добавить(ОписаниеИнструмента(
			"query_validate",
			"Проверить запрос языка запросов 1С по политике доступа без выполнения.",
			СхемаЗапроса(),
			ДляResponses));
		Инструменты.Добавить(ОписаниеИнструмента(
			"query_execute",
			"Выполнить уже проверенный ограниченный запрос выборки 1С в правах текущего пользователя.",
			СхемаЗапроса(),
			ДляResponses));
		Инструменты.Добавить(ОписаниеИнструмента(
			"catalog_record_counts",
			"Посчитать записи во всех или выбранных справочниках из белого списка профиля и вернуть лидеров. "
				+ "Используй для сравнения справочников по количеству объектов.",
			СхемаПодсчетаСправочников(),
			ДляResponses));
	КонецЕсли;

	Возврат Инструменты;

КонецФункции

Функция ИнструкцияДляМодели(Знач ПрофильДоступа) Экспорт

	Политика = AI_ПолитикиАгента.Получить(ПрофильДоступа);
	Инструкция = Символы.ПС + Символы.ПС
		+ "Правила агентского анализа базы 1С:" + Символы.ПС
		+ "1. Не выдумывай объекты и поля: для произвольного запроса сначала используй metadata_search "
			+ "и metadata_describe. Специализированные инструменты можно вызывать сразу." + Символы.ПС
		+ "2. Самостоятельно формируй запросы языка запросов 1С по найденным метаданным." + Символы.ПС
		+ "3. Для сравнения справочников по количеству записей сразу используй catalog_record_counts "
			+ "с пустым objects; не перебирай их отдельными query_execute." + Символы.ПС
		+ "4. Обычный запрос должен содержать один SELECT ВЫБРАТЬ и буквальный лимит ПЕРВЫЕ N. "
			+ "Однострочный агрегат без группировки, итогов и объединений может не содержать ПЕРВЫЕ." + Символы.ПС
		+ "5. Для самостоятельно сформированного запроса сначала вызови query_validate, "
			+ "затем query_execute с теми же query и parameters." + Символы.ПС
		+ "6. Не проси пользователя выполнить запрос вручную, если доступен query_execute." + Символы.ПС
		+ "7. Делай выводы только по фактически возвращенным данным. Если complete=false, "
			+ "явно сообщи, что сравнение неполное, и перечисли недоступные объекты.";
	Если Не AI_ПолитикиАгента.ДоступныЗапросы(Политика) Тогда
		Инструкция = Инструкция + Символы.ПС
			+ "Профиль текущего агента разрешает только исследование метаданных; инструменты чтения данных недоступны.";
	КонецЕсли;
	Возврат Инструкция;

КонецФункции

Функция ВыполнитьИнструмент(Знач ИмяИнструмента, Знач Аргументы, Знач ПрофильДоступа, Знач Состояние) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Успешно = Ложь;
	Попытка
		Политика = AI_ПолитикиАгента.Получить(ПрофильДоступа);
		Если ИмяИнструмента = "metadata_search" Тогда
			Результат = AI_МетаданныеСервер.НайтиОбъекты(
				ПолучитьСвойство(Аргументы, "query", ""),
				ПолучитьСвойство(Аргументы, "kinds", Новый Массив),
				ПолучитьСвойство(Аргументы, "limit", 50));
		ИначеЕсли ИмяИнструмента = "metadata_describe" Тогда
			Результат = AI_МетаданныеСервер.Описать(
				ПолучитьСвойство(Аргументы, "objects", Новый Массив),
				ПолучитьСвойство(Аргументы, "detail_level", "fields"));
		ИначеЕсли ИмяИнструмента = "query_validate" Тогда
			Результат = AI_БезопасныеЗапросы.ПроверитьЗапрос(
				ПолучитьСвойство(Аргументы, "query", ""),
				ПолучитьСвойство(Аргументы, "parameters", Новый Массив),
				Политика);
		ИначеЕсли ИмяИнструмента = "query_execute" Тогда
			УчестьЗапросКДанным(Состояние, Политика);
			Результат = AI_БезопасныеЗапросы.ВыполнитьЗапрос(
				ПолучитьСвойство(Аргументы, "query", ""),
				ПолучитьСвойство(Аргументы, "parameters", Новый Массив),
				Политика);
		ИначеЕсли ИмяИнструмента = "catalog_record_counts" Тогда
			УчестьЗапросКДанным(Состояние, Политика);
			Результат = AI_БезопасныеЗапросы.ПосчитатьЗаписиСправочников(
				ПолучитьСвойство(Аргументы, "objects", Новый Массив),
				ПолучитьСвойство(Аргументы, "top", 10),
				ПолучитьСвойство(Аргументы, "include_empty", Истина),
				Политика);
		Иначе
			ВызватьИсключение "Неизвестный инструмент агента: " + ИмяИнструмента;
		КонецЕсли;
		Успешно = ПолучитьСвойство(Результат, "ok", Истина);
	Исключение
		Результат = Новый Структура(
			"ok,error",
			Ложь,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаписатьАудит(
		ИмяИнструмента,
		Состояние,
		ПрофильДоступа,
		Успешно,
		ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	Возврат Результат;

КонецФункции

Процедура УчестьЗапросКДанным(Знач Состояние, Знач Политика)

	Если Состояние.КоличествоЗапросовКДанным >= Политика.МаксимумЗапросовКДанным Тогда
		ВызватьИсключение СтрШаблон(
			"Достигнут лимит запросов к данным за запуск (%1).",
			Политика.МаксимумЗапросовКДанным);
	КонецЕсли;
	Состояние.КоличествоЗапросовКДанным = Состояние.КоличествоЗапросовКДанным + 1;

КонецПроцедуры

Функция ОписаниеИнструмента(Знач Имя, Знач Описание, Знач Параметры, Знач ДляResponses)

	Если ДляResponses Тогда
		Результат = Новый Структура;
		Результат.Вставить("type", "function");
		Результат.Вставить("name", Имя);
		Результат.Вставить("description", Описание);
		Результат.Вставить("parameters", Параметры);
		Результат.Вставить("strict", Ложь);
		Возврат Результат;
	КонецЕсли;

	ФункцияИнструмента = Новый Структура;
	ФункцияИнструмента.Вставить("name", Имя);
	ФункцияИнструмента.Вставить("description", Описание);
	ФункцияИнструмента.Вставить("parameters", Параметры);
	Возврат Новый Структура(
		"type,function",
		"function",
		ФункцияИнструмента);

КонецФункции

Функция СхемаПоискаМетаданных()

	Свойства = Новый Соответствие;
	Свойства.Вставить("query", Новый Структура(
		"type,description",
		"string",
		"Часть имени, синонима или полного имени. Пустая строка возвращает первые доступные объекты."));
	ЭлементыВидов = Новый Структура("type", "string");
	Свойства.Вставить("kinds", Новый Структура(
		"type,items,description",
		"array",
		ЭлементыВидов,
		"Необязательные виды: catalog, document, information_register, accumulation_register, enum и другие."));
	Ограничение = Новый Структура("type,minimum,maximum", "integer", 1, 100);
	Свойства.Вставить("limit", Ограничение);
	Возврат СхемаОбъекта(Свойства, Новый Массив);

КонецФункции

Функция СхемаОписанияМетаданных()

	Свойства = Новый Соответствие;
	Свойства.Вставить("objects", Новый Структура(
		"type,items,description",
		"array",
		Новый Структура("type", "string"),
		"Массив полных имен объектов, например Справочник.Номенклатура."));
	Свойства.Вставить("detail_level", Новый Структура(
		"type,description",
		"string",
		"Уровень детализации; сейчас поддерживается fields."));
	Обязательные = Новый Массив;
	Обязательные.Добавить("objects");
	Возврат СхемаОбъекта(Свойства, Обязательные);

КонецФункции

Функция СхемаЗапроса()

	СвойстваПараметра = Новый Соответствие;
	СвойстваПараметра.Вставить("name", Новый Структура("type", "string"));
	СвойстваПараметра.Вставить("type", Новый Структура(
		"type,description",
		"string",
		"Один из типов: string, number, boolean, date."));
	СвойстваПараметра.Вставить("value", Новый Структура(
		"description",
		"Значение параметра; для date используй ISO 8601."));
	ОбязательныеПараметра = Новый Массив;
	ОбязательныеПараметра.Добавить("name");
	ОбязательныеПараметра.Добавить("type");
	ОбязательныеПараметра.Добавить("value");
	ЭлементПараметров = СхемаОбъекта(СвойстваПараметра, ОбязательныеПараметра);

	Свойства = Новый Соответствие;
	Свойства.Вставить("query", Новый Структура(
		"type,description",
		"string",
		"Один запрос выборки языка запросов 1С. Обычная выборка требует верхнее ограничение ПЕРВЫЕ N; "
			+ "однострочный агрегат без группировки, итогов и объединений может выполняться без ПЕРВЫЕ."));
	Свойства.Вставить("parameters", Новый Структура(
		"type,items",
		"array",
		ЭлементПараметров));
	Обязательные = Новый Массив;
	Обязательные.Добавить("query");
	Возврат СхемаОбъекта(Свойства, Обязательные);

КонецФункции

Функция СхемаПодсчетаСправочников()

	Свойства = Новый Соответствие;
	Свойства.Вставить("objects", Новый Структура(
		"type,items,description",
		"array",
		Новый Структура("type", "string"),
		"Необязательный массив полных имен справочников. Пустой массив означает все справочники профиля."));
	Свойства.Вставить("top", Новый Структура(
		"type,minimum,maximum,description",
		"integer",
		1,
		100,
		"Сколько справочников с наибольшим количеством записей вернуть."));
	Свойства.Вставить("include_empty", Новый Структура(
		"type,description",
		"boolean",
		"Возвращать ли справочники без записей."));
	Возврат СхемаОбъекта(Свойства, Новый Массив);

КонецФункции

Функция СхемаОбъекта(Знач Свойства, Знач Обязательные)

	Результат = Новый Структура;
	Результат.Вставить("type", "object");
	Результат.Вставить("properties", Свойства);
	Результат.Вставить("required", Обязательные);
	Результат.Вставить("additionalProperties", Ложь);
	Возврат Результат;

КонецФункции

Функция ПолучитьСвойство(Знач Объект, Знач ИмяСвойства, Знач ЗначениеПоУмолчанию)

	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Объект.Свойство(ИмяСвойства, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Значение = Объект.Получить(ИмяСвойства);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Процедура ЗаписатьАудит(Знач ИмяИнструмента, Знач Состояние, Знач ПрофильДоступа, Знач Успешно, Знач Длительность)

	Попытка
		Комментарий = СтрШаблон(
			"run=%1; step=%2; tool=%3; ok=%4; profile=%5; duration_ms=%6",
			Состояние.ИдентификаторЗапуска,
			Состояние.НомерШага,
			ИмяИнструмента,
			Успешно,
			Строка(ПрофильДоступа),
			Длительность);
		ЗаписьЖурналаРегистрации(
			"AI.Агент.Инструмент",
			?(Успешно, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка),
			,
			,
			Комментарий);
	Исключение
		// Ошибка технического аудита не должна ломать ответ агента.
	КонецПопытки;

КонецПроцедуры
