{0,
{"Обработка выборка критичных элементов",0,0,"критикал","//<<SP1376835 Garipov_ir 13.12.2019 
&НаКлиенте
Процедура ОбработкаВыбораКритичныхЭлементов(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	// При заполненой таблице
	Если <?""ПутьКТаблице"">.Количество() > 0 Тогда 
		
		СтандартнаяОбработка = Ложь;
		
		ИсходноеЗначение = ЭтаФорма[Элемент.Имя];
		
		СтруктураПараметров = Новый Структура(""Элемент, ВыбранноеЗначение, ИсходноеЗначение"",
											   Элемент, ВыбранноеЗначение, ИсходноеЗначение);
		
		Оповещение = Новый ОписаниеОповещения(""ПриСменеКритичныхРеквизитов"", ЭтаФорма, СтруктураПараметров);
		
		ПоказатьВопрос(Оповещение, ""Изменение значения приведет к очистке таблицы. Продолжить?"", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

//<<SP1376835 Garipov_ir 13.12.2019 
&НаКлиенте 
Процедура ПриСменеКритичныхРеквизитов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		//Какие то действия при все таки смене значения
		
		<?""ПутьКТаблице"">.Очистить();
		
		Если ЗначениеЗаполнено(ДополнительныеПараметры.ВыбранноеЗначение) Тогда
		
			ЭтаФорма[ДополнительныеПараметры.Элемент.Имя] = ДополнительныеПараметры.ВыбранноеЗначение;
			
		КонецЕсли;
		
	Иначе
		
		ЭтаФорма[ДополнительныеПараметры.Элемент.Имя] = ДополнительныеПараметры.ИсходноеЗначение;
		
	КонецЕсли;
	
КонецПроцедуры"}
},
