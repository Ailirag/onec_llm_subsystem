
// Запускает агентский запрос в фоне и сразу возвращает идентификатор операции.
// В фон передается только UUID: все параметры уже сохранены в регистре.
Функция НачатьОперацию(ПараметрыОперации) Экспорт

	Провайдер = ПолучитьСвойство(ПараметрыОперации, "Провайдер", Справочники.AI_Провайдеры.ПустаяСсылка());
	Модель = ПолучитьСвойство(ПараметрыОперации, "Модель", Справочники.AI_Модели.ПустаяСсылка());
	ТипAPI = ПолучитьСвойство(ПараметрыОперации, "ТипAPI", Неопределено);
	Промт = ОбрезатьКраяСтроки(ПолучитьСвойство(ПараметрыОперации, "Промт", ""));
	СистемныйПромт = Строка(ПолучитьСвойство(ПараметрыОперации, "СистемныйПромт", ""));

	Если Не ЗначениеЗаполнено(Провайдер)
		Или Не ЗначениеЗаполнено(Модель)
		Или Не ЗначениеЗаполнено(ТипAPI)
		Или Не ЗначениеЗаполнено(Промт)
		Или Не ЗначениеЗаполнено(СистемныйПромт) Тогда
		ВызватьИсключение "Заполните провайдера, модель, тип API, системную инструкцию и сообщение.";
	КонецЕсли;

	ИдентификаторПользователя = ИдентификаторТекущегоПользователя();
	ИдентификаторДиалога = ПолучитьСвойство(
		ПараметрыОперации,
		"ИдентификаторДиалога",
		Новый УникальныйИдентификатор);
	Если Не ЗначениеЗаполнено(ИдентификаторДиалога) Тогда
		ИдентификаторДиалога = Новый УникальныйИдентификатор;
	КонецЕсли;

	АктивнаяОперация = НайтиАктивнуюОперацию(
		ИдентификаторДиалога,
		ИдентификаторПользователя);
	Если ЗначениеЗаполнено(АктивнаяОперация) Тогда
		ВызватьИсключение "В этом диалоге уже выполняется запрос. Дождитесь его завершения или отмените.";
	КонецЕсли;

	ИдентификаторОперации = Новый УникальныйИдентификатор;
	ИдентификаторСообщения = Новый УникальныйИдентификатор;
	Вложения = ПолучитьСвойство(ПараметрыОперации, "Вложения", Новый Массив);
	ТекущийМомент = ТекущаяДатаСеанса();
	НачатьТранзакцию();
	Попытка
		Запись = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторОперации = ИдентификаторОперации;
		Запись.ИдентификаторДиалога = ИдентификаторДиалога;
		Запись.ИдентификаторСообщения = ИдентификаторСообщения;
		Запись.ИдентификаторПользователя = ИдентификаторПользователя;
		Запись.ДатаСоздания = ТекущийМомент;
		Запись.ДатаИзменения = ТекущийМомент;
		Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.ВОчереди;
		Запись.ТекущийЭтап = "Ожидание фонового задания";
		Запись.Провайдер = Провайдер;
		Запись.Модель = Модель;
		Запись.Агент = ПолучитьСвойство(
			ПараметрыОперации,
			"Агент",
			Справочники.AI_Агенты.ПустаяСсылка());
		Запись.ТипAPI = ТипAPI;
		Запись.Промт = Промт;
		Запись.СистемныйПромт = СистемныйПромт;
		Запись.ДанныеКонтекста = Строка(ПолучитьСвойство(ПараметрыОперации, "ДанныеКонтекста", ""));
		Запись.РежимДиалога = ПолучитьСвойство(ПараметрыОперации, "РежимДиалога", Истина);
		Запись.ГлубинаДиалога = ПолучитьСвойство(ПараметрыОперации, "ГлубинаДиалога", 20);
		Запись.ПредыдущийIDОтвета = Строка(ПолучитьСвойство(ПараметрыОперации, "ПредыдущийIDОтвета", ""));
		Запись.ОтменаЗапрошена = Ложь;
		Запись.Версия = 1;
		Запись.ПоследнийНомерШага = 0;
		Запись.КоличествоВложений = AI_Вложения.ПривязатьКОперации(
			ИдентификаторОперации,
			ИдентификаторДиалога,
			ИдентификаторСообщения,
			Вложения);
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ИдентификаторОперации);
	Попытка
		Задание = ФоновыеЗадания.Выполнить(
			"AI_АгентскиеОперацииСервер.ВыполнитьОперацию",
			ПараметрыЗадания,
			"AI_Агент_" + Строка(ИдентификаторДиалога),
			"Агентский запрос к данным базы");
		Запись.Прочитать();
		Запись.ИдентификаторФоновогоЗадания = Задание.УникальныйИдентификатор;
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Версия = Запись.Версия + 1;
		Запись.Записать();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Запись.Прочитать();
		Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.Ошибка;
		Запись.ТекущийЭтап = "Не удалось запустить фоновое задание";
		Запись.ТекстОшибки = ТекстОшибки;
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Версия = Запись.Версия + 1;
		Запись.Записать();
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Возврат Новый Структура(
		"ИдентификаторОперации,ИдентификаторДиалога",
		ИдентификаторОперации,
		ИдентификаторДиалога);

КонецФункции

// Возвращает компактное состояние операции и только новые шаги после указанного номера.
Функция ПолучитьИзменения(ИдентификаторОперации, ПоследнийПолученныйШаг = 0) Экспорт

	ДанныеОперации = ПолучитьДанныеОперации(ИдентификаторОперации);
	ПроверитьВладельцаОперации(ДанныеОперации);
	Если ЗавершитьОтменуПоТаймауту(ИдентификаторОперации) Тогда
		ДанныеОперации = ПолучитьДанныеОперации(ИдентификаторОперации);
	КонецЕсли;

	Статус = ДанныеОперации.Статус;
	Финальная = Статус = Перечисления.AI_СтатусАгентскойОперации.Завершена
		Или Статус = Перечисления.AI_СтатусАгентскойОперации.Ошибка
		Или Статус = Перечисления.AI_СтатусАгентскойОперации.Отменена;

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторОперации", ИдентификаторОперации);
	Результат.Вставить("ИдентификаторДиалога", ДанныеОперации.ИдентификаторДиалога);
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("ТекстСтатуса", Строка(Статус));
	Результат.Вставить("ТекущийЭтап", ДанныеОперации.ТекущийЭтап);
	Результат.Вставить("Финальная", Финальная);
	Результат.Вставить("Успешно", Статус = Перечисления.AI_СтатусАгентскойОперации.Завершена);
	Результат.Вставить("МожноОтменить", Не Финальная И Не ДанныеОперации.ОтменаЗапрошена);
	Результат.Вставить("Результат", ДанныеОперации.Результат);
	Результат.Вставить("ТекстОшибки", ДанныеОперации.ТекстОшибки);
	Результат.Вставить("НовыйIDОтвета", ДанныеОперации.НовыйIDОтвета);
	Результат.Вставить("ВходящиеТокены", ДанныеОперации.ВходящиеТокены);
	Результат.Вставить("ВыходящиеТокены", ДанныеОперации.ВыходящиеТокены);
	Результат.Вставить("ТокеныИнструментов", ДанныеОперации.ТокеныИнструментов);
	Результат.Вставить("ВходящиеТокеныВложений", ДанныеОперации.ВходящиеТокеныВложений);
	Результат.Вставить("ВыходящиеТокеныВложений", ДанныеОперации.ВыходящиеТокеныВложений);
	Результат.Вставить("КоличествоВложений", ДанныеОперации.КоличествоВложений);
	Результат.Вставить("Версия", ДанныеОперации.Версия);
	Результат.Вставить("ПоследнийНомерШага", ДанныеОперации.ПоследнийНомерШага);
	Результат.Вставить("Шаги", ПолучитьНовыеШаги(ИдентификаторОперации, ПоследнийПолученныйШаг));

	Возврат Результат;

КонецФункции

Процедура ЗапроситьОтмену(ИдентификаторОперации) Экспорт

	ДанныеОперации = ПолучитьДанныеОперации(ИдентификаторОперации);
	ПроверитьВладельцаОперации(ДанныеОперации);
	Если ЭтоФинальныйСтатус(ДанныеОперации.Статус) Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторОперации = ИдентификаторОперации;
	Запись.Прочитать();
	Запись.ОтменаЗапрошена = Истина;
	Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.ОтменаЗапрошена;
	Запись.ТекущийЭтап = "Ожидание безопасной точки остановки";
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Версия = Запись.Версия + 1;
	Запись.Записать();

КонецПроцедуры

Функция ЗавершитьОтменуПоТаймауту(ИдентификаторОперации)

	Запись = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторОперации = ИдентификаторОперации;
	Запись.Прочитать();
	Если Не Запись.ОтменаЗапрошена
		Или ЭтоФинальныйСтатус(Запись.Статус)
		Или Запись.ДатаИзменения > ТекущаяДатаСеанса() - 30 Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.Отменена;
	Запись.ТекущийЭтап = "Операция отменена пользователем";
	Запись.ТекстОшибки = "Операция отменена пользователем.";
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Версия = Запись.Версия + 1;
	Запись.Записать();
	Возврат Истина;

КонецФункции

Функция НайтиАктивнуюОперациюДиалога(ИдентификаторДиалога) Экспорт

	Возврат НайтиАктивнуюОперацию(
		ИдентификаторДиалога,
		ИдентификаторТекущегоПользователя());

КонецФункции

Функция ПолучитьПоследнююАктивнуюОперациюПользователя() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| 	Операции.ИдентификаторОперации КАК ИдентификаторОперации,
		| 	Операции.ИдентификаторДиалога КАК ИдентификаторДиалога,
		| 	Операции.Промт КАК Промт
		|ИЗ
		| 	РегистрСведений.AI_АгентскиеОперации КАК Операции
		|ГДЕ
		| 	Операции.ИдентификаторПользователя = &ИдентификаторПользователя
		| 	И Операции.Статус В (&ВОчереди, &Выполняется, &ОтменаЗапрошена)
		|УПОРЯДОЧИТЬ ПО
		| 	Операции.ДатаСоздания УБЫВ";
	Запрос.УстановитьПараметр(
		"ИдентификаторПользователя",
		ИдентификаторТекущегоПользователя());
	Запрос.УстановитьПараметр("ВОчереди", Перечисления.AI_СтатусАгентскойОперации.ВОчереди);
	Запрос.УстановитьПараметр("Выполняется", Перечисления.AI_СтатусАгентскойОперации.Выполняется);
	Запрос.УстановитьПараметр("ОтменаЗапрошена", Перечисления.AI_СтатусАгентскойОперации.ОтменаЗапрошена);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура(
		"ИдентификаторОперации,ИдентификаторДиалога,Промт",
		Выборка.ИдентификаторОперации,
		Выборка.ИдентификаторДиалога,
		Выборка.Промт);

КонецФункции

Функция ПолучитьДанныеОперации(ИдентификаторОперации)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| 	Операции.ИдентификаторДиалога КАК ИдентификаторДиалога,
		| 	Операции.ИдентификаторПользователя КАК ИдентификаторПользователя,
		| 	Операции.Статус КАК Статус,
		| 	Операции.ТекущийЭтап КАК ТекущийЭтап,
		| 	Операции.ОтменаЗапрошена КАК ОтменаЗапрошена,
		| 	Операции.Результат КАК Результат,
		| 	Операции.ТекстОшибки КАК ТекстОшибки,
		| 	Операции.НовыйIDОтвета КАК НовыйIDОтвета,
		| 	Операции.ВходящиеТокены КАК ВходящиеТокены,
		| 	Операции.ВыходящиеТокены КАК ВыходящиеТокены,
		| 	Операции.ТокеныИнструментов КАК ТокеныИнструментов,
		| 	Операции.ВходящиеТокеныВложений КАК ВходящиеТокеныВложений,
		| 	Операции.ВыходящиеТокеныВложений КАК ВыходящиеТокеныВложений,
		| 	Операции.КоличествоВложений КАК КоличествоВложений,
		| 	Операции.Версия КАК Версия,
		| 	Операции.ПоследнийНомерШага КАК ПоследнийНомерШага
		|ИЗ
		| 	РегистрСведений.AI_АгентскиеОперации КАК Операции
		|ГДЕ
		| 	Операции.ИдентификаторОперации = &ИдентификаторОперации";
	Запрос.УстановитьПараметр("ИдентификаторОперации", ИдентификаторОперации);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "Агентская операция не найдена.";
	КонецЕсли;
	Возврат Выборка;

КонецФункции

Функция ПолучитьНовыеШаги(ИдентификаторОперации, ПоследнийПолученныйШаг)

	МинимальныйНомерШага = ?(ПоследнийПолученныйШаг > 0, ПоследнийПолученныйШаг, 1);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| 	Шаги.ИдентификаторШага КАК ИдентификаторШага,
		| 	Шаги.ПорядковыйНомер КАК ПорядковыйНомер,
		| 	Шаги.НомерШага КАК НомерШага,
		| 	Шаги.Инструмент КАК Инструмент,
		| 	Шаги.Статус КАК Статус,
		| 	Шаги.ДатаНачала КАК ДатаНачала,
		| 	Шаги.ДатаОкончания КАК ДатаОкончания,
		| 	Шаги.ДлительностьМс КАК ДлительностьМс,
		| 	Шаги.Аргументы КАК Аргументы,
		| 	Шаги.Результат КАК Результат
		|ИЗ
		| 	РегистрСведений.AI_ШагиАгентскихОпераций КАК Шаги
		|ГДЕ
		| 	Шаги.ИдентификаторОперации = &ИдентификаторОперации
		| 	И Шаги.ПорядковыйНомер >= &МинимальныйНомерШага
		|УПОРЯДОЧИТЬ ПО
		| 	ПорядковыйНомер";
	Запрос.УстановитьПараметр("ИдентификаторОперации", ИдентификаторОперации);
	Запрос.УстановитьПараметр("МинимальныйНомерШага", МинимальныйНомерШага);

	Шаги = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Шаги.Добавить(Новый Структура(
			"ИдентификаторШага,ПорядковыйНомер,НомерШага,Инструмент,Статус,ДатаНачала,ДатаОкончания,ДлительностьМс,Аргументы,Результат",
			Выборка.ИдентификаторШага,
			Выборка.ПорядковыйНомер,
			Выборка.НомерШага,
			Выборка.Инструмент,
			Выборка.Статус,
			Выборка.ДатаНачала,
			Выборка.ДатаОкончания,
			Выборка.ДлительностьМс,
			Выборка.Аргументы,
			Выборка.Результат));
	КонецЦикла;
	Возврат Шаги;

КонецФункции

Функция НайтиАктивнуюОперацию(ИдентификаторДиалога, ИдентификаторПользователя)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| 	Операции.ИдентификаторОперации КАК ИдентификаторОперации
		|ИЗ
		| 	РегистрСведений.AI_АгентскиеОперации КАК Операции
		|ГДЕ
		| 	Операции.ИдентификаторДиалога = &ИдентификаторДиалога
		| 	И Операции.ИдентификаторПользователя = &ИдентификаторПользователя
		| 	И Операции.Статус В (&ВОчереди, &Выполняется, &ОтменаЗапрошена)
		|УПОРЯДОЧИТЬ ПО
		| 	Операции.ДатаСоздания УБЫВ";
	Запрос.УстановитьПараметр("ИдентификаторДиалога", ИдентификаторДиалога);
	Запрос.УстановитьПараметр("ИдентификаторПользователя", ИдентификаторПользователя);
	Запрос.УстановитьПараметр("ВОчереди", Перечисления.AI_СтатусАгентскойОперации.ВОчереди);
	Запрос.УстановитьПараметр("Выполняется", Перечисления.AI_СтатусАгентскойОперации.Выполняется);
	Запрос.УстановитьПараметр("ОтменаЗапрошена", Перечисления.AI_СтатусАгентскойОперации.ОтменаЗапрошена);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.ИдентификаторОперации, Неопределено);

КонецФункции

Процедура ПроверитьВладельцаОперации(ДанныеОперации)

	Если ДанныеОперации.ИдентификаторПользователя <> ИдентификаторТекущегоПользователя() Тогда
		ВызватьИсключение "Агентская операция принадлежит другому пользователю.";
	КонецЕсли;

КонецПроцедуры

Функция ИдентификаторТекущегоПользователя()

	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Возврат Пользователь.УникальныйИдентификатор;

КонецФункции

Функция ПолучитьСвойство(Данные, ИмяСвойства, ЗначениеПоУмолчанию)

	ЗначениеСвойства = Неопределено;
	Если Данные <> Неопределено И Данные.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
		Возврат ЗначениеСвойства;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ОбрезатьКраяСтроки(Текст)

	Результат = Строка(Текст);
	Пока СтрДлина(Результат) > 0 Цикл
		ПервыйСимвол = Лев(Результат, 1);
		Если ПервыйСимвол <> " " И ПервыйСимвол <> Символ(9) Тогда
			Прервать;
		КонецЕсли;
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Пока СтрДлина(Результат) > 0 Цикл
		ПоследнийСимвол = Прав(Результат, 1);
		Если ПоследнийСимвол <> " " И ПоследнийСимвол <> Символ(9) Тогда
			Прервать;
		КонецЕсли;
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭтоФинальныйСтатус(Статус)

	Возврат Статус = Перечисления.AI_СтатусАгентскойОперации.Завершена
		Или Статус = Перечисления.AI_СтатусАгентскойОперации.Ошибка
		Или Статус = Перечисления.AI_СтатусАгентскойОперации.Отменена;

КонецФункции
