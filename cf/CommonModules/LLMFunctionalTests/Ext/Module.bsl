// Места, карты и сценарии теста по префиксу наименования, тестовые маршруты и
// роли. Сначала места: они ссылаются на карты и сценарии.
Процедура УдалитьТестовыеОбъекты(Префикс)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Места.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.AI_МестаЗапускаСценариев КАК Места
		|ГДЕ
		|	Места.Наименование ПОДОБНО &Шаблон
		|;
		|ВЫБРАТЬ
		|	Карты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.AI_КартыИзвлечения КАК Карты
		|ГДЕ
		|	Карты.Наименование ПОДОБНО &Шаблон
		|;
		|ВЫБРАТЬ
		|	Сценарии.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.AI_Сценарии КАК Сценарии
		|ГДЕ
		|	Сценарии.Наименование ПОДОБНО &Шаблон
		|;
		|ВЫБРАТЬ
		|	Маршруты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТестовыеМаршруты КАК Маршруты
		|;
		|ВЫБРАТЬ
		|	Роли.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТестовыеРоли КАК Роли");
	Запрос.УстановитьПараметр("Шаблон", Префикс + "%");
	Для Каждого Пакет Из Запрос.ВыполнитьПакет() Цикл
		Выборка = Пакет.Выбрать();
		Пока Выборка.Следующий() Цикл
			Выборка.Ссылка.ПолучитьОбъект().Удалить();
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПолеКарты(Карта, Представление, ТабличнаяЧасть, Путь, ТипЗначения, ТипСсылки,
	ВыбиратьИзСписка = Ложь)

	Поле = Карта.Поля.Добавить();
	Поле.Представление = Представление;
	Поле.ТабличнаяЧасть = ТабличнаяЧасть;
	Поле.ПутьРеквизита = Путь;
	Поле.ТипЗначения = ТипЗначения;
	Поле.ТипСсылки = ТипСсылки;
	Поле.ПоискПоНаименованию = ЗначениеЗаполнено(ТипСсылки);
	Поле.ВыбиратьИзСписка = ВыбиратьИзСписка;

КонецПроцедуры

// Ключ поля в ответе: его выводит карта при записи.
Функция КлючПоляКарты(Карта, ТабличнаяЧасть, Путь)

	Для Каждого Поле Из Карта.Поля Цикл
		Если Поле.ТабличнаяЧасть = ТабличнаяЧасть И Поле.ПутьРеквизита = Путь Тогда
			Возврат Поле.Ключ;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В карте нет поля " + ТабличнаяЧасть + "." + Путь;

