#Область ВспомогательныеФункции

&НаСервере
Функция СН(СтрокаНавигации) //Обертка для сокращения
	Возврат СсылкаПоНавигации(СтрокаНавигации);
КонецФункции

&НаСервере
Функция НС(Ссылка)
	Возврат ПолучитьНавигационнуюСсылку(Ссылка)
КонецФункции


&НаСервере
Функция СсылкаПоНавигации(СтрокаНавигации)
    
    ПерваяТочка = Найти(СтрокаНавигации, "e1cib/data/");
    ВтораяТочка = Найти(СтрокаНавигации, "?ref=");
    
    ПредставлениеТипа   = Сред(СтрокаНавигации, ПерваяТочка + 11, ВтораяТочка - ПерваяТочка - 11);
    ШаблонЗначения = ЗначениеВСтрокуВнутр(ПредопределенноеЗначение(ПредставлениеТипа + ".ПустаяСсылка"));
    ЗначениеСсылки = СтрЗаменить(ШаблонЗначения, "00000000000000000000000000000000", Сред(СтрокаНавигации, ВтораяТочка + 5));
    Ссылка = ЗначениеИзСтрокиВнутр(ЗначениеСсылки);
	
	Возврат Ссылка;
	
КонецФункции


&НаКлиенте
Процедура Закомментировать(Команда)
	Перем ПерваяСтрока, ПерваяКолонка, ПоследняяСтрока, ПоследняяКолонка;
	
	Элемент = Элементы.ПроизвольныйКод;
	Элемент.ПолучитьГраницыВыделения(ПерваяСтрока, ПерваяКолонка, ПоследняяСтрока, ПоследняяКолонка);

	ТекстДоИзменения = ПроизвольныйКод.ПолучитьТекст();
	КоличествоСтрок = СтрЧислоСтрок(ТекстДоИзменения);
	ВыделенныйФрагмент = "";
	ДлинаПоследнейСтроки = 0;
	
	Если ПоследняяКолонка = 1 Тогда 
		ПоследняяСтрока = ПоследняяСтрока - 1;
	КонецЕсли;
	Если ПерваяСтрока >= ПоследняяСтрока И ПоследняяКолонка = 1 Тогда 
		ПоследняяКолонка = СтрДлина(СтрПолучитьСтроку(ТекстДоИзменения, ПерваяСтрока));
		ПоследняяСтрока = ПерваяСтрока;
	КонецЕсли;
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		Фрагмент = СтрПолучитьСтроку(ТекстДоИзменения, НомерСтроки);
		Если НомерСтроки >= ПерваяСтрока И НомерСтроки <= ПоследняяСтрока Тогда
			Если НомерСтроки = ПерваяСтрока Тогда 
				ВыделенныйФрагмент = ВыделенныйФрагмент + "//" + Фрагмент;
			Иначе
				ВыделенныйФрагмент = ВыделенныйФрагмент + Символы.ПС + "//" +Фрагмент;
			КонецЕсли;
			Если НомерСтроки = ПоследняяСтрока Тогда 
				ДлинаПоследнейСтроки = СтрДлина(Фрагмент) + 3;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ПоследняяКолонка = 1 Тогда 
		ПоследняяСтрока = ПоследняяСтрока + 1;
		ДлинаПоследнейСтроки = 1;
		ВыделенныйФрагмент =  ВыделенныйФрагмент + Символы.ПС;
	КонецЕсли;

	Элемент.УстановитьГраницыВыделения(ПерваяСтрока, 1, ПоследняяСтрока, ДлинаПоследнейСтроки);
	Элемент.ВыделенныйТекст = ВыделенныйФрагмент;
	Элемент.УстановитьГраницыВыделения(ПерваяСтрока, 1, ПоследняяСтрока, ДлинаПоследнейСтроки);
КонецПроцедуры


&НаКлиенте
Процедура Раскомментировать(Команда)
	Перем ПерваяСтрока, ПерваяКолонка, ПоследняяСтрока, ПоследняяКолонка;
	Элемент = Элементы.ПроизвольныйКод;
	Элемент.ПолучитьГраницыВыделения(ПерваяСтрока, ПерваяКолонка, ПоследняяСтрока, ПоследняяКолонка);
	
	ТекстДоИзменения = ПроизвольныйКод.ПолучитьТекст();
	КоличествоСтрок = СтрЧислоСтрок(ТекстДоИзменения);
	ВыделенныйФрагмент = "";
	ДлинаПоследнейСтроки = ПоследняяКолонка;
	
	Если ПоследняяКолонка = 1 Тогда 
		ПоследняяСтрока = ПоследняяСтрока - 1;
	КонецЕсли;
	Если ПерваяСтрока >= ПоследняяСтрока И ПоследняяКолонка = 1 Тогда 
		ПоследняяКолонка = СтрДлина(СтрПолучитьСтроку(ТекстДоИзменения, ПерваяСтрока));
		ПоследняяСтрока = ПерваяСтрока;
	КонецЕсли;

	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		Фрагмент = СтрПолучитьСтроку(ТекстДоИзменения, НомерСтроки);
		Если НомерСтроки >= ПерваяСтрока И НомерСтроки <= ПоследняяСтрока Тогда
			Если Лев(СокрЛ(Фрагмент), 2) = "//" Тогда
				Позиция = Найти(Фрагмент, "//");
				Фрагмент = Лев(Фрагмент, Позиция - 1) + Сред(Фрагмент, Позиция + 2);
			КонецЕсли;
			Если НомерСтроки = ПерваяСтрока Тогда 
				ВыделенныйФрагмент = ВыделенныйФрагмент + Фрагмент;
			Иначе
				ВыделенныйФрагмент = ВыделенныйФрагмент + Символы.ПС + Фрагмент;
			КонецЕсли;
			Если НомерСтроки = ПоследняяСтрока Тогда 
				ДлинаПоследнейСтроки = СтрДлина(Фрагмент) + 3;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ПоследняяКолонка = 1 Тогда 
		ПоследняяСтрока = ПоследняяСтрока + 1;
		ДлинаПоследнейСтроки = 1;
		ВыделенныйФрагмент =  ВыделенныйФрагмент + Символы.ПС;
	КонецЕсли;

	Элемент.УстановитьГраницыВыделения(ПерваяСтрока, 1, ПоследняяСтрока, ДлинаПоследнейСтроки);
	Элемент.ВыделенныйТекст = ВыделенныйФрагмент;
	Элемент.УстановитьГраницыВыделения(ПерваяСтрока, 1, ПоследняяСтрока, ДлинаПоследнейСтроки);
КонецПроцедуры


&НаСервере
Функция ПолнаяКопияОбъекта(ОбъектИсточник)
	
	МетаданныеОбъекта = ОбъектИсточник.Метаданные();
	
	КопияОбъекта = ОбъектИсточник.Скопировать();
	
	ЗаполнитьЗначенияСвойств(КопияОбъекта, ОбъектИсточник);
	
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		
		КопияОбъекта[ТабличнаяЧасть.Имя].Загрузить(ОбъектИсточник[ТабличнаяЧасть.Имя].Выгрузить());
		
	КонецЦикла;
	
	Возврат КопияОбъекта;
	
КонецФункции

#КонецОбласти 

#Область ОБРАБОТЧИКИ_ОПОВЕЩЕНИЙ

&НаКлиентеНаСервереБезКонтекста
Функция ТекстДляКонфигуратора(Текст)
	
	Результат = """";
	ПереводСтроки = Символы.ВК+Символы.ПС;
	Для Счетчик = 1 По СтрЧислоСтрок(Текст) Цикл
		ТекСтрока = СтрПолучитьСтроку(Текст, Счетчик);
		Если Счетчик > 1 Тогда 
			ТекСтрока = СтрЗаменить(ТекСтрока,"""","""""");
			Результат = Результат + ПереводСтроки + "|"+ ТекСтрока;
		Иначе
			ТекСтрока = СтрЗаменить(ТекСтрока,"""","""""");
			Результат = Результат + ТекСтрока;
		КонецЕсли;
	КонецЦикла;
	Результат = Результат + """";
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеВводаМассиваДанных(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		РезультатОбработки = "МногомернаяСтрока = " + Символы.ПС;
		ИтогОбработки = ТекстДляКонфигуратора(Результат);
		
		Итог = РезультатОбработки + ИтогОбработки + ";";
		Итог = Итог + "
		|
		|МассивДанных	= СтрРазделить(МногомернаяСтрока, Символы.ПС, Истина);
		|
		|Для Каждого ДанныеИзМассива Из МассивДанных Цикл
		|	Сообщить(ДанныеИзМассива);
		|КонецЦикла;";
		
		ПоказатьВводСтроки(Новый ОписаниеОповещения, Итог,,, Истина);
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеПодтвержденияЗамены(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) И Результат = КодВозвратаДиалога.Да Тогда
		
		ТекущиеДанные =  Элементы.ДеревоАлгоритмов.ТекущиеДанные;
		
		ТекущиеДанные.Код = ПроизвольныйКод.ПолучитьТекст();
		
		СохранитьАлгоритмы();
		
		Состояние("Заменено");
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		
		Состояние("Отменено");
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеПодтвержденияУдаленияГруппы(Результат, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = Элементы.ДеревоАлгоритмов.ТекущиеДанные;
	
	Если Результат = КодВозвратаДиалога.Нет ИЛИ НЕ ТекущиеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьГруппуНаСервере(ТекущиеДанные.УИД);
	
	СохранитьАлгоритмы();
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеВводаИмениГруппы(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьУзелДереваАлгоритмов(Результат);
	
	СохранитьАлгоритмы();
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеПодтвержденияУдаления(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	УИД = Элементы.ДеревоАлгоритмов.ТекущиеДанные.УИД;
	
	УдалитьАлгоритмНаСервере(УИД);
	
	СохранитьАлгоритмы();
	
	Состояние("Удалено");
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеВводаНазванияАлгоритма(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	НовыйАлгоритм = Новый Структура("ИмяАлгоритма, УИД, Код");
	НовыйАлгоритм.ИмяАлгоритма = Результат;
	НовыйАлгоритм.УИД = Новый УникальныйИдентификатор;
	НовыйАлгоритм.Код = ПроизвольныйКод.ПолучитьТекст();
	
	ТекущиеДанные = Элементы.ДеревоАлгоритмов.ТекущиеДанные;
	
	ДеталиДобавления	= Новый Структура("УИД, ЭтоГруппа") ;
	ЗаполнитьЗначенияСвойств(ДеталиДобавления, ТекущиеДанные);
	
	ДобавитьАлгоритмВУзел(НовыйАлгоритм, ДеталиДобавления);
	
	СохранитьАлгоритмы();
	
	Состояние("Алгоритм записан");
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеПоискаФайлов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Количество() > 0 Тогда
		
		ДД = Новый ДвоичныеДанные(Результат[0].ПолноеИмя);
		
		Адрес = ПоместитьВоВременноеХранилище(ДД, ЭтаФорма.УникальныйИдентификатор);
		
		ЗагрузитьАлгоритмыНаСервере(Адрес);
		
	КонецЕсли;
	
	ПутьКПоследнемуВыполняемомуКоду = ПапкаИсполнения + "last_execution";
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУтвержденияПодгрузкиПрошлогоКода(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Файл = Новый ТекстовыйДокумент;
		Файл.Прочитать(ПутьКПоследнемуВыполняемомуКоду);
		ПроизвольныйКод.УстановитьТекст(ЗначениеВИзСтроки(Файл.ПолучитьТекст(), Ложь));
		
		УдалитьФайлы(ПутьКПоследнемуВыполняемомуКоду);
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		
		УдалитьФайлы(ПутьКПоследнемуВыполняемомуКоду);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКаталога(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		ПапкаИсполнения = Результат[0];
		
		ДанныеЛокальногоПутиИзСервера(ПапкаИсполнения + "\");
		
		ПутьКПоследнемуВыполняемомуКоду = ПапкаИсполнения + "last_execution";
		
		ПриОткрытии(Ложь, Истина);
		
	Иначе
		
		Сообщить("Выбор каталога отменен.");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПРОЧИЕ


&НаКлиенте 
Функция ВернутьТекстHTML(пСтрокаКода, пРежим)
	
	КлючевыеСлова1 = ВернутьСтрокуКлючевыхСлов(пРежим, 1);
	КлючевыеСлова2 = ВернутьСтрокуКлючевыхСлов(пРежим, 2);
	
	Если пРежим = 0 Тогда 	//Встроенный язык
		ЦветПоУмолчанию 	= "blue";
		ЦветОператоры 		= "red";
		ЦветКлючевыеСлова 	= "red";
		ЦветКомментарии 	= "green";
		ЦветИнструкции		= "brown";
		ЦветДирективы		= "brown";
		ЦветСтроки			= "black";
		ЦветЧисла			= "black";
		ЦветДаты			= "black";
	Иначе					//Текст запроса
		ЦветПоУмолчанию 	= "black";
		ЦветОператоры 		= "red";
		ЦветКлючевыеСлова1 	= "blue";
		ЦветКлючевыеСлова2 	= "brown";
		ЦветКомментарии 	= "green";
		ЦветСтроки			= "red";
		ЦветЧисла			= "magenta";
		ЦветПараметры		= "darkcyan";
	КонецЕсли;
	
	//Назначаем стили для редактирования
	Документ = Элементы.Предпросмотр.Документ;
	Документ.body.style.fontfamily 		= "Courier New";
	Документ.body.style.fontsize 		= "10pt";
	Документ.body.style.color 			= ЦветПоУмолчанию;
	Документ.body.style.margintop 		= "0em";
	Документ.body.style.marginbottom 	= "0em";
	
	ЦветнойТекст = пСтрокаКода;
	
	RegExp = Новый ComОбъект("VBScript.RegExp");
	RegExp.Global = Истина;
	RegExp.IgnoreCase = Истина;
	RegExp.Multiline = Истина;

	//Заменяем < на &lt;
	RegExp.Pattern = "<";
	ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "&lt;");
	
	Если пРежим = 0 Тогда
	
		//Строки
		RegExp.Pattern = "(?:\x22(?:[^\x22]|\x22\x22)*?\x22)";
		RegExp.Pattern = RegExp.Pattern + "|(?:\x22(?:[^\x22]|\x22\x22)*?$)"; //Неоконченная строка
		//Комментарии
		RegExp.Pattern = RegExp.Pattern + "|(?://.*$)"; 
		//Инструкции препроцессору
		RegExp.Pattern = RegExp.Pattern + "|(?:\#.*$)";
		//Директивы компиляции
		RegExp.Pattern = RegExp.Pattern + "|(?:\&(?!lt;).*$)";
		//Даты
		RegExp.Pattern = RegExp.Pattern + "|(?:'[^']*?')";
		//Операторы
		RegExp.Pattern = RegExp.Pattern + "|(?:\&lt;)|(?:[\/\,\;\-\%\<\>\?\(\)\*\+\:\[\]\.\=])";
		//Числа
		RegExp.Pattern = RegExp.Pattern + "|(?:\s|^)(?:\d+\.?\d*)";
		//Ключевые слова
		RegExp.Pattern = RegExp.Pattern + "|(?:\s|^)(?:" + КлючевыеСлова1 + ")(?![a-zа-я0-9_]|\.)";
		
		RegExp.Pattern = "(" + RegExp.Pattern + ")";
		
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<font color=red>$1</font>");
		
		//Заменяем строки
		RegExp.Pattern = "<font color=red>(\x22[\s\S]*?)</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<font color=" + ЦветСтроки + ">$1</font>");
		
		//Заменяем комментарии
		RegExp.Pattern = "<font color=red>(/.*?)</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<font color=" + ЦветКомментарии + ">$1</font>");
		
		//Заменяем числа
		RegExp.Pattern = "<font color=red>([\s|^]?)(\d.*?)</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "$1<font color=" + ЦветЧисла + ">$2</font>");
		
		//Заменяем директивы
		RegExp.Pattern = "<font color=red>(&(?!lt;).*?)</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<font color=" + ЦветДирективы + ">$1</font>");
		
		//Заменяем инструкции
		RegExp.Pattern = "<font color=red>(#.*?)</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<font color=" + ЦветИнструкции + ">$1</font>");
		
		//Заменяем ключевые слова
		RegExp.Pattern = "<font color=red>(\s+)(.*?)</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "$1<font color=" + ЦветКлючевыеСлова + ">$2</font>");
		
	Иначе
		
		//Комментарии
		RegExp.Pattern = "(?://.*$)";
		//Строки
		RegExp.Pattern = RegExp.Pattern + "|(?:\x22(?:[^\x22$]|\x22\x22)*?\x22)";
		RegExp.Pattern = RegExp.Pattern + "|(?:\x22(?:[^\x22$]|\x22\x22)*?$)";
		//Ключевые слова 1
		RegExp.Pattern = RegExp.Pattern + "|(?:\s|^)(?:" + КлючевыеСлова1 + ")(?![a-zа-я0-9_\.])";
		//Ключевые слова 2
		RegExp.Pattern = RegExp.Pattern + "|(?:\s|^)(?:" + КлючевыеСлова2 + ")(?![a-zа-я0-9_\.])";
		//Операторы1
		СтрокаОператоров1 = "\;\%\?\:\[\]\\`~!@\$^\|";
		RegExp.Pattern = RegExp.Pattern + "|(?:[" + СтрокаОператоров1 + "])";
		//Операторы2
		СтрокаОператоров2 = "\+|-|\*|/|=|&lt;|>|,|\(|\)|=";
		RegExp.Pattern = RegExp.Pattern + "|(?:" + СтрокаОператоров2 + ")";
		//Параметры
		RegExp.Pattern = RegExp.Pattern + "|(?:&[a-zа-я0-9_]*)";
		//Числа
		RegExp.Pattern = RegExp.Pattern + "|(?:\s|^)(?:\d+\.?\d*)";
		
		RegExp.Pattern = "(" + RegExp.Pattern + ")";
		
		//Выполняем основное преобразование
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<font color=red>$1</font>");
		
		//Заменяем комментарии
		RegExp.Pattern = "<font color=red>(/.*?)</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<font color=" + ЦветКомментарии + ">$1</font>");
		
		//Заменяем строки
		RegExp.Pattern = "<font color=red>(\x22.*?)</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<font color=" + ЦветСтроки + ">$1</font>");
		
		//Заменяем числа
		RegExp.Pattern = "<font color=red>([\s|^]?)(\d.*?)</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "$1<font color=" + ЦветЧисла + ">$2</font>");
		
		//Заменяем ключевые слова 1
		RegExp.Pattern = "<font color=red>(\s*)(" + КлючевыеСлова1 + ")</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "$1<font color=" + ЦветКлючевыеСлова1 + ">$2</font>");
		
		//Заменяем ключевые слова 2
		RegExp.Pattern = "<font color=red>(\s*)(" + КлючевыеСлова2 + ")</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "$1<font color=" + ЦветКлючевыеСлова2 + ">$2</font>");
		
		//Заменяем операторы 2
		RegExp.Pattern = "<font color=red>(" + СтрокаОператоров2 + ")</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<font color=" + ЦветКлючевыеСлова1 + ">$1</font>");
		
		//Заменяем параметры
		RegExp.Pattern = "<font color=red>(&[a-zа-я0-9_]*)</font>";
		ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<font color=" + ЦветПараметры + ">$1</font>");
		
	КонецЕсли;
	
	//Заменяем переводы строки
	RegExp.Pattern = Символы.ПС;
	ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "<br>");
	
	//Заменяем табуляцию четырьмя &nbsp;
	RegExp.Pattern = "\t";
	ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "&nbsp;&nbsp;&nbsp;&nbsp;");
	
	//Заменяем четыре пробела четырьмя &nbsp;
	RegExp.Pattern = "    ";
	ЦветнойТекст = RegExp.Replace(ЦветнойТекст, "&nbsp;&nbsp;&nbsp;&nbsp;");
	
	Возврат ЦветнойТекст;
	
КонецФункции //ВернутьТекстHTML


&НаКлиенте
Функция ВернутьСтрокуКлючевыхСлов(пРежим, пНомер)
	
	Если пРежим = 0 И пНомер = 1 Тогда
		
		СтрокаКлючевыхСлов = "";
		//Циклы
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "для|каждого|по|из|пока|цикл|продолжить|прервать|конеццикла";
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|for|each|to|in|while|do|continue|break|enddo";
		//Условия
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|если|тогда|иначеесли|иначе|конецесли";
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|if|then|elsif|else|endif";
		//Функции/процедуры/переменные
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|процедура|функция|знач|экспорт|перем|возврат|конецпроцедуры|конецфункции";
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|procedure|function|val|export|var|return|endprocedure|endfunction";
		//Булевые операции
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|и|или|не";
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|and|or|not";
		//Примитивные типы
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|истина|ложь|null|неопределено";
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|true|false|null|undefined";
		//Попытка/исключение
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|попытка|исключение|вызватьисключение|конецпопытки";
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|try|except|raise|endtry";
		//Прочие операторы
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|выполнить|новый|перейти|добавитьобработчик|удалитьобработчик";
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|execute|new|goto|addhandler|removehandler";
		
		Возврат СтрокаКлючевыхСлов;
		
	ИначеЕсли пРежим = 0 И пНомер = 2 Тогда
		
		Возврат "";
		
	ИначеЕсли пРежим = 1 И пНомер = 1 Тогда
		
		СтрокаКлючевыхСлов = "";
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "ВЫБРАТЬ|РАЗЛИЧНЫЕ|ПЕРВЫЕ|ИЗ|ГДЕ|КАК|УПОРЯДОЧИТЬ|ПО|АВТОУПОРЯДОЧИВАНИЕ|СГРУППИРОВАТЬ|ИТОГИ|ОБЩИЕ|ЛЕВОЕ|ПРАВОЕ|ПОЛНОЕ|ВНЕШНЕЕ|ВНУТРЕННЕЕ|СОЕДИНЕНИЕ|УБЫВ|ВОЗР|ИМЕЮЩИЕ|ОБЪЕДИНИТЬ|ВСЕ|ДЛЯ|ИЗМЕНЕНИЯ|ПОМЕСТИТЬ|ИНДЕКСИРОВАТЬ|УНИЧТОЖИТЬ|БУЛЕВО|ЧИСЛО|ТОЛЬКО|ИЕРАРХИЯ|ПЕРИОДАМИ";
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|ЗНАЧЕНИЕ|ТИП|РАЗЛИЧНЫЕ|ТИПЗНАЧЕНИЯ";
		Возврат СтрокаКлючевыхСлов;
		
	ИначеЕсли пРежим = 1 И пНомер = 2 Тогда
		
		СтрокаКлючевыхСлов = "";
		//Функции работы со строками
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "ПОДСТРОКА";
		//Функции работы с датами
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|ГОД|КВАРТАЛ|МЕСЯЦ|ДЕНЬГОДА|ДЕНЬ|НЕДЕЛЯ|ДЕНЬНЕДЕЛИ|ЧАС|МИНУТА|СЕКУНДА|НАЧАЛОПЕРИОДА|КОНЕЦПЕРИОДА|ДОБАВИТЬКДАТЕ|РАЗНОСТЬДАТ|ДАТАВРЕМЯ";
        //Агрегатные функции
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|СУММА|МИНИМУМ|МАКСИМУМ|СРЕДНЕЕ|КОЛИЧЕСТВО";
		//Прочие функции
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|ЕСТЬNULL|ПРЕДСТАВЛЕНИЕ|ПРЕДСТАВЛЕНИЕССЫЛКИ|СПЕЦСИМВОЛ";
        //Логические операторы
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|И|ИЛИ|НЕ|ПОДОБНО|В|ИЕРАРХИИ|МЕЖДУ|ЕСТЬ|ССЫЛКА";
		//Прочие операторы
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|ВЫБОР|КОГДА|ТОГДА|ИНАЧЕ|КОНЕЦ|ВЫРАЗИТЬ";
		//Константы
		СтрокаКлючевыхСлов = СтрокаКлючевыхСлов + "|ИСТИНА|ЛОЖЬ|NULL|НЕОПРЕДЕЛЕНО";
		
		Возврат СтрокаКлючевыхСлов
		
	КонецЕсли;
	
КонецФункции //ВернутьСтрокуКлючевыхСлов


