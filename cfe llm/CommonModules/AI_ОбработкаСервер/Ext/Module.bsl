
#Область ПрограммныйИнтерфейс

Процедура ОбработкаОчереди() Экспорт

	КоличествоПопытокОбработки = Константы.AI_КоличествоПопытокОбработкиЗапросаОчереди.Получить();
	Если КоличествоПопытокОбработки = 0 Тогда
		КоличествоПопытокОбработки = 5;
	КонецЕсли;

	КоличествоВсехПотоков = Константы.AI_КоличествоПотоковОбработкиОчереди.Получить();
	Если КоличествоВсехПотоков = 0 Тогда
		КоличествоВсехПотоков = 4;
	КонецЕсли;

	// Вернуть зависшие "ВОбработке" записи (старше 60 мин) обратно в статус "Новый"
	ВернутьЗависшиеЗаписи();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	AI_ОчередьЗапросов.Дата КАК Дата,
		|	AI_ОчередьЗапросов.УникальныйИдентификатор КАК УникальныйИдентификатор,
		|	AI_ОчередьЗапросов.Провайдер.МаксКоличествоПотоков КАК ПровайдерМаксКоличествоПотоков,
		|	AI_ОчередьЗапросов.Провайдер.ЛимитRPM КАК ПровайдерЛимитRPM,
		|	AI_ОчередьЗапросов.Провайдер.ЛимитТокеновВСутки КАК ПровайдерЛимитТокеновВСутки,
		|	AI_ОчередьЗапросов.Провайдер КАК Провайдер
		|ИЗ
		|	РегистрСведений.AI_ОчередьЗапросов КАК AI_ОчередьЗапросов
		|ГДЕ
		|	AI_ОчередьЗапросов.Статус = &СтатусНовый
		|	И AI_ОчередьЗапросов.КоличествоОшибок < &МаксПопыток
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата
		|ИТОГИ
		|	МАКСИМУМ(ПровайдерМаксКоличествоПотоков),
		|	МАКСИМУМ(ПровайдерЛимитRPM),
		|	МАКСИМУМ(ПровайдерЛимитТокеновВСутки)
		|ПО
		|	Провайдер";

	Запрос.УстановитьПараметр("СтатусНовый", Перечисления.AI_СтатусОчереди.Новый);
	Запрос.УстановитьПараметр("МаксПопыток", КоличествоПопытокОбработки);

	ОбходПровайдеров = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	МассивПорций = Новый Массив;

	Пока ОбходПровайдеров.Следующий() Цикл

		ВыборкаЗапросов = ОбходПровайдеров.Выбрать();

		// Доступно ограничение из провайдера по количеству потоков
		ОграничениеПровайдераПоКоличествуПотоков = ОбходПровайдеров.ПровайдерМаксКоличествоПотоков;
		Если ОграничениеПровайдераПоКоличествуПотоков = 0
				ИЛИ ВыборкаЗапросов.Количество() <= 5 Тогда // Если меньше 5 запросов, то не имеет смысла в многопоточной обработке. IMHO
			ОграничениеПровайдераПоКоличествуПотоков = 1;
		КонецЕсли;

		// Лимит RPM: 0 = без ограничения
		ЛимитRPM = ОбходПровайдеров.ПровайдерЛимитRPM;

		// Лимит токенов в сутки: 0 = без ограничения
		ЛимитТокеновВСутки = ОбходПровайдеров.ПровайдерЛимитТокеновВСутки;
		Если ЛимитТокеновВСутки > 0 Тогда
			РасходЗаСегодня = ПолучитьРасходТокеновЗаСегодня(ОбходПровайдеров.Провайдер);
			Если РасходЗаСегодня >= ЛимитТокеновВСутки Тогда
				ЗаписьЖурналаРегистрации(
					"AI_ЛимитТокенов",
					УровеньЖурналаРегистрации.Предупреждение, , ОбходПровайдеров.Провайдер,
					СтрШаблон(
						"Превышен суточный лимит токенов: %1 из %2 — обработка провайдера пропущена",
						РасходЗаСегодня, ЛимитТокеновВСутки));
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		// Атомарно захватываем записи — в обработку уходят только успешно захваченные.
		// Если параллельный РЗ успел захватить запись первым — она пропускается.
		МассивЗахваченных = Новый Массив;
		Пока ВыборкаЗапросов.Следующий() Цикл
			// Соблюдаем лимит RPM провайдера (0 = без лимита)
			Если ЛимитRPM > 0 И МассивЗахваченных.Количество() >= ЛимитRPM Тогда
				Прервать;
			КонецЕсли;
			Если РегистрыСведений.AI_ОчередьЗапросов.ЗафиксироватьНачалоОбработки(
					ВыборкаЗапросов.УникальныйИдентификатор) Тогда
				МассивЗахваченных.Добавить(ВыборкаЗапросов.УникальныйИдентификатор);
			КонецЕсли;
		КонецЦикла;

		Если МассивЗахваченных.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Разбивка захваченных записей на порции для фоновых заданий
		МассивПорции = Новый Массив;
		МаксКоличествоВПорции = Макс(1, Цел(МассивЗахваченных.Количество() / ОграничениеПровайдераПоКоличествуПотоков));

		Для Каждого Идентификатор Из МассивЗахваченных Цикл
			МассивПорции.Добавить(Идентификатор);
			Если МассивПорции.Количество() >= МаксКоличествоВПорции Тогда
				МассивПорций.Добавить(МассивПорции);
				МассивПорции = Новый Массив;
			КонецЕсли;
		КонецЦикла;

		// Добавить остаток (последняя неполная порция)
		Если МассивПорции.Количество() > 0 Тогда
			МассивПорций.Добавить(МассивПорции);
		КонецЕсли;

	КонецЦикла;

	ПараметрыМенеджера	= ПараметрыМенеджераЗаданий();
	ПараметрыМенеджера.Вставить("ЗапускаемаяПроцедура"	, "AI_ОбработкаСервер.ОбработатьПорциюЗапроса");
	ПараметрыМенеджера.Вставить("НаименованиеЗадания"	, "Обработка запросов к нейросетям");
	ПараметрыМенеджера.Вставить("ПорцииДанных"			, МассивПорций);
	ПараметрыМенеджера.Вставить("КоличествоПотоков"		, КоличествоВсехПотоков);

	РезультатРаботыМенеджера = ОжидатьЗавершенияМенеджераФоновыхЗаданий(ПараметрыМенеджера, 5);

КонецПроцедуры

