&НаКлиенте
Процедура ВизуальныйКонструкторВыбор(Элемент, Область, СтандартнаяОбработка)
	ВизуальныйКонструкторВыборНаСервере();
КонецПроцедуры

#КонецОбласти 

#Область ОБРАБОТЧИКИ_КОМАНД


&НаКлиенте
Процедура ВизуальныйКонструктор_ВыполнитьПроизвольныйЗапрос(Команда)
	
	ОтмеченныеТаблицы = Новый Массив;
	
	Для Каждого Таблица ИЗ ВизуальныйКонструктор_ДанныеПостроения Цикл
		
		Если ОтмеченныеТаблицы.Найти(Таблица.ИмяТаблицы) = НЕОПРЕДЕЛЕНО Тогда
			ОтмеченныеТаблицы.Добавить(Таблица.ИмяТаблицы);
		КонецЕсли;
		
	КонецЦикла;
	
	ТабличныйДокумент = ВизуальныйКонструктор_ОбработатьЗапрос(ОтмеченныеТаблицы);
	
	ОткрытьФорму("ВнешняяОбработка.УниверсальнаяОбработка.Форма.ФормаРезультатаСоединения", Новый Структура("Результат", ТабличныйДокумент), ЭтаФорма);
	
КонецПроцедуры


&НаКлиенте
Процедура ВизуальныйКонструктор_ВыполнитьЗапрос(Команда)
	
	ДанныеПоложенийТаблиц = ВизуальныйКонструктор_ДанныеПостроения.НайтиСтроки(Новый Структура("ИмяСвойства", "Границы"));
	
	МассивТаблиц = Новый Массив;
	МассивПолей = Новый Массив;
	
	// Получить список таблиц и полей
	Для Каждого ДанныеТаблицы Из ДанныеПоложенийТаблиц Цикл
		
		МассивТаблиц.Добавить(ДанныеТаблицы.ИмяТаблицы);
		
		Граница = ПолучитьГраницыТаблицы(ДанныеТаблицы.Значение);
		
		Для Индекс = Граница.Лево По Граница.Право Цикл
			
			ИмяПоля = СокрЛП(ВизуальныйКонструктор.Область(Граница.Верх, Индекс).Текст);
			ИмяПоля = СтрШаблон("%1.%2", ДанныеТаблицы.ИмяТаблицы, ИмяПоля);
			
			МассивПолей.Добавить(ИмяПоля);
			
		КонецЦикла;
		
	КонецЦикла;
		
	Оповещение = Новый ОписаниеОповещения("ВизуальныйКонструктор_ПослеУтвержденияПолей", ЭтаФорма);
	
	ОткрытьФорму("ВнешняяОбработка.УниверсальнаяОбработка.Форма.ФормаРезультатаСоединения", Новый Структура("Таблицы, Поля", МассивТаблиц, МассивПолей), ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ВизуальныйКонструктор_ОтметитьСвязь(Команда)
	
	ТипСвязи = "ВНУТРЕННЕЕ";
	
	ТаблицаСвязи1	= "";
	ТаблицаСвязи2	= "";
	
	ПолеСвязи1		= "";
	ПолеСвязи2		= "";
	
	ПометкаБудет = НЕ Элементы.ВизуальныйКонструктор_ОтметитьСвязь.Пометка;
	
	РежимУстановкиСвязи(ПометкаБудет);
	
	ВизуальныйКонструктор_РежимУстановкиСвязи = Истина;
	
	ВизуальныйКонструктор_КоличествоЭлементовТекущейСвязи = 0;
	
КонецПроцедуры


&НаКлиенте
Процедура ВизуальныйКонструктор_ОтображатьЗапрос(Команда)
	Элементы.ВизуальныйКонструктор_ОтображатьЗапрос.Пометка = НЕ Элементы.ВизуальныйКонструктор_ОтображатьЗапрос.Пометка;
	Элементы.ГруппаСлужебнаяИнформация.Видимость = Элементы.ВизуальныйКонструктор_ОтображатьЗапрос.Пометка;
КонецПроцедуры


&НаКлиенте
Процедура ВизуальныйКонструктор_ВыделитьТаблицу(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаИмениТаблицыДляВизуальногоРедактора", ЭтаФорма);
	
	ИмяТаблицыПредложенное = ПолучитьУникальноеИмя();
	
	ПоказатьВводСтроки(Оповещение, ИмяТаблицыПредложенное, "Введите имя таблицы");
	
КонецПроцедуры


&НаКлиенте
Процедура ВизуальныйКонструктор_Сброс(Команда)
	
	ОчиститьСообщения();
	
	ВизуальныйКонструктор_СбросНаСервере();
	
КонецПроцедуры

#КонецОбласти 

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ


&НаСервере
Процедура РежимУстановкиСвязи(Установить)
	
	ВизуальныйКонструктор_РежимУстановкиСвязи = Установить;
	
	ВизуальныйКонструктор_КоличествоЭлементовТекущейСвязи = 0;
	
	Элементы.ВизуальныйКонструктор_ОтметитьСвязь.Пометка = Установить;
	
	Элементы.ТипСвязи.Видимость = Установить;
	
	Если Установить Тогда
		Элементы.ВизуальныйКонструктор_ОтметитьСвязь.ЦветФона = ЦветаСтиля.ЦветРамки;
	Иначе
		Элементы.ВизуальныйКонструктор_ОтметитьСвязь.ЦветФона = ЦветаСтиля.ЦветФонаКнопки;
	КонецЕсли;
	
	Элементы.ВизуальныйКонструктор.Редактирование = НЕ Установить;
	
КонецПроцедуры


&НаСервере
Процедура ВизуальныйКонструкторВыборНаСервере()
	
	ТекущаяОбласть = Элементы.ВизуальныйКонструктор.ТекущаяОбласть;
	
	Если ВизуальныйКонструктор_РежимУстановкиСвязи И ВизуальныйКонструктор_КоличествоЭлементовТекущейСвязи <= 1 Тогда
		
		// Определяем к какой таблице относится данная ячейка и записываем в данные построения
		ИмяТаблицы = ОпределитьТаблицу(ТекущаяОбласть);
		Если Не ЗначениеЗаполнено(ИмяТаблицы) Тогда
			РежимУстановкиСвязи(Ложь);
			Возврат;
		КонецЕсли;
		
		ТекущаяОбласть.ЦветФона = ЦветаСтиля.ЦветВажного;
		
		Если ВизуальныйКонструктор_КоличествоЭлементовТекущейСвязи = 0 Тогда
			ТаблицаСвязи1	= ИмяТаблицы;
			ПолеСвязи1		= ТекущаяОбласть.Текст
		Иначе
			ТаблицаСвязи2	= ИмяТаблицы;
			ПолеСвязи2		= ТекущаяОбласть.Текст;
		КонецЕсли;
		
		Если ВизуальныйКонструктор_КоличествоЭлементовТекущейСвязи = 1 Тогда
			
			НоваяСвязь = ВизуальныйКонструктор_ДанныеСвязей.Добавить();
			
			НоваяСвязь.Таблица1			= ТаблицаСвязи1;
			НоваяСвязь.Таблица2			= ТаблицаСвязи2;
			НоваяСвязь.ТипСоединения	= ТипСвязи;
			НоваяСвязь.ПолеСвязи1		= ПолеСвязи1;
			НоваяСвязь.ПолеСвязи2		= ПолеСвязи2;
			
			РежимУстановкиСвязи(Ложь);
			Сообщить("Соединение записано");
			
		Иначе
			ВизуальныйКонструктор_КоличествоЭлементовТекущейСвязи = ВизуальныйКонструктор_КоличествоЭлементовТекущейСвязи + 1;
		КонецЕсли;
		
	ИначеЕсли НЕ ВизуальныйКонструктор_РежимУстановкиСвязи Тогда
		
		РежимУстановкиСвязи(Ложь);
		
	ИначеЕсли ВизуальныйКонструктор_КоличествоЭлементовТекущейСвязи = 2 Тогда
		
		РежимУстановкиСвязи(Ложь);
		// Фиксация связи
		
	КонецЕсли;
		
КонецПроцедуры


&НаСервере
Функция ОпределитьТаблицу(ТекущаяОбласть)
	
	ДанныеПоложенийТаблиц = ВизуальныйКонструктор_ДанныеПостроения.НайтиСтроки(Новый Структура("ИмяСвойства", "Границы"));
	
	ТекущаяВерх = ТекущаяОбласть.Верх;
	ТекущаяЛево = ТекущаяОбласть.Лево;
	
	Для Каждого ДанныеГраниц Из ДанныеПоложенийТаблиц Цикл
		
		Граница = ПолучитьГраницыТаблицы(ДанныеГраниц.Значение);
		
		Если ТекущаяВерх = Граница.Верх И (ТекущаяЛево >= Граница.Лево И ТекущаяЛево <= Граница.Право) Тогда
			Возврат ДанныеГраниц.ИмяТаблицы;
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("В указаном диапазоне не найдено выделенных таблиц.");
	
	Возврат "";
	
КонецФункции


&НаСервере
Функция ПолучитьГраницыТаблицы(ДанныеГраниц)
	
	ГраницыТаблицы = СтрРазделить(ДанныеГраниц, ",", Ложь);
	
	Верх	= Число(ГраницыТаблицы[0]);
	Лево	= Число(ГраницыТаблицы[1]);
	Низ		= Число(ГраницыТаблицы[2]);
	Право	= Число(ГраницыТаблицы[3]);
	
	Возврат Новый Структура("Верх, Лево, Низ, Право", Верх, Лево, Низ, Право);
	
КонецФункции


&НаКлиенте
Функция ПолучитьУникальноеИмя()
	
	МассивЗначенийГенератора = Новый Массив;
	Генератор = Новый ГенераторСлучайныхЧисел;
	
	Для Индекс = 1 По 10 Цикл
		МассивЗначенийГенератора.Добавить(Генератор.СлучайноеЧисло(0,9));
	КонецЦикла;
	
	СгенерированноеЗначение = "Таблица_" + СтрСоединить(МассивЗначенийГенератора);
	
	Возврат СгенерированноеЗначение;
	
КонецФункции


&НаСервере
Процедура ВизуальныйКонструктор_СбросНаСервере()
	
	ВизуальныйКонструктор.Очистить();
	ВизуальныйКонструктор_ДанныеПостроения.Очистить();
	ВизуальныйКонструктор_ДанныеСвязей.Очистить();
	
	Сообщить("Данные сброшены");
	
КонецПроцедуры


&НаСервере
Функция ВизуальныйКонструктор_ОбработатьЗапрос(СписокТаблиц)
	
	СтруктураТаблиц = Новый Структура;
	
	Для Каждого Таблица Из СписокТаблиц Цикл
		
		ДанныеТаблицы = ВизуальныйКонструктор_ДанныеПостроения.НайтиСтроки(Новый Структура("ИмяТаблицы, ИмяСвойства", Таблица, "Границы"))[0];
		
		Граница = ПолучитьГраницыТаблицы(ДанныеТаблицы.Значение);
		
		Максимум = 0;
		// Определение максимальной длины полей
		Для ИндексВертикаль = Граница.Верх + 1 По Граница.Низ Цикл
			Для ИндексГоризонталь = Граница.Лево По Граница.Право Цикл
				ДлинаПоля = СтрДлина(СокрЛП(ВизуальныйКонструктор.Область(ИндексВертикаль, ИндексГоризонталь).Текст));
				Если ДлинаПоля > Максимум Тогда
					Максимум = ДлинаПоля;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ОписаниеСтроки = ОписаниеТипаСтрока(Максимум);
		
		НоваяТаблица = Новый ТаблицаЗначений;
		
		Для Индекс = Граница.Лево По Граница.Право Цикл
			
			ИмяПоля = СокрЛП(ВизуальныйКонструктор.Область(Граница.Верх, Индекс).Текст);
			
			НоваяТаблица.Колонки.Добавить(ИмяПоля, ОписаниеСтроки) 
			
		КонецЦикла;
		
		Для ИндексВертикаль = Граница.Верх + 1 По Граница.Низ Цикл
			
			НоваяСтрокаТаблицы = НоваяТаблица.Добавить();
			
			Для ИндексГоризонталь = Граница.Лево По Граница.Право Цикл
				
				ИмяПоля = СокрЛП(ВизуальныйКонструктор.Область(Граница.Верх, ИндексГоризонталь).Текст);
				
				ЗначениеПоля = СокрЛП(ВизуальныйКонструктор.Область(ИндексВертикаль, ИндексГоризонталь).Текст);
				
				НоваяСтрокаТаблицы[ИмяПоля] = ЗначениеПоля;
				
			КонецЦикла;
			
		КонецЦикла;
		
		СтруктураТаблиц.Вставить(Таблица, НоваяТаблица);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Для Каждого ТаблицаСтруктуры Из СтруктураТаблиц Цикл
		
		Запрос.УстановитьПараметр(ТаблицаСтруктуры.Ключ, ТаблицаСтруктуры.Значение);
		
	КонецЦикла;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных=Новый ОписаниеИсточникаДанных(Результат);       
	Построитель.Вывести(ТабличныйДокумент);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти 

#Область ОБРАБОТЧИКИ_ОПОВЕЩЕНИЙ


&НаКлиенте
Процедура ПослеВводаИмениТаблицыДляВизуальногоРедактора(ИмяТаблицы, ДополнительныеПараметры) Экспорт
	
	ТаблицаУжеСуществует = ВизуальныйКонструктор_ДанныеПостроения.НайтиСтроки(Новый Структура("ИмяТаблицы", ИмяТаблицы)).Количество() > 0;
	
	Если Не ЗначениеЗаполнено(ИмяТаблицы) Тогда
		Сообщить("Имя таблицы обязательно!");
		Возврат;
	КонецЕсли;
	
	Если ТаблицаУжеСуществует Тогда
		Сообщить("Таблица с таким именем уже существует, попробуйте еще раз.");
		Возврат;
	КонецЕсли;
	
	ТекущаяОбласть = Элементы.ВизуальныйКонструктор.ТекущаяОбласть;
	
	ДанныеОбласти = Новый Массив;
	ДанныеОбласти.Добавить(ТекущаяОбласть.Верх);
	ДанныеОбласти.Добавить(ТекущаяОбласть.Лево);
	ДанныеОбласти.Добавить(ТекущаяОбласть.Низ);
	ДанныеОбласти.Добавить(ТекущаяОбласть.Право);
	
	НоваяСтрокаДанных =		ВизуальныйКонструктор_ДанныеПостроения.Добавить();
	НоваяСтрокаДанных.ИмяТаблицы = ИмяТаблицы;
	НоваяСтрокаДанных.ИмяСвойства = "Границы"; // верх, лево, низ, право (против часовой)
	НоваяСтрокаДанных.Значение = СтрСоединить(ДанныеОбласти, ",");
	
	ТекущаяОбласть.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Двойная, 1);
	ТекущаяОбласть.ГраницаСлева = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Двойная, 1);
	ТекущаяОбласть.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Двойная, 1);
	ТекущаяОбласть.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Двойная, 1);
	
КонецПроцедуры


&НаКлиенте
Процедура ВизуальныйКонструктор_ПослеУтвержденияПолей(Результат, ДополнительныеПараметры) Экспорт
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Сообщить("Необходимо выбрать данные для вывода.");
		Возврат;
	КонецЕсли;
	
	//В результате будут содержаться отмеченные к выводу таблицы и их поля
	МассивТекстов			= Новый Массив;
	Разделитель				= "; //";
	
	ОтмеченныеТаблицы	= Результат.ОтмеченныеТаблицы;
	ОтмеченныеПоля		= Результат.ОтмеченныеПоля;
	ВсеПоля				= Результат.ВсеПоля;
	
	Для Каждого ИнтересующаяТаблица Из ОтмеченныеТаблицы Цикл
		
		ТекстЗапросаПодготовка	= Новый ТекстовыйДокумент;
		
		ТекстЗапросаПодготовка.ДобавитьСтроку("");
		ТекстЗапросаПодготовка.ДобавитьСтроку("ВЫБРАТЬ");
		
		КоличествоПолей = 0;
		Для Каждого Поле Из ВсеПоля Цикл
			
			Если СтрНачинаетсяС(Поле, ИнтересующаяТаблица + ".") Тогда
				КоличествоПолей = КоличествоПолей + 1;
			КонецЕсли;
			
		КонецЦикла;
		
		ИндексТекущегоПоля = 1;
		Для Каждого Поле Из ВсеПоля Цикл
			
			Если СтрНачинаетсяС(Поле, ИнтересующаяТаблица + ".") Тогда
				
				ТекстДобавления = Поле + ?(ИндексТекущегоПоля < КоличествоПолей, ",", "");
				ТекстЗапросаПодготовка.ДобавитьСтроку(ТекстДобавления);
				
				ИндексТекущегоПоля = ИндексТекущегоПоля + 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ТекстЗапросаПодготовка.ДобавитьСтроку("ПОМЕСТИТЬ " + ИнтересующаяТаблица);
		ТекстЗапросаПодготовка.ДобавитьСтроку(СтрШаблон("ИЗ &%1 КАК %1", ИнтересующаяТаблица));
		
		МассивТекстов.Добавить(ТекстЗапросаПодготовка.ПолучитьТекст());
		
	КонецЦикла;
	
	ТекстЗапросаПодготовка	= Новый ТекстовыйДокумент;
	
	ТекстЗапросаПодготовка.ДобавитьСтроку("");
	ТекстЗапросаПодготовка.ДобавитьСтроку("ВЫБРАТЬ");
	
	ИндексТекущегоПоля = 1;
	Для Каждого ИнтересующаяТаблица Из ОтмеченныеТаблицы Цикл
		
		Для Каждого Поле Из ОтмеченныеПоля Цикл
			
			Если СтрНачинаетсяС(Поле, ИнтересующаяТаблица + ".") Тогда
				
				ТекстДобавления = Поле + ?(ИндексТекущегоПоля < ОтмеченныеПоля.Количество(), ",", "");
				ТекстЗапросаПодготовка.ДобавитьСтроку(ТекстДобавления);
				
				ИндексТекущегоПоля = ИндексТекущегоПоля + 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ОсновнаяТаблица = ОтмеченныеТаблицы[0];
	
	ТекстЗапросаПодготовка.ДобавитьСтроку(СтрШаблон("ИЗ %1 КАК %1", ОсновнаяТаблица));
	
	Для Каждого ИнтересующаяТаблица Из ОтмеченныеТаблицы Цикл
		
		СписокСвязей	= ВизуальныйКонструктор_ДанныеСвязей.НайтиСтроки(Новый Структура("Таблица1", ИнтересующаяТаблица));
		
		ПерваяСвязь = Истина;
		
		Для Каждого Связь Из СписокСвязей Цикл
			
			Если ОтмеченныеТаблицы.Найти(Связь.Таблица2) <> Неопределено Тогда
				
				Если ПерваяСвязь Тогда
					
					ТекстЗапросаПодготовка.ДобавитьСтроку(СтрШаблон("%1 СОЕДИНЕНИЕ %2 КАК %2", Связь.ТипСоединения, Связь.Таблица2));
					ТекстЗапросаПодготовка.ДобавитьСтроку(СтрШаблон("ПО %1.%2 = %3.%4", Связь.Таблица1, Связь.ПолеСвязи1, Связь.Таблица2, Связь.ПолеСвязи2));
					
					ПерваяСвязь = Ложь;
					
				Иначе
					
					ТекстЗапросаПодготовка.ДобавитьСтроку(СтрШаблон("И %1.%2 = %3.%4", Связь.Таблица1, Связь.ПолеСвязи1, Связь.Таблица2, Связь.ПолеСвязи2));
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
	
	МассивТекстов.Добавить(ТекстЗапросаПодготовка.ПолучитьТекст());
	
	ТекстЗапроса = СтрСоединить(МассивТекстов, Разделитель);
	
	ТабличныйДокумент = ВизуальныйКонструктор_ОбработатьЗапрос(ОтмеченныеТаблицы);
	
	ОткрытьФорму("ВнешняяОбработка.УниверсальнаяОбработка.Форма.ФормаРезультатаСоединения", Новый Структура("Результат", ТабличныйДокумент), ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти 

#КонецОбласти 

