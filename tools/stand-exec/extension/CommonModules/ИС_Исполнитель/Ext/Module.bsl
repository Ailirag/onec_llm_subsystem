// Исполнитель кода стенда: выполняет присланный текст BSL и возвращает значение
// переменной Результат в виде JSON.
//
// Расширение существует ТОЛЬКО на тестовых стендах, его ставит комплект процесса.
// В поставку оно не входит и в рабочих базах ничего не выполняет: см. метку
// стенда в модуле ИС_МеткаСтенда.
//
// Договор для присланного кода:
//  - доступна переменная Параметры: то, что клиент передал в params;
//  - результат кладётся в переменную Результат: любое значение, приведение к JSON
//    выполняет исполнитель (ссылки, таблицы, структуры, даты);
//  - процедуры и функции объявлять нельзя: текст исполняется оператором Выполнить.
//
// Режимы:
//  - commit   — весь код в одной транзакции, при ошибке ничего не записано;
//  - rollback — код выполняется, результат снимается, транзакция отменяется:
//               эксперимент, не оставляющий следов на стенде;
//  - none     — без транзакции исполнителя: код управляет ею сам.

#Область ПрограммныйИнтерфейс

// Версия договора исполнителя. Совпадает с версией расширения.
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияИсполнителя() Экспорт

	Возврат "1.0.0";

КонецФункции

// Почему исполнитель откажет в выполнении кода текущему пользователю.
//
// Возвращаемое значение:
//  Строка - пустая строка, если выполнение разрешено.
//
Функция ПричинаОтказа() Экспорт

	Если Не ИС_МеткаСтенда.ИсполнениеРазрешено() Тогда
		Возврат "В базе нет метки стенда. Исполнитель выполняет код только на стенде, "
			+ "куда его поставил комплект процесса.";
	КонецЕсли;
	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат "Выполнение кода разрешено только пользователю с правом «Администрирование».";
	КонецЕсли;
	Возврат "";

КонецФункции

// Состояние исполнителя для проверки публикации. Кода не выполняет.
//
// Возвращаемое значение:
//  Структура
//
Функция Состояние() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("extension", "ИсполнительСтенда");
	Результат.Вставить("version", ВерсияИсполнителя());
	Результат.Вставить("armed", ИС_МеткаСтенда.ИсполнениеРазрешено());
	Результат.Вставить("user", ИмяПользователя());
	Результат.Вставить("admin", ПравоДоступа("Администрирование", Метаданные));
	Возврат Результат;

КонецФункции

// Разбирает тело запроса.
//
// Тело — либо JSON {"code": "...", "params": {...}, "mode": "..."}, либо сам текст
// кода (для вызова из командной строки). Режим берётся из тела, затем из
// параметра адреса mode, по умолчанию commit.
//
// Параметры:
//  Тело - Строка - тело запроса.
//  ТипСодержимого - Строка - заголовок Content-Type.
//  РежимИзАдреса - Строка, Неопределено - параметр mode адреса.
//
// Возвращаемое значение:
//  Структура - Код, Параметры, Режим.
//
Функция РазобратьЗапрос(Знач Тело, Знач ТипСодержимого, Знач РежимИзАдреса) Экспорт

	Задание = Новый Структура("Код, Параметры, Режим", "", Новый Структура, "commit");
	Если ЗначениеЗаполнено(РежимИзАдреса) Тогда
		Задание.Режим = НРег(СокрЛП(РежимИзАдреса));
	КонецЕсли;

	Если СтрНайти(НРег(Строка(ТипСодержимого)), "json") > 0 Тогда
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
			ВызватьИсключение "Тело запроса должно быть объектом JSON: {""code"": ""..."", ""params"": {...}, ""mode"": ""...""}.";
		КонецЕсли;
		Код = Данные.Получить("code");
		Задание.Код = ?(ТипЗнч(Код) = Тип("Строка"), Код, "");
		Параметры = Данные.Получить("params");
		Если Параметры <> Неопределено Тогда
			Задание.Параметры = СтруктураИзJSON(Параметры);
		КонецЕсли;
		Режим = Данные.Получить("mode");
		Если ТипЗнч(Режим) = Тип("Строка") И ЗначениеЗаполнено(Режим) Тогда
			Задание.Режим = НРег(СокрЛП(Режим));
		КонецЕсли;
	Иначе
		Задание.Код = Тело;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СокрЛП(Задание.Код)) Тогда
		ВызватьИсключение "Код для выполнения не передан.";
	КонецЕсли;
	Если Задание.Режим <> "commit" И Задание.Режим <> "rollback" И Задание.Режим <> "none" Тогда
		ВызватьИсключение "Неизвестный режим """ + Задание.Режим + """: допустимы commit, rollback, none.";
	КонецЕсли;
	Возврат Задание;

КонецФункции

// Выполняет код и собирает ответ.
//
// Параметры:
//  Код - Строка - текст BSL.
//  Параметры - Структура, Соответствие - доступны коду в переменной Параметры.
//  Режим - Строка - commit, rollback или none.
//
// Возвращаемое значение:
//  Структура - ok, mode, result, messages, elapsedMs; при ошибке ещё error и details.
//
Функция ВыполнитьКод(Знач Код, Знач Параметры, Знач Режим) Экспорт

	Ответ = Новый Структура;
	Ответ.Вставить("ok", Ложь);
	Ответ.Вставить("mode", Режим);
	Ответ.Вставить("result", Неопределено);
	Ответ.Вставить("messages", Новый Массив);
	Ответ.Вставить("elapsedMs", 0);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	// Сообщения, накопленные сеансом до вызова, к этому коду не относятся.
	ПолучитьСообщенияПользователю(Истина);

	ВТранзакции = (Режим <> "none");
	Если ВТранзакции Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Результат = Неопределено;
		ИсполнитьТекст(Код, Параметры, Результат);
		// Результат снимается до завершения транзакции: в режиме rollback после
		// отмены у созданных кодом ссылок уже нет ни данных, ни представлений.
		Ответ.result = ЗначениеДляJSON(Результат, 0);
		Если ВТранзакции Тогда
			Если Режим = "rollback" Тогда
				ОтменитьТранзакцию();
			Иначе
				ЗафиксироватьТранзакцию();
			КонецЕсли;
		КонецЕсли;
		Ответ.ok = Истина;
	Исключение
		Информация = ИнформацияОбОшибке();
		// Код мог открыть свои транзакции и не закрыть их: отменяются все уровни.
		Пока ТранзакцияАктивна() Цикл
			ОтменитьТранзакцию();
		КонецЦикла;
		Ответ.Вставить("error", КраткоеПредставлениеОшибки(Информация));
		Ответ.Вставить("details", ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;

	// Сообщения пользователю — часто единственное объяснение отказа: проверка
	// заполнения и обработчики записи сообщают о причине именно так.
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = Сообщение.Текст;
		Если ЗначениеЗаполнено(Сообщение.Поле) Тогда
			Текст = Сообщение.Поле + ": " + Текст;
		КонецЕсли;
		Ответ.messages.Добавить(Текст);
	КонецЦикла;
	Ответ.elapsedMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Возврат Ответ;

КонецФункции

// Приводит значение к виду, который принимает ЗаписатьJSON.
//
// Ссылки и значения перечислений становятся объектами {_type, _ref, _presentation},
// таблицы и деревья значений — массивами строк, даты — строками ISO 8601.
// Прочие типы — объектом {_type, _presentation}: ответ не падает на значении,
// которое не умеет сериализовать.
//
// Параметры:
//  Значение - Произвольный
//  Глубина - Число - текущая глубина вложенности.
//
// Возвращаемое значение:
//  Произвольный - значение, пригодное для ЗаписатьJSON.
//
Функция ЗначениеДляJSON(Знач Значение, Знач Глубина = 0) Экспорт

	Если Глубина > 32 Тогда
		Возврат "<вложенность глубже 32 уровней>";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	ИначеЕсли ТипЗначения = Тип("Тип") Тогда
		Возврат Строка(Значение);
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура")
		Или ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Объект = Новый Соответствие;
		Для Каждого Элемент Из Значение Цикл
			Объект.Вставить(КлючДляJSON(Элемент.Ключ), ЗначениеДляJSON(Элемент.Значение, Глубина + 1));
		КонецЦикла;
		Возврат Объект;
	ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Список = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Список.Добавить(ЗначениеДляJSON(Элемент, Глубина + 1));
		КонецЦикла;
		Возврат Список;
	ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
		Список = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Список.Добавить(ЗначениеДляJSON(Элемент.Значение, Глубина + 1));
		КонецЦикла;
		Возврат Список;
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат СтрокиДляJSON(Значение, Значение.Колонки, Глубина);
	ИначеЕсли ТипЗначения = Тип("ДеревоЗначений") Тогда
		Возврат СтрокиДереваДляJSON(Значение.Строки, Значение.Колонки, Глубина);
	ИначеЕсли ТипЗначения = Тип("РезультатЗапроса") Тогда
		Возврат ЗначениеДляJSON(Значение.Выгрузить(), Глубина);
	ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Возврат Новый Структура("_type", "ХранилищеЗначения");
	КонецЕсли;

	// Ссылки и значения перечислений узнаются по XML-типу: CatalogRef.<Имя>,
	// DocumentRef.<Имя>, EnumRef.<Имя> и так далее. Объекты (CatalogObject.<Имя>)
	// возвращаются своей ссылкой.
	ТипXML = XMLТипЗнч(Значение);
	ИмяТипаXML = ?(ТипXML = Неопределено, "", ТипXML.ИмяТипа);
	Если СтрНайти(ИмяТипаXML, "Ref.") > 0 Тогда
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Ссылка = Новый Структура;
		Ссылка.Вставить("_type", ?(ОбъектМетаданных = Неопределено, ИмяТипаXML, ОбъектМетаданных.ПолноеИмя()));
		Ссылка.Вставить("_ref", XMLСтрока(Значение));
		Ссылка.Вставить("_presentation", Строка(Значение));
		Возврат Ссылка;
	ИначеЕсли СтрНайти(ИмяТипаXML, "Object.") > 0 Тогда
		Попытка
			Возврат ЗначениеДляJSON(Значение.Ссылка, Глубина + 1);
		Исключение
			// У объекта нет ссылки: обрабатывается общим правилом ниже.
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("_type, _presentation", Строка(ТипЗначения), Строка(Значение));

КонецФункции

// Сериализует значение, уже приведённое ЗначениеДляJSON.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Строка
//
Функция ВJSON(Знач Значение) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Исполняет текст кода. Вынесено в отдельную процедуру, чтобы коду были видны
// только Параметры и Результат, а не переменные исполнителя: код, случайно
// присвоивший Ответ или Режим, иначе ломал бы собственный ответ.
Процедура ИсполнитьТекст(Знач Код, Параметры, Результат)

	Выполнить(Код);

КонецПроцедуры

Функция КлючДляJSON(Ключ)

	Если ТипЗнч(Ключ) = Тип("Строка") Тогда
		Возврат Ключ;
	КонецЕсли;
	Попытка
		Возврат XMLСтрока(Ключ);
	Исключение
		Возврат Строка(Ключ);
	КонецПопытки;

КонецФункции

Функция СтрокиДляJSON(Строки, Колонки, Глубина)

	Список = Новый Массив;
	Для Каждого СтрокаТаблицы Из Строки Цикл
		Объект = Новый Соответствие;
		Для Каждого Колонка Из Колонки Цикл
			Объект.Вставить(Колонка.Имя, ЗначениеДляJSON(СтрокаТаблицы[Колонка.Имя], Глубина + 1));
		КонецЦикла;
		Список.Добавить(Объект);
	КонецЦикла;
	Возврат Список;

КонецФункции

Функция СтрокиДереваДляJSON(Строки, Колонки, Глубина)

	Список = Новый Массив;
	Для Каждого СтрокаДерева Из Строки Цикл
		Объект = Новый Соответствие;
		Для Каждого Колонка Из Колонки Цикл
			Объект.Вставить(Колонка.Имя, ЗначениеДляJSON(СтрокаДерева[Колонка.Имя], Глубина + 1));
		КонецЦикла;
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			Объект.Вставить("_rows", СтрокиДереваДляJSON(СтрокаДерева.Строки, Колонки, Глубина + 1));
		КонецЕсли;
		Список.Добавить(Объект);
	КонецЦикла;
	Возврат Список;

КонецФункции

// Параметры из JSON становятся структурой, чтобы код писал Параметры.Имя, а не
// Параметры["Имя"]. Объект, ключ которого не годится в имя свойства, остаётся
// соответствием.
Функция СтруктураИзJSON(Значение)

	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Попытка
			Результат = Новый Структура;
			Для Каждого Элемент Из Значение Цикл
				Результат.Вставить(Элемент.Ключ, СтруктураИзJSON(Элемент.Значение));
			КонецЦикла;
			Возврат Результат;
		Исключение
			Результат = Новый Соответствие;
			Для Каждого Элемент Из Значение Цикл
				Результат.Вставить(Элемент.Ключ, СтруктураИзJSON(Элемент.Значение));
			КонецЦикла;
			Возврат Результат;
		КонецПопытки;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(СтруктураИзJSON(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Значение;

КонецФункции

#КонецОбласти
