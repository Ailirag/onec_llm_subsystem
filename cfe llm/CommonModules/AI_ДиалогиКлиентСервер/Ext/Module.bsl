Функция СоздатьДиалог(Настройки = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Результат = AI_ДиалогиСервер.СоздатьДиалог(
		ИдентификаторТекущегоПользователя(),
		Настройки);
	Возврат Результат;

КонецФункции

