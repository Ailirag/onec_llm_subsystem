
#Область ПрограммныйИнтерфейс

// Процедура для описания логики как нужно раскладывать тот или иной объект в Qdrant 
Процедура AI_ОбработкаОчередиПодготовкиКВекторизации() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	AI_ОчередьПодготовкиКВекторизации.Ссылка КАК Ссылка,
		|	ТИПЗНАЧЕНИЯ(AI_ОчередьПодготовкиКВекторизации.Ссылка) КАК ТипСсылки
		|ИЗ
		|	РегистрСведений.AI_ОчередьПодготовкиКВекторизации КАК AI_ОчередьПодготовкиКВекторизации
		|ИТОГИ ПО
		|	ТипСсылки";
	
	ОбходПоТипамСсылок = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ОбходПоТипамСсылок.Следующий() Цикл
		
		МассивОбъектовТипа = Новый Массив;
		
		ВыборкаПоСсылкам = ОбходПоТипамСсылок.Выбрать();
		
		Пока ВыборкаПоСсылкам.Следующий() Цикл
			МассивОбъектовТипа.Добавить(ВыборкаПоСсылкам.Ссылка);
		КонецЦикла;
		
		ОбработкаМассиваОчередиПодготовкиПоТипу(МассивОбъектовТипа, ОбходПоТипамСсылок.ТипСсылки);
		
	КонецЦикла;
	
КонецПроцедуры

// ИнициализироватьКоллекциюВQdrant
// Создаёт коллекцию в Qdrant и помечает её инициализированной в справочнике.
// Если коллекция уже существует — не пересоздаёт, просто фиксирует флаг.
//
// Параметры:
//   Коллекция       - СправочникСсылка.AI_RAGКоллекции - элемент коллекции
//   КомпонентRAG    - Структура - данные RAG-компонента (из AI_Клиент._ДанныеRAG)
//
// Возвращаемое значение:
//   Структура - { Успех: Булево, Описание: Строка }
Функция ИнициализироватьКоллекциюВQdrant(Коллекция, КомпонентRAG) Экспорт

	Результат = НовыйРезультатОперации();

	Попытка

		// Получаем данные коллекции из справочника
		ДанныеКоллекций = Справочники.AI_RAGКоллекции.ПолучитьЗначенияКоллекций(Коллекция);
		ДанныеКоллекции = ДанныеКоллекций[Коллекция];

		ИмяКоллекции   = ДанныеКоллекции.Наименование;
		РазмерВектора  = КомпонентRAG.EmbeddingРазмерность;

		// Формируем тело запроса PUT /collections/{name}
		ТелоЗапроса = Новый Структура;
		ВекторыПараметры = Новый Структура;
		ВекторыПараметры.Вставить("size",     РазмерВектора);
		ВекторыПараметры.Вставить("distance", "Cosine");
		ТелоЗапроса.Вставить("vectors", ВекторыПараметры);

		URL      = СтрШаблон("%1/collections/%2", КомпонентRAG.QdrantURL, ИмяКоллекции);
		Заголовки = ЗаголовкиQdrant(КомпонентRAG.QdrantAPIКлюч);

		Ответ = OPI_ЗапросыHTTP.PutСТелом(URL, ТелоЗапроса, Заголовки, Истина, Ложь);

		// Qdrant возвращает {"result": true} при успехе и {"status": {...}} при ошибке
		// Также 200 если коллекция уже существует (идемпотентный PUT)
		КодОтвета = Ответ.КодСостояния; 
		
		Если КодОтвета <> 200 И КодОтвета <> 204 Тогда
			ВызватьИсключение СтрШаблон(
				"Qdrant вернул код %1. Тело: %2",
				КодОтвета,
				OPI_Инструменты.JSONСтрокой(Ответ.ПолучитьТелоКакСтроку()));
		КонецЕсли;

		// Фиксируем флаг инициализации в справочнике
		ОбъектКоллекции = Коллекция.ПолучитьОбъект();
		ОбъектКоллекции.КоллекцияИнициализирована = Истина;
		ОбъектКоллекции.Записать();

		Результат.Успех = Истина;

	Исключение
		Результат.Успех    = Ложь;
		Результат.Описание = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// ОтправитьДанныеВQdrant
// Получает вектор для текстовых данных и размещает точку в Qdrant.
// Используется из AI_ОбработкаОчередиВекторизации для каждого элемента очереди.
//
// Параметры:
//   КомпонентRAG - Структура          - данные RAG-компонента
//   ИмяКоллекции - Строка             - наименование коллекции в Qdrant
//   МассивТочек  - Массив Из Структура - точки: { Вектор, Payload }
//                  (формируется снаружи, по одной или пакетом)
//
// Возвращаемое значение:
//   Структура - { Успех: Булево, Описание: Строка }
Функция ОтправитьДанныеВQdrant(КомпонентRAG, ИмяКоллекции, МассивТочек) Экспорт

	Результат = НовыйРезультатОперации();

	Попытка

		Если Не ЗначениеЗаполнено(МассивТочек) Или МассивТочек.Количество() = 0 Тогда
			Результат.Успех    = Истина;
			Результат.Описание = "Нет точек для отправки";
			Возврат Результат;
		КонецЕсли;

		// PUT /collections/{name}/points  (upsert — идемпотентно)
		URL      = СтрШаблон("%1/collections/%2/points", КомпонентRAG.QdrantURL, ИмяКоллекции);
		Заголовки = ЗаголовкиQdrant(КомпонентRAG.QdrantAPIКлюч);

		ТелоЗапроса = Новый Структура;
		ТелоЗапроса.Вставить("points", МассивТочек);

		Ответ     = OPI_ЗапросыHTTP.PutСТелом(URL, ТелоЗапроса, Заголовки, Истина, Истина);
		КодОтвета = Ответ.КодСостояния;

		Если КодОтвета <> 200 И КодОтвета <> 202 Тогда
			ВызватьИсключение СтрШаблон(
				"Qdrant /points вернул код %1. Тело: %2",
				КодОтвета,
				OPI_Инструменты.JSONСтрокой(Ответ.ПолучитьТелоКакСтроку()));
		КонецЕсли;

		Результат.Успех = Истина;

	Исключение
		Результат.Успех    = Ложь;
		Результат.Описание = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// ПолучитьСтатусRAG
// Проверяет доступность Embedding-сервиса и Qdrant.
// Используется формой AI_RAG для отображения статуса компонентов.
//
// Параметры:
//   КомпонентRAG - Структура - данные компонента RAG
//
// Возвращаемое значение:
//   Структура - { EmbeddingДоступен, EmbeddingСтатус, QdrantДоступен, QdrantСтатус }
Функция ПолучитьСтатусRAG(КомпонентRAG) Экспорт

	Статус = Новый Структура(
		"EmbeddingДоступен, EmbeddingСтатус, QdrantДоступен, QdrantСтатус",
		Ложь, "", Ложь, "");

	// --- Embedding ---
	Попытка
		// Стандартный healthcheck OpenAI-совместимых серверов: GET /models
		URLEmb    = СтрШаблон("%1/models", КомпонентRAG.EmbeddingURL);
		ЗаголовкиEmb = ЗаголовкиEmbedding(КомпонентRAG.EmbeddingAPIКлюч);

		ОтветEmb     = OPI_ЗапросыHTTP.Get(URLEmb, , ЗаголовкиEmb, , Истина);
		КодEmb       = ОтветEmb["status_code"];

		Статус.EmbeddingДоступен = (КодEmb >= 200 И КодEmb < 300);
		Статус.EmbeddingСтатус   = СтрШаблон("HTTP %1", КодEmb);
	Исключение
		Статус.EmbeddingСтатус = "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;

	// --- Qdrant ---
	Попытка
		// GET /healthz — стандартный endpoint Qdrant
		URLQd     = СтрШаблон("%1/healthz", КомпонентRAG.QdrantURL);
		ЗаголовкиQd = ЗаголовкиQdrant(КомпонентRAG.QdrantAPIКлюч);

		ОтветQd   = OPI_ЗапросыHTTP.Get(URLQd, , ЗаголовкиQd, , Истина);
		КодQd     = ОтветQd["status_code"];

		Статус.QdrantДоступен = (КодQd >= 200 И КодQd < 300);
		Статус.QdrantСтатус   = СтрШаблон("HTTP %1", КодQd);
	Исключение
		Статус.QdrantСтатус = "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Статус;

КонецФункции

// Процедура вызывается регламентным заданием AI_ОбработкаОчередиВекторизации.
// Читает AI_ОчередьВекторизации, группирует по коллекции, для каждой порции:
//   1. Проверяет / создаёт коллекцию в Qdrant
//   2. Пропускает чанки без изменений (по хешу через AI_ИдентификаторыЧанков)
//   3. Получает векторы через Embedding-сервис
//   4. Отправляет порции в Qdrant
//   5. Фиксирует результат в AI_ИдентификаторыЧанков и удаляет из очереди
// AI_ОбработкаОчередиВекторизации
// Точка входа — вызывается регламентным заданием.
// Читает очередь, группирует по коллекции, запускает обработку порциями
// через менеджер фоновых заданий (с учётом AI_КоличествоПотоковВекторизации).
Процедура AI_ОбработкаОчередиВекторизации() Экспорт

	// 1. Запрос очереди с группировкой по коллекции
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.УникальныйИдентификатор КАК УникальныйИдентификатор,
		|	Очередь.Коллекция КАК Коллекция
		|ИЗ
		|	РегистрСведений.AI_ОчередьВекторизации КАК Очередь
		|ИТОГИ ПО
		|	Коллекция";

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат; // Очередь пуста — выходим
	КонецЕсли;

	КоличествоПотоков = Константы.AI_КоличествоПотоковВекторизации.Получить();
	Если КоличествоПотоков = 0 Тогда
		КоличествоПотоков = 1;
	КонецЕсли;

	// 2. Собираем порции по коллекциям для менеджера фоновых заданий
	МассивПорций = Новый Массив;

	ОбходПоКоллекциям = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Пока ОбходПоКоллекциям.Следующий() Цикл

		МассивИдентификаторов = Новый Массив;
		ВыборкаЗаписей = ОбходПоКоллекциям.Выбрать();

		Пока ВыборкаЗаписей.Следующий() Цикл
			МассивИдентификаторов.Добавить(ВыборкаЗаписей.УникальныйИдентификатор);
		КонецЦикла;

		// Параметр для фонового задания: коллекция + её идентификаторы
		ПараметрЗадания = Новый Структура;
		ПараметрЗадания.Вставить("Коллекция",            ОбходПоКоллекциям.Коллекция);
		ПараметрЗадания.Вставить("МассивИдентификаторов", МассивИдентификаторов);

		МассивПорции = Новый Массив;
		МассивПорции.Добавить(ПараметрЗадания);
		
		МассивПорций.Добавить(МассивПорции);

	КонецЦикла;

	// 3. Запускаем через менеджер фоновых заданий из Слоя инфраструктуры
	ПараметрыМенеджера = AI_ОбработкаСервер.ПараметрыМенеджераЗаданий();
	ПараметрыМенеджера.ЗапускаемаяПроцедура = "AI_RAG.ОбработатьПорциюВекторизации";
	ПараметрыМенеджера.НаименованиеЗадания  = "Векторизация данных для RAG";
	ПараметрыМенеджера.ПорцииДанных         = МассивПорций;
	ПараметрыМенеджера.КоличествоПотоков    = КоличествоПотоков;

	AI_ОбработкаСервер.ОжидатьЗавершенияМенеджераФоновыхЗаданий(ПараметрыМенеджера, 5);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолноеИмяТипаПоСсылке(Ссылка) Экспорт
	
	Если не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Ссылка не заполнена. Продолжение не возможно";
	КонецЕсли;
	
	НайденныеМетаданные = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	
	Возврат НайденныеМетаданные.ПолноеИмя();
	
КонецФункции

// ПолучитьКоллекцииQdrant
// Запрашивает список коллекций из Qdrant через API.
//
// Параметры:
//   КомпонентRAG  - Структура - данные RAG-компонента
//   ИмяКоллекции  - Строка   - если заполнено, возвращает только эту коллекцию
//
// Возвращаемое значение:
//   Массив Из Структура - каждая структура: { name, status, vectors_count }
Функция ПолучитьКоллекцииQdrant(КомпонентRAG, ИмяКоллекции = "") Экспорт

	Заголовки = ЗаголовкиQdrant(КомпонентRAG.QdrantAPIКлюч);

	Если ЗначениеЗаполнено(ИмяКоллекции) Тогда
		URL = СтрШаблон("%1/collections/%2", КомпонентRAG.QdrantURL, ИмяКоллекции);
	Иначе
		URL = СтрШаблон("%1/collections", КомпонентRAG.QdrantURL);
	КонецЕсли;

	Ответ = OPI_ЗапросыHTTP.Get(URL, , Заголовки);
	Данные = OPI_Инструменты.JsonВСтруктуру(Ответ, Ложь);

	МассивКоллекций = Новый Массив;

	Если Не ЗначениеЗаполнено(Данные) Тогда
		Возврат МассивКоллекций;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИмяКоллекции) Тогда

		// GET /collections/{name} → { result: { name, status, vectors_count, ... } }
		Если Данные.Свойство("result") И ЗначениеЗаполнено(Данные["result"]) Тогда
			МассивКоллекций.Добавить(Данные["result"]);
		КонецЕсли;

	Иначе

		// GET /collections → { result: { collections: [ { name, status }, ... ] } }
		Рез = Данные["result"];
		Если ЗначениеЗаполнено(Рез) И Рез.Свойство("collections") Тогда
			Для Каждого Элемент Из Рез["collections"] Цикл
				МассивКоллекций.Добавить(Элемент);
			КонецЦикла;
		КонецЕсли;

	КонецЕсли;

	Возврат МассивКоллекций;

КонецФункции

// ПолучитьВектор
// Отправляет текст в Embedding-сервис и возвращает вектор.
// Сервис должен поддерживать OpenAI Embeddings API:
//   POST /embeddings  { "model": "...", "input": "текст" }
//
// Параметры:
//   КомпонентRAG - Структура - данные RAG-компонента
//   Данные       - Строка    - текст для векторизации
//
// Возвращаемое значение:
//   Массив Из Число - вектор (embedding), или Неопределено при ошибке
Функция ПолучитьВектор(КомпонентRAG, Данные) Экспорт

	Заголовки = ЗаголовкиEmbedding(КомпонентRAG.EmbeddingAPIКлюч);

	Тело = Новый Структура;
	Тело.Вставить("model", КомпонентRAG.EmbeddingМодель);
	Тело.Вставить("input", Данные);

	URL  = СтрШаблон("%1/embeddings", КомпонентRAG.EmbeddingURL);
	Ответ = OPI_ЗапросыHTTP.PostСТелом(URL, Тело, Заголовки);
	ДанныеОтвета = OPI_Инструменты.JsonВСтруктуру(Ответ, Ложь);

	// Ответ OpenAI Embeddings: { "data": [ { "embedding": [...], "index": 0 } ] }
	Если Не ЗначениеЗаполнено(ДанныеОтвета) ИЛИ (
		ДанныеОтвета.Свойство("detail") И ДанныеОтвета["detail"] = "Not found") Тогда
		ВызватьИсключение "Embedding-сервис вернул пустой ответ";
	КонецЕсли;

	Если ДанныеОтвета.Свойство("error") Тогда
		ВызватьИсключение СтрШаблон(
			"Ошибка Embedding-сервиса: %1",
			OPI_Инструменты.JSONСтрокой(ДанныеОтвета["error"]));
	КонецЕсли;
		
	Если ДанныеОтвета.Свойство("detail") Тогда
		ВызватьИсключение СтрШаблон(
			"Ошибка Embedding-сервиса: %1",
			OPI_Инструменты.JSONСтрокой(ДанныеОтвета["detail"]));
	КонецЕсли;

	МассивData = ДанныеОтвета["data"];
	Если Не ЗначениеЗаполнено(МассивData) Или МассивData.Количество() = 0 Тогда
		ВызватьИсключение "Embedding-сервис не вернул векторы в поле 'data'";
	КонецЕсли;

	Возврат МассивData[0]["embedding"];

КонецФункции

// РазместитьВектор
// Низкоуровневая обёртка для upsert одного вектора в Qdrant.
// Для пакетной загрузки используйте ОтправитьДанныеВQdrant с массивом точек.
//
// Параметры:
//   КомпонентRAG - Структура  - данные RAG-компонента
//   ИмяКоллекции - Строка     - имя коллекции в Qdrant
//   Вектор       - Массив     - числовой вектор
//   Payload      - Структура  - произвольные метаданные точки (текст чанка, ссылка и т.д.)
//   ИдентификаторТочки - Строка - UUID точки (если не задан — генерируется)
//
// Возвращаемое значение:
//   Структура - { Успех: Булево, Описание: Строка }
Функция РазместитьВектор(КомпонентRAG, ИмяКоллекции, Вектор, Payload, ИдентификаторТочки = "") Экспорт

	Если Не ЗначениеЗаполнено(ИдентификаторТочки) Тогда
		// Qdrant принимает UUID или целое число в качестве id
		ИдентификаторТочки = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	Точка = Новый Структура;
	Точка.Вставить("id",      ИдентификаторТочки);
	Точка.Вставить("vector",  Вектор);
	Точка.Вставить("payload", Payload);

	МассивТочек = Новый Массив;
	МассивТочек.Добавить(Точка);

	Возврат ОтправитьДанныеВQdrant(КомпонентRAG, ИмяКоллекции, МассивТочек);

КонецФункции

// ПостроитьФильтрПоАгенту
// Возвращает структуру filter для Qdrant по разрешениям агента
// (читает табличную часть AI_Агенты.RAGРазрешения).
//
// Возвращает Неопределено если у агента нет разрешений — фильтр не применяется,
// поиск идёт по всем чанкам (поведение по умолчанию).
//
// Маппинг типа разрешения → ключ payload Qdrant:
//   Организация → "org_guid"
//   Тенант      → "tenant"
//   Право       → "permissions"
//   ТипДанных   → "entity_type"
//
// Для типа Право в any-список автоматически добавляется "all" — обратная
// совместимость с чанками, помеченными как универсально доступные.
//
// Параметры:
//   Агент - СправочникСсылка.AI_Агенты
//
// Возвращаемое значение:
//   Структура с ключом must (массив условий) либо Неопределено
Функция ПостроитьФильтрПоАгенту(Агент) Экспорт

	Если НЕ ЗначениеЗаполнено(Агент) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Разрешения.Разрешение.ТипРазрешения  КАК ТипРазрешения,
		|	Разрешения.Разрешение.Наименование   КАК Значение
		|ИЗ
		|	Справочник.AI_Агенты.RAGРазрешения КАК Разрешения
		|ГДЕ
		|	Разрешения.Ссылка = &Агент";
	Запрос.УстановитьПараметр("Агент", Агент);

	Выборка = Запрос.Выполнить().Выбрать();

	// Группируем значения по ключу payload
	ПоКлючам = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		КлючPayload = КлючPayloadПоТипу(Выборка.ТипРазрешения);
		Если КлючPayload = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Массив = ПоКлючам.Получить(КлючPayload);
		Если Массив = Неопределено Тогда
			Массив = Новый Массив;
			ПоКлючам.Вставить(КлючPayload, Массив);
		КонецЕсли;
		Массив.Добавить(Строка(Выборка.Значение));
	КонецЦикла;

	// Авто-добавление "all" для permissions — обратная совместимость
	ПраваМассив = ПоКлючам.Получить("permissions");
	Если ПраваМассив <> Неопределено И ПраваМассив.Найти("all") = Неопределено Тогда
		ПраваМассив.Добавить("all");
	КонецЕсли;

	Если ПоКлючам.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Must = Новый Массив;
	Для Каждого КЗ Из ПоКлючам Цикл
		Условие = Новый Структура;
		Условие.Вставить("key",   КЗ.Ключ);
		Условие.Вставить("match", Новый Структура("any", КЗ.Значение));
		Must.Добавить(Условие);
	КонецЦикла;

	Возврат Новый Структура("must", Must);

КонецФункции

// Соответствие значения перечисления AI_ТипыРазрешенийRAG ключу payload Qdrant.
Функция КлючPayloadПоТипу(ТипРазрешения) Экспорт
	Если ТипРазрешения = Перечисления.AI_ТипыРазрешенийRAG.Организация Тогда
		Возврат "org_guid";
	ИначеЕсли ТипРазрешения = Перечисления.AI_ТипыРазрешенийRAG.Тенант Тогда
		Возврат "tenant";
	ИначеЕсли ТипРазрешения = Перечисления.AI_ТипыРазрешенийRAG.Право Тогда
		Возврат "permissions";
	ИначеЕсли ТипРазрешения = Перечисления.AI_ТипыРазрешенийRAG.ТипДанных Тогда
		Возврат "entity_type";
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// ПоискПохожихВQdrant
// Выполняет векторный поиск в коллекции Qdrant.
// Используется из AI_Клиент.ОбработатьВекторныйЗапрос().
//
// Параметры:
//   КомпонентRAG        - Структура - данные RAG-компонента
//   ИмяКоллекции        - Строка    - имя коллекции
//   Вектор              - Массив    - вектор запроса
//   Лимит               - Число     - максимальное количество результатов
//   МинПорогСхожести    - Число     - минимальный score (0..1)
//   Фильтр              - Структура - filter для Qdrant (см. ПостроитьФильтрПоАгенту)
//                                     или Неопределено = без фильтра
//
// Возвращаемое значение:
//   Массив Из Структура - { id, score, payload }
Функция ПоискПохожихВQdrant(КомпонентRAG, ИмяКоллекции, Вектор, Лимит = 5,
                            МинПорогСхожести = 0.7, Фильтр = Неопределено) Экспорт

	URL      = СтрШаблон("%1/collections/%2/points/search", КомпонентRAG.QdrantURL, ИмяКоллекции);
	Заголовки = ЗаголовкиQdrant(КомпонентRAG.QdrantAPIКлюч);

	Тело = Новый Структура;
	Тело.Вставить("vector",          Вектор);
	Тело.Вставить("limit",           Лимит);
	Тело.Вставить("score_threshold", МинПорогСхожести);
	Тело.Вставить("with_payload",    Истина);

	Если Фильтр <> Неопределено Тогда
		Тело.Вставить("filter", Фильтр);
	КонецЕсли;

	Ответ        = OPI_ЗапросыHTTP.PostСТелом(URL, Тело, Заголовки);
	ДанныеОтвета = OPI_Инструменты.JsonВСтруктуру(Ответ, Ложь);

	Если Не ЗначениеЗаполнено(ДанныеОтвета) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Если ДанныеОтвета.Свойство("status") Тогда
		Статус = ДанныеОтвета["status"];
		Если ТипЗнч(Статус) = Тип("Соответствие") И Статус.Свойство("error") Тогда
			ВызватьИсключение СтрШаблон("Qdrant search error: %1", Статус["error"]);
		КонецЕсли;
	КонецЕсли;

	// { "result": [ { "id": ..., "score": ..., "payload": {...} }, ... ] }
	РезультатыПоиска = ДанныеОтвета["result"];
	Если Не ЗначениеЗаполнено(РезультатыПоиска) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат РезультатыПоиска;

КонецФункции

// ОбработатьПорциюВекторизации
// Вызывается фоновым заданием для одной порции (одна коллекция).
// Получает данные из AI_ОчередьВекторизации, строит векторы, отправляет в Qdrant,
// фиксирует в AI_ИдентификаторыЧанков, удаляет из очереди.
//
// Параметры:
//   ПараметрЗадания - Структура - { Коллекция, МассивИдентификаторов }
Процедура ОбработатьПорциюВекторизации(ПараметрЗадания) Экспорт

	Коллекция            = ПараметрЗадания.Коллекция;
	МассивИдентификаторов = ПараметрЗадания.МассивИдентификаторов;

	// 1. Получаем данные коллекции и компонента RAG
	ДанныеКоллекцийСоответствие = Справочники.AI_RAGКоллекции.ПолучитьЗначенияКоллекций(Коллекция);
	ДанныеКоллекции = ДанныеКоллекцийСоответствие[Коллекция];

	// КомпонентRAG — владелец коллекции (Справочник.AI_RAG)
	КомпонентRAGСсылка = ДанныеКоллекции.Ссылка.Владелец;
	КомпонентRAG       = ПолучитьСтруктуруКомпонентаRAG(КомпонентRAGСсылка);

	ИмяКоллекции = ДанныеКоллекции.Наименование;

	// 2. Проверяем / создаём коллекцию в Qdrant
	КоллекцииQdrant = ПолучитьКоллекцииQdrant(КомпонентRAG, ИмяКоллекции);
	КоллекцияСуществует = КоллекцииQdrant.Количество() > 0;

	Если Не КоллекцияСуществует Тогда
		РезИниц = ИнициализироватьКоллекциюВQdrant(Коллекция, КомпонентRAG);
		Если Не РезИниц.Успех Тогда
			ВызватьИсключение СтрШаблон(
				"Не удалось инициализировать коллекцию [%1] в Qdrant: %2",
				ИмяКоллекции, РезИниц.Описание);
		КонецЕсли;
	КонецЕсли;

	// 3. Читаем данные записей очереди
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.УникальныйИдентификатор     КАК УникальныйИдентификатор,
		|	Очередь.ИдентификаторЧанка           КАК ИдентификаторЧанка,
		|	Очередь.ИдентификаторСущности        КАК ИдентификаторСущности,
		|	Очередь.ЗаголовокЧанка               КАК ЗаголовокЧанка,
		|	Очередь.Подзаголовок                 КАК Подзаголовок,
		|	Очередь.ПодзаголовокВторогоУровня    КАК ПодзаголовокВторогоУровня,
		|	Очередь.Данные                       КАК Данные,
		|	Очередь.КонтекстТекст                КАК КонтекстТекст,
		|	Очередь.ОтображаемыйТекст            КАК ОтображаемыйТекст,
		|	Очередь.ХешДанных                    КАК ХешДанных,
		|	Очередь.НомерЧанка                   КАК НомерЧанка,
		|	Очередь.ВсегоЧанков                  КАК ВсегоЧанков,
		|	Очередь.Секция                       КАК Секция,
		|	Очередь.ИсточникВнутреннийТип        КАК ИсточникВнутреннийТип,
		|	Очередь.НавигационнаяСсылка          КАК НавигационнаяСсылка,
		|	Очередь.Разрешения                   КАК Разрешения,
		|	Очередь.Тенант                       КАК Тенант,
		|	Очередь.ОрганизацияИГуид             КАК ОрганизацияИГуид,
		|	Очередь.Язык                         КАК Язык,
		|	Очередь.Источник                     КАК Источник
		|ИЗ
		|	РегистрСведений.AI_ОчередьВекторизации КАК Очередь
		|ГДЕ
		|	Очередь.УникальныйИдентификатор В (&МассивИдентификаторов)";

	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	Выборка = Запрос.Выполнить().Выбрать();

	// 4. Строим точки пакетами по 50 штук — не перегружаем Embedding-сервис
	РазмерПорции = 50;
	МассивТочек  = Новый Массив;
	ОбработанныеИдентификаторы = Новый Массив;

	// Отслеживаем актуальные ID чанков по сущностям для последующей чистки сирот.
	// Ключ = НавигационнаяСсылка + "|" + ТипСущности
	ТекущиеЧанкиПоСущностям = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		// 4а. Проверяем хеш — если данные не изменились, пропускаем
		Если ХешНеИзменился(Выборка.НавигационнаяСсылка, Выборка.ИсточникВнутреннийТип,
		                     Выборка.НомерЧанка, Выборка.ИдентификаторЧанка, Выборка.ХешДанных) Тогда
			// Чанк не изменился — фиксируем как актуальный (сиротой не является)
			ДобавитьАктуальныйЧанк(ТекущиеЧанкиПоСущностям,
				Выборка.НавигационнаяСсылка, Выборка.ИсточникВнутреннийТип, Выборка.ИдентификаторЧанка);
			// Удаляем из очереди без повторной векторизации
			УдалитьЗаписьИзОчереди(Выборка.УникальныйИдентификатор);
			Продолжить;
		КонецЕсли;

		// 4б. Получаем вектор
		Вектор = ПолучитьВектор(КомпонентRAG, Выборка.Данные);

		// 4в. Строим payload для Qdrant — всё что пригодится при поиске
		Payload = Новый Структура;
		Payload.Вставить("text",          Выборка.КонтекстТекст);    // текст для LLM
		Payload.Вставить("display_text",  Выборка.ОтображаемыйТекст); // текст для UI
		Payload.Вставить("header",        Выборка.ЗаголовокЧанка);
		Payload.Вставить("subheader",     Выборка.Подзаголовок);
		Payload.Вставить("subheader2",    Выборка.ПодзаголовокВторогоУровня);
		Payload.Вставить("section",       Выборка.Секция);
		Payload.Вставить("chunk_num",     Выборка.НомерЧанка);
		Payload.Вставить("chunks_total",  Выборка.ВсегоЧанков);
		Payload.Вставить("entity_id",     Выборка.ИдентификаторСущности);
		Payload.Вставить("entity_type",   Выборка.ИсточникВнутреннийТип);
		Payload.Вставить("nav_ref",       Выборка.НавигационнаяСсылка);
		Payload.Вставить("source",        Выборка.Источник);
		Payload.Вставить("tenant",        Выборка.Тенант);
		Payload.Вставить("org_guid",      Выборка.ОрганизацияИГуид);
		Payload.Вставить("lang",          Выборка.Язык);
		Payload.Вставить("permissions",   Выборка.Разрешения);

		// 4г. Формируем точку — id берём из ИдентификаторЧанка (UUID)
		Точка = Новый Структура;
		Точка.Вставить("id",      Строка(Выборка.ИдентификаторЧанка));
		Точка.Вставить("vector",  Вектор);
		Точка.Вставить("payload", Payload);
		МассивТочек.Добавить(Точка);

		// Фиксируем как актуальный (новая или обновлённая версия чанка)
		ДобавитьАктуальныйЧанк(ТекущиеЧанкиПоСущностям,
			Выборка.НавигационнаяСсылка, Выборка.ИсточникВнутреннийТип, Выборка.ИдентификаторЧанка);

		// Запоминаем для последующей фиксации
		ОбработанныеИдентификаторы.Добавить(Новый Структура(
			"УникальныйИдентификатор, ИдентификаторЧанка, НавигационнаяСсылка,
			|ИсточникВнутреннийТип, НомерЧанка, ХешДанных, Вектор",
			Выборка.УникальныйИдентификатор,
			Выборка.ИдентификаторЧанка,
			Выборка.НавигационнаяСсылка,
			Выборка.ИсточникВнутреннийТип,
			Выборка.НомерЧанка,
			Выборка.ХешДанных,
			OPI_Инструменты.JSONСтрокой(Вектор, , Ложь, Ложь)));

		// 4д. Отправляем порцию и сбрасываем накопитель
		Если МассивТочек.Количество() >= РазмерПорции Тогда
			ОтправитьПорциюВQdrant(КомпонентRAG, ИмяКоллекции, МассивТочек, ОбработанныеИдентификаторы);
			МассивТочек = Новый Массив;
			ОбработанныеИдентификаторы = Новый Массив;
		КонецЕсли;

	КонецЦикла;

	// 4е. Отправляем остаток (хвост менее 50 записей)
	Если МассивТочек.Количество() > 0 Тогда
		ОтправитьПорциюВQdrant(КомпонентRAG, ИмяКоллекции, МассивТочек, ОбработанныеИдентификаторы);
	КонецЕсли;

	// 5. Удаляем устаревшие (сиротские) чанки для всех обработанных сущностей.
	// Вызывается после того как все порции отправлены — новые ID уже в Qdrant.
	Для Каждого КЗ Из ТекущиеЧанкиПоСущностям Цикл
		УдалитьСтарыеЧанкиСущности(КомпонентRAG, ИмяКоллекции,
			КЗ.Значение.НавигационнаяСсылка, КЗ.Значение.ТипСущности, КЗ.Значение.МассивID);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Dispatch подготовки к векторизации по типу ссылок.
// Изолированное расширение не сериализует произвольные объекты автоматически:
// состав индексируемых полей должен быть явно задан в проекте внедрения.
Процедура ОбработкаМассиваОчередиПодготовкиПоТипу(МассивСсылок, ТипСсылок)

	ТекстОшибки = СтрШаблон(
		"AI_RAG: сборщик данных типа [%1] не настроен. "
			+ "Добавьте явную обработку типа перед постановкой объектов в очередь.",
		ТипСсылок);
	ЗаписьЖурналаРегистрации(
		"AI_RAG",
		УровеньЖурналаРегистрации.Ошибка, , ,
		ТекстОшибки);
	ВызватьИсключение ТекстОшибки;

КонецПроцедуры

// ЗаголовкиEmbedding
// Формирует заголовки для запросов к Embedding-сервису (OpenAI-совместимый).
Функция ЗаголовкиEmbedding(APIКлюч)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");

	Если ЗначениеЗаполнено(APIКлюч) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + APIКлюч);
	КонецЕсли;

	Возврат Заголовки;

КонецФункции

// ЗаголовкиQdrant
// Формирует заголовки для запросов к Qdrant.
Функция ЗаголовкиQdrant(APIКлюч)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");

	Если ЗначениеЗаполнено(APIКлюч) Тогда
		// Qdrant использует api-key заголовок
		Заголовки.Вставить("api-key", APIКлюч);
	КонецЕсли;

	Возврат Заголовки;

КонецФункции

// НовыйРезультатОперации
// Вспомогательная фабрика для возврата унифицированного результата.
Функция НовыйРезультатОперации()

	Результат = Новый Структура;
	Результат.Вставить("Успех",    Ложь);
	Результат.Вставить("Описание", "");
	Возврат Результат;

КонецФункции

// ОтправитьПорциюВQdrant
// Отправляет накопленный массив точек в Qdrant, затем фиксирует результат
// в AI_ИдентификаторыЧанков и удаляет записи из AI_ОчередьВекторизации.
Процедура ОтправитьПорциюВQdrant(КомпонентRAG, ИмяКоллекции, МассивТочек, ОбработанныеИдентификаторы)

	Результат = ОтправитьДанныеВQdrant(КомпонентRAG, ИмяКоллекции, МассивТочек);

	Если Не Результат.Успех Тогда
		// Логируем ошибку — не прерываем всю очередь, оставляем записи на следующий запуск РЗ
		ЗаписьЖурналаРегистрации(
			"AI_RAG.Векторизация",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон("Ошибка отправки в Qdrant [%1]: %2", ИмяКоллекции, Результат.Описание));
		Возврат;
	КонецЕсли;

	// Фиксируем успешно отправленные чанки
	Для Каждого Запись Из ОбработанныеИдентификаторы Цикл

		НачатьТранзакцию();
		Попытка

			// Обновляем/создаём запись в AI_ИдентификаторыЧанков
			ЗафиксироватьИдентификаторЧанка(Запись);

			// Удаляем из очереди
			УдалитьЗаписьИзОчереди(Запись.УникальныйИдентификатор);

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(
				"AI_RAG.Векторизация",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				СтрШаблон("Ошибка фиксации чанка [%1]: %2",
					Запись.ИдентификаторЧанка, ОписаниеОшибки()));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// ЗафиксироватьИдентификаторЧанка
// Записывает или обновляет строку в AI_ИдентификаторыЧанков.
// Измерения: НавигационнаяСсылка + ТипСущности + НомерЧанка + ИдентификаторЧанка + ХешДанных
// Ресурсы: Вектор (JSON-строка), ХэшДанных (дублирует для быстрой проверки)
Процедура ЗафиксироватьИдентификаторЧанка(Запись)

	МенеджерЗаписи = РегистрыСведений.AI_ИдентификаторыЧанков.СоздатьМенеджерЗаписи();

	// Измерения (ключ записи)
	МенеджерЗаписи.НавигационнаяСсылка = Запись.НавигационнаяСсылка;
	МенеджерЗаписи.ТипСущности          = Запись.ИсточникВнутреннийТип;
	МенеджерЗаписи.НомерЧанка           = Запись.НомерЧанка;
	МенеджерЗаписи.ИдентификаторЧанка   = Запись.ИдентификаторЧанка;
	МенеджерЗаписи.ХешДанных            = Запись.ХешДанных;

	// Ресурсы
	МенеджерЗаписи.Вектор    = Запись.Вектор;    // JSON-строка вектора — для кеша
	МенеджерЗаписи.ХэшДанных = Запись.ХешДанных; // Дублируем в ресурс для запросов без соединения

	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// ХешНеИзменился
// Проверяет: есть ли в AI_ИдентификаторыЧанков запись с таким же хешем.
// Если есть — данные не изменились, повторная векторизация не нужна.
//
// Возвращаемое значение: Булево
Функция ХешНеИзменился(НавигационнаяСсылка, ТипСущности, НомерЧанка, ИдентификаторЧанка, ХешДанных)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Признак
		|ИЗ
		|	РегистрСведений.AI_ИдентификаторыЧанков КАК ИдЧанков
		|ГДЕ
		|	ИдЧанков.НавигационнаяСсылка = &НавигационнаяСсылка
		|	И ИдЧанков.ТипСущности        = &ТипСущности
		|	И ИдЧанков.НомерЧанка         = &НомерЧанка
		|	И ИдЧанков.ИдентификаторЧанка = &ИдентификаторЧанка
		|	И ИдЧанков.ХешДанных          = &ХешДанных";

	Запрос.УстановитьПараметр("НавигационнаяСсылка", НавигационнаяСсылка);
	Запрос.УстановитьПараметр("ТипСущности",          ТипСущности);
	Запрос.УстановитьПараметр("НомерЧанка",           НомерЧанка);
	Запрос.УстановитьПараметр("ИдентификаторЧанка",   ИдентификаторЧанка);
	Запрос.УстановитьПараметр("ХешДанных",            ХешДанных);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// УдалитьЗаписьИзОчереди
// Удаляет одну запись из AI_ОчередьВекторизации по УникальномуИдентификатору.
Процедура УдалитьЗаписьИзОчереди(УникальныйИдентификатор)

	НаборЗаписей = РегистрыСведений.AI_ОчередьВекторизации.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УникальныйИдентификатор.Установить(УникальныйИдентификатор);
	НаборЗаписей.Записать(Истина); // Пустой набор = удаление записи

КонецПроцедуры

// ПолучитьСтруктуруКомпонентаRAG
// Читает реквизиты справочника AI_RAG и собирает структуру КомпонентRAG,
// идентичную той, что строит AI_Клиент из SQL-запроса.
// Вызывается из фонового задания, где AI_Клиент недоступен.
//
// Параметры:
//   КомпонентRAGСсылка - СправочникСсылка.AI_RAG
//
// Возвращаемое значение:
//   Структура - поля КомпонентRAG
Функция ПолучитьСтруктуруКомпонентаRAG(КомпонентRAGСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	AI_RAG.Наименование          КАК Наименование,
		|	AI_RAG.Активен               КАК Активен,
		|	AI_RAG.EmbeddingURL          КАК EmbeddingURL,
		|	AI_RAG.EmbeddingМодель       КАК EmbeddingМодель,
		|	AI_RAG.EmbeddingТаймаутСек   КАК EmbeddingТаймаутСек,
		|	AI_RAG.EmbeddingРазмерность  КАК EmbeddingРазмерность,
		|	AI_RAG.EmbeddingAPIКлюч      КАК EmbeddingAPIКлюч,
		|	AI_RAG.QdrantURL             КАК QdrantURL,
		|	AI_RAG.QdrantТаймаутСек      КАК QdrantТаймаутСек,
		|	AI_RAG.QdrantAPIКлюч         КАК QdrantAPIКлюч
		|ИЗ
		|	Справочник.AI_RAG КАК AI_RAG
		|ГДЕ
		|	AI_RAG.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", КомпонентRAGСсылка);
	Строка = Запрос.Выполнить().Выгрузить()[0];

	Если Не Строка.Активен Тогда
		ВызватьИсключение СтрШаблон("RAG-компонент [%1] не активен", Строка.Наименование);
	КонецЕсли;

	КомпонентRAG = Новый Структура;
	КомпонентRAG.Вставить("Наименование",         Строка.Наименование);
	КомпонентRAG.Вставить("EmbeddingURL",          Строка.EmbeddingURL);
	КомпонентRAG.Вставить("EmbeddingМодель",       Строка.EmbeddingМодель);
	КомпонентRAG.Вставить("EmbeddingТаймаутСек",   Строка.EmbeddingТаймаутСек);
	КомпонентRAG.Вставить("EmbeddingРазмерность",  Строка.EmbeddingРазмерность);
	КомпонентRAG.Вставить("EmbeddingAPIКлюч",      Строка.EmbeddingAPIКлюч);
	КомпонентRAG.Вставить("QdrantURL",             Строка.QdrantURL);
	КомпонентRAG.Вставить("QdrantТаймаутСек",      Строка.QdrantТаймаутСек);
	КомпонентRAG.Вставить("QdrantAPIКлюч",         Строка.QdrantAPIКлюч);

	Возврат КомпонентRAG;

КонецФункции

// ДобавитьАктуальныйЧанк
// Вспомогательная процедура: добавляет ИдентификаторЧанка в карту актуальных ID по сущности.
// Используется в ОбработатьПорциюВекторизации для отслеживания чанков, которые не являются сиротами.
//
// Параметры:
//   ТекущиеЧанкиПоСущностям - Соответствие (изменяется) - карта ключ→{НавигационнаяСсылка, ТипСущности, МассивID}
//   НавигационнаяСсылка     - Строка
//   ТипСущности             - Строка
//   ИдентификаторЧанка      - УникальныйИдентификатор
Процедура ДобавитьАктуальныйЧанк(ТекущиеЧанкиПоСущностям, НавигационнаяСсылка, ТипСущности, ИдентификаторЧанка)

	Ключ = НавигационнаяСсылка + "|" + ТипСущности;

	Если ТекущиеЧанкиПоСущностям.Получить(Ключ) = Неопределено Тогда
		ТекущиеЧанкиПоСущностям.Вставить(Ключ, Новый Структура(
			"НавигационнаяСсылка, ТипСущности, МассивID",
			НавигационнаяСсылка, ТипСущности, Новый Массив));
	КонецЕсли;

	ТекущиеЧанкиПоСущностям.Получить(Ключ).МассивID.Добавить(ИдентификаторЧанка);

КонецПроцедуры

// УдалитьСтарыеЧанкиСущности
// Находит чанки сущности в AI_ИдентификаторыЧанков, которых нет в переданном массиве актуальных,
// и удаляет их из Qdrant и реестра.
//
// Вызывается в конце ОбработатьПорциюВекторизации после успешной отправки всех новых порций.
// Это гарантирует: новые данные уже в Qdrant до того, как старые удаляются.
//
// Параметры:
//   КомпонентRAG        - Структура - данные RAG-компонента
//   ИмяКоллекции        - Строка    - имя коллекции в Qdrant
//   НавигационнаяСсылка - Строка    - навигационная ссылка сущности
//   ТипСущности         - Строка    - тип сущности (ИсточникВнутреннийТип)
//   НовыеИдентификаторы - Массив    - актуальные ИдентификаторыЧанка (UUID)
Процедура УдалитьСтарыеЧанкиСущности(КомпонентRAG, ИмяКоллекции,
		НавигационнаяСсылка, ТипСущности, НовыеИдентификаторы)

	// 1. Читаем все существующие чанки сущности (нужен полный ключ для МенеджерЗаписи.Удалить)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИдЧанков.НавигационнаяСсылка КАК НавигационнаяСсылка,
		|	ИдЧанков.ТипСущности         КАК ТипСущности,
		|	ИдЧанков.НомерЧанка          КАК НомерЧанка,
		|	ИдЧанков.ИдентификаторЧанка  КАК ИдентификаторЧанка,
		|	ИдЧанков.ХешДанных           КАК ХешДанных
		|ИЗ
		|	РегистрСведений.AI_ИдентификаторыЧанков КАК ИдЧанков
		|ГДЕ
		|	ИдЧанков.НавигационнаяСсылка = &НавигационнаяСсылка
		|	И ИдЧанков.ТипСущности = &ТипСущности";
	Запрос.УстановитьПараметр("НавигационнаяСсылка", НавигационнаяСсылка);
	Запрос.УстановитьПараметр("ТипСущности",          ТипСущности);
	Выборка = Запрос.Выполнить().Выбрать();

	// 2. Строим множество актуальных ID для быстрой проверки
	НовыеIDСоответствие = Новый Соответствие;
	Для Каждого НовыйID Из НовыеИдентификаторы Цикл
		НовыеIDСоответствие.Вставить(Строка(НовыйID), Истина);
	КонецЦикла;

	// 3. Находим и удаляем сирот из реестра
	МассивСиротQdrant = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ИДСтрокой = Строка(Выборка.ИдентификаторЧанка);
		Если НовыеIDСоответствие.Получить(ИДСтрокой) = Неопределено Тогда
			МассивСиротQdrant.Добавить(ИДСтрокой);
			// Удаляем запись реестра (полный ключ известен из выборки)
			МенеджерЗаписи = РегистрыСведений.AI_ИдентификаторыЧанков.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.НавигационнаяСсылка = Выборка.НавигационнаяСсылка;
			МенеджерЗаписи.ТипСущности          = Выборка.ТипСущности;
			МенеджерЗаписи.НомерЧанка           = Выборка.НомерЧанка;
			МенеджерЗаписи.ИдентификаторЧанка   = Выборка.ИдентификаторЧанка;
			МенеджерЗаписи.ХешДанных            = Выборка.ХешДанных;
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	КонецЦикла;

	// 4. Удаляем сирот из Qdrant
	Если МассивСиротQdrant.Количество() > 0 Тогда
		РезультатУдаления = УдалитьТочкиИзQdrant(КомпонентRAG, ИмяКоллекции, МассивСиротQdrant);
		Если Не РезультатУдаления.Успех Тогда
			ЗаписьЖурналаРегистрации("AI_RAG.Векторизация",
				УровеньЖурналаРегистрации.Ошибка, , ,
				СтрШаблон("Ошибка удаления сирот из Qdrant [%1/%2]: %3",
					ТипСущности, НавигационнаяСсылка, РезультатУдаления.Описание));
		Иначе
			ЗаписьЖурналаРегистрации("AI_RAG.Векторизация",
				УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("Удалено %1 устаревших чанков сущности [%2/%3]",
					МассивСиротQdrant.Количество(), ТипСущности, НавигационнаяСсылка));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// УдалитьТочкиИзQdrant
// Удаляет точки из коллекции Qdrant по массиву строковых ID.
// Использует POST /collections/{name}/points/delete с телом { "points": [...] }.
// Операция идемпотентна — повторное удаление несуществующих точек безопасно.
//
// Параметры:
//   КомпонентRAG          - Структура - данные RAG-компонента (QdrantURL, QdrantAPIКлюч)
//   ИмяКоллекции          - Строка    - имя коллекции в Qdrant
//   МассивИдентификаторов - Массив    - строковые UUID точек для удаления
//
// Возвращаемое значение:
//   Структура - { Успех: Булево, Описание: Строка }
Функция УдалитьТочкиИзQdrant(КомпонентRAG, ИмяКоллекции, МассивИдентификаторов)

	Результат = НовыйРезультатОперации();

	Если МассивИдентификаторов.Количество() = 0 Тогда
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	URL       = СтрШаблон("%1/collections/%2/points/delete", КомпонентRAG.QdrantURL, ИмяКоллекции);
	Заголовки = ЗаголовкиQdrant(КомпонентRAG.QdrantAPIКлюч);

	Тело = Новый Структура;
	Тело.Вставить("points", МассивИдентификаторов);

	Попытка
		Ответ     = OPI_ЗапросыHTTP.PostСТелом(URL, Тело, Заголовки);
		КодОтвета = Ответ.КодСостояния;

		Если КодОтвета <> 200 И КодОтвета <> 202 Тогда
			Результат.Описание = СтрШаблон(
				"Qdrant DELETE /points вернул код %1. Тело: %2",
				КодОтвета,
				OPI_Инструменты.JSONСтрокой(Ответ.ПолучитьТелоКакСтроку()));
			Возврат Результат;
		КонецЕсли;

		Результат.Успех = Истина;
	Исключение
		Результат.Описание = "Ошибка при удалении точек из Qdrant: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти
