// Копируем структуру чтобы в массиве были разные объекты
Функция ОбъединитьСтруктуру(Источник)
	Копия = Новый Структура;
	Для Каждого Элемент Из Источник Цикл
		Копия.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции

Функция НоваяТаблицаРезультатов()
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Score",     Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 4)));
	ТЗ.Колонки.Добавить("Заголовок", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Текст",     Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("НавСсылка", Новый ОписаниеТипов("Строка"));
	Возврат ТЗ;
КонецФункции

