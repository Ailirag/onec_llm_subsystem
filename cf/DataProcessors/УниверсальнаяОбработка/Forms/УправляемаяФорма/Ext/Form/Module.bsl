// @strict-types


#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Для скрытия команд относящихся к консоли кода
	Элементы.ОтменаТранзакции.Видимость	= Ложь;
	Элементы.ФормаСтатистика.Видимость	= Ложь;
	Элементы.КонсольКода_ГруппаСохраненные.Видимость			= Ложь;
	Элементы.ДеревоОбъектовМетаданных.Видимость					= Ложь;
	Элементы.ДеревоОбъектовМетаданныхПодробности.Видимость		= Ложь;
	Элементы.СписокАлгоритмовСохранитьТекущийАлгоритм.Видимость	= Ложь;
	Элементы.Заменить.Видимость									= Ложь;
	
	// Страница соединения таблиц
	Элементы.ГруппаСлужебнаяИнформация.Видимость	= Ложь;
	Элементы.ТипСвязи.Видимость						= Ложь;
	Элементы.ЗвуковоеОповещение.Видимость			= Ложь;
	Элементы.ВизуальныйКонструктор_ОтображатьЗапрос.Видимость	= Ложь;
	
	// Для открытия файла сохраненных алгоритмов
	ПутьКФайлу					= РеквизитФормыВЗначение("Объект").ИспользуемоеИмяФайла;
	ПапкаИсполнения				= Сред(ПутьКФайлу, 0, СтрНайти(ПутьКФайлу, "\", НаправлениеПоиска.СКонца));
	ПервоеОткрытиеКонсолиКода	= Истина;
	
	РежимДополнительнойОбработки = ПапкаИсполнения = "e1cib\tempstorage\";
	
	Если РежимДополнительнойОбработки Тогда
		Шаблон("Режим дополнительной обработки: %1", РежимДополнительнойОбработки);
	КонецЕсли;
	
	ХранимыеФайлы_ОбновитьНаСервере();
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ, ПринудительныйВызов = Ложь)
	//Поиск ранее сохраненных алгоритмов
	Если Не РежимДополнительнойОбработки ИЛИ ПринудительныйВызов Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеПоискаФайлов", ЭтаФорма);
		НачатьПоискФайлов(Оповещение, ПапкаИсполнения, "_conscode");
	Иначе
		// Попытка достать адрес на клиентской машине из памяти сервера
		// если нет данных в памяти попросить указать, затем записать в память на сервере
		ИмяПапки = ДанныеЛокальногоПутиИзСервера();
		
		Если ИмяПапки = Неопределено Тогда
			
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораКаталога", ЭтаФорма);
			
			ДиалогВыбораПапки = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
			ДиалогВыбораПапки.Показать(Оповещение);
			
		Иначе
			
			ПапкаИсполнения = ИмяПапки;
			ПриОткрытии(Ложь, Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
	СформироватьПодсказку();
	
КонецПроцедуры

#КонецОбласти 

#Область ОБРАБОТЧИКИ_КОМАНД_ФОРМЫ

&НаКлиенте
Процедура Сохранить(Команда)
	
	СохранитьОбъектСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура НовыйОбъект(Команда)
	
	Если Объект.СсылкаНаОбъект = Неопределено Тогда
		СообщитьПользователю("Не выбран тип объекта",, "Объект.СсылкаНаОбъект");
		Возврат;
	КонецЕсли;
	
	Если ЕстьГруппы(Объект.СсылкаНаОбъект) Тогда
		СписокВыбора = Новый СписокЗначений;
		СписокВыбора.Добавить("Элемент");
		СписокВыбора.Добавить("Группа");
		
		Результат = ВыбратьИзМеню(СписокВыбора, Элементы.НовыйОбъект);
		
		Если Результат = Неопределено Тогда
			Возврат;
		ИначеЕсли Результат.Значение = "Элемент" Тогда
			Группа = Ложь;
		Иначе
			Группа = Истина;
		КонецЕсли;
	Иначе
		Группа = Ложь;
	КонецЕсли;
	
	ЗаполнитьФормуСервер(Истина, Группа);
	
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьОбъект(Команда)
	
	ЗаполнитьФормуСервер();
	
КонецПроцедуры

#КонецОбласти 

