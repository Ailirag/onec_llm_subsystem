Функция КоличествоХарактеристик(Знач ЗапросСхемы)

	Попытка
		Возврат ЗапросСхемы.Характеристики.Количество();
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Периодичность оборотов («Обороты(&Начало, &Конец, Авто)») — ключевое слово, а не поле.
Функция ЭтоПериодичностьВиртуальнойТаблицы(Знач Выражение)

	Слово = ВРег(СокрЛП(Строка(Выражение)));
	Возврат ЗначениеЗаполнено(Слово)
		И СтрНайти(
			",АВТО,ЗАПИСЬ,РЕГИСТРАТОР,ПЕРИОД,СЕКУНДА,МИНУТА,ЧАС,ДЕНЬ,НЕДЕЛЯ,ДЕКАДА,МЕСЯЦ,КВАРТАЛ,ПОЛУГОДИЕ,ГОД,"
				+ "AUTO,RECORD,RECORDER,PERIOD,SECOND,MINUTE,HOUR,DAY,WEEK,TENDAYS,MONTH,QUARTER,HALFYEAR,YEAR,",
			"," + Слово + ",") > 0;

КонецФункции

Функция ВнутриПредставления(Знач Разбор)

	Для Каждого ИмяФункции Из Разбор.Функции Цикл
		Если СтрНайти(",ПРЕДСТАВЛЕНИЕ,PRESENTATION,ПРЕДСТАВЛЕНИЕССЫЛКИ,REFPRESENTATION,", "," + ИмяФункции + ",") > 0
				И ЗначениеЗаполнено(ИмяФункции) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция КлючевыеСловаВыражений()

	Слова = "И,ИЛИ,НЕ,В,ИЕРАРХИИ,ПОДОБНО,СПЕЦСИМВОЛ,МЕЖДУ,ЕСТЬ,NULL,ИСТИНА,ЛОЖЬ,НЕОПРЕДЕЛЕНО,"
		+ "ВЫБОР,КОГДА,ТОГДА,ИНАЧЕ,КОНЕЦ,РАЗЛИЧНЫЕ,"
		+ "СЕКУНДА,МИНУТА,ЧАС,ДЕНЬ,НЕДЕЛЯ,МЕСЯЦ,КВАРТАЛ,ГОД,ДЕКАДА,ПОЛУГОДИЕ,"
		+ "СТРОКА,ЧИСЛО,ДАТА,БУЛЕВО,"
		+ "AND,OR,NOT,IN,HIERARCHY,LIKE,ESCAPE,BETWEEN,IS,TRUE,FALSE,UNDEFINED,"
		+ "CASE,WHEN,THEN,ELSE,END,DISTINCT,"
		+ "SECOND,MINUTE,HOUR,DAY,WEEK,MONTH,QUARTER,YEAR,TENDAYS,HALFYEAR,"
		+ "STRING,NUMBER,DATE,BOOLEAN";
	Результат = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить(Слова, ",") Цикл
		Результат.Вставить(Слово, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Звездочку схема запроса раскрыла бы в список полей, и запрещенные поля были бы
// отклонены, но она отклоняется явно: модель перечисляет нужные поля, а не
// забирает все, что есть в объекте. Фигурные скобки — расширение языка запросов
// для компоновки данных; агенту оно не нужно.
Функция ПроверитьКонструкцииТекста(Знач Лексемы)

	Для Индекс = 0 По Лексемы.ВГраница() Цикл
		Лексема = Лексемы[Индекс];
		Если Лексема.Вид <> "символ" Тогда
			Продолжить;
		КонецЕсли;
		Если Лексема.Значение = "{" Или Лексема.Значение = "}" Тогда
			Возврат "Конструкции компоновки данных в фигурных скобках в запросе агента запрещены.";
		КонецЕсли;
		Если Лексема.Значение = "*" И ЭтоВыборкаВсехПолей(Лексемы, Индекс) Тогда
			Возврат "Выборка всех полей («*») запрещена: перечислите нужные поля явно.";
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ЭтоВыборкаВсехПолей(Знач Лексемы, Знач Индекс)

	// КОЛИЧЕСТВО(*) и умножение звездочку тоже содержат.
	Если Индекс = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Предыдущая = Лексемы[Индекс - 1];
	Если Предыдущая.Вид = "символ" Тогда
		Возврат Предыдущая.Значение = "." Или Предыдущая.Значение = ",";
	КонецЕсли;
	Если Предыдущая.Вид = "идентификатор" Тогда
		Возврат СтрНайти(",ВЫБРАТЬ,SELECT,РАЗЛИЧНЫЕ,DISTINCT,РАЗРЕШЕННЫЕ,ALLOWED,", "," + Предыдущая.Верх + ",") > 0;
	КонецЕсли;
	Если Предыдущая.Вид = "число" И Индекс > 1 Тогда
		ПередЧислом = Лексемы[Индекс - 2];
		Возврат ПередЧислом.Вид = "идентификатор"
			И (ПередЧислом.Верх = "ПЕРВЫЕ" Или ПередЧислом.Верх = "TOP");
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Лексемы языка запросов: строковые константы, параметры, числа, слова
// (имена полей, таблиц, функций, ключевые слова) и одиночные символы.
Функция РазобратьНаЛексемы(Знач Текст)

	Лексемы = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Начало = Позиция;
		Если ЭтоПробельныйСимвол(Символ) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если Символ = """" Тогда
			Позиция = Позиция + 1;
			Пока Истина Цикл
				Если Позиция > Длина Тогда
					ВызватьИсключение "в запросе не закрыта строковая константа.";
				КонецЕсли;
				Если Сред(Текст, Позиция, 1) = """" Тогда
					Если Сред(Текст, Позиция + 1, 1) <> """" Тогда
						Прервать;
					КонецЕсли;
					Позиция = Позиция + 1;
				КонецЕсли;
				Позиция = Позиция + 1;
			КонецЦикла;
			Позиция = Позиция + 1;
			ДобавитьЛексему(Лексемы, "строка", Сред(Текст, Начало, Позиция - Начало), Начало);
			Продолжить;
		КонецЕсли;

		Если Символ <> "&" И ЭтоРазделительЛексем(Символ) Тогда
			ДобавитьЛексему(Лексемы, "символ", Символ, Начало);
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Позиция = Позиция + 1;
		Пока Позиция <= Длина И Не ЭтоРазделительЛексем(Сред(Текст, Позиция, 1)) Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		// Дробная часть числа: «1.5» — одна лексема, а не поле «5» после точки.
		Если ЭтоЦифра(Символ)
				И Сред(Текст, Позиция, 1) = "."
				И ЭтоЦифра(Сред(Текст, Позиция + 1, 1)) Тогда
			Позиция = Позиция + 1;
			Пока Позиция <= Длина И Не ЭтоРазделительЛексем(Сред(Текст, Позиция, 1)) Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
		КонецЕсли;
		Если Символ = "&" Тогда
			Вид = "параметр";
		ИначеЕсли ЭтоЦифра(Символ) Тогда
			Вид = "число";
		Иначе
			Вид = "идентификатор";
		КонецЕсли;
		ДобавитьЛексему(Лексемы, Вид, Сред(Текст, Начало, Позиция - Начало), Начало);
	КонецЦикла;
	Возврат Лексемы;

КонецФункции

Процедура ДобавитьЛексему(Знач Лексемы, Знач Вид, Знач Значение, Знач Начало)

	Лексемы.Добавить(Новый Структура(
		"Вид,Значение,Верх,Начало",
		Вид,
		Значение,
		ВРег(Значение),
		Начало));

КонецПроцедуры

Функция ЭтоПробельныйСимвол(Знач Символ)

	Возврат Символ = " "
		Или Символ = Символы.Таб
		Или Символ = Символы.ПС
		Или Символ = Символы.ВК
		Или Символ = Символы.НПП
		Или Символ = Символы.ПФ
		Или Символ = Символы.ВТаб;

КонецФункции

Функция ЭтоРазделительЛексем(Знач Символ)

	Если СтрДлина(Символ) = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЭтоПробельныйСимвол(Символ)
		Или СтрНайти("()[]{},.;:+-*/=<>&""'!?%|\^~@#$`", Символ) > 0;

КонецФункции

Функция ЭтоЦифра(Знач Символ)

	Возврат СтрДлина(Символ) = 1 И СтрНайти("0123456789", Символ) > 0;

КонецФункции

Функция ЭтоСимволЛексемы(Знач Лексемы, Знач Индекс, Знач Символ)

	Если Индекс < 0 Или Индекс >= Лексемы.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Лексема = Лексемы[Индекс];
	Возврат Лексема.Вид = "символ" И Лексема.Значение = Символ;

КонецФункции

Функция ЭтоСловоЛексемы(Знач Лексемы, Знач Индекс, Знач СписокСлов)

	Если Индекс < 0 Или Индекс >= Лексемы.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Лексема = Лексемы[Индекс];
	Возврат Лексема.Вид = "идентификатор"
		И СтрНайти("," + СписокСлов + ",", "," + Лексема.Верх + ",") > 0;

КонецФункции

Функция ИмяФункцииПередСкобкой(Знач Лексемы, Знач Индекс)

	Если Индекс = 0 Или Лексемы[Индекс - 1].Вид <> "идентификатор" Тогда
		Возврат "";
	КонецЕсли;
	Если ЭтоСимволЛексемы(Лексемы, Индекс - 2, ".") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лексемы[Индекс - 1].Верх;

КонецФункции

Функция ПрочитатьЦепочку(Знач Лексемы, Знач Индекс, Знач Имена)

	Если Индекс >= Лексемы.Количество() Или Лексемы[Индекс].Вид <> "идентификатор" Тогда
		Возврат Индекс;
	КонецЕсли;
	Имена.Добавить(Лексемы[Индекс].Значение);
	Индекс = Индекс + 1;
	Пока ЭтоСимволЛексемы(Лексемы, Индекс, ".")
			И Индекс + 1 < Лексемы.Количество()
			И Лексемы[Индекс + 1].Вид = "идентификатор" Цикл
		Имена.Добавить(Лексемы[Индекс + 1].Значение);
		Индекс = Индекс + 2;
	КонецЦикла;
	Возврат Индекс;

КонецФункции

Функция ИндексЗакрывающейСкобки(Знач Лексемы, Знач ИндексОткрывающей)

	Глубина = 0;
	Для Индекс = ИндексОткрывающей По Лексемы.ВГраница() Цикл
		Лексема = Лексемы[Индекс];
		Если Лексема.Вид <> "символ" Тогда
			Продолжить;
		КонецЕсли;
		Если Лексема.Значение = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Лексема.Значение = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Индекс;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В выражении запроса не закрыта скобка.";

КонецФункции
