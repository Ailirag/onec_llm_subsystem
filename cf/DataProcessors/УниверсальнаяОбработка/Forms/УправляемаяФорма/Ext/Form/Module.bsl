											?(Строка.Имя = "Подсистемы", Метаданные.Подсистемы, Неопределено));

	КонецЦикла;
	
	Если ЭлементОбщие.ПолучитьЭлементы().Количество() = 0 Тогда
		ЭлементКонфигурация.ПолучитьЭлементы().Удалить(ЭлементОбщие);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыводКоллекцииОбъектовМетаданных(Имя, ПолноеИмя, Синоним, Картинка, КартинкаОбъекта, Родитель = Неопределено, Подсистемы = Неопределено, Проверять = Истина)

	НоваяСтрока = НоваяСтрокаДерева(Имя, ПолноеИмя, Синоним, Картинка, Родитель, Подсистемы <> Неопределено И Подсистемы <> Метаданные.Подсистемы);
	
	Если Подсистемы = Неопределено Тогда
		Для каждого ЭлементКоллекцииМетаданных ИЗ Метаданные[Имя] Цикл

			ПолноеИмя = ЭлементКоллекцииМетаданных.ПолноеИмя();
			
			РодительЭлементов = НоваяСтрокаДерева(ЭлементКоллекцииМетаданных.Имя,
									ПолноеИмя,
									ЭлементКоллекцииМетаданных.Синоним,
									КартинкаОбъекта,
									НоваяСтрока,
									Истина,
									Имя);
									
		КонецЦикла;
	КонецЕсли;
	
	Возврат НоваяСтрока;
	
КонецФункции

&НаСервере
Функция НоваяСтрокаДерева(Имя, ПолноеИмя, Синоним, Картинка, Родитель, ЭтоОбъектМетаданных = Ложь, ИмяТипаРодителя = "")
	
	Коллекция = Родитель.ПолучитьЭлементы();
	НоваяСтрока = Коллекция.Добавить();
	НоваяСтрока.Имя                 = Имя;
	НоваяСтрока.Представление       = СтрШаблон("%1 (%2)", Имя, ?(ЗначениеЗаполнено(Синоним), Синоним, Имя));
	НоваяСтрока.Пометка             = 0;
	НоваяСтрока.Картинка            = Картинка;
	НоваяСтрока.ПолноеИмя           = ИмяТипаРодителя + "." + Имя;
	НоваяСтрока.ЭтоОбъектМетаданных = ЭтоОбъектМетаданных;
	
	Возврат НоваяСтрока;
	
КонецФункции

#Область КОНСОЛЬ_КОДА_ЯДРО


&НаСервере 
Процедура ВыполнитьПроизвольныйКодНаСервереПосредник(ТекстВыполнения, Источник = "", Успешно)
	
	Попытка
		
		ВыполнитьПроизвольныйКодНаСервере(ТекстВыполнения);
		
		ТекстСообщения = СтрШаблон("Алгоритм %1успешно выполнен", ?(ЗначениеЗаполнено(Источник), "[" + Источник + "] ", ""));
		
		Сообщить(ТекстСообщения);
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		Успешно = Ложь;
		
	КонецПопытки;
	
КонецПроцедуры


&НаСервере 
Процедура ВыполнитьПроизвольныйКодНаСервере(ТекстВыполнения)
	
	ВремяНачала = ТекущаяДата();
	
	ОтменаТранзакции	= Элементы.ОтменаТранзакции.Пометка;
	ВестиСтатистику		= Элементы.ФормаСтатистика.Пометка;
	
	Если СтрНайти(нрег(ТекстВыполнения), "текущийобъект") > 0 Тогда
		ТекущийОбъект = Объект.СсылкаНаОбъект.ПолучитьОбъект();
	КонецЕсли;
	
	Если ОтменаТранзакции Тогда
		НачатьТранзакцию();
	КонецЕсли;
	
	Если ВестиСтатистику Тогда
		Сообщить("Начало выполнения: " + ВремяНачала);
	КонецЕсли;
	
	Выполнить ТекстВыполнения;
	
	~Возврат:
	
	ВремяОкончания = ТекущаяДата();
	
	Если ОтменаТранзакции Тогда
		ОтменитьТранзакцию();
		Сообщить("Транзакция отменена");
	КонецЕсли;
	
	Если ВестиСтатистику Тогда
		
		ЗатраченноеВремя = ВремяОкончания - ВремяНачала;
		
		ТекстСообщения = СтрШаблон("Окончание выполнения: %1, время выполнения: %2 минут (%3 секунд)",
		ВремяОкончания,
		Окр(ЗатраченноеВремя / 60, 3),
		ЗатраченноеВремя);
		
		Сообщить(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВызватьФункцию(ВызватьФункцию_ИмяФункции, Переменная1 = Неопределено, Переменная2 = Неопределено, Переменная3 = Неопределено, Переменная4 = Неопределено, Переменная5 = Неопределено, Переменная6 = Неопределено,
													Переменная7 = Неопределено, Переменная8 = Неопределено, Переменная9 = Неопределено)
													
	// Возвращаемое значение
	РезультатФункции = Неопределено;
	
	ФормированиеТекстаВыполнения	= Новый ТекстовыйДокумент;
	ВызватьФункцию_ВсеПараметры		= Новый Структура("Переменная1, Переменная2, Переменная3, Переменная4, Переменная5, Переменная6, Переменная7, Переменная8, Переменная9", 
													   Переменная1, Переменная2, Переменная3, Переменная4, Переменная5, Переменная6, Переменная7, Переменная8, Переменная9);
	
	ВызватьФункцию_ДеревоЗначение		= РеквизитФормыВЗначение("ДеревоАлгоритмов");
	ВызватьФункцию_НайденныйАлгоритм	= ВызватьФункцию_ДеревоЗначение.Строки.НайтиСтроки(Новый Структура("ИмяАлгоритма", ВызватьФункцию_ИмяФункции), Истина);
	
	Если НЕ ЗначениеЗаполнено(ВызватьФункцию_НайденныйАлгоритм) Тогда
		ВызватьИсключение СтрШаблон("Метод [%1] не найден", ВызватьФункцию_ИмяФункции);
	КонецЕсли;
	
	Функция_ГрязныйКодКВыполнению			= ВызватьФункцию_НайденныйАлгоритм[0].Код;
	ВызватьФункцию_ПозицияНачалаПараметров	= СтрНайти(Функция_ГрязныйКодКВыполнению, ВызватьФункцию_ИмяФункции) + СтрДлина(ВызватьФункцию_ИмяФункции) + 1;
	ВызватьФункцию_ПозицияКонцаПараметров	= СтрНайти(Функция_ГрязныйКодКВыполнению, ")");
	
	ВызватьФункцию_ПараметрыФункции = СтрРазделить(Сред(Функция_ГрязныйКодКВыполнению, ВызватьФункцию_ПозицияНачалаПараметров, ВызватьФункцию_ПозицияКонцаПараметров - ВызватьФункцию_ПозицияНачалаПараметров), ",", Ложь);
	
	Для НомерПараметра = 0 По ВызватьФункцию_ПараметрыФункции.Количество() - 1 Цикл
		
		ВызватьФункцию_ПараметрФункции = ВызватьФункцию_ПараметрыФункции[НомерПараметра];
		ВызватьФункцию_СоставПараметра = СтрРазделить(ВызватьФункцию_ПараметрФункции, "=", Ложь);
		
		Если ВызватьФункцию_СоставПараметра.Количество() = 1 Тогда //Без значения по умолчанию
			ФормированиеТекстаВыполнения.ДобавитьСтроку(СтрШаблон("%1 = %2;", ВызватьФункцию_СоставПараметра[0], "Переменная" + (НомерПараметра + 1)));
		ИначеЕсли ВызватьФункцию_СоставПараметра.Количество() = 2 Тогда // Со значением по умолчанию
			Если ЗначениеЗаполнено(ВызватьФункцию_ВсеПараметры["Переменная" + (НомерПараметра + 1)]) Тогда
				ЗначениеПараметра = "Переменная" + (НомерПараметра + 1);
			Иначе
				ЗначениеПараметра = СокрЛП(ВызватьФункцию_СоставПараметра[1]);
			КонецЕсли;
			
			ФормированиеТекстаВыполнения.ДобавитьСтроку(СтрШаблон("%1 = %2;", ВызватьФункцию_СоставПараметра[0], ЗначениеПараметра));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Функция_КонецФункции		= СтрНайти(Функция_ГрязныйКодКВыполнению, "Конец", НаправлениеПоиска.СКонца);
	ВызватьФункцию_ЧистыйКод	= Сред(Функция_ГрязныйКодКВыполнению, ВызватьФункцию_ПозицияКонцаПараметров + 1, Функция_КонецФункции - ВызватьФункцию_ПозицияКонцаПараметров - 1);
	
	ФормированиеТекстаВыполнения.ДобавитьСтроку(ВызватьФункцию_ЧистыйКод);
	
	ТекстВыполнения = ФормированиеТекстаВыполнения.ПолучитьТекст();
	Если СтрНайти(нрег(ТекстВыполнения), "возврат ") > 0 Тогда
		ТекстВыполнения = СтрЗаменить(нрег(ТекстВыполнения), "возврат ", "РезультатФункции = ");
	ИначеЕсли СтрНайти(нрег(ТекстВыполнения), "возврат;") > 0 Тогда
		ТекстВыполнения = СтрЗаменить(нрег(ТекстВыполнения), "возврат;", "Перейти ~Возврат2_0");
	КонецЕсли;
	
	Выполнить ТекстВыполнения;
	
	~Возврат2_0:
	
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти 

#КонецОбласти 

