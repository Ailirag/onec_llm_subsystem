&НаСервере
Процедура УдалитьАлгоритмНаСервере(УИД)
	
	ДеревоОбъект = РеквизитФормыВЗначение("ДеревоАлгоритмов");
	НужнаяСтрока = НайтиВДеревеПоУИДУ(ДеревоОбъект, УИД);
	
	Если НЕ ЗначениеЗаполнено(НужнаяСтрока.Родитель) Тогда
		Владелец = ДеревоОбъект;
	Иначе
		Владелец = НужнаяСтрока.Родитель;
	КонецЕсли;
	
	Владелец.Строки.Удалить(НужнаяСтрока);
	
	ЗначениеВРеквизитФормы(ДеревоОбъект, "ДеревоАлгоритмов");
	
