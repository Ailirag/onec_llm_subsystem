// Возвращает секрет авторизации MCP-сервера.
// Модуль доступен только на сервере и не доступен для серверного вызова с клиента.
//
// Параметры:
//  Сервер - СправочникСсылка.AI_MCPСерверы
//
// Возвращаемое значение:
//  Строка
//
Функция Получить(Знач Сервер) Экспорт

	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ПолучитьВнутренне(Сервер);
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Результат;

КонецФункции

// Записывает секрет авторизации MCP-сервера в закрытый для прикладных ролей регистр.
//
// Параметры:
//  Сервер - СправочникСсылка.AI_MCPСерверы
//  Секрет - Строка
//
Процедура Записать(Знач Сервер, Знач Секрет) Экспорт

	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗаписатьВнутренне(Сервер, Секрет);
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);

КонецПроцедуры

// Удаляет секрет авторизации MCP-сервера.
//
// Параметры:
//  Сервер - СправочникСсылка.AI_MCPСерверы
//
Процедура Удалить(Знач Сервер) Экспорт

	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		УдалитьВнутренне(Сервер);
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);

КонецПроцедуры

Функция ПолучитьВнутренне(Сервер)

	Если Не ЗначениеЗаполнено(Сервер) Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| AI_СекретыMCP.Секрет КАК Секрет
		|ИЗ
		| РегистрСведений.AI_СекретыMCP КАК AI_СекретыMCP
		|ГДЕ
		| AI_СекретыMCP.Сервер = &Сервер";
	Запрос.УстановитьПараметр("Сервер", Сервер);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.Секрет = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(Выборка.Секрет.Получить());
	Исключение
		ВызватьИсключение "Секрет MCP-сервера поврежден или имеет неподдерживаемый формат.";
	КонецПопытки;

КонецФункции

Процедура ЗаписатьВнутренне(Сервер, Секрет)

	Если Не ЗначениеЗаполнено(Сервер) Тогда
		ВызватьИсключение "Не указан MCP-сервер.";
	КонецЕсли;
	Запись = РегистрыСведений.AI_СекретыMCP.СоздатьМенеджерЗаписи();
	Запись.Сервер = Сервер;
	Запись.Секрет = Новый ХранилищеЗначения(Строка(Секрет));
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

Процедура УдалитьВнутренне(Сервер)

	Если Не ЗначениеЗаполнено(Сервер) Тогда
		Возврат;
	КонецЕсли;
	Запись = РегистрыСведений.AI_СекретыMCP.СоздатьМенеджерЗаписи();
	Запись.Сервер = Сервер;
	Запись.Удалить();

КонецПроцедуры
