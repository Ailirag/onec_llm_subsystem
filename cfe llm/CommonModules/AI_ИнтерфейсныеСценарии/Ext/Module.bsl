
// Формирует конфигурационно-независимый снимок контекста запуска.
// Прикладные ссылки используются только во время открытия формы и не сохраняются.
Функция СформироватьКонтекст(ОбъектыНазначения = Неопределено, ТипМеста = "Объект") Экспорт

	Объекты = НормализоватьОбъекты(ОбъектыНазначения);
	ЭлементыКонтекста = Новый Массив;
	ПолноеИмяМетаданных = "";
	ТипИсточника = "";
	КлючИсточника = "";
	ПредставлениеИсточника = "";

	Для Каждого ОбъектНазначения Из Объекты Цикл
		ЭлементКонтекста = ОписаниеОбъекта(ОбъектНазначения);
		ЭлементыКонтекста.Добавить(ЭлементКонтекста.JSON);
		Если Не ЗначениеЗаполнено(ПолноеИмяМетаданных) Тогда
			ПолноеИмяМетаданных = ЭлементКонтекста.ПолноеИмяМетаданных;
			ТипИсточника = ЭлементКонтекста.ТипИсточника;
			КлючИсточника = ЭлементКонтекста.Ключ;
			ПредставлениеИсточника = ЭлементКонтекста.Представление;
		ИначеЕсли ПолноеИмяМетаданных <> ЭлементКонтекста.ПолноеИмяМетаданных Тогда
			ПолноеИмяМетаданных = "";
		КонецЕсли;
	КонецЦикла;

	Если Объекты.Количество() = 0 Тогда
		ТипМеста = "Глобально";
		ПредставлениеИсточника = "Без прикладного объекта";
	ИначеЕсли Объекты.Количество() > 1 Тогда
		ПредставлениеИсточника = СтрШаблон("Выбрано объектов: %1", Объекты.Количество());
		КлючИсточника = "";
	КонецЕсли;

	JSONКонтекст = Новый Структура;
	JSONКонтекст.Вставить("version", 1);
	JSONКонтекст.Вставить("launch_place", ТипМеста);
	JSONКонтекст.Вставить("metadata_name", ПолноеИмяМетаданных);
	JSONКонтекст.Вставить("objects", ЭлементыКонтекста);

	Возврат Новый Структура(
		"ТипМеста,ПолноеИмяМетаданных,ТипИсточника,КлючИсточника,ПредставлениеИсточника,КонтекстJSON,ДанныеКонтекста,КоличествоОбъектов",
		ТипМеста,
		ПолноеИмяМетаданных,
		ТипИсточника,
		КлючИсточника,
		ПредставлениеИсточника,
		ЗаписатьJSONВСтроку(JSONКонтекст),
		СформироватьТекстКонтекста(ЭлементыКонтекста, ТипМеста),
		Объекты.Количество());

КонецФункции

// Разбирает агрегированный контекст на контексты отдельных объектов.
//
// Массовый режим делает по операции на объект, а ядро действий умеет работать
// только с одним: применить результат к «выбранным объектам» вообще нельзя —
// у каждого свой файл, свой ответ модели и свое решение человека.
//
// Разбор идет по снимку JSON, а не по ссылкам: ссылки в контексте не хранятся
// намеренно, и заводить для массового режима второй канал передачи данных
// значило бы обойти это правило.
Функция КонтекстыОбъектов(Знач Контекст) Экспорт

	Результат = Новый Массив;
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	ТекстJSON = "";
	Контекст.Свойство("КонтекстJSON", ТекстJSON);
	Если Не ЗначениеЗаполнено(ТекстJSON) Тогда
		Возврат Результат;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Попытка
		Разобранное = ПрочитатьJSON(Чтение, Истина);
	Исключение
		// Контекст испорчен: молча вернуть пустой массив нельзя — вызывающий
		// решит, что объектов нет, и запустит пакет ни по чему.
		ВызватьИсключение "Не удалось разобрать контекст запуска: " + ОписаниеОшибки();
	КонецПопытки;

	Объекты = Неопределено;
	Если ТипЗнч(Разобранное) = Тип("Соответствие") Тогда
		Объекты = Разобранное.Получить("objects");
	КонецЕсли;
	Если ТипЗнч(Объекты) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	ТипМеста = "Объект";
	Контекст.Свойство("ТипМеста", ТипМеста);

	Для Каждого Элемент Из Объекты Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = Строка(?(Элемент.Получить("metadata_name") = Неопределено,
			"", Элемент.Получить("metadata_name")));
		Ключ = Строка(?(Элемент.Получить("key") = Неопределено,
			"", Элемент.Получить("key")));
		Представление = Строка(?(Элемент.Получить("presentation") = Неопределено,
			"", Элемент.Получить("presentation")));
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		JSONОбъекта = Новый Структура("metadata_name,key,presentation",
			ПолноеИмя, Ключ, Представление);
		ЭлементыКонтекста = Новый Массив;
		ЭлементыКонтекста.Добавить(JSONОбъекта);

		JSONКонтекст = Новый Структура;
		JSONКонтекст.Вставить("version", 1);
		JSONКонтекст.Вставить("launch_place", ТипМеста);
		JSONКонтекст.Вставить("metadata_name", ПолноеИмя);
		JSONКонтекст.Вставить("objects", ЭлементыКонтекста);

		Результат.Добавить(Новый Структура(
			"ТипМеста,ПолноеИмяМетаданных,ТипИсточника,КлючИсточника,ПредставлениеИсточника,КонтекстJSON,ДанныеКонтекста,КоличествоОбъектов",
			ТипМеста,
			ПолноеИмя,
			ПолноеИмя,
			Ключ,
			Представление,
			ЗаписатьJSONВСтроку(JSONКонтекст),
			СформироватьТекстКонтекста(ЭлементыКонтекста, ТипМеста),
			1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проходит ли контекст отборы места запуска. Для пачки — хотя бы один объект.
Функция ОтборыПропускаютКонтекст(МестоЗапуска, Контекст)

	Если Контекст.КоличествоОбъектов <= 1 Тогда
		Возврат AI_ИзвлечениеРеквизитов.ПроверитьОтборыКонтекста(МестоЗапуска, Контекст);
	КонецЕсли;

	Для Каждого КонтекстОбъекта Из КонтекстыОбъектов(Контекст) Цикл
		Если AI_ИзвлечениеРеквизитов.ПроверитьОтборыКонтекста(МестоЗапуска, КонтекстОбъекта) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Режим выполнения места запуска для нескольких объектов.
//
// Пустое значение означает очередь: по операции на объект. Такой выбор по
// умолчанию сделан осознанно — один запрос по пачке объектов дает один ответ
// модели, который потом не к чему применить построчно.
Функция РежимВыполненияОчередью(МестоЗапуска) Экспорт

	Режим = МестоЗапуска.РежимВыполнения;
	Возврат Не Режим = Перечисления.AI_РежимВыполнения.ОднимЗапросом;

КонецФункции

// Возвращает только активные места запуска, доступные текущему пользователю.
//
// Тип места должен совпасть с контекстом. Глобальное действие — это действие
// без прикладного объекта: в карточке оно ничего не знает о документе и ничего
// в него не запишет, а рядом с настоящими действиями только путает.
Функция ПолучитьДоступныеСценарии(Контекст) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("МестоЗапуска", Новый ОписаниеТипов("СправочникСсылка.AI_МестаЗапускаСценариев"));
	Результат.Колонки.Добавить("Сценарий", Новый ОписаниеТипов("СправочникСсылка.AI_Сценарии"));
	Результат.Колонки.Добавить("ПредставлениеКоманды", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("НачальныйЗапрос", Новый ОписаниеТипов("Строка"));

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|  Места.Ссылка КАК МестоЗапуска,
		|  Места.Сценарий КАК Сценарий,
		|  Места.ПредставлениеКоманды КАК ПредставлениеКоманды,
		|  Места.Описание КАК Описание,
		|  Места.НачальныйЗапрос КАК НачальныйЗапрос,
		|  Места.РазрешитьНесколькоОбъектов КАК РазрешитьНесколькоОбъектов
		|ИЗ Справочник.AI_МестаЗапускаСценариев КАК Места
		|ГДЕ НЕ Места.ПометкаУдаления
		|  И Места.Активно
		|  И НЕ Места.Сценарий.ПометкаУдаления
		|  И Места.Сценарий.Активен
		|  И Места.ТипМеста = &ТипМеста
		|  И (Места.ПолноеИмяМетаданных = """"
		|    ИЛИ Места.ПолноеИмяМетаданных = ""*""
		|    ИЛИ Места.ПолноеИмяМетаданных = &ПолноеИмяМетаданных)
		|УПОРЯДОЧИТЬ ПО Места.Порядок, Места.Наименование");
	Запрос.УстановитьПараметр("ТипМеста", Контекст.ТипМеста);
	Запрос.УстановитьПараметр("ПолноеИмяМетаданных", Контекст.ПолноеИмяМетаданных);
	ИдентификаторПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Контекст.КоличествоОбъектов > 1 И Не Выборка.РазрешитьНесколькоОбъектов Тогда
			Продолжить;
		КонецЕсли;
		РешениеОДоступе = AI_ДоступКАгентамСервер.ОпределитьДоступ(
			ИдентификаторПользователя,
			Выборка.Сценарий.Агент);
		Если Не РешениеОДоступе.Разрешен Тогда
			Продолжить;
		КонецЕсли;
		Если Не МестоВидноПользователю(Выборка.МестоЗапуска) Тогда
			Продолжить;
		КонецЕсли;
		// Дополнительные отборы места запуска: позволяют разделить действия
		// внутри одного типа объекта — например, только документы вида «Договор».
		//
		// У пачки объекта в контексте нет: ключ источника пуст, и отбор по
		// реквизиту вычислить не на чем. Поэтому отбор проверяется по каждому
		// объекту, и действие предлагается, если подходит хотя бы один —
		// неподходящие отсеются при запуске, каждый со своей причиной.
		Если Не ОтборыПропускаютКонтекст(Выборка.МестоЗапуска, Контекст) Тогда
			Продолжить;
		КонецЕсли;
		// Сложные условия — кодом конфигурации или внешней обработки. Упавшая
		// проверка скрывает действие, а причина уходит в журнал.
		Если Не AI_ПрименениеРекомендаций.ПроверитьДоступность(
				Выборка.МестоЗапуска, Контекст, "ВыборДействия").Доступно Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРезультата = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРезультата, Выборка);
		Если Не ЗначениеЗаполнено(СтрокаРезультата.ПредставлениеКоманды) Тогда
			СтрокаРезультата.ПредставлениеКоманды = Строка(СтрокаРезультата.Сценарий);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Кому показывать действие — вдобавок к доступу к агенту. Агент отвечает, можно
// ли человеку пользоваться моделью и данными, а место — нужно ли ему именно это
// действие: одно — только администраторам, другое — только бухгалтерии.
//
// Пустая таблица «Видимость» — видно всем, у кого есть агент. Иначе хватает
// одного выполненного условия: роли информационной базы или группы доступа.
Функция МестоВидноПользователю(МестоЗапуска) Экспорт

	Условия = МестоЗапуска.Видимость;
	Если Условия.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Условие Из Условия Цикл
		Если УсловиеВидимостиВыполнено(СокрЛП(Условие.ВидУсловия), СокрЛП(Условие.Имя)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Виды условий видимости: значение — для хранения, представление — для человека.
Функция ВидыУсловийВидимости() Экспорт

	Виды = Новый СписокЗначений;
	Виды.Добавить("Роль", "Роль");
	Виды.Добавить("ГруппаДоступа", "Группа доступа");
	Возврат Виды;

КонецФункции

// Что можно выбрать в условии видимости: роли конфигурации или группы и
// профили доступа (в Документообороте — профили полномочий). Значение — то,
// что пишется в «Имя».
Функция ВариантыУсловияВидимости(ВидУсловия) Экспорт

	Варианты = Новый СписокЗначений;
	Если ВидУсловия = "Роль" Тогда
		Для Каждого Роль Из Метаданные.Роли Цикл
			Варианты.Добавить(Роль.Имя, СтрШаблон("%1 (%2)", Роль.Представление(), Роль.Имя));
		КонецЦикла;
		Варианты.СортироватьПоПредставлению();
	ИначеЕсли ВидУсловия = "ГруппаДоступа" Тогда
		Для Каждого Имя Из ИменаГруппДоступа() Цикл
			Варианты.Добавить(Имя, Имя);
		КонецЦикла;
	КонецЕсли;
	Возврат Варианты;

КонецФункции

Функция УсловиеВидимостиВыполнено(ВидУсловия, Имя)

	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ВидУсловия = "Роль" Тогда
		// Несуществующая роль — не «видно всем», а «никому»: опечатка в имени не
		// должна открывать действие. О ней скажет проверка настройки.
		Если Метаданные.Роли.Найти(Имя) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат РольДоступна(Имя);
	ИначеЕсли ВидУсловия = "ГруппаДоступа" Тогда
		Возврат ПользовательВГруппеДоступа(Имя);
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Группы доступа — не объекты подсистемы: запрос к ним — данные, а не код, и в
// конфигурации без них условие просто не выполняется, а проверка настройки
// говорит почему. Как конфигурация выдает доступ, узнается по метаданным:
//   БСП — группа доступа (Справочник.ГруппыДоступа); участник — сам
//         пользователь или его группа пользователей;
//   Документооборот — полномочия (РегистрСведений.ПолномочияПользователей):
//         профиль выдан пользователю или контейнеру — рабочей группе,
//         подразделению, а кто в контейнере, знает ПользователиВКонтейнерах.
//         Группы доступа БСП в ДО не используются.
// Имя совпадает и с наименованием группы, и с наименованием профиля: группы
// называют по-своему, а профиль у них общий.
Функция ПользовательВГруппеДоступа(ИмяГруппы)

	Проверки = Новый Массив;
	Если ЕстьГруппыДоступаБСП() Тогда
		Проверки.Добавить(
			"ВЫБРАТЬ
			|	ИСТИНА КАК Входит
			|ИЗ
			|	Справочник.ГруппыДоступа.Пользователи КАК Участники
			|ГДЕ
			|	НЕ Участники.Ссылка.ПометкаУдаления
			|	И (Участники.Ссылка.Наименование = &Имя
			|			ИЛИ Участники.Ссылка.Профиль.Наименование = &Имя)
			|	И (Участники.Пользователь В
			|				(ВЫБРАТЬ
			|					Т.Ссылка
			|				ИЗ
			|					ТекущийПользователь КАК Т)
			|			ИЛИ Участники.Пользователь В
			|				(ВЫБРАТЬ
			|					Составы.ГруппаПользователей
			|				ИЗ
			|					РегистрСведений.СоставыГруппПользователей КАК Составы
			|				ГДЕ
			|					Составы.Пользователь В
			|						(ВЫБРАТЬ
			|							Т.Ссылка
			|						ИЗ
			|							ТекущийПользователь КАК Т)))");
	КонецЕсли;
	Если ЕстьПолномочияДокументооборота() Тогда
		Проверки.Добавить(
			"ВЫБРАТЬ
			|	ИСТИНА
			|ИЗ
			|	РегистрСведений.ПолномочияПользователей КАК Выдано
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПользователиВКонтейнерах КАК Состав
			|		ПО Выдано.Владелец = Состав.Контейнер
			|ГДЕ
			|	Состав.Пользователь В
			|			(ВЫБРАТЬ
			|				Т.Ссылка
			|			ИЗ
			|				ТекущийПользователь КАК Т)
			|	И НЕ Выдано.Полномочия.ПометкаУдаления
			|	И Выдано.Полномочия.Наименование = &Имя");
	КонецЕсли;
	Если Проверки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ТекущийПользователь
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.ИдентификаторПользователяИБ = &ИдентификаторИБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + СтрСоединить(Проверки, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС));
	Запрос.УстановитьПараметр("ИдентификаторИБ",
		ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
	Запрос.УстановитьПараметр("Имя", ИмяГруппы);

	// Пользователю не обязательно видеть группы доступа, а проверяется — он сам.
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Входит = Не Запрос.Выполнить().Пустой();
	Исключение
		// Другая редакция БСП с иным составом групп доступа: условие не
		// выполнится, а причину увидит администратор — иначе действие пропало
		// бы у всех молча.
		Входит = Ложь;
		ЗаписьЖурналаРегистрации("AI.ИнтерфейсныеСценарии", УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон("Не удалось проверить группу доступа «%1»: %2", ИмяГруппы,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Входит;

КонецФункции

// Есть ли в конфигурации чем выдавать доступ группами: группы доступа БСП или
// полномочия Документооборота.
Функция ЕстьГруппыДоступа()

	Возврат ЕстьГруппыДоступаБСП() Или ЕстьПолномочияДокументооборота();

КонецФункции

Функция ЕстьГруппыДоступаБСП()

	Возврат Метаданные.Справочники.Найти("ГруппыДоступа") <> Неопределено
		И Метаданные.Справочники.Найти("Пользователи") <> Неопределено
		И Метаданные.РегистрыСведений.Найти("СоставыГруппПользователей") <> Неопределено;

КонецФункции

Функция ЕстьПолномочияДокументооборота()

	Полномочия = Метаданные.РегистрыСведений.Найти("ПолномочияПользователей");
	Состав = Метаданные.РегистрыСведений.Найти("ПользователиВКонтейнерах");
	Возврат Полномочия <> Неопределено И Состав <> Неопределено
		И Полномочия.Измерения.Найти("Владелец") <> Неопределено
		И Полномочия.Измерения.Найти("Полномочия") <> Неопределено
		И Состав.Измерения.Найти("Контейнер") <> Неопределено
		И Состав.Измерения.Найти("Пользователь") <> Неопределено
		И Метаданные.Справочники.Найти("Пользователи") <> Неопределено
		И Метаданные.Справочники.Найти("ПрофилиГруппДоступа") <> Неопределено;

КонецФункции

// Наименования групп доступа и профилей — то, что годится в условие. Группа
// без участников не предлагается: условие по ней не выполнится ни для кого, а
// в Документообороте такая группа — неиспользуемый справочник БСП.
Функция ИменаГруппДоступа()

	Имена = Новый Массив;
	Если Не ЕстьГруппыДоступа() Тогда
		Возврат Имена;
	КонецЕсли;
	Части = Новый Массив;
	Если ЕстьГруппыДоступаБСП() Тогда
		Части.Добавить(
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Участники.Ссылка.Наименование КАК Наименование
			|ИЗ
			|	Справочник.ГруппыДоступа.Пользователи КАК Участники
			|ГДЕ
			|	НЕ Участники.Ссылка.ПометкаУдаления");
	КонецЕсли;
	// Профили — отдельно от групп: профиль есть и тогда, когда групп на него
	// еще не завели, а в Документообороте доступ выдается именно профилями.
	Если Метаданные.Справочники.Найти("ПрофилиГруппДоступа") <> Неопределено Тогда
		Части.Добавить(
			"ВЫБРАТЬ
			|	Профили.Наименование
			|ИЗ
			|	Справочник.ПрофилиГруппДоступа КАК Профили
			|ГДЕ
			|	НЕ Профили.ПометкаУдаления");
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат Имена;
	КонецЕсли;
	Запрос = Новый Запрос(СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС) + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование");
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Наименование) Тогда
				Имена.Добавить(Выборка.Наименование);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Имена.Очистить();
		ЗаписьЖурналаРегистрации("AI.ИнтерфейсныеСценарии", УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось прочитать группы и профили доступа: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Имена;

КонецФункции

Функция ПодготовитьПараметрыДиалога(МестоЗапуска, Контекст, НачальныйЗапрос = "") Экспорт

	Если ТипЗнч(МестоЗапуска) <> Тип("СправочникСсылка.AI_МестаЗапускаСценариев")
		Или Не ЗначениеЗаполнено(МестоЗапуска)
		Или МестоЗапуска.ПометкаУдаления
		Или Не МестоЗапуска.Активно Тогда
		ВызватьИсключение "Место запуска сценария недоступно.";
	КонецЕсли;

	Сценарий = МестоЗапуска.Сценарий;
	Если Не ЗначениеЗаполнено(Сценарий) Или Сценарий.ПометкаУдаления Или Не Сценарий.Активен Тогда
		ВызватьИсключение "Сценарий недоступен для запуска.";
	КонецЕсли;
	РешениеОДоступе = AI_ДоступКАгентамСервер.ОпределитьДоступ(
		ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор,
		Сценарий.Агент);
	Если Не РешениеОДоступе.Разрешен Тогда
		ВызватьИсключение "Нет доступа к агенту сценария: " + РешениеОДоступе.Причина;
	КонецЕсли;
	Если Не МестоВидноПользователю(МестоЗапуска) Тогда
		ВызватьИсключение "Действие показывается только определенным ролям или группам доступа,"
			+ " и текущему пользователю оно недоступно.";
	КонецЕсли;

	// Правило множественного выбора проверяется здесь, а не только при отборе
	// действий: контекст приходит с клиента и доверять ему нельзя.
	КоличествоОбъектов = 0;
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("КоличествоОбъектов", КоличествоОбъектов);
	КонецЕсли;
	Если КоличествоОбъектов > 1 И Не МестоЗапуска.РазрешитьНесколькоОбъектов Тогда
		ВызватьИсключение "Место запуска не допускает обработку нескольких объектов.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НачальныйЗапрос) Тогда
		НачальныйЗапрос = МестоЗапуска.НачальныйЗапрос;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Сценарий", Сценарий);
	ПараметрыФормы.Вставить("НачальныйЗапрос", НачальныйЗапрос);
	ПараметрыФормы.Вставить("ДанныеКонтекста", Контекст.ДанныеКонтекста);
	ПараметрыФормы.Вставить("КонтекстJSON", Контекст.КонтекстJSON);
	ПараметрыФормы.Вставить("ВерсияКонтекста", 1);
	ПараметрыФормы.Вставить("ТипИсточника", Контекст.ТипИсточника);
	ПараметрыФормы.Вставить("КлючИсточника", Контекст.КлючИсточника);
	ПараметрыФормы.Вставить("ПредставлениеИсточника", Контекст.ПредставлениеИсточника);
	Возврат ПараметрыФормы;

КонецФункции

// Данные объекта для модели: реквизиты шапки и строки табличных частей, которые
// перечислены в месте запуска. Табличные части уходят таблицами с номером
// строки — по нему модель потом называет строку, которую нужно изменить.
//
// Объект читается с правами пользователя: чего не видит он, того не увидит и
// модель. Длинный документ обрезается с явной пометкой, чтобы модель не делала
// выводов по неполным данным молча.
//
// Возвращает пустую строку, если передавать нечего.
Функция ДанныеОбъектаДляМодели(МестоЗапуска, Контекст) Экспорт

	Если МестоЗапуска.ДанныеОбъекта.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Ссылка = AI_ИзвлечениеРеквизитов.ПолучитьОбъектПоКонтексту(Контекст);
	Если Ссылка = Неопределено Или Ссылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	ОписаниеОбъекта = Ссылка.Метаданные();
	Если Не ПравоДоступа("Чтение", ОписаниеОбъекта) Тогда
		ВызватьИсключение СтрШаблон("Нет права читать «%1».", ОписаниеОбъекта.Представление());
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект «%1» не найден.", Ссылка);
	КонецЕсли;

	Состав = СоставДанныхОбъекта(МестоЗапуска, ОписаниеОбъекта);
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Данные объекта «%1» (%2):",
		ПредставлениеОбъектаНазначения(Ссылка),
		ПредставлениеОбъектаМетаданных(ОписаниеОбъекта.ПолноеИмя())));
	Длина = СтрДлина(Строки[0]);

	Для Каждого Реквизит Из Состав.Реквизиты Цикл
		Текст = СтрШаблон("- %1: %2", Реквизит.Представление, ЗначениеДляМодели(Объект[Реквизит.Имя]));
		Строки.Добавить(Текст);
		Длина = Длина + СтрДлина(Текст);
	КонецЦикла;

	Для Каждого ОписаниеЧасти Из Состав.ТабличныеЧасти Цикл
		ТабличнаяЧасть = Объект[ОписаниеЧасти.Имя];
		Всего = ТабличнаяЧасть.Количество();
		Заголовки = Новый Массив;
		Заголовки.Добавить("№");
		Для Каждого Колонка Из ОписаниеЧасти.Колонки Цикл
			Заголовки.Добавить(Колонка.Представление);
		КонецЦикла;
		Строки.Добавить("");
		Строки.Добавить(СтрШаблон("Табличная часть «%1», строк: %2:", ОписаниеЧасти.Представление, Всего));
		Строки.Добавить("| " + СтрСоединить(Заголовки, " | ") + " |");

		Показано = 0;
		Для Каждого СтрокаЧасти Из ТабличнаяЧасть Цикл
			Если Показано >= МаксимумСтрокДанныхОбъекта() Или Длина >= МаксимумСимволовДанныхОбъекта() Тогда
				Прервать;
			КонецЕсли;
			Ячейки = Новый Массив;
			Ячейки.Добавить(Формат(СтрокаЧасти.НомерСтроки, "ЧГ=0"));
			Для Каждого Колонка Из ОписаниеЧасти.Колонки Цикл
				Ячейки.Добавить(ЗначениеДляМодели(СтрокаЧасти[Колонка.Имя]));
			КонецЦикла;
			Текст = "| " + СтрСоединить(Ячейки, " | ") + " |";
			Строки.Добавить(Текст);
			Длина = Длина + СтрДлина(Текст);
			Показано = Показано + 1;
		КонецЦикла;
		Если Показано < Всего Тогда
			Строки.Добавить(СтрШаблон("(Показаны первые %1 из %2 строк, остальные не переданы.)",
				Показано, Всего));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Задание разговора в диалоговом режиме: зачем он и что в итоге нужно собрать.
// Уходит в контекст каждого хода, а не в историю: так модель помнит цель, даже
// когда история обрезана по глубине.
Функция ЗаданиеДиалога(МестоЗапуска) Экспорт

	Части = Новый Массив;
	Если ЗначениеЗаполнено(СокрЛП(МестоЗапуска.НачальныйЗапрос)) Тогда
		Части.Добавить("Задача разговора: " + СокрЛП(МестоЗапуска.НачальныйЗапрос));
	КонецЕсли;
	Поля = AI_ИзвлечениеРеквизитов.ОписаниеПолейДляДиалога(МестоЗапуска.КартаИзвлечения);
	Если ЗначениеЗаполнено(Поля) Тогда
		Части.Добавить(Поля);
	КонецЕсли;
	// Без правила про сказанное раньше модель на уточнении забывала уже
	// перечисленные строки и просила их заново.
	Части.Добавить("Правила разговора: уточняй недостающее по одному-два вопроса за раз;"
		+ " все, что пользователь уже сказал, остается в силе, пока он сам это не поправит, —"
		+ " не переспрашивай и не теряй; называй только значения из перечней, других не придумывай;"
		+ " когда все собрано или пользователь говорит, что больше ничего не нужно, кратко перечисли"
		+ " итог и предложи нажать «Сформировать результат».");
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);

КонецФункции

// Запрос, которым диалог заканчивается: результат по схеме ответа сценария.
Функция ЗапросИтогаДиалога() Экспорт

	Возврат "Разговор закончен. Верни результат по итогам всего разговора строго по схеме ответа."
		+ " То, о чем не договорились, оставь пустым.";

КонецФункции

// Возвращает внешнюю обработку БСП, встроенную в подсистему макетом.
// Исходники лежат в integrations/bsp, но поставляется она вместе с расширением,
// чтобы не потеряться при переносе между базами.
Функция ПолучитьВстроеннуюОбработкуБСП() Экспорт

	Возврат Обработки.AI_ПомощникКонтекста.ПолучитьМакет("ОбработкаБСП");

КонецФункции

// Помещает встроенную обработку во временное хранилище и возвращает адрес.
// Подходит и для выгрузки в файл, и для передачи в форму регистрации
// дополнительной обработки БСП.
Функция АдресВстроеннойОбработкиБСП(ИдентификаторФормы = Неопределено) Экспорт

	Возврат ПоместитьВоВременноеХранилище(
		ПолучитьВстроеннуюОбработкуБСП(),
		ИдентификаторФормы);

КонецФункции

// Имя файла, под которым обработку ожидает увидеть администратор.
Функция ИмяФайлаВстроеннойОбработкиБСП() Экспорт

	Возврат ИмяОбработкиБСП() + ".epf";

КонецФункции

// Что мешает месту запуска работать. Каждая строка — готовая фраза для
// администратора: что не так и что сделать. Проверяется то, что иначе
// всплывет только у пользователя: несуществующий объект, отставшая схема,
// обработка БСП, не назначенная на объект, опечатка в имени обработчика.
//
// Возвращает структуру:
//   Проблемы               - Массив из Строка;
//   МожноНазначитьОбработку - Булево - объекта нет в назначении обработки БСП,
//                             и его можно туда добавить;
//   СхемаОтстает           - Булево - схему карты нужно перенести в сценарий.
Функция ПроблемыНастройкиМеста(МестоЗапуска) Экспорт

	Результат = Новый Структура("Проблемы,МожноНазначитьОбработку,СхемаОтстает",
		Новый Массив, Ложь, Ложь);
	Проблемы = Результат.Проблемы;

	Сценарий = МестоЗапуска.Сценарий;
	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Проблемы.Добавить("Не выбран сценарий — запускать нечего.");
	ИначеЕсли Сценарий.ПометкаУдаления Или Не Сценарий.Активен Тогда
		Проблемы.Добавить(СтрШаблон("Сценарий «%1» выключен — действие не появится у пользователей.",
			Сценарий));
	КонецЕсли;
	// Выключенное место — частое состояние после мастера и пакета сценариев:
	// «настройка в порядке» без этой оговорки обещала бы команду, которой нет.
	Если Не МестоЗапуска.Активно Тогда
		Проблемы.Добавить("Действие выключено — пользователи его не увидят."
			+ " Чтобы показать его, включите флажок «Включено» в месте запуска.");
	КонецЕсли;

	ТипМеста = СокрЛП(МестоЗапуска.ТипМеста);
	ПолноеИмя = СокрЛП(МестоЗапуска.ПолноеИмяМетаданных);
	СОбъектом = (ТипМеста = "Объект" Или ТипМеста = "Список");
	ОбъектНайден = Ложь;
	Если СОбъектом Тогда
		Если Не ЗначениеЗаполнено(ПолноеИмя) Или ПолноеИмя = "*" Тогда
			Проблемы.Добавить("Объект не указан: действие появится в карточке любого объекта"
				+ " конфигурации, а обработка БСП будет назначена на все документы и справочники.");
		ИначеЕсли Метаданные.НайтиПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
			Проблемы.Добавить(СтрШаблон("Объект «%1» не найден в конфигурации —"
				+ " действие не появится нигде. Выберите объект из списка.", ПолноеИмя));
		Иначе
			ОбъектНайден = Истина;
		КонецЕсли;
	КонецЕсли;

	ДобавитьПроблемыКарты(МестоЗапуска, ПолноеИмя, Результат);
	ДобавитьПроблемыДействия(МестоЗапуска, СОбъектом, Проблемы);
	ДобавитьПроблемыУточнений(МестоЗапуска, Проблемы);
	ДобавитьПроблемыДанныхОбъекта(МестоЗапуска, СОбъектом, ОбъектНайден, ПолноеИмя, Проблемы);

	Если ОбъектНайден Тогда
		Регистрация = РегистрацияОбработкиБСП();
		Если Регистрация = Неопределено Тогда
			Если Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено Тогда
				Проблемы.Добавить("Обработка «AI-помощник» не зарегистрирована в дополнительных"
					+ " отчетах и обработках — команды помощника в карточках нет."
					+ " Выгрузите ее командой «Сохранить обработку для БСП» и зарегистрируйте.");
			КонецЕсли;
		ИначеЕсли Не Регистрация.Используется Тогда
			Проблемы.Добавить(СтрШаблон("Регистрация обработки «%1» отключена —"
				+ " команды помощника в карточках нет.", Регистрация.Наименование));
		ИначеЕсли Регистрация.Назначение.Найти(ПолноеИмя) = Неопределено Тогда
			Проблемы.Добавить(СтрШаблон("Команда помощника не появится в «%1»: обработка «%2»"
				+ " не назначена на этот объект. Нажмите «Подключить команду к объекту».",
				ПредставлениеОбъектаМетаданных(ПолноеИмя), Регистрация.Наименование));
			Результат.МожноНазначитьОбработку = ПравоДоступа("Изменение",
				Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки"));
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Пачку запускают из списка, а заполнять форму там нечем: помощник открыт без
// карточки объекта. Текст общий для проверки места и мастера нового действия.
Функция ТекстПачкаБезФормы() Экспорт

	Возврат "Пачку запускают из списка, где формы объекта нет: «Заполнить форму» сработает"
		+ " только для одного объекта, открытого в карточке. Для пачки выберите «Записать в объект».";

КонецФункции

// Объекты, для которых можно настроить действие: справочники, документы,
// бизнес-процессы и задачи. Представление — синоним с видом объекта, чтобы
// одноименные объекты разных видов не путались. Устаревшие «Удалить...» в
// список не попадают: действие на них настраивать незачем, а в конфигурации
// вроде Документооборота они занимают первые экраны списка.
//
// Отбор — часть синонима или имени: для подбора по мере ввода. С отбором
// возвращается не больше 30 вариантов.
Функция ВариантыОбъектовМетаданных(Знач Отбор = "") Экспорт

	Отбор = НРег(СокрЛП(Отбор));
	Варианты = Новый СписокЗначений;
	Для Каждого Коллекция Из ОписанияКоллекцийОбъектов() Цикл
		Для Каждого ОписаниеОбъекта Из Коллекция.Объекты Цикл
			Если СтрНачинаетсяС(ОписаниеОбъекта.Имя, "Удалить") Тогда
				Продолжить;
			КонецЕсли;
			Представление = СтрШаблон("%1 (%2)", ОписаниеОбъекта.Синоним, Коллекция.Вид);
			Если ЗначениеЗаполнено(Отбор)
				И СтрНайти(НРег(Представление), Отбор) = 0
				И СтрНайти(НРег(ОписаниеОбъекта.Имя), Отбор) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Варианты.Добавить(ОписаниеОбъекта.ПолноеИмя(), Представление);
		КонецЦикла;
	КонецЦикла;
	Варианты.СортироватьПоПредставлению();
	Если ЗначениеЗаполнено(Отбор) Тогда
		Пока Варианты.Количество() > 30 Цикл
			Варианты.Удалить(Варианты.Количество() - 1);
		КонецЦикла;
	КонецЕсли;
	Возврат Варианты;

КонецФункции

// Один объект, а не список: «Шаблон согласования», а не «Шаблоны согласования».
// Представления объекта в метаданных может не быть — тогда синоним.
Функция ПредставлениеОдногоОбъекта(ОписаниеОбъекта) Экспорт

	Представление = "";
	Попытка
		Представление = СокрЛП(ОписаниеОбъекта.ПредставлениеОбъекта);
	Исключение
		// У вида метаданных нет представления объекта.
		Представление = "";
	КонецПопытки;
	Возврат ?(ЗначениеЗаполнено(Представление), Представление, ОписаниеОбъекта.Представление());

КонецФункции

// Человеческое имя объекта метаданных: «Внутренние документы (справочник)».
Функция ПредставлениеОбъектаМетаданных(ПолноеИмя) Экспорт

	Имя = СокрЛП(Строка(ПолноеИмя));
	Если Не ЗначениеЗаполнено(Имя) Или Имя = "*" Тогда
		Возврат "любой объект";
	КонецЕсли;
	ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(Имя);
	Если ОписаниеОбъекта = Неопределено Тогда
		Возврат Имя + " (не найден в конфигурации)";
	КонецЕсли;
	Для Каждого Коллекция Из ОписанияКоллекцийОбъектов() Цикл
		Если Коллекция.Объекты.Содержит(ОписаниеОбъекта) Тогда
			Возврат СтрШаблон("%1 (%2)", ОписаниеОбъекта.Синоним, Коллекция.Вид);
		КонецЕсли;
	КонецЦикла;
	Возврат ОписаниеОбъекта.Синоним;

КонецФункции

// Регистрация обработки помощника в реестре дополнительных обработок БСП.
// Реестр читается запросом: подсистема не зависит от прикладного API БСП,
// а в конфигурации без нее просто вернется Неопределено.
//
// Возвращает структуру Ссылка, Наименование, Используется, Назначение — массив
// полных имен объектов, либо Неопределено, если обработка не зарегистрирована.
Функция РегистрацияОбработкиБСП() Экспорт

	Если Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Обработки.Ссылка КАК Ссылка,
		|	Обработки.Наименование КАК Наименование,
		|	Обработки.Публикация = ЗНАЧЕНИЕ(
		|		Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Отключена) КАК Отключена
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
		|ГДЕ
		|	НЕ Обработки.ПометкаУдаления
		|	И Обработки.ИмяОбъекта = &Имя
		|;
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Назначение.ОбъектНазначения.ПолноеИмя КАК ПолноеИмя
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки.Назначение КАК Назначение
		|ГДЕ
		|	НЕ Назначение.Ссылка.ПометкаУдаления
		|	И Назначение.Ссылка.ИмяОбъекта = &Имя");
	Запрос.УстановитьПараметр("Имя", ИмяОбработкиБСП());
	Попытка
		Пакет = Запрос.ВыполнитьПакет();
	Исключение
		// Реестр другой редакции БСП или нет прав на чтение.
		Возврат Неопределено;
	КонецПопытки;

	Выборка = Пакет[0].Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Ссылка,Наименование,Используется,Назначение",
		Выборка.Ссылка,
		Выборка.Наименование,
		Не Выборка.Отключена,
		Пакет[1].Выгрузить().ВыгрузитьКолонку("ПолноеИмя"));

КонецФункции

// Добавляет объект в назначение обработки помощника. БСП сама обновляет по
// назначению свой регистр команд при записи регистрации, поэтому после записи
// команда появляется в карточке объекта без перерегистрации обработки.
//
// Действие административное: оно меняет реестр подключенного кода.
Процедура НазначитьОбработкуБСП(ПолноеИмя) Экспорт

	Регистрация = РегистрацияОбработкиБСП();
	Если Регистрация = Неопределено Тогда
		ВызватьИсключение "Обработка помощника не зарегистрирована в дополнительных отчетах и обработках.";
	КонецЕсли;
	Если Не ПравоДоступа("Изменение", Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки")) Тогда
		ВызватьИсключение "Нет права менять регистрацию дополнительных обработок.";
	КонецЕсли;
	Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект «%1» не найден в конфигурации.", ПолноеИмя);
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Идентификаторы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИдентификаторыОбъектовМетаданных КАК Идентификаторы
		|ГДЕ
		|	НЕ Идентификаторы.ПометкаУдаления
		|	И Идентификаторы.ПолноеИмя = &ПолноеИмя");
	Запрос.УстановитьПараметр("ПолноеИмя", ПолноеИмя);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("Для «%1» нет идентификатора объекта метаданных БСП.", ПолноеИмя);
	КонецЕсли;

	Объект = Регистрация.Ссылка.ПолучитьОбъект();
	Если Объект.Назначение.Найти(Выборка.Ссылка, "ОбъектНазначения") = Неопределено Тогда
		Объект.Назначение.Добавить().ОбъектНазначения = Выборка.Ссылка;
		Объект.Записать();
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"AI.НастройкаДействий",
		УровеньЖурналаРегистрации.Информация,
		,
		Регистрация.Ссылка,
		"Обработка помощника назначена на объект " + ПолноеИмя);

КонецПроцедуры

// Имена обработок из реестра БСП — для выбора внешнего обработчика действия.
// Обработка самого помощника в список не попадает: действием она не бывает.
Функция ЗарегистрированныеОбработки() Экспорт

	Варианты = Новый СписокЗначений;
	Если Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") = Неопределено Тогда
		Возврат Варианты;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Обработки.Наименование КАК Наименование,
		|	Обработки.ИмяОбъекта КАК ИмяОбъекта
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
		|ГДЕ
		|	НЕ Обработки.ПометкаУдаления
		|	И Обработки.ИмяОбъекта <> &Имя
		|УПОРЯДОЧИТЬ ПО
		|	Обработки.Наименование");
	Запрос.УстановитьПараметр("Имя", ИмяОбработкиБСП());
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Варианты;
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		Варианты.Добавить(Выборка.Наименование,
			СтрШаблон("%1 (%2)", Выборка.Наименование, Выборка.ИмяОбъекта));
	КонецЦикла;
	Возврат Варианты;

КонецФункции

Функция НормализоватьОбъекты(ОбъектыНазначения)
	Результат = Новый Массив;
	Если ОбъектыНазначения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(ОбъектыНазначения) = Тип("Массив")
		Или ТипЗнч(ОбъектыНазначения) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Значение Из ОбъектыНазначения Цикл
			Если ЗначениеЗаполнено(Значение) Тогда
				Результат.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(ОбъектыНазначения) Тогда
		Результат.Добавить(ОбъектыНазначения);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ОписаниеОбъекта(ОбъектНазначения)
	ПолноеИмяМетаданных = "";
	Попытка
		ПолноеИмяМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(ОбъектНазначения)).ПолноеИмя();
	Исключение
	КонецПопытки;
	ТипИсточника = ?(ЗначениеЗаполнено(ПолноеИмяМетаданных), ПолноеИмяМетаданных, Строка(ТипЗнч(ОбъектНазначения)));
	Ключ = "";
	Попытка
		Ключ = Строка(ОбъектНазначения.УникальныйИдентификатор());
	Исключение
		Попытка
			Ключ = XMLСтрока(ОбъектНазначения);
		Исключение
		КонецПопытки;
	КонецПопытки;
	Представление = ПредставлениеОбъектаНазначения(ОбъектНазначения);
	JSON = Новый Структура;
	JSON.Вставить("metadata_name", ПолноеИмяМетаданных);
	JSON.Вставить("key", Ключ);
	JSON.Вставить("presentation", Представление);
	Возврат Новый Структура(
		"ПолноеИмяМетаданных,ТипИсточника,Ключ,Представление,JSON",
		ПолноеИмяМетаданных,
		ТипИсточника,
		Ключ,
		Представление,
		JSON);
КонецФункции

// Имя объекта внешней обработки помощника — по нему регистрация ищется в
// реестре БСП.
Функция ИмяОбработкиБСП()
	Возврат "AI_ПомощникКонтекстаБСП";
КонецФункции

// Виды объектов, на которые настраиваются действия, с человеческим названием
// вида: у справочника и документа бывают одинаковые синонимы.
Функция ОписанияКоллекцийОбъектов()

	Коллекции = Новый Массив;
	Коллекции.Добавить(Новый Структура("Вид,Объекты", "справочник", Метаданные.Справочники));
	Коллекции.Добавить(Новый Структура("Вид,Объекты", "документ", Метаданные.Документы));
	Коллекции.Добавить(Новый Структура("Вид,Объекты", "бизнес-процесс", Метаданные.БизнесПроцессы));
	Коллекции.Добавить(Новый Структура("Вид,Объекты", "задача", Метаданные.Задачи));
	Возврат Коллекции;

КонецФункции

Процедура ДобавитьПроблемыКарты(МестоЗапуска, ПолноеИмя, Результат)

	Карта = МестоЗапуска.КартаИзвлечения;
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Возврат;
	КонецЕсли;
	Если Карта.ПометкаУдаления Или Не Карта.Активна Тогда
		Результат.Проблемы.Добавить(СтрШаблон("Карта извлечения «%1» выключена —"
			+ " ответ модели не разложится по реквизитам.", Карта));
		Возврат;
	КонецЕсли;

	ИмяКарты = СокрЛП(Карта.ПолноеИмяМетаданных);
	Если ЗначениеЗаполнено(ИмяКарты) И ЗначениеЗаполнено(ПолноеИмя) И ПолноеИмя <> "*"
		И ИмяКарты <> ПолноеИмя Тогда
		Результат.Проблемы.Добавить(СтрШаблон("Карта «%1» настроена на «%2», а действие —"
			+ " на «%3»: реквизиты карты у этого объекта могут не найтись.",
			Карта,
			ПредставлениеОбъектаМетаданных(ИмяКарты),
			ПредставлениеОбъектаМетаданных(ПолноеИмя)));
	КонецЕсли;

	Если AI_ИзвлечениеРеквизитов.СхемаСценарияОтстает(Карта, МестоЗапуска.Сценарий) Тогда
		Результат.СхемаОтстает = Истина;
		Результат.Проблемы.Добавить(СтрШаблон("Схема ответа в сценарии «%1» отстает от карты"
			+ " «%2»: модель не вернет поля, добавленные в карту позже."
			+ " Нажмите «Обновить схему сценария».", МестоЗапуска.Сценарий, Карта));
	КонецЕсли;

	Если Карта.ЗаменятьСтрокиТабличныхЧастей И Карта.ОбновлятьСтрокиПоНомеру Тогда
		Результат.Проблемы.Добавить(СтрШаблон("В карте «%1» отмечено и «Заменять строки», и «Обновлять"
			+ " строки по номеру» — оставьте что-то одно.", Карта));
	КонецЕсли;
	// Номер строки модель берет из данных объекта: без табличной части в
	// данных ей не на что сослаться.
	Если Карта.ОбновлятьСтрокиПоНомеру Тогда
		ТабличныеЧастиДанных = Новый Соответствие;
		Для Каждого СтрокаДанных Из МестоЗапуска.ДанныеОбъекта Цикл
			ТабличныеЧастиДанных.Вставить(НРег(СокрЛП(СтрокаДанных.ТабличнаяЧасть)), Истина);
		КонецЦикла;
		Проверенные = Новый Соответствие;
		Для Каждого Поле Из Карта.Поля Цикл
			ИмяТЧ = СокрЛП(Поле.ТабличнаяЧасть);
			Если Не ЗначениеЗаполнено(ИмяТЧ) Или Проверенные.Получить(НРег(ИмяТЧ)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Проверенные.Вставить(НРег(ИмяТЧ), Истина);
			Если ТабличныеЧастиДанных.Получить(НРег(ИмяТЧ)) = Неопределено Тогда
				Результат.Проблемы.Добавить(СтрШаблон("Строки «%1» обновляются по номеру, но сама табличная"
					+ " часть не передается модели в данных объекта — номеров строк она не узнает.", ИмяТЧ));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПроблемыДействия(МестоЗапуска, СОбъектом, Проблемы)

	Виды = Перечисления.AI_ВидДействия;
	Вид = МестоЗапуска.ВидДействия;

	Если Не СОбъектом И (Вид = Виды.ЗаполнитьФорму Или Вид = Виды.ЗаписатьОбъект) Тогда
		Проблемы.Добавить(СтрШаблон("Действие без объекта не может «%1»:"
			+ " заполнять и записывать нечего, результат будет только показан.", Вид));
	КонецЕсли;
	Если (Вид = Виды.ЗаполнитьФорму Или Вид = Виды.ЗаписатьОбъект Или Вид = Виды.СоздатьОбъект)
		И Не ЗначениеЗаполнено(МестоЗапуска.КартаИзвлечения) Тогда
		Проблемы.Добавить("Для заполнения, записи и создания объекта нужна карта извлечения:"
			+ " без нее помощник не знает, куда класть значения.");
	КонецЕсли;
	Если Вид = Виды.СоздатьОбъект И ЗначениеЗаполнено(МестоЗапуска.КартаИзвлечения) Тогда
		ИмяСоздания = AI_ПрименениеРекомендаций.ОбъектСоздания(МестоЗапуска);
		ОписаниеСоздания = Метаданные.НайтиПоПолномуИмени(ИмяСоздания);
		Если ОписаниеСоздания = Неопределено Тогда
			Проблемы.Добавить("Не определено, какой объект создавать: у карты извлечения не указан объект.");
		ИначеЕсли Не Метаданные.Справочники.Содержит(ОписаниеСоздания)
			И Не Метаданные.Документы.Содержит(ОписаниеСоздания) Тогда
			Проблемы.Добавить(СтрШаблон("Создавать можно только элементы справочников и документы,"
				+ " а карта настроена на «%1».", ПредставлениеОбъектаМетаданных(ИмяСоздания)));
		КонецЕсли;
	КонецЕсли;
	Если СОбъектом И МестоЗапуска.РазрешитьНесколькоОбъектов И Вид = Виды.ЗаполнитьФорму Тогда
		Проблемы.Добавить(ТекстПачкаБезФормы());
	КонецЕсли;
	Если МестоЗапуска.РежимДиалога И МестоЗапуска.РазрешитьНесколькоОбъектов Тогда
		Проблемы.Добавить("Диалог ведется по одному объекту: для пачки из списка он не запустится."
			+ " Снимите «Можно запускать для нескольких объектов» или режим диалога.");
	КонецЕсли;
	Если Вид = Виды.ПользовательскоеДействие И Не ЗначениеЗаполнено(МестоЗапуска.КлючДействия) Тогда
		Проблемы.Добавить("Не указан ключ действия — прикладному коду нечего выполнять.");
	КонецЕсли;
	// Обработка нужна не только виду «Внешний обработчик»: проверка и этапы
	// вызывают ее при любом виде действия.
	Методы = МетодыОбработкиМеста(МестоЗапуска);
	НужнаОбработка = (Вид = Виды.ВнешнийОбработчик) Или Методы.Количество() > 0;
	Если НужнаОбработка И Не ЗначениеЗаполнено(МестоЗапуска.Обработчик) Тогда
		Если Вид = Виды.ВнешнийОбработчик Тогда
			Проблемы.Добавить("Не выбрана внешняя обработка действия.");
		Иначе
			Проблемы.Добавить("Заданы методы обработки, но сама обработка не выбрана —"
				+ " проверки и этапы не выполнятся.");
		КонецЕсли;
	ИначеЕсли НужнаОбработка
		И Не AI_ПрименениеРекомендаций.ОбработчикЗарегистрирован(МестоЗапуска.Обработчик) Тогда
		Проблемы.Добавить(СтрШаблон("Обработка «%1» не найдена среди дополнительных"
			+ " обработок или отключена.", МестоЗапуска.Обработчик));
	КонецЕсли;
	Для Каждого Метод Из Методы Цикл
		Если Не AI_ПрименениеРекомендаций.ИмяМетодаДопустимо(Метод.Значение) Тогда
			Проблемы.Добавить(СтрШаблон("%1: «%2» — недопустимое имя метода. Разрешены буквы,"
				+ " цифры и подчеркивание, не с цифры.", Метод.Представление, Метод.Значение));
		КонецЕсли;
	КонецЦикла;

	ДобавитьПроблемыВидимости(МестоЗапуска, Проблемы);

КонецПроцедуры

// Заполненные методы обработки места: значение — имя метода, представление —
// поле, в котором оно задано.
Функция МетодыОбработкиМеста(МестоЗапуска)

	Методы = Новый СписокЗначений;
	Поля = Новый Структура("МетодДействия,МетодПроверки,МетодПодготовкиЗапроса,МетодПослеОтвета,МетодПослеДействия",
		"Метод действия", "Метод проверки", "Метод подготовки запроса", "Метод после ответа",
		"Метод после действия");
	Для Каждого Поле Из Поля Цикл
		// Метод действия вызывается только у вида «Внешний обработчик»: у других
		// видов заполненный он просто не нужен.
		Если Поле.Ключ = "МетодДействия"
			И МестоЗапуска.ВидДействия <> Перечисления.AI_ВидДействия.ВнешнийОбработчик Тогда
			Продолжить;
		КонецЕсли;
		ИмяМетода = СокрЛП(МестоЗапуска[Поле.Ключ]);
		Если ЗначениеЗаполнено(ИмяМетода) Тогда
			Методы.Добавить(ИмяМетода, Поле.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Методы;

КонецФункции

// Условие видимости, которое никогда не выполнится, — не «видно всем», а
// «не видно никому»: опечатка в имени роли прячет действие молча.
Процедура ДобавитьПроблемыВидимости(МестоЗапуска, Проблемы)

	Условия = МестоЗапуска.Видимость;
	Если Условия.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИменаГрупп = Неопределено;
	БезГруппСообщено = Ложь;
	Для Каждого Условие Из Условия Цикл
		Вид = СокрЛП(Условие.ВидУсловия);
		Имя = СокрЛП(Условие.Имя);
		Если Не ЗначениеЗаполнено(Имя) Тогда
			Проблемы.Добавить("Кому показывать: в условии не указано имя роли или группы доступа.");
		ИначеЕсли Вид = "Роль" Тогда
			Если Метаданные.Роли.Найти(Имя) = Неопределено Тогда
				Проблемы.Добавить(СтрШаблон("Кому показывать: роли «%1» в конфигурации нет —"
					+ " по этому условию действие не увидит никто.", Имя));
			КонецЕсли;
		ИначеЕсли Вид = "ГруппаДоступа" Тогда
			// Без групп доступа не выполнится ни одно условие по группе —
			// достаточно сказать об этом раз, а роли проверить дальше.
			Если Не ЕстьГруппыДоступа() Тогда
				Если Не БезГруппСообщено Тогда
					Проблемы.Добавить("Кому показывать: в конфигурации нет групп доступа БСП и полномочий"
						+ " Документооборота — условие по группе не выполнится. Используйте роль.");
					БезГруппСообщено = Истина;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если ИменаГрупп = Неопределено Тогда
				ИменаГрупп = ИменаГруппДоступа();
			КонецЕсли;
			Если ИменаГрупп.Найти(Имя) = Неопределено Тогда
				Проблемы.Добавить(СтрШаблон("Кому показывать: профиля или группы доступа с участниками"
					+ " «%1» нет — по этому условию действие не увидит никто.", Имя));
			КонецЕсли;
		Иначе
			Проблемы.Добавить(СтрШаблон("Кому показывать: неизвестное условие «%1»."
				+ " Допустимы «Роль» и «ГруппаДоступа».", Вид));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Что именно передать модели: реквизиты шапки и табличные части с колонками по
// настройке места. «*» — все реквизиты шапки или все колонки табличной части.
// Неизвестные имена и то, что пользователю не видно, пропускаются молча:
// о первых говорит проверка настройки, а вторые модели и не положены.
//
// Возвращает структуру:
//   Реквизиты      - Массив из Структура - Имя, Представление;
//   ТабличныеЧасти - Массив из Структура - Имя, Представление, Колонки.
Функция СоставДанныхОбъекта(МестоЗапуска, ОписаниеОбъекта)

	Состав = Новый Структура("Реквизиты,ТабличныеЧасти", Новый Массив, Новый Массив);
	Добавленные = Новый Соответствие;
	Части = Новый Соответствие;

	Для Каждого СтрокаДанных Из МестоЗапуска.ДанныеОбъекта Цикл
		ИмяТЧ = СокрЛП(СтрокаДанных.ТабличнаяЧасть);
		ИмяРеквизита = СокрЛП(СтрокаДанных.ПутьРеквизита);

		Если Не ЗначениеЗаполнено(ИмяТЧ) Тогда
			Реквизиты = Новый Массив;
			Если ИмяРеквизита = "*" Тогда
				Для Каждого Реквизит Из ОписаниеОбъекта.Реквизиты Цикл
					Реквизиты.Добавить(Реквизит);
				КонецЦикла;
			ИначеЕсли ЗначениеЗаполнено(ИмяРеквизита) Тогда
				Реквизит = ОписаниеРеквизитаШапки(ОписаниеОбъекта, ИмяРеквизита);
				Если Реквизит <> Неопределено Тогда
					Реквизиты.Добавить(Реквизит);
				КонецЕсли;
			КонецЕсли;
			Для Каждого Реквизит Из Реквизиты Цикл
				Если Добавленные.Получить(Реквизит.Имя) = Неопределено И ЭлементДанныхДоступен(Реквизит) Тогда
					Добавленные.Вставить(Реквизит.Имя, Истина);
					Состав.Реквизиты.Добавить(Новый Структура("Имя,Представление",
						Реквизит.Имя, ИмяДляЧеловека(Реквизит)));
				КонецЕсли;
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		ОписаниеТЧ = Неопределено;
		Попытка
			ОписаниеТЧ = ОписаниеОбъекта.ТабличныеЧасти.Найти(ИмяТЧ);
		Исключение
			ОписаниеТЧ = Неопределено;
		КонецПопытки;
		Если ОписаниеТЧ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Часть = Части.Получить(ОписаниеТЧ.Имя);
		Если Часть = Неопределено Тогда
			Часть = Новый Структура("Имя,Представление,Колонки,Имена",
				ОписаниеТЧ.Имя, ИмяДляЧеловека(ОписаниеТЧ), Новый Массив, Новый Соответствие);
			Части.Вставить(ОписаниеТЧ.Имя, Часть);
			Состав.ТабличныеЧасти.Добавить(Часть);
		КонецЕсли;
		Для Каждого Колонка Из ОписаниеТЧ.Реквизиты Цикл
			Если (ИмяРеквизита = "*" Или Не ЗначениеЗаполнено(ИмяРеквизита) Или Колонка.Имя = ИмяРеквизита)
				И Не СтрНачинаетсяС(Колонка.Имя, "Удалить")
				И Часть.Имена.Получить(Колонка.Имя) = Неопределено
				И ЭлементДанныхДоступен(Колонка) Тогда
				Часть.Имена.Вставить(Колонка.Имя, Истина);
				Часть.Колонки.Добавить(Новый Структура("Имя,Представление", Колонка.Имя, ИмяДляЧеловека(Колонка)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Устаревшие реквизиты «Удалить...» модели ни к чему.
	Отобранные = Новый Массив;
	Для Каждого Реквизит Из Состав.Реквизиты Цикл
		Если Не СтрНачинаетсяС(Реквизит.Имя, "Удалить") Тогда
			Отобранные.Добавить(Реквизит);
		КонецЕсли;
	КонецЦикла;
	Состав.Реквизиты = Отобранные;
	Возврат Состав;

КонецФункции

// Право пользователя видеть реквизит. Для колонок табличных частей и
// стандартных реквизитов платформа права не проверяет — они видны вместе
// с объектом.
Функция ЭлементДанныхДоступен(ОписаниеЭлемента)

	Попытка
		Возврат ПравоДоступа("Просмотр", ОписаниеЭлемента);
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

Функция ИмяДляЧеловека(ОписаниеЭлемента)

	Синоним = СокрЛП(ОписаниеЭлемента.Синоним);
	Возврат ?(ЗначениеЗаполнено(Синоним), Синоним, ОписаниеЭлемента.Имя);

КонецФункции

// Значение в тексте для модели: числа без разделителей разрядов, даты в ISO,
// флажки словами. Переводы строк и «|» ломали бы таблицу — заменяются.
Функция ЗначениеДляМодели(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "да", "нет");
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧГ=0; ЧН=0");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат "";
		КонецЕсли;
		Возврат ?(Значение = НачалоДня(Значение),
			Формат(Значение, "ДФ=yyyy-MM-dd"),
			Формат(Значение, "ДФ='yyyy-MM-dd HH:mm'"));
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Текст = СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, "|", "/");
	Возврат ?(СтрДлина(Текст) > 300, Лев(Текст, 300) + "…", Текст);

КонецФункции

// Потолки данных объекта: строк на табличную часть и символов всего. Выше —
// уже не «данные документа», а выгрузка, и ее стоит отдавать файлом.
Функция МаксимумСтрокДанныхОбъекта()
	Возврат 300;
КонецФункции

Функция МаксимумСимволовДанныхОбъекта()
	Возврат 60000;
КонецФункции

// Данные объекта читаются по именам из настройки: опечатка в имени реквизита
// иначе всплыла бы только отказом при запуске.
Процедура ДобавитьПроблемыДанныхОбъекта(МестоЗапуска, СОбъектом, ОбъектНайден, ПолноеИмя, Проблемы)

	Если МестоЗапуска.ДанныеОбъекта.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не СОбъектом Тогда
		Проблемы.Добавить("Действие без объекта: передавать модели данные объекта неоткуда —"
			+ " очистите «Данные объекта для модели».");
		Возврат;
	КонецЕсли;
	Если Не ОбъектНайден Тогда
		Возврат;
	КонецЕсли;
	ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Для Каждого СтрокаДанных Из МестоЗапуска.ДанныеОбъекта Цикл
		Причина = ПричинаОшибкиДанныхОбъекта(ОписаниеОбъекта,
			СокрЛП(СтрокаДанных.ТабличнаяЧасть), СокрЛП(СтрокаДанных.ПутьРеквизита));
		Если ЗначениеЗаполнено(Причина) Тогда
			Проблемы.Добавить("Данные объекта для модели: " + Причина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Почему строку настройки данных объекта нельзя прочитать. Пустая строка — можно.
Функция ПричинаОшибкиДанныхОбъекта(ОписаниеОбъекта, ИмяТЧ, ИмяРеквизита)

	Если ЗначениеЗаполнено(ИмяТЧ) Тогда
		ОписаниеТЧ = Неопределено;
		Попытка
			ОписаниеТЧ = ОписаниеОбъекта.ТабличныеЧасти.Найти(ИмяТЧ);
		Исключение
			ОписаниеТЧ = Неопределено;
		КонецПопытки;
		Если ОписаниеТЧ = Неопределено Тогда
			Возврат СтрШаблон("табличной части «%1» у объекта нет.", ИмяТЧ);
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяРеквизита) И ИмяРеквизита <> "*"
			И ОписаниеТЧ.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Возврат СтрШаблон("в табличной части «%1» нет колонки «%2».", ИмяТЧ, ИмяРеквизита);
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат "не указан реквизит.";
	КонецЕсли;
	Если ИмяРеквизита = "*" Или ОписаниеРеквизитаШапки(ОписаниеОбъекта, ИмяРеквизита) <> Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон("реквизита «%1» у объекта нет.", ИмяРеквизита);

КонецФункции

// Реквизит шапки по имени, включая стандартные (Наименование, Номер, Дата).
Функция ОписаниеРеквизитаШапки(ОписаниеОбъекта, Имя)

	Реквизит = ОписаниеОбъекта.Реквизиты.Найти(Имя);
	Если Реквизит <> Неопределено Тогда
		Возврат Реквизит;
	КонецЕсли;
	Попытка
		Для Каждого Стандартный Из ОписаниеОбъекта.СтандартныеРеквизиты Цикл
			Если Стандартный.Имя = Имя Тогда
				Возврат Стандартный;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

Процедура ДобавитьПроблемыУточнений(МестоЗапуска, Проблемы)

	Номер = 0;
	Для Каждого Уточнение Из МестоЗапуска.Уточнения Цикл
		Номер = Номер + 1;
		Название = ?(ЗначениеЗаполнено(Уточнение.Представление),
			Уточнение.Представление, "Вопрос " + Формат(Номер, "ЧГ=0"));
		Источник = СокрЛП(Уточнение.ИсточникДанных);
		Если Не ЗначениеЗаполнено(Источник) Тогда
			Продолжить;
		КонецЕсли;
		Если Метаданные.НайтиПоПолномуИмени(Источник) = Неопределено Тогда
			Проблемы.Добавить(СтрШаблон("«%1»: источник вариантов «%2» не найден в конфигурации.",
				Название, Источник));
			Продолжить;
		КонецЕсли;
		Если Уточнение.ВидУточнения = Перечисления.AI_ВидУточнения.ВыборИзПодчиненных
			И Не ЗначениеЗаполнено(Уточнение.РеквизитСвязи) Тогда
			Проблемы.Добавить(СтрШаблон("«%1»: для выбора из подчиненных не указан реквизит"
				+ " связи с объектом.", Название));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Представление объекта для человека. Новый документ без заголовка платформа
// показывает пустой строкой или «<>», и в списке пачки такие объекты
// неразличимы. А пачку запускают как раз по таким — только что заведенным.
Функция ПредставлениеОбъектаНазначения(ОбъектНазначения)

	Представление = СокрЛП(Строка(ОбъектНазначения));
	Если ЗначениеЗаполнено(Представление) И Представление <> "<>" Тогда
		Возврат Лев(Представление, 250);
	КонецЕсли;

	ОписаниеМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(ОбъектНазначения));
	Если ОписаниеМетаданных = Неопределено Тогда
		Возврат "Объект без наименования";
	КонецЕсли;
	Имя = ПредставлениеОдногоОбъекта(ОписаниеМетаданных);

	// Номер или код хоть как-то отличают один безымянный объект от другого.
	Номер = "";
	Для Каждого ИмяРеквизита Из СтрРазделить("Номер,Код", ",") Цикл
		Попытка
			Номер = СокрЛП(Строка(ОбъектНазначения[ИмяРеквизита]));
		Исключение
			Номер = "";
		КонецПопытки;
		Если ЗначениеЗаполнено(Номер) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(Номер) Тогда
		Возврат Лев(СтрШаблон("%1 %2 (без наименования)", Имя, Номер), 250);
	КонецЕсли;
	Возврат Лев(Имя + " (без наименования)", 250);

КонецФункции

Функция СформироватьТекстКонтекста(ЭлементыКонтекста, ТипМеста)
	Строки = Новый Массив;
	Строки.Добавить("Контекст запуска: " + ТипМеста);
	Для Каждого Элемент Из ЭлементыКонтекста Цикл
		Строки.Добавить(СтрШаблон(
			"Объект: %1; тип: %2; ключ: %3",
			Элемент.presentation,
			Элемент.metadata_name,
			Элемент.key));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ЗаписатьJSONВСтроку(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции
