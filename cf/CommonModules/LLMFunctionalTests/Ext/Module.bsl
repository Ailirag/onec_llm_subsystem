Процедура ТестИзоляцииДиалогов(Результаты)

	Попытка
		AI_ДиалогиСервер.УдалитьДиалогиДо(ТекущаяДатаСеанса() + 86400);
		Фикстуры = ПолучитьФикстуры();
		Пользователь1 = Новый УникальныйИдентификатор("11111111-1111-1111-1111-111111111111");
		Пользователь2 = Новый УникальныйИдентификатор("22222222-2222-2222-2222-222222222222");
		Настройки = Новый Структура(
			"Провайдер,Модель,Агент,ТипAPI,СистемныйПромт,ГлубинаДиалога",
			Фикстуры.Провайдер,
			НайтиМодель(Фикстуры.Провайдер, "mock-agent"),
			Фикстуры.Агент,
			Перечисления.AI_ТипAPI.Responses,
			"Autotest system prompt",
			20);
		Диалог = AI_ДиалогиСервер.СоздатьДиалог(Пользователь1, Настройки);
		AI_ДиалогиСервер.ЗаписатьСобытие(
			Пользователь1,
			Диалог,
			Перечисления.AI_РольСообщения.user,
			"Первое тестовое сообщение");
		AI_ДиалогиСервер.ЗаписатьСобытие(
			Пользователь1,
			Диалог,
			Перечисления.AI_РольСообщения.assistant,
			"Тестовый ответ");
		Сообщения = AI_ДиалогиСервер.ПолучитьСообщения(Пользователь1, Диалог, 20);
		Проверить(Сообщения.Количество() = 2, "История диалога должна содержать два сообщения.");

		ДоступЧужогоПользователя = Истина;
		Попытка
			AI_ДиалогиСервер.ПроверитьДоступ(Пользователь2, Диалог);
		Исключение
			ДоступЧужогоПользователя = Ложь;
		КонецПопытки;
		Проверить(Не ДоступЧужогоПользователя,
			"Другой пользователь не должен видеть чужой диалог.");

		AI_ДиалогиСервер.Переименовать(Пользователь1, Диалог, "Autotest conversation");
		AI_ДиалогиСервер.УстановитьАрхив(Пользователь1, Диалог, Истина);
		Настройки = AI_ДиалогиСервер.ПолучитьНастройки(Пользователь1, Диалог);
		Проверить(Настройки.Архивирован И Настройки.Заголовок = "Autotest conversation",
			"Переименование или архивирование диалога не сохранено.");
		AI_ДиалогиСервер.УстановитьАрхив(Пользователь1, Диалог, Ложь);
		ДобавитьРезультат(
			Результаты,
			"conversation_isolation",
			Истина,
			"История, настройки, архив и запрет чужого доступа работают.");
	Исключение
		ДобавитьОшибкуТеста(Результаты, "conversation_isolation");
	КонецПопытки;

КонецПроцедуры

Процедура ТестЖурналированияТокенов(Результаты)

	Попытка
		Фикстуры = ПолучитьФикстуры();
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	СУММА(Журнал.ВходныеТокены) КАК ВходныеТокены,
			|	СУММА(Журнал.ВыходныеТокены) КАК ВыходныеТокены,
			|	СУММА(Журнал.ТулТокены) КАК ТулТокены,
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	РегистрСведений.AI_ЖурналЗапросов КАК Журнал
			|ГДЕ
			|	Журнал.Провайдер = &Провайдер
			|	И Журнал.Период >= &Начало");
		Запрос.УстановитьПараметр("Провайдер", Фикстуры.Провайдер);
		Запрос.УстановитьПараметр("Начало", НачалоДня(ТекущаяДатаСеанса()));
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Проверить(Выборка.Количество = 6,
			"Ожидалось шесть журналируемых модельных операций.");
		Проверить(Выборка.ВходныеТокены = 76
				И Выборка.ВыходныеТокены = 32
				И Выборка.ТулТокены = 18,
			"Журнал содержит неверные итоги токенов одного прогона.");
		ДобавитьРезультат(
			Результаты,
			"token_journal",
			Истина,
			СтрШаблон(
				"Записей: %1, токены: %2 вход / %3 выход / %4 tools.",
				Выборка.Количество,
				Выборка.ВходныеТокены,
				Выборка.ВыходныеТокены,
				Выборка.ТулТокены));
	Исключение
		ДобавитьОшибкуТеста(Результаты, "token_journal");
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьФикстуры()

	Провайдер = Справочники.AI_Провайдеры.НайтиПоКоду("ATPROV001", Истина);
	Профиль = Справочники.AI_ПрофилиДоступаКДанным.НайтиПоКоду("ATPROF001", Истина);
	Агент = Справочники.AI_Агенты.НайтиПоКоду("ATAGENT01", Истина);
	Возврат Новый Структура("Провайдер,Профиль,Агент", Провайдер, Профиль, Агент);

КонецФункции

Функция НайтиМодель(Провайдер, Наименование)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Модели.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.AI_Модели КАК Модели
		|ГДЕ
		|	Модели.Владелец = &Провайдер
		|	И Модели.Наименование = &Наименование
		|	И НЕ Модели.ПометкаУдаления");
	Запрос.УстановитьПараметр("Провайдер", Провайдер);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.AI_Модели.ПустаяСсылка();

КонецФункции

Процедура ОбеспечитьВозможностиМодели(Провайдер, Модель)

	Запись = РегистрыСведений.AI_ВозможностиМоделей.СоздатьМенеджерЗаписи();
	Запись.Модель = Модель;
	Запись.Возможность = Перечисления.AI_ВозможностьМодели.ВводИзображений;
	Запись.ТипAPI = Перечисления.AI_ТипAPI.Responses;
	Запись.СпособПередачи = Перечисления.AI_СпособПередачиВложения.InlineBase64;
	Запись.MIMEТипы = "image/png,image/jpeg,image/webp";
	Запись.МаксимальныйРазмерБайт = 5242880;
	Запись.МаксимальноеКоличество = 5;
	Запись.Записать();

	Запись = РегистрыСведений.AI_ВозможностиМоделей.СоздатьМенеджерЗаписи();
	Запись.Модель = Модель;
	Запись.Возможность = Перечисления.AI_ВозможностьМодели.ВводФайлов;
	Запись.ТипAPI = Перечисления.AI_ТипAPI.Responses;
	Запись.СпособПередачи = Перечисления.AI_СпособПередачиВложения.FilesAPI;
	Запись.MIMEТипы = "text/plain,application/pdf";
	Запись.МаксимальныйРазмерБайт = 20971520;
	Запись.МаксимальноеКоличество = 5;
	Запись.Записать();

	ОбъектПровайдера = Провайдер.ПолучитьОбъект();
	ОбъектПровайдера.МодельАнализаВложений = Модель;
	ОбъектПровайдера.Записать();

КонецПроцедуры

Процедура Проверить(Условие, ТекстОшибки)

	Если Не Условие Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОшибкуТеста(Результаты, ИмяТеста)

	ДобавитьРезультат(
		Результаты,
		ИмяТеста,
		Ложь,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

КонецПроцедуры

Процедура ДобавитьРезультат(Результаты, ИмяТеста, Успешно, Детали)

	Результаты.Добавить(Новый Структура(
		"Имя,Успешно,Детали",
		ИмяТеста,
		Успешно,
		Строка(Детали)));

КонецПроцедуры

Функция СформироватьТекстРезультатов(Результаты)

	ВсеУспешно = Истина;
	Для Каждого Результат Из Результаты Цикл
		Если Не Результат.Успешно Тогда
			ВсеУспешно = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(?(ВсеУспешно, "OK", "ERROR"));
	Для Каждого Результат Из Результаты Цикл
		Детали = СтрЗаменить(Результат.Детали, Символы.ВК, " ");
		Детали = СтрЗаменить(Детали, Символы.ПС, " ");
		Детали = СтрЗаменить(Детали, "|", "/");
		Строки.Добавить(
			?(Результат.Успешно, "PASS", "FAIL")
				+ "|" + Результат.Имя
				+ "|" + Детали);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти
