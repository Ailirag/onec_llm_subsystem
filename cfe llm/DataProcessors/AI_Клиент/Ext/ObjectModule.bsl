#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИнициализироватьЗначенияСущностей()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ * Из Справочник.AI_Модели КАК AI_Модели ГДЕ AI_Модели.Ссылка = &Модель";
	
	Запрос.УстановитьПараметр("Модель", _Модель);
	
	ДанныеМодели = Запрос.Выполнить().Выгрузить()[0];
	_FolderID = ДанныеМодели.FolderID;
	Если _ДанныеПровайдера.Ссылка = Справочники.AI_Провайдеры.Yandex
		И ЗначениеЗаполнено(_FolderID)
		И Не СтрНачинаетсяС(НРег(_МодельСтрокой), "gpt://") Тогда
		_МодельСтрокой = СтрШаблон(
			"gpt://%1/%2/latest",
			_FolderID,
			_МодельСтрокой);
	КонецЕсли;
	
	Если Не _ДанныеПровайдера.Активен Тогда
		ВызватьИсключение СтрШаблон("Провайдер [%1] не активен. Работа завершена.", _Провайдер);
	КонецЕсли;
	
	Если Не Справочники.AI_Провайдеры.ТипПоддерживается(_ДанныеПровайдера, _ТипAPI) Тогда
		ВызватьИсключение СтрШаблон("Провайдер [%1]. Тип API [%2] не поддерживается. Работа завершена.", _Провайдер, _ТипAPI);
	КонецЕсли;
	
	_APIКлюч = _ДанныеПровайдера.APIКлюч;
	_БазовыйURL = _ДанныеПровайдера.АдресаСервисов[_ТипAPI];
	Если _Провайдер = Справочники.AI_Провайдеры.ZAI И Не ЗначениеЗаполнено(_БазовыйURL) Тогда
		_БазовыйURL = AI_ZAI.БазовыйURL();
	КонецЕсли;
	
КонецФункции

Процедура ПроверкаЗаполненияОтвета()
	
	Если Ответ = Неопределено Тогда
		ВызватьИсключение "Преобразование ответа невозможно. Ответ не инициализирован.";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЛогироватьЗапрос()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ Константы.AI_ЛогироватьЗапросы.Получить() = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ = Неопределено Тогда
		ВызватьИсключение "Ответ не инициализирован. Последовательность вызовов нарушена. Продолжение не возможно";
	КонецЕсли;
	
	ОтветСервиса = OPI_Инструменты.JSONСтрокой(Ответ);
	
	РегистрыСведений.AI_ЖурналЗапросов.ЛогироватьЗапрос(
		_Агент, _ИДЗапроса,
		_Провайдер, _Модель, _СистемныйПромт, _ТекстовыйЗапрос,
		ОтветСервиса, ВходящиеТокены, ВыходящиеТокены, ТулТокены);
	
КонецПроцедуры

Процедура ПолучитьИдентификаторДиалога()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не _РежимДиалога Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторДиалога = РегистрыСведений.AI_Диалоги.НачатьДиалог();
КонецПроцедуры

Процедура ЗаписатьСобытиеДиалога(Роль, Сообщение)
	
	Если Не _РежимДиалога Тогда
		Возврат;
	КонецЕсли;
	// Для Responses API диалог ведётся через previous_response_id — запись в AI_Диалоги не нужна
	Если _ТипAPI = Перечисления.AI_ТипAPI.Responses Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегистрыСведений.AI_Диалоги.ЗаписьСобытия(ИдентификаторДиалога, Роль, Сообщение);
КонецПроцедуры

Функция ПолучитьСобытияДиалога()
	УстановитьПривилегированныйРежим(Истина);
	Возврат РегистрыСведений.AI_Диалоги.ПолучитьСообщенияДиалога(ИдентификаторДиалога, _ГлубинаДиалога);
КонецФункции

Процедура ОбогатитьСообщенияИсторией(ПерваяИтерация, Сообщения)
	
	Если ПерваяИтерация Или Не _РежимДиалога Тогда
		Возврат;
	КонецЕсли;
	
	СообщенияИстории = ПолучитьСобытияДиалога();
	
	Для Каждого СообщениеИстории Из СообщенияИстории Цикл
		ДляДобавления = OPI_OpenAI.ПолучитьСтруктуруСообщения(
			СообщениеИстории.Роль,
			СообщениеИстории.Сообщение);
		Сообщения.Добавить(ДляДобавления);
	КонецЦикла;
	
КонецПроцедуры

Функция ИнициализироватьДополнительныеПараметрыИНавыки()
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("temperature", _Температура);
	
	Если _ТипAPI = Перечисления.AI_ТипAPI.Responses Тогда
		ДополнительныеПараметры.Вставить("max_output_tokens", _МаксТокенов);
	Иначе
		ДополнительныеПараметры.Вставить("max_tokens", _МаксТокенов);
	КонецЕсли;
	
	Если _Провайдер = Справочники.AI_Провайдеры.ZAI Тогда
		Если _АгентскийРежим И Не МодельZAIПоддерживаетАгентскийРежим() Тогда
			ВызватьИсключение СтрШаблон(
				"Модель Z.AI [%1] не поддерживает агентский режим.",
				_МодельСтрокой);
		КонецЕсли;
		Если МодельZAIПоддерживаетАгентскийРежим() Тогда
			ДополнительныеПараметры.Вставить(
				"thinking",
				Новый Структура(
					"type",
					?(_АгентскийРежим, "enabled", "disabled")));
		КонецЕсли;
	КонецЕсли;

	Если _НуженВебПоиск
			И Не _ТипAPI = Перечисления.AI_ТипAPI.Responses
			И Не _Провайдер = Справочники.AI_Провайдеры.ZAI Тогда
		ВызватьИсключение
			"Функция веб поиска работает только с Responses API или Z.AI Chat Completions.";
	КонецЕсли;
	
	Если _НуженВебПоиск Тогда
		
		Если НЕ ДополнительныеПараметры.Свойство("tools") Тогда
			ДополнительныеПараметры.Вставить("tools", Новый Массив);
		КонецЕсли;
		
		Если _Провайдер = Справочники.AI_Провайдеры.ZAI Тогда
			ПараметрыВебПоиска = Новый Структура("enable,search_result", Истина, Истина);
			Если ЗначениеЗаполнено(_РазмерОкнаКонтекстаВебПоиска) Тогда
				ПараметрыВебПоиска.Вставить(
					"content_size",
					_РазмерОкнаКонтекстаВебПоиска);
			КонецЕсли;
			Если ЗначениеЗаполнено(_URLАдреса) И _URLАдреса.Количество() > 0 Тогда
				ПараметрыВебПоиска.Вставить("search_domain_filter", _URLАдреса[0]);
			КонецЕсли;
			СтруктураФункции = Новый Структура(
				"type,web_search",
				"web_search",
				ПараметрыВебПоиска);
		Иначе
			СтруктураФункции = Новый Структура("type", "web_search");
		КонецЕсли;
		
		Если _Провайдер = Справочники.AI_Провайдеры.Yandex Тогда
			СтруктураФункции.Вставить("search_context_size", ?(ЗначениеЗаполнено(_РазмерОкнаКонтекстаВебПоиска), _РазмерОкнаКонтекстаВебПоиска, "medium"));
			// Принудительно устанавливаем необходимость поиска для Yandex провайдера
			ДополнительныеПараметры.Вставить("tool_choice", "required");
		КонецЕсли;
		
		Если Не _Провайдер = Справочники.AI_Провайдеры.ZAI
				И ЗначениеЗаполнено(_URLАдреса) Тогда
			СтруктураФункции.Вставить("filters", Новый Структура("allowed_domains", Новый Массив));
			
			Для Каждого Адрес Из _URLАдреса Цикл
				СтруктураФункции.filters.allowed_domains.Добавить(Адрес);
			КонецЦикла;
		КонецЕсли;
		
		ДополнительныеПараметры.tools.Добавить(СтруктураФункции);
		
	КонецЕсли;

	Если _АгентскийРежим Тогда
		Если Не ДополнительныеПараметры.Свойство("tools") Тогда
			ДополнительныеПараметры.Вставить("tools", Новый Массив);
		КонецЕсли;
		Для Каждого Инструмент Из AI_ИнструментыАгента.ПолучитьОписания(
				_ПрофильДоступаКДанным,
				_ТипAPI = Перечисления.AI_ТипAPI.Responses) Цикл
			ДополнительныеПараметры.tools.Добавить(Инструмент);
		КонецЦикла;
	КонецЕсли;
	
	Если _АгентскийРежим
			И ДополнительныеПараметры.Свойство("tools")
			И Не _Провайдер = Справочники.AI_Провайдеры.Yandex Тогда
		ДополнительныеПараметры.Вставить("tool_choice", "auto");
	КонецЕсли;

	Возврат ДополнительныеПараметры;
	
КонецФункции

Функция МодельZAIПоддерживаетАгентскийРежим()

	КодМодели = НРег(_МодельСтрокой);
	Возврат СтрНачинаетсяС(КодМодели, "glm-5")
		Или СтрНачинаетсяС(КодМодели, "glm-4.7")
		Или СтрНачинаетсяС(КодМодели, "glm-4.6")
		Или СтрНачинаетсяС(КодМодели, "glm-4.5");

КонецФункции

Функция ИнициализироватьМассивСообщений()
	
	СообщениеСистемы = OPI_OpenAI.ПолучитьСообщениеСистемы(_СистемныйПромт);
	СообщениеПользователя = OPI_OpenAI.ПолучитьСообщениеПользователя(_ТекстовыйЗапрос);
	
	ПерваяИтерация = Ложь;
	Если _РежимДиалога И Не ЗначениеЗаполнено(ИдентификаторДиалога) Тогда
		ПолучитьИдентификаторДиалога();
		ЗаписатьСобытиеДиалога(СообщениеСистемы.role, СообщениеСистемы.content);
		ПерваяИтерация = Истина;
	КонецЕсли;
	
	Сообщения = Новый Массив;
	Сообщения.Добавить(СообщениеСистемы);
	Сообщения.Добавить(СообщениеПользователя);
	
	ОбогатитьСообщенияИсторией(ПерваяИтерация, Сообщения);
	ОбогатитьСообщенияДополнительнымКонтекстом(Сообщения);
	
	Возврат Сообщения;
	
КонецФункции

Процедура ОбогатитьСообщенияДополнительнымКонтекстом(Сообщения)
	
	Для Каждого Контекст Из _ДополнительныйКонтекст Цикл
		ТекстСообщения = СтрШаблон("--%1--%2%3--end_context--",
			"context:" + Контекст.Наименование + " \\ " + Контекст.ИдентификаторДляЛогики,
			Символы.ПС,
			Контекст.ДанныеКонтекста);
		СтруктураСообщения = OPI_OpenAI.ПолучитьСтруктуруСообщения("user", ТекстСообщения);
		Сообщения.Добавить(СтруктураСообщения);
	КонецЦикла;
	
КонецПроцедуры

// ОбработатьВекторныйЗапрос
// Для каждого компонента RAG из _ДанныеRAG:
//   1. Получает embedding запроса через AI_RAG.ПолучитьВектор
//   2. Ищет похожие фрагменты в каждой коллекции через AI_RAG.ПоискПохожихВQdrant
//   3. Взвешивает результаты по ВесКоллекции
//   4. Возвращает массив фрагментов, отсортированных по score убыванию
//
// Возвращаемое значение:
//   Массив Из Структура — { score, text, header, subheader, nav_ref, chunk_num, chunks_total, entity_type }
//   Пустой массив если RAG не настроен или не нашёл ничего выше порога.
Функция ОбработатьВекторныйЗапрос()
	
	ВсеФрагменты = Новый Массив;
	
	Если _ДанныеRAG = Неопределено Или _ДанныеRAG.Количество() = 0 Тогда
		Возврат ВсеФрагменты;
	КонецЕсли;
	
	Для Каждого КомпонентRAG Из _ДанныеRAG Цикл
		
		Если Не КомпонентRAG.Активен Тогда
			Продолжить;
		КонецЕсли;
		
		// Получаем вектор запроса — один раз на компонент (один embedding-сервис)
		Попытка
			ВекторЗапроса = AI_RAG.ПолучитьВектор(КомпонентRAG, _ТекстовыйЗапрос);
		Исключение
			
			ТекстОшибки = СтрШаблон("Ошибка получения вектора [%1]: %2", КомпонентRAG.Наименование, ОписаниеОшибки());
			
			ЗаписьЖурналаРегистрации(
				"AI_Клиент.RAG",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ТекстОшибки);
				
			ВызватьИсключение ТекстОшибки;
				
		КонецПопытки;
		
		// Поиск по каждой коллекции компонента
		Для Каждого Коллекция Из КомпонентRAG.МассивКоллекций Цикл
			
			Попытка
				ФильтрПоАгенту = AI_RAG.ПостроитьФильтрПоАгенту(_Агент);
				РезультатыПоиска = AI_RAG.ПоискПохожихВQdrant(
					КомпонентRAG,
					Коллекция.ИмяКоллекции,
					ВекторЗапроса,
					Коллекция.ЛимитФрагментовQdrant,
					Коллекция.МинПорогСхожестиВектора,
					ФильтрПоАгенту);
			Исключение
					
				ТекстОшибки = СтрШаблон("Ошибка поиска в коллекции [%1]: %2", Коллекция.ИмяКоллекции, ОписаниеОшибки());
					
				ЗаписьЖурналаРегистрации(
					"AI_Клиент.RAG",
					УровеньЖурналаРегистрации.Ошибка,
					,
					,
					ТекстОшибки);
					
				ВызватьИсключение ТекстОшибки;
					
			КонецПопытки;
			
			// Применяем вес коллекции к score каждого фрагмента и нормализуем payload
			Для Каждого Точка Из РезультатыПоиска Цикл
				
				Payload = Точка["payload"];
				Если Не ЗначениеЗаполнено(Payload) Тогда
					Продолжить;
				КонецЕсли;
				
				Фрагмент = Новый Структура;
				Фрагмент.Вставить("score",        Точка["score"] * Коллекция.ВесКоллекции);
				Фрагмент.Вставить("text",         ?(Payload.Свойство("text"),         Payload["text"],         ""));
				Фрагмент.Вставить("header",       ?(Payload.Свойство("header"),       Payload["header"],       ""));
				Фрагмент.Вставить("subheader",    ?(Payload.Свойство("subheader"),    Payload["subheader"],    ""));
				Фрагмент.Вставить("nav_ref",      ?(Payload.Свойство("nav_ref"),      Payload["nav_ref"],      ""));
				Фрагмент.Вставить("entity_type",  ?(Payload.Свойство("entity_type"),  Payload["entity_type"],  ""));
				Фрагмент.Вставить("chunk_num",    ?(Payload.Свойство("chunk_num"),    Payload["chunk_num"],    0));
				Фрагмент.Вставить("chunks_total", ?(Payload.Свойство("chunks_total"), Payload["chunks_total"], 1));
				
				ВсеФрагменты.Добавить(Фрагмент);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Сортировка по score убыванию (пузырьком — массивы обычно небольшие)
	Если ВсеФрагменты.Количество() > 1 Тогда
		ВсеФрагменты = СортироватьФрагментыПоScore(ВсеФрагменты);
	КонецЕсли;
	
	Возврат ВсеФрагменты;
	
КонецФункции

// ОтсортироватьФрагментыПоScore
// Сортировка пузырьком — массивы фрагментов обычно небольшие (< 50 элементов).
Функция ОтсортироватьФрагментыПоScore(МассивФрагментов)

	Н = МассивФрагментов.ВГраница();

	Пока Н > 0 Цикл
		Для Индекс = 0 По Н - 1 Цикл
			Если МассивФрагментов[Индекс]["score"] < МассивФрагментов[Индекс + 1]["score"] Тогда
				Временный              = МассивФрагментов[Индекс];
				МассивФрагментов[Индекс]    = МассивФрагментов[Индекс + 1];
				МассивФрагментов[Индекс + 1] = Временный;
			КонецЕсли;
		КонецЦикла;
		Н = Н - 1;
	КонецЦикла;

	Возврат МассивФрагментов;

КонецФункции

// ОбогатитьСообщенияRAG
// Формирует одно системное сообщение из найденных фрагментов и добавляет
// его в массив сообщений перед запросом пользователя.
//
// Формат блока для LLM:
//   --RAG_CONTEXT--
//   ### Контрагент: ООО Ромашка (чанк 1/1)
//   Наименование: ООО Ромашка
//   ИНН: 7700000001
//   ...
//   --END_RAG_CONTEXT--
//
// Параметры:
//   Сообщения        - Массив - массив сообщений для LLM (изменяется)
//   МассивФрагментов - Массив - результат ОбработатьВекторныйЗапрос()
Процедура ОбогатитьСообщенияRAG(Сообщения, МассивФрагментов)

	Если Не ЗначениеЗаполнено(МассивФрагментов) Или МассивФрагментов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЧастиТекста = Новый Массив;
	ЧастиТекста.Добавить("--RAG_CONTEXT--");

	Для Каждого Фрагмент Из МассивФрагментов Цикл

		// Заголовок блока — собираем из header / subheader / чанк-инфо
		Заголовок = Фрагмент["header"];
		Если ЗначениеЗаполнено(Фрагмент["subheader"]) Тогда
			Заголовок = Заголовок + " / " + Фрагмент["subheader"];
		КонецЕсли;

		ВсегоЧанков = Фрагмент["chunks_total"];
		Если ВсегоЧанков > 1 Тогда
			Заголовок = СтрШаблон("%1 (чанк %2/%3)",
				Заголовок, Фрагмент["chunk_num"], ВсегоЧанков);
		КонецЕсли;

		ЧастиТекста.Добавить("### " + Заголовок);
		ЧастиТекста.Добавить(Фрагмент["text"]);

		// Навигационная ссылка — полезна если LLM должен ссылаться на источник
		Если ЗначениеЗаполнено(Фрагмент["nav_ref"]) Тогда
			ЧастиТекста.Добавить("[источник: " + Фрагмент["nav_ref"] + "]");
		КонецЕсли;

		ЧастиТекста.Добавить(""); // пустая строка-разделитель между фрагментами

	КонецЦикла;

	ЧастиТекста.Добавить("--END_RAG_CONTEXT--");

	ТекстRAG = СтрСоединить(ЧастиТекста, Символы.ПС);

	// Вставляем как сообщение от пользователя перед фактическим запросом —
	// это стандартная техника RAG для ChatCompletions API.
	// Позиция: после системного промта (индекс 0), перед запросом пользователя.
	СообщениеRAG = OPI_OpenAI.ПолучитьСтруктуруСообщения("user", ТекстRAG);
	Сообщения.Вставить(Сообщения.Количество() - 1, СообщениеRAG);

КонецПроцедуры

// ──────────────────────────────────────────────────────────────────────────────
// Основные методы отправки запросов
// ──────────────────────────────────────────────────────────────────────────────

// СпроситьChatCompletions
// Реализует запрос через /v1/chat/completions.
// Диалог ведётся путём передачи истории сообщений (из AI_Диалоги).
Процедура СпроситьChatCompletions()
	
	Сообщения = ИнициализироватьМассивСообщенийChatCompletions();
	
	ДополнительныеПараметры = ИнициализироватьДополнительныеПараметрыИНавыки();
	
	МассивФрагментовRAG = ОбработатьВекторныйЗапрос();
	ОбогатитьСообщенияRAG(Сообщения, МассивФрагментовRAG);
	
	Если _АгентскийРежим Тогда
		ВыполнитьАгентскийЦиклChatCompletions(Сообщения, ДополнительныеПараметры);
	Иначе
		Ответ = ОтправитьChatCompletions(Сообщения, ДополнительныеПараметры);
	КонецЕсли;
	
	Если ОтветСодержитОшибкуAPI(Ответ) Тогда
		ОшибкаОбработки = ПредставлениеОшибкиAPI(Ответ);
		ИзвлеченныйОтвет = ОшибкаОбработки;
		Возврат;
	КонецЕсли;

	Если Не _АгентскийРежим Тогда
		УчестьТокеныChatCompletions(Ответ);
	КонецЕсли;
	
	Попытка
		ИзвлечьОтвет();
		ЗаписатьСобытиеДиалога(Перечисления.AI_РольСообщения.user, _ТекстовыйЗапрос);
		ЗаписатьСобытиеДиалога(Перечисления.AI_РольСообщения.assistant, ИзвлеченныйОтвет);
		ЛогироватьЗапрос();
	Исключение
		ОшибкаОбработки = ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

Функция ОтправитьChatCompletions(Знач Сообщения, Знач ДополнительныеПараметры)

	Если _Провайдер = Справочники.AI_Провайдеры.ZAI Тогда
		Возврат AI_ZAI.ПолучитьОтвет(
			_БазовыйURL,
			_APIКлюч,
			_МодельСтрокой,
			Сообщения,
			ДополнительныеПараметры);
	ИначеЕсли _Провайдер = Справочники.AI_Провайдеры.LMStudio Тогда
		Возврат AI_LMStudio.ПолучитьОтветВКонтексте(
			_БазовыйURL,
			_МодельСтрокой,
			Сообщения,
			ДополнительныеПараметры);
	КонецЕсли;
	Возврат OPI_OpenAI.ПолучитьОтвет(
		_БазовыйURL,
		_APIКлюч,
		_МодельСтрокой,
		Сообщения,
		ДополнительныеПараметры);

КонецФункции

Процедура ВыполнитьАгентскийЦиклChatCompletions(Знач Сообщения, Знач ДополнительныеПараметры)

	Политика = AI_ПолитикиАгента.Получить(_ПрофильДоступаКДанным);
	Состояние = НовоеСостояниеАгента();
	ВходящиеТокены = 0;
	ВыходящиеТокены = 0;
	ТулТокены = 0;
	ШагиАгента = Новый Массив;

	Сообщения[0]["content"] = Сообщения[0]["content"]
		+ AI_ИнструментыАгента.ИнструкцияДляМодели(_ПрофильДоступаКДанным);

	Для НомерШага = 1 По Политика.МаксимумШагов Цикл
		Состояние.НомерШага = НомерШага;
		Если ОтменаАгентскойОперацииЗапрошена() Тогда
			Ответ = ОтветСОшибкой("Операция отменена пользователем.");
			Возврат;
		КонецЕсли;
		ЗафиксироватьЭтапАгентскойОперации(
			СтрШаблон("Обращение к модели, шаг %1", НомерШага));
		Ответ = ОтправитьChatCompletions(Сообщения, ДополнительныеПараметры);
		Если ОтменаАгентскойОперацииЗапрошена() Тогда
			Ответ = ОтветСОшибкой("Операция отменена пользователем.");
			Возврат;
		КонецЕсли;
		Если ОтветСодержитОшибкуAPI(Ответ) Тогда
			Возврат;
		КонецЕсли;
		УчестьТокеныChatCompletions(Ответ);

		ВызовыИнструментов = ПолучитьВызовыИнструментовChatCompletions(Ответ);
		Если ВызовыИнструментов.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;

		СообщениеМодели = Ответ["choices"][0]["message"];
		Сообщения.Добавить(СообщениеМодели);
		Для Каждого ВызовИнструмента Из ВызовыИнструментов Цикл
			РезультатИнструмента = ВыполнитьВызовИнструментаChatCompletions(
				ВызовИнструмента,
				Состояние);
			СообщениеИнструмента = Новый Структура;
			СообщениеИнструмента.Вставить("role", "tool");
			СообщениеИнструмента.Вставить("tool_call_id", ВызовИнструмента["id"]);
			СообщениеИнструмента.Вставить(
				"content",
				OPI_Инструменты.JSONСтрокой(РезультатИнструмента));
			Сообщения.Добавить(СообщениеИнструмента);
		КонецЦикла;
	КонецЦикла;

	Ответ = ОтветСОшибкой("Агент не завершил работу за лимит шагов профиля.");

КонецПроцедуры

Функция ПолучитьВызовыИнструментовChatCompletions(Знач ОтветМодели)

	Результат = Новый Массив;
	Попытка
		Сообщение = ОтветМодели["choices"][0]["message"];
		Вызовы = Сообщение["tool_calls"];
		Если Вызовы <> Неопределено Тогда
			Для Каждого Вызов Из Вызовы Цикл
				Если Вызов["type"] = "function" Тогда
					Результат.Добавить(Вызов);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ВыполнитьВызовИнструментаChatCompletions(Знач ВызовИнструмента, Знач Состояние)

	ИмяИнструмента = "Неизвестный инструмент";
	Аргументы = Новый Структура;
	Попытка
		ИмяИнструмента = ВызовИнструмента["function"]["name"];
		Аргументы = ВызовИнструмента["function"]["arguments"];
		Если ТипЗнч(Аргументы) = Тип("Строка") Тогда
			Если ЗначениеЗаполнено(Аргументы) Тогда
				Аргументы = OPI_Инструменты.JsonВСтруктуру(Аргументы, Истина);
			Иначе
				Аргументы = Новый Структура;
			КонецЕсли;
		КонецЕсли;
	Исключение
		РезультатОшибки = Новый Структура(
			"ok,error",
			Ложь,
			"Некорректные аргументы tool call: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ДобавитьШагАгента(Состояние, ИмяИнструмента, Аргументы, РезультатОшибки, 0);
		Возврат РезультатОшибки;
	КонецПопытки;

	Возврат ВыполнитьИнструментСТрассировкой(
		ИмяИнструмента,
		Аргументы,
		Состояние);

КонецФункции

Процедура УчестьТокеныChatCompletions(Знач ОтветМодели)

	Попытка
		ВходящиеТокены = ВходящиеТокены + ОтветМодели["usage"]["prompt_tokens"];
		ВыходящиеТокены = ВыходящиеТокены + ОтветМодели["usage"]["completion_tokens"];
	Исключение
	КонецПопытки;

КонецПроцедуры

// СпроситьResponses
// Реализует запрос через /v1/responses.
// 
// ДИАЛОГ в Responses API:
//   Нативный механизм — передача previous_response_id. Сервер сам хранит контекст.
//   Это освобождает от необходимости передавать историю сообщениями.
//   При первом запросе в сессии _ПредыдущийIDОтвета пустой — передаём только входящее.
//   После каждого ответа сохраняем id ответа для следующего запроса.
//
// РАЗЛИЧИЯ Yandex vs OpenAI Responses:
//   - Yandex: инструмент веб-поиска: {"type":"web_search","search_context_size":"medium"}, tool_choice: "required"
//   - OpenAI: инструмент веб-поиска: {"type":"web_search_preview"}, tool_choice не требуется
//   - Yandex: структура ответа такая же как OpenAI Responses (output[].content[].text)
//   - Токены: Yandex возвращает usage.input_tokens / output_tokens,
//             OpenAI Responses возвращает usage.input_tokens / output_tokens
//
// RAG в Responses API:
//   RAG-контекст вставляется в системный промт (а не как отдельное сообщение),
//   поскольку в Responses API при наличии previous_response_id сообщения
//   пользователя — только новый ввод, без истории.
Процедура СпроситьResponses()
	
	ДополнительныеПараметры = ИнициализироватьДополнительныеПараметрыИНавыки();
	МассивФрагментовRAG = ОбработатьВекторныйЗапрос();
	
	// В Responses API RAG-контекст передаём через системный промт (instructions),
	// а не отдельным сообщением, т.к. при previous_response_id история не передаётся
	СистемныйПромтСRAG = СобратьСистемныйПромтСRAG(МассивФрагментовRAG);
	Если _АгентскийРежим Тогда
		СистемныйПромтСRAG = СистемныйПромтСRAG
			+ AI_ИнструментыАгента.ИнструкцияДляМодели(_ПрофильДоступаКДанным);
	КонецЕсли;
	
	Сообщения = ИнициализироватьМассивСообщенийResponses(СистемныйПромтСRAG);
	
	// При диалоге передаём previous_response_id вместо истории сообщений
	Если _РежимДиалога И ЗначениеЗаполнено(_ПредыдущийIDОтвета) Тогда
		ДополнительныеПараметры.Вставить("previous_response_id", _ПредыдущийIDОтвета);
	КонецЕсли;
	
	ДопЗаголовки = Новый Соответствие;
	
	Если _Провайдер = Справочники.AI_Провайдеры.Yandex Тогда
		ДопЗаголовки.Вставить("x-project", _FolderID);
	КонецЕсли;
	
	Если _АгентскийРежим Тогда
		ВыполнитьАгентскийЦиклResponses(Сообщения, ДополнительныеПараметры, ДопЗаголовки);
	Иначе
		Ответ = OPI_OpenAI.ПолучитьОтветResponses(
			_БазовыйURL,
			_APIКлюч,
			_МодельСтрокой,
			Сообщения,
			ДополнительныеПараметры,
			ДопЗаголовки);
	КонецЕсли;
	
	Если ОтветСодержитОшибкуAPI(Ответ) Тогда
		ОшибкаОбработки = ПредставлениеОшибкиAPI(Ответ);
		ИзвлеченныйОтвет = ОшибкаОбработки;
		Возврат;
	КонецЕсли;

	Если Не _АгентскийРежим Тогда
		УчестьТокеныResponses(Ответ);
	КонецЕсли;
	
	Попытка
		ИзвлечьОтветResponses();
		
		// Сохраняем ID ответа для следующего шага диалога
		IDОтвета = Ответ["id"];
		Если ЗначениеЗаполнено(IDОтвета) Тогда
			_ПредыдущийIDОтвета = IDОтвета;
		КонецЕсли;
		
		// Для совместимости с UI песочницы сохраняем и в ИдентификаторДиалога
		Если _РежимДиалога И Не ЗначениеЗаполнено(ИдентификаторДиалога) Тогда
			ИдентификаторДиалога = _ПредыдущийIDОтвета;
		КонецЕсли;
		
		ЛогироватьЗапрос();
	Исключение
		ОшибкаОбработки = ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

Процедура ВыполнитьАгентскийЦиклResponses(Знач Вход, Знач ДополнительныеПараметры, Знач ДопЗаголовки)

	Политика = AI_ПолитикиАгента.Получить(_ПрофильДоступаКДанным);
	Состояние = НовоеСостояниеАгента();
	ВходящиеТокены = 0;
	ВыходящиеТокены = 0;
	ТулТокены = 0;
	ШагиАгента = Новый Массив;

	Для НомерШага = 1 По Политика.МаксимумШагов Цикл
		Состояние.НомерШага = НомерШага;
		Если ОтменаАгентскойОперацииЗапрошена() Тогда
			Ответ = ОтветСОшибкой("Операция отменена пользователем.");
			Возврат;
		КонецЕсли;
		ЗафиксироватьЭтапАгентскойОперации(
			СтрШаблон("Обращение к модели, шаг %1", НомерШага));
		ДополнительныеПараметры.Вставить(
			"tool_choice",
			?(НомерШага = 1, "required", "auto"));
		Ответ = OPI_OpenAI.ПолучитьОтветResponses(
			_БазовыйURL,
			_APIКлюч,
			_МодельСтрокой,
			Вход,
			ДополнительныеПараметры,
			ДопЗаголовки);
		Если ОтменаАгентскойОперацииЗапрошена() Тогда
			Ответ = ОтветСОшибкой("Операция отменена пользователем.");
			Возврат;
		КонецЕсли;
		Если ОтветСодержитОшибкуAPI(Ответ) Тогда
			Возврат;
		КонецЕсли;
		УчестьТокеныResponses(Ответ);

		ВызовыИнструментов = ПолучитьВызовыИнструментовResponses(Ответ);
		Если ВызовыИнструментов.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;

		IDОтвета = Ответ["id"];
		Если Не ЗначениеЗаполнено(IDОтвета) Тогда
			Ответ = ОтветСОшибкой("Responses API не вернул id для продолжения tool call.");
			Возврат;
		КонецЕсли;
		ДополнительныеПараметры.Вставить("previous_response_id", IDОтвета);
		Вход = Новый Массив;
		Для Каждого ВызовИнструмента Из ВызовыИнструментов Цикл
			РезультатИнструмента = ВыполнитьВызовИнструментаResponses(
				ВызовИнструмента,
				Состояние);
			РезультатВызова = Новый Структура;
			РезультатВызова.Вставить("type", "function_call_output");
			РезультатВызова.Вставить("call_id", ВызовИнструмента["call_id"]);
			РезультатВызова.Вставить(
				"output",
				OPI_Инструменты.JSONСтрокой(РезультатИнструмента));
			Вход.Добавить(РезультатВызова);
		КонецЦикла;
	КонецЦикла;

	Ответ = ОтветСОшибкой("Агент не завершил работу за лимит шагов профиля.");

КонецПроцедуры

Функция ПолучитьВызовыИнструментовResponses(Знач ОтветМодели)

	Результат = Новый Массив;
	Попытка
		Для Каждого Элемент Из ОтветМодели["output"] Цикл
			Если Элемент["type"] = "function_call" Тогда
				Результат.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Результат;

