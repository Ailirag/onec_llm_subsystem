
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ApiКлюч = ТекущийОбъект.ApiКлюч.Получить();
	Если Не ЗначениеЗаполнено(ТекущийОбъект.ТипПровайдера) Тогда
		ТекущийОбъект.ТипПровайдера =
			Справочники.AI_Провайдеры.ПолучитьТипПровайдера(
				ТекущийОбъект.Ссылка);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьНастройкиZAI();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Справочники.AI_Провайдеры.ЗаполнитьНастройкиПоУмолчанию(ТекущийОбъект);
	ТекущийОбъект.APIКлюч = Новый ХранилищеЗначения(ApiКлюч);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ЗагрузитьМодели(Команда)

	Записать();
	ПараметрыФормы = Новый Структура("Провайдер", Объект.Ссылка);
	ОткрытьФорму(
		"Справочник.AI_Провайдеры.Форма.ВыборМоделей",
		ПараметрыФормы,
		ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНастройкиZAI()

	Справочники.AI_Провайдеры.ЗаполнитьНастройкиПоУмолчанию(Объект);

КонецПроцедуры

#КонецОбласти
