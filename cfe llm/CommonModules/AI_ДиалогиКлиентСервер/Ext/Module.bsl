Функция ПолучитьМоиДиалоги(СтрокаПоиска = "", ПоказыватьАрхивные = Ложь, Лимит = 50) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ИдентификаторПользователя = ИдентификаторТекущегоПользователя();
	AI_ДиалогиСервер.МигрироватьДиалогиПользователя(ИдентификаторПользователя);
	Результат = AI_ДиалогиСервер.ПолучитьДиалоги(
		ИдентификаторПользователя,
		СтрокаПоиска,
		ПоказыватьАрхивные,
		Лимит);
	Возврат Результат;

