// Состав стандартного интерфейса OData на стенде.
//
// Публикация OData на стендах комплекта включена (standardOdata в default.vrd),
// но по умолчанию состав интерфейса пуст, и сервис не отдаёт ни одной сущности.
// Комплект вызывает ОпубликоватьВсё через COM при установке исполнителя, если
// в манифесте standExec.odata не выключен.
//
// Публикуются все объекты, которые принимает УстановитьСоставСтандартногоИнтерфейсаOData,
// включая добавленные расширениями: коллекции Метаданные в сеансе видят их.
// Это стенд, и выбирать, что показывать тестам и сиду, незачем.
//
// Вызов меняет настройку базы, а не данные: подписок на запись он не вызывает и
// во внешнем соединении безопасен.

#Область ПрограммныйИнтерфейс

// Публикует в OData все объекты метаданных допустимых видов.
//
// Возвращаемое значение:
//  Число - количество опубликованных объектов.
//
Функция ОпубликоватьВсё() Экспорт

	Объекты = Новый Массив;
	Для Каждого Коллекция Из КоллекцииМетаданных() Цикл
		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			Объекты.Добавить(ОбъектМетаданных);
		КонецЦикла;
	КонецЦикла;

	УстановитьПривилегированныйРежим(Истина);
	УстановитьСоставСтандартногоИнтерфейсаOData(Объекты);
	Возврат Объекты.Количество();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Виды объектов, допустимые для стандартного интерфейса OData (справка
// платформы, УстановитьСоставСтандартногоИнтерфейсаOData).
Функция КоллекцииМетаданных()

	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.Справочники);
	Коллекции.Добавить(Метаданные.Документы);
	Коллекции.Добавить(Метаданные.ПланыОбмена);
	Коллекции.Добавить(Метаданные.ПланыСчетов);
	Коллекции.Добавить(Метаданные.ПланыВидовРасчета);
	Коллекции.Добавить(Метаданные.ПланыВидовХарактеристик);
	Коллекции.Добавить(Метаданные.РегистрыБухгалтерии);
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.РегистрыРасчета);
	Коллекции.Добавить(Метаданные.РегистрыНакопления);
	Коллекции.Добавить(Метаданные.ЖурналыДокументов);
	Коллекции.Добавить(Метаданные.Перечисления);
	Коллекции.Добавить(Метаданные.Задачи);
	Коллекции.Добавить(Метаданные.БизнесПроцессы);
	Коллекции.Добавить(Метаданные.Константы);
	Возврат Коллекции;

КонецФункции

#КонецОбласти
