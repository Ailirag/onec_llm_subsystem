// Демонстрационный обработчик действия подсистемы LLM.
//
// Показывает весь контракт вида действия «Внешний обработчик»:
//   СведенияОДействияхLLM — самоописание: какие методы обработка предлагает
//                           и какие параметры ждет. Из него настройщик
//                           получает список выбора метода;
//   ВыполнитьДействие     — одношаговое действие;
//   СоздатьСвязанныйОбъект — многошаговое: спрашивает подтверждение и
//                           продолжает после ответа;
//   СоздатьПослеЗаписи     — многошаговое с ожиданием записи: продолжает
//                           только тогда, когда объект появился в базе;
//   ПроверитьДоступность  — проверка сложных условий кодом.
//
// Обновлять конфигурацию для всего этого не нужно — достаточно
// зарегистрировать обработку. Регистрация через БСП нужна только как реестр:
// права, версия, безопасный режим и администрирование. Вызывает обработку
// само ядро подсистемы.

#Область ПрограммныйИнтерфейс

// Контракт БСП: без него обработку не зарегистрировать.
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "AI-действие: демонстрация");
	ПараметрыРегистрации.Вставить("Версия", "1.3.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить(
		"Информация",
		"Обработчик действия подсистемы LLM. Запускается не из меню БСП,"
		+ " а ядром подсистемы по виду действия «Внешний обработчик».");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	ПараметрыРегистрации.Вставить("Команды", Команды);

	Возврат ПараметрыРегистрации;

КонецФункции

// Самоописание для настройки места запуска.
//
// Перечислить экспортные методы обработки платформенными средствами нельзя:
// метаданные не хранят состав модуля, рефлексии над BSL нет. Поэтому обработка
// описывает себя сама — подсистема заполнит из этого список выбора метода.
// Функция необязательная: без нее настройщику останутся стандартные имена
// и ручной ввод.
Функция СведенияОДействияхLLM() Экспорт

	Методы = Новый ТаблицаЗначений;
	Методы.Колонки.Добавить("Метод", Новый ОписаниеТипов("Строка"));
	Методы.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Методы.Колонки.Добавить("Назначение", Новый ОписаниеТипов("Строка"));
	Методы.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	Методы.Колонки.Добавить("Параметры", Новый ОписаниеТипов("Строка"));

	Строка = Методы.Добавить();
	Строка.Метод = "ВыполнитьДействие";
	Строка.Представление = "Показать сводку по плану";
	Строка.Назначение = "Действие";
	Строка.Описание = "Одношаговое действие: сообщает, что пришло в плане.";

	Строка = Методы.Добавить();
	Строка.Метод = "СоздатьСвязанныйОбъект";
	Строка.Представление = "Создать связанный объект (с подтверждением)";
	Строка.Назначение = "Действие";
	Строка.Описание = "Многошаговое действие: спрашивает подтверждение,"
		+ " затем отчитывается о выполнении.";
	Строка.Параметры = "ВидСвязанного — что создавать (строка).";

	Строка = Методы.Добавить();
	Строка.Метод = "СоздатьПослеЗаписи";
	Строка.Представление = "Создать связанный объект (после записи)";
	Строка.Назначение = "Действие";
	Строка.Описание = "Многошаговое действие: ждет, пока человек запишет объект,"
		+ " и продолжает с настоящей ссылкой.";
	Строка.Параметры = "ВидСвязанного — что создавать (строка).";

	Строка = Методы.Добавить();
	Строка.Метод = "СверитьИПредложитьДругое";
	Строка.Представление = "Сверить и предложить другое действие";
	Строка.Назначение = "Действие";
	Строка.Описание = "Заканчивается предложением продолжить другим местом запуска.";
	Строка.Параметры = "СледующееДействие — наименование места запуска (строка).";

	Строка = Методы.Добавить();
	Строка.Метод = "ПроверитьДоступность";
	Строка.Представление = "Проверка доступности";
	Строка.Назначение = "Проверка";
	Строка.Описание = "Запрещает действие, если в плане нет пригодных значений.";
	Строка.Параметры = "МинимумЗначений — сколько пригодных строк требуется (число).";

	Возврат Методы;

КонецФункции

// Одношаговое действие.
Процедура ВыполнитьДействие(Параметры) Экспорт

	Ссылка = AI_ИзвлечениеРеквизитов.ПолучитьОбъектПоКонтексту(Параметры.Контекст);
	Если Ссылка = Неопределено Тогда
		Параметры.Сообщения.Добавить("Объект контекста не определен.");
		Параметры.Обработано = Истина;
		Возврат;
	КонецЕсли;

	Сводка = СводкаПоПлану(Параметры.План);
	Параметры.Сообщения.Добавить(СтрШаблон(
		"Обработчик получил объект «%1» и пригодных значений: %2 (%3).",
		Строка(Ссылка),
		Сводка.Количество,
		?(ЗначениеЗаполнено(Сводка.Перечень), Сводка.Перечень, "нет")));
	Параметры.Количество = Сводка.Количество;
	Параметры.Обработано = Истина;

КонецПроцедуры

// Многошаговое действие: спрашивает подтверждение и продолжает после ответа.
Процедура СоздатьСвязанныйОбъект(Параметры) Экспорт

	Сводка = СводкаПоПлану(Параметры.План);

	Если Параметры.Шаг = 1 Тогда
		Вид = "объект";
		Если Параметры.Дополнительные.Свойство("ВидСвязанного") Тогда
			Вид = Строка(Параметры.Дополнительные.ВидСвязанного);
		КонецЕсли;
		Параметры.Продолжение = Новый Структура(
			"ВидУточнения,Представление,Подсказка,Обязательное",
			"Вопрос",
			"Подтверждение",
			СтрШаблон("Создать %1 по %2 распознанным значениям?", Вид, Сводка.Количество),
			Истина);
		// Состояние переживет шаг: ядро вернет его следующим вызовом.
		Параметры.Состояние = Новый Структура("Вид,Количество", Вид, Сводка.Количество);
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Параметры.ОтветПользователя) <> Тип("Структура")
		Или Параметры.ОтветПользователя.Значение <> Истина Тогда
		Параметры.Сообщения.Добавить("Создание отменено пользователем.");
		Параметры.Обработано = Истина;
		Возврат;
	КонецЕсли;

	Вид = "объект";
	Количество = Сводка.Количество;
	Если ТипЗнч(Параметры.Состояние) = Тип("Структура") Тогда
		Параметры.Состояние.Свойство("Вид", Вид);
		Параметры.Состояние.Свойство("Количество", Количество);
	КонецЕсли;

	// Здесь прикладное решение создавало бы свой документ штатным способом.
	// Демонстрация ограничивается отчетом: подсистема не знает, что и как
	// создавать в конкретной конфигурации.
	Параметры.Сообщения.Добавить(СтрШаблон(
		"Подтверждено. Создание «%1» по %2 значениям выполнил бы прикладной код.",
		Вид,
		Количество));
	Параметры.Количество = Количество;
	Параметры.Обработано = Истина;

КонецПроцедуры

// Многошаговое действие, которому нужна ссылка на объект.
//
// Показывает единственный правильный порядок для связывания: сначала объект
// оказывается в базе, потом появляется связь. До записи ссылки у нового
// объекта нет вовсе, а выданная авансом ссылка оставит висящую связь, если
// человек закроет карточку без записи.
Процедура СоздатьПослеЗаписи(Параметры) Экспорт

	Вид = "объект";
	Если Параметры.Дополнительные.Свойство("ВидСвязанного") Тогда
		Вид = Строка(Параметры.Дополнительные.ВидСвязанного);
	КонецЕсли;

	Если Параметры.Шаг = 1 Тогда
		// Ядро вернет этот шаг помощнику, помощник отпустит форму объекта и
		// дождется записи. Вопроса пользователю здесь нет: ответом служит сам
		// факт записи.
		Параметры.Продолжение = Новый Структура(
			"ВидУточнения,Представление,Подсказка",
			"ОжиданиеЗаписи",
			"Запись объекта",
			СтрШаблон("Запишите документ — после записи создам %1.", Вид));
		Параметры.Состояние = Новый Структура("Вид", Вид);
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Параметры.Состояние) = Тип("Структура") Тогда
		Параметры.Состояние.Свойство("Вид", Вид);
	КонецЕсли;

	Ссылка = AI_ИзвлечениеРеквизитов.ПолучитьОбъектПоКонтексту(Параметры.Контекст);
	Если Ссылка = Неопределено Тогда
		// Ожидание прервано: помощник не получил записанного объекта. Действие
		// не выполнено, и делать вид, что выполнено, нельзя.
		Параметры.Сообщения.Добавить(
			"Объект так и не появился в базе — связывать нечего.");
		Возврат;
	КонецЕсли;

	Сводка = СводкаПоПлану(Параметры.План);
	// Здесь прикладное решение создавало бы свой документ и ставило в него
	// ссылку на записанный объект. Демонстрация ограничивается отчетом.
	Параметры.Сообщения.Добавить(СтрШаблон(
		"Объект «%1» записан, ссылка есть: прикладной код создал бы %2 по %3 значениям.",
		Строка(Ссылка),
		Вид,
		Сводка.Количество));
	Параметры.Количество = Сводка.Количество;
	Параметры.Обработано = Истина;

КонецПроцедуры

// Действие, которое заканчивается предложением другого действия.
//
// Так выглядит настоящая цепочка: проверка нашла несоответствие, и дальше
// нужен другой сценарий. Запускать его молча нельзя — он стоит токенов и
// меняет другой объект, поэтому обработчик только предлагает.
Процедура СверитьИПредложитьДругое(Параметры) Экспорт

	Сводка = СводкаПоПлану(Параметры.План);
	Параметры.Сообщения.Добавить(СтрШаблон(
		"Сверка выполнена, пригодных значений: %1.", Сводка.Количество));

	Следующее = "";
	Если Параметры.Дополнительные.Свойство("СледующееДействие") Тогда
		Следующее = СокрЛП(Строка(Параметры.Дополнительные.СледующееДействие));
	КонецЕсли;

	Если ЗначениеЗаполнено(Следующее) Тогда
		Параметры.СледующееДействие = Новый Структура("МестоЗапуска,Причина",
			Следующее,
			"Реквизиты относятся к другому основному документу:"
				+ " его тоже нужно разобрать.");
	КонецЕсли;

	Параметры.Количество = Сводка.Количество;
	Параметры.Обработано = Истина;

КонецПроцедуры

// Проверка сложных условий кодом.
Процедура ПроверитьДоступность(Параметры) Экспорт

	Минимум = 1;
	Если Параметры.Дополнительные.Свойство("МинимумЗначений") Тогда
		Минимум = Число(Параметры.Дополнительные.МинимумЗначений);
	КонецЕсли;

	Если Параметры.ЭтапПроверки = "ВыборДействия" Тогда
		// На этапе выбора плана еще нет — ограничений не накладываем.
		Возврат;
	КонецЕсли;

	Сводка = СводкаПоПлану(Параметры.План);
	Если Сводка.Количество < Минимум Тогда
		Параметры.Доступно = Ложь;
		Параметры.Причина = СтрШаблон(
			"Нужно не менее %1 распознанных значений, а есть %2.",
			Минимум,
			Сводка.Количество);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СводкаПоПлану(План)

	Результат = Новый Структура("Количество,Перечень", 0, "");
	Если План = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого СтрокаПлана Из План Цикл
		Если Не СтрокаПлана.Применимо Тогда
			Продолжить;
		КонецЕсли;
		Результат.Количество = Результат.Количество + 1;
		Результат.Перечень = Результат.Перечень
			+ ?(ЗначениеЗаполнено(Результат.Перечень), ", ", "")
			+ СтрокаПлана.Представление;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
