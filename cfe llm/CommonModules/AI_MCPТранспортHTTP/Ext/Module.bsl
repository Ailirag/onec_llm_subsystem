
Функция ВыполнитьJSONRPC(
		Знач Настройки,
		Знач Сообщение,
		Знач Сессия = Неопределено,
		Знач ВозвращатьОшибкиHTTP = Ложь) Экспорт

	ПроверитьEndpoint(Настройки);
	Заголовки = СформироватьЗаголовки(Настройки, Сессия, Сообщение);
	Таймаут = Макс(1, ПолучитьСвойство(Настройки, "ТаймаутСекунд", 60));

	HTTPКлиент = OPI_ЗапросыHTTP.НовыйЗапрос()
		.Инициализировать(Настройки.Endpoint)
		.УстановитьТаймаут(Таймаут)
		.МаксимумПопыток(0)
		.МаксимумПереадресаций(0)
		.УстановитьЗаголовки(Заголовки)
		.УстановитьJsonТело(Сообщение)
		.ОбработатьЗапрос("POST");
	ОтветHTTP = HTTPКлиент.ВернутьОтвет(Ложь, Истина);

	КодСостояния = ОтветHTTP.КодСостояния;
	ПроверитьРазмерПоЗаголовку(ОтветHTTP.Заголовки, Настройки);
	Тело = ПолучитьТелоОтвета(ОтветHTTP);
	ПроверитьРазмерОтвета(Тело, Настройки);
	Если КодСостояния >= 400 И Не ВозвращатьОшибкиHTTP Тогда
		ВызватьИсключение СтрШаблон(
			"MCP-сервер вернул HTTP %1: %2",
			КодСостояния,
			Лев(Тело, 2000));
	КонецЕсли;

	ТипКонтента = ПолучитьЗаголовок(ОтветHTTP.Заголовки, "Content-Type");
	JSON = Неопределено;
	Если ЗначениеЗаполнено(Тело) Тогда
		Попытка
			Если СтрНайти(НРег(ТипКонтента), "text/event-stream") > 0 Тогда
				JSON = РазобратьSSE(Тело, ПолучитьСвойство(Сообщение, "id", Неопределено));
			Иначе
				JSON = OPI_Инструменты.JsonВСтруктуру(Тело, Истина);
			КонецЕсли;
		Исключение
			Если КодСостояния < 400 Или Не ВозвращатьОшибкиHTTP Тогда
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура(
		"КодСостояния,Заголовки,Тело,JSON,ИдентификаторСессии,ТипКонтента",
		КодСостояния,
		ОтветHTTP.Заголовки,
		Тело,
		JSON,
		ПолучитьЗаголовок(ОтветHTTP.Заголовки, "MCP-Session-Id"),
		ТипКонтента);

КонецФункции

Процедура ЗавершитьСессию(Знач Настройки, Знач Сессия) Экспорт

	Если Сессия = Неопределено
		Или Не ЗначениеЗаполнено(ПолучитьСвойство(Сессия, "Идентификатор", "")) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		HTTPКлиент = OPI_ЗапросыHTTP.НовыйЗапрос()
			.Инициализировать(Настройки.Endpoint)
			.УстановитьТаймаут(Макс(1, ПолучитьСвойство(Настройки, "ТаймаутСекунд", 60)))
			.МаксимумПопыток(0)
			.МаксимумПереадресаций(0)
			.УстановитьЗаголовки(СформироватьЗаголовки(Настройки, Сессия))
			.ОбработатьЗапрос("DELETE");
		ОтветHTTP = HTTPКлиент.ВернутьОтвет(Ложь, Истина);
		Если ОтветHTTP.КодСостояния >= 400 И ОтветHTTP.КодСостояния <> 405 Тогда
			ВызватьИсключение СтрШаблон("HTTP %1", ОтветHTTP.КодСостояния);
		КонецЕсли;
	Исключение
		// Завершение удаленной сессии не должно маскировать результат инструмента.
		ЗаписьЖурналаРегистрации(
			"AI.MCP",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция СформироватьЗаголовки(
		Знач Настройки,
		Знач Сессия = Неопределено,
		Знач Сообщение = Неопределено)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json, text/event-stream");
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("User-Agent", "1C-LLM-MCP/1.0");

	Версия = "";
	Если Сессия <> Неопределено Тогда
		Версия = ПолучитьСвойство(Сессия, "ВерсияПротокола", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(Версия) Тогда
		Заголовки.Вставить("MCP-Protocol-Version", Версия);
	КонецЕсли;
	ИдентификаторСессии = "";
	Если Сессия <> Неопределено Тогда
		ИдентификаторСессии = ПолучитьСвойство(Сессия, "Идентификатор", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдентификаторСессии) Тогда
		Заголовки.Вставить("MCP-Session-Id", ИдентификаторСессии);
	КонецЕсли;
	Если ЗначениеЗаполнено(Версия)
		И СтрНачинаетсяС(Версия, "2026-")
		И Сообщение <> Неопределено Тогда
		Метод = ПолучитьСвойство(Сообщение, "method", "");
		Если ЗначениеЗаполнено(Метод) Тогда
			Заголовки.Вставить("Mcp-Method", Метод);
		КонецЕсли;
		Если Метод = "tools/call" Тогда
			Параметры = ПолучитьСвойство(Сообщение, "params", Новый Структура);
			ИмяИнструмента = ПолучитьСвойство(Параметры, "name", "");
			Если ЗначениеЗаполнено(ИмяИнструмента) Тогда
				Заголовки.Вставить("Mcp-Name", ИмяИнструмента);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ТипАвторизации = ПолучитьСвойство(
		Настройки,
		"ТипАвторизации",
		Перечисления.AI_ТипАвторизацииMCP.Нет);
	Если ТипАвторизации = Перечисления.AI_ТипАвторизацииMCP.Нет Тогда
		Возврат Заголовки;
	КонецЕсли;

	Секрет = ПолучитьСвойство(Настройки, "Секрет", "");
	Если Не ЗначениеЗаполнено(Секрет) Тогда
		ВызватьИсключение "Для MCP-сервера не заполнен секрет авторизации.";
	КонецЕсли;
	ПроверитьЗначениеЗаголовка(Секрет);
	Если ТипАвторизации = Перечисления.AI_ТипАвторизацииMCP.Bearer Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Секрет);
	ИначеЕсли ТипАвторизации = Перечисления.AI_ТипАвторизацииMCP.Basic Тогда
		Заголовки.Вставить(
			"Authorization",
			"Basic " + Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Секрет)));
	ИначеЕсли ТипАвторизации = Перечисления.AI_ТипАвторизацииMCP.ПроизвольныйЗаголовок Тогда
		ИмяЗаголовка = СокрЛП(Строка(ПолучитьСвойство(Настройки, "ИмяЗаголовкаАвторизации", "")));
		ПроверитьИмяЗаголовкаАвторизации(ИмяЗаголовка);
		Заголовки.Вставить(ИмяЗаголовка, Секрет);
	КонецЕсли;
	Возврат Заголовки;

КонецФункции

Процедура ПроверитьЗначениеЗаголовка(Знач ЗначениеЗаголовка)

	Если СтрНайти(ЗначениеЗаголовка, Символы.ВК) > 0
		Или СтрНайти(ЗначениеЗаголовка, Символы.ПС) > 0 Тогда
		ВызватьИсключение "Секрет MCP содержит недопустимый перевод строки.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИмяЗаголовкаАвторизации(Знач ИмяЗаголовка)

	Если Не ЗначениеЗаполнено(ИмяЗаголовка) Тогда
		ВызватьИсключение "Не заполнено имя заголовка авторизации MCP.";
	КонецЕсли;
	ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!#$%&'*+-.^_`|~";
	Для Индекс = 1 По СтрДлина(ИмяЗаголовка) Цикл
		Если СтрНайти(ДопустимыеСимволы, Сред(ИмяЗаголовка, Индекс, 1)) = 0 Тогда
			ВызватьИсключение "Имя заголовка авторизации MCP содержит недопустимые символы.";
		КонецЕсли;
	КонецЦикла;
	СлужебныеЗаголовки = ",accept,content-type,host,mcp-session-id,mcp-protocol-version,origin,";
	Если СтрНайти(СлужебныеЗаголовки, "," + НРег(ИмяЗаголовка) + ",") > 0 Тогда
		ВызватьИсключение "Нельзя использовать служебный заголовок MCP для авторизации: " + ИмяЗаголовка;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьEndpoint(Знач Настройки)

	ИсходныйEndpoint = СокрЛП(Строка(ПолучитьСвойство(Настройки, "Endpoint", "")));
	Endpoint = НРег(ИсходныйEndpoint);
	Если Не ЗначениеЗаполнено(Endpoint) Тогда
		ВызватьИсключение "Не заполнен endpoint MCP-сервера.";
	КонецЕсли;
	Если Не СтрНачинаетсяС(Endpoint, "https://") Тогда
		Если Не СтрНачинаетсяС(Endpoint, "http://") Тогда
			ВызватьИсключение "Endpoint MCP должен использовать HTTP или HTTPS.";
		КонецЕсли;
		Если Не ПолучитьСвойство(Настройки, "РазрешитьНезащищенныйHTTP", Ложь) Тогда
			ВызватьИсключение "Незащищенный HTTP для MCP-сервера запрещен настройкой.";
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(ИсходныйEndpoint, "#") > 0 Тогда
		ВызватьИсключение "Endpoint MCP не должен содержать фрагмент URL.";
	КонецЕсли;
	НачалоАдреса = СтрНайти(ИсходныйEndpoint, "://") + 3;
	ОстатокАдреса = Сред(ИсходныйEndpoint, НачалоАдреса);
	ОкончаниеАдреса = СтрДлина(ОстатокАдреса) + 1;
	ПозицияПути = СтрНайти(ОстатокАдреса, "/");
	ПозицияПараметров = СтрНайти(ОстатокАдреса, "?");
	Если ПозицияПути > 0 Тогда
		ОкончаниеАдреса = Мин(ОкончаниеАдреса, ПозицияПути);
	КонецЕсли;
	Если ПозицияПараметров > 0 Тогда
		ОкончаниеАдреса = Мин(ОкончаниеАдреса, ПозицияПараметров);
	КонецЕсли;
	АдресСервера = Лев(ОстатокАдреса, ОкончаниеАдреса - 1);
	Если Не ЗначениеЗаполнено(АдресСервера) Тогда
		ВызватьИсключение "Endpoint MCP не содержит адрес сервера.";
	КонецЕсли;
	Если СтрНайти(АдресСервера, "@") > 0 Тогда
		ВызватьИсключение "Учетные данные запрещено включать в URL MCP-сервера.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРазмерПоЗаголовку(Знач Заголовки, Знач Настройки)

	Лимит = ПолучитьСвойство(Настройки, "МаксимальныйРазмерОтветаБайт", 0);
	Если Лимит <= 0 Тогда
		Возврат;
	КонецЕсли;
	ЗначениеРазмера = ПолучитьЗаголовок(Заголовки, "Content-Length");
	Если Не ЗначениеЗаполнено(ЗначениеРазмера) Тогда
		Возврат;
	КонецЕсли;
	Размер = Число(ЗначениеРазмера);
	Если Размер > Лимит Тогда
		ВызватьИсключение СтрШаблон(
			"Ответ MCP-сервера превышает установленный лимит: %1 из %2 байт.",
			Размер,
			Лимит);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРазмерОтвета(Знач Тело, Знач Настройки)

	Лимит = ПолучитьСвойство(Настройки, "МаксимальныйРазмерОтветаБайт", 0);
	Если Лимит <= 0 Или Не ЗначениеЗаполнено(Тело) Тогда
		Возврат;
	КонецЕсли;
	Размер = ПолучитьДвоичныеДанныеИзСтроки(Тело).Размер();
	Если Размер > Лимит Тогда
		ВызватьИсключение СтрШаблон(
			"Ответ MCP-сервера превышает установленный лимит: %1 из %2 байт.",
			Размер,
			Лимит);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьТелоОтвета(Знач ОтветHTTP)

	Возврат ОтветHTTP.ПолучитьТелоКакСтроку();

КонецФункции

Функция РазобратьSSE(Знач Тело, Знач ОжидаемыйID)

	НормализованныйТекст = СтрЗаменить(Тело, Символы.ВК + Символы.ПС, Символы.ПС);
	НормализованныйТекст = СтрЗаменить(НормализованныйТекст, Символы.ВК, Символы.ПС);
	Для Каждого Событие Из СтрРазделить(
			НормализованныйТекст,
			Символы.ПС + Символы.ПС,
			Ложь) Цикл
		СтрокиДанных = Новый Массив;
		Для Каждого СтрокаСобытия Из СтрРазделить(Событие, Символы.ПС, Ложь) Цикл
			Если СтрНачинаетсяС(СтрокаСобытия, "data:") Тогда
				СтрокиДанных.Добавить(СокрЛП(Сред(СтрокаСобытия, 6)));
			КонецЕсли;
		КонецЦикла;
		Если СтрокиДанных.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Данные = СтрСоединить(СтрокиДанных, Символы.ПС);
		Попытка
			JSON = OPI_Инструменты.JsonВСтруктуру(Данные, Истина);
			ID = ПолучитьСвойство(JSON, "id", Неопределено);
			Если ОжидаемыйID = Неопределено Или Строка(ID) = Строка(ОжидаемыйID) Тогда
				Возврат JSON;
			КонецЕсли;
		Исключение
			// Служебные SSE-события без JSON-RPC пропускаются.
			JSON = Неопределено;
		КонецПопытки;
	КонецЦикла;
	ВызватьИсключение "SSE-ответ MCP не содержит ожидаемого JSON-RPC сообщения.";

КонецФункции

Функция ПолучитьЗаголовок(Знач Заголовки, Знач Имя)

	Для Каждого Заголовок Из Заголовки Цикл
		Если НРег(Строка(Заголовок.Ключ)) = НРег(Имя) Тогда
			Возврат Строка(Заголовок.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ПолучитьСвойство(Знач Источник, Знач Имя, Знач ПоУмолчанию)

	Если Источник = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Источник) = Тип("Структура")
		Или ТипЗнч(Источник) = Тип("ФиксированнаяСтруктура") Тогда
		Значение = Неопределено;
		Если Источник.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Источник) = Тип("Соответствие")
		Или ТипЗнч(Источник) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Источник.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции
