// Мастер помощника: действие -> уточнения -> рекомендации.
//
// Уточнения описаны декларативно в ТЧ Уточнения места запуска. Форма не знает,
// что именно уточняется: она идет по строкам ТЧ подряд и для каждой рисует
// страницу по виду уточнения. Шаг уточнения целиком пропускается, если строк нет.
//
// Анализ выполняется фоновой агентской операцией, форма опрашивает ее и
// показывает разобранные по карте рекомендации. В базу помощник не пишет
// ничего: подтвержденные значения он переносит в форму прикладного объекта,
// а записывает их человек обычной командой «Записать».

#Область ОписаниеПеременных

// Число шагов уточнения у выбранного действия. Держим на клиенте, чтобы
// перерисовка кнопок не ходила на сервер за одним числом.
&НаКлиенте
Перем ВсегоУточненийКэш;

// Вид действия выбранного места запуска, строкой: клиенту нужен он только
// для заголовка и видимости кнопки, настоящая проверка идет на сервере.
&НаКлиенте
Перем ВидДействияКлиент;

// Момент запуска обращения к модели — для счетчика ожидания.
&НаКлиенте
Перем НачалоОжидания;

// Состояние многошагового обработчика между шагами. Держим на клиенте, потому
// что шагами управляет клиентский цикл; требование к состоянию одно — оно
// должно переноситься между клиентом и сервером.
&НаКлиенте
Перем СостояниеДействияКлиент;

// Ждем ли сейчас, пока человек запишет объект. Обработчик вправе попросить
// такой шаг: связать что-либо с новым объектом до записи нельзя — ссылки у
// него еще нет, а выдать ее авансом значит оставить висящую связь, если
// человек передумает записывать.
&НаКлиенте
Перем ОжиданиеЗаписиАктивно;

// Момент начала ожидания записи — для счетчика и потолка ожидания.
&НаКлиенте
Перем НачалоОжиданияЗаписи;

// Идет ли разбор пачки объектов. Массовый режим — это N операций в очереди,
// по одной на объект: ответ модели по пачке применить построчно нельзя.
&НаКлиенте
Перем ПакетныйРежимКлиент;

// Подпись кнопки действия из настройки места запуска. Пустая означает
// «назови сам по виду действия»: для типовых видов подпись очевидна, а для
// прикладного действия «Выполнить действие» не говорит человеку ничего.
&НаКлиенте
Перем ЗаголовокДействияКлиент;

// Пройденные звенья цепочки действий: сюда попадает каждое место запуска,
// которым уже продолжали. Нужен, чтобы цепочка не зациклилась и не ушла в
// бесконечную глубину — предложение приходит от прикладного кода, а он ошибается.
&НаКлиенте
Перем ЦепочкаДействийКлиент;

// Действие начинается с разговора: модель уточняет у человека, что нужно,
// а результат по карте формируется по его команде.
&НаКлиенте
Перем РежимДиалогаКлиент;

// Что создает вид «Создать объект» — для подписи кнопки и вопроса перед
// созданием: «Создать шаблон согласования» понятнее «Выполнить действие».
&НаКлиенте
Перем ПредставлениеСозданияКлиент;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектыНазначения = Неопределено;
	Параметры.Свойство("ОбъектыНазначения", ОбъектыНазначения);
	ТипМестаИзПараметров = "Объект";
	Параметры.Свойство("ТипМеста", ТипМестаИзПараметров);

	Контекст = AI_ИнтерфейсныеСценарии.СформироватьКонтекст(
		ОбъектыНазначения,
		ТипМестаИзПараметров);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Контекст);
	КонтекстПредставление = Контекст.ПредставлениеИсточника;

	ПрочитатьСписокДействий();
	ВыбратьДействиеИзПараметров();

	// Перенос настройки между базами — административное действие, и кнопки
	// пакета видны только тому, кто вправе его выполнить. Настоящая проверка
	// права живет в AI_ПакетыСценариев, здесь только видимость.
	ПакетыДоступны = AI_ПакетыСценариев.ПакетыДоступны();
	Элементы.ВыгрузитьПакет.Видимость = ПакетыДоступны;
	Элементы.ЗагрузитьПакет.Видимость = ПакетыДоступны;

	// Обработка для БСП, инструкция по настройке, запрос к модели и технические
	// колонки разбора нужны тому, кто настраивает действия. Пользователю они
	// ничего не говорят, а запрос к модели он вдобавок мог бы испортить.
	Настройщик = ПравоДоступа("Изменение", Метаданные.Справочники.AI_МестаЗапускаСценариев);
	Элементы.СохранитьОбработкуБСП.Видимость = Настройщик;
	Элементы.СохранитьИнструкцию.Видимость = Настройщик;
	Элементы.НачальныйЗапросВыбранного.Видимость = Настройщик;
	Элементы.ЗначениеМодели.Видимость = Настройщик;
	Элементы.ПутьРеквизита.Видимость = Настройщик;

	НастроитьТаблицыРезультата();

	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДействия;

КонецПроцедуры

// Колонки, которых нет в макете формы: текущее значение реквизита рядом с
// предложенным и файл, взятый по каждому объекту пачки. Человек должен видеть,
// что именно заменит результат и из какого файла он получен.
&НаСервере
Процедура НастроитьТаблицыРезультата()

	ТипСтроки = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500));
	Добавляемые = Новый Массив;
	Добавляемые.Добавить(Новый РеквизитФормы("ТекущееЗначение", ТипСтроки, "Рекомендации", "Сейчас"));
	Добавляемые.Добавить(Новый РеквизитФормы("Изменится", Новый ОписаниеТипов("Булево"), "Рекомендации"));
	Добавляемые.Добавить(Новый РеквизитФормы("Файл", ТипСтроки, "Пакет", "Файл"));
	ИзменитьРеквизиты(Добавляемые);

	КолонкаСейчас = Элементы.Добавить("ТекущееЗначение", Тип("ПолеФормы"), Элементы.Рекомендации);
	КолонкаСейчас.ПутьКДанным = "Рекомендации.ТекущееЗначение";
	КолонкаСейчас.Вид = ВидПоляФормы.ПолеВвода;
	КолонкаСейчас.ТолькоПросмотр = Истина;
	Элементы.Переместить(КолонкаСейчас, Элементы.Рекомендации, Элементы.ЗначениеСтрокой);

	// Причина — сразу за значением: за правым краем таблицы ее не видно.
	// «Распознано» дублирует отметку «Применить» и причину в комментарии.
	Элементы.Переместить(Элементы.Комментарий, Элементы.Рекомендации, Элементы.Распознано);
	Элементы.Распознано.Видимость = Ложь;

	КолонкаФайла = Элементы.Добавить("ПакетФайл", Тип("ПолеФормы"), Элементы.Пакет);
	КолонкаФайла.ПутьКДанным = "Пакет.Файл";
	КолонкаФайла.Вид = ВидПоляФормы.ПолеВвода;
	КолонкаФайла.ТолькоПросмотр = Истина;
	Элементы.Переместить(КолонкаФайла, Элементы.Пакет, Элементы.ПакетСостояние);

	// Ширины по смыслу: иначе колонки растягиваются по длине реквизитов в
	// пятьсот символов, и предложенное значение уезжает за правый край.
	Элементы.РекомендацияПредставление.Ширина = 24;
	КолонкаСейчас.Ширина = 18;
	Элементы.ЗначениеСтрокой.Ширина = 24;
	Элементы.Комментарий.Ширина = 24;
	Элементы.ЗначениеМодели.Ширина = 16;
	Элементы.ПутьРеквизита.Ширина = 16;
	КолонкаФайла.Ширина = 24;

	// Итог анализа бывает в две строки: обрезанный статус прячет подсказку,
	// какую кнопку нажать дальше.
	Элементы.СтатусОперации.МногострочныйРежим = Истина;
	Элементы.СтатусОперации.Высота = 2;
	Элементы.СтатусОперации.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	Элементы.ПояснениеПакета.РастягиватьПоГоризонтали = Истина;
	Элементы.ПояснениеПакета.АвтоМаксимальнаяШирина = Ложь;
	// Разговор — главное на своей странице: в поле автоматической ширины
	// ответ модели ложится узкой колонкой в треть окна.
	Для Каждого ИмяЭлемента Из СтрРазделить("ПояснениеДиалога,ИсторияДиалога,СообщениеДиалога,СтатусДиалога", ",") Цикл
		Элементы[ИмяЭлемента].РастягиватьПоГоризонтали = Истина;
		Элементы[ИмяЭлемента].АвтоМаксимальнаяШирина = Ложь;
	КонецЦикла;
	Элементы.ИсторияДиалога.Высота = 16;

	// Что поменяется в объекте — жирным, нераспознанное — серым: глаз сразу
	// находит строки, которые стоит проверить.
	Оформление = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(Оформление, "ЗначениеСтрокой");
	ДобавитьОтборОформления(Оформление, "Рекомендации.Изменится", Истина);
	Оформление.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));

	Оформление = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(Оформление, "РекомендацияПредставление");
	ДобавитьПолеОформления(Оформление, "ТекущееЗначение");
	ДобавитьПолеОформления(Оформление, "ЗначениеСтрокой");
	ДобавитьПолеОформления(Оформление, "Комментарий");
	ДобавитьОтборОформления(Оформление, "Рекомендации.Распознано", Ложь);
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);

КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеОформления(Оформление, ИмяЭлемента)
	Поле = Оформление.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
КонецПроцедуры

&НаСервере
Процедура ДобавитьОтборОформления(Оформление, Путь, Значение)
	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Путь);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Значение;
КонецПроцедуры

&НаСервере
Процедура ПрочитатьСписокДействий()

	Контекст = КонтекстФормы();
	ТаблицаСценариев = AI_ИнтерфейсныеСценарии.ПолучитьДоступныеСценарии(Контекст);
	ЗначениеВРеквизитФормы(ТаблицаСценариев, "Сценарии");
	Если ТаблицаСценариев.Количество() = 0 Тогда
		КонтекстПредставление = ПредставлениеКонтекста()
			+ ". Нет доступных действий для этого места запуска.";
	Иначе
		КонтекстПредставление = ПредставлениеКонтекста();
	КонецЕсли;

КонецПроцедуры

// Отдельная кнопка в карточке открывает помощник сразу на своем действии:
// параметр «МестоЗапуска» — ссылка или наименование. Действие берется только
// из списка доступных — кнопка не обходит ни агента, ни видимость, ни отборы.
&НаСервере
Процедура ВыбратьДействиеИзПараметров()

	Место = Неопределено;
	Если Не Параметры.Свойство("МестоЗапуска", Место) Или Не ЗначениеЗаполнено(Место) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Место) = Тип("Строка") Тогда
		Место = Справочники.AI_МестаЗапускаСценариев.НайтиПоНаименованию(СокрЛП(Место), Истина);
	КонецЕсли;
	Строки = Сценарии.НайтиСтроки(Новый Структура("МестоЗапуска", Место));
	Если Строки.Количество() = 0 Тогда
		КонтекстПредставление = ПредставлениеКонтекста()
			+ ". Действие, на которое вела кнопка, здесь недоступно.";
		Возврат;
	КонецЕсли;
	Элементы.Сценарии.ТекущаяСтрока = Строки[0].ПолучитьИдентификатор();
	АвтозапускДействия = Истина;

КонецПроцедуры

// «Выбрано объектов: 2» не говорит, какие именно объекты уйдут в пачку.
// Первые несколько называем прямо, остальные — числом.
&НаСервере
Функция ПредставлениеКонтекста()

	Если КоличествоОбъектов <= 1 Тогда
		Возврат ПредставлениеИсточника;
	КонецЕсли;

	Имена = Новый Массив;
	Попытка
		Контексты = AI_ИнтерфейсныеСценарии.КонтекстыОбъектов(КонтекстФормы());
	Исключение
		Возврат ПредставлениеИсточника;
	КонецПопытки;
	Для Каждого КонтекстОбъекта Из Контексты Цикл
		Если Имена.Количество() = 3 Тогда
			Прервать;
		КонецЕсли;
		Имена.Добавить(КонтекстОбъекта.ПредставлениеИсточника);
	КонецЦикла;

	Текст = ПредставлениеИсточника + ": " + СтрСоединить(Имена, "; ");
	Если КоличествоОбъектов > Имена.Количество() Тогда
		Текст = Текст + СтрШаблон(" и еще %1", КоличествоОбъектов - Имена.Количество());
	КонецЕсли;
	Возврат Лев(Текст, 500);

КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьОписаниеВыбранного();
	ОбновитьСостояниеИнтерфейса();
	Если ОперацияВыполняется Тогда
		ПодключитьОпросОперации();
	КонецЕсли;
	Если АвтозапускДействия Тогда
		// Запуск — после открытия: вопросы и разговор показываются уже в окне.
		АвтозапускДействия = Ложь;
		ПодключитьОбработчикОжидания("ЗапуститьДействиеИзПараметров", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьДействиеИзПараметров() Экспорт

	НачатьСценарий();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	ОтключитьОпросОперации();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СценарииПриАктивизацииСтроки(Элемент)
	ОбновитьОписаниеВыбранного();
КонецПроцедуры

&НаКлиенте
Процедура СценарииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДалееОбработка(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ВариантыУточненияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДалееОбработка(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДалееОбработка(Команда)

	Если ОперацияВыполняется Тогда
		Возврат;
	КонецЕсли;

	Если Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДействия Тогда
		НачатьСценарий();
	ИначеЕсли Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаУточнение Тогда
		// Страница уточнения обслуживает два разных цикла: уточнения перед
		// запуском модели и шаги, которые запросил обработчик действия.
		Если ЗначениеЗаполнено(ВидПродолжения) Тогда
			ПродолжитьДействие();
		Иначе
			ПродолжитьУточнения();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НазадОбработка(Команда)

	// Из результата по одному объекту возвращаемся к списку пакета, а не к
	// выбору действия: пакет еще не разобран.
	Если Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат
		И ПакетныйРежимКлиент = Истина
		И Пакет.Количество() > 0 Тогда
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаПакет;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецЕсли;

	// Итог разговора не устроил — возвращаемся к разговору: переписка на месте,
	// можно поправить модель словами и сформировать результат заново.
	Если Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат
		И ЗначениеЗаполнено(ЭтапДиалога) Тогда
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДиалог;
		ЭтапДиалога = "Разговор";
		СтатусОперации = "Скажите модели, что поправить, и сформируйте результат снова.";
		ОбновитьСостояниеИнтерфейса();
		ПоказатьКонецИстории();
		Возврат;
	КонецЕсли;
	ЭтапДиалога = "";

	Если Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаУточнение
		И ИндексУточнения > 1 Тогда
		// Возвращаемся на предыдущее уточнение, а не к списку действий.
		УдалитьСобранноеУточнение(ИндексУточнения);
		ИндексУточнения = ИндексУточнения - 1;
		УдалитьСобранноеУточнение(ИндексУточнения);
		Если ПоказатьУточнение(ИндексУточнения) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДействия;
	ИндексУточнения = 0;
	// Действие больше не выбрано — заголовок окна возвращается к общему.
	ЗаголовокДействияКлиент = "";
	СброситьЗаголовокОкна();
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаСервере
Процедура СброситьЗаголовокОкна()

	УстановитьЗаголовокОкна("");

КонецПроцедуры

// Действие выполняется только по явной команде пользователя и только по
// отмеченным строкам. Что именно произойдет, задано видом действия на месте
// запуска: заполнение формы, запись объекта или прикладное действие.
&НаКлиенте
Процедура ПрименитьРекомендацииОбработка(Команда)

	Если Не ЗначениеЗаполнено(ЗаголовокДействия()) Тогда
		Сообщить("Для этого действия применение результата не настроено.");
		Возврат;
	КонецЕсли;
	Если ВидДействияКлиент = "ЗаполнитьФорму" И ФормаОбъекта() = Неопределено Тогда
		Сообщить("Помощник открыт без формы объекта — заполнять нечего."
			+ " Откройте карточку объекта и вызовите помощника из нее.");
		Возврат;
	КонецЕсли;

	Отобрано = 0;
	Для Каждого СтрокаТаблицы Из Рекомендации Цикл
		Если СтрокаТаблицы.Применить Тогда
			Отобрано = Отобрано + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отобрано = 0 Тогда
		Сообщить("Отметьте строки, к которым нужно применить действие.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПрименитьРекомендацииЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстПодтверждения(Отобрано), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьРекомендацииЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ШагДействия = 1;
	ВыполнитьШагДействия(Неопределено);

КонецПроцедуры

// Один шаг действия. Обработчик вправе не закончить, а попросить уточнение —
// тогда мастер показывает шаг и возвращается сюда с ответом пользователя.
&НаКлиенте
Процедура ВыполнитьШагДействия(ОтветПользователя)

	// Потолок шагов: кривой обработчик не должен зацикливать пользователя.
	Если ШагДействия > 20 Тогда
		СтатусОперации = "Действие превысило допустимое число шагов и остановлено.";
		Возврат;
	КонецЕсли;

	Действие = ВыполнитьДействиеНаСервере(ОтветПользователя, СостояниеДействияКлиент);
	СостояниеДействияКлиент = Действие.Состояние;
	Для Каждого Сообщение Из Действие.Сообщения Цикл
		Сообщить(Сообщение);
	КонецЦикла;
	Если ЗначениеЗаполнено(Действие.Ошибка) Тогда
		СтатусОперации = Действие.Ошибка;
		ЗавершитьДействие();
		Возврат;
	КонецЕсли;

	Если Действие.ЕстьПродолжение Тогда
		ШагДействия = ШагДействия + 1;
		ПоказатьПродолжениеДействия(Действие);
		Возврат;
	КонецЕсли;

	ЗавершитьДействие();

	Если ВидДействияКлиент = "ЗаполнитьФорму" Тогда
		СтатусОперации = ЗаполнитьФормуОбъекта(Действие.План);
		ПредложитьПродолжениеЦепочки(Действие);
		Возврат;
	КонецЕсли;

	// Созданный объект сразу открываем: человек проверит его в привычной
	// форме, а списки, где он должен появиться, узнают о нем оповещением.
	Если Действие.СозданныйОбъект <> Неопределено Тогда
		СтатусОперации = СтрШаблон("Создан «%1». Заполнено значений: %2, отклонено: %3.",
			Действие.ПредставлениеСозданного,
			Действие.Обработано,
			Действие.Отклонено);
		ОповеститьОбИзменении(Действие.СозданныйОбъект);
		ПоказатьЗначение(, Действие.СозданныйОбъект);
		ПредложитьПродолжениеЦепочки(Действие);
		Возврат;
	КонецЕсли;

	СтатусОперации = СтрШаблон("Применено: %1, отклонено: %2.",
		Действие.Обработано,
		Действие.Отклонено);
	Если Действие.Обработано > 0 Тогда
		Оповестить("Запись_" + ПолноеИмяМетаданных, КлючИсточника);
	КонецЕсли;

	ПредложитьПродолжениеЦепочки(Действие);

КонецПроцедуры

// Одно действие естественно ведет к другому: проверка нашла несоответствие —
// значит, нужно другое действие. Цепочку предлагает прикладной код, а решает
// человек: молча запускать следующий сценарий и тратить его токены нельзя.
&НаКлиенте
Процедура ПредложитьПродолжениеЦепочки(Действие)

	Если Действие.СледующееМесто = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЦепочкаДействийКлиент = Неопределено Тогда
		ЦепочкаДействийКлиент = Новый Массив;
	КонецЕсли;

	// Потолок глубины и защита от петли. Оба случая — ошибка прикладного кода,
	// но расплачивается за нее пользователь, поэтому цепочка обрывается здесь.
	Если ЦепочкаДействийКлиент.Количество() >= 5 Тогда
		Сообщить("Цепочка действий уже прошла пять звеньев и остановлена.");
		Возврат;
	КонецЕсли;
	Если ЦепочкаДействийКлиент.Найти(Действие.СледующееМесто) <> Неопределено Тогда
		Сообщить("Цепочка вернулась к действию, которое уже выполнялось, и остановлена.");
		Возврат;
	КонецЕсли;

	Вопрос = СтрШаблон("Продолжить действием «%1»?", Действие.СледующееПредставление);
	Если ЗначениеЗаполнено(Действие.СледующаяПричина) Тогда
		Вопрос = Действие.СледующаяПричина + Символы.ПС + Вопрос;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПродолжитьЦепочкуЗавершение", ЭтотОбъект,
		Новый Структура("Место", Действие.СледующееМесто));
	ПоказатьВопрос(Оповещение, Вопрос, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЦепочкуЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Если ЦепочкаДействийКлиент = Неопределено Тогда
		ЦепочкаДействийКлиент = Новый Массив;
	КонецЕсли;
	ЦепочкаДействийКлиент.Добавить(ДополнительныеПараметры.Место);

	Переход = ПерейтиКДействиюНаСервере(ДополнительныеПараметры.Место);
	Если ЗначениеЗаполнено(Переход.Ошибка) Тогда
		СтатусОперации = Переход.Ошибка;
		Возврат;
	КонецЕсли;

	ВсегоУточненийКэш = Переход.Уточнений;
	ВидДействияКлиент = Переход.ВидДействия;
	ЗаголовокДействияКлиент = Переход.ЗаголовокДействия;
	РежимДиалогаКлиент = Переход.РежимДиалога;
	ПредставлениеСозданияКлиент = Переход.ПредставлениеСоздания;
	ИндексУточнения = 0;
	Если Переход.Уточнений = 0 Тогда
		ЗапуститьАнализ();
		Возврат;
	КонецЕсли;

	ИндексУточнения = 1;
	Если Не ПоказатьУточнение(ИндексУточнения) Тогда
		СтатусОперации = "Следующее действие требует уточнения,"
			+ " которое помощник пока не умеет показывать.";
		Возврат;
	КонецЕсли;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПродолжениеДействия(Действие)

	Если ВидПродолжения = "ОжиданиеЗаписи" Тогда
		НачатьОжиданиеЗаписи(Действие);
		Возврат;
	КонецЕсли;

	Если ВидПродолжения = "Вопрос" Тогда
		// Да/Нет показываем диалогом: отдельная страница мастера тут лишняя.
		Оповещение = Новый ОписаниеОповещения("ПродолжениеВопросЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, Действие.ТекстПродолжения, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаУточнение;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ПродолжениеВопросЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Значение = (Ответ = КодВозвратаДиалога.Да);
	ВыполнитьШагДействия(Новый Структура("Ключ,Значение,Представление",
		"",
		Значение,
		?(Значение, "да", "нет")));

КонецПроцедуры

// Шаг, которого ждут от человека, а не от помощника: пока объект не записан,
// ссылки на него не существует, и связать с ним документ нечем.
//
// Помощник открыт окном поверх карточки и блокирует ее. Отпустить окно на ходу
// нельзя: присваивание РежимОткрытияОкна открытой форме проходит без ошибки,
// но блокировку не снимает — поверх карточки остается перехватывающий слой
// платформы, и до кнопки «Записать» человек не дотянется. Проверено в
// tests/ui/wait-for-write.mjs.
//
// Поэтому запись предлагается кнопкой самого помощника: нажимает ее человек, а
// выполняет ее форма объекта своим методом Записать() — со всеми проверками
// модуля формы. Помощник по-прежнему ничего не записывает сам.
&НаКлиенте
Процедура НачатьОжиданиеЗаписи(Действие)

	Форма = ФормаОбъекта();
	Если Форма = Неопределено Тогда
		ОтменитьОжиданиеЗаписи("Обработчик ждет записи объекта, но помощник открыт"
			+ " без формы объекта — ждать нечего.");
		Возврат;
	КонецЕсли;

	ОжиданиеЗаписиАктивно = Истина;
	НачалоОжиданияЗаписи = ТекущаяДата();
	СтатусОперации = ?(ЗначениеЗаполнено(Действие.ТекстПродолжения),
		Действие.ТекстПродолжения,
		"Запишите объект — действие продолжится после записи.");
	ОбновитьСостояниеИнтерфейса();
	// Опрос остается и при кнопке: объект могли записать и из другого места,
	// например открыв карточку второй раз.
	ПодключитьОбработчикОжидания("ПроверитьЗаписьОбъекта", 1, Истина);

КонецПроцедуры

// Признак записи — заполненная ссылка при немодифицированной форме. Оповещение
// «Запись_*» не годится: его шлет прикладная форма по соглашению конфигурации,
// а механизм обязан работать в любой.
//
// Уже записанный и неизмененный объект проходит проверку сразу: ждать нечего,
// ссылка есть.
&НаКлиенте
Процедура ПроверитьЗаписьОбъекта()

	Если Не ОжиданиеЗаписиАктивно = Истина Тогда
		Возврат;
	КонецЕсли;

	Форма = ФормаОбъекта();
	Если Форма = Неопределено Тогда
		ОтменитьОжиданиеЗаписи("Форма объекта закрыта — действие не продолжено.");
		Возврат;
	КонецЕсли;

	Ссылка = Неопределено;
	Попытка
		Ссылка = Форма.Объект.Ссылка;
	Исключение
		ОтменитьОжиданиеЗаписи("Форма объекта больше недоступна — действие не продолжено.");
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Ссылка) И Не Форма.Модифицированность Тогда
		ОжиданиеЗаписиАктивно = Ложь;
		ПринятьЗаписанныйОбъект(Ссылка);
		ВыполнитьШагДействия(Новый Структура("Ключ,Значение,Представление",
			"ОбъектЗаписан",
			Истина,
			Строка(Ссылка)));
		Возврат;
	КонецЕсли;

	// Потолок ожидания: помощник не должен висеть в опросе весь рабочий день,
	// если человек ушел от карточки, не записав.
	Если ТекущаяДата() - НачалоОжиданияЗаписи > 900 Тогда
		ОтменитьОжиданиеЗаписи("Объект не записан за 15 минут — действие остановлено.");
		Возврат;
	КонецЕсли;

	СтатусОперации = "Ожидание записи объекта" + ПрошлоВремени(НачалоОжиданияЗаписи);
	ПодключитьОбработчикОжидания("ПроверитьЗаписьОбъекта", 1, Истина);

КонецПроцедуры

// Запись выполняет форма объекта, а не помощник: ее метод Записать() проводит
// объект через ПередЗаписью, проверку заполнения и прочую логику модуля формы.
// Прямая запись объекта в обход формы все это обошла бы.
&НаКлиенте
Процедура ЗаписатьОбъектВладельцаОбработка(Команда)

	Если Не ОжиданиеЗаписиАктивно = Истина Тогда
		Возврат;
	КонецЕсли;

	Форма = ФормаОбъекта();
	Если Форма = Неопределено Тогда
		ОтменитьОжиданиеЗаписи("Форма объекта закрыта — действие не продолжено.");
		Возврат;
	КонецЕсли;

	Попытка
		Записано = Форма.Записать();
	Исключение
		СтатусОперации = "Не удалось записать объект: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Если Не Записано Тогда
		// Форма отказала сама — например, не заполнено обязательное поле.
		// Ожидание не снимаем: человек исправит и нажмет снова.
		СтатусОперации = "Форма объекта не приняла запись. Исправьте карточку и повторите.";
		Возврат;
	КонецЕсли;

	ПроверитьЗаписьОбъекта();

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОжиданиеЗаписи(Причина)

	ОжиданиеЗаписиАктивно = Ложь;
	СтатусОперации = Причина;
	ЗавершитьДействие();

КонецПроцедуры

// После записи объект наконец существует, и контекст шага переключается на
// настоящую ссылку. До записи ее в контексте просто нет: у нового объекта
// ссылка пустая, и ядру нечего было бы искать.
//
// КонтекстJSON не трогаем: он описывает источник для модели, а модель уже
// ответила. Обновляется то, по чему ядро находит объект.
&НаСервере
Процедура ПринятьЗаписанныйОбъект(Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяМетаданных = Ссылка.Метаданные().ПолноеИмя();
	ТипИсточника = ПолноеИмяМетаданных;
	КлючИсточника = Строка(Ссылка.УникальныйИдентификатор());
	ПредставлениеИсточника = Лев(Строка(Ссылка), 250);
	КоличествоОбъектов = 1;

КонецПроцедуры

// Кнопка «Далее» на шаге продолжения ведет не в анализ, а обратно в действие.
&НаКлиенте
Процедура ПродолжитьДействие()

	Ответ = СобратьОтветПродолжения();
	Если ТипЗнч(Ответ) = Тип("Строка") Тогда
		Сообщить(Ответ);
		Возврат;
	КонецЕсли;
	ВыполнитьШагДействия(Ответ);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьДействие()

	ОжиданиеЗаписиАктивно = Ложь;
	ОтключитьОбработчикОжидания("ПроверитьЗаписьОбъекта");
	ВидПродолжения = "";
	ШагДействия = 0;
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

// Заголовок кнопки действия. Пустая строка — действия нет, кнопку не показываем.
&НаКлиенте
Функция ЗаголовокДействия()

	// Настроенная подпись главнее: она описывает конкретное действие
	// («Создать заявку на расход»), а вид действия — только механику.
	Если ЗначениеЗаполнено(ЗаголовокДействияКлиент) Тогда
		Возврат ЗаголовокДействияКлиент;
	КонецЕсли;

	Если ВидДействияКлиент = "ЗаполнитьФорму" Тогда
		Возврат "Заполнить форму";
	ИначеЕсли ВидДействияКлиент = "ЗаписатьОбъект" Тогда
		Возврат "Записать в объект";
	ИначеЕсли ВидДействияКлиент = "СоздатьОбъект" Тогда
		Возврат ?(ЗначениеЗаполнено(ПредставлениеСозданияКлиент),
			"Создать «" + ПредставлениеСозданияКлиент + "»", "Создать объект");
	ИначеЕсли ВидДействияКлиент = "ПользовательскоеДействие"
		Или ВидДействияКлиент = "ВнешнийОбработчик" Тогда
		Возврат "Выполнить действие";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Функция ТекстПодтверждения(Отобрано)

	Если ВидДействияКлиент = "ЗаполнитьФорму" Тогда
		Возврат СтрШаблон(
			"Заполнить в форме «%1» реквизитов: %2?"
			+ " Объект не записывается — записать его нужно самостоятельно.",
			ПредставлениеИсточника,
			Отобрано);
	ИначеЕсли ВидДействияКлиент = "ЗаписатьОбъект" Тогда
		Возврат СтрШаблон(
			"Записать в объект «%1» реквизитов: %2? Объект будет изменен в базе.",
			ПредставлениеИсточника,
			Отобрано);
	ИначеЕсли ВидДействияКлиент = "СоздатьОбъект" Тогда
		Возврат СтрШаблон(
			"Создать «%1» по отмеченным значениям (%2)? Новый объект будет записан в базу.",
			?(ЗначениеЗаполнено(ПредставлениеСозданияКлиент), ПредставлениеСозданияКлиент, "объект"),
			Отобрано);
	КонецЕсли;
	Возврат СтрШаблон(
		"Выполнить действие для «%1» по отмеченным строкам (%2)?",
		ПредставлениеИсточника,
		Отобрано);

КонецФункции

// Переносит подготовленные значения в форму объекта. Форма остается
// измененной и незаписанной: записывает ее пользователь.
&НаКлиенте
Функция ЗаполнитьФормуОбъекта(План)

	Форма = ФормаОбъекта();
	Если Форма = Неопределено Тогда
		Возврат "Форма объекта закрыта — заполнять нечего.";
	КонецЕсли;

	Заполнено = 0;
	НеПринято = 0;
	// Строки табличных частей, уже созданные в этом заполнении: поля одной
	// строки приходят в плане порознь, а лечь должны в одну.
	СтрокиТЧ = Новый Соответствие;
	ОчищенныеТЧ = Новый Соответствие;

	Для Каждого Строка Из План Цикл
		Попытка
			Если ЗначениеЗаполнено(Строка.ТабличнаяЧасть) Тогда
				ЗаполнитьСтрокуТабличнойЧастиФормы(Форма, Строка, СтрокиТЧ, ОчищенныеТЧ);
			ИначеЕсли ЗначениеЗаполнено(Строка.Свойство) Тогда
				ЗаполнитьДополнительныйРеквизитФормы(Форма, Строка);
			Иначе
				Форма.Объект[Строка.ПутьРеквизита] = Строка.Значение;
			КонецЕсли;
			Заполнено = Заполнено + 1;
		Исключение
			// Реквизита может не быть на конкретной форме объекта, даже если
			// он есть у метаданных: форма вправе его не выводить.
			НеПринято = НеПринято + 1;
			Сообщить(СтрШаблон("%1: форма объекта не приняла значение (%2).",
				Строка.Представление,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;

	Если Заполнено > 0 Тогда
		Форма.Модифицированность = Истина;
	КонецЕсли;

	Возврат СтрШаблон(
		"Заполнено реквизитов в форме: %1, не принято: %2."
		+ " Проверьте значения и запишите объект.",
		Заполнено,
		НеПринято);

КонецФункции

// Заполняет строку табличной части в форме объекта.
//
// Очистка — только если этого просит карта, и один раз на табличную часть:
// дописывать безопаснее, чем молча стереть то, что человек уже внес.
&НаКлиенте
Процедура ЗаполнитьСтрокуТабличнойЧастиФормы(Форма, Строка, СтрокиТЧ, ОчищенныеТЧ)

	ИмяТЧ = Строка.ТабличнаяЧасть;
	Ключ = ИмяТЧ + "#" + Формат(Строка.НомерСтроки, "ЧГ=0");
	СтрокаФормы = СтрокиТЧ.Получить(Ключ);
	Если СтрокаФормы = Неопределено Тогда
		ТабличнаяЧасть = Форма.Объект[ИмяТЧ];
		Если Строка.ОбновлятьСтроки Тогда
			// Номер — это номер строки объекта: пишем в нее, новую не заводим.
			Если Строка.НомерСтроки < 1 Или Строка.НомерСтроки > ТабличнаяЧасть.Количество() Тогда
				ВызватьИсключение "в форме нет строки с таким номером";
			КонецЕсли;
			СтрокаФормы = ТабличнаяЧасть[Строка.НомерСтроки - 1];
		Иначе
			Если Строка.ЗаменятьСтроки И ОчищенныеТЧ.Получить(ИмяТЧ) = Неопределено Тогда
				ТабличнаяЧасть.Очистить();
				ОчищенныеТЧ.Вставить(ИмяТЧ, Истина);
			КонецЕсли;
			СтрокаФормы = ТабличнаяЧасть.Добавить();
		КонецЕсли;
		СтрокиТЧ.Вставить(Ключ, СтрокаФормы);
	КонецЕсли;

	СтрокаФормы[Строка.ПутьРеквизита] = Строка.Значение;

КонецПроцедуры

// Дополнительный реквизит в форме объекта.
//
// Форма БСП показывает свойства не из табличной части, а из своих реквизитов,
// перечисленных в Свойства_ОписаниеДополнительныхРеквизитов, и при записи
// собирает табличную часть заново из них. Значение, положенное только в
// табличную часть, БСП при записи молча отбросит — поэтому оно ставится в
// реквизит формы. Табличная часть заполняется тоже: ее читают формы без БСП,
// а для свойств, которых нет в наборах объекта, БСП берет значение из нее.
&НаКлиенте
Процедура ЗаполнитьДополнительныйРеквизитФормы(Форма, Строка)

	ИмяРеквизита = ИмяРеквизитаСвойстваВФорме(Форма, Строка.Свойство);
	Если ИмяРеквизита = Неопределено Тогда
		ВызватьИсключение "свойства нет среди выведенных на форму — при записи объекта"
			+ " его значение не сохранится";
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Форма[ИмяРеквизита] = Строка.Значение;
	КонецЕсли;

	Найдена = Неопределено;
	Для Каждого СтрокаСвойства Из Форма.Объект.ДополнительныеРеквизиты Цикл
		Если СтрокаСвойства.Свойство = Строка.Свойство Тогда
			Найдена = СтрокаСвойства;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Найдена = Неопределено Тогда
		Найдена = Форма.Объект.ДополнительныеРеквизиты.Добавить();
		Найдена.Свойство = Строка.Свойство;
	КонецЕсли;
	Найдена.Значение = Строка.Значение;

КонецПроцедуры

// Имя реквизита формы, в котором БСП держит значение свойства.
//
// Пустая строка — форма без свойств БСП либо свойства на ней еще не
// построены (БСП строит их отложенно): тогда при записи табличная часть
// берется как есть. Неопределено — свойства построены, а этого среди них нет,
// и записать его через форму нельзя.
&НаКлиенте
Функция ИмяРеквизитаСвойстваВФорме(Форма, Свойство)

	Попытка
		Описание = Форма.Свойства_ОписаниеДополнительныхРеквизитов;
	Исключение
		Возврат "";
	КонецПопытки;

	Для Каждого СтрокаОписания Из Описание Цикл
		Если СтрокаОписания.Свойство = Свойство Тогда
			Возврат СтрокаОписания.ИмяРеквизитаЗначение;
		КонецЕсли;
	КонецЦикла;

	Если Описание.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Форма прикладного объекта, из которой вызван помощник.
// БСП открывает обработку, передавая форму объекта владельцем, поэтому
// отдельного канала связи с прикладной формой не нужно.
&НаКлиенте
Функция ФормаОбъекта()

	Форма = ВладелецФормы;
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Если ТипЗнч(Форма.Объект) = Тип("Неопределено") Тогда
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		// У формы списка реквизита «Объект» нет — заполнять нечего.
		Возврат Неопределено;
	КонецПопытки;
	Возврат Форма;

КонецФункции

&НаКлиенте
Процедура ОткрытьДиалогОбработка(Команда)

	// В разговоре открывается он сам целиком — с файлами и всеми репликами.
	Если ЗначениеЗаполнено(ИдентификаторДиалогаРежима)
		И (Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДиалог
			Или ЗначениеЗаполнено(ЭтапДиалога)) Тогда
		ОткрытьФорму(
			"Обработка.AI_ЧатПоДаннымБазы.Форма.ДиалогСАгентом",
			Новый Структура("ИдентификаторДиалога", Новый УникальныйИдентификатор(ИдентификаторДиалогаРежима)),
			ЭтотОбъект);
		Возврат;
	КонецЕсли;

	// С результата открывается переписка этой операции: что модель получила и
	// что ответила. Новая беседа с тем же запросом тут ничего бы не объяснила,
	// а отправленная заново ушла бы без файла.
	ОперацияДиалога = ОперацияОткрытогоРезультата();
	Если ОперацияДиалога <> Неопределено Тогда
		ДиалогОперации = ИдентификаторДиалогаОперации(ОперацияДиалога);
		Если ДиалогОперации <> Неопределено Тогда
			ОткрытьФорму(
				"Обработка.AI_ЧатПоДаннымБазы.Форма.ДиалогСАгентом",
				Новый Структура("ИдентификаторДиалога", ДиалогОперации),
				ЭтотОбъект);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите действие.");
		Возврат;
	КонецЕсли;
	Попытка
		ПараметрыДиалога = ПодготовитьПараметрыДиалогаНаСервере(ТекущиеДанные.МестоЗапуска);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	ОткрытьФорму(
		"Обработка.AI_ЧатПоДаннымБазы.Форма.ДиалогСАгентом",
		ПараметрыДиалога,
		ЭтотОбъект);

КонецПроцедуры

// Операция, результат которой сейчас перед человеком: на странице результата —
// последняя запущенная или открытая из пачки, на странице пачки — выбранная
// строка. Неопределено — результата на экране нет.
&НаКлиенте
Функция ОперацияОткрытогоРезультата()

	Если Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат
		И Строка(ИдентификаторОперации) <> "00000000-0000-0000-0000-000000000000" Тогда
		Возврат ИдентификаторОперации;
	КонецЕсли;

	Если Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаПакет Тогда
		ТекущиеДанные = Элементы.Пакет.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Идентификатор) Тогда
			Возврат Новый УникальныйИдентификатор(ТекущиеДанные.Идентификатор);
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Диалог, в котором шла операция. Помощник запускает ее диалоговым путем,
// поэтому переписка сохранена целиком — вместе с вложенным файлом.
&НаСервереБезКонтекста
Функция ИдентификаторДиалогаОперации(ИдентификаторОперации)

	Попытка
		Состояние = AI_АгентскиеОперации.ПолучитьИзменения(ИдентификаторОперации);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	ИдентификаторДиалога = Неопределено;
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("ИдентификаторДиалога", ИдентификаторДиалога);
	КонецЕсли;
	Если ТипЗнч(ИдентификаторДиалога) <> Тип("УникальныйИдентификатор")
		Или ИдентификаторДиалога = ПустойУникальныйИдентификатор() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ИдентификаторДиалога;

КонецФункции

&НаКлиенте
Процедура ОткрытьОбычныйДиалогОбработка(Команда)
	ОткрытьФорму(
		"Обработка.AI_ЧатПоДаннымБазы.Форма.ДиалогСАгентом",
		Новый Структура,
		ЭтотОбъект);
КонецПроцедуры

// У формы помощника своя командная панель без стандартных команд, поэтому
// кнопки справки на ней нет: F1 знают не все, а ссылка на виду.
&НаКлиенте
Процедура СправкаПомощникаОбработка(Команда)
	ОткрытьСправку("Обработка.AI_ПомощникКонтекста");
КонецПроцедуры

// Выгружает встроенную в расширение внешнюю обработку, чтобы администратор
// мог зарегистрировать ее в дополнительных отчетах и обработках БСП.
&НаКлиенте
Процедура СохранитьОбработкуБСПОбработка(Команда)

	// Вариант «с диалогом»: пользователь сам выбирает, куда сохранить файл,
	// и в веб-клиенте расширение работы с файлами не требуется.
	Файл = ПодготовитьОбработкуБСПНаСервере();
	НачатьПолучениеФайлаССервера(Файл.Адрес, Файл.Имя);

КонецПроцедуры

// Инструкция собирается из настроенных данных, а не пишется руками, поэтому
// не расходится с системой: что настроено — то и написано.
&НаКлиенте
Процедура СохранитьИнструкциюОбработка(Команда)

	Файл = ПодготовитьИнструкциюНаСервере();
	Если ЗначениеЗаполнено(Файл.Ошибка) Тогда
		Сообщить(Файл.Ошибка);
		Возврат;
	КонецЕсли;
	НачатьПолучениеФайлаССервера(Файл.Адрес, Файл.Имя);

КонецПроцедуры

&НаСервере
Функция ПодготовитьИнструкциюНаСервере()

	Результат = Новый Структура("Адрес,Имя,Ошибка", "", "", "");
	Попытка
		HTML = AI_Инструкции.СформироватьHTML();
		Данные = ПолучитьДвоичныеДанныеИзСтроки(HTML, "UTF-8", Ложь);
		Результат.Адрес = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
		Результат.Имя = AI_Инструкции.ИмяФайлаИнструкции();
	Исключение
		Результат.Ошибка = "Не удалось сформировать инструкцию: " + ОписаниеОшибки();
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область НавигацияМастера

&НаКлиенте
Процедура НачатьСценарий()

	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите действие.");
		Возврат;
	КонецЕсли;

	Попытка
		Подготовка = ВыбратьДействиеНаСервере(ТекущиеДанные.МестоЗапуска);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Подготовка.Отказ) Тогда
		Сообщить(Подготовка.Отказ);
		Возврат;
	КонецЕсли;

	ВсегоУточненийКэш = Подготовка.Уточнений;
	ВидДействияКлиент = Подготовка.ВидДействия;
	ЗаголовокДействияКлиент = Подготовка.ЗаголовокДействия;
	ПакетныйРежимКлиент = Подготовка.Пакетный;
	РежимДиалогаКлиент = Подготовка.РежимДиалога;
	ПредставлениеСозданияКлиент = Подготовка.ПредставлениеСоздания;
	Количество = Подготовка.Уточнений;
	ИндексУточнения = 0;
	Если Количество = 0 Тогда
		ЗапуститьАнализ();
		Возврат;
	КонецЕсли;

	ИндексУточнения = 1;
	Если Не ПоказатьУточнение(ИндексУточнения) Тогда
		// Вид уточнения не поддержан интерфейсом — не притворяемся, что спросили.
		Сообщить("Действие требует уточнения, которое помощник пока не умеет показывать.");
		Возврат;
	КонецЕсли;
	// Заголовок кнопки зависит от того, последнее ли это уточнение.
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьУточнения()

	Ответ = СохранитьОтветУточнения(ИндексУточнения);
	Если ЗначениеЗаполнено(Ответ) Тогда
		Сообщить(Ответ);
		Возврат;
	КонецЕсли;

	Следующий = ИндексУточнения + 1;
	Пока Следующий <= ВсегоУточнений() Цикл
		Если ПоказатьУточнение(Следующий) Тогда
			ИндексУточнения = Следующий;
			ОбновитьСостояниеИнтерфейса();
			Возврат;
		КонецЕсли;
		// Неподдержанный вид пропускаем, но оставляем след в статусе.
		Следующий = Следующий + 1;
	КонецЦикла;

	ЗапуститьАнализ();

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьАнализ()

	Рекомендации.Очистить();
	ТекстОтвета = "";
	// Прошлая операция больше не результат на экране: иначе «Открыть диалог»
	// после неудачного запуска показал бы чужую переписку.
	ИдентификаторОперации = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");

	Если ПакетныйРежимКлиент = Истина Тогда
		ЗапуститьПакет();
		Возврат;
	КонецЕсли;

	Если РежимДиалогаКлиент = Истина Тогда
		НачатьДиалог();
		Возврат;
	КонецЕсли;

	// Серверная часть запуска не должна выбрасывать пользователю
	// «непредвиденную ошибку»: причина нужна ему прямо в мастере.
	Попытка
		Запуск = ЗапуститьНаСервере();
	Исключение
		СтатусОперации = "Не удалось запустить анализ: " + ОписаниеОшибки();
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		СтатусОперации = Запуск.Ошибка;
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецЕсли;

	ИдентификаторОперации = Запуск.ИдентификаторОперации;
	ОперацияВыполняется = Истина;
	НачалоОжидания = ТекущаяДата();
	СтатусОперации = "Анализ выполняется...";
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
	ОбновитьСостояниеИнтерфейса();
	ПодключитьОпросОперации();

КонецПроцедуры

// Диалоговый режим: сначала разговор, потом результат по карте. Разговор
// начинает модель — по заданию места и данным объекта она сама говорит, что
// соберет, и задает первый вопрос. Человеку не нужно угадывать, с чего начать.
&НаКлиенте
Процедура НачатьДиалог()

	СообщениеДиалога = "";
	Попытка
		Запуск = НачатьДиалогНаСервере();
	Исключение
		Запуск = Новый Структура("ИдентификаторОперации,Ошибка", Неопределено, ОписаниеОшибки());
	КонецПопытки;
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДиалог;
	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		СтатусОперации = "Не удалось начать разговор: " + Запуск.Ошибка;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецЕсли;
	ЖдатьОтветаДиалога(Запуск.ИдентификаторОперации);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщениеОбработка(Команда)

	Если ОперацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	Текст = СокрЛП(СообщениеДиалога);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		СтатусОперации = "Напишите сообщение модели.";
		Возврат;
	КонецЕсли;
	Запуск = ОтправитьВДиалогНаСервере(Текст);
	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		СтатусОперации = "Не удалось отправить: " + Запуск.Ошибка;
		Возврат;
	КонецЕсли;
	СообщениеДиалога = "";
	ЖдатьОтветаДиалога(Запуск.ИдентификаторОперации);

КонецПроцедуры

// Итог разговора — тот же анализ по карте, только модель отвечает по всей
// переписке. Дальше работают обычные рекомендации и кнопка действия.
&НаКлиенте
Процедура СформироватьРезультатОбработка(Команда)

	Если ОперацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	Запуск = СформироватьИтогДиалогаНаСервере();
	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		СтатусОперации = "Не удалось сформировать результат: " + Запуск.Ошибка;
		Возврат;
	КонецЕсли;
	Рекомендации.Очистить();
	ТекстОтвета = "";
	ИдентификаторОперации = Запуск.ИдентификаторОперации;
	ОперацияВыполняется = Истина;
	НачалоОжидания = ТекущаяДата();
	СтатусОперации = "Формирую результат по разговору...";
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
	ОбновитьСостояниеИнтерфейса();
	ПодключитьОпросОперации();

КонецПроцедуры

&НаКлиенте
Процедура ЖдатьОтветаДиалога(Идентификатор)

	ИдентификаторОперации = Идентификатор;
	ОперацияВыполняется = Истина;
	НачалоОжидания = ТекущаяДата();
	СтатусОперации = "Модель отвечает...";
	ОбновитьСостояниеИнтерфейса();
	ПоказатьКонецИстории();
	ПодключитьОпросОперации();

КонецПроцедуры

// Последние реплики — внизу истории: курсор в конец, чтобы поле прокрутилось.
&НаКлиенте
Процедура ПоказатьКонецИстории()

	Позиция = СтрДлина(ИсторияДиалога) + 1;
	Попытка
		Элементы.ИсторияДиалога.УстановитьГраницыВыделения(Позиция, Позиция);
	Исключение
		// Поле еще не отрисовано — прокрутка не важна.
	КонецПопытки;

КонецПроцедуры

// Пачка объектов обрабатывается по одному: на каждый объект своя агентская
// операция. Параллелизм, повторы и восстановление прерванных берет на себя
// очередь подсистемы — второй такой механизм помощнику не нужен.
// Перенос настройки между базами — работа администратора, и кнопки видны
// только ему. Проверка права живет на сервере, здесь только видимость.
&НаКлиенте
Процедура ВыгрузитьПакетОбработка(Команда)

	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите действие, которое нужно выгрузить.");
		Возврат;
	КонецЕсли;

	Пакет = ПодготовитьПакетНаСервере(ТекущиеДанные.МестоЗапуска);
	Для Каждого Сообщение Из Пакет.Сообщения Цикл
		Сообщить(Сообщение);
	КонецЦикла;
	Если ЗначениеЗаполнено(Пакет.Ошибка) Тогда
		Сообщить(Пакет.Ошибка);
		Возврат;
	КонецЕсли;

	// Синхронный ПолучитьФайл в веб-клиенте без модальности не работает.
	НачатьПолучениеФайлаССервера(Пакет.Адрес, Пакет.Имя);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПакетОбработка(Команда)

	Оповещение = Новый ОписаниеОповещения("ЗагрузитьПакетЗавершение", ЭтотОбъект);
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	// Голый manifest.json — пакет, написанный руками или агентом, без обработок.
	ПараметрыДиалога.Фильтр = "Пакет сценария (*.zip, *.json)|*.zip;*.json";
	ПараметрыДиалога.Заголовок = "Выберите пакет сценария";
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор, ПараметрыДиалога);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПакетЗавершение(Помещен, Адрес, ВыбранноеИмя, ДополнительныеПараметры) Экспорт

	Если Не Помещен Тогда
		Возврат;
	КонецЕсли;

	Итог = ЗагрузитьПакетНаСервере(Адрес);
	// Загруженные места выключены, поэтому в списке их еще не будет: перечитать
	// нужно все равно — обновление существующего действия видно сразу.
	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Сообщить(Сообщение);
	КонецЦикла;
	Если Итог.Успешно Тогда
		ПрочитатьСписокДействий();
		ОбновитьОписаниеВыбранного();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПакет()

	Попытка
		Запуск = ЗапуститьПакетНаСервере();
	Исключение
		СтатусОперации = "Не удалось запустить пакет: " + ОписаниеОшибки();
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		СтатусОперации = Запуск.Ошибка;
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецЕсли;

	НачалоОжидания = ТекущаяДата();
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаПакет;
	ОбновитьСостояниеИнтерфейса();
	ПодключитьОпросПакета();

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОпросПакета()
	ПодключитьОбработчикОжидания("ПроверитьСостояниеПакета", 2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСостояниеПакета()

	Осталось = ОбновитьПакетНаСервере();
	Если Осталось > 0 Тогда
		ПодключитьОпросПакета();
	КонецЕсли;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

// Открывает результат одного объекта в обычной странице рекомендаций. Дальше
// работают те же кнопки, что и в одиночном режиме: человек проверяет значения
// и применяет действие к этому объекту.
&НаКлиенте
Процедура ОткрытьРезультатПакетаОбработка(Команда)

	ТекущиеДанные = Элементы.Пакет.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите объект в списке.");
		Возврат;
	КонецЕсли;
	Если Не ТекущиеДанные.Готово Тогда
		Сообщить("По этому объекту анализ еще идет.");
		Возврат;
	КонецЕсли;
	Если Не ТекущиеДанные.Успешно Тогда
		Сообщить("По этому объекту анализ завершился ошибкой: " + ТекущиеДанные.Состояние);
		Возврат;
	КонецЕсли;

	СтатусОперации = ОткрытьСтрокуПакетаНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОписаниеВыбранного()
	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОписаниеВыбранного = "";
		НачальныйЗапросВыбранного = "";
	Иначе
		ОписаниеВыбранного = ТекущиеДанные.Описание;
		НачальныйЗапросВыбранного = ТекущиеДанные.НачальныйЗапрос;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояниеИнтерфейса()

	НаДействиях = (Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДействия);
	НаУточнении = (Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаУточнение);
	НаРезультате = (Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат);
	НаПакете = (Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаПакет);
	НаДиалоге = (Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДиалог);

	// Анимация крутится только пока ждем модель — она и есть признак жизни.
	Элементы.ИндикаторОжидания.Видимость = НаРезультате И ОперацияВыполняется;

	Элементы.Назад.Доступность = Не НаДействиях И Не ОперацияВыполняется;
	// На странице пакета «Далее» не при чем: следующий шаг выбирает человек,
	// открывая конкретный объект. В разговоре свои кнопки.
	Элементы.Далее.Видимость = Не НаРезультате И Не НаПакете И Не НаДиалоге;
	Элементы.КнопкаОтправить.Доступность = Не ОперацияВыполняется;
	Элементы.КнопкаСформировать.Доступность = Не ОперацияВыполняется
		И ЗначениеЗаполнено(ИдентификаторДиалогаРежима);
	Элементы.Далее.Доступность = Не ОперацияВыполняется;
	Если НаУточнении И ЗначениеЗаполнено(ВидПродолжения) Тогда
		Элементы.Далее.Заголовок = "Продолжить";
	ИначеЕсли НаУточнении И ИндексУточнения >= ВсегоУточнений() Тогда
		Элементы.Далее.Заголовок = ?(РежимДиалогаКлиент = Истина, "Начать разговор", "Запустить анализ");
	Иначе
		Элементы.Далее.Заголовок = "Далее >";
	КонецЕсли;
	// Кнопку действия показываем только там, где действие настроено, а для
	// заполнения формы — еще и когда есть форма объекта.
	// Имя «Заголовок» в модуле формы занято заголовком самой формы —
	// локальная переменная с таким именем стирает заголовок окна.
	ЗаголовокКнопки = ЗаголовокДействия();
	Доступно = ЗначениеЗаполнено(ЗаголовокКнопки)
		И (ВидДействияКлиент <> "ЗаполнитьФорму" Или ФормаОбъекта() <> Неопределено);
	Элементы.ПрименитьРекомендации.Видимость = НаРезультате И Доступно;
	Если Доступно Тогда
		Элементы.ПрименитьРекомендации.Заголовок = ЗаголовокКнопки;
	КонецЕсли;
	Элементы.ПрименитьРекомендации.Доступность = Не ОперацияВыполняется
		И Рекомендации.Количество() > 0;

	// Кнопка записи живет ровно столько, сколько идет ожидание: в остальное
	// время объект записывают обычной командой карточки.
	Элементы.ЗаписатьОбъектВладельца.Видимость = (ОжиданиеЗаписиАктивно = Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОпросОперации()
	ПодключитьОбработчикОжидания("ПроверитьСостояниеОперации", 2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОпросОперации()
	ОтключитьОбработчикОжидания("ПроверитьСостояниеОперации");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСостояниеОперации()

	Если Не ОперацияВыполняется Тогда
		Возврат;
	КонецЕсли;

	Состояние = ПроверитьСостояниеНаСервере();
	Если Не Состояние.Финальная Тогда
		// Обращение к модели идет фоновым заданием, интерфейс не блокируется.
		// Пользователю показываем этап от операции и время ожидания, чтобы
		// длинный ответ модели не выглядел зависанием.
		СтатусОперации = Состояние.Статус + ПрошлоВремени();
		ПодключитьОпросОперации();
		Возврат;
	КонецЕсли;

	СтатусОперации = Состояние.Статус;
	ОперацияВыполняется = Ложь;
	ОбновитьСостояниеИнтерфейса();
	Если Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДиалог Тогда
		ПоказатьКонецИстории();
		ТекущийЭлемент = Элементы.СообщениеДиалога;
	КонецЕсли;

КонецПроцедуры

// Сколько идет текущее обращение. Формат намеренно короткий: строка состояния
// и так несет текст этапа.
&НаКлиенте
Функция ПрошлоВремени(Начало = Неопределено)

	Отсчет = ?(Начало = Неопределено, НачалоОжидания, Начало);
	Если Не ЗначениеЗаполнено(Отсчет) Тогда
		Возврат "";
	КонецЕсли;
	Секунд = Цел(ТекущаяДата() - Отсчет);
	Если Секунд < 1 Тогда
		Возврат "";
	КонецЕсли;
	Если Секунд < 60 Тогда
		Возврат СтрШаблон(" (%1 с)", Секунд);
	КонецЕсли;
	Возврат СтрШаблон(" (%1 мин %2 с)", Цел(Секунд / 60), Секунд % 60);

КонецФункции

#КонецОбласти

#Область РаботаСУточнениями

&НаКлиенте
Функция ВсегоУточнений()
	Возврат ?(ВсегоУточненийКэш = Неопределено, 0, ВсегоУточненийКэш);
КонецФункции

// Готовит страницу под вид уточнения. Ложь — вид интерфейсом не поддержан.
//
// Перед каждым вопросом спрашивается проверка кодом («ПередШагом»): она вправе
// остановить действие, пока человек не ушел дальше. Остановка — это страница
// результата с причиной, а для вызывающего — «шаг показан»: иначе он принял
// бы отказ за неподдержанный вид вопроса.
&НаСервере
Функция ПоказатьУточнение(Номер)

	Описание = ОписаниеУточнения(Номер);
	Если Описание = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Проверка = AI_ПрименениеРекомендаций.ПроверитьДоступность(ТекущееМестоЗапуска, КонтекстФормы(),
		"ПередШагом", Неопределено, Новый Структура("Номер,Вопрос", Номер, Описание.Представление));
	Если Не Проверка.Доступно Тогда
		Рекомендации.Очистить();
		СтатусОперации = "Действие остановлено: " + ?(ЗначениеЗаполнено(Проверка.Причина),
			Проверка.Причина, "его запретила проверка настройки.");
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
		Возврат Истина;
	КонецЕсли;

	Виды = Перечисления.AI_ВидУточнения;
	Страница = Неопределено;
	ВариантыУточнения.Очистить();
	УточнениеСтрока = "";
	УточнениеЧисло = 0;
	УточнениеДата = '00010101';
	УточнениеФлаг = Ложь;
	ТекстНетВариантов = "";

	Если Описание.ВидУточнения = Виды.ВыборИзПодчиненных
		Или Описание.ВидУточнения = Виды.ВыборИзСписка Тогда
		Страница = Элементы.ВидСписок;
		Список = AI_ИзвлечениеРеквизитов.ПолучитьВариантыУточнения(Описание, КонтекстФормы());
		Для Каждого СтрокаИсточника Из Список Цикл
			СтрокаТаблицы = ВариантыУточнения.Добавить();
			СтрокаТаблицы.Ключ = Строка(СтрокаИсточника.Ссылка.УникальныйИдентификатор());
			СтрокаТаблицы.Представление = СтрокаИсточника.Представление;
			СтрокаТаблицы.Дополнительно = СтрокаИсточника.Дополнительно;
		КонецЦикла;
		// Пустой список без объяснения человек принимает за сбой. Сказать сразу,
		// чего не хватает, полезнее, чем ответить отказом на «Далее».
		Если ВариантыУточнения.Количество() = 0 Тогда
			ТекстНетВариантов = AI_ИзвлечениеРеквизитов.ТекстНетВариантов(Описание);
		КонецЕсли;
	ИначеЕсли Описание.ВидУточнения = Виды.ВводСтроки Тогда
		Страница = Элементы.ВидСтрока;
	ИначеЕсли Описание.ВидУточнения = Виды.ВводЧисла Тогда
		Страница = Элементы.ВидЧисло;
	ИначеЕсли Описание.ВидУточнения = Виды.ВводДаты Тогда
		Страница = Элементы.ВидДата;
	ИначеЕсли Описание.ВидУточнения = Виды.Флаг Тогда
		Страница = Элементы.ВидФлаг;
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Страница;
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаУточнение;
	Элементы.ПояснениеУточнения.Заголовок = ТекстПояснения(Описание, Номер)
		+ ?(ЗначениеЗаполнено(ТекстНетВариантов), Символы.ПС + ТекстНетВариантов, "");
	Возврат Истина;

КонецФункции

// Проверяет и запоминает ответ. Возвращает текст ошибки либо пустую строку.
&НаСервере
Функция СохранитьОтветУточнения(Номер)

	Описание = ОписаниеУточнения(Номер);
	Если Описание = Неопределено Тогда
		Возврат "Уточнение больше не доступно.";
	КонецЕсли;

	Виды = Перечисления.AI_ВидУточнения;
	Ключ = "";
	ЗначениеТекстом = "";

	Если Описание.ВидУточнения = Виды.ВыборИзПодчиненных
		Или Описание.ВидУточнения = Виды.ВыборИзСписка Тогда
		НомерСтроки = Элементы.ВариантыУточнения.ТекущаяСтрока;
		ТекущаяСтрока = Неопределено;
		Для Каждого СтрокаТаблицы Из ВариантыУточнения Цикл
			Если СтрокаТаблицы.ПолучитьИдентификатор() = НомерСтроки Тогда
				ТекущаяСтрока = СтрокаТаблицы;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ТекущаяСтрока = Неопределено Тогда
			Возврат ?(ВариантыУточнения.Количество() = 0,
				AI_ИзвлечениеРеквизитов.ТекстНетВариантов(Описание),
				"Выберите значение из списка.");
		КонецЕсли;
		Ключ = ТекущаяСтрока.Ключ;
		ЗначениеТекстом = ТекущаяСтрока.Представление;

	ИначеЕсли Описание.ВидУточнения = Виды.ВводСтроки Тогда
		Если Описание.Обязательное И Не ЗначениеЗаполнено(УточнениеСтрока) Тогда
			Возврат "Заполните значение.";
		КонецЕсли;
		ЗначениеТекстом = УточнениеСтрока;

	ИначеЕсли Описание.ВидУточнения = Виды.ВводЧисла Тогда
		Если Описание.Обязательное И Не ЗначениеЗаполнено(УточнениеЧисло) Тогда
			Возврат "Заполните значение.";
		КонецЕсли;
		ЗначениеТекстом = Формат(УточнениеЧисло, "ЧРД=.; ЧГ=0");

	ИначеЕсли Описание.ВидУточнения = Виды.ВводДаты Тогда
		Если Описание.Обязательное И Не ЗначениеЗаполнено(УточнениеДата) Тогда
			Возврат "Заполните дату.";
		КонецЕсли;
		ЗначениеТекстом = ?(ЗначениеЗаполнено(УточнениеДата),
			Формат(УточнениеДата, "ДФ=yyyy-MM-dd"), "");

	ИначеЕсли Описание.ВидУточнения = Виды.Флаг Тогда
		ЗначениеТекстом = ?(УточнениеФлаг, "да", "нет");

	Иначе
		Возврат "Вид уточнения не поддержан.";
	КонецЕсли;

	УдалитьСобранноеУточнениеНаСервере(Номер);
	СтрокаОтвета = СобранныеУточнения.Добавить();
	СтрокаОтвета.НомерСтрокиУточнения = Номер;
	СтрокаОтвета.Идентификатор = ?(ЗначениеЗаполнено(Описание.Идентификатор),
		Описание.Идентификатор, "уточнение_" + Формат(Номер, "ЧГ=0"));
	СтрокаОтвета.Представление = ?(ЗначениеЗаполнено(Описание.Представление),
		Описание.Представление, СтрокаОтвета.Идентификатор);
	СтрокаОтвета.Ключ = Ключ;
	СтрокаОтвета.ЗначениеТекстом = Лев(ЗначениеТекстом, 500);
	СтрокаОтвета.ПередаватьСодержимое = Описание.ПередаватьСодержимое;

	Возврат "";

КонецФункции

&НаКлиенте
Процедура УдалитьСобранноеУточнение(Номер)
	УдалитьСобранноеУточнениеНаСервере(Номер);
КонецПроцедуры

&НаСервере
Процедура УдалитьСобранноеУточнениеНаСервере(Номер)
	Отбор = Новый Структура("НомерСтрокиУточнения", Номер);
	Для Каждого СтрокаТаблицы Из СобранныеУточнения.НайтиСтроки(Отбор) Цикл
		СобранныеУточнения.Удалить(СтрокаТаблицы);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ОписаниеУточнения(Номер)

	Если Не ЗначениеЗаполнено(ТекущееМестоЗапуска) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Уточнения = ТекущееМестоЗапуска.Уточнения;
	Если Номер < 1 Или Номер > Уточнения.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Уточнения[Номер - 1];

КонецФункции

&НаСервереБезКонтекста
Функция ТекстПояснения(Описание, Номер)
	Текст = ?(ЗначениеЗаполнено(Описание.Подсказка),
		Описание.Подсказка,
		?(ЗначениеЗаполнено(Описание.Представление),
			Описание.Представление,
			"Уточните детали действия."));
	Возврат "Шаг " + Формат(Номер, "ЧГ=0") + ". " + Текст;
КонецФункции

#КонецОбласти

#Область СерверныеВызовы

&НаСервере
Функция ВыбратьДействиеНаСервере(МестоЗапуска)

	ТекущееМестоЗапуска = МестоЗапуска;
	СобранныеУточнения.Очистить();
	ВариантыУточнения.Очистить();
	Рекомендации.Очистить();
	Пакетный = КоличествоОбъектов > 1
		И AI_ИнтерфейсныеСценарии.РежимВыполненияОчередью(МестоЗапуска);

	// В пакете уточнение с источником данных разрешается по каждому объекту
	// отбором — спрашивать про файл тридцать раз бессмысленно. А уточнение без
	// источника задать нечем: один ответ на всю пачку означал бы, что человек
	// отвечает за объекты, которых он не видел. Такое действие честно
	// отклоняем, а не выполняем наполовину.
	Отказ = "";
	Если Пакетный Тогда
		Для Каждого Уточнение Из МестоЗапуска.Уточнения Цикл
			Если Не ЗначениеЗаполнено(Уточнение.ИсточникДанных) Тогда
				Отказ = "Действие спрашивает уточнение «" + Уточнение.Представление
					+ "», которое нельзя задать сразу для нескольких объектов."
					+ " Запустите его по одному объекту.";
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Разговор ведется с одним человеком об одном объекте: ответ на пачку в
	// тридцать документов разговором не собрать.
	Если Пакетный И МестоЗапуска.РежимДиалога И Не ЗначениеЗаполнено(Отказ) Тогда
		Отказ = "Действие начинается с разговора, а разговор ведется по одному объекту."
			+ " Запустите его из карточки объекта.";
	КонецЕсли;

	// Заголовок окна называет выбранное действие: помощник открывается поверх
	// карточки, и через минуту уже не видно, с чем именно он работает.
	УстановитьЗаголовокОкна(МестоЗапуска.ПредставлениеКоманды);

	// Без карты раскладывать ответ не по чему — он показывается текстом.
	ЕстьКарта = ЗначениеЗаполнено(МестоЗапуска.КартаИзвлечения);
	Элементы.Рекомендации.Видимость = ЕстьКарта;
	Элементы.ТекстОтветаМодели.Видимость = Не ЕстьКарта;

	ЭтапДиалога = "";
	ИдентификаторДиалогаРежима = "";
	ПредыдущийIDОтветаДиалога = "";
	ИсторияДиалога = "";
	ДанныеКонтекстаДиалога = "";
	Элементы.ПояснениеДиалога.Заголовок = ?(ЗначениеЗаполнено(МестоЗапуска.Описание),
		СокрЛП(МестоЗапуска.Описание) + " ", "")
		+ "Отвечайте модели обычными словами. Когда все обсудите, нажмите «Сформировать результат».";

	ПредставлениеСоздания = "";
	Если МестоЗапуска.ВидДействия = Перечисления.AI_ВидДействия.СоздатьОбъект Тогда
		ОписаниеСоздания = Метаданные.НайтиПоПолномуИмени(
			AI_ПрименениеРекомендаций.ОбъектСоздания(МестоЗапуска));
		Если ОписаниеСоздания <> Неопределено Тогда
			ПредставлениеСоздания = AI_ИнтерфейсныеСценарии.ПредставлениеОдногоОбъекта(ОписаниеСоздания);
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("Уточнений,ВидДействия,Пакетный,Отказ,ЗаголовокДействия,РежимДиалога,ПредставлениеСоздания",
		?(Пакетный, 0, МестоЗапуска.Уточнения.Количество()),
		ВидДействияСтрокой(МестоЗапуска.ВидДействия),
		Пакетный,
		Отказ,
		СокрЛП(МестоЗапуска.ЗаголовокДействия),
		МестоЗапуска.РежимДиалога,
		ПредставлениеСоздания);

КонецФункции

// КонтекстЗапуска и АвтоВыборФайлов нужны массовому режиму: он запускает эту
// же процедуру по разу на объект, и файл у каждого объекта свой. Спрашивать про
// файл по каждому объекту бессмысленно — отбор уточнения и так однозначен.
//
// Возвращает структуру: ИдентификаторОперации, Ошибка, Файл — представление
// файлов, ушедших модели.
&НаСервере
Функция ЗапуститьНаСервере(КонтекстЗапуска = Неопределено, АвтоВыборФайлов = Ложь)

	Результат = Новый Структура("ИдентификаторОперации,Ошибка,Файл",
		ПустойУникальныйИдентификатор(), "", "");

	Контекст = ?(КонтекстЗапуска = Неопределено, КонтекстФормы(), КонтекстЗапуска);

	Попытка
		ПараметрыДиалога = AI_ИнтерфейсныеСценарии.ПодготовитьПараметрыДиалога(
			ТекущееМестоЗапуска,
			Контекст,
			НачальныйЗапросВыбранного);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	ДанныеКонтекстаЗапуска = ПараметрыДиалога.ДанныеКонтекста;

	// Данные объекта (реквизиты, строки табличных частей) — по настройке места.
	// Читаются с правами пользователя, поэтому отказ здесь — не ошибка ядра.
	Попытка
		ДанныеОбъекта = AI_ИнтерфейсныеСценарии.ДанныеОбъектаДляМодели(ТекущееМестоЗапуска, Контекст);
	Исключение
		Результат.Ошибка = "Не удалось прочитать данные объекта: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	Если ЗначениеЗаполнено(ДанныеОбъекта) Тогда
		ДанныеКонтекстаЗапуска = ДанныеКонтекстаЗапуска + Символы.ПС + Символы.ПС + ДанныеОбъекта;
	КонецЕсли;

	// В пакете ответов от человека нет: уточнения с источником данных
	// разрешаются отбором по каждому объекту.
	Ответы = ?(АвтоВыборФайлов, АвтоответыУточнений(), СобранныеУточнения);

	// Файлы находятся до того, как заведен диалог. Объект без подходящего файла
	// не должен оставлять пустую беседу, а главное — модель без файла отвечает
	// пустыми строками, и такой ответ легко принять за «в документе ничего нет».
	Файлы = Новый Массив;
	ОтветыДляОбработчика = Новый Массив;
	Для Каждого Ответ Из Ответы Цикл
		ЗначениеОтвета = Ответ.ЗначениеТекстом;
		Если Ответ.ПередаватьСодержимое
			И (ЗначениеЗаполнено(Ответ.Ключ) Или АвтоВыборФайлов) Тогда
			Файл = НайтиФайлУточнения(Ответ, Контекст, АвтоВыборФайлов);
			Если Не Файл.Успех Тогда
				Результат.Ошибка = Файл.Причина;
				Возврат Результат;
			КонецЕсли;
			Файлы.Добавить(Файл);
			ЗначениеОтвета = Файл.Представление;
		КонецЕсли;
		ДанныеКонтекстаЗапуска = ДанныеКонтекстаЗапуска + Символы.ПС
			+ Ответ.Представление + ": " + ЗначениеОтвета;
		ОтветыДляОбработчика.Добавить(Новый Структура("Представление,Значение",
			Ответ.Представление, ЗначениеОтвета));
	КонецЦикла;

	// Последнее слово перед моделью — за обработчиком места: он вправе подать
	// свой файл, дописать данные и запрос или отказать.
	Подготовка = AI_ПрименениеРекомендаций.ПодготовитьЗапрос(ТекущееМестоЗапуска, Контекст,
		Новый Структура("Промт,ДанныеКонтекста,Файлы,Ответы,Режим",
			ПараметрыДиалога.НачальныйЗапрос, ДанныеКонтекстаЗапуска, Файлы, ОтветыДляОбработчика,
			?(АвтоВыборФайлов, "Пачка", "Запуск")));
	Если ЗначениеЗаполнено(Подготовка.Ошибка) Тогда
		Результат.Ошибка = Подготовка.Ошибка;
		Возврат Результат;
	КонецЕсли;
	ПоказатьСообщенияОбработчика(Подготовка.Сообщения);
	ПараметрыДиалога.НачальныйЗапрос = Подготовка.Промт;
	ДанныеКонтекстаЗапуска = Подготовка.ДанныеКонтекста;
	Файлы = Подготовка.Файлы;

	// Вложения подсистемы привязаны к диалогу, а прикладная операция диалога
	// не создает: ей выдается технический UUID без записи. Поэтому запуск идет
	// диалоговым путем — заодно пользователь может открыть переписку целиком.
	Попытка
		ИдентификаторДиалогаЗапуска = AI_ДиалогиКлиентСервер.СоздатьДиалог(
			НастройкиДиалогаЗапуска(ПараметрыДиалога));
	Исключение
		Результат.Ошибка = "Не удалось создать диалог запуска: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	СписокВложений = Новый Массив;
	Представления = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		// Файл уходит модели настоящим вложением через штатный конвейер
		// подсистемы: разбирать его средствами конфигурации не требуется.
		Попытка
			Адрес = ПоместитьВоВременноеХранилище(Файл.Содержимое, УникальныйИдентификатор);
			// СохранитьВложение отдает описание для формы, а операция принимает
			// массив ссылок — берем из описания именно ссылку.
			Сохраненное = AI_Вложения.СохранитьВложение(
				Файл.ИмяФайла,
				Адрес,
				ИдентификаторДиалогаЗапуска,
				ПараметрыДиалога.Сценарий.Провайдер);
		Исключение
			Результат.Ошибка = "Не удалось подготовить вложение: " + ОписаниеОшибки();
			Возврат Результат;
		КонецПопытки;
		СписокВложений.Добавить(Сохраненное.Ссылка);
		Представления.Добавить(Файл.Представление);
	КонецЦикла;
	Результат.Файл = Лев(СтрСоединить(Представления, "; "), 250);

	// Имя «Параметры» в модуле формы занято параметрами самой формы:
	// присваивание в него валится с «Поле объекта недоступно для записи».
	ПараметрыОперации = AI_ПубличныйAPI.ПараметрыВыполнения();
	ПараметрыОперации.Сценарий = ПараметрыДиалога.Сценарий;
	ПараметрыОперации.Промт = ПараметрыДиалога.НачальныйЗапрос;
	ПараметрыОперации.ДанныеКонтекста = ДанныеКонтекстаЗапуска;
	ПараметрыОперации.Вложения = СписокВложений;
	ПараметрыОперации.КонтекстJSON = ПараметрыДиалога.КонтекстJSON;
	ПараметрыОперации.ВерсияКонтекста = ПараметрыДиалога.ВерсияКонтекста;
	ПараметрыОперации.ТипИсточника = ПараметрыДиалога.ТипИсточника;
	ПараметрыОперации.КлючИсточника = ПараметрыДиалога.КлючИсточника;
	ПараметрыОперации.ПредставлениеИсточника = ПараметрыДиалога.ПредставлениеИсточника;
	ПараметрыОперации.Вставить("ИдентификаторДиалога", ИдентификаторДиалогаЗапуска);

	Попытка
		Запуск = AI_АгентскиеОперации.НачатьОперацию(ПараметрыОперации);
		Результат.ИдентификаторОперации = Запуск.ИдентификаторОперации;
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Начинает разговор: заводит диалог, кладет в его контекст задание, данные
// объекта и ответы на вопросы, прикладывает файлы и просит модель начать.
&НаСервере
Функция НачатьДиалогНаСервере()

	Результат = Новый Структура("ИдентификаторОперации,Ошибка", ПустойУникальныйИдентификатор(), "");
	Контекст = КонтекстФормы();
	Попытка
		ПараметрыДиалога = AI_ИнтерфейсныеСценарии.ПодготовитьПараметрыДиалога(
			ТекущееМестоЗапуска, Контекст, НачальныйЗапросВыбранного);
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Части = Новый Массив;
	Части.Добавить(ПараметрыДиалога.ДанныеКонтекста);
	Файлы = Новый Массив;
	ОтветыДляОбработчика = Новый Массив;
	Для Каждого Ответ Из СобранныеУточнения Цикл
		ЗначениеОтвета = Ответ.ЗначениеТекстом;
		Если Ответ.ПередаватьСодержимое И ЗначениеЗаполнено(Ответ.Ключ) Тогда
			Файл = НайтиФайлУточнения(Ответ, Контекст, Ложь);
			Если Не Файл.Успех Тогда
				Результат.Ошибка = Файл.Причина;
				Возврат Результат;
			КонецЕсли;
			Файлы.Добавить(Файл);
			ЗначениеОтвета = Файл.Представление;
		КонецЕсли;
		Части.Добавить(Ответ.Представление + ": " + ЗначениеОтвета);
		ОтветыДляОбработчика.Добавить(Новый Структура("Представление,Значение",
			Ответ.Представление, ЗначениеОтвета));
	КонецЦикла;
	Попытка
		ДанныеОбъекта = AI_ИнтерфейсныеСценарии.ДанныеОбъектаДляМодели(ТекущееМестоЗапуска, Контекст);
	Исключение
		Результат.Ошибка = "Не удалось прочитать данные объекта: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	Если ЗначениеЗаполнено(ДанныеОбъекта) Тогда
		Части.Добавить(ДанныеОбъекта);
	КонецЕсли;
	Части.Добавить(AI_ИнтерфейсныеСценарии.ЗаданиеДиалога(ТекущееМестоЗапуска));
	ДанныеКонтекстаДиалога = СтрСоединить(Части, Символы.ПС + Символы.ПС);

	// Обработчик места вправе подать разговору свой файл и дописать контекст.
	// Первое сообщение без его правки пересчитывается: файл, поданный
	// обработчиком, модель должна изучить так же, как выбранный человеком.
	ПервоеСообщение = ТекстНачалаДиалога(Файлы.Количество() > 0);
	Подготовка = AI_ПрименениеРекомендаций.ПодготовитьЗапрос(ТекущееМестоЗапуска, Контекст,
		Новый Структура("Промт,ДанныеКонтекста,Файлы,Ответы,Режим",
			ПервоеСообщение, ДанныеКонтекстаДиалога, Файлы, ОтветыДляОбработчика, "Разговор"));
	Если ЗначениеЗаполнено(Подготовка.Ошибка) Тогда
		Результат.Ошибка = Подготовка.Ошибка;
		Возврат Результат;
	КонецЕсли;
	ПоказатьСообщенияОбработчика(Подготовка.Сообщения);
	ДанныеКонтекстаДиалога = Подготовка.ДанныеКонтекста;
	Файлы = Подготовка.Файлы;
	Если Подготовка.Промт = ПервоеСообщение Тогда
		ПервоеСообщение = ТекстНачалаДиалога(Файлы.Количество() > 0);
	Иначе
		ПервоеСообщение = Подготовка.Промт;
	КонецЕсли;

	Настройки = НастройкиДиалогаЗапуска(ПараметрыДиалога);
	Настройки.ДанныеКонтекста = ДанныеКонтекстаДиалога;
	Попытка
		Идентификатор = AI_ДиалогиКлиентСервер.СоздатьДиалог(Настройки);
	Исключение
		Результат.Ошибка = "Не удалось создать диалог: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	ИдентификаторДиалогаРежима = Строка(Идентификатор);
	ПредыдущийIDОтветаДиалога = "";
	ИсторияДиалога = "";

	Вложения = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Попытка
			Адрес = ПоместитьВоВременноеХранилище(Файл.Содержимое, УникальныйИдентификатор);
			Сохраненное = AI_Вложения.СохранитьВложение(
				Файл.ИмяФайла, Адрес, Идентификатор, ПараметрыДиалога.Сценарий.Провайдер);
		Исключение
			Результат.Ошибка = "Не удалось подготовить вложение: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
		КонецПопытки;
		Вложения.Добавить(Сохраненное.Ссылка);
	КонецЦикла;

	Возврат ОтправитьВДиалог(ПервоеСообщение, Вложения, Ложь);

КонецФункции

// Сообщения обработчика этапа — человеку: например, «взят скан от 12.03,
// более новой версии нет».
&НаСервере
Процедура ПоказатьСообщенияОбработчика(Сообщения)

	Для Каждого Текст Из Сообщения Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
	КонецЦикла;

КонецПроцедуры

// Первое сообщение — за человека: модель сама говорит, что соберет, и задает
// первый вопрос, а при файле сначала предлагает то, что взяла из него.
&НаСервереБезКонтекста
Функция ТекстНачалаДиалога(ЕстьФайлы)

	Текст = "Начни разговор: одной-двумя фразами скажи, что мы собираем, и задай первый вопрос.";
	Если ЕстьФайлы Тогда
		Текст = Текст + " Сначала изучи приложенный файл и предложи то, что уже можно взять из него.";
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаСервере
Функция ОтправитьВДиалогНаСервере(Текст)

	Возврат ОтправитьВДиалог(Текст, Новый Массив, Истина);

КонецФункции

// Ход разговора — обычная операция в том же диалоге, но без сценария: схема
// ответа не нужна, модель отвечает текстом. Агент, модель и провайдер — из
// сценария места запуска, доступ к агенту проверяет сама операция.
&НаСервере
Функция ОтправитьВДиалог(Текст, Вложения, ПоказатьВИстории)

	Результат = Новый Структура("ИдентификаторОперации,Ошибка", ПустойУникальныйИдентификатор(), "");
	ПараметрыОперации = ПараметрыХодаДиалога(Текст);
	ПараметрыОперации.Вставить("Вложения", Вложения);
	Попытка
		Запуск = AI_АгентскиеОперации.НачатьОперацию(ПараметрыОперации);
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	Если ПоказатьВИстории Тогда
		ДобавитьВИсторию("Вы", Текст);
	КонецЕсли;
	ЭтапДиалога = "Разговор";
	Результат.ИдентификаторОперации = Запуск.ИдентификаторОперации;
	Возврат Результат;

КонецФункции

// Итог разговора: та же операция в том же диалоге, но со сценарием — он дает
// схему ответа, и модель возвращает результат по карте с учетом всей переписки.
&НаСервере
Функция СформироватьИтогДиалогаНаСервере()

	Результат = Новый Структура("ИдентификаторОперации,Ошибка", ПустойУникальныйИдентификатор(), "");
	Если Не ЗначениеЗаполнено(ИдентификаторДиалогаРежима) Тогда
		Результат.Ошибка = "Разговор еще не начат.";
		Возврат Результат;
	КонецЕсли;
	ПараметрыОперации = ПараметрыХодаДиалога(AI_ИнтерфейсныеСценарии.ЗапросИтогаДиалога());
	ПараметрыОперации.Вставить("Сценарий", ТекущееМестоЗапуска.Сценарий);
	Попытка
		Запуск = AI_АгентскиеОперации.НачатьОперацию(ПараметрыОперации);
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	ЭтапДиалога = "Итог";
	Результат.ИдентификаторОперации = Запуск.ИдентификаторОперации;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПараметрыХодаДиалога(Текст)

	Сценарий = ТекущееМестоЗапуска.Сценарий;
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ИдентификаторДиалога", Новый УникальныйИдентификатор(ИдентификаторДиалогаРежима));
	ПараметрыОперации.Вставить("Провайдер", Сценарий.Провайдер);
	ПараметрыОперации.Вставить("Модель", Сценарий.Модель);
	ПараметрыОперации.Вставить("Агент", Сценарий.Агент);
	ПараметрыОперации.Вставить("ТипAPI", Сценарий.ТипAPI);
	ПараметрыОперации.Вставить("Промт", Текст);
	ПараметрыОперации.Вставить("ДанныеКонтекста", ДанныеКонтекстаДиалога);
	ПараметрыОперации.Вставить("РежимДиалога", Истина);
	ПараметрыОперации.Вставить("ГлубинаДиалога", 40);
	ПараметрыОперации.Вставить("ПредыдущийIDОтвета", ПредыдущийIDОтветаДиалога);
	ПараметрыОперации.Вставить("КонтекстJSON", КонтекстJSON);
	ПараметрыОперации.Вставить("ВерсияКонтекста", 1);
	ПараметрыОперации.Вставить("ТипИсточника", ТипИсточника);
	ПараметрыОперации.Вставить("КлючИсточника", КлючИсточника);
	ПараметрыОперации.Вставить("ПредставлениеИсточника", ПредставлениеИсточника);
	Возврат ПараметрыОперации;

КонецФункции

// Ответ модели на ход разговора — в историю. Ошибку тоже пишем туда: иначе
// человек не поймет, почему на его вопрос никто не ответил.
&НаСервере
Функция ПроверитьХодДиалога()

	Результат = Новый Структура("Финальная,Статус", Истина, "");
	Попытка
		Состояние = AI_ПубличныйAPI.ПолучитьСостояние(ИдентификаторОперации);
	Исключение
		Результат.Статус = "Сбой при получении ответа: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	Результат.Финальная = Состояние.Финальная;
	Если Не Состояние.Финальная Тогда
		Результат.Статус = "Модель отвечает: " + Состояние.ТекстСтатуса;
		Возврат Результат;
	КонецЕсли;
	Если Не Состояние.Успешно Тогда
		ДобавитьВИсторию("Ошибка", Состояние.ТекстОшибки);
		Результат.Статус = "Модель не ответила: " + Состояние.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	ДобавитьВИсторию("Помощник", Строка(Состояние.Результат));
	Если ЗначениеЗаполнено(Состояние.НовыйIDОтвета) Тогда
		ПредыдущийIDОтветаДиалога = Состояние.НовыйIDОтвета;
	КонецЕсли;
	Результат.Статус = "Ответьте модели или нажмите «Сформировать результат», когда все обсудите.";
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ДобавитьВИсторию(Кто, Текст)

	Реплика = Кто + ": " + ТекстБезРазметки(СокрЛП(Текст));
	ИсторияДиалога = ?(ЗначениеЗаполнено(ИсторияДиалога),
		ИсторияДиалога + Символы.ПС + Символы.ПС + Реплика, Реплика);

КонецПроцедуры

// В текстовом поле разметку никто не отрисует: «**Итог:**» так и видно со
// звездочками. Переписка с разметкой — по кнопке «Открыть диалог».
&НаСервереБезКонтекста
Функция ТекстБезРазметки(Текст)

	Строки = Новый Массив;
	Для Каждого СтрокаТекста Из СтрРазделить(СтрЗаменить(Текст, "**", ""), Символы.ПС, Истина) Цикл
		// Строка-разделитель таблицы «|---|---|»: столбцы и без нее читаются.
		Остаток = СокрЛП(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрокаТекста, "|", ""), "-", ""), ":", ""));
		Если СтрНачинаетсяС(СокрЛ(СтрокаТекста), "|") И Не ЗначениеЗаполнено(Остаток) Тогда
			Продолжить;
		КонецЕсли;
		Очищенная = СтрокаТекста;
		Пока СтрНачинаетсяС(Очищенная, "#") Цикл
			Очищенная = Сред(Очищенная, 2);
		КонецЦикла;
		Строки.Добавить(?(Очищенная = СтрокаТекста, СтрокаТекста, СокрЛ(Очищенная)));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Настройки беседы для запуска из мастера: их же увидит пользователь,
// если откроет диалог, чтобы посмотреть переписку целиком.
&НаСервере
Функция НастройкиДиалогаЗапуска(ПараметрыДиалога)

	Сценарий = ПараметрыДиалога.Сценарий;
	Возврат Новый Структура(
		"Сценарий,Провайдер,Модель,Агент,ТипAPI,ДанныеКонтекста,КонтекстJSON,ВерсияКонтекста,ТипИсточника,КлючИсточника,ПредставлениеИсточника",
		Сценарий,
		Сценарий.Провайдер,
		Сценарий.Модель,
		Сценарий.Агент,
		Сценарий.ТипAPI,
		ПараметрыДиалога.ДанныеКонтекста,
		ПараметрыДиалога.КонтекстJSON,
		ПараметрыДиалога.ВерсияКонтекста,
		ПараметрыДиалога.ТипИсточника,
		ПараметрыДиалога.КлючИсточника,
		ПараметрыДиалога.ПредставлениеИсточника);

КонецФункции

// Находит прикладной файл, выбранный в уточнении, и читает его содержимое.
// Содержимое ядро получает само: из реквизита-хранилища либо через
// переопределяемый модуль. Разбор файла конфигурацией не нужен.
//
// При автовыборе файл берется по отбору уточнения, а не первый попавшийся:
// порядок расширений в отборе и есть приоритет.
//
// Возвращает структуру: Успех, Содержимое, ИмяФайла, Представление, Причина.
&НаСервере
Функция НайтиФайлУточнения(Ответ, Контекст, АвтоВыбор)

	Результат = Новый Структура("Успех,Содержимое,ИмяФайла,Представление,Причина",
		Ложь, Неопределено, "", "", "");

	Описание = ОписаниеУточнения(Ответ.НомерСтрокиУточнения);
	Если Описание = Неопределено Тогда
		Результат.Причина = "Уточнение с файлом больше не доступно.";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Список = AI_ИзвлечениеРеквизитов.ПолучитьВариантыУточнения(Описание, Контекст);
	Исключение
		Результат.Причина = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Выбранный = Неопределено;
	Если АвтоВыбор Тогда
		Выбранный = AI_ИзвлечениеРеквизитов.ВыбратьВариантАвтоматически(Список, Описание.ОтборЗначение);
	Иначе
		Для Каждого СтрокаИсточника Из Список Цикл
			Если Строка(СтрокаИсточника.Ссылка.УникальныйИдентификатор()) = Ответ.Ключ Тогда
				Выбранный = СтрокаИсточника;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Выбранный = Неопределено Тогда
		Результат.Причина = ?(АвтоВыбор,
			AI_ИзвлечениеРеквизитов.ТекстНетВариантов(Описание),
			"Выбранный файл больше не доступен.");
		Возврат Результат;
	КонецЕсли;

	Содержимое = AI_ИзвлечениеРеквизитов.ПолучитьСодержимоеВложения(Выбранный.Ссылка, Описание);
	Если Не Содержимое.Получено Тогда
		Результат.Причина = Содержимое.Причина;
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Содержимое = Содержимое.Содержимое;
	Результат.ИмяФайла = Содержимое.ИмяФайла;
	Результат.Представление = Выбранный.Представление;
	Возврат Результат;

КонецФункции

// Выполняет действие, объявленное на месте запуска. Для вида «Заполнить форму»
// ядро только возвращает план — подставляет значения уже клиентская часть.
&НаСервере
Функция ВыполнитьДействиеНаСервере(ОтветПользователя, СостояниеШага)

	Результат = Новый Структура(
		"План,Обработано,Отклонено,Ошибка,Сообщения,ЕстьПродолжение,ТекстПродолжения,Состояние"
			+ ",СледующееМесто,СледующееПредставление,СледующаяПричина,СозданныйОбъект,ПредставлениеСозданного",
		Новый Массив, 0, 0, "", Новый Массив, Ложь, "", СостояниеШага,
		Неопределено, "", "", Неопределено, "");

	// Типизированные значения берем из свежего разбора ответа: на форме лежат
	// только представления. Разбираем один раз на все заполнение.
	Разобранное = Неопределено;
	Если ЗначениеЗаполнено(ТекущееМестоЗапуска.КартаИзвлечения) И ЗначениеЗаполнено(ТекстОтвета) Тогда
		Попытка
			Разобранное = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(
				ТекущееМестоЗапуска.КартаИзвлечения,
				ТекстОтвета,
				КонтекстРазбора());
		Исключение
			Результат.Ошибка = "Не удалось разобрать ответ модели: " + ОписаниеОшибки();
			Возврат Результат;
		КонецПопытки;
	КонецЕсли;
	Если Разобранное = Неопределено Тогда
		Результат.Ошибка = "Нет разобранного ответа модели — заполнять нечего.";
		Возврат Результат;
	КонецЕсли;

	Значения = Новый ТаблицаЗначений;
	Значения.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	Значения.Колонки.Добавить("Значение");
	Значения.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Значения.Колонки.Добавить("ТабличнаяЧасть", Новый ОписаниеТипов("Строка"));
	Значения.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));

	// В ядро уходят только отмеченные и распознанные строки. Соответствие
	// «ключ -> реквизит» ядро берет из карты само, клиентский путь не в счет.
	//
	// Строки сопоставляются по порядку, а не по ключу: у табличной части ключ
	// один на все строки, и поиск по нему свел бы двадцать строк договора в
	// одну. Порядок детерминирован — оба разбора идут по одной карте и одному
	// ответу, — но на всякий случай ключ сверяется.
	Индекс = -1;
	Для Каждого СтрокаТаблицы Из Рекомендации Цикл
		Индекс = Индекс + 1;
		Если Не СтрокаТаблицы.Применить Или Не СтрокаТаблицы.Распознано Тогда
			Продолжить;
		КонецЕсли;
		Если Индекс >= Разобранное.Количество() Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРазбора = Разобранное[Индекс];
		Если СтрокаРазбора.Ключ <> СтрокаТаблицы.Ключ Тогда
			// Карту изменили между анализом и применением: соответствие строк
			// потеряно, и применять наугад нельзя.
			Результат.Сообщения.Добавить(СтрокаТаблицы.Представление
				+ ": карта извлечения изменилась после анализа, строка пропущена.");
			Продолжить;
		КонецЕсли;

		СтрокаЗначения = Значения.Добавить();
		СтрокаЗначения.Ключ = СтрокаТаблицы.Ключ;
		СтрокаЗначения.Значение = СтрокаРазбора.Значение;
		СтрокаЗначения.Представление = СтрокаРазбора.Представление;
		СтрокаЗначения.ТабличнаяЧасть = СтрокаРазбора.ТабличнаяЧасть;
		СтрокаЗначения.НомерСтроки = СтрокаРазбора.НомерСтроки;
	КонецЦикла;

	Попытка
		Действие = AI_ПрименениеРекомендаций.ВыполнитьДействие(
			ТекущееМестоЗапуска,
			КонтекстФормы(),
			Значения,
			ШагДействия,
			СостояниеШага,
			ОтветПользователя);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Результат.План = Действие.План;
	Результат.Обработано = Действие.Обработано;
	Результат.Отклонено = Действие.Отклонено;
	Результат.Ошибка = Действие.Ошибка;
	Если Действие.СозданныйОбъект <> Неопределено Тогда
		Результат.СозданныйОбъект = Действие.СозданныйОбъект;
		Результат.ПредставлениеСозданного = Строка(Действие.СозданныйОбъект);
	КонецЕсли;
	Для Каждого Сообщение Из Действие.Сообщения Цикл
		Результат.Сообщения.Добавить(Сообщение);
	КонецЦикла;

	Результат.Состояние = Действие.Состояние;

	Если Действие.СледующееДействие <> Неопределено Тогда
		Результат.СледующееМесто = Действие.СледующееДействие.МестоЗапуска;
		Результат.СледующееПредставление = Действие.СледующееДействие.Представление;
		Результат.СледующаяПричина = Действие.СледующееДействие.Причина;
	КонецЕсли;

	Если Действие.Продолжение <> Неопределено Тогда
		Результат.ЕстьПродолжение = ПоказатьПродолжениеНаСервере(Действие.Продолжение);
		Если Не Результат.ЕстьПродолжение Тогда
			Результат.Ошибка = "Обработчик запросил шаг, который помощник"
				+ " пока не умеет показывать: " + ВидПродолжения;
		Иначе
			Результат.ТекстПродолжения = Элементы.ПояснениеУточнения.Заголовок;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Готовит страницу под шаг, который запросил обработчик. Словарь видов тот же,
// что у декларативных уточнений, поэтому новых страниц не требуется.
&НаСервере
Функция ПоказатьПродолжениеНаСервере(Продолжение)

	ВидПродолжения = "";
	ПродолжениеОбязательное = Ложь;
	Если ТипЗнч(Продолжение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Вид = "";
	Продолжение.Свойство("ВидУточнения", Вид);
	ВидПродолжения = СокрЛП(Строка(Вид));
	Продолжение.Свойство("Обязательное", ПродолжениеОбязательное);

	ВариантыУточнения.Очистить();
	УточнениеСтрока = "";
	УточнениеЧисло = 0;
	УточнениеДата = '00010101';
	УточнениеФлаг = Ложь;

	Подсказка = "";
	Продолжение.Свойство("Подсказка", Подсказка);
	Если Не ЗначениеЗаполнено(Подсказка) Тогда
		Продолжение.Свойство("Представление", Подсказка);
	КонецЕсли;
	Элементы.ПояснениеУточнения.Заголовок = Строка(Подсказка);

	Если ВидПродолжения = "Вопрос" Тогда
		// Показывается диалогом, страница не нужна.
		Возврат Истина;
	КонецЕсли;

	Если ВидПродолжения = "ОжиданиеЗаписи" Тогда
		// Страницы нет: шаг ждет человека в форме объекта, а не в помощнике.
		Возврат Истина;
	КонецЕсли;

	Если ВидПродолжения = "ВыборИзВариантов" Тогда
		Варианты = Неопределено;
		Продолжение.Свойство("Варианты", Варианты);
		Если ТипЗнч(Варианты) <> Тип("Массив") Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого Вариант Из Варианты Цикл
			СтрокаТаблицы = ВариантыУточнения.Добавить();
			Ключ = "";
			Представление = "";
			Вариант.Свойство("Ключ", Ключ);
			Вариант.Свойство("Представление", Представление);
			СтрокаТаблицы.Ключ = Строка(Ключ);
			СтрокаТаблицы.Представление = ?(ЗначениеЗаполнено(Представление),
				Строка(Представление), Строка(Ключ));
		КонецЦикла;
		Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Элементы.ВидСписок;
	ИначеЕсли ВидПродолжения = "ВводСтроки" Тогда
		Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Элементы.ВидСтрока;
	ИначеЕсли ВидПродолжения = "ВводЧисла" Тогда
		Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Элементы.ВидЧисло;
	ИначеЕсли ВидПродолжения = "ВводДаты" Тогда
		Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Элементы.ВидДата;
	ИначеЕсли ВидПродолжения = "Флаг" Тогда
		Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Элементы.ВидФлаг;
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Собирает ответ пользователя на шаг продолжения.
// Возвращает структуру ответа либо строку с текстом ошибки.
&НаКлиенте
Функция СобратьОтветПродолжения()

	Если ВидПродолжения = "ВыборИзВариантов" Тогда
		ТекущиеДанные = Элементы.ВариантыУточнения.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат ?(ВариантыУточнения.Количество() = 0,
				"Обработчик не предложил ни одного варианта.",
				"Выберите вариант.");
		КонецЕсли;
		Возврат Новый Структура("Ключ,Значение,Представление",
			ТекущиеДанные.Ключ, ТекущиеДанные.Ключ, ТекущиеДанные.Представление);
	КонецЕсли;

	Если ВидПродолжения = "ВводСтроки" Тогда
		Если ПродолжениеОбязательное И Не ЗначениеЗаполнено(УточнениеСтрока) Тогда
			Возврат "Заполните значение.";
		КонецЕсли;
		Возврат Новый Структура("Ключ,Значение,Представление",
			"", УточнениеСтрока, УточнениеСтрока);
	КонецЕсли;

	Если ВидПродолжения = "ВводЧисла" Тогда
		Если ПродолжениеОбязательное И Не ЗначениеЗаполнено(УточнениеЧисло) Тогда
			Возврат "Заполните значение.";
		КонецЕсли;
		Возврат Новый Структура("Ключ,Значение,Представление",
			"", УточнениеЧисло, Строка(УточнениеЧисло));
	КонецЕсли;

	Если ВидПродолжения = "ВводДаты" Тогда
		Если ПродолжениеОбязательное И Не ЗначениеЗаполнено(УточнениеДата) Тогда
			Возврат "Заполните дату.";
		КонецЕсли;
		Возврат Новый Структура("Ключ,Значение,Представление",
			"", УточнениеДата, Строка(УточнениеДата));
	КонецЕсли;

	Если ВидПродолжения = "Флаг" Тогда
		Возврат Новый Структура("Ключ,Значение,Представление",
			"", УточнениеФлаг, ?(УточнениеФлаг, "да", "нет"));
	КонецЕсли;

	Возврат "Неизвестный вид шага: " + ВидПродолжения;

КонецФункции

// Опрос состояния не должен ронять форму: любая ошибка становится статусом,
// иначе пользователь видит «непредвиденную ошибку» без единой подсказки.
&НаСервере
Функция ПроверитьСостояниеНаСервере()

	// Ход разговора — это ответ в историю, а не рекомендации.
	Если ЭтапДиалога = "Разговор" Тогда
		Возврат ПроверитьХодДиалога();
	КонецЕсли;

	Результат = Новый Структура("Финальная,Статус", Истина, "");

	Попытка
		Состояние = AI_ПубличныйAPI.ПолучитьСостояние(ИдентификаторОперации);

		Результат.Финальная = Состояние.Финальная;
		Если Не Состояние.Финальная Тогда
			Результат.Статус = "Анализ выполняется: " + Состояние.ТекстСтатуса;
			Возврат Результат;
		КонецЕсли;

		Если Не Состояние.Успешно Тогда
			Результат.Статус = "Анализ завершился с ошибкой: " + Состояние.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;

		// Итог разговора — тоже звено переписки: вернувшись к разговору,
		// модель должна его помнить.
		Если ЗначениеЗаполнено(ЭтапДиалога) И ЗначениеЗаполнено(Состояние.НовыйIDОтвета) Тогда
			ПредыдущийIDОтветаДиалога = Состояние.НовыйIDОтвета;
		КонецЕсли;
		// Обработчик места видит ответ раньше человека: может поправить значения
		// или отклонить ответ целиком.
		Обработка = AI_ПрименениеРекомендаций.ОбработатьОтветМодели(
			ТекущееМестоЗапуска, КонтекстФормы(), Строка(Состояние.Результат));
		Если ЗначениеЗаполнено(Обработка.Ошибка) Тогда
			ТекстОтвета = "";
			Результат.Статус = "Ответ модели отклонен: " + Обработка.Ошибка;
			Возврат Результат;
		КонецЕсли;
		ПоказатьСообщенияОбработчика(Обработка.Сообщения);
		ТекстОтвета = Обработка.ТекстОтвета;
		Результат.Статус = ЗаполнитьРекомендации();
	Исключение
		Результат.Финальная = Истина;
		Результат.Статус = "Сбой при получении результата: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Ставит в очередь по операции на каждый объект контекста.
//
// Ошибка по одному объекту не отменяет остальные: строка помечается неуспешной
// с причиной. Иначе один недоступный файл из тридцати рушил бы весь пакет.
// Псевдоответы на уточнения для массового режима: сами значения подставит
// отбор по объекту, здесь важны только номер строки уточнения и признак
// «передавать содержимое».
// Переход по цепочке — тот же выбор действия, что и руками: место запуска
// перечитывается, доступ проверяется заново, состояние прошлого шага
// сбрасывается. Иначе следующий сценарий унаследовал бы чужие ответы.
&НаСервере
Функция ПерейтиКДействиюНаСервере(МестоЗапуска)

	Результат = Новый Структура("Уточнений,ВидДействия,Ошибка,ЗаголовокДействия,РежимДиалога,ПредставлениеСоздания",
		0, "", "", "", Ложь, "");

	Попытка
		Подготовка = ВыбратьДействиеНаСервере(МестоЗапуска);
	Исключение
		Результат.Ошибка = "Не удалось перейти к следующему действию: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Подготовка.Отказ) Тогда
		Результат.Ошибка = Подготовка.Отказ;
		Возврат Результат;
	КонецЕсли;

	НачальныйЗапросВыбранного = МестоЗапуска.НачальныйЗапрос;
	ЗаполнитьЗначенияСвойств(Результат, Подготовка,
		"Уточнений,ВидДействия,ЗаголовокДействия,РежимДиалога,ПредставлениеСоздания");
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПодготовитьПакетНаСервере(МестоЗапуска)

	Результат = Новый Структура("Адрес,Имя,Ошибка,Сообщения", "", "", "", Новый Массив);

	Попытка
		Пакет = AI_ПакетыСценариев.Выгрузить(МестоЗапуска);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Для Каждого Строка Из Пакет.Состав Цикл
		Результат.Сообщения.Добавить("В пакет вошло — " + Строка);
	КонецЦикла;
	Для Каждого Строка Из Пакет.Предупреждения Цикл
		Результат.Сообщения.Добавить(Строка);
	КонецЦикла;

	Результат.Адрес = ПоместитьВоВременноеХранилище(Пакет.Данные, УникальныйИдентификатор);
	Результат.Имя = Пакет.Имя;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗагрузитьПакетНаСервере(Адрес)

	Результат = Новый Структура("Успешно,Сообщения", Ложь, Новый Массив);

	Попытка
		Итог = AI_ПакетыСценариев.Загрузить(Адрес);
	Исключение
		Результат.Сообщения.Добавить(ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Для Каждого Строка Из Итог.Загружено Цикл
		Результат.Сообщения.Добавить(Строка);
	КонецЦикла;
	Для Каждого Строка Из Итог.Предупреждения Цикл
		Результат.Сообщения.Добавить(Строка);
	КонецЦикла;
	Для Каждого Строка Из Итог.Ошибки Цикл
		Результат.Сообщения.Добавить("Отказ: " + Строка);
	КонецЦикла;

	Результат.Успешно = (Итог.Ошибки.Количество() = 0);
	Если Результат.Успешно Тогда
		Результат.Сообщения.Добавить(
			"Загруженные места запуска выключены: включите их после проверки.");
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Функция АвтоответыУточнений()

	Ответы = Новый ТаблицаЗначений;
	Ответы.Колонки.Добавить("НомерСтрокиУточнения", Новый ОписаниеТипов("Число"));
	Ответы.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	Ответы.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Ответы.Колонки.Добавить("ЗначениеТекстом", Новый ОписаниеТипов("Строка"));
	Ответы.Колонки.Добавить("ПередаватьСодержимое", Новый ОписаниеТипов("Булево"));

	Номер = 0;
	Для Каждого Уточнение Из ТекущееМестоЗапуска.Уточнения Цикл
		Номер = Номер + 1;
		Если Не ЗначениеЗаполнено(Уточнение.ИсточникДанных) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаОтвета = Ответы.Добавить();
		СтрокаОтвета.НомерСтрокиУточнения = Номер;
		СтрокаОтвета.Представление = Уточнение.Представление;
		СтрокаОтвета.ЗначениеТекстом = "выбрано отбором";
		СтрокаОтвета.ПередаватьСодержимое = Уточнение.ПередаватьСодержимое;
	КонецЦикла;

	Возврат Ответы;

КонецФункции

&НаСервере
Функция ЗапуститьПакетНаСервере()

	Результат = Новый Структура("Ошибка", "");
	Пакет.Очистить();

	Попытка
		Контексты = AI_ИнтерфейсныеСценарии.КонтекстыОбъектов(КонтекстФормы());
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если Контексты.Количество() = 0 Тогда
		Результат.Ошибка = "В контексте нет объектов, по которым можно запустить пакет.";
		Возврат Результат;
	КонецЕсли;

	Запущено = 0;
	Для Каждого КонтекстОбъекта Из Контексты Цикл
		СтрокаПакета = Пакет.Добавить();
		СтрокаПакета.Представление = КонтекстОбъекта.ПредставлениеИсточника;
		СтрокаПакета.ПолноеИмя = КонтекстОбъекта.ПолноеИмяМетаданных;
		СтрокаПакета.Ключ = КонтекстОбъекта.КлючИсточника;

		// Отбор места запуска проверяется по каждому объекту: в пачку могли
		// попасть и те, к которым действие не относится. Молча пропускать их
		// нельзя — человек должен видеть, почему объект не обработан.
		Если Не AI_ИзвлечениеРеквизитов.ПроверитьОтборыКонтекста(
				ТекущееМестоЗапуска, КонтекстОбъекта) Тогда
			СтрокаПакета.Готово = Истина;
			СтрокаПакета.Состояние = "Пропущен: объект не подходит под отбор действия";
			Продолжить;
		КонецЕсли;

		Попытка
			Запуск = ЗапуститьНаСервере(КонтекстОбъекта, Истина);
		Исключение
			СтрокаПакета.Готово = Истина;
			СтрокаПакета.Состояние = "Не удалось запустить: " + ОписаниеОшибки();
			Продолжить;
		КонецПопытки;

		Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
			СтрокаПакета.Готово = Истина;
			СтрокаПакета.Состояние = Запуск.Ошибка;
			Продолжить;
		КонецЕсли;

		СтрокаПакета.Идентификатор = Строка(Запуск.ИдентификаторОперации);
		СтрокаПакета.Файл = Запуск.Файл;
		СтрокаПакета.Состояние = "В очереди";
		Запущено = Запущено + 1;
	КонецЦикла;

	ОбновитьПояснениеПакета();

	Если Запущено = 0 Тогда
		Результат.Ошибка = "Ни одну операцию пакета запустить не удалось."
			+ " Причины по объектам — в списке.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сколько объектов пачки уже разобрано. Без счетчика длинная пачка выглядит
// зависшей, а строки с ошибкой легко пропустить среди готовых.
&НаСервере
Процедура ОбновитьПояснениеПакета()

	Готово = 0;
	БезРезультата = 0;
	Для Каждого СтрокаПакета Из Пакет Цикл
		Если Не СтрокаПакета.Готово Тогда
			Продолжить;
		КонецЕсли;
		Готово = Готово + 1;
		Если Не СтрокаПакета.Успешно Тогда
			БезРезультата = БезРезультата + 1;
		КонецЕсли;
	КонецЦикла;

	Текст = СтрШаблон("Обработано %1 из %2", Готово, Пакет.Количество());
	Если БезРезультата > 0 Тогда
		Текст = Текст + СтрШаблон(", без результата: %1", БезРезультата);
	КонецЕсли;
	Элементы.ПояснениеПакета.Заголовок = Текст
		+ ". Объекты обрабатываются по одному через очередь."
		+ " Откройте строку, чтобы проверить и применить результат.";

КонецПроцедуры

// Опрашивает незавершенные операции пакета. Возвращает, сколько осталось.
//
// Опрос заодно двигает очередь: ПолучитьСостояние обслуживает очередь своего
// пользователя, поэтому пакет идет и там, где регламентное задание не работает.
&НаСервере
Функция ОбновитьПакетНаСервере()

	Осталось = 0;
	Для Каждого СтрокаПакета Из Пакет Цикл
		Если СтрокаПакета.Готово Или Не ЗначениеЗаполнено(СтрокаПакета.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Состояние = AI_ПубличныйAPI.ПолучитьСостояние(
				Новый УникальныйИдентификатор(СтрокаПакета.Идентификатор));
		Исключение
			СтрокаПакета.Готово = Истина;
			СтрокаПакета.Состояние = "Сбой при получении состояния: " + ОписаниеОшибки();
			Продолжить;
		КонецПопытки;

		Если Не Состояние.Финальная Тогда
			СтрокаПакета.Состояние = Состояние.ТекстСтатуса;
			Осталось = Осталось + 1;
			Продолжить;
		КонецЕсли;

		СтрокаПакета.Готово = Истина;
		Если Не Состояние.Успешно Тогда
			СтрокаПакета.Состояние = "Ошибка: " + Состояние.ТекстОшибки;
			Продолжить;
		КонецЕсли;

		// Обработчик ответа — по каждому объекту пачки, со своим контекстом.
		Обработка = AI_ПрименениеРекомендаций.ОбработатьОтветМодели(
			ТекущееМестоЗапуска, КонтекстСтрокиПакета(СтрокаПакета), Строка(Состояние.Результат));
		Если ЗначениеЗаполнено(Обработка.Ошибка) Тогда
			СтрокаПакета.Состояние = "Ответ модели отклонен: " + Обработка.Ошибка;
			Продолжить;
		КонецЕсли;
		СтрокаПакета.Успешно = Истина;
		СтрокаПакета.ТекстОтвета = Обработка.ТекстОтвета;
		СтрокаПакета.Состояние = "Готово, результат можно проверить"
			+ ?(Обработка.Сообщения.Количество() > 0, ". " + СтрСоединить(Обработка.Сообщения, " "), "");
	КонецЦикла;

	ОбновитьПояснениеПакета();

	Возврат Осталось;

КонецФункции

// Делает выбранный объект пакета текущим: контекст формы переключается на него,
// а рекомендации разбираются из его ответа. Дальше работает обычный одиночный
// путь — те же проверки и то же действие.
&НаСервере
Функция ОткрытьСтрокуПакетаНаСервере(ИдентификаторСтроки)

	СтрокаПакета = Пакет.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаПакета = Неопределено Тогда
		Возврат "Строка пакета не найдена.";
	КонецЕсли;

	ПолноеИмяМетаданных = СтрокаПакета.ПолноеИмя;
	ТипИсточника = СтрокаПакета.ПолноеИмя;
	КлючИсточника = СтрокаПакета.Ключ;
	ПредставлениеИсточника = СтрокаПакета.Представление;
	КонтекстПредставление = СтрокаПакета.Представление;
	КоличествоОбъектов = 1;
	ТекстОтвета = СтрокаПакета.ТекстОтвета;
	// По ней «Открыть диалог» найдет переписку именно этого объекта.
	ИдентификаторОперации = Новый УникальныйИдентификатор(СтрокаПакета.Идентификатор);

	Возврат ЗаполнитьРекомендации();

КонецФункции

&НаСервере
Функция ЗаполнитьРекомендации()

	Рекомендации.Очистить();
	Карта = ТекущееМестоЗапуска.КартаИзвлечения;
	Если Не ЗначениеЗаполнено(Карта) Тогда
		// Раскладывать ответ не по чему: это текст — вывод, сводка, замечания.
		Элементы.ТекстОтветаМодели.Видимость = Истина;
		Элементы.Рекомендации.Видимость = Ложь;
		Возврат "Анализ завершен. Ответ модели — ниже.";
	КонецЕсли;

	Попытка
		Таблица = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(Карта, ТекстОтвета, КонтекстРазбора());
		AI_ИзвлечениеРеквизитов.ДополнитьТекущимиЗначениями(Таблица, КонтекстРазбора());
	Исключение
		Возврат "Не удалось разобрать ответ модели: " + ОписаниеОшибки();
	КонецПопытки;
	// Существующие строки, обновляемые по номеру, отмечаются как реквизиты
	// шапки — только изменения. Дописываемые и заменяемые строки — все.
	ОбновлениеСтрок = Карта.ОбновлятьСтрокиПоНомеру;

	Распознано = 0;
	Отмечено = 0;
	Для Каждого СтрокаИсточника Из Таблица Цикл
		СтрокаТаблицы = Рекомендации.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаИсточника);
		СтрокаТаблицы.ЗначениеСтрокой = ПредставлениеЗначения(СтрокаИсточника.Значение);
		СтрокаТаблицы.ТекущееЗначение = ПредставлениеЗначения(СтрокаИсточника.ТекущееЗначение);

		// Отмечается то, что изменит объект: совпадающее значение применять
		// незачем, а человеку проще проверить пять изменений, чем двадцать строк.
		// Строки табличной части отмечаются все — при замене строк часть
		// собирается заново, и неотмеченная строка из нее пропала бы.
		// Записи без подтверждения нет в любом случае.
		СтрокаТЧ = ЗначениеЗаполнено(СтрокаИсточника.ТабличнаяЧасть) И Не ОбновлениеСтрок;
		СтрокаТаблицы.Применить = СтрокаИсточника.Распознано
			И (СтрокаИсточника.Изменится Или СтрокаТЧ);
		Если СтрокаИсточника.Распознано И Не СтрокаИсточника.Изменится И Не СтрокаТЧ Тогда
			СтрокаТаблицы.Комментарий = "Совпадает с текущим значением.";
		КонецЕсли;

		Если СтрокаИсточника.Распознано Тогда
			Распознано = Распознано + 1;
		КонецЕсли;
		Если СтрокаТаблицы.Применить Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;

	// Ни одного значения — почти всегда не тот файл или файл без текста.
	// Сказать это прямо лучше, чем показывать таблицу пустых строк.
	Если Распознано = 0 И Рекомендации.Количество() > 0 Тогда
		Возврат "Анализ завершен, но в документе не нашлось ни одного реквизита из карты."
			+ " Проверьте, тот ли файл выбран и есть ли в нем текст.";
	КонецЕсли;

	Виды = Перечисления.AI_ВидДействия;
	ВидДействия = ТекущееМестоЗапуска.ВидДействия;
	Если ВидДействия = Виды.ЗаполнитьФорму Тогда
		Хвост = " Проверьте значения и нажмите «Заполнить форму».";
	ИначеЕсли ВидДействия = Виды.ЗаписатьОбъект Тогда
		Хвост = " Проверьте значения и нажмите «Записать в объект».";
	ИначеЕсли ВидДействия = Виды.СоздатьОбъект Тогда
		Хвост = " Проверьте значения и нажмите «Создать».";
	ИначеЕсли ВидДействия = Виды.ПользовательскоеДействие
		Или ВидДействия = Виды.ВнешнийОбработчик Тогда
		Хвост = " Проверьте значения и нажмите «Выполнить действие».";
	Иначе
		Хвост = " Действие с результатом не настроено — значения только показаны.";
	КонецЕсли;

	Возврат СтрШаблон(
		"Анализ завершен. Распознано реквизитов: %1 из %2, изменится: %3.%4",
		Распознано,
		Рекомендации.Количество(),
		Отмечено,
		Хвост);

КонецФункции

// Значение так, как его прочтет человек: дата без нулевого времени, флаг
// словом. «15.03.2026 0:00:00» в договоре не пишут.
&НаСервереБезКонтекста
Функция ПредставлениеЗначения(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат "";
		КонецЕсли;
		Возврат Формат(Значение, ?(НачалоДня(Значение) = Значение, "ДЛФ=D", "ДЛФ=DT"));
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	КонецЕсли;
	Возврат Лев(Строка(Значение), 500);

КонецФункции

&НаСервере
Функция ПодготовитьПараметрыДиалогаНаСервере(МестоЗапуска)
	Возврат AI_ИнтерфейсныеСценарии.ПодготовитьПараметрыДиалога(
		МестоЗапуска,
		КонтекстФормы(),
		НачальныйЗапросВыбранного);
КонецФункции

&НаСервере
Функция ПодготовитьОбработкуБСПНаСервере()

	Возврат Новый Структура(
		"Адрес,Имя",
		AI_ИнтерфейсныеСценарии.АдресВстроеннойОбработкиБСП(УникальныйИдентификатор),
		AI_ИнтерфейсныеСценарии.ИмяФайлаВстроеннойОбработкиБСП());

КонецФункции

// Имя «Заголовок» в модуле формы — это заголовок самой формы, поэтому пишем в
// него явно через ЭтаФорма: локальная переменная с таким именем однажды уже
// стерла заголовок окна.
&НаСервере
Процедура УстановитьЗаголовокОкна(ПредставлениеДействия)

	Основа = "AI-помощник";
	Если ЗначениеЗаполнено(ПредставлениеДействия) Тогда
		ЭтаФорма.Заголовок = Основа + ": " + СокрЛП(Строка(ПредставлениеДействия));
	Иначе
		ЭтаФорма.Заголовок = Основа;
	КонецЕсли;

КонецПроцедуры

// Вид действия уходит на клиент строкой: сравнивать строки проще, чем
// вызывать ПредопределенноеЗначение на каждую перерисовку кнопки.
&НаСервереБезКонтекста
Функция ВидДействияСтрокой(ВидДействия)

	Виды = Перечисления.AI_ВидДействия;
	Если ВидДействия = Виды.ЗаполнитьФорму Тогда
		Возврат "ЗаполнитьФорму";
	ИначеЕсли ВидДействия = Виды.ЗаписатьОбъект Тогда
		Возврат "ЗаписатьОбъект";
	ИначеЕсли ВидДействия = Виды.СоздатьОбъект Тогда
		Возврат "СоздатьОбъект";
	ИначеЕсли ВидДействия = Виды.ПользовательскоеДействие Тогда
		Возврат "ПользовательскоеДействие";
	ИначеЕсли ВидДействия = Виды.ВнешнийОбработчик Тогда
		Возврат "ВнешнийОбработчик";
	КонецЕсли;
	Возврат "ТолькоПоказать";

КонецФункции

&НаСервереБезКонтекста
Функция ПустойУникальныйИдентификатор()

	Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");

КонецФункции

// Контекст для разбора ответа и текущих значений. Новый объект — не объект
// контекста: сравнивать предложенное с шаблоном, из карточки которого
// позвали помощника, значило бы показать чужие «текущие» значения.
&НаСервере
Функция КонтекстРазбора()

	Если ТекущееМестоЗапуска.ВидДействия = Перечисления.AI_ВидДействия.СоздатьОбъект Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КонтекстФормы();

КонецФункции

// Контекст одного объекта пачки — для обработчика его ответа: объект тот же,
// что ушел модели, а не контекст списка, из которого запускали пачку.
&НаСервере
Функция КонтекстСтрокиПакета(СтрокаПакета)
	Возврат Новый Структура(
		"ТипМеста,ПолноеИмяМетаданных,ТипИсточника,КлючИсточника,ПредставлениеИсточника,КонтекстJSON,ДанныеКонтекста,КоличествоОбъектов",
		"Объект",
		СтрокаПакета.ПолноеИмя,
		СтрокаПакета.ПолноеИмя,
		СтрокаПакета.Ключ,
		СтрокаПакета.Представление,
		"",
		"",
		1);
КонецФункции

&НаСервере
Функция КонтекстФормы()
	Возврат Новый Структура(
		"ТипМеста,ПолноеИмяМетаданных,ТипИсточника,КлючИсточника,ПредставлениеИсточника,КонтекстJSON,ДанныеКонтекста,КоличествоОбъектов",
		ТипМеста,
		ПолноеИмяМетаданных,
		ТипИсточника,
		КлючИсточника,
		ПредставлениеИсточника,
		КонтекстJSON,
		ДанныеКонтекста,
		КоличествоОбъектов);
КонецФункции

#КонецОбласти
