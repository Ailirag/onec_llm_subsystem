КонецПроцедуры

Процедура ТестМетаданныхИЗапросов(Результаты)

	Попытка
		Фикстуры = ПолучитьФикстуры();
		Политика = AI_ПолитикиАгента.Получить(Фикстуры.Профиль);
		Поиск = AI_МетаданныеСервер.НайтиОбъекты(
			"контраг",
			Новый Массив,
			20,
			Политика);
		Проверить(Поиск.ok И Поиск.items.Количество() = 1,
			"Поиск метаданных не вернул разрешенный справочник.");

		Объекты = Новый Массив;
		Объекты.Добавить("Справочник.Контрагенты");
		Описание = AI_МетаданныеСервер.Описать(Объекты, "fields", Политика);
		Проверить(Описание.ok И Описание.items.Количество() = 1,
			"Описание метаданных не сформировано.");
		Проверить(Описание.items[0].restricted_field_count = 1,
			"Ограниченное поле ИНН не учтено.");

		ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 5
			|	Контрагенты.Код КАК Код,
			|	Контрагенты.Наименование КАК Наименование
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|УПОРЯДОЧИТЬ ПО
			|	Наименование";
		Параметры = Новый Массив;
		Проверка = AI_БезопасныеЗапросы.ПроверитьЗапрос(ТекстЗапроса, Параметры, Политика);
		Проверить(Проверка.ok, "Корректный запрос отклонен: " + Проверка.error);
		Выполнение = AI_БезопасныеЗапросы.ВыполнитьЗапрос(ТекстЗапроса, Параметры, Политика);
		Проверить(Выполнение.ok И Выполнение.row_count = 5,
			"Корректный запрос не вернул пять строк.");

		ЗапрещенныйЗапрос =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Контрагенты.ИНН КАК ИНН
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты";
		Проверка = AI_БезопасныеЗапросы.ПроверитьЗапрос(
			ЗапрещенныйЗапрос,
			Параметры,
			Политика);
		Проверить(Не Проверка.ok, "Запрос ограниченного поля ИНН должен быть отклонен.");

		НекорректныйЗапрос =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДЛИНА(Контрагенты.Наименование) КАК Длина
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты";
		Проверка = AI_БезопасныеЗапросы.ПроверитьЗапрос(
			НекорректныйЗапрос,
			Параметры,
			Политика);
		Проверить(Не Проверка.ok, "Синтаксически некорректный запрос должен быть отклонен.");

		Подсчет = AI_БезопасныеЗапросы.ПосчитатьЗаписиСправочников(
			Объекты,
			10,
			Истина,
			Политика);
		Проверить(Подсчет.ok И Подсчет.leader.count = 37,
			"Подсчет записей справочника должен вернуть 37.");
		ДобавитьРезультат(
			Результаты,
			"metadata_and_queries",
			Истина,
			"Метаданные, whitelist, restricted field, validate, execute и count работают.");
	Исключение
		ДобавитьОшибкуТеста(Результаты, "metadata_and_queries");
	КонецПопытки;

КонецПроцедуры

