{2,22,4,
{"S","Проведение ЗнР"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,8f6485d2-9e69-45a0-b5de-e9f7e77b3252},
{"B",0},
{"S","
МассивДокументов = Новый Массив;
// Из статуса формирование в согласован
СсылкаФормирование = СсылкаПоНавигации(""e1cib/data/Документ.ЗаявкаНаРасход?ref=bb90bc97e1693b2011eb0c8a255cc6bf"");
СсылкаСогласование = СсылкаПоНавигации(""e1cib/data/Документ.ЗаявкаНаРасход?ref=bb8fbc97e151385b11eb0c822cc93ec4"");

СтруктураПроведение = Новый Структура(""Ссылка"", ""Проведение"", СсылкаФормирование, Истина);

СтруктураПроведение = Новый Структура(""Ссылка"", ""Проведение"", СсылкаФормирование, Ложь);

СтруктураПроведение = Новый Структура(""Ссылка"", ""Проведение"", СсылкаСогласование, Истина);

СтруктураПроведение = Новый Структура(""Ссылка"", ""Проведение"", СсылкаСогласование, Ложь);


МассивДокументов.Добавить(СсылкаФормирование);
МассивДокументов.Добавить(СсылкаСогласование);

Для Каждого Документ Из МассивДокументов Цикл

	ЭтотДокумент = Документ.ПолучитьОбъект();

	ЭтотДокумент.ДополнительныеСвойства.Вставить(""СтатусОбъекта"", Перечисления.СостояниеДокументов.Согласован);
	ЭтотДокумент.ДополнительныеСвойства.Вставить(""НеКонтролироватьСтатус"", Истина);
	ЭтотДокумент.ДополнительныеСвойства.Вставить(""БезКонтроляЗакрытогоПериода"", Истина);

	ЭтотДокумент.Записать(РежимЗаписиДокумента.Проведение);

КонецЦикла;"},0},
{2,23,4,
{"S","Типовая операция ТМЦКомплектация_КомплектацияППА"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,dddf3527-8d55-49a5-a999-fbf69f032398},
{"B",0},
{"S","СтруктураДопСвойств = Новый Структура(""Родитель, ДокументМетаданные"", Справочники.ТиповыеОперации.ТМЦКомплектация, Метаданные.Документы.ТМЦКомплектация.Имя);

ИмяСправочника = ""ТиповыеОперации"";
ИмяПредопределенныхДанных = ""ТМЦКомплектация_КомплектацияППА"";
НаименованиеНовогоЭлемента = ""Комплектация ППА"";
ЭтоГруппа = Ложь;
УИД = Неопределено;

	Результат = Неопределено;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	
	ПакетЗапроса 	= СхемаЗапроса.ПакетЗапросов[0];
	ОператорЗапроса = ПакетЗапроса.Операторы[0];
	
	ИсточникНоменклатура = ОператорЗапроса.Источники.Добавить(""Справочник."" + ИмяСправочника, ""ВыбранныйСправочник"");
	
	ОператорЗапроса.ВыбираемыеПоля.Добавить(""ВыбранныйСправочник.Ссылка"");
	ОператорЗапроса.Отбор.Добавить(""ВыбранныйСправочник.ИмяПредопределенныхДанных = &ИмяПредопределенныхДанных"");
	
	Запрос = Новый Запрос;
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	Запрос.УстановитьПараметр(""ИмяПредопределенныхДанных"", ИмяПредопределенныхДанных);
	
	ТекстСообщения = """";
	ВидОповещения = Неопределено;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		
		Если НЕ ЭтоГруппа Тогда
			Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
		Иначе
			Элемент = Справочники[ИмяСправочника].СоздатьГруппу();
		КонецЕсли;
		
		ТекстСообщения = "" - Создан новый элемент Справочника """"%1"""", связан с предопредленным значением """"%2""""."";
		ТекстОшибки = "" - Ошибка создания нового элемента Справочника """"%1"""" для привязки к предопредленному значению """"%2""""!""
						+ "" (Описание ошибки: %3)"";
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		
		ТекстСообщения = "" - Обновлен элемент Справочника """"%1"""", связаный с предопредленным значением """"%2""""."";
		ТекстОшибки = "" - Ошибка обновления элемента Справочника """"%1"""", связанного с предопредленным значением """"%2""""!""
						+ "" (Описание ошибки: %3)"";
	КонецЕсли;
	
	Попытка
		
		Если НЕ УИД = Неопределено Тогда
			
			СсылкаПоУИД = Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
			Если НЕ Элемент.Ссылка.Пустая() И НЕ СсылкаПоУИД = Элемент.Ссылка Тогда
				Элемент.ИмяПредопределенныхДанных = """";
				ТекстСообщения = "" - Сменился элемент Справочника """"%1"""", связаный с предопредленным значением """"%2""""."";
				ТекстОшибки = "" - Ошибка смены предопределенного элемента """"%2"""" Справочника """"%1""""!""
								+ "" (Описание ошибки: %3)"";
				Элемент.Записать();
			КонецЕсли;
			
			ОбъектПоУИД = СсылкаПоУИД.ПолучитьОбъект();
			Если ОбъектПоУИД = Неопределено Тогда
				
				Если НЕ Элемент.Ссылка.Пустая() Тогда
					Если НЕ ЭтоГруппа Тогда
						Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
					Иначе
						Элемент = Справочники[ИмяСправочника].СоздатьГруппу();
					КонецЕсли;
				КонецЕсли;
				
				Элемент.УстановитьСсылкуНового(СсылкаПоУИД);
				
			Иначе
				Элемент = ОбъектПоУИД;
			КонецЕсли;
			
		КонецЕсли;
		
		Элемент.Наименование = НаименованиеНовогоЭлемента;
		Элемент.ИмяПредопределенныхДанных = ИмяПредопределенныхДанных;
		Если СтруктураДопСвойств <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Элемент, СтруктураДопСвойств);
		КонецЕсли;
		
		Элемент.Записать();
		
		ТекстСообщения = СтрШаблон(ТекстСообщения, ИмяСправочника, ИмяПредопределенныхДанных);
		ВидОповещения = СтатусСообщения.Информация;
		
		Результат = Элемент.Ссылка;
		
	Исключение
		ТекстСообщения = СтрШаблон(ТекстОшибки, ИмяСправочника, ИмяПредопределенныхДанных, ОписаниеОшибки());
		ВидОповещения = СтатусСообщения.ОченьВажное;
	КонецПопытки;
	
	Сообщить(ТекстСообщения, ВидОповещения);
	
"},0},
{2,24,4,
{"S","удалить сторно движения для пр"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,41cc2c13-e63b-4604-8b3f-3cd5e71105f4},
{"B",0},
{"S","Запрос = Новый Запрос;
Запрос.Текст =
	""ВЫБРАТЬ
|	ПрочаяРеализация.Ссылка КАК Ссылка,
|	НАЧАЛОПЕРИОДА(ПрочаяРеализация.Дата, МЕСЯЦ) КАК ПЕРИОД,
|	ПрочаяРеализация.ДатаБУ КАК ДатаБУ,
|	ПрочаяРеализация.Организация КАК Организация,
|	ПрочаяРеализация.Контрагент КАК Контрагент,
|	ПрочаяРеализация.Сумма КАК Сумма,
|	ПрочаяРеализация.Подразделение КАК ПодразделениеШапки,
|	ПрочаяРеализацияУслуги.Подразделение КАК Подразделение,
|	ПрочаяРеализацияУслуги.Модель КАК Модель,
|	ПрочаяРеализацияУслуги.Сумма КАК СуммаФакт,
|	ПрочаяРеализация.ДоговорКонтрагента КАК Основание,
|	ВЫБОР
|		КОГДА Договоры.ОсновнойДоговор = ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
|			ТОГДА ПрочаяРеализация.ДоговорКонтрагента
|		ИНАЧЕ Договоры.ОсновнойДоговор
|	КОНЕЦ КАК Договор,
|	ПрочаяРеализация.ДокументОснование КАК ДокументОснование,
|	ЗначенияСвойствОбъектовСрезПоследних.Значение КАК ВидНачисления,
|	ПрочаяРеализация.ВидРеализации КАК ВидРеализации
|ПОМЕСТИТЬ ВТ_ПрочаяРеализация
|ИЗ
|	Документ.ПрочаяРеализация КАК ПрочаяРеализация
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПрочаяРеализация.Услуги КАК ПрочаяРеализацияУслуги
|		ПО ПрочаяРеализация.Ссылка = ПрочаяРеализацияУслуги.Ссылка
|			И (ПрочаяРеализация.Проведен)
|			И (ПрочаяРеализация.Дата МЕЖДУ &НачалоПериода И &КонецПериода)
|			И (ПрочаяРеализация.ДатаБУ МЕЖДУ &НачалоПериода И &КонецПериода)
|			И (ПрочаяРеализацияУслуги.ТипТМЦ В (&Субаренда, &ПредоставлениеВАрендуПомещения, &РазмещениеРИМ))
|//			И (&ОтборПоОрганизации)
|//			И ПрочаяРеализацияУслуги.Ссылка = &Ссылка
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов.СрезПоследних(&КонецПериода, Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ИспользуемыйВидНачисленияАренды)) КАК ЗначенияСвойствОбъектовСрезПоследних
|		ПО (ПрочаяРеализацияУслуги.Модель = ЗначенияСвойствОбъектовСрезПоследних.Объект)
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
|		ПО ПрочаяРеализация.ДоговорКонтрагента = Договоры.Ссылка
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	ВТ_ПрочаяРеализация.Ссылка КАК Ссылка,
|	МАКСИМУМ(ВТ_ПрочаяРеализация.ВидНачисления = ЗНАЧЕНИЕ(Справочник.ВидыНачислений.РазмещениеРИМ)) КАК ЕстьРазмещениеРИМ
|ПОМЕСТИТЬ вт_ЕстьРазмещениеРИМ
|ИЗ
|	ВТ_ПрочаяРеализация КАК ВТ_ПрочаяРеализация
|
|СГРУППИРОВАТЬ ПО
|	ВТ_ПрочаяРеализация.Ссылка
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи,
|	СторноДоки.Ссылка КАК Ссылка,
|	ВТ_ПрочаяРеализация.Ссылка КАК ДокументПР,
|	ВТ_ПрочаяРеализация.ПЕРИОД КАК Период,
|	ВТ_ПрочаяРеализация.Организация КАК Организация,
|	ВТ_ПрочаяРеализация.Контрагент КАК Контрагент,
|	ВТ_ПрочаяРеализация.ПодразделениеШапки КАК ПодразделениеШапки,
|	ВТ_ПрочаяРеализация.Подразделение КАК Подразделение,
|	ВТ_ПрочаяРеализация.Модель КАК Модель,
|	СУММА(ВТ_ПрочаяРеализация.СуммаФакт) КАК СуммаФакт,
|	ВТ_ПрочаяРеализация.Основание КАК Основание,
|	ВТ_ПрочаяРеализация.ДокументОснование КАК ДокументОснование,
|	ВТ_ПрочаяРеализация.ВидРеализации КАК ВидРеализации,
|	ВЫБОР
|		КОГДА ВТ_ПрочаяРеализация.ВидНачисления = ЗНАЧЕНИЕ(Справочник.ВидыНачислений.БазоваяАренднаяПлата)
|			ТОГДА ВТ_ПрочаяРеализация.Договор
|		КОГДА вт_ЕстьРазмещениеРИМ.ЕстьРазмещениеРИМ
|			ТОГДА ВТ_ПрочаяРеализация.Основание
|		ИНАЧЕ ВТ_ПрочаяРеализация.Договор
|	КОНЕЦ КАК Договор,
|	ВТ_ПрочаяРеализация.ВидНачисления КАК ВидНачисления,
|	ЕСТЬNULL(ФилиалУчетаЦФОСрезПоследних.Филиал, ЗНАЧЕНИЕ(Справочник.Филиалы.ПустаяСсылка)) КАК ФилиалНачисления
|ПОМЕСТИТЬ ВТ_Сторно
|ИЗ
|	ВТ_ПрочаяРеализация КАК ВТ_ПрочаяРеализация
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сторно.Доки КАК СторноДоки
|		ПО ВТ_ПрочаяРеализация.Ссылка = СторноДоки.Док
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сторно КАК Сторно
|		ПО (СторноДоки.Ссылка = Сторно.Ссылка)
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодразделениеЦФО.СрезПоследних КАК ПодразделениеЦФОСрезПоследних
|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФилиалУчетаЦФО.СрезПоследних КАК ФилиалУчетаЦФОСрезПоследних
|			ПО ПодразделениеЦФОСрезПоследних.ЦФО = ФилиалУчетаЦФОСрезПоследних.ЦФО
|		ПО ВТ_ПрочаяРеализация.ПодразделениеШапки = ПодразделениеЦФОСрезПоследних.Подразделение
|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ЕстьРазмещениеРИМ КАК вт_ЕстьРазмещениеРИМ
|		ПО ВТ_ПрочаяРеализация.Ссылка = вт_ЕстьРазмещениеРИМ.Ссылка
|ГДЕ
