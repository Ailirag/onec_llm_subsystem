КонецПроцедуры

&НаКлиенте
Процедура УведомлениеВТелеграм(Команда)
	
	ЗначенияПроверки = Новый Массив;
	ЗначенияПроверки.Добавить("telegram_chat_id");
	ЗначенияПроверки.Добавить("telegram_api_key");
	
	ЗначенияЗаполнены = Истина;
	
	Для Каждого ЗначениеПроверки Из ЗначенияПроверки Цикл
		
		Если Не ЗначениеЗаполнено(ЭтаФорма[ЗначениеПроверки]) Тогда
			Сообщить(СтрШаблон("Перед активацией необходимо заполнить ""%1"" на вкладке настроки", ЗначениеПроверки));
			ЗначенияЗаполнены = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначенияЗаполнены Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.УведомлениеВТелеграм.Пометка = Не Элементы.УведомлениеВТелеграм.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура ВставкаМассиваСтрок(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаМассиваДанных", ЭтаФорма);
	
	ПоказатьВводСтроки(Оповещение, "", "Введите массив данных", , Истина);
	
КонецПроцедуры


&НаКлиенте
Процедура ВыполнитьБезПредзагрузки(Команда)
	
	ОчиститьСообщения();
	
	ТекущиеДанные = Элементы.ДеревоАлгоритмов.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Код) Тогда
		Успешно = Истина;
		ВыполнитьПроизвольныйКодНаСервереПосредник(ТекущиеДанные.Код, ТекущиеДанные.ИмяАлгоритма, Успешно);
		ЗвуковоеСопровождение();
		ОтправкаУведомленияВТелеграм(Успешно);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СохранитьДерево(Команда)
	СохранитьАлгоритмы();
КонецПроцедуры


&НаКлиенте
Процедура Заменить(Команда)
	
	ТекущиеДанные = Элементы.ДеревоАлгоритмов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.ЭтоГруппа Тогда
		Возврат
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияЗамены", ЭтаФорма);
	
	ПоказатьВопрос(Оповещение, СтрШаблон("Алгоритм назначения ""%1"" уверены?", ТекущиеДанные.ИмяАлгоритма), РежимДиалогаВопрос.ДаНет,,,"Подтвердите");
	
КонецПроцедуры


&НаКлиенте
Процедура УдалитьГруппу(Команда)
	
	ТекущиеДанные = Элементы.ДеревоАлгоритмов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ТекущиеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияУдаленияГруппы", ЭтаФорма);
	
	ПоказатьВопрос(Оповещение, СтрШаблон("Вы действительно хотите удалить группу ""%1"" и все алгоритмы содержащиеся в ней?", ТекущиеДанные.ИмяАлгоритма), РежимДиалогаВопрос.ДаНет,,,"Подтвердите действие");
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьГруппу(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаИмениГруппы", ЭтаФорма);
	
	ПоказатьВводСтроки(Оповещение,"","Введите наименование группы");
	
КонецПроцедуры


&НаКлиенте
Процедура УдалитьАлгоритм(Команда)
	
	ТекущиеДанные	= Элементы.ДеревоАлгоритмов.ТекущиеДанные;
	
	Если ДеревоАлгоритмов.ПолучитьЭлементы().Количество() = 0 ИЛИ ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение		= Новый ОписаниеОповещения("ПослеПодтвержденияУдаления", ЭтаФорма);
	ТекстВопроса	= СтрШаблон("Вы уверены что хотите удалить данный алгоритм (%1) ?", ТекущиеДанные.ИмяАлгоритма);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,," Подтвердите удаление");
	
КонецПроцедуры


&НаКлиенте
Процедура СохранитьТекущийАлгоритм(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаНазванияАлгоритма", ЭтаФорма);
	
	ПоказатьВводСтроки(Оповещение, "");
	
КонецПроцедуры


&НаКлиенте
Процедура ВыполнитьПроизвольныйКод(Команда)
	
	ОчиститьСообщения();
	
	Если СтрНайти(нрег(ПроизвольныйКод.ПолучитьТекст()), "текущийобъект") > 0 И НЕ ЗначениеЗаполнено(Объект.СсылкаНаОбъект) Тогда
		Сообщить("Не выбрана ссылка на объект!");
		Возврат;
	КонецЕсли;	
	
	ВыделенныйТекст = Элементы.ПроизвольныйКод.ВыделенныйТекст;
	
	ТекстВыполнения = ?(ЗначениеЗаполнено(ВыделенныйТекст), ВыделенныйТекст, ПроизвольныйКод.ПолучитьТекст());
	
	Если ЗначениеЗаполнено(ТекстВыполнения) Тогда
		Сохраняемое = ЗначениеВИзСтроки(ТекстВыполнения, Истина);
		Файл = Новый ТекстовыйДокумент;
		Файл.УстановитьТекст(Сохраняемое);
		
		Попытка
			Файл.Записать(ПутьКПоследнемуВыполняемомуКоду);
		Исключение
			Сообщить("Ошибка записи файла last_execution");
		КонецПопытки;
	КонецЕсли;
	
	Успешно = Истина;
	
	ВыполнитьПроизвольныйКодНаСервереПосредник(ТекстВыполнения, , Успешно);
	
	ОтправкаУведомленияВТелеграм(Успешно);
	ПодключитьОбработчикОжидания("ЗвуковоеСопровождение", 0.1, Истина);
	
КонецПроцедуры

&НаСервере
Функция ЗначениеВИзСтроки(Значение, Внуть)
	
	Если Внуть Тогда
		Возврат ЗначениеВСтрокуВнутр(Значение);
	Иначе
		Возврат ЗначениеИзСтрокиВнутр(Значение);
	КонецЕсли;
	
КонецФункции

