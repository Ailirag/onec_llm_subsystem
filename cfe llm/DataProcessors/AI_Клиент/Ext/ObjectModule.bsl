Функция ОтветСодержитОшибкуAPI(Знач ОтветAPI)

	Если ПолучитьПолеОтветаAPI(ОтветAPI, "error") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Статус = ПолучитьПолеОтветаAPI(ОтветAPI, "status");
	Если Статус = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат Число(Статус) >= 400;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ПредставлениеОшибкиAPI(Знач ОтветAPI)

	Статус = ПолучитьПолеОтветаAPI(ОтветAPI, "status");
	ТекстОшибки = ПолучитьПолеОтветаAPI(ОтветAPI, "detail");
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Ошибка = ПолучитьПолеОтветаAPI(ОтветAPI, "error");
		ТекстОшибки = ПолучитьПолеОтветаAPI(Ошибка, "message");
		Если Не ЗначениеЗаполнено(ТекстОшибки) И Ошибка <> Неопределено Тогда
			ТекстОшибки = Строка(Ошибка);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		ТекстОшибки = ПолучитьПолеОтветаAPI(ОтветAPI, "title");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		ТекстОшибки = OPI_Инструменты.JSONСтрокой(ОтветAPI);
	КонецЕсли;
	Если ЗначениеЗаполнено(Статус) Тогда
		Возврат СтрШаблон("HTTP %1: %2", Статус, ТекстОшибки);
	КонецЕсли;
	Возврат Строка(ТекстОшибки);

КонецФункции

Функция ПолучитьПолеОтветаAPI(Знач ОтветAPI, Знач ИмяПоля)

	Если ТипЗнч(ОтветAPI) = Тип("Соответствие") Тогда
		Возврат ОтветAPI.Получить(ИмяПоля);
	ИначеЕсли ТипЗнч(ОтветAPI) = Тип("Структура") Тогда
		ЗначениеПоля = Неопределено;
		Если ОтветAPI.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			Возврат ЗначениеПоля;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция СформироватьКонтекстYandexOCR(Знач РезультатOCR)

	Страницы = Новый Массив;
	Если ТипЗнч(РезультатOCR) = Тип("Массив") Тогда
		Для Каждого РезультатСтраницы Из РезультатOCR Цикл
			Страницы.Добавить(СформироватьСтраницуYandexOCR(РезультатСтраницы));
		КонецЦикла;
	Иначе
		Страницы.Добавить(СформироватьСтраницуYandexOCR(РезультатOCR));
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("source", "Yandex Vision OCR");
	Контекст.Вставить("pages", Страницы);
	Возврат OPI_Инструменты.JSONСтрокой(Контекст);

КонецФункции

Функция СформироватьСтраницуYandexOCR(Знач РезультатСтраницы)

	Аннотация = ПолучитьПолеОтветаAPI(РезультатСтраницы, "textAnnotation");
	Если Аннотация = Неопределено Тогда
		ВызватьИсключение "Yandex Vision OCR вернул страницу без textAnnotation.";
	КонецЕсли;

	Страница = Новый Структура;
	Страница.Вставить("page", ПолучитьПолеОтветаAPI(РезультатСтраницы, "page"));
	Страница.Вставить("width", ПолучитьПолеОтветаAPI(Аннотация, "width"));
	Страница.Вставить("height", ПолучитьПолеОтветаAPI(Аннотация, "height"));
	Страница.Вставить("fullText", ПолучитьПолеОтветаAPI(Аннотация, "fullText"));
	Страница.Вставить("markdown", ПолучитьПолеОтветаAPI(Аннотация, "markdown"));

	КомпактныеБлоки = Новый Массив;
	Блоки = ПолучитьПолеОтветаAPI(Аннотация, "blocks");
	Если ТипЗнч(Блоки) = Тип("Массив") Тогда
		Для Каждого Блок Из Блоки Цикл
			КомпактныйБлок = Новый Структура;
			КомпактныйБлок.Вставить(
				"layoutType", ПолучитьПолеОтветаAPI(Блок, "layoutType"));
			КомпактныйБлок.Вставить(
				"boundingBox", ПолучитьПолеОтветаAPI(Блок, "boundingBox"));

			КомпактныеСтроки = Новый Массив;
			СтрокиБлока = ПолучитьПолеОтветаAPI(Блок, "lines");
			Если ТипЗнч(СтрокиБлока) = Тип("Массив") Тогда
				Для Каждого СтрокаБлока Из СтрокиБлока Цикл
					КомпактнаяСтрока = Новый Структура;
					КомпактнаяСтрока.Вставить(
						"text", ПолучитьПолеОтветаAPI(СтрокаБлока, "text"));
					КомпактнаяСтрока.Вставить(
						"boundingBox", ПолучитьПолеОтветаAPI(СтрокаБлока, "boundingBox"));
					КомпактныеСтроки.Добавить(КомпактнаяСтрока);
				КонецЦикла;
			КонецЕсли;
			КомпактныйБлок.Вставить("lines", КомпактныеСтроки);
			КомпактныеБлоки.Добавить(КомпактныйБлок);
		КонецЦикла;
	КонецЕсли;
	Страница.Вставить("blocks", КомпактныеБлоки);
	Страница.Вставить("tables", ПолучитьПолеОтветаAPI(Аннотация, "tables"));

	Возврат Страница;

КонецФункции

// ИнициализироватьМассивСообщенийChatCompletions
// Строит массив сообщений для /v1/chat/completions.
// При режиме диалога обогащает историей из AI_Диалоги.
Функция ИнициализироватьМассивСообщенийChatCompletions()
	
	СообщениеСистемы = OPI_OpenAI.ПолучитьСообщениеСистемы(_СистемныйПромт);
	СообщениеПользователя = OPI_OpenAI.ПолучитьСообщениеПользователя(_ТекстовыйЗапрос);
	
	ПерваяИтерация = Ложь;
	Если _РежимДиалога И Не ЗначениеЗаполнено(ИдентификаторДиалога) Тогда
		ПолучитьИдентификаторДиалогаChatCompletions();
		ЗаписатьСобытиеДиалога(Перечисления.AI_РольСообщения.system, СообщениеСистемы["content"]);
		ПерваяИтерация = Истина;
	КонецЕсли;
	
	Сообщения = Новый Массив;
	Сообщения.Добавить(СообщениеСистемы);
	ОбогатитьСообщенияИсторией(ПерваяИтерация, Сообщения);
	ОбогатитьСообщенияДополнительнымКонтекстом(Сообщения);
	
	Сообщения.Добавить(СообщениеПользователя);
	
	Возврат Сообщения;
	
КонецФункции

// ИнициализироватьМассивСообщенийResponses
// В Responses API при первом запросе — передаём системный промт + сообщение пользователя.
// При последующих запросах диалога (previous_response_id заполнен) — только новое сообщение.
// Дополнительный контекст вставляется как отдельные сообщения пользователя.
