// Флаг тестового обработчика — булев параметр действия места. Пустое имя
// снимает все флаги.
Процедура УстановитьФлагМеста(Место, ИмяФлага)

	ОбъектМеста = Место.Ссылка.ПолучитьОбъект();
	ОбъектМеста.ПараметрыДействия.Очистить();
	Если ЗначениеЗаполнено(ИмяФлага) Тогда
		Параметр = ОбъектМеста.ПараметрыДействия.Добавить();
		Параметр.Имя = ИмяФлага;
		Параметр.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Булево;
		Параметр.Значение = "Истина";
	КонецЕсли;
	ОбъектМеста.Записать();

