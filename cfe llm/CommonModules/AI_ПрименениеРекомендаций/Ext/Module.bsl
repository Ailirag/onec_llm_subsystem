// Применение рекомендаций модели к прикладным данным.
//
// Что именно делать с результатом, решает не код помощника, а настройка:
// у места запуска есть вид действия. Встроенных видов три, четвертый —
// точка расширения для прикладных сценариев:
//
//   ТолькоПоказать           — ничего не делать, показать значения;
//   ЗаполнитьФорму           — вернуть план, форма подставит значения сама
//                              и оставит объект незаписанным;
//   ЗаписатьОбъект           — записать значения в объект в транзакции;
//   СоздатьОбъект            — создать новый элемент или документ того вида,
//                              на который настроена карта, и записать его;
//   ПользовательскоеДействие — вызвать AI_ДействияПереопределяемый;
//   ВнешнийОбработчик        — выполнить внешнюю обработку из реестра БСП,
//                              то есть добавить действие без обновления
//                              конфигурации.
//
// Общая часть у всех видов — план: что и в какой реквизит можно положить.
// План строится по карте извлечения, которая перечитывается здесь заново,
// поэтому пути, пришедшие с клиента, ни на что не влияют.
//
// Табличные части и реквизиты через точку сознательно не поддержаны:
// в них нет однозначной строки. Такой путь отклоняется явно.

#Область ПрограммныйИнтерфейс

// Строит план применения, ничего не меняя.
//
// Значения — таблица с колонками Ключ и Значение: что предложила модель.
//
// Возвращает таблицу с колонками Ключ, Представление, ПутьРеквизита,
// Значение, Применимо, Причина.
Функция ПодготовитьПлан(МестоЗапуска, Контекст, Значения) Экспорт

	ПроверитьДоступностьМеста(МестоЗапуска);
	Возврат СформироватьПлан(МестоЗапуска, Контекст, Значения);

КонецФункции

// Выполняет действие, объявленное на месте запуска.
//
// Шаг, Состояние и ОтветПользователя поддерживают многошаговые действия:
// обработчик вправе не завершиться, а попросить уточнение у пользователя.
// Тогда он возвращает Продолжение, форма его показывает и зовет действие
// снова со следующим шагом. Состояние между шагами обработчик хранит сам —
// ядро только переносит его туда и обратно.
//
// Возвращает структуру:
//   ВидДействия  — что было сделано;
//   План         — массив структур ПутьРеквизита, Значение, Представление;
//                  для вида ЗаполнитьФорму это то, что должна подставить форма;
//   Обработано   — сколько строк применено на сервере (для ЗаполнитьФорму — 0);
//   Отклонено    — сколько строк не прошло проверку;
//   Ошибка       — текст отказа, если действие не выполнено;
//   Сообщения    — построчные причины отказов;
//   Продолжение  — описание следующего шага либо Неопределено. Вид шага —
//                  вид уточнения («Вопрос», «ВводСтроки», «ВыборИзВариантов»,
//                  «ВводЧисла», «ВводДаты», «Флаг») либо «ОжиданиеЗаписи»:
//                  последний ничего не спрашивает, а ждет, пока объект
//                  запишет человек, и только потом идет следующий шаг;
//   Состояние    — что обработчик просит вернуть ему на следующем шаге;
//   СледующееДействие — место запуска, которым обработчик предлагает продолжить,
//                  либо Неопределено. Структура: МестоЗапуска, Причина;
//   СозданныйОбъект — ссылка на объект, созданный видом «Создать объект».
Функция ВыполнитьДействие(МестоЗапуска, Контекст, Значения,
		Шаг = 1, Состояние = Неопределено, ОтветПользователя = Неопределено) Экспорт

	Результат = Новый Структура(
		"ВидДействия,План,Обработано,Отклонено,Ошибка,Сообщения,Продолжение,Состояние,СледующееДействие,СозданныйОбъект",
		Неопределено, Новый Массив, 0, 0, "", Новый Массив, Неопределено, Состояние, Неопределено,
		Неопределено);

	ПроверитьДоступностьМеста(МестоЗапуска);
	ВидДействия = МестоЗапуска.ВидДействия;
	Результат.ВидДействия = ВидДействия;

	Виды = Перечисления.AI_ВидДействия;
	Если Не ЗначениеЗаполнено(ВидДействия) Или ВидДействия = Виды.ТолькоПоказать Тогда
		Результат.Ошибка = "Для этого действия применение результата не настроено.";
		Возврат Результат;
	КонецЕсли;

	// Проверка кодом — на входе в действие. Следующие шаги многошагового
	// действия ведет сам обработчик: он и решает, продолжать ли.
	Если Шаг = 1 Тогда
		Проверка = ПроверитьДоступность(МестоЗапуска, Контекст, "ПередДействием");
		Если Не Проверка.Доступно Тогда
			Результат.Ошибка = ?(ЗначениеЗаполнено(Проверка.Причина), Проверка.Причина,
				"Действие сейчас недоступно: его запретила проверка настройки.");
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	План = СформироватьПлан(МестоЗапуска, Контекст, Значения);
	Пригодные = План.НайтиСтроки(Новый Структура("Применимо", Истина));
	Результат.Отклонено = План.Количество() - Пригодные.Количество();
	Для Каждого СтрокаПлана Из План Цикл
		Если Не СтрокаПлана.Применимо И ЗначениеЗаполнено(СтрокаПлана.Причина) Тогда
			Результат.Сообщения.Добавить(
				СтрокаПлана.Представление + ": " + СтрокаПлана.Причина);
		КонецЕсли;
	КонецЦикла;

	Если ВидДействия = Виды.ЗаполнитьФорму Тогда
		// Формы конкретной конфигурации подсистеме недоступны, поэтому
		// значения подставляет вызывающая форма, а здесь только план.
		РежимСтрок = РежимСтрокКарты(МестоЗапуска);
		Для Каждого СтрокаПлана Из Пригодные Цикл
			Результат.План.Добавить(Новый Структура(
				"ПутьРеквизита,Значение,Представление,ТабличнаяЧасть,НомерСтроки,Свойство,ЗаменятьСтроки,ОбновлятьСтроки",
				СтрокаПлана.ПутьРеквизита,
				СтрокаПлана.Значение,
				СтрокаПлана.Представление,
				СтрокаПлана.ТабличнаяЧасть,
				СтрокаПлана.НомерСтроки,
				СтрокаПлана.Свойство,
				РежимСтрок.Заменять,
				РежимСтрок.Обновлять));
		КонецЦикла;
		Если Результат.План.Количество() = 0 Тогда
			Результат.Ошибка = "Нет значений, пригодных для заполнения формы.";
		КонецЕсли;
	ИначеЕсли ВидДействия = Виды.ЗаписатьОбъект Тогда
		ЗаписатьОбъект(МестоЗапуска, Контекст, Пригодные, Результат);
	ИначеЕсли ВидДействия = Виды.СоздатьОбъект Тогда
		СоздатьОбъект(МестоЗапуска, Пригодные, Результат);
	ИначеЕсли ВидДействия = Виды.ПользовательскоеДействие Тогда
		ВыполнитьПользовательскоеДействие(
			МестоЗапуска, Контекст, План, Шаг, ОтветПользователя, Результат);
	ИначеЕсли ВидДействия = Виды.ВнешнийОбработчик Тогда
		ВыполнитьВнешнийОбработчик(
			МестоЗапуска, Контекст, План, Шаг, ОтветПользователя, Результат);
	Иначе
		Результат.Ошибка = "Вид действия не поддержан ядром: " + Строка(ВидДействия);
		Возврат Результат;
	КонецЕсли;

	// После действия — только когда оно закончено и удалось: у многошагового
	// следующий шаг еще впереди, а после отказа прикладывать и запускать нечего.
	Если Не ЗначениеЗаполнено(Результат.Ошибка) И Результат.Продолжение = Неопределено Тогда
		ВыполнитьПослеДействия(МестоЗапуска, Контекст, План, Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Последняя точка перед моделью: файлы и данные собраны, модель еще не вызвана.
// Обработчик вправе подать свой файл — например, выбрать присоединенный файл
// документа по своему алгоритму, — дописать данные и запрос или отказать.
//
// Вход — Структура:
//   Промт           - Строка - запрос к модели;
//   ДанныеКонтекста - Строка - данные объекта и ответы на вопросы;
//   Файлы           - Массив из Структура - ИмяФайла, Содержимое (ДвоичныеДанные),
//                     Представление: что уйдет модели вложениями;
//   Ответы          - Массив из Структура - Представление, Значение: ответы на вопросы;
//   Режим           - Строка - "Запуск", "Пачка" (по объекту пачки) или "Разговор".
//
// Возвращает структуру: Промт, ДанныеКонтекста, Файлы, Сообщения, Ошибка.
Функция ПодготовитьЗапрос(МестоЗапуска, Контекст, Вход) Экспорт

	Результат = Новый Структура("Промт,ДанныеКонтекста,Файлы,Сообщения,Ошибка",
		Вход.Промт, Вход.ДанныеКонтекста, Вход.Файлы, Новый Массив, "");

	Параметры = ПараметрыВызоваОбработчика(МестоЗапуска, Контекст, Неопределено);
	Параметры.Вставить("Этап", "ПодготовкаЗапроса");
	Параметры.Вставить("Режим", Вход.Режим);
	Параметры.Вставить("Промт", Вход.Промт);
	Параметры.Вставить("ДанныеКонтекста", Вход.ДанныеКонтекста);
	Параметры.Вставить("Файлы", Вход.Файлы);
	Параметры.Вставить("Ответы", Вход.Ответы);
	Параметры.Вставить("Отказ", Ложь);
	Параметры.Вставить("Причина", "");

	Попытка
		ВыполнитьЭтап(МестоЗапуска, "ПодготовкаЗапроса", Параметры);
	Исключение
		Результат.Ошибка = "Обработчик подготовки запроса не выполнен: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьОшибкуЭтапа(МестоЗапуска, "ПодготовкаЗапроса", ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	ДобавитьСообщенияЭтапа(Параметры, Результат.Сообщения);
	Если Параметры.Отказ Тогда
		Результат.Ошибка = ?(ЗначениеЗаполнено(Параметры.Причина), Строка(Параметры.Причина),
			"Обработчик отказал в запуске, не указав причину.");
		Возврат Результат;
	КонецЕсли;

	// Файл без имени или содержимого уйдет модели пустым, и она ответит пустыми
	// строками — такой ответ легко принять за «в документе ничего нет».
	Если ТипЗнч(Параметры.Файлы) <> Тип("Массив") Тогда
		Результат.Ошибка = "Обработчик подготовки запроса вернул файлы не массивом.";
		Возврат Результат;
	КонецЕсли;
	Для Каждого Файл Из Параметры.Файлы Цикл
		Если ТипЗнч(Файл) <> Тип("Структура")
			Или Не Файл.Свойство("ИмяФайла") Или Не ЗначениеЗаполнено(Файл.ИмяФайла)
			Или Не Файл.Свойство("Содержимое") Или ТипЗнч(Файл.Содержимое) <> Тип("ДвоичныеДанные") Тогда
			Результат.Ошибка = "Обработчик подготовки запроса вернул файл без имени или содержимого:"
				+ " нужна структура ИмяФайла, Содержимое (двоичные данные), Представление.";
			Возврат Результат;
		КонецЕсли;
		Если Не Файл.Свойство("Представление") Или Не ЗначениеЗаполнено(Файл.Представление) Тогда
			Файл.Вставить("Представление", Файл.ИмяФайла);
		КонецЕсли;
	КонецЦикла;

	Результат.Промт = Строка(Параметры.Промт);
	Результат.ДанныеКонтекста = Строка(Параметры.ДанныеКонтекста);
	Результат.Файлы = Параметры.Файлы;
	Возврат Результат;

КонецФункции

// Ответ модели до того, как его увидит человек: обработчик вправе поправить
// значения, добавить предупреждения или отклонить ответ целиком.
//
// Правится сам ответ, а не таблица рекомендаций: ответ разбирается дважды —
// для показа и заново при применении, — и правка должна дойти до обоих.
// Поэтому обработчик получает разобранный JSON (Ответ) и ключи карты (Ключи:
// «Реквизит», «ТабличнаяЧасть.Колонка», «Свойство.Наименование» -> ключ в ответе),
// а ядро собирает из него новый текст, только если что-то изменилось.
//
// Возвращает структуру: ТекстОтвета, Сообщения, Ошибка (ответ отклонен).
Функция ОбработатьОтветМодели(МестоЗапуска, Контекст, ТекстОтвета) Экспорт

	Результат = Новый Структура("ТекстОтвета,Сообщения,Ошибка", ТекстОтвета, Новый Массив, "");

	Ответ = ОтветМоделиДляОбработчика(ТекстОтвета);
	До = ?(Ответ = Неопределено, "", ЗаписатьОтветМодели(Ответ));

	Параметры = ПараметрыВызоваОбработчика(МестоЗапуска, Контекст, Неопределено);
	Параметры.Вставить("Этап", "ПослеОтвета");
	Параметры.Вставить("ТекстОтвета", ТекстОтвета);
	Параметры.Вставить("Ответ", Ответ);
	Параметры.Вставить("Ключи", КлючиКарты(МестоЗапуска.КартаИзвлечения));
	Параметры.Вставить("Отказ", Ложь);
	Параметры.Вставить("Причина", "");

	Попытка
		ВыполнитьЭтап(МестоЗапуска, "ПослеОтвета", Параметры);
	Исключение
		Результат.Ошибка = "Обработчик ответа модели не выполнен: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьОшибкуЭтапа(МестоЗапуска, "ПослеОтвета", ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	ДобавитьСообщенияЭтапа(Параметры, Результат.Сообщения);
	Если Параметры.Отказ Тогда
		Результат.Ошибка = ?(ЗначениеЗаполнено(Параметры.Причина), Строка(Параметры.Причина),
			"Обработчик отклонил ответ модели, не указав причину.");
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Параметры.Ответ) = Тип("Соответствие") Тогда
		После = ЗаписатьОтветМодели(Параметры.Ответ);
		Если После <> До Тогда
			Результат.ТекстОтвета = После;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Если Строка(Параметры.ТекстОтвета) <> ТекстОтвета Тогда
		Результат.ТекстОтвета = Строка(Параметры.ТекстОтвета);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Истина, если имя годится в метод обработчика: буквы, цифры, подчеркивание,
// не с цифры. Нужна проверке настройки — иначе опечатка всплывет при запуске.
Функция ИмяМетодаДопустимо(ИмяМетода) Экспорт

	Попытка
		ПроверитьИмяМетода(СокрЛП(ИмяМетода));
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Адаптер конфигурации: обработка, которая знает типы значений этой
// конфигурации, недоступные ядру, — например, полные роли Документооборота.
// Задается константой AI_АдаптерКонфигурации: наименование обработки из реестра
// БСП либо «Обработка.<Имя>».
//
// Контракт обработки:
//   ОбрабатываемыеТипы() - Массив из Строка - полные имена типов («Справочник.ПолныеРоли»);
//   ЗначенияДляВыбора(Параметры) - заполняет Параметры.Значения массивом структур
//       Представление, Пояснение: что предложить модели;
//   НайтиЗначение(Параметры) - по Параметры.Текст заполняет Значение, Найдено,
//       Комментарий.
// Параметры обоих методов: ПолноеИмяОбъекта, ТабличнаяЧасть, ПутьРеквизита,
// ТипыСсылки (Массив из Строка — типы поля, которые обрабатывает адаптер).
//
// Возвращает массив полных имен типов, пустой — адаптера нет или он недоступен.
Функция ТипыАдаптераКонфигурации() Экспорт

	Адаптер = АдаптерКонфигурации();
	Возврат ?(Адаптер = Неопределено, Новый Массив, Адаптер.Типы);

КонецФункции

// Кэш адаптера живет весь серверный вызов. Сменили константу в том же вызове
// (автотест, загрузка настроек) — кэш нужно сбросить, иначе ядро продолжит
// работать со старым адаптером.
Процедура СброситьКэшАдаптераКонфигурации() Экспорт

	AI_ПовторноеИспользование.КэшАдаптераКонфигурации().Очистить();

КонецПроцедуры

// Вызывает метод адаптера: «ЗначенияДляВыбора» или «НайтиЗначение». Ложь —
// адаптера нет. Сбой адаптера — исключение: молча ответить «не найдено» значит
// спрятать настоящую причину от того, кто будет разбирать отказ.
Функция ВызватьАдаптерКонфигурации(ИмяМетода, Параметры) Экспорт

	Адаптер = АдаптерКонфигурации();
	Если Адаптер = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ВызватьМетодОбработки(Адаптер.Обработка, ИмяМетода, Параметры);
	Возврат Истина;

КонецФункции

// Какой объект создает вид «Создать объект»: тот, на который настроена карта,
// а если карта годится для любого — объект места запуска. Пустая строка —
// создавать нечего.
Функция ОбъектСоздания(МестоЗапуска) Экспорт

	Карта = МестоЗапуска.КартаИзвлечения;
	Если ЗначениеЗаполнено(Карта) Тогда
		ИмяКарты = СокрЛП(Карта.ПолноеИмяМетаданных);
		Если ЗначениеЗаполнено(ИмяКарты) И ИмяКарты <> "*" Тогда
			Возврат ИмяКарты;
		КонецЕсли;
	КонецЕсли;
	ИмяМеста = СокрЛП(МестоЗапуска.ПолноеИмяМетаданных);
	Возврат ?(ИмяМеста = "*", "", ИмяМеста);

КонецФункции

// Проверяет, доступно ли действие, кодом внешней обработки.
//
// Декларативные отборы контекста остаются дешевым путем для простых условий.
// Этот вход — для сложных: этап показывает, где именно нас спрашивают, и
// один метод обработки обслуживает все точки проверки.
//
// Этап — "ВыборДействия" | "ПередШагом" | "ПередДействием".
//
// Возвращает структуру Доступно, Причина. Упавшая проверка не ломает помощника:
// она трактуется как отказ, а причина уходит в журнал.
Функция ПроверитьДоступность(МестоЗапуска, Контекст, Этап,
		План = Неопределено, Состояние = Неопределено) Экспорт

	Результат = Новый Структура("Доступно,Причина", Истина, "");

	Если Не ЗначениеЗаполнено(МестоЗапуска) Или МестоЗапуска.ПометкаУдаления Тогда
		Результат.Доступно = Ложь;
		Результат.Причина = "Место запуска недоступно.";
		Возврат Результат;
	КонецЕсли;

	ИмяОбработчика = СокрЛП(МестоЗапуска.Обработчик);
	ИмяМетода = СокрЛП(МестоЗапуска.МетодПроверки);
	ЕстьВнешняя = ЗначениеЗаполнено(ИмяОбработчика) И ЗначениеЗаполнено(ИмяМетода);

	Попытка
		ПараметрыВызова = ПараметрыВызоваОбработчика(МестоЗапуска, Контекст, План);
		ПараметрыВызова.Вставить("ЭтапПроверки", Строка(Этап));
		ПараметрыВызова.Вставить("Состояние", Состояние);
		ПараметрыВызова.Вставить("Доступно", Истина);
		ПараметрыВызова.Вставить("Причина", "");

		// Сначала конфигурация, потом внешняя обработка: запрет, объявленный
		// в конфигурации, внешней настройкой не снимается.
		AI_ДействияПереопределяемый.ПриПроверкеДоступности(ПараметрыВызова);
		Если ПараметрыВызова.Доступно И ЕстьВнешняя Тогда
			Обработка = ПодключитьОбработчик(ИмяОбработчика);
			ВызватьМетодОбработки(Обработка, ИмяМетода, ПараметрыВызова);
		КонецЕсли;
	Исключение
		// Отказ проверки не должен ломать список действий пользователю.
		Результат.Доступно = Ложь;
		Результат.Причина = "Проверка доступности не выполнена.";
		ЗаписьЖурналаРегистрации(
			"AI.ПрименениеРекомендаций",
			УровеньЖурналаРегистрации.Ошибка,
			,
			МестоЗапуска,
			СтрШаблон("Проверка «%1.%2» на этапе «%3» завершилась ошибкой: %4",
				ИмяОбработчика, ИмяМетода, Строка(Этап), ОписаниеОшибки()));
		Возврат Результат;
	КонецПопытки;

	Результат.Доступно = ПараметрыВызова.Доступно;
	Результат.Причина = Строка(ПараметрыВызова.Причина);
	Возврат Результат;

КонецФункции

// Методы, которые обработка предлагает для настройки места запуска.
//
// Перечислить экспортные методы платформенными средствами нельзя: метаданные
// не хранят состав модуля, рефлексии над BSL нет. Поэтому список берется из
// самоописания обработки — необязательной функции СведенияОДействияхLLM.
// Нет функции — возвращается пустая таблица, и настройщику остаются
// стандартные имена и ручной ввод.
//
// Истина, если обработка с таким именем есть в реестре дополнительных
// обработок и не отключена. Нужна проверке настройки: опечатка в имени
// обработчика иначе всплывет только при первом применении.
Функция ОбработчикЗарегистрирован(ИмяОбработчика) Экспорт

	Если Не ЗначениеЗаполнено(СокрЛП(ИмяОбработчика)) Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяКонфигурации = ИмяОбработкиКонфигурации(ИмяОбработчика);
	Если ЗначениеЗаполнено(ИмяКонфигурации) Тогда
		Возврат Метаданные.Обработки.Найти(ИмяКонфигурации) <> Неопределено;
	КонецЕсли;
	Возврат НайтиЗарегистрированнуюОбработку(СокрЛП(ИмяОбработчика)) <> Неопределено;

КонецФункции

// Возвращает таблицу Метод, Представление, Назначение, Описание, Параметры.
Функция ПолучитьМетодыОбработчика(ИмяОбработчика) Экспорт

	Методы = Новый ТаблицаЗначений;
	Методы.Колонки.Добавить("Метод", Новый ОписаниеТипов("Строка"));
	Методы.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Методы.Колонки.Добавить("Назначение", Новый ОписаниеТипов("Строка"));
	Методы.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	Методы.Колонки.Добавить("Параметры", Новый ОписаниеТипов("Строка"));

	Если Не ЗначениеЗаполнено(СокрЛП(ИмяОбработчика)) Тогда
		Возврат Методы;
	КонецЕсли;

	Попытка
		Обработка = ПодключитьОбработчик(СокрЛП(ИмяОбработчика));
		Объявленные = Обработка.СведенияОДействияхLLM();
	Исключение
		// Обработка не найдена либо не описывает себя — это не ошибка.
		Возврат Методы;
	КонецПопытки;

	Если ТипЗнч(Объявленные) <> Тип("ТаблицаЗначений") Тогда
		Возврат Методы;
	КонецЕсли;
	Для Каждого Строка Из Объявленные Цикл
		Новая = Методы.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Строка);
	КонецЦикла;
	Возврат Методы;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Право увидеть рекомендации и право их применить — одно и то же право
// на действие, поэтому доступ к агенту проверяется еще раз.
Процедура ПроверитьДоступностьМеста(МестоЗапуска)

	Если Не ЗначениеЗаполнено(МестоЗапуска) Или МестоЗапуска.ПометкаУдаления Тогда
		ВызватьИсключение "Место запуска недоступно.";
	КонецЕсли;

	РешениеОДоступе = AI_ДоступКАгентамСервер.ОпределитьДоступ(
		ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор,
		МестоЗапуска.Сценарий.Агент);
	Если Не РешениеОДоступе.Разрешен Тогда
		ВызватьИсключение "Нет доступа к агенту сценария: " + РешениеОДоступе.Причина;
	КонецЕсли;
	// Видимость — тоже право: скрытое в списке действие не должно выполняться
	// ни по старой ссылке, ни звеном цепочки.
	Если Не AI_ИнтерфейсныеСценарии.МестоВидноПользователю(МестоЗапуска) Тогда
		ВызватьИсключение "Действие показывается только определенным ролям или группам доступа,"
			+ " и текущему пользователю оно недоступно.";
	КонецЕсли;

КонецПроцедуры

// Этап, на котором в ход действия вмешивается код: сначала конфигурация, потом
// внешняя обработка места запуска — как у проверок: отказ, объявленный
// конфигурацией, внешней настройкой не снимается.
Процедура ВыполнитьЭтап(МестоЗапуска, ИмяЭтапа, Параметры)

	Если ИмяЭтапа = "ПодготовкаЗапроса" Тогда
		AI_ДействияПереопределяемый.ПриПодготовкеЗапроса(Параметры);
	ИначеЕсли ИмяЭтапа = "ПослеОтвета" Тогда
		AI_ДействияПереопределяемый.ПослеОтветаМодели(Параметры);
	ИначеЕсли ИмяЭтапа = "ПослеДействия" Тогда
		AI_ДействияПереопределяемый.ПослеДействия(Параметры);
	КонецЕсли;
	Если Параметры.Свойство("Отказ") И Параметры.Отказ = Истина Тогда
		Возврат;
	КонецЕсли;

	ИмяОбработчика = СокрЛП(МестоЗапуска.Обработчик);
	ИмяМетода = МетодЭтапа(МестоЗапуска, ИмяЭтапа);
	Если ЗначениеЗаполнено(ИмяОбработчика) И ЗначениеЗаполнено(ИмяМетода) Тогда
		Обработка = ПодключитьОбработчик(ИмяОбработчика);
		ВызватьМетодОбработки(Обработка, ИмяМетода, Параметры);
	КонецЕсли;

КонецПроцедуры

Функция МетодЭтапа(МестоЗапуска, ИмяЭтапа)

	Если ИмяЭтапа = "ПодготовкаЗапроса" Тогда
		Возврат СокрЛП(МестоЗапуска.МетодПодготовкиЗапроса);
	ИначеЕсли ИмяЭтапа = "ПослеОтвета" Тогда
		Возврат СокрЛП(МестоЗапуска.МетодПослеОтвета);
	ИначеЕсли ИмяЭтапа = "ПослеДействия" Тогда
		Возврат СокрЛП(МестоЗапуска.МетодПослеДействия);
	КонецЕсли;
	Возврат "";

КонецФункции

// Действие уже выполнено: сбой обработки после него не отменяет сделанное,
// но и молчать о нем нельзя — человек должен знать, что файл не приложен или
// процесс не запущен.
Процедура ВыполнитьПослеДействия(МестоЗапуска, Контекст, План, Результат)

	Параметры = ПараметрыВызоваОбработчика(МестоЗапуска, Контекст, План);
	Параметры.Вставить("Этап", "ПослеДействия");
	Параметры.Вставить("ВидДействия", Результат.ВидДействия);
	Параметры.Вставить("Применено", Результат.Обработано);
	Параметры.Вставить("Отклонено", Результат.Отклонено);
	Параметры.Вставить("СозданныйОбъект", Результат.СозданныйОбъект);

	Попытка
		ВыполнитьЭтап(МестоЗапуска, "ПослеДействия", Параметры);
	Исключение
		Результат.Сообщения.Добавить("Действие выполнено, но обработка после него не удалась: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьОшибкуЭтапа(МестоЗапуска, "ПослеДействия", ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	ДобавитьСообщенияЭтапа(Параметры, Результат.Сообщения);
	Если Результат.СледующееДействие = Неопределено Тогда
		ПринятьСледующееДействие(МестоЗапуска, Параметры, Результат);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСообщенияЭтапа(Параметры, Сообщения)

	Если ТипЗнч(Параметры.Сообщения) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Сообщение Из Параметры.Сообщения Цикл
		Сообщения.Добавить(Строка(Сообщение));
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьОшибкуЭтапа(МестоЗапуска, ИмяЭтапа, Информация)

	ЗаписьЖурналаРегистрации(
		"AI.ПрименениеРекомендаций",
		УровеньЖурналаРегистрации.Ошибка,
		,
		МестоЗапуска,
		СтрШаблон("Этап «%1» обработчика «%2» завершился ошибкой: %3",
			ИмяЭтапа, СокрЛП(МестоЗапуска.Обработчик), ПодробноеПредставлениеОшибки(Информация)));

КонецПроцедуры

// Ответ для обработчика — разобранный JSON. Текстовый ответ (вывод, сводка)
// обработчик получает строкой в ТекстОтвета, а здесь — Неопределено.
Функция ОтветМоделиДляОбработчика(ТекстОтвета)

	Текст = СокрЛП(Строка(ТекстОтвета));
	Если Не СтрНачинаетсяС(Текст, "{") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Ответ = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(ТипЗнч(Ответ) = Тип("Соответствие"), Ответ, Неопределено);

КонецФункции

Функция ЗаписатьОтветМодели(Ответ)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Ответ);
	Возврат Запись.Закрыть();

КонецФункции

// Где в ответе модели лежит значение поля карты: обработчику не нужно знать,
// какие ключи карта вывела из имен реквизитов.
Функция КлючиКарты(Карта)

	Ключи = Новый Соответствие;
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Возврат Ключи;
	КонецЕсли;
	Для Каждого Поле Из Карта.Поля Цикл
		Ключ = СокрЛП(Поле.Ключ);
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Поле.ДополнительныйРеквизит) Тогда
			Путь = "Свойство." + СокрЛП(Поле.ДополнительныйРеквизит);
		ИначеЕсли ЗначениеЗаполнено(Поле.ТабличнаяЧасть) Тогда
			Путь = СокрЛП(Поле.ТабличнаяЧасть) + "." + СокрЛП(Поле.ПутьРеквизита);
		Иначе
			Путь = СокрЛП(Поле.ПутьРеквизита);
		КонецЕсли;
		Ключи.Вставить(Путь, Ключ);
	КонецЦикла;
	Возврат Ключи;

КонецФункции

// Подключенный адаптер и его типы — один раз за серверный вызов. Константа
// читается привилегированно: пользователю ее видеть не нужно, а знать ядру —
// нужно при каждом разборе.
Функция АдаптерКонфигурации()

	Кэш = AI_ПовторноеИспользование.КэшАдаптераКонфигурации();
	Если Кэш.Получить("Прочитан") = Истина Тогда
		Возврат Кэш.Получить("Адаптер");
	КонецЕсли;
	Кэш.Вставить("Прочитан", Истина);
	Кэш.Вставить("Адаптер", Неопределено);

	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Имя = СокрЛП(Константы.AI_АдаптерКонфигурации.Получить());
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Обработка = ПодключитьОбработчик(Имя);
		Объявленные = Обработка.ОбрабатываемыеТипы();
	Исключение
		// Недоступный адаптер не должен ронять разбор: ядро работает как без
		// него, а причина уходит в журнал — ее увидит администратор.
		ЗаписьЖурналаРегистрации(
			"AI.ПрименениеРекомендаций",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон("Адаптер конфигурации «%1» недоступен: %2", Имя, ОписаниеОшибки()));
		Возврат Неопределено;
	КонецПопытки;

	Типы = Новый Массив;
	Если ТипЗнч(Объявленные) = Тип("Массив") Тогда
		Для Каждого ПолноеИмя Из Объявленные Цикл
			Если ЗначениеЗаполнено(СокрЛП(Строка(ПолноеИмя))) Тогда
				Типы.Добавить(СокрЛП(Строка(ПолноеИмя)));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Адаптер = Новый Структура("Имя,Обработка,Типы", Имя, Обработка, Типы);
	Кэш.Вставить("Адаптер", Адаптер);
	Возврат Адаптер;

КонецФункции

// «Обработка.<Имя>» — обработка самой конфигурации, а не внешняя: для
// встроенного внедрения без БСП и для автотестов. Реестр БСП ей не нужен.
// Пустая строка — это имя внешней обработки из реестра.
Функция ИмяОбработкиКонфигурации(ИмяОбработчика)

	Имя = СокрЛП(ИмяОбработчика);
	Для Каждого Префикс Из СтрРазделить("Обработка.,DataProcessor.", ",") Цикл
		Если СтрНачинаетсяС(Имя, Префикс) Тогда
			Возврат Сред(Имя, СтрДлина(Префикс) + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Запись идет под правами пользователя: привилегированный режим не включается,
// отказ в правах — штатный результат, а не ошибка ядра.
Процедура ЗаписатьОбъект(МестоЗапуска, Контекст, Пригодные, Результат)

	Если Пригодные.Количество() = 0 Тогда
		Результат.Ошибка = "Нет значений, пригодных к записи.";
		Возврат;
	КонецЕсли;

	Ссылка = AI_ИзвлечениеРеквизитов.ПолучитьОбъектПоКонтексту(Контекст);
	Если Ссылка = Неопределено Тогда
		Результат.Ошибка = "Не удалось определить объект для записи.";
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(Контекст.ПолноеИмяМетаданных);
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
		Блокировка.Заблокировать();

		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ВызватьИсключение "Объект не найден или недоступен для изменения.";
		КонецЕсли;

		Примененные = ПеренестиПланВОбъект(Объект, Пригодные, РежимСтрокКарты(МестоЗапуска), Результат);

		Объект.Записать();

		ПроверитьСохранение(Объект, Примененные, Результат);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Обработано = 0;
		Результат.Ошибка = "Не удалось записать объект: " + ОписаниеОшибки();
		ЗаписатьВЖурнал(МестоЗапуска, Ссылка, Результат, УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецПопытки;

	ЗаписатьВЖурнал(МестоЗапуска, Ссылка, Результат, УровеньЖурналаРегистрации.Информация);

КонецПроцедуры

// Новый объект того вида, на который настроена карта: маршрут согласования,
// собранный в разговоре, заявка по письму. Создается под правами пользователя,
// заполнение по умолчанию выполняет сама конфигурация, проверка заполнения —
// тоже: полуготовый объект хуже, чем внятный отказ.
Процедура СоздатьОбъект(МестоЗапуска, Пригодные, Результат)

	Если Пригодные.Количество() = 0 Тогда
		Результат.Ошибка = "Нет значений, из которых можно создать объект.";
		Возврат;
	КонецЕсли;

	ПолноеИмя = ОбъектСоздания(МестоЗапуска);
	ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОписаниеОбъекта = Неопределено Тогда
		Результат.Ошибка = "Не определено, какой объект создавать: у карты извлечения не указан объект.";
		Возврат;
	КонецЕсли;
	ЭтоСправочник = Метаданные.Справочники.Содержит(ОписаниеОбъекта);
	Если Не ЭтоСправочник И Не Метаданные.Документы.Содержит(ОписаниеОбъекта) Тогда
		Результат.Ошибка = "Создавать можно только элементы справочников и документы, а карта настроена на "
			+ ПолноеИмя + ".";
		Возврат;
	КонецЕсли;
	Если Не ПравоДоступа("Добавление", ОписаниеОбъекта) Тогда
		Результат.Ошибка = СтрШаблон("Нет права создавать «%1».", ОписаниеОбъекта.Представление());
		Возврат;
	КонецЕсли;

	Менеджер = AI_ИзвлечениеРеквизитов.МенеджерПоПолномуИмени(ПолноеИмя);
	НачатьТранзакцию();
	Попытка
		Объект = ?(ЭтоСправочник, Менеджер.СоздатьЭлемент(), Менеджер.СоздатьДокумент());
		// Значения по умолчанию (автор, ответственный, настройки процесса)
		// ставит обработка заполнения самой конфигурации.
		Объект.Заполнить(Неопределено);
		Если Не ЭтоСправочник И Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;

		Примененные = ПеренестиПланВОбъект(Объект, Пригодные, РежимСтрокКарты(МестоЗапуска), Результат);

		Если Не Объект.ПроверитьЗаполнение() Тогда
			ВызватьИсключение "объект не прошел проверку заполнения — см. сообщения";
		КонецЕсли;
		Объект.Записать();

		ПроверитьСохранение(Объект, Примененные, Результат);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Обработано = 0;
		Результат.Ошибка = СтрШаблон("Не удалось создать «%1»: %2",
			ОписаниеОбъекта.Представление(), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьВЖурнал(МестоЗапуска, Неопределено, Результат, УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецПопытки;

	Результат.СозданныйОбъект = Объект.Ссылка;
	ЗаписатьВЖурнал(МестоЗапуска, Объект.Ссылка, Результат, УровеньЖурналаРегистрации.Информация);

КонецПроцедуры

// Как карта велит поступать со строками табличных частей: дописывать (по
// умолчанию), заменять целиком или обновлять существующие по номеру.
Функция РежимСтрокКарты(МестоЗапуска)

	Режим = Новый Структура("Заменять,Обновлять", Ложь, Ложь);
	Карта = МестоЗапуска.КартаИзвлечения;
	Если ЗначениеЗаполнено(Карта) Тогда
		Режим.Заменять = Карта.ЗаменятьСтрокиТабличныхЧастей;
		Режим.Обновлять = Карта.ОбновлятьСтрокиПоНомеру;
	КонецЕсли;
	Возврат Режим;

КонецФункции

// Кладет значения плана в объект. Строка табличной части, которой нет при
// обновлении по номеру, не создается, а отклоняется с причиной: модель
// ошиблась номером, и дописывать строку за нее нельзя.
//
// Возвращает структуру: Строки — примененные строки плана, СтрокиТЧ —
// строки табличных частей объекта, в которые они легли.
Функция ПеренестиПланВОбъект(Объект, Пригодные, РежимСтрок, Результат)

	Примененные = Новый Структура("Строки,СтрокиТЧ", Новый Массив, Новый Соответствие);
	ОчищенныеТЧ = Новый Соответствие;
	Для Каждого СтрокаПлана Из Пригодные Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.ТабличнаяЧасть) Тогда
			Если Не ЗаполнитьСтрокуТабличнойЧасти(Объект, СтрокаПлана, РежимСтрок,
				ОчищенныеТЧ, Примененные.СтрокиТЧ) Тогда
				Результат.Отклонено = Результат.Отклонено + 1;
				Результат.Сообщения.Добавить(СтрокаПлана.Представление
					+ ": в объекте нет строки с таким номером.");
				Продолжить;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(СтрокаПлана.Свойство) Тогда
			ЗаполнитьДополнительныйРеквизит(Объект, СтрокаПлана);
		Иначе
			Объект[СтрокаПлана.ПутьРеквизита] = СтрокаПлана.Значение;
		КонецЕсли;
		Примененные.Строки.Добавить(СтрокаПлана);
		Результат.Обработано = Результат.Обработано + 1;
	КонецЦикла;
	Возврат Примененные;

КонецФункции

// Прикладная логика конфигурации вправе переопределить записанное: в
// Документообороте, например, Контрагент вычисляется из состава сторон и
// сбрасывается при записи. Молча отчитаться «записано» в таком случае —
// ввести пользователя в заблуждение.
Процедура ПроверитьСохранение(Объект, Примененные, Результат)

	Для Каждого СтрокаПлана Из Примененные.Строки Цикл
		Если Не ЗначениеСохранилось(Объект, СтрокаПлана, Примененные.СтрокиТЧ) Тогда
			Результат.Обработано = Результат.Обработано - 1;
			Результат.Отклонено = Результат.Отклонено + 1;
			Результат.Сообщения.Добавить(СтрокаПлана.Представление
				+ ": значение не сохранилось — конфигурация переопределила реквизит при записи.");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Точка расширения: прикладное действие сверх встроенных видов.
// Ключ действия из места запуска позволяет одному обработчику обслуживать
// несколько сценариев, не заводя под каждый свой вид.
Процедура ВыполнитьПользовательскоеДействие(МестоЗапуска, Контекст, План,
		Шаг, ОтветПользователя, Результат)

	ПараметрыВызова = ПараметрыВызоваОбработчика(МестоЗапуска, Контекст, План);
	ПараметрыВызова.Вставить("Шаг", Шаг);
	ПараметрыВызова.Вставить("Состояние", Результат.Состояние);
	ПараметрыВызова.Вставить("ОтветПользователя", ОтветПользователя);

	AI_ДействияПереопределяемый.ПриВыполненииДействия(ПараметрыВызова);

	ПринятьОтветОбработчика(
		МестоЗапуска,
		Контекст,
		ПараметрыВызова,
		Результат,
		СтрШаблон("Действие «%1» не реализовано в AI_ДействияПереопределяемый.",
			СокрЛП(МестоЗапуска.КлючДействия)));

КонецПроцедуры

// Действие, реализованное внешней обработкой из реестра БСП.
//
// Реестром владеет БСП: там права, версии, безопасный режим и администрирование.
// Исполнение же идет платформенными средствами, поэтому ядро не заимствует
// объекты БСП и не вызывает его общие модули: и то и другое сделало бы
// расширение незапускаемым в конфигурациях без БСП.
Процедура ВыполнитьВнешнийОбработчик(МестоЗапуска, Контекст, План,
		Шаг, ОтветПользователя, Результат)

	ИмяОбработчика = СокрЛП(МестоЗапуска.Обработчик);
	Если Не ЗначениеЗаполнено(ИмяОбработчика) Тогда
		Результат.Ошибка = "В месте запуска не указана обработка-обработчик действия.";
		Возврат;
	КонецЕсли;

	ИмяМетода = СокрЛП(МестоЗапуска.МетодДействия);
	Если Не ЗначениеЗаполнено(ИмяМетода) Тогда
		ИмяМетода = "ВыполнитьДействие";
	КонецЕсли;

	Попытка
		Обработка = ПодключитьОбработчик(ИмяОбработчика);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат;
	КонецПопытки;

	ПараметрыВызова = ПараметрыВызоваОбработчика(МестоЗапуска, Контекст, План);
	ПараметрыВызова.Вставить("Шаг", Шаг);
	ПараметрыВызова.Вставить("Состояние", Результат.Состояние);
	ПараметрыВызова.Вставить("ОтветПользователя", ОтветПользователя);

	Попытка
		ВызватьМетодОбработки(Обработка, ИмяМетода, ПараметрыВызова);
	Исключение
		Результат.Ошибка = СтрШаблон("Обработчик «%1.%2» завершился с ошибкой: %3",
			ИмяОбработчика, ИмяМетода, ОписаниеОшибки());
		ЗаписатьВЖурнал(
			МестоЗапуска,
			AI_ИзвлечениеРеквизитов.ПолучитьОбъектПоКонтексту(Контекст),
			Результат,
			УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецПопытки;

	ПринятьОтветОбработчика(
		МестоЗапуска,
		Контекст,
		ПараметрыВызова,
		Результат,
		СтрШаблон("Обработчик «%1.%2» не взял действие «%3» в работу.",
			ИмяОбработчика, ИмяМетода, СокрЛП(МестоЗапуска.КлючДействия)));

КонецПроцедуры

// Единая структура вызова для всех обработчиков — и переопределяемого модуля,
// и внешней обработки. Сигнатура намеренно одна: собрать произвольный список
// аргументов в BSL нельзя без генерации кода, а дополнительные данные удобно
// передавать содержимым структуры.
Функция ПараметрыВызоваОбработчика(МестоЗапуска, Контекст, План)

	Параметры = Новый Структура;
	Параметры.Вставить("КлючДействия", СокрЛП(МестоЗапуска.КлючДействия));
	Параметры.Вставить("МестоЗапуска", МестоЗапуска);
	Параметры.Вставить("Контекст", Контекст);
	Параметры.Вставить("План", План);
	Параметры.Вставить("Дополнительные", ДополнительныеПараметры(МестоЗапуска));
	Параметры.Вставить("Количество", 0);
	Параметры.Вставить("Сообщения", Новый Массив);
	Параметры.Вставить("Обработано", Ложь);
	Параметры.Вставить("Продолжение", Неопределено);
	// Цепочка: обработчик вправе предложить следующее действие. Именно
	// предложить — запускать его молча нельзя, решение остается за человеком.
	Параметры.Вставить("СледующееДействие", Неопределено);
	Возврат Параметры;

КонецФункции

// Пользовательские параметры места запуска, приведенные к объявленным типам.
Функция ДополнительныеПараметры(МестоЗапуска)

	Значения = Новый Структура;
	Для Каждого Строка Из МестоЗапуска.ПараметрыДействия Цикл
		Имя = СокрЛП(Строка.Имя);
		Если Не ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Значения.Вставить(Имя, ТипизированноеЗначение(Строка));
	КонецЦикла;
	Возврат Значения;

КонецФункции

Функция ТипизированноеЗначение(Строка)

	Текст = СокрЛП(Строка.Значение);
	Типы = Перечисления.AI_ТипЗначенияПоля;
	Вид = Строка.ТипЗначения;

	Если Вид = Типы.Число Тогда
		Попытка
			Возврат Число(СтрЗаменить(СтрЗаменить(Текст, " ", ""), ",", "."));
		Исключение
			Возврат 0;
		КонецПопытки;
	ИначеЕсли Вид = Типы.Дата Тогда
		Попытка
			Возврат Дата(СтрЗаменить(СтрЗаменить(Текст, "-", ""), ".", ""));
		Исключение
			Возврат '00010101';
		КонецПопытки;
	ИначеЕсли Вид = Типы.Булево Тогда
		Возврат ВРег(Текст) = "ИСТИНА" Или Текст = "1" Или ВРег(Текст) = "ДА";
	ИначеЕсли Вид = Типы.Ссылка Тогда
		// Ссылочный параметр ищется по наименованию в объявленном типе:
		// хранить ссылку строкой безопаснее, чем привязывать настройку
		// подсистемы к составу типов конкретной конфигурации.
		Возврат СсылкаПоНаименованию(СокрЛП(Строка.ТипСсылки), Текст);
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция СсылкаПоНаименованию(ПолноеИмя, Текст)

	Если Не ЗначениеЗаполнено(ПолноеИмя) Или Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Менеджер = AI_ИзвлечениеРеквизитов.МенеджерПоПолномуИмени(ПолноеИмя);
		Возврат Менеджер.НайтиПоНаименованию(Текст, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Разбирает то, что вернул обработчик: продолжение диалога либо завершение.
Процедура ПринятьОтветОбработчика(МестоЗапуска, Контекст, ПараметрыВызова,
		Результат, ТекстОтказа)

	Для Каждого Сообщение Из ПараметрыВызова.Сообщения Цикл
		Результат.Сообщения.Добавить(Строка(Сообщение));
	КонецЦикла;

	Если ПараметрыВызова.Продолжение <> Неопределено Тогда
		// Обработчик просит уточнение у пользователя. Состояние он хранит сам,
		// ядро только переносит его между шагами.
		Результат.Продолжение = ПараметрыВызова.Продолжение;
		Результат.Состояние = ПараметрыВызова.Состояние;
		Результат.Обработано = ПараметрыВызова.Количество;
		Возврат;
	КонецЕсли;

	ПринятьСледующееДействие(МестоЗапуска, ПараметрыВызова, Результат);

	Если Не ПараметрыВызова.Обработано Тогда
		Результат.Ошибка = ТекстОтказа;
		Возврат;
	КонецЕсли;

	Результат.Обработано = ПараметрыВызова.Количество;
	Результат.Состояние = Неопределено;
	ЗаписатьВЖурнал(
		МестоЗапуска,
		AI_ИзвлечениеРеквизитов.ПолучитьОбъектПоКонтексту(Контекст),
		Результат,
		УровеньЖурналаРегистрации.Информация);

КонецПроцедуры

// Проверяет предложенное продолжение цепочки.
//
// Цепочка не должна превращаться в способ дотянуться до действия, которое
// пользователю не разрешено: место запуска проверяется теми же правилами, что и
// при обычном выборе, — активностью, доступом к агенту и отборами контекста.
// Непрошедшее предложение не молчит: причина уходит пользователю сообщением.
Процедура ПринятьСледующееДействие(МестоЗапуска, ПараметрыВызова, Результат)

	Предложение = ПараметрыВызова.СледующееДействие;
	Если Предложение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Предложение) <> Тип("Структура") Тогда
		Результат.Сообщения.Добавить(
			"Обработчик предложил продолжение в непонятном виде — оно пропущено.");
		Возврат;
	КонецЕсли;

	ИмяИлиСсылка = Неопределено;
	Предложение.Свойство("МестоЗапуска", ИмяИлиСсылка);
	Причина = "";
	Предложение.Свойство("Причина", Причина);

	Следующее = НайтиМестоЗапуска(ИмяИлиСсылка);
	Если Следующее = Неопределено Тогда
		Результат.Сообщения.Добавить(СтрШаблон(
			"Обработчик предложил продолжить действием «%1», но такого места запуска нет.",
			Строка(ИмяИлиСсылка)));
		Возврат;
	КонецЕсли;

	Если Следующее = МестоЗапуска Тогда
		// Действие, предлагающее само себя, — это цикл. Один шаг цепочки он
		// не испортит, но повторять его помощнику незачем.
		Результат.Сообщения.Добавить(
			"Обработчик предложил продолжить тем же действием — предложение пропущено.");
		Возврат;
	КонецЕсли;

	Попытка
		ПроверитьДоступностьМеста(Следующее);
	Исключение
		Результат.Сообщения.Добавить(СтрШаблон(
			"Продолжение «%1» недоступно: %2", Строка(Следующее), ОписаниеОшибки()));
		Возврат;
	КонецПопытки;

	Результат.СледующееДействие = Новый Структура("МестоЗапуска,Причина,Представление",
		Следующее,
		СокрЛП(Строка(Причина)),
		СокрЛП(Строка(Следующее.ПредставлениеКоманды)));

КонецПроцедуры

Функция НайтиМестоЗапуска(Знач ИмяИлиСсылка)

	Если ТипЗнч(ИмяИлиСсылка) = Тип("СправочникСсылка.AI_МестаЗапускаСценариев") Тогда
		Возврат ?(ЗначениеЗаполнено(ИмяИлиСсылка), ИмяИлиСсылка, Неопределено);
	КонецЕсли;
	Имя = СокрЛП(Строка(ИмяИлиСсылка));
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ссылка = Справочники.AI_МестаЗапускаСценариев.НайтиПоНаименованию(Имя, Истина);
	Возврат ?(ЗначениеЗаполнено(Ссылка), Ссылка, Неопределено);

КонецФункции

// Подключение обработки кэшируется на время серверного вызова: многошаговое
// действие и проверки иначе подключали бы один и тот же файл заново.
Функция ПодключитьОбработчик(ИмяОбработчика)

	Кэш = ПодключенныеОбработчики();
	Подключенная = Кэш.Получить(ИмяОбработчика);
	Если Подключенная <> Неопределено Тогда
		Возврат Подключенная;
	КонецЕсли;

	ИмяКонфигурации = ИмяОбработкиКонфигурации(ИмяОбработчика);
	Если ЗначениеЗаполнено(ИмяКонфигурации) Тогда
		Если Метаданные.Обработки.Найти(ИмяКонфигурации) = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Обработчик «%1» не найден: в конфигурации нет обработки «%2».",
				ИмяОбработчика, ИмяКонфигурации);
		КонецЕсли;
		Обработка = Обработки[ИмяКонфигурации].Создать();
		Кэш.Вставить(ИмяОбработчика, Обработка);
		Возврат Обработка;
	КонецЕсли;

	Регистрация = НайтиЗарегистрированнуюОбработку(ИмяОбработчика);
	Если Регистрация = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Обработчик «%1» не найден. Проверьте, что дополнительная обработка"
			+ " зарегистрирована, опубликована и доступна текущему пользователю,"
			+ " а в конфигурации есть подсистема дополнительных обработок.",
			ИмяОбработчика);
	КонецЕсли;

	Попытка
		Адрес = ПоместитьВоВременноеХранилище(Регистрация.ДвоичныеДанные);
		// Предупреждения об опасных действиях в фоновом исполнении показать
		// некому, а блокировать выполнение они будут — гасим осознанно.
		Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
		Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
		ИмяПодключенной = ВнешниеОбработки.Подключить(
			Адрес, , Регистрация.БезопасныйРежим, Защита);
		Обработка = ВнешниеОбработки.Создать(ИмяПодключенной, Регистрация.БезопасныйРежим);
	Исключение
		ВызватьИсключение СтрШаблон("Не удалось подключить обработчик «%1»: %2",
			ИмяОбработчика, ОписаниеОшибки());
	КонецПопытки;

	Кэш.Вставить(ИмяОбработчика, Обработка);
	Возврат Обработка;

КонецФункции

Функция ПодключенныеОбработчики()
	Возврат AI_ПовторноеИспользование.КэшПодключенныхОбработчиков();
КонецФункции

// Вызывает метод обработки по имени из настройки.
//
// Вызвать метод по имени из переменной в BSL иначе нельзя: Объект[Имя] — это
// доступ к свойству, а не к методу. Поэтому здесь единственный Выполнить во
// всей подсистеме, и в него попадает не код, а идентификатор: имя метода
// проверяется по строгому шаблону до подстановки.
Процедура ВызватьМетодОбработки(Обработка, ИмяМетода, Параметры)

	ПроверитьИмяМетода(ИмяМетода);
	Выполнить("Обработка." + ИмяМетода + "(Параметры)");

КонецПроцедуры

Процедура ПроверитьИмяМетода(ИмяМетода)

	Если СтрДлина(ИмяМетода) = 0 Или СтрДлина(ИмяМетода) > 64 Тогда
		ВызватьИсключение "Имя метода обработчика пустое или слишком длинное.";
	КонецЕсли;

	Допустимые = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		+ "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя"
		+ "0123456789_";
	Для Позиция = 1 По СтрДлина(ИмяМетода) Цикл
		Символ = Сред(ИмяМетода, Позиция, 1);
		Если СтрНайти(Допустимые, Символ) = 0 Тогда
			ВызватьИсключение СтрШаблон(
				"Недопустимое имя метода обработчика: «%1»."
				+ " Разрешены только буквы, цифры и подчеркивание.",
				ИмяМетода);
		КонецЕсли;
	КонецЦикла;

	Если СтрНайти("0123456789", Лев(ИмяМетода, 1)) > 0 Тогда
		ВызватьИсключение "Имя метода обработчика не может начинаться с цифры.";
	КонецЕсли;

КонецПроцедуры

// Читает регистрацию из справочника БСП. Текст запроса — данные, а не код,
// поэтому в конфигурации без БСП это не ошибка компиляции: запрос просто
// не выполнится, и вызывающий получит внятный отказ.
Функция НайтиЗарегистрированнуюОбработку(Имя)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Обработки.ХранилищеОбработки КАК ХранилищеОбработки,
		|	Обработки.БезопасныйРежим КАК БезопасныйРежим,
		|	Обработки.Версия КАК Версия
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
		|ГДЕ
		|	НЕ Обработки.ПометкаУдаления
		|	И (Обработки.Наименование = &Имя ИЛИ Обработки.ИмяОбъекта = &Имя)
		|	И Обработки.Публикация <> ЗНАЧЕНИЕ(
		|		Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Отключена)");
	Запрос.УстановитьПараметр("Имя", Имя);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		// Нет подсистемы дополнительных обработок либо нет прав на справочник.
		Возврат Неопределено;
	КонецПопытки;

	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Хранилище = Выборка.ХранилищеОбработки;
	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДвоичныеДанные = Хранилище.Получить();
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("ДвоичныеДанные,БезопасныйРежим,Версия",
		ДвоичныеДанные,
		Выборка.БезопасныйРежим,
		Строка(Выборка.Версия));

КонецФункции

Функция СформироватьПлан(МестоЗапуска, Контекст, Значения)

	План = Новый ТаблицаЗначений;
	План.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	План.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	План.Колонки.Добавить("ПутьРеквизита", Новый ОписаниеТипов("Строка"));
	План.Колонки.Добавить("ТабличнаяЧасть", Новый ОписаниеТипов("Строка"));
	План.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	План.Колонки.Добавить("Свойство");
	План.Колонки.Добавить("Значение");
	План.Колонки.Добавить("Применимо", Новый ОписаниеТипов("Булево"));
	План.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));

	Если ТипЗнч(Значения) <> Тип("ТаблицаЗначений") Тогда
		Возврат План;
	КонецЕсли;

	// Белый список: карта перечитывается здесь, данные клиента не в счет.
	Карта = МестоЗапуска.КартаИзвлечения;
	ПоляКарты = Новый Соответствие;
	Если ЗначениеЗаполнено(Карта) И Не Карта.ПометкаУдаления И Карта.Активна Тогда
		Для Каждого Поле Из Карта.Поля Цикл
			Ключ = СокрЛП(Поле.Ключ);
			Если ЗначениеЗаполнено(Ключ) Тогда
				ПоляКарты.Вставить(Ключ, Поле);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Новый объект — вида карты, а не объекта контекста: маршрут собирают и из
	// карточки другого шаблона, и вовсе без объекта.
	Создание = (МестоЗапуска.ВидДействия = Перечисления.AI_ВидДействия.СоздатьОбъект);
	Если Создание Тогда
		ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(ОбъектСоздания(МестоЗапуска));
		СсылкаОбъекта = Неопределено;
	Иначе
		ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(Строка(Контекст.ПолноеИмяМетаданных));
		// Объект нужен дополнительным реквизитам: одноименные свойства разных
		// наборов различает только набор самого объекта.
		СсылкаОбъекта = AI_ИзвлечениеРеквизитов.ПолучитьОбъектПоКонтексту(Контекст);
	КонецЕсли;

	// Колонки строк табличных частей появились позже основных: вызов из очереди
	// или из внешнего кода вправе передать таблицу без них.
	ЕстьНомерСтроки = Значения.Колонки.Найти("НомерСтроки") <> Неопределено;
	ЕстьПредставление = Значения.Колонки.Найти("Представление") <> Неопределено;

	Для Каждого СтрокаЗначения Из Значения Цикл
		СтрокаПлана = План.Добавить();
		СтрокаПлана.Ключ = СокрЛП(Строка(СтрокаЗначения.Ключ));
		СтрокаПлана.Значение = СтрокаЗначения.Значение;

		Поле = ПоляКарты.Получить(СтрокаПлана.Ключ);
		Если Поле = Неопределено Тогда
			СтрокаПлана.Причина = "Поле отсутствует в карте извлечения — применение запрещено.";
			Продолжить;
		КонецЕсли;

		СтрокаПлана.Представление = ?(ЗначениеЗаполнено(Поле.Представление),
			Поле.Представление, СтрокаПлана.Ключ);
		Путь = СокрЛП(Поле.ПутьРеквизита);
		СтрокаПлана.ПутьРеквизита = Путь;
		СтрокаПлана.ТабличнаяЧасть = СокрЛП(Поле.ТабличнаяЧасть);
		ИмяСвойства = СокрЛП(Поле.ДополнительныйРеквизит);

		// Пустое значение модель возвращает, когда в документе его нет. Записать
		// его — значит стереть то, что человек уже внес. Ложь логического
		// реквизита — ответ, а не пустота.
		Если ТипЗнч(СтрокаПлана.Значение) <> Тип("Булево")
			И Не ЗначениеЗаполнено(СтрокаПлана.Значение) Тогда
			СтрокаПлана.Причина = "В документе значения нет — пустым реквизит не заполняется.";
			Продолжить;
		КонецЕсли;

		Если ОписаниеОбъекта = Неопределено Тогда
			СтрокаПлана.Причина = ?(Создание,
				"Не определено, какой объект создавать: у карты извлечения не указан объект.",
				"Объект контекста не найден в конфигурации.");
			Продолжить;
		КонецЕсли;

		// Номер строки приходит из разбора: он связывает поля одной строки
		// табличной части между собой.
		Если ЗначениеЗаполнено(СтрокаПлана.ТабличнаяЧасть) Тогда
			Если ЕстьНомерСтроки Тогда
				СтрокаПлана.НомерСтроки = Число(СтрокаЗначения.НомерСтроки);
			КонецЕсли;
			Если ЕстьПредставление И ЗначениеЗаполнено(СтрокаЗначения.Представление) Тогда
				СтрокаПлана.Представление = СтрокаЗначения.Представление;
			КонецЕсли;
			ПроверитьРеквизитТабличнойЧасти(ОписаниеОбъекта, СтрокаПлана);
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ИмяСвойства) Тогда
			ПроверитьДополнительныйРеквизит(ОписаниеОбъекта, СсылкаОбъекта, ИмяСвойства, СтрокаПлана);
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Путь) Тогда
			СтрокаПлана.Причина = "В карте не задан реквизит объекта.";
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Путь, ".") > 0 Тогда
			СтрокаПлана.Причина = "Путь через точку не поддержан:"
				+ " для табличной части заполните реквизит «Табличная часть» в карте.";
			Продолжить;
		КонецЕсли;

		Реквизит = НайтиРеквизит(ОписаниеОбъекта, Путь);
		Если Реквизит = Неопределено Тогда
			СтрокаПлана.Причина = "Реквизит не найден: " + Путь;
			Продолжить;
		КонецЕсли;
		Если Не Реквизит.Тип.СодержитТип(ТипЗнч(СтрокаПлана.Значение)) Тогда
			СтрокаПлана.Причина = СтрШаблон(
				"Тип значения (%1) не подходит реквизиту %2.",
				Строка(ТипЗнч(СтрокаПлана.Значение)),
				Путь);
			Продолжить;
		КонецЕсли;

		СтрокаПлана.Применимо = Истина;
	КонецЦикла;

	Возврат План;

КонецФункции

// Реквизит табличной части: та же проверка по метаданным, что и для шапки,
// только искать нужно в колонках табличной части.
Процедура ПроверитьРеквизитТабличнойЧасти(ОписаниеОбъекта, СтрокаПлана)

	Если СтрокаПлана.НомерСтроки <= 0 Тогда
		СтрокаПлана.Причина = "Не определен номер строки табличной части.";
		Возврат;
	КонецЕсли;

	ОписаниеТЧ = Неопределено;
	Попытка
		ОписаниеТЧ = ОписаниеОбъекта.ТабличныеЧасти.Найти(СтрокаПлана.ТабличнаяЧасть);
	Исключение
		ОписаниеТЧ = Неопределено;
	КонецПопытки;
	Если ОписаниеТЧ = Неопределено Тогда
		СтрокаПлана.Причина = "Табличная часть не найдена: " + СтрокаПлана.ТабличнаяЧасть;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаПлана.ПутьРеквизита) Тогда
		СтрокаПлана.Причина = "В карте не задана колонка табличной части.";
		Возврат;
	КонецЕсли;

	Реквизит = ОписаниеТЧ.Реквизиты.Найти(СтрокаПлана.ПутьРеквизита);
	Если Реквизит = Неопределено Тогда
		СтрокаПлана.Причина = СтрШаблон("В табличной части %1 нет реквизита %2.",
			СтрокаПлана.ТабличнаяЧасть, СтрокаПлана.ПутьРеквизита);
		Возврат;
	КонецЕсли;
	Если Не Реквизит.Тип.СодержитТип(ТипЗнч(СтрокаПлана.Значение)) Тогда
		СтрокаПлана.Причина = СтрШаблон(
			"Тип значения (%1) не подходит реквизиту %2.%3.",
			Строка(ТипЗнч(СтрокаПлана.Значение)),
			СтрокаПлана.ТабличнаяЧасть,
			СтрокаПлана.ПутьРеквизита);
		Возврат;
	КонецЕсли;

	СтрокаПлана.Применимо = Истина;

КонецПроцедуры

// Дополнительный реквизит адресуется наименованием свойства, а не ссылкой:
// план видов характеристик — объект прикладной конфигурации, и ссылаться на
// него из расширения означало бы привязать подсистему к одной конфигурации.
// Поэтому вид характеристик определяется по типу колонки «Свойство» той самой
// табличной части, а свойство ищется по наименованию среди наборов объекта.
Процедура ПроверитьДополнительныйРеквизит(ОписаниеОбъекта, Ссылка, ИмяСвойства, СтрокаПлана)

	ОписаниеТЧ = Неопределено;
	Попытка
		ОписаниеТЧ = ОписаниеОбъекта.ТабличныеЧасти.Найти("ДополнительныеРеквизиты");
	Исключение
		ОписаниеТЧ = Неопределено;
	КонецПопытки;
	Если ОписаниеТЧ = Неопределено Тогда
		СтрокаПлана.Причина = "У объекта нет табличной части «ДополнительныеРеквизиты».";
		Возврат;
	КонецЕсли;

	КолонкаСвойство = ОписаниеТЧ.Реквизиты.Найти("Свойство");
	КолонкаЗначение = ОписаниеТЧ.Реквизиты.Найти("Значение");
	Если КолонкаСвойство = Неопределено Или КолонкаЗначение = Неопределено Тогда
		СтрокаПлана.Причина = "Табличная часть дополнительных реквизитов устроена иначе:"
			+ " нет колонок «Свойство» и «Значение».";
		Возврат;
	КонецЕсли;

	ИмяВидаХарактеристик = AI_ИзвлечениеРеквизитов.ИмяВидаХарактеристикСвойств(ОписаниеОбъекта);
	Если Не ЗначениеЗаполнено(ИмяВидаХарактеристик) Тогда
		СтрокаПлана.Причина = "Не удалось определить план видов характеристик"
			+ " дополнительных реквизитов.";
		Возврат;
	КонецЕсли;

	Поиск = AI_ИзвлечениеРеквизитов.НайтиДополнительныйРеквизит(
		ИмяВидаХарактеристик, ИмяСвойства, Ссылка);
	Если Поиск.Свойство = Неопределено Тогда
		СтрокаПлана.Причина = Поиск.Причина;
		Возврат;
	КонецЕсли;
	Свойство = Поиск.Свойство;

	// Значение из списка должно принадлежать своему свойству: тип у чужого
	// «Да» тот же, и проверка типа ниже его не отличит.
	Сверка = AI_ИзвлечениеРеквизитов.СверитьЗначениеСвойства(Свойство, СтрокаПлана.Значение);
	Если ЗначениеЗаполнено(Сверка.Причина) Тогда
		СтрокаПлана.Причина = Сверка.Причина;
		Возврат;
	КонецЕсли;
	СтрокаПлана.Значение = Сверка.Значение;

	// Тип значения свойства проверяем, если он объявлен: у БСП это реквизит
	// ТипЗначения самого свойства.
	Попытка
		ТипСвойства = Свойство.ТипЗначения;
	Исключение
		ТипСвойства = Неопределено;
	КонецПопытки;
	Если ТипЗнч(ТипСвойства) = Тип("ОписаниеТипов")
		И Не ТипСвойства.СодержитТип(ТипЗнч(СтрокаПлана.Значение)) Тогда
		СтрокаПлана.Причина = СтрШаблон(
			"Тип значения (%1) не подходит дополнительному реквизиту «%2».",
			Строка(ТипЗнч(СтрокаПлана.Значение)),
			ИмяСвойства);
		Возврат;
	КонецЕсли;

	СтрокаПлана.Свойство = Свойство;
	СтрокаПлана.Применимо = Истина;

КонецПроцедуры

// Реквизит объекта по имени, включая стандартные (Наименование, Код и прочие).
Функция НайтиРеквизит(ОписаниеОбъекта, Имя)

	Реквизит = ОписаниеОбъекта.Реквизиты.Найти(Имя);
	Если Реквизит <> Неопределено Тогда
		Возврат Реквизит;
	КонецЕсли;
	Попытка
		Для Каждого Стандартный Из ОписаниеОбъекта.СтандартныеРеквизиты Цикл
			Если Стандартный.Имя = Имя Тогда
				Возврат Стандартный;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

// Строки табличной части собираются по номеру из разбора: поля одной строки
// приходят в плане по отдельности, а лечь должны в одну строку.
//
// Очистка выполняется один раз на табличную часть и только если карта это
// разрешает: дописывать к существующим строкам — поведение по умолчанию,
// потому что молча стереть чужие данные хуже, чем добавить лишнюю строку.
// При обновлении по номеру номер — это номер строки самого объекта, и новые
// строки не заводятся. Ложь — такой строки в объекте нет.
Функция ЗаполнитьСтрокуТабличнойЧасти(Объект, СтрокаПлана, РежимСтрок, ОчищенныеТЧ, СтрокиТЧ)

	ИмяТЧ = СтрокаПлана.ТабличнаяЧасть;
	Ключ = ИмяТЧ + "#" + Формат(СтрокаПлана.НомерСтроки, "ЧГ=0");
	СтрокаОбъекта = СтрокиТЧ.Получить(Ключ);
	Если СтрокаОбъекта = Неопределено Тогда
		ТабличнаяЧасть = Объект[ИмяТЧ];
		Если РежимСтрок.Обновлять Тогда
			Если СтрокаПлана.НомерСтроки < 1 Или СтрокаПлана.НомерСтроки > ТабличнаяЧасть.Количество() Тогда
				Возврат Ложь;
			КонецЕсли;
			СтрокаОбъекта = ТабличнаяЧасть[СтрокаПлана.НомерСтроки - 1];
		Иначе
			Если РежимСтрок.Заменять И ОчищенныеТЧ.Получить(ИмяТЧ) = Неопределено Тогда
				ТабличнаяЧасть.Очистить();
				ОчищенныеТЧ.Вставить(ИмяТЧ, Истина);
			КонецЕсли;
			СтрокаОбъекта = ТабличнаяЧасть.Добавить();
		КонецЕсли;
		СтрокиТЧ.Вставить(Ключ, СтрокаОбъекта);
	КонецЕсли;

	СтрокаОбъекта[СтрокаПлана.ПутьРеквизита] = СтрокаПлана.Значение;
	Возврат Истина;

КонецФункции

// Дополнительный реквизит — строка табличной части по свойству: если строка
// уже есть, значение заменяется, иначе добавляется новая.
Процедура ЗаполнитьДополнительныйРеквизит(Объект, СтрокаПлана)

	Отбор = Новый Структура("Свойство", СтрокаПлана.Свойство);
	Найденные = Объект.ДополнительныеРеквизиты.НайтиСтроки(Отбор);
	Если Найденные.Количество() > 0 Тогда
		СтрокаСвойства = Найденные[0];
	Иначе
		СтрокаСвойства = Объект.ДополнительныеРеквизиты.Добавить();
		СтрокаСвойства.Свойство = СтрокаПлана.Свойство;
	КонецЕсли;
	СтрокаСвойства.Значение = СтрокаПлана.Значение;

КонецПроцедуры

// Сверка после записи. Для табличной части сверяется та самая строка, которую
// заполняли: перебирать заново нельзя — конфигурация вправе переупорядочить.
Функция ЗначениеСохранилось(Объект, СтрокаПлана, СтрокиТЧ)

	Если ЗначениеЗаполнено(СтрокаПлана.ТабличнаяЧасть) Тогда
		Ключ = СтрокаПлана.ТабличнаяЧасть + "#" + Формат(СтрокаПлана.НомерСтроки, "ЧГ=0");
		СтрокаОбъекта = СтрокиТЧ.Получить(Ключ);
		Если СтрокаОбъекта = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат СтрокаОбъекта[СтрокаПлана.ПутьРеквизита] = СтрокаПлана.Значение;
	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаПлана.Свойство) Тогда
		Отбор = Новый Структура("Свойство", СтрокаПлана.Свойство);
		Найденные = Объект.ДополнительныеРеквизиты.НайтиСтроки(Отбор);
		Если Найденные.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Найденные[0].Значение = СтрокаПлана.Значение;
	КонецЕсли;

	Возврат Объект[СтрокаПлана.ПутьРеквизита] = СтрокаПлана.Значение;

КонецФункции

Процедура ЗаписатьВЖурнал(МестоЗапуска, Ссылка, Результат, Уровень)

	Текст = СтрШаблон(
		"Место запуска: %1. Вид действия: %2. Объект: %3. Применено: %4, отклонено: %5. %6",
		Строка(МестоЗапуска),
		Строка(Результат.ВидДействия),
		Строка(Ссылка),
		Результат.Обработано,
		Результат.Отклонено,
		Результат.Ошибка);
	ЗаписьЖурналаРегистрации("AI.ПрименениеРекомендаций", Уровень, , Ссылка, Текст);

КонецПроцедуры

#КонецОбласти
