Функция ОписаниеЭтапаОтвета(Карта, Исполнитель, Порядок, СрокДней)

	Этап = Новый Соответствие;
	Этап.Вставить(КлючПоляКарты(Карта, "Этапы", "Исполнитель"), Исполнитель);
	Этап.Вставить(КлючПоляКарты(Карта, "Этапы", "Порядок"), Порядок);
	Этап.Вставить(КлючПоляКарты(Карта, "Этапы", "СрокДней"), СрокДней);
	Возврат Этап;

