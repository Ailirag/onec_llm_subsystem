КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДиалогИзИсторииОбработка(Команда)

	Если ОперацияВыполняется Тогда
		СтатусОперации = "Сначала дождитесь завершения запроса или отмените его";
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.ИсторияДиалогов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		СтатусОперации = "Выберите диалог в истории";
		Возврат;
	КонецЕсли;

	УдалитьВсеВложения();
	Попытка
		ОткрытьДиалогИзИсторииНаСервере(ТекущиеДанные.ИдентификаторДиалога);
	Исключение
		СтатусОперации = "Не удалось открыть диалог: " + ОписаниеОшибки();
		Возврат;
	КонецПопытки;
	ОбновитьСостояниеИнтерфейса();
	Если ОперацияВыполняется Тогда
		ПодключитьОпросОперации();
		ПроверитьСостояниеОперации();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПереименоватьДиалогОбработка(Команда)

	ТекущиеДанные = Элементы.ИсторияДиалогов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		СтатусОперации = "Выберите диалог в истории";
		Возврат;
	КонецЕсли;
	Попытка
		AI_ДиалогиКлиентСервер.Переименовать(
			ТекущиеДанные.ИдентификаторДиалога,
			НовыйЗаголовокДиалога);
		ОбновитьИсториюДиалоговНаСервере();
	Исключение
		СтатусОперации = "Не удалось переименовать диалог: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура АрхивироватьДиалогОбработка(Команда)

	ТекущиеДанные = Элементы.ИсторияДиалогов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		СтатусОперации = "Выберите диалог в истории";
		Возврат;
	КонецЕсли;
	Если ОперацияВыполняется
		И ТекущиеДанные.ИдентификаторДиалога = ИдентификаторДиалога Тогда
		СтатусОперации = "Нельзя архивировать диалог во время выполнения запроса";
		Возврат;
	КонецЕсли;
	Если Не ТекущиеДанные.Архивирован
		И ТекущиеДанные.ИдентификаторДиалога = ИдентификаторДиалога Тогда
		УдалитьВсеВложения();
	КонецЕсли;
	Попытка
		AI_ДиалогиКлиентСервер.УстановитьАрхив(
			ТекущиеДанные.ИдентификаторДиалога,
			Не ТекущиеДанные.Архивирован);
		Если Не ТекущиеДанные.Архивирован
			И ТекущиеДанные.ИдентификаторДиалога = ИдентификаторДиалога Тогда
			ПодготовитьНовыйДиалогНаСервере();
		КонецЕсли;
		ОбновитьИсториюДиалоговНаСервере();
		ОбновитьСостояниеИнтерфейса();
	Исключение
		СтатусОперации = "Не удалось изменить архив: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОбновитьИсториюДиалоговНаСервере()

	ИсторияДиалогов.Очистить();
	Диалоги = AI_ДиалогиКлиентСервер.ПолучитьМоиДиалоги(
		ПоискДиалогов,
		ПоказыватьАрхивныеДиалоги,
		50);
	Для Каждого Диалог Из Диалоги Цикл
		СтрокаИстории = ИсторияДиалогов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаИстории, Диалог);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОткрытьДиалогИзИсторииНаСервере(ИдентификаторОткрываемогоДиалога)

	Настройки = AI_ДиалогиКлиентСервер.ПолучитьНастройки(ИдентификаторОткрываемогоДиалога);
	ИдентификаторДиалога = ИдентификаторОткрываемогоДиалога;
	Провайдер = Настройки.Провайдер;
	Модель = Настройки.Модель;
	Агент = Настройки.Агент;
	ТипAPI = Настройки.ТипAPI;
	СистемныйПромт = Настройки.СистемныйПромт;
	ДанныеКонтекста = Настройки.ДанныеКонтекста;
	Сценарий = Настройки.Сценарий;
	КонтекстJSON = Настройки.КонтекстJSON;
	ВерсияКонтекста = Настройки.ВерсияКонтекста;
	ТипИсточника = Настройки.ТипИсточника;
	КлючИсточника = Настройки.КлючИсточника;
	ПредставлениеИсточника = Настройки.ПредставлениеИсточника;
	ГлубинаДиалога = ?(Настройки.ГлубинаДиалога > 0, Настройки.ГлубинаДиалога, 20);
	ПредыдущийIDОтвета = Настройки.ПредыдущийIDОтвета;
	РежимДиалога = Истина;
	НовыйЗаголовокДиалога = Настройки.Заголовок;
	НовоеСообщение = "";
	Сообщения.Очистить();
	ШагиАгента.Очистить();
	Вложения.Очистить();
	АргументыШага = "";
	РезультатШага = "";
	ПоследнийПолученныйШаг = 0;
	ИдентификаторОперации = ПустойУникальныйИдентификатор();
	ЗагрузитьИсториюДиалога();

	АктивнаяОперация = AI_АгентскиеОперации.ПолучитьАктивнуюОперациюДиалога(
		ИдентификаторДиалога);
	Если АктивнаяОперация = Неопределено Тогда
		ОперацияВыполняется = Ложь;
		СтатусОперации = "Диалог открыт";
	Иначе
		ИдентификаторОперации = АктивнаяОперация.ИдентификаторОперации;
		ОперацияВыполняется = Истина;
		СтатусОперации = "Восстановление выполняющегося запроса...";
		Если ЗначениеЗаполнено(АктивнаяОперация.Промт) Тогда
			ДобавитьСообщениеНаСервере("Вы", АктивнаяОперация.Промт);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АгентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДоступныеАгенты = AI_ДоступКАгентамКлиентСервер.ПолучитьДоступныхАгентов();
	Если ДоступныеАгенты.Количество() = 0 Тогда
		Сообщить("Для текущего пользователя нет доступных агентов.");
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения(
		"АгентВыбран",
		ЭтотОбъект);
	НачальноеЗначение = ДоступныеАгенты.НайтиПоЗначению(Агент);
	Если НачальноеЗначение = Неопределено Тогда
		ПоказатьВыборИзСписка(
			Оповещение,
			ДоступныеАгенты,
			Элемент);
	Иначе
		ПоказатьВыборИзСписка(
			Оповещение,
			ДоступныеАгенты,
			Элемент,
			НачальноеЗначение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АгентВыбран(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Агент = ВыбранноеЗначение.Значение;
	АгентПриИзменении(Элементы.Агент);

КонецПроцедуры

&НаКлиенте
Процедура АгентПриИзменении(Элемент)

	ЗаполнитьСистемныйПромтПоАгентуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПровайдерПриИзменении(Элемент)

	ОчиститьМодельНаСервере();
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ШагиАгентаПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.ШагиАгента.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		АргументыШага = "";
		РезультатШага = "";
	Иначе
		АргументыШага = ТекущиеДанные.Аргументы;
		РезультатШага = ТекущиеДанные.Результат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСостояниеОперации() Экспорт

	Если Не ОперацияВыполняется Или Не ЗначениеЗаполнено(ИдентификаторОперации) Тогда
		ОтключитьОпросОперации();
		Возврат;
	КонецЕсли;

	Попытка
		Изменения = AI_АгентскиеОперации.ПолучитьИзменения(
			ИдентификаторОперации,
			ПоследнийПолученныйШаг);
	Исключение
		СтатусОперации = "Не удалось обновить состояние: " + ОписаниеОшибки();
		ОбновитьHTMLДиалога();
		Возврат;
	КонецПопытки;

	ОбновитьШагиАгента(Изменения.Шаги);
	СтатусОперации = Изменения.ТекстСтатуса;
	Если ЗначениеЗаполнено(Изменения.ТекущийЭтап) Тогда
		СтатусОперации = СтатусОперации + " | " + Изменения.ТекущийЭтап;
	КонецЕсли;
	Элементы.ОтменитьОперацию.Доступность = Изменения.МожноОтменить;
	ОбновитьHTMLДиалога();

	Если Не Изменения.Финальная Тогда
		Возврат;
	КонецЕсли;

	ОперацияВыполняется = Ложь;
	ОтключитьОпросОперации();
	Если Изменения.Успешно Тогда
		ДобавитьСообщение(ПредставлениеАгента(), Изменения.Результат);
		НовоеСообщение = "";
		Вложения.Очистить();
		Если ЗначениеЗаполнено(Изменения.НовыйIDОтвета) Тогда
			ПредыдущийIDОтвета = Изменения.НовыйIDОтвета;
		КонецЕсли;
	Иначе
		Для Каждого Вложение Из Вложения Цикл
			Вложение.Статус = "Ошибка";
		КонецЦикла;
		ТекстОшибки = Изменения.ТекстОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Операция не завершена";
		КонецЕсли;
		ДобавитьСообщение("Система", ТекстОшибки);
	КонецЕсли;
	СтатистикаТокенов = СтрШаблон(
		"Токены: %1 вход / %2 выход | Вызовов инструментов: %3",
		Изменения.ВходящиеТокены,
		Изменения.ВыходящиеТокены,
		Изменения.ПоследнийНомерШага);
	Если Изменения.ТокеныИнструментов > 0 Тогда
		СтатистикаТокенов = СтатистикаТокенов + СтрШаблон(
			" | Токенов инструментов: %1",
			Изменения.ТокеныИнструментов);
	КонецЕсли;
	Если Изменения.КоличествоВложений > 0 Тогда
		СтатистикаТокенов = СтатистикаТокенов + СтрШаблон(
			" | Вложения: %1, токены %2/%3",
			Изменения.КоличествоВложений,
			Изменения.ВходящиеТокеныВложений,
			Изменения.ВыходящиеТокеныВложений);
	КонецЕсли;
	ОбновитьИсториюДиалоговНаСервере();
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьШагиАгента(НовыеШаги)

	Для Каждого Шаг Из НовыеШаги Цикл
		СтрокаШага = Неопределено;
		Для Каждого СуществующаяСтрока Из ШагиАгента Цикл
			Если СуществующаяСтрока.ИдентификаторШага = Шаг.ИдентификаторШага Тогда
				СтрокаШага = СуществующаяСтрока;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаШага = Неопределено Тогда
			СтрокаШага = ШагиАгента.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаШага, Шаг);
		Если Шаг.ПорядковыйНомер > ПоследнийПолученныйШаг Тогда
			ПоследнийПолученныйШаг = Шаг.ПорядковыйНомер;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОпросОперации()

	ОтключитьОпросОперации();
	ПодключитьОбработчикОжидания("ПроверитьСостояниеОперации", 1, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОпросОперации()

	Попытка
		ОтключитьОбработчикОжидания("ПроверитьСостояниеОперации");
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояниеИнтерфейса()

	Элементы.Отправить.Доступность = Не ОперацияВыполняется;
	Элементы.НовоеСообщение.Доступность = Не ОперацияВыполняется;
	Элементы.НастройкиДиалога.Доступность = Не ОперацияВыполняется;
	Элементы.ОтменитьОперацию.Видимость = ОперацияВыполняется;
	Элементы.ОтменитьОперацию.Доступность = ОперацияВыполняется;
	Элементы.Модель.Доступность = Не ОперацияВыполняется И ЗначениеЗаполнено(Провайдер);
	Элементы.ПрикрепитьФайлы.Видимость = Истина;
	Элементы.ПрикрепитьФайлы.Доступность = Не ОперацияВыполняется;
	Элементы.УдалитьВложение.Доступность = Не ОперацияВыполняется
		И Вложения.Количество() > 0;
	Элементы.ПанельВложений.Видимость = Вложения.Количество() > 0;
	ОбновитьHTMLДиалога();

КонецПроцедуры

&НаКлиенте
Функция ПроверитьНастройкиДиалога()

	Если Не ЗначениеЗаполнено(Провайдер)
		Или Не ЗначениеЗаполнено(Модель)
		Или Не ЗначениеЗаполнено(ТипAPI)
		Или Не ЗначениеЗаполнено(СистемныйПромт) Тогда
		СтатусОперации = "Заполните провайдера, модель, тип API и системную инструкцию";
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ДобавитьСообщение(Роль, ТекстСообщения)

	СтрокаСообщения = Сообщения.Добавить();
	СтрокаСообщения.Время = ТекущаяДата();
	СтрокаСообщения.Роль = Роль;
	СтрокаСообщения.Сообщение = Строка(ТекстСообщения);
	ОбновитьHTMLДиалога();

КонецПроцедуры

&НаКлиенте
Функция ПредставлениеАгента()

	Возврат ?(ЗначениеЗаполнено(Агент), Строка(Агент), "Модель");

КонецФункции

&НаКлиенте
Процедура ЛентаДиалогаДокументСформирован(Элемент)

	Попытка
		РежимПрокрутки = Строка(
			Элемент.Документ.body.getAttribute("data-scroll-mode"));
		Если РежимПрокрутки = "preserve" Тогда
			ПозицияПрокрутки = Число(
				Элемент.Документ.body.getAttribute("data-scroll-top"));
			Элемент.Документ.defaultView.scrollTo(0, ПозицияПрокрутки);
		Иначе
			ЯкорьКонца = Элемент.Документ.getElementById("chat-end");
			Если ЯкорьКонца <> Неопределено Тогда
				ЯкорьКонца.scrollIntoView(Ложь);
			Иначе
				Элемент.Документ.defaultView.scrollTo(
					0,
					Элемент.Документ.body.scrollHeight);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Попытка
			Элемент.Документ.body.scrollTop = Элемент.Документ.body.scrollHeight;
		Исключение
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьHTMLДиалога()

	ПараметрыПрокрутки = ПолучитьПараметрыПрокруткиДиалога();
	НовыйHTML = СформироватьHTMLДиалога(ПараметрыПрокрутки);
	Если HTMLДиалога <> НовыйHTML Тогда
		HTMLДиалога = НовыйHTML;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрыПрокруткиДиалога()

	ПараметрыПрокрутки = Новый Структура(
		"Режим,Позиция,ИнструментыРазвернуты",
		"end",
		0,
		Истина);
	Попытка
		Документ = Элементы.ЛентаДиалога.Документ;
		Лента = Документ.getElementById("chat");
		Если Лента = Неопределено Тогда
			Возврат ПараметрыПрокрутки;
		КонецЕсли;

		ПредыдущееКоличествоСообщений = Строка(
			Лента.getAttribute("data-message-count"));
		ПредыдущаяОперацияВыполняется = Строка(
			Лента.getAttribute("data-running"));
		ТекущееКоличествоСообщений = Формат(
			Сообщения.Количество(),
			"ЧГ=0");
		Если ОперацияВыполняется
			И ПредыдущаяОперацияВыполняется = "1"
			И ПредыдущееКоличествоСообщений = ТекущееКоличествоСообщений Тогда
			ПараметрыПрокрутки.Режим = "preserve";
			ПараметрыПрокрутки.Позиция = Документ.documentElement.scrollTop;
			Если Документ.body.scrollTop > ПараметрыПрокрутки.Позиция Тогда
				ПараметрыПрокрутки.Позиция = Документ.body.scrollTop;
			КонецЕсли;
		КонецЕсли;

		ПанельИнструментов = Документ.getElementById("tools-panel");
		Если ПанельИнструментов <> Неопределено Тогда
			ПараметрыПрокрутки.ИнструментыРазвернуты = ПанельИнструментов.hasAttribute("open");
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ПараметрыПрокрутки;

КонецФункции

&НаКлиенте
Функция СформироватьHTMLДиалога(ПараметрыПрокрутки)

	ЧастиHTML = Новый Массив;
	ЧастиHTML.Добавить("<!DOCTYPE html><html><head><meta charset='utf-8'><style>");
	ЧастиHTML.Добавить(СтилиHTMLДиалога());
	ЧастиHTML.Добавить(СтрШаблон(
		"</style></head><body data-scroll-mode='%1' data-scroll-top='%2'>"
		+ "<main class='chat' id='chat' data-message-count='%3' data-running='%4' aria-live='polite'>",
		ПараметрыПрокрутки.Режим,
		Формат(ПараметрыПрокрутки.Позиция, "ЧГ=0"),
		Формат(Сообщения.Количество(), "ЧГ=0"),
		?(ОперацияВыполняется, "1", "0")));

	НомерСообщения = 0;
	Для Каждого СообщениеДиалога Из Сообщения Цикл
		НомерСообщения = НомерСообщения + 1;
		ЧастиHTML.Добавить(СформироватьHTMLСообщения(
			СообщениеДиалога,
			НомерСообщения));
	КонецЦикла;

	HTMLИнструментов = СформироватьHTMLИнструментов(
		ПараметрыПрокрутки.ИнструментыРазвернуты);
	Если ЗначениеЗаполнено(HTMLИнструментов) Тогда
		ЧастиHTML.Добавить(HTMLИнструментов);
	КонецЕсли;
	Если НомерСообщения = 0 И Не ЗначениеЗаполнено(HTMLИнструментов) Тогда
		ЧастиHTML.Добавить(
			"<div class='empty-state'>Диалог пока пуст</div>");
	КонецЕсли;

	ЧастиHTML.Добавить("<div id='chat-end'></div></main>");
	ЧастиHTML.Добавить(СкриптыHTMLДиалога());
	ЧастиHTML.Добавить("</body></html>");
	Возврат СтрСоединить(ЧастиHTML, "");

КонецФункции

