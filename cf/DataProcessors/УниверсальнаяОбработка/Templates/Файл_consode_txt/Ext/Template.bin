{2,15,4,
{"S","ПривязатьПредопределенноеЗначениеКЭлементуПланаВидовХарактеристикПоКоду"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,f8eec01f-6be8-4bb7-a2b7-15215ea88f41},
{"B",0},
{"S","//ПривязатьПредопределенноеЗначениеКЭлементуПланаВидовХарактеристикПоКоду(""СвойстваОбъектов"", ""0060100359"", ""НоменклатураКонкурсаБезПЗИ"");
//ИмяПВХ, КодЭлемента, ИмяПредопределенныхДанных

ИмяПВХ = """";
КодЭлемента = """";
ИмяПредопределенныхДанных = """";

ТекстСообщения = """";
	
	Попытка
		
		НайденныйЭлемент = ПланыВидовХарактеристик[ИмяПВХ].НайтиПоКоду(КодЭлемента);
		
		Если ЗначениеЗаполнено(НайденныйЭлемент) Тогда 
			
			ОбъектЭлементаПВХ = НайденныйЭлемент.ПолучитьОбъект();
			
			Если ОбъектЭлементаПВХ.ИмяПредопределенныхДанных = ИмяПредопределенныхДанных Тогда
				
				ТекстСообщения = "" - Элемент ПВХ """""" + ИмяПВХ + """"""""
					+ "" код элемента """""" + КодЭлемента + """"""""
					+ "" уже связан с предопредленным значением """""" + ИмяПредопределенныхДанных + """"""."";
				
			Иначе
				
				ОбъектЭлементаПВХ.ИмяПредопределенныхДанных = ИмяПредопределенныхДанных;
				ОбъектЭлементаПВХ.Записать();
				
				ТекстСообщения = "" - Элемент ПВХ """""" + ИмяПВХ + """"""""
					+ "" код элемента """""" + КодЭлемента + """"""""
					+ "" связан с предопредленным значением """""" + ИмяПредопределенныхДанных + """"""."";
				
			КонецЕсли;
			
		Иначе
			
			ТекстСообщения = "" - Не найден элемент ПВХ """""" + ИмяПВХ + """"""""
				+ "" код элемента """""" + КодЭлемента + """"""""
				+ "" для связывания с предопредленным значением """""" + ИмяПредопределенныхДанных + """"""!"";
				
		КонецЕсли;
		
	Исключение
		
		ТекстСообщения = "" - Ошибка связывания элемента ПВХ """""" + ИмяПВХ + """"""""
			+ "" код элемента """""" + КодЭлемента + """"""""
			+ "" с предопредленным значением """""" + ИмяПредопределенныхДанных + """"""!""
			+ "" (Описание ошибки: "" + ОписаниеОшибки() + "")"";
		
	КонецПопытки;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);"},0},
{2,16,4,
{"S","ПривязатьПредопределенноеЗначениеКЭлементуСправочникаПоКоду"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,abe7c868-27fe-4cf3-820e-5067eb82aa8e},
{"B",0},
{"S","//ПривязатьПредопределенноеЗначениеКЭлементуСправочникаПоКоду(ИмяСправочника, КодЭлемента, ИмяПредопределенныхДанных)

ИмяСправочника = ""ТипыТМЦ""; 
КодЭлемента = ""CNT-001346"";
ИмяПредопределенныхДанных = ""РеализацияВторсырья"";
	
Попытка
	
	НайденныйЭлемент = Справочники[ИмяСправочника].НайтиПоКоду(КодЭлемента);
	
	Если ЗначениеЗаполнено(НайденныйЭлемент) Тогда 
		
		ОбъектЭлементаСправочника = НайденныйЭлемент.ПолучитьОбъект();
		
		Если ОбъектЭлементаСправочника.ИмяПредопределенныхДанных = ИмяПредопределенныхДанных Тогда
			Сообщить("" - Элемент справочника """""" + ИмяСправочника + """"""""
			+ "" код элемента """""" + КодЭлемента + """"""""
			+ "" уже связан с предопредленным значением """""" + ИмяПредопределенныхДанных + """"""."", СтатусСообщения.Информация);	
		Иначе
			ОбъектЭлементаСправочника.ИмяПредопределенныхДанных = ИмяПредопределенныхДанных;
			ОбъектЭлементаСправочника.Записать();
			Сообщить("" - Элемент справочника """""" + ИмяСправочника + """"""""
			+ "" код элемента """""" + КодЭлемента + """"""""
			+ "" связан с предопредленным значением """""" + ИмяПредопределенныхДанных + """"""."", СтатусСообщения.Информация);
		КонецЕсли;
		
	Иначе
		Сообщить("" - Не найден элемент справочника """""" + ИмяСправочника + """"""""
		+ "" код элемента """""" + КодЭлемента + """"""""
		+ "" для связывания с предопредленным значением """""" + ИмяПредопределенныхДанных + """"""!"", СтатусСообщения.ОченьВажное);
	КонецЕсли;
	
Исключение
	
	Сообщить("" - Ошибка связывания элемента справочника """""" + ИмяСправочника + """"""""
	+ "" код элемента """""" + КодЭлемента + """"""""
	+ "" с предопредленным значением """""" + ИмяПредопределенныхДанных + """"""!""
	+ "" (Описание ошибки: "" + ОписаниеОшибки() + "")"", СтатусСообщения.ОченьВажное);
	
КонецПопытки;"},0},
{2,17,4,
{"S","СоздатьПользовательскуюКлючевуюОперацию"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,a8a8a83f-0e9a-4221-93f1-c43e561768ce},
{"B",0},
{"S","
// Создание ключевых операций
//СоздатьПользовательскуюКлючевуюОперацию(Наименование, Имя, ЦелевоеВремя = 0, Приоритет = 0, МинимальноДопустимыйУровень = Неопределено)

Наименование				= ""Отчет """"Реестры имущества"""" (Подготовка предварительных данных для реестра """"Приобретение НМЦ"""")"";
Имя							= ""Отчет.РеестрыИмущества:ПодготовкаПредварительныхДанныхРеестраПриобретениеНМЦ"";
ЦелевоеВремя				= 1;
Приоритет					= 0;
МинимальноДопустимыйУровень	= Перечисления.УровниПроизводительности.Удовлетворительно;

Запрос = Новый Запрос;
Запрос.Текст = ""ВЫБРАТЬ ПЕРВЫЕ 1
|	КлючевыеОперации.Ссылка КАК Ссылка
|ИЗ
|	Справочник.КлючевыеОперации КАК КлючевыеОперации
|ГДЕ
|	КлючевыеОперации.ИмяХеш = &ИмяХеш"";

ХешMD5 = Новый ХешированиеДанных(ХешФункция.MD5);
ХешMD5.Добавить(Имя);
ИмяХешТемп = ХешMD5.ХешСумма;
ИмяХеш = СтрЗаменить(Строка(ИмяХешТемп), "" "", """");
Запрос.УстановитьПараметр(""ИмяХеш"", ИмяХеш);
Результат = Запрос.Выполнить();

Если Результат.Пустой() Тогда
	
	Попытка
		НовыйЭлемент = Справочники.КлючевыеОперации.СоздатьЭлемент();
		НовыйЭлемент.Наименование = Наименование;
		НовыйЭлемент.Имя = Имя;
		НовыйЭлемент.ЦелевоеВремя = ЦелевоеВремя;
		НовыйЭлемент.Приоритет = Приоритет;
		НовыйЭлемент.МинимальноДопустимыйУровень = МинимальноДопустимыйУровень;
		НовыйЭлемент.ИмяХеш = ИмяХеш;
		НовыйЭлемент.ВыполненаСОшибкой = Ложь;
		НовыйЭлемент.Записать();
	Исключение
		Комментарий = СтрШаблон(""Не удалось создать КО с именем %1. "", Имя) + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(""Запись ключевой операции"", УровеньЖурналаРегистрации.Ошибка,,, Комментарий);
	КонецПопытки;
	
КонецЕсли;"},0},
{2,18,4,
{"S","СоздатьПредопределенныйЭлементСправочника"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,349709df-0d2b-43cf-9afb-0addc32ae0d8},
{"B",0},
{"S","Функция СоздатьПредопределенныйЭлементСправочника(ИмяСправочника, ИмяПредопределенныхДанных, НаименованиеНовогоЭлемента, ЭтоГруппа = Ложь
													, СтруктураДопСвойств = Неопределено, УИД = Неопределено)
	
	Результат = Неопределено;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	
	ПакетЗапроса 	= СхемаЗапроса.ПакетЗапросов[0];
	ОператорЗапроса = ПакетЗапроса.Операторы[0];
	
	ИсточникНоменклатура = ОператорЗапроса.Источники.Добавить(""Справочник."" + ИмяСправочника, ""ВыбранныйСправочник"");
	
	ОператорЗапроса.ВыбираемыеПоля.Добавить(""ВыбранныйСправочник.Ссылка"");
	ОператорЗапроса.Отбор.Добавить(""ВыбранныйСправочник.ИмяПредопределенныхДанных = &ИмяПредопределенныхДанных"");
	
	Запрос = Новый Запрос;
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	Запрос.УстановитьПараметр(""ИмяПредопределенныхДанных"", ИмяПредопределенныхДанных);
	
	ТекстСообщения = """";
	ВидОповещения = Неопределено;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		
		Если НЕ ЭтоГруппа Тогда
			Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
		Иначе
			Элемент = Справочники[ИмяСправочника].СоздатьГруппу();
		КонецЕсли;
		
		ТекстСообщения = "" - Создан новый элемент Справочника """"%1"""", связан с предопредленным значением """"%2""""."";
		ТекстОшибки = "" - Ошибка создания нового элемента Справочника """"%1"""" для привязки к предопредленному значению """"%2""""!""
						+ "" (Описание ошибки: %3)"";
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		
		ТекстСообщения = "" - Обновлен элемент Справочника """"%1"""", связаный с предопредленным значением """"%2""""."";
		ТекстОшибки = "" - Ошибка обновления элемента Справочника """"%1"""", связанного с предопредленным значением """"%2""""!""
						+ "" (Описание ошибки: %3)"";
	КонецЕсли;
	
	Попытка
		
		Если НЕ УИД = Неопределено Тогда
			
			СсылкаПоУИД = Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
			Если НЕ Элемент.Ссылка.Пустая() И НЕ СсылкаПоУИД = Элемент.Ссылка Тогда
				Элемент.ИмяПредопределенныхДанных = """";
				ТекстСообщения = "" - Сменился элемент Справочника """"%1"""", связаный с предопредленным значением """"%2""""."";
				ТекстОшибки = "" - Ошибка смены предопределенного элемента """"%2"""" Справочника """"%1""""!""
								+ "" (Описание ошибки: %3)"";
				Элемент.Записать();
			КонецЕсли;
			
			ОбъектПоУИД = СсылкаПоУИД.ПолучитьОбъект();
			Если ОбъектПоУИД = Неопределено Тогда
				
				Если НЕ Элемент.Ссылка.Пустая() Тогда
					Если НЕ ЭтоГруппа Тогда
						Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
					Иначе
						Элемент = Справочники[ИмяСправочника].СоздатьГруппу();
					КонецЕсли;
				КонецЕсли;
				
				Элемент.УстановитьСсылкуНового(СсылкаПоУИД);
				
			Иначе
				Элемент = ОбъектПоУИД;
			КонецЕсли;
			
		КонецЕсли;
		
		Элемент.Наименование = НаименованиеНовогоЭлемента;
		Элемент.ИмяПредопределенныхДанных = ИмяПредопределенныхДанных;
		Если СтруктураДопСвойств <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Элемент, СтруктураДопСвойств);
		КонецЕсли;
		
		Элемент.Записать();
		
		ТекстСообщения = СтрШаблон(ТекстСообщения, ИмяСправочника, ИмяПредопределенныхДанных);
		ВидОповещения = СтатусСообщения.Информация;
		
		Результат = Элемент.Ссылка;
		
	Исключение
		ТекстСообщения = СтрШаблон(ТекстОшибки, ИмяСправочника, ИмяПредопределенныхДанных, ОписаниеОшибки());
		ВидОповещения = СтатусСообщения.ОченьВажное;
	КонецПопытки;
	
	Сообщить(ТекстСообщения, ВидОповещения);
	
	Возврат Результат;
	
КонецФункции"},0}
}
},
