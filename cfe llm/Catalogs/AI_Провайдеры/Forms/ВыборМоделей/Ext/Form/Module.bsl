#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Параметры.Провайдер) Тогда
		Отказ = Истина;
		ВызватьИсключение "Не указан провайдер для получения списка моделей.";
	КонецЕсли;

	Провайдер = Параметры.Провайдер;
	ДоступныеМодели = Справочники.AI_Провайдеры.ПолучитьДоступныеМодели(Провайдер);
	Источник = ДоступныеМодели.Источник;

	ТаблицаМоделей = Новый ТаблицаЗначений;
	ТаблицаМоделей.Колонки.Добавить("Выбрана", Новый ОписаниеТипов("Булево"));
	ТаблицаМоделей.Колонки.Добавить(
		"КодAPI",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	ТаблицаМоделей.Колонки.Добавить(
		"Описание",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));

	Для Каждого ОписаниеМодели Из ДоступныеМодели.Модели Цикл
		СтрокаМодели = ТаблицаМоделей.Добавить();
		СтрокаМодели.Выбрана = Ложь;
		СтрокаМодели.КодAPI = ОписаниеМодели.КодAPI;
		СтрокаМодели.Описание = ОписаниеМодели.Описание;
	КонецЦикла;

	ЗначениеВРеквизитФормы(ТаблицаМоделей, "Модели");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	УстановитьВыборВсехМоделей(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьВыборВсехМоделей(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыбранные(Команда)

	Если КоличествоВыбранныхМоделей() = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте хотя бы одну модель для загрузки.");
		Возврат;
	КонецЕсли;

	Результат = ЗагрузитьВыбранныеНаСервере();
	Сообщить(СтрШаблон(
		"Модели загружены (%1). Выбрано: %2, создано: %3, обновлено: %4, без изменений: %5.",
		Результат.Источник,
		Результат.Получено,
		Результат.Создано,
		Результат.Обновлено,
		Результат.БезИзменений));
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВыборВсехМоделей(ЗначениеВыбора)
	Для Каждого СтрокаМодели Из Модели Цикл
		СтрокаМодели.Выбрана = ЗначениеВыбора;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция КоличествоВыбранныхМоделей()
	КоличествоВыбранных = 0;
	Для Каждого СтрокаМодели Из Модели Цикл
		Если СтрокаМодели.Выбрана Тогда
			КоличествоВыбранных = КоличествоВыбранных + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат КоличествоВыбранных;
КонецФункции

&НаСервере
Функция ЗагрузитьВыбранныеНаСервере()

	КодыМоделей = Новый Массив;
	ТаблицаМоделей = РеквизитФормыВЗначение("Модели");
	Для Каждого СтрокаМодели Из ТаблицаМоделей Цикл
		Если СтрокаМодели.Выбрана Тогда
			КодыМоделей.Добавить(СтрокаМодели.КодAPI);
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.AI_Провайдеры.ЗагрузитьВыбранныеМодели(
		Провайдер,
		КодыМоделей);

КонецФункции

#КонецОбласти
