// Открывает помощника для выбранных объектов.
//
// ФормаВладелец — форма прикладного объекта, если помощника вызвали из нее.
// Через владельца помощник заполняет реквизиты формы, не записывая объект:
// другого канала связи с формой конкретной конфигурации у подсистемы нет.
Процедура ОткрытьПомощник(ОбъектыНазначения = Неопределено, ТипМеста = "Объект",
		ФормаВладелец = Неопределено) Экспорт

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОбъектыНазначения", ОбъектыНазначения);
	ПараметрыФормы.Вставить("ТипМеста", ТипМеста);

	Если ФормаВладелец = Неопределено Тогда
		// Вызов из раздела: помощнику некуда возвращаться, открываем обычным окном.
		ОткрытьФорму("Обработка.AI_ПомощникКонтекста.Форма.Форма", ПараметрыФормы);
		Возврат;
	КонецЕсли;

	// Помощник — шаг работы с конкретной формой, а не отдельное рабочее место:
	// открываем окном поверх вызвавшей формы, а не еще одной вкладкой.
	ОткрытьФорму(
		"Обработка.AI_ПомощникКонтекста.Форма.Форма",
		ПараметрыФормы,
		ФормаВладелец,
		,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

Процедура ОткрытьГлобальныйПомощник() Экспорт
	ОткрытьПомощник(Неопределено, "Глобально");
КонецПроцедуры
