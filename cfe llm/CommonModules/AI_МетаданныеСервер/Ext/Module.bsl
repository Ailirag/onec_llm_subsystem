
// Сервис безопасного обзора метаданных для LLM-агента.

Функция НайтиОбъекты(Знач СтрокаПоиска = "", Знач Виды = Неопределено, Знач Лимит = 50) Экспорт

	Лимит = НормализоватьЛимит(Лимит, 50, 100);
	СтрокаПоиска = НРег(СокрЛП(Строка(СтрокаПоиска)));
	ФильтрВидов = ПодготовитьФильтрВидов(Виды);
	Результат = Новый Массив;

	Для Каждого ОписаниеКоллекции Из КоллекцииМетаданных() Цикл
		Если ФильтрВидов.Количество() > 0
				И ФильтрВидов.Получить(НРег(ОписаниеКоллекции.Вид)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Коллекция = Метаданные[ОписаниеКоллекции.Имя];
		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			Если Результат.Количество() >= Лимит Тогда
				Возврат Новый Структура("ok,items", Истина, Результат);
			КонецЕсли;
			Если Не ДоступноЧтение(ОбъектМетаданных) Тогда
				Продолжить;
			КонецЕсли;

			ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
			Синоним = Строка(ОбъектМетаданных.Синоним);
			СтрокаСопоставления = НРег(ОбъектМетаданных.Имя + " " + Синоним + " " + ПолноеИмя);
			Если ЗначениеЗаполнено(СтрокаПоиска)
					И СтрНайти(СтрокаСопоставления, СтрокаПоиска) = 0 Тогда
				Продолжить;
			КонецЕсли;

			Результат.Добавить(Новый Структура(
				"full_name,name,synonym,kind",
				ПолноеИмя,
				ОбъектМетаданных.Имя,
				Синоним,
				ОписаниеКоллекции.Вид));
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("ok,items", Истина, Результат);

КонецФункции

Функция Описать(Знач ПолныеИмена, Знач УровеньДетализации = "fields") Экспорт

	Результат = Новый Массив;
	Если ПолныеИмена = Неопределено Тогда
		Возврат Новый Структура("ok,items", Истина, Результат);
	КонецЕсли;

	Количество = 0;
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		Количество = Количество + 1;
		Если Количество > 20 Тогда
			Прервать;
		КонецЕсли;

		ОбъектМетаданных = ПолучитьОбъектМетаданных(Строка(ПолноеИмя));
		Если ОбъектМетаданных = Неопределено Тогда
			Результат.Добавить(Новый Структура(
				"full_name,error",
				Строка(ПолноеИмя),
				"Объект метаданных не найден."));
			Продолжить;
		КонецЕсли;
		Если Не ДоступноЧтение(ОбъектМетаданных) Тогда
			Результат.Добавить(Новый Структура(
				"full_name,error",
				Строка(ПолноеИмя),
				"Недостаточно права Чтение."));
			Продолжить;
		КонецЕсли;

		Описание = Новый Структура;
		Описание.Вставить("full_name", ОбъектМетаданных.ПолноеИмя());
		Описание.Вставить("name", ОбъектМетаданных.Имя);
		Описание.Вставить("synonym", Строка(ОбъектМетаданных.Синоним));
		Описание.Вставить("kind", ВидОбъекта(ОбъектМетаданных));
		Описание.Вставить("fields", ПолучитьПоля(ОбъектМетаданных));
		Описание.Вставить("tabular_sections", ПолучитьТабличныеЧасти(ОбъектМетаданных));
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Новый Структура("ok,items", Истина, Результат);

КонецФункции

Функция ПолучитьОбъектМетаданных(Знач ПолноеИмя) Экспорт

	ИскомоеИмя = НРег(СокрЛП(ПолноеИмя));
	Для Каждого ОписаниеКоллекции Из КоллекцииМетаданных() Цикл
		Для Каждого ОбъектМетаданных Из Метаданные[ОписаниеКоллекции.Имя] Цикл
			Если НРег(ОбъектМетаданных.ПолноеИмя()) = ИскомоеИмя Тогда
				Возврат ОбъектМетаданных;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ВсеОбъектыДляПроверкиЗапроса() Экспорт

	Результат = Новый Массив;
	Для Каждого ОписаниеКоллекции Из КоллекцииМетаданных() Цикл
		Для Каждого ОбъектМетаданных Из Метаданные[ОписаниеКоллекции.Имя] Цикл
			Результат.Добавить(ОбъектМетаданных);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПолучитьПоля(Знач ОбъектМетаданных)

	Поля = Новый Массив;
	ДобавитьПоляКоллекции(Поля, ОбъектМетаданных, "СтандартныеРеквизиты", "standard");
	ДобавитьПоляКоллекции(Поля, ОбъектМетаданных, "Реквизиты", "attribute");
	ДобавитьПоляКоллекции(Поля, ОбъектМетаданных, "Измерения", "dimension");
	ДобавитьПоляКоллекции(Поля, ОбъектМетаданных, "Ресурсы", "resource");
	Возврат Поля;

КонецФункции

Процедура ДобавитьПоляКоллекции(Знач Поля, Знач ОбъектМетаданных, Знач ИмяСвойства, Знач ВидПоля)

	Попытка
		Коллекция = ОбъектМетаданных[ИмяСвойства];
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Поле Из Коллекция Цикл
		ТипПоля = "";
		Попытка
			ТипПоля = Строка(Поле.Тип);
		Исключение
		КонецПопытки;
		Поля.Добавить(Новый Структура(
			"name,synonym,kind,type",
			Поле.Имя,
			Строка(Поле.Синоним),
			ВидПоля,
			ТипПоля));
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьТабличныеЧасти(Знач ОбъектМетаданных)

	Результат = Новый Массив;
	Попытка
		ТабличныеЧасти = ОбъектМетаданных.ТабличныеЧасти;
	Исключение
		Возврат Результат;
	КонецПопытки;

	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		Поля = Новый Массив;
		ДобавитьПоляКоллекции(Поля, ТабличнаяЧасть, "Реквизиты", "attribute");
		Результат.Добавить(Новый Структура(
			"name,synonym,fields",
			ТабличнаяЧасть.Имя,
			Строка(ТабличнаяЧасть.Синоним),
			Поля));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДоступноЧтение(Знач ОбъектМетаданных)

	Попытка
		Возврат ПравоДоступа("Чтение", ОбъектМетаданных);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ВидОбъекта(Знач ОбъектМетаданных)

	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	ПозицияТочки = СтрНайти(ПолноеИмя, ".");
	Если ПозицияТочки = 0 Тогда
		Возврат "metadata";
	КонецЕсли;
	Возврат Лев(ПолноеИмя, ПозицияТочки - 1);

КонецФункции

Функция ПодготовитьФильтрВидов(Знач Виды)

	Результат = Новый Соответствие;
	Если Виды = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Вид Из Виды Цикл
		Результат.Вставить(НРег(СокрЛП(Строка(Вид))), Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КоллекцииМетаданных()

	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("Имя,Вид", "Справочники", "catalog"));
	Результат.Добавить(Новый Структура("Имя,Вид", "Документы", "document"));
	Результат.Добавить(Новый Структура("Имя,Вид", "РегистрыСведений", "information_register"));
	Результат.Добавить(Новый Структура("Имя,Вид", "РегистрыНакопления", "accumulation_register"));
	Результат.Добавить(Новый Структура("Имя,Вид", "РегистрыБухгалтерии", "accounting_register"));
	Результат.Добавить(Новый Структура("Имя,Вид", "РегистрыРасчета", "calculation_register"));
	Результат.Добавить(Новый Структура("Имя,Вид", "ПланыСчетов", "chart_of_accounts"));
	Результат.Добавить(Новый Структура("Имя,Вид", "ПланыВидовХарактеристик", "chart_of_characteristic_types"));
	Результат.Добавить(Новый Структура("Имя,Вид", "ПланыВидовРасчета", "chart_of_calculation_types"));
	Результат.Добавить(Новый Структура("Имя,Вид", "БизнесПроцессы", "business_process"));
	Результат.Добавить(Новый Структура("Имя,Вид", "Задачи", "task"));
	Результат.Добавить(Новый Структура("Имя,Вид", "Перечисления", "enum"));
	Возврат Результат;

КонецФункции

Функция НормализоватьЛимит(Знач Значение, Знач ПоУмолчанию, Знач Максимум)

	Если ТипЗнч(Значение) <> Тип("Число") Или Значение <= 0 Тогда
		Значение = ПоУмолчанию;
	КонецЕсли;
	Возврат Мин(Цел(Значение), Максимум);

КонецФункции
