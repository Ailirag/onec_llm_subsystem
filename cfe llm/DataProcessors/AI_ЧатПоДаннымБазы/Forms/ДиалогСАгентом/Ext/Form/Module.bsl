&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ВосстановитьНастройкиДиалогаНаСервере();
	ПрименитьПараметрыСценарияНаСервере();
	Если ГлубинаДиалога <= 0 Тогда
		ГлубинаДиалога = 20;
		РежимДиалога = Истина;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СистемныйПромт) Тогда
		ЗаполнитьСистемныйПромтПоАгентуНаСервере();
	КонецЕсли;

	КонтекстИзПараметров = Неопределено;
	Если Параметры.Свойство("ДанныеКонтекста", КонтекстИзПараметров) Тогда
		ДанныеКонтекста = Строка(КонтекстИзПараметров);
	КонецЕсли;

	// Помощник открывает переписку уже выполненной операции: беседа есть, и
	// показать нужно ее, а не начинать новую и не подхватывать чужую.
	ОткрываемыйДиалог = Неопределено;
	Если Параметры.Свойство("ИдентификаторДиалога", ОткрываемыйДиалог)
		И ТипЗнч(ОткрываемыйДиалог) = Тип("УникальныйИдентификатор") Тогда
		ОбновитьИсториюДиалоговНаСервере();
		ОткрытьДиалогИзИсторииНаСервере(ОткрываемыйДиалог);
		СтатистикаТокенов = "";
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторДиалога) Тогда
		ИдентификаторДиалога = ПустойУникальныйИдентификатор();
	КонецЕсли;
	ОбновитьИсториюДиалоговНаСервере();
	ЗагрузитьИсториюДиалога();

	АктивнаяОперация = Неопределено;
	Если ЗначениеЗаполнено(ИдентификаторДиалога) Тогда
		АктивнаяОперация = AI_АгентскиеОперации.ПолучитьАктивнуюОперациюДиалога(
			ИдентификаторДиалога);
	КонецЕсли;
	// Диалог, открытый из места запуска, несет собственный контекст источника.
	// Подхват посторонней операции подменил бы его чужой беседой.
	Если АктивнаяОперация = Неопределено И Не ЭтоЗапускПоМестуСценария() Тогда
		АктивнаяОперация = AI_АгентскиеОперации.ПолучитьПоследнююАктивнуюОперациюПользователя();
	КонецЕсли;

	Если АктивнаяОперация <> Неопределено Тогда
		ИдентификаторОперации = АктивнаяОперация.ИдентификаторОперации;
		ИдентификаторДиалога = АктивнаяОперация.ИдентификаторДиалога;
		ОперацияВыполняется = Истина;
		СтатусОперации = "Восстановление выполняющегося запроса...";
		Сообщения.Очистить();
		ЗагрузитьИсториюДиалога();
		Если ЗначениеЗаполнено(АктивнаяОперация.Промт) Тогда
			ДобавитьСообщениеНаСервере("Вы", АктивнаяОперация.Промт);
		КонецЕсли;
	Иначе
		ОперацияВыполняется = Ложь;
		СтатусОперации = "Готов к диалогу";
	КонецЕсли;
	СтатистикаТокенов = "";
	ПоследнийПолученныйШаг = 0;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьСостояниеИнтерфейса();
	Если ОперацияВыполняется Тогда
		ПодключитьОпросОперации();
		ПроверитьСостояниеОперации();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	ОтключитьОпросОперации();
	СохранитьНастройкиДиалогаНаСервере();
	Если Не ОперацияВыполняется Тогда
		УдалитьВсеВложения();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиДиалогаНаСервере()

	Попытка
		Настройки = ХранилищеОбщихНастроек.Загрузить(
			"AI_ЧатПоДаннымБазы",
			"ДиалогСАгентом");
		Если Настройки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Настройки.Свойство("Провайдер", Провайдер);
		Настройки.Свойство("Модель", Модель);
		Настройки.Свойство("ТипAPI", ТипAPI);
		Настройки.Свойство("Агент", Агент);
	Исключение
		ЗаписьЖурналаРегистрации(
			"AI.НастройкиДиалога",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиДиалогаНаСервере()

	// Агент и модель сценария принадлежат месту запуска, а не пользователю:
	// сохранение их по умолчанию подменило бы настройки обычного диалога.
	Если ЭтоЗапускПоМестуСценария() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Настройки = Новый Структура;
		Настройки.Вставить("Провайдер", Провайдер);
		Настройки.Вставить("Модель", Модель);
		Настройки.Вставить("ТипAPI", ТипAPI);
		Настройки.Вставить("Агент", Агент);
		ХранилищеОбщихНастроек.Сохранить(
			"AI_ЧатПоДаннымБазы",
			"ДиалогСАгентом",
			Настройки);
	Исключение
		ЗаписьЖурналаРегистрации(
			"AI.НастройкиДиалога",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Истина, если диалог открыт из места запуска сценария либо из адаптера
// с прикладным контекстом. Настройки пользователя в этом случае не трогаем.
&НаСервере
Функция ЭтоЗапускПоМестуСценария()
	Возврат ЗначениеЗаполнено(Сценарий) Или ЗначениеЗаполнено(КонтекстJSON);
КонецФункции

&НаКлиенте
Процедура ОтправитьОбработка(Команда)

	Если ОперацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	Если Не ПроверитьНастройкиДиалога() Тогда
		Возврат;
	КонецЕсли;

	ТекстСообщения = ОбрезатьКраяСтроки(НовоеСообщение);
	Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
		СтатусОперации = "Введите сообщение";
		Возврат;
	КонецЕсли;
	Попытка
		ИдентификаторДиалога = ОбеспечитьДиалогНаСервере();
	Исключение
		СтатусОперации = "Не удалось подготовить диалог: " + ОписаниеОшибки();
		Возврат;
	КонецПопытки;

	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ИдентификаторДиалога", ИдентификаторДиалога);
	ПараметрыОперации.Вставить("Провайдер", Провайдер);
	ПараметрыОперации.Вставить("Модель", Модель);
	ПараметрыОперации.Вставить("Агент", Агент);
	ПараметрыОперации.Вставить("ТипAPI", ТипAPI);
	ПараметрыОперации.Вставить("Промт", ТекстСообщения);
	ПараметрыОперации.Вставить("СистемныйПромт", СистемныйПромт);
	ПараметрыОперации.Вставить("ДанныеКонтекста", ДанныеКонтекста);
	ПараметрыОперации.Вставить("РежимДиалога", РежимДиалога);
	ПараметрыОперации.Вставить("ГлубинаДиалога", ГлубинаДиалога);
	ПараметрыОперации.Вставить("ПредыдущийIDОтвета", ПредыдущийIDОтвета);
	Если ЗначениеЗаполнено(Сценарий) И Сообщения.Количество() = 0 Тогда
		ПараметрыОперации.Вставить("Сценарий", Сценарий);
	КонецЕсли;
	ПараметрыОперации.Вставить("КонтекстJSON", КонтекстJSON);
	ПараметрыОперации.Вставить("ВерсияКонтекста", ?(ВерсияКонтекста > 0, ВерсияКонтекста, 1));
	ПараметрыОперации.Вставить("ТипИсточника", ТипИсточника);
	ПараметрыОперации.Вставить("КлючИсточника", КлючИсточника);
	ПараметрыОперации.Вставить("ПредставлениеИсточника", ПредставлениеИсточника);
	СсылкиВложений = Новый Массив;
	Для Каждого Вложение Из Вложения Цикл
		СсылкиВложений.Добавить(Вложение.Ссылка);
	КонецЦикла;
	ПараметрыОперации.Вставить("Вложения", СсылкиВложений);

	Попытка
		РезультатЗапуска = AI_АгентскиеОперации.НачатьОперацию(ПараметрыОперации);
	Исключение
		СтатусОперации = "Не удалось отправить: " + ОписаниеОшибки();
		Возврат;
	КонецПопытки;

	ИдентификаторОперации = РезультатЗапуска.ИдентификаторОперации;
	ИдентификаторДиалога = РезультатЗапуска.ИдентификаторДиалога;
	ОперацияВыполняется = Истина;
	ПоследнийПолученныйШаг = 0;
	ШагиАгента.Очистить();
	АргументыШага = "";
	РезультатШага = "";
	ДобавитьСообщение("Вы", ТекстСообщения + ПредставлениеВложений());
	Для Каждого Вложение Из Вложения Цикл
		Вложение.Статус = "В очереди";
	КонецЦикла;
	СтатусОперации = "Запрос поставлен в очередь";
	ОбновитьСостояниеИнтерфейса();
	ПодключитьОпросОперации();
	ПроверитьСостояниеОперации();

КонецПроцедуры

&НаСервере
Процедура ПрименитьПараметрыСценарияНаСервере()

	СценарийИзПараметров = Неопределено;
	Если Параметры.Свойство("Сценарий", СценарийИзПараметров)
		И ЗначениеЗаполнено(СценарийИзПараметров) Тогда
		Если ТипЗнч(СценарийИзПараметров) <> Тип("СправочникСсылка.AI_Сценарии")
			Или СценарийИзПараметров.ПометкаУдаления
			Или Не СценарийИзПараметров.Активен Тогда
			ВызватьИсключение "Передан недоступный сценарий диалога.";
		КонецЕсли;
		Сценарий = СценарийИзПараметров;
		Агент = Сценарий.Агент;
		Провайдер = Сценарий.Провайдер;
		Модель = Сценарий.Модель;
		ТипAPI = Сценарий.ТипAPI;
	КонецЕсли;

	НачальныйЗапрос = "";
	Если Параметры.Свойство("НачальныйЗапрос", НачальныйЗапрос)
		И ЗначениеЗаполнено(НачальныйЗапрос) Тогда
		НовоеСообщение = Строка(НачальныйЗапрос);
	КонецЕсли;
	Параметры.Свойство("КонтекстJSON", КонтекстJSON);
	Параметры.Свойство("ВерсияКонтекста", ВерсияКонтекста);
	Параметры.Свойство("ТипИсточника", ТипИсточника);
	Параметры.Свойство("КлючИсточника", КлючИсточника);
	Параметры.Свойство("ПредставлениеИсточника", ПредставлениеИсточника);

КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайлыОбработка(Команда)

	СтатусОперации = "Открытие выбора файлов...";
	Если ОперацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Провайдер) Тогда
		СтатусОперации = "Сначала выберите провайдера";
		Возврат;
	КонецЕсли;
	Если Вложения.Количество() >= 5 Тогда
		СтатусОперации = "К сообщению можно прикрепить не более 5 файлов";
		Возврат;
	КонецЕсли;

	// НачатьПомещениеФайлов использует штатный диалог и не требует
	// расширения работы с файлами в тонком, толстом и веб-клиенте.
	ПодключениеРасширенияРаботыСФайламиЗавершение(Истина, Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ПодключениеРасширенияРаботыСФайламиЗавершение(
		Результат, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		СтатусОперации = "Клиент не разрешил работу с файлами";
		Возврат;
	КонецЕсли;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файлы";
	Диалог.Фильтр =
		"Все поддерживаемые файлы (*.png;*.jpg;*.jpeg;*.webp;*.pdf;*.doc;*.docx;*.rtf;*.odt;*.xls;*.xlsx;*.ppt;*.pptx;*.txt;*.md;*.json;*.xml;*.html;*.htm;*.csv;*.tsv;*.log;*.bsl;*.os;*.py;*.js;*.ts;*.sql;*.yaml;*.yml)"
		+ "|*.png;*.jpg;*.jpeg;*.webp;*.pdf;*.doc;*.docx;*.rtf;*.odt;*.xls;*.xlsx;*.ppt;*.pptx;*.txt;*.md;*.json;*.xml;*.html;*.htm;*.csv;*.tsv;*.log;*.bsl;*.os;*.py;*.js;*.ts;*.sql;*.yaml;*.yml"
		+ "|Изображения (*.png;*.jpg;*.jpeg;*.webp)|*.png;*.jpg;*.jpeg;*.webp"
		+ "|Документы (*.pdf;*.doc;*.docx;*.rtf;*.odt;*.xls;*.xlsx;*.ppt;*.pptx)|*.pdf;*.doc;*.docx;*.rtf;*.odt;*.xls;*.xlsx;*.ppt;*.pptx"
		+ "|Текст и код (*.txt;*.md;*.json;*.xml;*.html;*.csv;*.tsv;*.log;*.bsl;*.os;*.py;*.js;*.ts;*.sql;*.yaml;*.yml)"
		+ "|*.txt;*.md;*.json;*.xml;*.html;*.htm;*.csv;*.tsv;*.log;*.bsl;*.os;*.py;*.js;*.ts;*.sql;*.yaml;*.yml";
	Диалог.МножественныйВыбор = Истина;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Оповещение = Новый ОписаниеОповещения(
		"ПомещениеВложенийЗавершение",
		ЭтотОбъект);
	НачатьПомещениеФайлов(
		Оповещение,
		,
		Диалог,
		Истина,
		ЭтотОбъект.УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПомещениеВложенийЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
		СтатусОперации = "Выбор файлов отменен";
		Возврат;
	КонецЕсли;
	Для Каждого ПомещенныйФайл Из Результат Цикл
		Если Вложения.Количество() >= 5 Тогда
			СтатусОперации = "Загружены первые 5 файлов";
			Прервать;
		КонецЕсли;
		Попытка
			ДанныеВложения = СохранитьВложениеНаСервере(
				ПомещенныйФайл.Имя,
				ПомещенныйФайл.Хранение);
			СтрокаВложения = Вложения.Добавить();
			СтрокаВложения.Ссылка = ДанныеВложения.Ссылка;
			СтрокаВложения.ИмяФайла = ДанныеВложения.ИмяФайла;
			СтрокаВложения.MIMEТип = ДанныеВложения.MIMEТип;
			СтрокаВложения.РазмерБайт = ДанныеВложения.РазмерБайт;
			СтрокаВложения.Размер = ПредставлениеРазмера(ДанныеВложения.РазмерБайт);
			СтрокаВложения.Статус = ДанныеВложения.Статус;
		Исключение
			СтатусОперации = СтрШаблон(
				"Не удалось прикрепить %1: %2",
				ПомещенныйФайл.Имя,
				ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Если Вложения.Количество() > 0 Тогда
		СтатусОперации = СтрШаблон(
			"Прикреплено файлов: %1",
			Вложения.Количество());
	КонецЕсли;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВложениеОбработка(Команда)

	Если ОперацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.Вложения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьВложениеНаСервере(ТекущиеДанные.Ссылка);
		Вложения.Удалить(ТекущиеДанные);
		СтатусОперации = "Вложение удалено";
	Исключение
		СтатусОперации = "Не удалось удалить вложение: " + ОписаниеОшибки();
	КонецПопытки;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВсеВложения()

	Пока Вложения.Количество() > 0 Цикл
		СтрокаВложения = Вложения[0];
		Попытка
			УдалитьВложениеНаСервере(СтрокаВложения.Ссылка);
		Исключение
		КонецПопытки;
		Вложения.Удалить(СтрокаВложения);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОперациюОбработка(Команда)

	Если Не ОперацияВыполняется Или Не ЗначениеЗаполнено(ИдентификаторОперации) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		AI_АгентскиеОперации.ЗапроситьОтмену(ИдентификаторОперации);
		СтатусОперации = "Отмена запрошена. Ожидание безопасной точки остановки";
		Элементы.ОтменитьОперацию.Доступность = Ложь;
	Исключение
		СтатусОперации = "Не удалось запросить отмену: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

