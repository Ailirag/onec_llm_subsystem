КонецПроцедуры

&НаКлиенте
Функция ПредставлениеВложений()

	Если Вложения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого Вложение Из Вложения Цикл
		Имена.Добавить(Вложение.ИмяФайла);
	КонецЦикла;
	Возврат Символы.ПС + "Вложения: " + СтрСоединить(Имена, ", ");

КонецФункции

&НаКлиенте
Функция ПредставлениеРазмера(РазмерБайт)

	Если РазмерБайт < 1024 Тогда
		Возврат СтрШаблон("%1 Б", РазмерБайт);
	ИначеЕсли РазмерБайт < 1024 * 1024 Тогда
		Возврат СтрШаблон("%1 КБ", Окр(РазмерБайт / 1024, 1));
	КонецЕсли;
	Возврат СтрШаблон("%1 МБ", Окр(РазмерБайт / 1048576, 1));

КонецФункции

