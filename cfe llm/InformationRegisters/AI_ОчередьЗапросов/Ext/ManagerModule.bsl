
#Область ПрограммныйИнтерфейс

Процедура ЗафиксироватьОшибкуОбработки(Идентификатор, ТекстОшибки) Экспорт

	МаксПопыток = Константы.AI_КоличествоПопытокОбработкиЗапросаОчереди.Получить();
	Если МаксПопыток = 0 Тогда
		МаксПопыток = 5;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.AI_ОчередьЗапросов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УникальныйИдентификатор = Идентификатор;
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Ошибка = ТекстОшибки;
	МенеджерЗаписи.КоличествоОшибок = МенеджерЗаписи.КоличествоОшибок + 1;
	МенеджерЗаписи.ДатаНачалаОбработки = '00010101000000';

	Если МенеджерЗаписи.КоличествоОшибок >= МаксПопыток Тогда
		МенеджерЗаписи.Статус = Перечисления.AI_СтатусОчереди.Ошибка;
	Иначе
		МенеджерЗаписи.Статус = Перечисления.AI_СтатусОчереди.Новый;
	КонецЕсли;

	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Возвращает запись в очередь без инкремента счётчика ошибок.
// Используется при получении 429 (лимит запросов провайдера) —
// это временная перегрузка API, а не ошибка самого запроса.
Процедура ВернутьВОчередьБезОшибки(Идентификатор) Экспорт
	МенеджерЗаписи = РегистрыСведений.AI_ОчередьЗапросов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УникальныйИдентификатор = Идентификатор;
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Статус = Перечисления.AI_СтатусОчереди.Новый;
	МенеджерЗаписи.ДатаНачалаОбработки = '00010101000000';
	МенеджерЗаписи.Записать(Истина);
КонецПроцедуры

Процедура УдалитьЗапросИзОчереди(Идентификатор) Экспорт
	НаборЗаписей = РегистрыСведений.AI_ОчередьЗапросов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УникальныйИдентификатор.Установить(Идентификатор);
	НаборЗаписей.Записать(Истина);
КонецПроцедуры

Процедура ПоставитьЗапросВОчередь(Провайдер, ТипAPI, Модель, AI_Агент, Промт, ИмяВложения = "", Вложение = Неопределено) Экспорт

	МенеджерЗаписи = РегистрыСведений.AI_ОчередьЗапросов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УникальныйИдентификатор = Новый УникальныйИдентификатор;
	МенеджерЗаписи.Дата = ТекущаяДатаСеанса();
	МенеджерЗаписи.Провайдер = Провайдер;
	МенеджерЗаписи.ТипAPI = ТипAPI;
	МенеджерЗаписи.Модель = Модель;
	МенеджерЗаписи.AI_Агент = AI_Агент;
	МенеджерЗаписи.Промт = Промт;
	МенеджерЗаписи.ИмяВложения = ИмяВложения;
	МенеджерЗаписи.Статус = Перечисления.AI_СтатусОчереди.Новый;

	Если НЕ Вложение = Неопределено Тогда
		МенеджерЗаписи.Вложение = Новый ХранилищеЗначения(Вложение);
	КонецЕсли;

	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Атомарно переводит запись из "Новый" в "ВОбработке".
// Возвращает Истина — запись захвачена, Ложь — уже занята другим потоком или не существует.
Функция ЗафиксироватьНачалоОбработки(Идентификатор) Экспорт

	Результат = Ложь;

	НаборЗаписей = РегистрыСведений.AI_ОчередьЗапросов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УникальныйИдентификатор.Установить(Идентификатор);

	НачатьТранзакцию();
	Попытка
		НаборЗаписей.Заблокировать();
		НаборЗаписей.Прочитать();

		Если НаборЗаписей.Количество() > 0 Тогда
			Запись = НаборЗаписей[0];
			Если Запись.Статус = Перечисления.AI_СтатусОчереди.Новый Тогда
				Запись.Статус = Перечисления.AI_СтатусОчереди.ВОбработке;
				Запись.ДатаНачалаОбработки = ТекущаяДатаСеанса();
				НаборЗаписей.Записать(Истина);
				Результат = Истина;
			КонецЕсли;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			"AI_ОчередьЗапросов",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон("Ошибка захвата записи очереди [%1]: %2",
				Идентификатор, ОписаниеОшибки()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти
