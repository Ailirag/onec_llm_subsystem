//КонецФункции 

Функция ИнициализироватьМассивСообщенийResponses(Знач СистемныйПромт)
    
    Сообщения = Новый Массив;
    
    Если Не ЗначениеЗаполнено(_ПредыдущийIDОтвета) Тогда
        
        Если ЗначениеЗаполнено(СистемныйПромт) Тогда
            Сообщения.Добавить(OPI_OpenAI.ПолучитьСообщениеСистемы(СистемныйПромт));
        КонецЕсли;
        
        ОбогатитьСообщенияДополнительнымКонтекстом(Сообщения);
        
    Иначе
        
        // При previous_response_id базовая история уже на стороне Responses API,
        // но свежий RAG текущего вопроса нужно передать явно.
        Если ЗначениеЗаполнено(СистемныйПромт) Тогда
            Сообщения.Добавить(OPI_OpenAI.ПолучитьСтруктуруСообщения("user", СистемныйПромт));
        КонецЕсли;
        ОбогатитьСообщенияДополнительнымКонтекстом(Сообщения);
        
    КонецЕсли;
    
    Сообщения.Добавить(OPI_OpenAI.ПолучитьСообщениеПользователя(_ТекстовыйЗапрос));
    
    Возврат Сообщения;
    
КонецФункции

// ИзвлечьОтветResponses
// Responses API возвращает ответ в output[], а не в choices[].
// Структура: output[i].type == "message" => output[i].content[j].type == "output_text" => .text
// При наличии веб-поиска в output[] могут быть элементы с type="web_search_call" — их пропускаем.
Процедура ИзвлечьОтветResponses(ВСтруктуру = Ложь)
	
	ПреобразоватьОтветВСоответствие();
	
	МассивOutput = Ответ["output"];
	
	Если МассивOutput = Неопределено Или МассивOutput.Количество() = 0 Тогда
		ВызватьИсключение "Responses API: массив output пустой или отсутствует.";
	КонецЕсли;
	
	ТекстОтвета = "";
	
	Для Каждого ЭлементOutput Из МассивOutput Цикл
		
		ТипЭлемента = ЭлементOutput["type"];
		
		Если ТипЭлемента = "message" Тогда
			
			МассивContent = ЭлементOutput["content"];
			Если МассивContent = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого ЭлементContent Из МассивContent Цикл
				ТипContent = ЭлементContent["type"];
				Если ТипContent = "output_text" Или ТипContent = "text" Тогда
					ТекстОтвета = ТекстОтвета + ЭлементContent["text"];
				КонецЕсли;
			КонецЦикла;
			
		// web_search_call и другие служебные типы — пропускаем
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТекстОтвета) Тогда
		ВызватьИсключение "Responses API: не удалось извлечь текст из output.";
	КонецЕсли;
	
	Если Лев(ТекстОтвета, 3) = "```" Тогда
		ТекстОтвета = Сред(ТекстОтвета, 4, СтрДлина(ТекстОтвета) - 4 - 3);
	КонецЕсли;
	
	ИзвлеченныйОтвет = ТекстОтвета;
	
	Если ВСтруктуру Тогда
		ИзвлеченныйОтвет = OPI_Инструменты.JsonВСтруктуру(ИзвлеченныйОтвет, Ложь);
	КонецЕсли;
	
КонецПроцедуры

// СобратьСистемныйПромтСRAG
// Для Responses API RAG-контекст встраивается в системный промт,
// т.к. при наличии previous_response_id дополнительные сообщения не передаются.
Функция СобратьСистемныйПромтСRAG(МассивФрагментов)
	
	СистемнаяИнструкция = _СистемныйПромт;
	
	Если ЗначениеЗаполнено(СистемнаяИнструкция) И ЗначениеЗаполнено(_ПредыдущийIDОтвета) И ЗначениеЗаполнено(МассивФрагментов) Тогда
		СистемнаяИнструкция = "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(МассивФрагментов) Тогда
		Возврат СистемнаяИнструкция;
	КонецЕсли;
	
	ЧастиТекста = Новый Массив;
	ЧастиТекста.Добавить(СистемнаяИнструкция);
	ЧастиТекста.Добавить("");
	ЧастиТекста.Добавить("--RAG_CONTEXT--");
	
	Для Каждого Фрагмент Из МассивФрагментов Цикл
		Заголовок = Фрагмент["header"];
		Если ЗначениеЗаполнено(Фрагмент["subheader"]) Тогда
			Заголовок = Заголовок + " / " + Фрагмент["subheader"];
		КонецЕсли;
		ВсегоЧанков = Фрагмент["chunks_total"];
		Если ВсегоЧанков > 1 Тогда
			Заголовок = СтрШаблон("%1 (чанк %2/%3)", Заголовок, Фрагмент["chunk_num"], ВсегоЧанков);
		КонецЕсли;
		ЧастиТекста.Добавить("### " + Заголовок);
		ЧастиТекста.Добавить(Фрагмент["text"]);
		Если ЗначениеЗаполнено(Фрагмент["nav_ref"]) Тогда
			ЧастиТекста.Добавить("[источник: " + Фрагмент["nav_ref"] + "]");
		КонецЕсли;
		ЧастиТекста.Добавить("");
	КонецЦикла;
	
	ЧастиТекста.Добавить("--END_RAG_CONTEXT--");
	
	Возврат СтрСоединить(ЧастиТекста, Символы.ПС);
	
КонецФункции

// СортироватьФрагментыПоScore
// Сортировка массива фрагментов по полю score по убыванию.
// Используется вместо несуществующего AI_ВекторныйПоиск.СортироватьФрагментыПоРелевантности.
Функция СортироватьФрагментыПоScore(МассивФрагментов)
	
	Н = МассивФрагментов.Количество();
	Для Индекс = 0 По Н - 2 Цикл
		Для Й = 0 По Н - Индекс - 2 Цикл
			Если МассивФрагментов[Й]["score"] < МассивФрагментов[Й + 1]["score"] Тогда
				Врем = МассивФрагментов[Й];
				МассивФрагментов[Й] = МассивФрагментов[Й + 1];
				МассивФрагментов[Й + 1] = Врем;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивФрагментов;
	
КонецФункции

Процедура ПолучитьИдентификаторДиалогаChatCompletions()
	Если Не _РежимДиалога Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ИдентификаторДиалога = РегистрыСведений.AI_Диалоги.НачатьДиалог();
КонецПроцедуры

