// Получение параметров для метода ЗапуститьМенеджерФоновыхЗаданий()
Функция ПараметрыМенеджераЗаданий() Экспорт

	ПараметрыМенеджера	= Новый Структура;
	ПараметрыМенеджера.Вставить("ЗапускаемаяПроцедура"	, "");
	ПараметрыМенеджера.Вставить("НаименованиеЗадания"	, "");
	ПараметрыМенеджера.Вставить("ПорцииДанных"			, Новый Массив);
	ПараметрыМенеджера.Вставить("КоличествоПотоков"		, 1);
	ПараметрыМенеджера.Вставить("ИдентификаторФормы"	, Неопределено);

	Возврат ПараметрыМенеджера;

КонецФункции

// Возвращает суммарный расход токенов (входные + выходные + тул) за текущие сутки по провайдеру.
// Учитывает только записи в AI_ЖурналЗапросов, т.е. требует AI_ЛогироватьЗапросы = Истина.
Функция ПолучитьРасходТокеновЗаСегодня(Провайдер) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(AI_ЖурналЗапросов.ВходныеТокены)
		|		+ СУММА(AI_ЖурналЗапросов.ВыходныеТокены)
		|		+ СУММА(AI_ЖурналЗапросов.ТулТокены) КАК Всего
		|ИЗ
		|	РегистрСведений.AI_ЖурналЗапросов КАК AI_ЖурналЗапросов
		|ГДЕ
		|	AI_ЖурналЗапросов.Период >= &НачалоДня
		|	И AI_ЖурналЗапросов.Период < &НачалоСлДня
		|	И AI_ЖурналЗапросов.Провайдер = &Провайдер";

	НачалоТекущегоДня = НачалоДня(ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("НачалоДня",   НачалоТекущегоДня);
	Запрос.УстановитьПараметр("НачалоСлДня", НачалоТекущегоДня + 86400);
	Запрос.УстановитьПараметр("Провайдер",   Провайдер);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Всего <> Null Тогда
		Возврат Выборка.Всего;
	КонецЕсли;
	Возврат 0;

КонецФункции

// Функция управляет очередями обработки данных для фоновых заданий
// Механиз работы:
// Три ключевых параметра:
//		1. ЗапускаемаяПроцедура - процедура которая будет запущена в фоновом задании
//		2. ПорцииДанных - массив с параметрами (порциями данных) для каждого фонового задания
//		3. КоличествоПотоков - Максимальное количество одновременно работающих потоков для обработки
// Если количество порций данных больше чем параметр "КоличествоПотоков", метод ждет освобождения потока
// и запускает фоновое задание по еще не обработанной порции данных, и так, до обработки всех порций.
// Параметры:
// ПараметрыМенеджера	-	Структура	- полученная методом ПараметрыМенеджераЗаданий() и заполненных для обработки
// ДлительностьПаузы	-	Число		- Длительность паузы ожидания освобождения потока
Функция ОжидатьЗавершенияМенеджераФоновыхЗаданий(ПараметрыМенеджера, ДлительностьПаузы = 20, ПоследнийПакетЗапускатьОтдельно = Ложь) Экспорт

	ЗапускаемаяПроцедура		= ПараметрыМенеджера.ЗапускаемаяПроцедура;
	НаименованиеЗадания			= ПараметрыМенеджера.НаименованиеЗадания;
	ПорцииДанных				= ПараметрыМенеджера.ПорцииДанных;
	КоличествоПотоков			= ПараметрыМенеджера.КоличествоПотоков;

	Если ПараметрыМенеджера.Свойство("ИдентификаторФормы") Тогда
		ГлавныйИдентификаторЗаданий	= ПараметрыМенеджера.ИдентификаторФормы;
	Иначе
		ГлавныйИдентификаторЗаданий = Новый УникальныйИдентификатор;
	КонецЕсли;

	ЗапущенныеФоновыеЗадания	= Новый Массив;

	// Разворот массива. Необходим для правильного удаления значений из массива порций, с сохранением порядка переданного разработчиком
	ИтоговыеПорции = Новый Массив;

	Индекс = ПорцииДанных.ВГраница();
	Пока Индекс <> -1 Цикл
		ИтоговыеПорции.Добавить(ПорцииДанных[Индекс]);
		Индекс = Индекс - 1;
	КонецЦикла;

	ИндексПартии = ПорцииДанных.ВГраница();

	Пока ИтоговыеПорции.Количество() > 0 ИЛИ ЗапущенныеФоновыеЗадания.Количество() > 0 Цикл

		// Если все выделенные потоки на задание заняты или если не осталось необработанных порций данных
		Если ЗапущенныеФоновыеЗадания.Количество() = КоличествоПотоков Или ИтоговыеПорции.Количество() = 0
			//Проверка для последнего пакета, т.к. он должен запустить только когда закончились все предыдущие
			ИЛИ (ПоследнийПакетЗапускатьОтдельно И ИндексПартии = 0 И Не ЗапущенныеФоновыеЗадания.Количество() = 0)
			Тогда

			// Проверка заданий на выполненность
			Индекс = ЗапущенныеФоновыеЗадания.ВГраница();
			Пока Индекс >= 0 Цикл

				Попытка
					ЗаданиеВыполнено = ЗаданиеВыполнено(ЗапущенныеФоновыеЗадания[Индекс]);

				Исключение
					ТекстОшибки			= ОписаниеОшибки();
					ЗаданиеВыполнено	= Истина;

					ЗаписьЖурналаРегистрации(ЗапускаемаяПроцедура, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				КонецПопытки;

				Если ЗаданиеВыполнено Тогда
					ЗапущенныеФоновыеЗадания.Удалить(Индекс);
				КонецЕсли;

				Индекс = Индекс - 1;
			КонецЦикла;

			// Если ни одно задание еще не выполнилось или если все порции в обработке и просто ожидаем завершения всех заданий
			Если ЗапущенныеФоновыеЗадания.Количество() = КоличествоПотоков ИЛИ (ЗапущенныеФоновыеЗадания.Количество() > 0 И ИтоговыеПорции.Количество() = 0) Тогда
				Пауза(ДлительностьПаузы);
			КонецЕсли;

			ИндексПартии = ИтоговыеПорции.ВГраница();

		//Проверка что пакеты для запуска не закончились + условие для НЕзапуска последнего пакета
		ИначеЕсли (ИндексПартии <> -1 И Не (ПоследнийПакетЗапускатьОтдельно И ИндексПартии = 0))
			//Условие для запуска последнего пакета.
			ИЛИ (ПоследнийПакетЗапускатьОтдельно И ИндексПартии = 0 И ЗапущенныеФоновыеЗадания.Количество() = 0)
			Тогда

			Задание = ВыполнитьВФоне(ЗапускаемаяПроцедура, ИтоговыеПорции[ИндексПартии], НаименованиеЗадания);

			// Удаление уже обрабатывающейся порции данных
			УдалитьЗначениеИзМассива(ИтоговыеПорции, ИтоговыеПорции[ИндексПартии]);

			ЗапущенныеФоновыеЗадания.Добавить(Задание.УникальныйИдентификатор);

			ИндексПартии = ИндексПартии - 1;

		КонецЕсли;

	КонецЦикла;

КонецФункции

Процедура УдалитьЗначениеИзМассива(Массив, Значение) Экспорт

	Индекс = Массив.Найти(Значение);
	Если Индекс <> Неопределено Тогда
		Массив.Удалить(Индекс);
	КонецЕсли;

КонецПроцедуры

Процедура AI_RAG_ПередЗаписьюПриЗаписи(Источник, Отказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	РегистрыСведений.AI_ОчередьПодготовкиКВекторизации.ПоставитьСсылкуВОчередь(Источник.Ссылка);
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура Пауза(Секунд) Экспорт

    ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
    ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();

    Если ФоновоеЗадание = Неопределено Тогда
        Параметры = Новый Массив;
        Параметры.Добавить(Секунд);
        ФоновоеЗадание = ФоновыеЗадания.Выполнить("AI_ОбработкаСервер.Пауза", Параметры);
    КонецЕсли;

    Попытка
        ФоновоеЗадание.ОжидатьЗавершения(Секунд);
    Исключение
        Возврат;
    КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьПорциюЗапроса(ИдентификаторыСообщений) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	AI_ОчередьЗапросов.Дата КАК Дата,
		|	AI_ОчередьЗапросов.УникальныйИдентификатор КАК УникальныйИдентификатор,
		|	AI_ОчередьЗапросов.Провайдер КАК Провайдер,
		|	AI_ОчередьЗапросов.ТипAPI КАК ТипAPI,
		|	AI_ОчередьЗапросов.Модель КАК Модель,
		|	AI_ОчередьЗапросов.AI_Агент КАК AI_Агент,
		|	AI_ОчередьЗапросов.AI_Агент.ИдентификаторДляЛогики КАК ИдентификаторДляЛогики,
		|	AI_ОчередьЗапросов.Промт КАК Промт,
		|	AI_ОчередьЗапросов.ИмяВложения КАК ИмяВложения,
		|	AI_ОчередьЗапросов.Вложение КАК Вложение
		|ИЗ
		|	РегистрСведений.AI_ОчередьЗапросов КАК AI_ОчередьЗапросов
		|ГДЕ
		|	AI_ОчередьЗапросов.УникальныйИдентификатор В(&СписокИдентификаторов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";

	Запрос.УстановитьПараметр("СписокИдентификаторов", ИдентификаторыСообщений);

	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		РезультатОбработки = ВыполнитьОбращениеККлиентуИзОчереди(Результат);

		Если РезультатОбработки.Ошибка Тогда
			Если РезультатОбработки.ЭтоЛимитОбращений Тогда
				// 429: временная перегрузка провайдера — не тратим попытку
				РегистрыСведений.AI_ОчередьЗапросов.ВернутьВОчередьБезОшибки(
					Результат.УникальныйИдентификатор);
				ЗаписьЖурналаРегистрации("AI_ОчередьЗапросов",
					УровеньЖурналаРегистрации.Предупреждение, , ,
					СтрШаблон("Лимит запросов провайдера (429), запись [%1] возвращена в очередь: %2",
						Результат.УникальныйИдентификатор, РезультатОбработки.ОписаниеОшибки));
			Иначе
				РегистрыСведений.AI_ОчередьЗапросов.ЗафиксироватьОшибкуОбработки(
					Результат.УникальныйИдентификатор, РезультатОбработки.ОписаниеОшибки);
			КонецЕсли;
		Иначе
			AI_ДействияПослеОбработки.ВыполнитьДействияПослеПолученияОтвета(РезультатОбработки);
			РегистрыСведений.AI_ОчередьЗапросов.УдалитьЗапросИзОчереди(Результат.УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПараметрыРезультатаОбработки()

	Параметры = Новый Структура;
	Параметры.Вставить("Ошибка", Ложь);
	Параметры.Вставить("ЭтоЛимитОбращений", Ложь);
	Параметры.Вставить("ОписаниеОшибки", "");
	Параметры.Вставить("ОтветСтрокой", "");
	Параметры.Вставить("Ответ", Неопределено);
	Параметры.Вставить("ИдентификаторДляЛогики", "");

	Возврат Параметры;

КонецФункции

Функция ВыполнитьОбращениеККлиентуИзОчереди(ВыборкаОчереди)

	Результат = ПараметрыРезультатаОбработки();
	Результат.ИдентификаторДляЛогики = ВыборкаОчереди.ИдентификаторДляЛогики;

	Попытка
		Клиент = Обработки.AI_Клиент.Создать();
		Клиент.Инициализировать(ВыборкаОчереди.Провайдер, ВыборкаОчереди.Модель, ВыборкаОчереди.ТипAPI);
		Клиент.ИнициализироватьСистемныйПромт(ВыборкаОчереди.AI_Агент);
		Клиент.УстановитьИДЗапроса(ВыборкаОчереди.УникальныйИдентификатор);

		Промт = ВыборкаОчереди.Промт;

		Если ЗначениеЗаполнено(ВыборкаОчереди.ИмяВложения) Тогда
			// НЕ проверена работоспособность
			ДвоичныеДанные = ВыборкаОчереди.Вложение.Получить();
			Клиент.СпроситьСКартинкой(Промт, ВыборкаОчереди.ИмяВложения, ДвоичныеДанные);
		Иначе
			Клиент.Спросить(Промт);
		КонецЕсли;

		// Проверяем наличие ошибки в ответе провайдера (HTTP-ошибка без исключения, напр. 429)
		Если ЗначениеЗаполнено(Клиент.ОшибкаОбработки) Тогда
			ВызватьИсключение Клиент.ОшибкаОбработки;
		КонецЕсли;

		Клиент.ПреобразоватьОтветВСтроку();
		Клиент.ИзвлечьОтвет();

	Исключение
		Результат.Ошибка = Истина;
		Результат.ОписаниеОшибки = ОписаниеОшибки();
		Результат.ЭтоЛимитОбращений = ЭтоОшибкаЛимитаОбращений(Результат.ОписаниеОшибки);
		Возврат Результат;
	КонецПопытки;

	Результат.ОтветСтрокой = Клиент.ИзвлеченныйОтвет;

	Попытка
		Если Клиент.ИзвлекатьОтветВСтруктуру Тогда
			Клиент.ИзвлечьОтвет(Истина);
		КонецЕсли;
		Результат.Ответ = Клиент.ИзвлеченныйОтвет;
	Исключение
		Результат.Ошибка = Истина;
		Результат.ОписаниеОшибки = СтрШаблон("При преобразовании ответа [%1] в структуру произошла ошибка: %2%3",
												Результат.ОтветСтрокой,
												Символы.ПС,
												ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ЗаданиеВыполнено(ИдентификаторЗадания)

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		ВызватьИсключение "Задания по идентификатору не найдено.";
	КонецЕсли;

	ЗаданиеЗавершено = НЕ Задание.Состояние = СостояниеФоновогоЗадания.Активно;

	Возврат ЗаданиеЗавершено;

КонецФункции

Функция ВыполнитьВФоне(ЗапускаемаяПроцедура, Порция, ИмяЗадания)
	Возврат ФоновыеЗадания.Выполнить(ЗапускаемаяПроцедура, Порция, Новый УникальныйИдентификатор, ИмяЗадания);
КонецФункции

Процедура ВернутьЗависшиеЗаписи()

	ТаймаутМинут = 60;
	ГраницаВремени = ТекущаяДатаСеанса() - ТаймаутМинут * 60;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	AI_ОчередьЗапросов.УникальныйИдентификатор КАК УникальныйИдентификатор
		|ИЗ
		|	РегистрСведений.AI_ОчередьЗапросов КАК AI_ОчередьЗапросов
		|ГДЕ
		|	AI_ОчередьЗапросов.Статус = &СтатусВОбработке
		|	И AI_ОчередьЗапросов.ДатаНачалаОбработки <= &ГраницаВремени";

	Запрос.УстановитьПараметр("СтатусВОбработке", Перечисления.AI_СтатусОчереди.ВОбработке);
	Запрос.УстановитьПараметр("ГраницаВремени", ГраницаВремени);

	КоличествоСброшенных = 0;
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.AI_ОчередьЗапросов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.УникальныйИдентификатор = Результат.УникальныйИдентификатор;
		МенеджерЗаписи.Прочитать();
		// Повторная проверка статуса — защита от гонки при одновременном вызове
		Если МенеджерЗаписи.Статус = Перечисления.AI_СтатусОчереди.ВОбработке Тогда
			МенеджерЗаписи.Статус = Перечисления.AI_СтатусОчереди.Новый;
			МенеджерЗаписи.ДатаНачалаОбработки = '00010101000000';
			МенеджерЗаписи.Записать(Истина);
			КоличествоСброшенных = КоличествоСброшенных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоСброшенных > 0 Тогда
		ЗаписьЖурналаРегистрации(
			"AI_ОчередьЗапросов",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			СтрШаблон("Возвращено в очередь зависших записей: %1 (таймаут %2 мин.)",
				КоличествоСброшенных, ТаймаутМинут));
	КонецЕсли;

КонецПроцедуры

// Определяет, является ли ошибка ограничением частоты запросов провайдера (HTTP 429).
// Проверяет текст ошибки на признаки rate-limit от OpenAI, Yandex, Ollama и совместимых API.
Функция ЭтоОшибкаЛимитаОбращений(ТекстОшибки)
	НижнийРегистр = НРег(ТекстОшибки);
	Возврат СтрНайти(НижнийРегистр, "429") > 0
		ИЛИ СтрНайти(НижнийРегистр, "rate_limit") > 0
		ИЛИ СтрНайти(НижнийРегистр, "too many requests") > 0
		ИЛИ СтрНайти(НижнийРегистр, "requests_per_minute") > 0
		ИЛИ СтрНайти(НижнийРегистр, "resource_exhausted") > 0;
КонецФункции

Процедура AI_КонтрольУникальностиИдентификатораЛогикиПередЗаписью(Источник, Отказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.Наименование КАК Наименование
		|ИЗ
		|	Справочник.AI_Модели КАК Таблица
		|ГДЕ
		|	НЕ Таблица.Ссылка = &Ссылка
		|	И Таблица.ИдентификаторДляЛогики = &ИдентификаторДляЛогики";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "AI_Модели", Метаданные.НайтиПоТипу(ТипЗнч(Источник.Ссылка)).Имя);

	Запрос.УстановитьПараметр("ИдентификаторДляЛогики", Источник.ИдентификаторДляЛогики);
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);

	Результат = Запрос.Выполнить().Выбрать();

	Если Результат.Следующий() Тогда
		Сообщить(СтрШаблон("Данный идентификатор используется в элементе [%1]. Продолжение не возможно.", Источник.Ссылка));
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
