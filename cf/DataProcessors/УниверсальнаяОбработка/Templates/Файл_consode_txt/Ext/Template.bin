МассивУдаляемых.Добавить(""19,15"");
МассивУдаляемых.Добавить(""77,05"");
МассивУдаляемых.Добавить(""Н08,20"");
МассивУдаляемых.Добавить(""Н08"");

Для Каждого Удаляемый Из МассивУдаляемых Цикл
	Найденый = ПланыСчетов.Бухгалтерский.НайтиПоКоду(Удаляемый);
	Если ЗначениеЗаполнено(Найденый) Тогда
		ОбъектНайденного = Найденый.ПолучитьОбъект();
		ОбъектНайденного.ИмяПредопределенныхДанных = """";
		ОбъектНайденного.Записать();
		ОбъектНайденного.Удалить();
	КонецЕсли;
КонецЦикла;

МассивСоздаваемых = Новый Массив;

Активный = ВидСчета.Активный;
Пассивный = ВидСчета.Пассивный;
АктивноПассивный = ВидСчета.АктивноПассивный;

Счет_01 =	ПланыСчетов.Бухгалтерский.ОсновныеСредства;
Счет_02 =	ПланыСчетов.Бухгалтерский.АмортизацияОсновныхСредств;
Счет_08 =	ПланыСчетов.Бухгалтерский.ВложенияВоВнеоборотныеАктивы;
Счет_19 =	ПланыСчетов.Бухгалтерский.НДС;
Счет_76 =	ПланыСчетов.Бухгалтерский.РасчетыСДебиторамиИКредиторами;
Счет_77 =	ПланыСчетов.Бухгалтерский.ОтложенныеНО;
Счет_Н01 =	ПланыСчетов.Бухгалтерский.АмортизируемоеИмущество_НалоговыйУчет;
Счет_Н02 =	ПланыСчетов.Бухгалтерский.Износ_НалоговыйУчет;


ВидСубконто_Подразделения = ПланыВидовХарактеристик.ВидыСубконтоБухгалтерские.ПодразделенияОрганизаций;
ВидСубконто_ОС = ПланыВидовХарактеристик.ВидыСубконтоБухгалтерские.ОсновныеСредства;
ВидСубконто_МоделиТМЦ = ПланыВидовХарактеристик.ВидыСубконтоБухгалтерские.Модель;
ВидСубконто_ДП = ПланыВидовХарактеристик.ВидыСубконтоБухгалтерские.ДокументыПолученные;
ВидСубконто_Контрагенты = ПланыВидовХарактеристик.ВидыСубконтоБухгалтерские.Контрагенты;
ВидСубконто_СтавкиНДС = ПланыВидовХарактеристик.ВидыСубконтоБухгалтерские.НДС;
ВидСубконто_Подразделения = ПланыВидовХарактеристик.ВидыСубконтоБухгалтерские.ПодразделенияОрганизаций;

НаборСубконто_1 = Новый Массив;
НаборСубконто_1.Добавить(ВидСубконто_Подразделения);
НаборСубконто_1.Добавить(ВидСубконто_ОС);

НаборСубконто_2 = Новый Массив;
НаборСубконто_2.Добавить(ВидСубконто_Подразделения);
НаборСубконто_2.Добавить(ВидСубконто_ОС);
НаборСубконто_2.Добавить(ВидСубконто_МоделиТМЦ);
НаборСубконто_2.Добавить(ВидСубконто_ДП);

НаборСубконто_3 = Новый Массив;
НаборСубконто_3.Добавить(ВидСубконто_Подразделения);
НаборСубконто_3.Добавить(ВидСубконто_Контрагенты);
НаборСубконто_3.Добавить(ВидСубконто_ОС);

НаборСубконто_4 = Новый Массив;
НаборСубконто_4.Добавить(ВидСубконто_Подразделения);
НаборСубконто_4.Добавить(ВидСубконто_Контрагенты);
НаборСубконто_4.Добавить(ВидСубконто_ДП);
НаборСубконто_4.Добавить(ВидСубконто_СтавкиНДС);

НаборСубконто_5 = Новый Массив;
НаборСубконто_5.Добавить(ВидСубконто_ОС);
//											//    Код		Наименование счета								ИмяПредопределенное									Родитель    А/П					Кол   Вал	Заб.  Набор субконто
СтрокаСтруктуры = ""Код, Наименование, ИмяПредопределенныхДанных, Родитель, Вид, Количественный, Валютный, Забалансовый, ВидыСубконто, ДопФлаг"";

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""01,05"",	""Арендованное имущество"",						""АрендованноеИмущество"",							Счет_01,	Активный,			Ложь, Ложь, Ложь, НаборСубконто_1, """");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""01,15"",	""Выбытие арендованного имущества"",				""ВыбытиеАрендованногоИмущества"",					Счет_01,	Активный,			Ложь, Ложь, Ложь, НаборСубконто_1, """");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""02,05"",	""Амортизация арендованного имущества"",			""АмортизацияАрендованногоИмущества"",				Счет_02,	Пассивный,			Ложь, Ложь, Ложь, НаборСубконто_1, """");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""08,20"",	""Приобретение права аренды"",					""ПриобретениеПраваАренды"",							Счет_08,	Активный,			Истина, Ложь, Ложь, НаборСубконто_2, ""ИспользоватьВСФ"");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""76,20"",	""Арендные обязательства"",						""АрендныеОбязательства"",							Счет_76,	АктивноПассивный,	Ложь, Ложь, Ложь, НаборСубконто_3, ""ВариантУчетаВзаиморасчетов:Прочие,ИспользоватьВСФ"");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""19,15"",	""НДС по аренде"",								""НДСПоАренде"",										Счет_19,	АктивноПассивный,	Ложь, Ложь, Ложь, НаборСубконто_4, """");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""77,05"",	""Отложенное налоговое обязательство по аренде"",	""ОтложенноеНОПоАренде"",								Счет_77,	АктивноПассивный,	Ложь, Ложь, Ложь, НаборСубконто_5, """");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""Н01,05"", ""Арендованное имущество"",						""АрендованноеИмущество_НалоговыйУчет"",				Счет_Н01,	Активный,			Ложь, Ложь, Истина, НаборСубконто_1, """");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""Н02,05"", ""Амортизация арендованного имущества"",			""АмортизацияАрендованногоИмущества_НалоговыйУчет"",	Счет_Н02,	Пассивный,		Ложь, Ложь, Истина, НаборСубконто_1, """");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""Н01,15"", ""Выбытие арендованного имущества"",				""ВыбытиеАрендованногоИмущества_НалоговыйУчет"",		Счет_Н01,	Активный,			Ложь, Ложь, Истина, НаборСубконто_1, """");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""Н08"",	""Приобретение права аренды"",					""ВложенияВоВнеоборотныеАктивы_НалоговыйУчет"", 				,	Активный,			Истина, Ложь, Истина, НаборСубконто_2, ""ЗапретитьИспользоватьВПроводках"");
МассивСоздаваемых.Добавить(СтруктураСчета);

СтруктураСчета = Новый Структура(СтрокаСтруктуры, ""Н08,20"", ""Приобретение права аренды"",					""ПриобретениеПраваАренды_НалоговыйУчет"",					,	Активный,			Истина, Ложь, Истина, НаборСубконто_2, """");
МассивСоздаваемых.Добавить(СтруктураСчета);

Для Каждого СоздаваемыйСчет Из МассивСоздаваемых Цикл

	НовыйСчет = ПланыСчетов.Бухгалтерский.СоздатьСчет();
	ЗаполнитьЗначенияСвойств(НовыйСчет, СоздаваемыйСчет);
	
	Если СоздаваемыйСчет.Код = ""Н08,20"" Тогда
		НовыйСчет.Родитель = Планысчетов.Бухгалтерский.ВложенияВоВнеоборотныеАктивы_НалоговыйУчет;
	КонецЕсли;

	Для Каждого ВидСубконтоТЧ Из СоздаваемыйСчет.ВидыСубконто Цикл
		ВидСубконто = НовыйСчет.ВидыСубконто.Добавить();
		ВидСубконто.ВидСубконто = ВидСубконтоТЧ;
		ВидСубконто.Суммовой = Истина;
		ВидСубконто.Количественный = СоздаваемыйСчет.Количественный;
	КонецЦикла;
	
	Флаг = СоздаваемыйСчет.ДопФлаг;
	
	Если ЗначениеЗаполнено(Флаг) Тогда
	
		МассивНастроек = СтрРазделить(Флаг, "","", Ложь); // из за 76.20
		
		Для Каждого ЗначениеНастройки Из МассивНастроек Цикл
		
			Если СтрНайти(ЗначениеНастройки, "":"") Тогда
				ДанныеЗаполненияРеквизита	= СтрРазделить(ЗначениеНастройки, "":"", Ложь);
				ИмяРеквизита			= ДанныеЗаполненияРеквизита[0];
				ЗначениеРеквизита		= ДанныеЗаполненияРеквизита[1];
				ИмяМетаданныхЗначения	= Метаданные.НайтиПоТипу(ТипЗнч(НовыйСчет[ИмяРеквизита])).ПолноеИмя();
				ЗначениеПодстановки		= ПредопределенноеЗначение(ИмяМетаданныхЗначения + ""."" + ЗначениеРеквизита);
				НовыйСчет[ИмяРеквизита]	= ЗначениеПодстановки;
			ИначеЕсли ТипЗнч(НовыйСчет[ЗначениеНастройки]) = Тип(""Булево"") Тогда
				НовыйСчет[ЗначениеНастройки] = Истина;
			КонецЕсли;
			
		КонецЦикла;
			
	КонецЕсли;
	
	Попытка
		НовыйСчет.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(""Создание элемента плана счетов"", УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(""Счет """"%1"""". %2"", НовыйСчет.Код, ОписаниеОшибки()));
	КонецПопытки;	
	
КонецЦикла;

// Настройка налогового счета 44.01.01
Счет_Н440101 = ПланыСчетов.Бухгалтерский.АмортизацияОсновныхСредствДляЦелейНалогообложения_.ПолучитьОбъект();
Счет_Н440101.ИспользоватьВСФ = Истина;
Попытка
	Счет_Н440101.Записать();
Исключение
	ЗаписьЖурналаРегистрации(""Изменение элемента плана счетов"", УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(""Счет """"%1"""". %2"", Счет_Н440101.Код, ОписаниеОшибки()));
КонецПопытки;

// Справочник ТМЦ
НоваяГруппаТМЦ = Справочники.ТМЦ.СоздатьГруппу();
НоваяГруппаТМЦ.Наименование = ""Права пользования активами"";
НоваяГруппаТМЦ.ИмяПредопределенныхДанных = ""ПраваПользованияАктивами"";
Попытка
	НоваяГруппаТМЦ.Записать();
Исключение
	ЗаписьЖурналаРегистрации(""Создание группы ТМЦ"", УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(""Группа """"%1"""". %2"", НоваяГруппаТМЦ.Наименование, ОписаниеОшибки()));
КонецПопытки;

// Справочник Виды расчета
РодительВидовРасчетов = Неопределено;

МассивВидовРасчета = СтрРазделить(""АрендаИмущества:Аренда имущества,ПоступлениеПредметаАренды:Поступление предмета аренды,РиэлторскиеУслуги:Риэлторские услуги,РемонтАрендованногоИмущества:Ремонт арендованного имущества,ВыкупПраваАренды:Выкуп права аренды, ПоступлениеУслугАренды:Поступление услуг аренды"", "","", Ложь);

Для Каждого ВидРасчета Из МассивВидовРасчета Цикл
	
	ДанныеСоздания = СтрРазделить(ВидРасчета, "":"", Ложь);
	ИмяПредопределенное = СокрЛП(ДанныеСоздания[0]);
	ИмяЭлемента = СокрЛП(ДанныеСоздания[1]);
	
	Если ИмяПредопределенное = ""АрендаИмущества"" Тогда
		ЭлементСправочника = Справочники.ВидыРасчетов.СоздатьГруппу();
		ЭтоРодитель = Истина;
	Иначе
		ЭлементСправочника = Справочники.ВидыРасчетов.СоздатьЭлемент();
		ЭтоРодитель = Ложь;
	КонецЕсли;
		
	ЭлементСправочника.Наименование = ИмяЭлемента;
	ЭлементСправочника.ИмяПредопределенныхДанных = ИмяПредопределенное;
	
	Если ЗначениеЗаполнено(РодительВидовРасчетов) Тогда
		ЭлементСправочника.Родитель = РодительВидовРасчетов;
	КонецЕсли;

	Попытка
		ЭлементСправочника.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(""Создание видов расчетов"", УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(""Вид расчета """"%1"""". %2"", ЭлементСправочника.Наименование, ОписаниеОшибки()));
	КонецПопытки;
	
	Если ЭтоРодитель Тогда
		РодительВидовРасчетов = ЭлементСправочника.Ссылка;
	КонецЕсли;
	
КонецЦикла;

// Справочник Типовые операции
НоваяТО = Справочники.ТиповыеОперации.СоздатьЭлемент();
НоваяТО.Наименование = ""Комплектация ППА"";
НоваяТО.Родитель = Справочники.ТиповыеОперации.ТМЦКомплектация;
НоваяТО.ИмяПредопределенныхДанных = ""ТМЦКомплектация_КомплектацияППА"";
НоваяТО.ДокументМетаданные = Метаданные.Документы.ТМЦКомплектация.Имя;
Попытка
	НоваяТО.Записать();
Исключение
	ЗаписьЖурналаРегистрации(""Создание типовых операций"", УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(""Типовая операция: """"%1"""". %2"", НоваяТО.Наименование, ОписаниеОшибки()));
КонецПопытки;

"},0},
{2,8,4,
{"S","Запись документа без запрета редактирования"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,8a5ed60e-6420-4471-a3cb-49e0a5be0932},
{"B",0},
{"S","ДП = СН(""e1cib/data/Документ.СФПолученная?ref=bb8fbc97e151385b11eb1ce46b80b25a"");

ЗаписываемыйОбъект = ДП.ПолучитьОбъект();
ДатаЗапретаНовая = ДАТА(2020,09,01);

// Изменение объекта
ЗаписываемыйОбъект.Счет = ПланыСчетов.Бухгалтерский.АрендныеОбязательства;


// Служебная часть
НаборЗаписей = РегистрыСведений.ЗапретыРедактирования.СоздатьНаборЗаписей();
НаборЗаписей.Отбор.Объект.Установить(Справочники.Организации.Тандер);
НаборЗаписей.Прочитать();

ДатаЗапретаИсходная = НаборЗаписей[0].ДатаЗапрета;

НаборЗаписей[0].ДатаЗапрета = ДатаЗапретаНовая;

НаборЗаписей.Записать(Истина);

ЗаписываемыйОбъект.Записать(РежимЗаписиДокумента.Проведение);

НаборЗаписей[0].ДатаЗапрета = ДатаЗапретаИсходная;

НаборЗаписей.Записать(Истина);

Сообщить(НаборЗаписей[0].ДатаЗапрета);"},0},
{2,9,4,
{"S","Исправление ЗНР"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,328e04a6-f561-4aa4-8113-ee466344c88b},
{"B",0},
{"S","Запрос = Новый Запрос;
	Запрос.Текст =
	""ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявкаНаРасходДвиженияОперации.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаРасход.ДвиженияОперации КАК ЗаявкаНаРасходДвиженияОперации
	|ГДЕ
	|	ЗаявкаНаРасходДвиженияОперации.Ссылка.Дата > ДАТАВРЕМЯ(2020, 9, 1)
	|	И ЗаявкаНаРасходДвиженияОперации.СуммаНДС < 0
	|	И ЗаявкаНаРасходДвиженияОперации.СуммаБезНДС - ЗаявкаНаРасходДвиженияОперации.Сумма = ЗаявкаНаРасходДвиженияОперации.СуммаНДС * -1"";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	ВсегоДокументов		= Результат.Количество();
	КоличествоУспешных	= 0;
	МассивОшибок		= Новый Массив;
	
	СоответствиеСтавок = Новый Соответствие;
	СоответствиеСтавок.Вставить(Перечисления.СтавкиНДС.НДС10, 10);
	СоответствиеСтавок.Вставить(Перечисления.СтавкиНДС.НДС18, 18);
	СоответствиеСтавок.Вставить(Перечисления.СтавкиНДС.НДС20, 20);
	СоответствиеСтавок.Вставить(Перечисления.СтавкиНДС.БезНДС, 0);
	
	Пока Результат.Следующий() Цикл
		
		ДокументОбъект = Результат.Ссылка.ПолучитьОбъект();
		
		Для Каждого СтрокаТЧ Из ДокументОбъект.ДвиженияОперации Цикл
			Если СтрокаТЧ.СуммаНДС < 0 Тогда
				СтрокаТЧ.СуммаБезНДС = СтрокаТЧ.Сумма / (100 + СоответствиеСтавок[СтрокаТЧ.СтавкаНДС]) * 100;
				СтрокаТЧ.СуммаНДС = СтрокаТЧ.Сумма - СтрокаТЧ.СуммаБезНДС;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			ДокументОбъект.ДополнительныеСвойства.Вставить(""НеКонтролироватьСтатус"", Истина);
			ДокументОбъект.ДополнительныеСвойства.Вставить(""БезКонтроляЗакрытогоПериода"", Истина);
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КоличествоУспешных = КоличествоУспешных + 1;
		Исключение
			МассивОшибок.Добавить(СтрШаблон(""Документ """"%1"""". Ошибка: %2"", Результат.Ссылка, ОписаниеОшибки()));
		КонецПопытки;
		
	КонецЦикла;
	
	Сообщить(""Количество успешно обработанных: "" + КоличествоУспешных);
	
	Если МассивОшибок.Количество() Тогда
		
		Сообщить(""Количество ошибок: "" + МассивОшибок.Количество());
		
		Для Каждого Ошибка Из МассивОшибок Цикл
			
			Сообщить(Ошибка);
			
		КонецЦикла;
		
	КонецЕсли;"},0}
}
},
