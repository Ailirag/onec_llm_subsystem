Функция ПолучитьФикстуры()

	Провайдер = Справочники.AI_Провайдеры.НайтиПоКоду("ATPROV001", Истина);
	Профиль = Справочники.AI_ПрофилиДоступаКДанным.НайтиПоКоду("ATPROF001", Истина);
	Агент = Справочники.AI_Агенты.НайтиПоКоду("ATAGENT01", Истина);
	Возврат Новый Структура("Провайдер,Профиль,Агент", Провайдер, Профиль, Агент);

КонецФункции

// На чистой базе модели заводит тест загрузки моделей, а он идет позже.
// Тесты, которым модель нужна раньше, не должны зависеть от порядка запуска.
Функция ОбеспечитьМодельАгента(Провайдер)

	Модель = НайтиМодель(Провайдер, "mock-agent");
	Если ЗначениеЗаполнено(Модель) Тогда
		Возврат Модель;
	КонецЕсли;
	Коды = Новый Массив;
	Коды.Добавить("mock-agent");
	Справочники.AI_Провайдеры.ЗагрузитьВыбранныеМодели(Провайдер, Коды);
	Возврат НайтиМодель(Провайдер, "mock-agent");

КонецФункции

Функция НайтиМодель(Провайдер, Наименование)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Модели.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.AI_Модели КАК Модели
		|ГДЕ
		|	Модели.Владелец = &Провайдер
		|	И Модели.Наименование = &Наименование
		|	И НЕ Модели.ПометкаУдаления");
	Запрос.УстановитьПараметр("Провайдер", Провайдер);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.AI_Модели.ПустаяСсылка();

КонецФункции

Процедура ОбеспечитьВозможностиМодели(Провайдер, Модель)

	Запись = РегистрыСведений.AI_ВозможностиМоделей.СоздатьМенеджерЗаписи();
	Запись.Модель = Модель;
	Запись.Возможность = Перечисления.AI_ВозможностьМодели.ВводИзображений;
	Запись.ТипAPI = Перечисления.AI_ТипAPI.Responses;
	Запись.СпособПередачи = Перечисления.AI_СпособПередачиВложения.InlineBase64;
	Запись.MIMEТипы = "image/png,image/jpeg,image/webp";
	Запись.МаксимальныйРазмерБайт = 5242880;
	Запись.МаксимальноеКоличество = 5;
	Запись.Записать();

	Запись = РегистрыСведений.AI_ВозможностиМоделей.СоздатьМенеджерЗаписи();
	Запись.Модель = Модель;
	Запись.Возможность = Перечисления.AI_ВозможностьМодели.ВводФайлов;
	Запись.ТипAPI = Перечисления.AI_ТипAPI.Responses;
	Запись.СпособПередачи = Перечисления.AI_СпособПередачиВложения.FilesAPI;
	Запись.MIMEТипы = "text/plain,application/pdf";
	Запись.МаксимальныйРазмерБайт = 20971520;
	Запись.МаксимальноеКоличество = 5;
	Запись.Записать();

	ОбъектПровайдера = Провайдер.ПолучитьОбъект();
	ОбъектПровайдера.МодельАнализаВложений = Модель;
	ОбъектПровайдера.Записать();

КонецПроцедуры

Процедура Проверить(Условие, ТекстОшибки)

	Если Не Условие Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОшибкуТеста(Результаты, ИмяТеста)

	ДобавитьРезультат(
		Результаты,
		ИмяТеста,
		Ложь,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

КонецПроцедуры

Процедура ДобавитьРезультат(Результаты, ИмяТеста, Успешно, Детали)

	Результаты.Добавить(Новый Структура(
		"Имя,Успешно,Детали",
		ИмяТеста,
		Успешно,
		Строка(Детали)));

КонецПроцедуры

Функция СформироватьТекстРезультатов(Результаты)

	ВсеУспешно = Истина;
	Для Каждого Результат Из Результаты Цикл
		Если Не Результат.Успешно Тогда
			ВсеУспешно = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(?(ВсеУспешно, "OK", "ERROR"));
	Для Каждого Результат Из Результаты Цикл
		Детали = СтрЗаменить(Результат.Детали, Символы.ВК, " ");
		Детали = СтрЗаменить(Детали, Символы.ПС, " ");
		Детали = СтрЗаменить(Детали, "|", "/");
		Строки.Добавить(
			?(Результат.Успешно, "PASS", "FAIL")
				+ "|" + Результат.Имя
				+ "|" + Детали);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти
