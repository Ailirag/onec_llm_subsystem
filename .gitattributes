# Правила нормализации и хранения файлов репозитория 1С.
#
# ВАЖНО: для каждого атрибута выигрывает ПОСЛЕДНЕЕ совпавшее правило. Поэтому
# общий catch-all идёт первым, а бинарные типы и LFS — после него.

# ── Общая нормализация переводов строк ────────────────────────────────────────
# Выгрузка конфигурации 1С — UTF-8 с BOM и CRLF. Фиксируем LF в индексе и CRLF в
# рабочем каталоге явно, чтобы результат не зависел от локального core.autocrlf
# каждого разработчика. Без этого один и тот же файл у разных участников даёт
# полнофайловый diff и ложные конфликты при параллельной работе.
#
# На момент введения правил весь индекс уже был в LF, поэтому ренормализация не
# требуется. Если git ls-files --eol покажет i/crlf, выполнить один раз:
#   git add --renormalize .
* text=auto eol=crlf

# ── Явные текстовые типы конфигурации и инструментария ────────────────────────
*.bsl   text eol=crlf
*.os    text eol=crlf
*.xml   text eol=crlf
*.html  text eol=crlf
*.txt   text eol=crlf
*.svg   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.md    text eol=crlf
*.json  text eol=crlf
*.mjs   text eol=crlf
*.js    text eol=crlf
*.yaml  text eol=crlf
*.yml   text eol=crlf
*.toml  text eol=crlf

# ── Бинарные типы выгрузки 1С без нормализации ────────────────────────────────
# Табличные документы, графические схемы и геометрия хранятся как есть: любая
# нормализация переводов строк повреждает содержимое.
*.mxl   -text
*.grs   -text
*.geom  -text
*.ico   -text

# ── Git LFS: бинарные артефакты и ресурсы ─────────────────────────────────────
*.cf   filter=lfs diff=lfs merge=lfs -text
*.cfe  filter=lfs diff=lfs merge=lfs -text
*.bin  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.bmp  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text
*.emf  filter=lfs diff=lfs merge=lfs -text
*.wmf  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text

# ── Подсказки для diff ────────────────────────────────────────────────────────
# Модули 1С — обычный текст; включаем распознавание функций для читаемых
# заголовков ханков в diff.
*.bsl   diff

