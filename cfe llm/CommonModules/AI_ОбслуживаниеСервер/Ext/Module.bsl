				ТранзакцияОткрыта = Ложь;
			КонецЕсли;

		КонецЦикла;

		Если ТранзакцияОткрыта Тогда
			ЗафиксироватьТранзакцию();
			ТранзакцияОткрыта = Ложь;
		КонецЕсли;

	Исключение
		Если ТранзакцияОткрыта Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Возврат Удалено;

КонецФункции
