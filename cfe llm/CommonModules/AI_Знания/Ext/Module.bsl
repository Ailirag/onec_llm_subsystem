#Область ПрограммныйИнтерфейс

// Возвращает активные карточки контекста из наборов знаний агента.
//
// Параметры:
//  Агент - СправочникСсылка.AI_Агенты - агент, для которого назначены наборы.
//
// Возвращаемое значение:
//  Массив из Структура - карточки контекста с источником и версией набора.
//
Функция КонтекстыНаборовАгента(Агент) Экспорт

	Если Не ЗначениеЗаполнено(Агент) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| 	Состав.Контекст.ДанныеКонтекста КАК ДанныеКонтекста,
		| 	Состав.Контекст.Наименование КАК Наименование,
		| 	Состав.Контекст.ИдентификаторДляЛогики КАК ИдентификаторДляЛогики,
		| 	Назначения.НаборЗнаний.Наименование КАК НаборЗнаний,
		| 	Назначения.НаборЗнаний.Версия КАК ВерсияНабора
		|ИЗ
		| 	Справочник.AI_Агенты.НаборыЗнаний КАК Назначения
		| 		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.AI_НаборыЗнаний.Состав КАК Состав
		| 		ПО Назначения.НаборЗнаний = Состав.Ссылка
		|ГДЕ
		| 	Назначения.Ссылка = &Агент
		| 	И Назначения.НаборЗнаний.Активен
		| 	И НЕ Назначения.НаборЗнаний.ПометкаУдаления
		| 	И НЕ Состав.Контекст.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		| 	Назначения.НомерСтроки,
		| 	Состав.НомерСтроки";
	Запрос.УстановитьПараметр("Агент", Агент);

	Возврат КонтекстыИзРезультатаЗапроса(Запрос.Выполнить());

КонецФункции

// Возвращает активные карточки контекста из наборов знаний сценария.
//
// Параметры:
//  Сценарий - СправочникСсылка.AI_Сценарии - сценарий, для которого назначены наборы.
//
// Возвращаемое значение:
//  Массив из Структура - карточки контекста с источником и версией набора.
//
Функция КонтекстыНаборовСценария(Сценарий) Экспорт

	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| 	Состав.Контекст.ДанныеКонтекста КАК ДанныеКонтекста,
		| 	Состав.Контекст.Наименование КАК Наименование,
		| 	Состав.Контекст.ИдентификаторДляЛогики КАК ИдентификаторДляЛогики,
		| 	Назначения.НаборЗнаний.Наименование КАК НаборЗнаний,
		| 	Назначения.НаборЗнаний.Версия КАК ВерсияНабора
		|ИЗ
		| 	Справочник.AI_Сценарии.НаборыЗнаний КАК Назначения
		| 		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.AI_НаборыЗнаний.Состав КАК Состав
		| 		ПО Назначения.НаборЗнаний = Состав.Ссылка
		|ГДЕ
		| 	Назначения.Ссылка = &Сценарий
		| 	И Назначения.НаборЗнаний.Активен
		| 	И НЕ Назначения.НаборЗнаний.ПометкаУдаления
		| 	И НЕ Состав.Контекст.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		| 	Назначения.НомерСтроки,
		| 	Состав.НомерСтроки";
	Запрос.УстановитьПараметр("Сценарий", Сценарий);

	Возврат КонтекстыИзРезультатаЗапроса(Запрос.Выполнить());

КонецФункции

// Добавляет контексты с устранением дублей по логическому идентификатору.
//
// Параметры:
//  Приемник - Массив из Структура - изменяемая коллекция итоговых контекстов.
//  Источник - Массив из Структура - добавляемые контексты.
//  ЗамещатьСуществующие - Булево - более конкретный источник заменяет общий.
//
Процедура ДобавитьБезДубликатов(Приемник, Источник, ЗамещатьСуществующие = Ложь) Экспорт

	Для Каждого Контекст Из Источник Цикл
		Индекс = ИндексКонтекста(Приемник, Контекст.ИдентификаторДляЛогики);
		Если Индекс >= 0 Тогда
			Если Не ЗамещатьСуществующие Тогда
				Продолжить;
			КонецЕсли;
			Приемник.Удалить(Индекс);
		КонецЕсли;
		Приемник.Добавить(Контекст);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонтекстыИзРезультатаЗапроса(РезультатЗапроса)

	Результат = Новый Массив;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Контекст = Новый Структура;
		Контекст.Вставить("ДанныеКонтекста", Выборка.ДанныеКонтекста);
		Контекст.Вставить("Наименование", Выборка.Наименование);
		Контекст.Вставить("ИдентификаторДляЛогики", Выборка.ИдентификаторДляЛогики);
		Контекст.Вставить("НаборЗнаний", Выборка.НаборЗнаний);
		Контекст.Вставить("ВерсияНабора", Выборка.ВерсияНабора);
		Результат.Добавить(Контекст);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИндексКонтекста(Контексты, Идентификатор)

	Для Индекс = 0 По Контексты.Количество() - 1 Цикл
		Если Контексты[Индекс].ИдентификаторДляЛогики = Идентификатор Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;

КонецФункции

#КонецОбласти
