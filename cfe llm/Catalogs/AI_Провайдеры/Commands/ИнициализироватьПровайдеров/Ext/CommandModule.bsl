
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт

	Попытка
		Результат = AI_ОбслуживаниеСервер.ОбеспечитьСтандартныхПровайдеров();
		ОповеститьОбИзменении(Тип("СправочникСсылка.AI_Провайдеры"));
		Сообщить(СтрШаблон(
			"Провайдеры инициализированы: создано %1, обновлено %2, без изменений %3.",
			Результат.Создано,
			Результат.Обновлено,
			Результат.БезИзменений));
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры
