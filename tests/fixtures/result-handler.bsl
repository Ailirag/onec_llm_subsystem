// Только для сгенерированной тестовой конфигурации. В CF/CFE поставки не входит.
Процедура ОбработатьРезультат(КодОбработчика, Контракт, Обработан) Экспорт
	Обработан = Ложь;
	Если КодОбработчика <> "test.accept" И КодОбработчика <> "test.rollback" Тогда
		Возврат;
	КонецЕсли;
	Если ПривилегированныйРежим() Тогда
		ВызватьИсключение "Прикладной обработчик получил привилегированный режим.";
	КонецЕсли;
	Запись = РегистрыСведений.LLMTestDeliveries.СоздатьМенеджерЗаписи();
	Запись.OperationId = Контракт.ИдентификаторОперации;
	Запись.Прочитать();
	Запись.OperationId = Контракт.ИдентификаторОперации;
	Запись.DeliveryCount = Запись.DeliveryCount + 1;
	Запись.Записать();
	Если КодОбработчика = "test.rollback" Тогда
		ВызватьИсключение "Тест отката обработчика.";
	КонецЕсли;
	Обработан = Истина;
КонецПроцедуры
