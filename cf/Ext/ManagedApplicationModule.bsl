Процедура ПриНачалеРаботыСистемы()
	Если СтрНачинаетсяС(Строка(ПараметрЗапуска), "LLMCORE|") Тогда
		ПодключитьОбработчикОжидания("ПроверитьФоновыйТест", 1);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьФоновыйТест() Экспорт
	Части = СтрРазделить(Строка(ПараметрЗапуска), "|", Ложь);
	Результат = LLMBackgroundTestServer.Проверить(Части[2]);
	Если СтрНачинаетсяС(Результат, "WAIT|") Тогда
		Возврат;
	КонецЕсли;
	ОтключитьОбработчикОжидания("ПроверитьФоновыйТест");
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Результат);
	Документ.Записать(Части[1], КодировкаТекста.UTF8);
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
