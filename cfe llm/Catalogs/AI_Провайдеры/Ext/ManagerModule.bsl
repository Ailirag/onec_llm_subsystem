		СтрРазделить(ВариантыНаименования, ",")));

КонецПроцедуры

Функция НайтиСтандартногоПровайдера(ТипПровайдера, ВариантыНаименования)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Провайдеры.Ссылка КАК Ссылка,
		|	Провайдеры.ТипПровайдера КАК ТипПровайдера,
		|	Провайдеры.Наименование КАК Наименование
		|ИЗ
		|	Справочник.AI_Провайдеры КАК Провайдеры
		|ГДЕ
		|	НЕ Провайдеры.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	КандидатПоНаименованию = Справочники.AI_Провайдеры.ПустаяСсылка();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ТипПровайдера = ТипПровайдера Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ТипПровайдера) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ВариантНаименования Из ВариантыНаименования Цикл
			Если НормализоватьНаименованиеПровайдера(Выборка.Наименование)
					= НормализоватьНаименованиеПровайдера(ВариантНаименования) Тогда
				КандидатПоНаименованию = Выборка.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат КандидатПоНаименованию;

КонецФункции

Функция ТипПровайдераПоНаименованию(Наименование)

	НормализованноеИмя = НормализоватьНаименованиеПровайдера(Наименование);
	Если НормализованноеИмя = "openai" Тогда
		Возврат Перечисления.AI_ТипПровайдера.OpenAI;
	ИначеЕсли НормализованноеИмя = "yandex"
			Или НормализованноеИмя = "yandexcloud" Тогда
		Возврат Перечисления.AI_ТипПровайдера.Yandex;
	ИначеЕсли НормализованноеИмя = "zai" Тогда
		Возврат Перечисления.AI_ТипПровайдера.ZAI;
	ИначеЕсли НормализованноеИмя = "lmstudio" Тогда
		Возврат Перечисления.AI_ТипПровайдера.LMStudio;
	ИначеЕсли НормализованноеИмя = "ollama" Тогда
		Возврат Перечисления.AI_ТипПровайдера.Ollama;
	КонецЕсли;
	Возврат Перечисления.AI_ТипПровайдера.ПустаяСсылка();

КонецФункции

Функция НормализоватьНаименованиеПровайдера(Наименование)

	Результат = НРег(СокрЛП(Строка(Наименование)));
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, ".", "");
	Результат = СтрЗаменить(Результат, "-", "");
	Возврат Результат;

КонецФункции

Функция ПолучитьСуществующиеМодели(Провайдер)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	AI_Модели.Ссылка КАК Ссылка,
		|	AI_Модели.Наименование КАК Наименование
		|ИЗ
		|	Справочник.AI_Модели КАК AI_Модели
		|ГДЕ
		|	AI_Модели.Владелец = &Провайдер";
	Запрос.УстановитьПараметр("Провайдер", Провайдер);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(НРег(Выборка.Наименование), Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СформироватьИдентификаторЛогики(ПредопределенныйИдентификатор)

	Если ЗначениеЗаполнено(ПредопределенныйИдентификатор) Тогда
		Возврат Лев(ПредопределенныйИдентификатор, 50);
	КонецЕсли;

	Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Возврат "MODEL_" + Идентификатор;

КонецФункции

#КонецОбласти
