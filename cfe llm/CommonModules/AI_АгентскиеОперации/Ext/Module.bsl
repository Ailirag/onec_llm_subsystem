		"ИдентификаторОперации,ИдентификаторДиалога,ИдентификаторКорреляции,ПовторныйВызов",
		ИдентификаторОперации,
		ИдентификаторДиалога,
		ИдентификаторКорреляции,
		ПовторныйВызов);

КонецФункции

Процедура ПроверитьПрикладныеПараметры(
	КодСценария,
	ИдемпотентныйКлюч,
	ТипИсточника,
	ПредставлениеИсточника,
	ВерсияКонтекста,
	Приоритет)

	Если Не ЗначениеЗаполнено(КодСценария) Тогда
		ВызватьИсключение "Для прикладного вызова укажите код сценария.";
	КонецЕсли;
	Если СтрДлина(КодСценария) > 100 Тогда
		ВызватьИсключение "Код сценария не может быть длиннее 100 символов.";
	КонецЕсли;
	Если СтрДлина(ИдемпотентныйКлюч) > 100 Тогда
		ВызватьИсключение "Идемпотентный ключ не может быть длиннее 100 символов.";
	КонецЕсли;
	Если СтрДлина(ТипИсточника) > 150 Тогда
		ВызватьИсключение "Тип источника не может быть длиннее 150 символов.";
	КонецЕсли;
	Если СтрДлина(ПредставлениеИсточника) > 250 Тогда
		ВызватьИсключение "Представление источника не может быть длиннее 250 символов.";
	КонецЕсли;
	Если ВерсияКонтекста < 1
		Или ВерсияКонтекста > 99999
		Или Цел(ВерсияКонтекста) <> ВерсияКонтекста Тогда
		ВызватьИсключение "Версия контекста должна быть целым числом от 1 до 99999.";
	КонецЕсли;
	Если Приоритет < 0
		Или Приоритет > 999
		Или Цел(Приоритет) <> Приоритет Тогда
		ВызватьИсключение "Приоритет должен быть целым числом от 0 до 999.";
	КонецЕсли;

КонецПроцедуры

Функция ПроверитьКонтекстJSON(КонтекстJSON, ВерсияКонтекста)

	КонтекстJSON = ОбрезатьКраяСтроки(КонтекстJSON);
	Если Не ЗначениеЗаполнено(КонтекстJSON) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрДлина(КонтекстJSON) > 1000000 Тогда
		ВызватьИсключение "Контекст JSON не может быть больше 1 000 000 символов.";
	КонецЕсли;
	Если ВерсияКонтекста < 1
		Или ВерсияКонтекста > 99999
		Или Цел(ВерсияКонтекста) <> ВерсияКонтекста Тогда
		ВызватьИсключение "Для контекста JSON укажите целую версию от 1 до 99999.";
	КонецЕсли;

	Попытка
		ДанныеКонтекста = OPI_Инструменты.JsonВСтруктуру(КонтекстJSON, Истина);
	Исключение
		ВызватьИсключение "Некорректный контекст JSON: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если ТипЗнч(ДанныеКонтекста) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Корнем контекста JSON должен быть объект.";
	КонецЕсли;
	ВерсияИзJSON = ДанныеКонтекста.Получить("version");
	Если ВерсияИзJSON = Неопределено Тогда
		ВызватьИсключение "Контекст JSON должен содержать поле version.";
	КонецЕсли;
	Если ВерсияИзJSON <> ВерсияКонтекста Тогда
		ВызватьИсключение "Поле version в контексте JSON не совпадает с ВерсияКонтекста.";
	КонецЕсли;

	Возврат КонтекстJSON;

КонецФункции

