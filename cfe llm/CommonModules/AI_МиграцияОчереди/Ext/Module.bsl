
// Opt-in адаптер старого метода. Не меняет старый маршрут без настройки сценария.
Функция ПоставитьПоСценарию(Провайдер, ТипAPI, Модель, Агент, Промт, ИмяВложения, Вложение) Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.AI_Сценарии
		|ГДЕ Активен И НЕ ПометкаУдаления И ИспользоватьДляСтаройОчереди И Агент = &Агент");
	Запрос.УстановитьПараметр("Агент", Агент);
	Сценарии = Запрос.Выполнить().Выгрузить();
	Если Сценарии.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Сценарии.Количество() > 1 Тогда
		ВызватьИсключение "Для агента настроено несколько сценариев старой очереди.";
	КонецЕсли;
	ПроверитьОтсутствиеВложения(ИмяВложения, Вложение);
	Параметры = ПараметрыПереноса(Сценарии[0].Ссылка, Провайдер, ТипAPI, Модель, Агент, Промт);
	Параметры.ЗапуститьНемедленно = Не ТранзакцияАктивна();
	AI_ПубличныйAPI.НачатьВыполнение(Параметры);
	Возврат Истина;
КонецФункции

// Явный серверный перенос одной записи. Старые записи без владельца требуют
// отдельного подтверждения и роли администратора; инициатором станет текущий пользователь.
Функция ПеренестиЗапрос(Идентификатор, Сценарий, ПодтвержденПереносБезВладельца = Ложь) Экспорт
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Перенос старой очереди запускается вне транзакции.";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Набор = РегистрыСведений.AI_ОчередьЗапросов.СоздатьНаборЗаписей();
		Набор.Отбор.УникальныйИдентификатор.Установить(Идентификатор);
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.AI_ОчередьЗапросов");
		Элемент.УстановитьЗначение("УникальныйИдентификатор", Идентификатор);
		Блокировка.Заблокировать();
		Набор.Прочитать();
		Если Набор.Количество() <> 1 Тогда
			ВызватьИсключение "Запись старой очереди не найдена.";
		КонецЕсли;
		Запись = Набор[0];
		Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
		Если ЗначениеЗаполнено(Запись.ИдентификаторПользователя) Тогда
			Если Запись.ИдентификаторПользователя <> Пользователь Тогда
				ВызватьИсключение "Нельзя переносить запись другого пользователя.";
			КонецЕсли;
		ИначеЕсли Не ПодтвержденПереносБезВладельца Или Не РольДоступна("AI_ПолныеПрава") Тогда
			ВызватьИсключение "Для записи без владельца требуется явное подтверждение администратора.";
		КонецЕсли;
		Если Запись.Статус = Перечисления.AI_СтатусОчереди.ПеренесенВЯдро Тогда
			ИдентификаторОперации = Запись.ИдентификаторНовойОперации;
		Иначе
			Если Запись.Статус <> Перечисления.AI_СтатусОчереди.Новый Или Запись.КоличествоОшибок > 0 Тогда
				ВызватьИсключение "Перенос разрешен только для новых записей без попыток обработки.";
			КонецЕсли;
			ПроверитьОтсутствиеВложения(Запись.ИмяВложения, Запись.Вложение.Получить());
			Если Сценарий.Агент <> Запись.AI_Агент Тогда
				ВызватьИсключение "Агент сценария не совпадает с агентом записи очереди.";
			КонецЕсли;
			Параметры = ПараметрыПереноса(Сценарий, Запись.Провайдер, Запись.ТипAPI, Запись.Модель, Запись.AI_Агент, Запись.Промт);
			Параметры.ИдемпотентныйКлюч = "legacy-" + Строка(Идентификатор);
			Параметры.ТипИсточника = "РегистрСведений.AI_ОчередьЗапросов";
			Параметры.КлючИсточника = Строка(Идентификатор);
			Параметры.ЗапуститьНемедленно = Ложь;
			Запуск = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
			ИдентификаторОперации = Запуск.ИдентификаторОперации;
			Запись.ИдентификаторНовойОперации = ИдентификаторОперации;
			Запись.ИдентификаторПользователя = Пользователь;
			Запись.Статус = Перечисления.AI_СтатусОчереди.ПеренесенВЯдро;
			Набор.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	AI_ДиспетчерОпераций.ОбработатьОчередь();
	Возврат ИдентификаторОперации;
КонецФункции

Функция ПараметрыПереноса(Сценарий, Провайдер, ТипAPI, Модель, Агент, Промт)
	Параметры = AI_ПубличныйAPI.ПараметрыВыполнения();
	Параметры.Сценарий = Сценарий;
	Параметры.Провайдер = Провайдер;
	Параметры.ТипAPI = ТипAPI;
	Параметры.Модель = Модель;
	Параметры.Агент = Агент;
	Параметры.Промт = Промт;
	Возврат Параметры;
КонецФункции

Процедура ПроверитьОтсутствиеВложения(ИмяВложения, Вложение)
	Если ЗначениеЗаполнено(ИмяВложения) Или Вложение <> Неопределено Тогда
		ВызватьИсключение "Перенос вложений старой очереди требует прикладного адаптера. Запрос не перенесен.";
	КонецЕсли;
КонецПроцедуры
