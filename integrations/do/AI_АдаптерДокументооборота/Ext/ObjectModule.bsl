// Адаптер конфигурации подсистемы LLM для Документооборота.
//
// Ядро подсистемы находит значение по тексту модели в справочниках с
// наименованием и в перечислениях. Исполнитель шаблона процесса в ДО бывает
// еще двух видов, которых ядро искать не умеет:
//   - полная роль (Справочник.ПолныеРоли): роль исполнителя плюс до двух
//     объектов адресации — «Руководитель, Юридический отдел». Наименования у
//     нее нет, а нужная комбинация заводится по требованию;
//   - автоподстановка — строка вроде «Автор процесса», которую ДО при старте
//     процесса заменяет пользователем.
// Адаптер перечисляет эти значения для модели и находит их по тексту ответа.
// Подключается константой «Адаптер конфигурации» в настройках подсистемы.

#Область ПрограммныйИнтерфейс

// Контракт БСП: без него обработку не зарегистрировать.
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "AI-адаптер Документооборота");
	ПараметрыРегистрации.Вставить("Версия", "1.0.0");
	// Полную роль ДО заводит в привилегированном режиме, а безопасный режим
	// привилегии игнорирует: недостающее сочетание роли и объекта адресации
	// адаптер заведет, только если у пользователя есть право на полные роли.
	// Уже заведенные находит всегда.
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить(
		"Информация",
		"Адаптер подсистемы LLM: роли исполнителей и автоподстановки для шаблонов"
		+ " процессов. Запускается не из меню БСП, а ядром подсистемы.");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	ПараметрыРегистрации.Вставить("Команды", Команды);

	Возврат ПараметрыРегистрации;

КонецФункции

// Типы, значения которых адаптер берет на себя.
Функция ОбрабатываемыеТипы() Экспорт

	Типы = Новый Массив;
	Типы.Добавить("Справочник.ПолныеРоли");
	Возврат Типы;

КонецФункции

// Что предложить модели: роли и автоподстановки с пояснениями.
//
// Роли — те, у которых есть исполнители (с объектами адресации — как они
// заведены), и роли, используемые без объектов адресации, даже без
// исполнителей: шаблон настраивают раньше, чем назначают людей, но модель и
// человек должны видеть, что исполнителей пока нет.
Процедура ЗначенияДляВыбора(Параметры) Экспорт

	Если ДопускаетСтроку(Параметры) Тогда
		Для Каждого Автоподстановка Из Автоподстановки() Цикл
			Параметры.Значения.Добавить(Новый Структура("Представление,Пояснение",
				Автоподстановка, "автоподстановка ДО"));
		КонецЦикла;
	КонецЕсли;

	Роли = Новый ТаблицаЗначений;
	Роли.Колонки.Добавить("Представление");
	Роли.Колонки.Добавить("Пояснение");
	Добавленные = Новый Соответствие;
	Для Каждого Элемент Из ИсполнителиРолей() Цикл
		СтрокаРоли = Роли.Добавить();
		СтрокаРоли.Представление = Строка(Элемент.Ключ);
		СтрокаРоли.Пояснение = "роль; исполняет " + СписокИсполнителей(Элемент.Значение);
		Добавленные.Вставить(НРег(СтрокаРоли.Представление), Истина);
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Роли.Наименование КАК Наименование
		|ИЗ
		|	Справочник.РолиИсполнителей КАК Роли
		|ГДЕ
		|	НЕ Роли.ПометкаУдаления
		|	И Роли.ИспользуетсяБезОбъектовАдресации");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Добавленные.Получить(НРег(Выборка.Наименование)) = Неопределено Тогда
			СтрокаРоли = Роли.Добавить();
			СтрокаРоли.Представление = Выборка.Наименование;
			СтрокаРоли.Пояснение = "роль; исполнителей пока нет";
		КонецЕсли;
	КонецЦикла;

	// Один и тот же порядок от запроса к запросу: модель не должна видеть в
	// перестановке смысл, а запрос — терять кэш провайдера.
	Роли.Сортировать("Представление");
	Для Каждого СтрокаРоли Из Роли Цикл
		Параметры.Значения.Добавить(Новый Структура("Представление,Пояснение",
			СтрокаРоли.Представление, СтрокаРоли.Пояснение));
	КонецЦикла;

КонецПроцедуры

// «Автор процесса» — автоподстановка, «Юрист» или «Руководитель, Юридический
// отдел» — полная роль. Остальное — не наше: ядро поищет пользователя.
Процедура НайтиЗначение(Параметры) Экспорт

	Текст = СокрЛП(Параметры.Текст);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;

	Если ДопускаетСтроку(Параметры) Тогда
		Для Каждого Автоподстановка Из Автоподстановки() Цикл
			Если НРег(Автоподстановка) = НРег(Текст) Тогда
				// Шаблон хранит автоподстановку ее представлением — так же, как
				// ее выбирает человек в форме шаблона.
				Параметры.Значение = Автоподстановка;
				Параметры.Найдено = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, ",", Ложь) Цикл
		Части.Добавить(СокрЛП(Часть));
	КонецЦикла;
	Роль = Справочники.РолиИсполнителей.НайтиПоНаименованию(Части[0], Истина);
	Если Не ЗначениеЗаполнено(Роль) Тогда
		Возврат;
	КонецЕсли;

	// Заведенная полная роль узнается по представлению: так ее и показывали
	// модели. Это же спасает от разбора по запятым, когда запятая есть в
	// наименовании объекта адресации.
	ПолнаяРоль = ЗаведеннаяПолнаяРоль(Роль, Части);
	Если ПолнаяРоль = Неопределено Тогда
		ПолнаяРоль = НоваяПолнаяРоль(Роль, Части, Параметры);
		Если ПолнаяРоль = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Параметры.Значение = ПолнаяРоль;
	Параметры.Найдено = Истина;
	Если ИсполнителиРолей().Получить(ПолнаяРоль) = Неопределено Тогда
		Параметры.Комментарий = "У роли пока нет исполнителей: назначьте их до запуска процесса по шаблону.";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Автоподстановки без предметов процесса: предметные («Предмет.Автор
// документа») зависят от предметов шаблона, а шаблон еще только собирается.
Функция Автоподстановки()

	Результат = Новый Массив;
	Попытка
		Список = ШаблоныБизнесПроцессов.ПолучитьСписокДоступныхФункций(Неопределено, Ложь);
	Исключение
		// Другая редакция ДО без этого программного интерфейса: без
		// автоподстановок адаптер все равно полезен ролями. Но молча терять
		// их нельзя — причину увидит администратор в журнале.
		ЗаписьЖурналаРегистрации("AI.АдаптерДокументооборота", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Автоподстановки недоступны: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	Для Каждого Элемент Из Список Цикл
		Если ЗначениеЗаполнено(Элемент.Представление) Тогда
			Результат.Добавить(Элемент.Представление);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Автоподстановка — строка, и годится только туда, где тип реквизита ее
// допускает: у исполнителя шаблона допускает, у роли задачи — нет.
Функция ДопускаетСтроку(Параметры)

	ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(Параметры.ПолноеИмяОбъекта);
	Если ОписаниеОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Реквизит = Неопределено;
	Если ЗначениеЗаполнено(Параметры.ТабличнаяЧасть) Тогда
		ТабличнаяЧасть = ОписаниеОбъекта.ТабличныеЧасти.Найти(Параметры.ТабличнаяЧасть);
		Если ТабличнаяЧасть <> Неопределено Тогда
			Реквизит = ТабличнаяЧасть.Реквизиты.Найти(Параметры.ПутьРеквизита);
		КонецЕсли;
	Иначе
		Реквизит = ОписаниеОбъекта.Реквизиты.Найти(Параметры.ПутьРеквизита);
	КонецЕсли;
	Возврат Реквизит <> Неопределено И Реквизит.Тип.СодержитТип(Тип("Строка"));

КонецФункции

// Полная роль -> массив исполнителей (действующих пользователей).
Функция ИсполнителиРолей()

	Результат = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Исполнители.РольИсполнителя КАК Роль,
		|	Исполнители.Исполнитель КАК Исполнитель
		|ИЗ
		|	РегистрСведений.ИсполнителиЗадач КАК Исполнители
		|ГДЕ
		|	НЕ Исполнители.РольИсполнителя.ПометкаУдаления
		|	И НЕ Исполнители.Исполнитель.ПометкаУдаления
		|	И НЕ Исполнители.Исполнитель.Недействителен
		|УПОРЯДОЧИТЬ ПО
		|	Исполнители.Исполнитель.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Роль) Тогда
			Продолжить;
		КонецЕсли;
		Список = Результат.Получить(Выборка.Роль);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Выборка.Роль, Список);
		КонецЕсли;
		Список.Добавить(Строка(Выборка.Исполнитель));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СписокИсполнителей(Исполнители)

	Показать = 3;
	Части = Новый Массив;
	Для Индекс = 0 По Мин(Показать, Исполнители.Количество()) - 1 Цикл
		Части.Добавить(Исполнители[Индекс]);
	КонецЦикла;
	Текст = СтрСоединить(Части, ", ");
	Если Исполнители.Количество() > Показать Тогда
		Текст = Текст + СтрШаблон(" и еще %1", Исполнители.Количество() - Показать);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Полная роль этой роли, представление которой совпадает с текстом: ДО
// собирает его как «Роль, Основной объект, Дополнительный объект».
Функция ЗаведеннаяПолнаяРоль(Роль, Части)

	Искомое = НРег(СтрСоединить(Части, ", "));
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ПолныеРоли.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПолныеРоли КАК ПолныеРоли
		|ГДЕ
		|	ПолныеРоли.Владелец = &Роль
		|	И НЕ ПолныеРоли.ПометкаУдаления");
	Запрос.УстановитьПараметр("Роль", Роль);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НРег(Строка(Выборка.Ссылка)) = Искомое Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Такого сочетания роли и объектов адресации еще нет — заводим его, как это
// делает форма шаблона, когда человек выбирает роль с объектом адресации.
// Неопределено — завести нельзя, причина в Параметры.Комментарий.
Функция НоваяПолнаяРоль(Роль, Части, Параметры)

	Основной = Неопределено;
	Дополнительный = Неопределено;
	Если Части.Количество() = 1 Тогда
		Если Не Роль.ИспользуетсяБезОбъектовАдресации Тогда
			Параметры.Комментарий = СтрШаблон("Роль «%1» назначается только вместе с объектом адресации (%2):"
				+ " например, «%1, <наименование>».", Роль, Роль.ТипыОсновногоОбъектаАдресации);
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли Не Роль.ИспользуетсяСОбъектамиАдресации Тогда
		Параметры.Комментарий = СтрШаблон("Роль «%1» назначается без объектов адресации.", Роль);
		Возврат Неопределено;
	Иначе
		Основной = ОбъектАдресации(Части[1], Роль.ТипыОсновногоОбъектаАдресации);
		Если Основной = Неопределено Тогда
			Параметры.Комментарий = СтрШаблон("Для роли «%1» не найден объект адресации «%2» (%3).",
				Роль, Части[1], Роль.ТипыОсновногоОбъектаАдресации);
			Возврат Неопределено;
		КонецЕсли;
		Если Части.Количество() > 2 Тогда
			Дополнительный = ОбъектАдресации(Части[2], Роль.ТипыДополнительногоОбъектаАдресации);
			Если Дополнительный = Неопределено Тогда
				Параметры.Комментарий = СтрШаблон("Для роли «%1» не найден дополнительный объект адресации «%2» (%3).",
					Роль, Части[2], Роль.ТипыДополнительногоОбъектаАдресации);
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Попытка
		Возврат Справочники.ПолныеРоли.НайтиСоздатьПолнуюРоль(Роль, Основной, Дополнительный);
	Исключение
		Параметры.Комментарий = СтрШаблон("Роли «%1» в таком сочетании еще нет в базе, а завести ее"
			+ " не удалось: %2. Выберите ее один раз в любом шаблоне вручную.",
			СтрСоединить(Части, ", "), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Объект адресации по наименованию — только среди типов, которые допускает
// роль: у «Руководителя» это, например, подразделения, и одноименный проект
// подставлять нельзя.
Функция ОбъектАдресации(Имя, ВидОбъекта)

	Если Не ЗначениеЗаполнено(ВидОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ТипОбъекта Из ВидОбъекта.ТипЗначения.Типы() Цикл
		ОписаниеОбъекта = Метаданные.НайтиПоТипу(ТипОбъекта);
		Если ОписаниеОбъекта = Неопределено
			Или Не Метаданные.Справочники.Содержит(ОписаниеОбъекта)
			Или ОписаниеОбъекта.ДлинаНаименования = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ссылка = Справочники[ОписаниеОбъекта.Имя].НайтиПоНаименованию(Имя, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти
