#Область ПрограммныйИнтерфейс

Функция Run(Режим = "smoke") Экспорт

	Результаты = Новый Массив;

	Попытка
		Если НРег(СокрЛП(Режим)) = "seed" Тогда
			ЗаполнитьТестовыеДанные(Результаты);
		ИначеЕсли НРег(СокрЛП(Режим)) = "smoke" Тогда
			ВыполнитьДымовыеТесты(Результаты);
		Иначе
			ВызватьИсключение "Поддерживаемые режимы: seed, smoke.";
		КонецЕсли;
	Исключение
		ДобавитьРезультат(
			Результаты,
			"runner",
			Ложь,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат СформироватьТекстРезультатов(Результаты);

КонецФункции

// Возвращает WAIT, пока фоновая операция выполняется, затем OK или ERROR.
// Повторные вызовы с одним ключом одновременно проверяют идемпотентность API.
Функция RunCore(ИдемпотентныйКлюч, ПрямойВызов = Истина) Экспорт

	Попытка
		ЗапросСтарыхТестов = Новый Запрос(
			"ВЫБРАТЬ ИдентификаторОперации ИЗ РегистрСведений.AI_АгентскиеОперации
			|ГДЕ КодСценария = &Сценарий И ИдемпотентныйКлюч <> &Ключ
			| И ИдентификаторПользователя = &Пользователь");
		ЗапросСтарыхТестов.УстановитьПараметр("Сценарий", "functional.core");
		ЗапросСтарыхТестов.УстановитьПараметр("Ключ", ИдемпотентныйКлюч);
		ЗапросСтарыхТестов.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
		СтарыеТесты = ЗапросСтарыхТестов.Выполнить().Выбрать();
		Пока СтарыеТесты.Следующий() Цикл
			AI_ПубличныйAPI.Отменить(СтарыеТесты.ИдентификаторОперации);
		КонецЦикла;
		Фикстуры = ПолучитьФикстуры();
		Модель = ОбеспечитьМодельАгента(Фикстуры.Провайдер);
		Проверить(ЗначениеЗаполнено(Модель), "Модель mock-agent не найдена.");

		Параметры = AI_ПубличныйAPI.ПараметрыВыполнения();
		Параметры.КодСценария = "functional.core";
		Параметры.ИдемпотентныйКлюч = ИдемпотентныйКлюч;
		Параметры.Источник = Фикстуры.Агент;
		Параметры.ПредставлениеИсточника = "Autotest database agent";
		Параметры.ВерсияКонтекста = 1;
		Параметры.КонтекстJSON = "{""expected_counterparties"":37}";
		Параметры.Приоритет = 100;
		Параметры.Провайдер = Фикстуры.Провайдер;
		Параметры.Модель = Модель;
		Параметры.ТипAPI = Перечисления.AI_ТипAPI.Responses;
		Параметры.Агент = Фикстуры.Агент;
		Параметры.Промт = "AGENT_COUNT_COUNTERPARTIES CORE_CONTEXT";
		НекорректныйКонтекстПринят = Истина;
		Попытка
			AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		Исключение
			НекорректныйКонтекстПринят = Ложь;
		КонецПопытки;
		Проверить(Не НекорректныйКонтекстПринят,
			"Контекст JSON без поля version не был отклонён.");
		Параметры.КонтекстJSON = "{""version"":1,""expected_counterparties"":37}";

		ПервыйЗапуск = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		ПовторныйЗапуск = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		Проверить(
			ПервыйЗапуск.ИдентификаторОперации = ПовторныйЗапуск.ИдентификаторОперации,
			"Идемпотентный вызов создал вторую операцию.");
		Проверить(ПовторныйЗапуск.ПовторныйВызов,
			"Повторный вызов не помечен как идемпотентный повтор.");

		Состояние = AI_ПубличныйAPI.ПолучитьСостояние(
			ПервыйЗапуск.ИдентификаторОперации);
		Если Не Состояние.Финальная И ПрямойВызов Тогда
			// Внешнее COM-соединение файловой тестовой базы не запускает планировщик
			// фоновых заданий. Выполняем тот же серверный обработчик напрямую.
			ЗаписьОперации = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
			ЗаписьОперации.ИдентификаторОперации = ПервыйЗапуск.ИдентификаторОперации;
			ЗаписьОперации.Прочитать();
			AI_АгентскиеОперацииСервер.ВыполнитьОперацию(
				ПервыйЗапуск.ИдентификаторОперации, ЗаписьОперации.ТокенВыполнения);
			Состояние = AI_ПубличныйAPI.ПолучитьСостояние(
				ПервыйЗапуск.ИдентификаторОперации);
		КонецЕсли;

		Если Не Состояние.Финальная Тогда
			Возврат "WAIT|" + Строка(ПервыйЗапуск.ИдентификаторОперации);
		КонецЕсли;
		Проверить(Состояние.Успешно,
			"Прикладная операция завершилась с ошибкой: " + Состояние.ТекстОшибки);
		Проверить(Состояние.Результат = "MOCK_AGENT_OK",
			"Публичный API не получил ответ mock-провайдера.");
		Проверить(Состояние.КодСценария = "functional.core",
			"Код сценария потерян в очереди.");
		Проверить(Состояние.ТипИсточника = Строка(ТипЗнч(Фикстуры.Агент)),
			"Тип источника потерян в очереди.");
		Проверить(Состояние.КлючИсточника = Строка(Фикстуры.Агент.УникальныйИдентификатор()),
			"Ключ ссылочного источника не определен автоматически.");
		Проверить(Состояние.ВерсияКонтекста = 1,
			"Версия контекста потеряна в очереди.");
		Проверить(Состояние.ВходящиеТокены > 0 И Состояние.ВыходящиеТокены > 0,
			"Токены прикладной операции не учтены.");

		Возврат "OK|" + Строка(ПервыйЗапуск.ИдентификаторОперации)
			+ "|" + Состояние.Результат;
	Исключение
		Возврат "ERROR|" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция RunContracts() Экспорт
	Попытка
		СхемаJSON = "{""type"":""object"",""properties"":{""count"":{""type"":""integer""}},""required"":[""count""],""additionalProperties"":false}";
		AI_КонтрактыОпераций.ПроверитьОтвет("{""count"":37}", СхемаJSON);
		Для Каждого Некорректный Из СтрРазделить("{}|{""count"":""37""}|{""count"":37,""extra"":1}|{""count"":null}", "|") Цикл
			Отклонен = Ложь;
			Попытка
				AI_КонтрактыОпераций.ПроверитьОтвет(Некорректный, СхемаJSON);
			Исключение
				Отклонен = Истина;
			КонецПопытки;
			Проверить(Отклонен, "Некорректный JSON принят: " + Некорректный);
		КонецЦикла;
		Фикстуры = ПолучитьФикстуры();
		СсылкаСценария = Справочники.AI_Сценарии.НайтиПоКоду("ATSCHEMA01");
		Если ЗначениеЗаполнено(СсылкаСценария) Тогда
			Сценарий = СсылкаСценария.ПолучитьОбъект();
		Иначе
			Сценарий = Справочники.AI_Сценарии.СоздатьЭлемент();
			Сценарий.Код = "ATSCHEMA01";
		КонецЕсли;
		Сценарий.Наименование = "Autotest schema";
		Сценарий.Активен = Истина;
		Сценарий.ВерсияКонтракта = 1;
		Сценарий.МаксимумПопыток = 1;
		Сценарий.Агент = Фикстуры.Агент;
		Сценарий.Провайдер = Фикстуры.Провайдер;
		Сценарий.Модель = НайтиМодель(Фикстуры.Провайдер, "mock-agent");
		Сценарий.ТипAPI = Перечисления.AI_ТипAPI.Responses;
		Сценарий.СхемаОтветаJSON = СхемаJSON;
		Сценарий.КодОбработчика = "test.unknown";
		Сценарий.Записать();
		Параметры = AI_ПубличныйAPI.ПараметрыВыполнения();
		Параметры.Сценарий = Сценарий.Ссылка;
		Параметры.Промт = "SCHEMA_VALID";
		Параметры.ЗапуститьНемедленно = Ложь;
		Запуск = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		Сценарий.СхемаОтветаJSON = "";
		Сценарий.ВерсияКонтракта = 2;
		Сценарий.Записать();
		AI_АгентскиеОперацииСервер.ВыполнитьОперацию(Запуск.ИдентификаторОперации);
		AI_КонтрактыОпераций.ДоставитьРезультат(Запуск.ИдентификаторОперации);
		Результат = AI_ПубличныйAPI.ПолучитьРезультат(Запуск.ИдентификаторОперации);
		Проверить(Результат.Успешно И Результат.Результат = "{""count"":37}", "Структурированный ответ не получен: " + Результат.ТекстОшибки);
		Проверить(Результат.ВерсияКонтракта = 1, "Изменился снимок контракта очереди.");
		Проверить(Результат.СтатусДоставки = "Ошибка" И ЗначениеЗаполнено(Результат.ОшибкаДоставки), "Ошибка доставки не отделена от результата модели.");
		Сценарий.СхемаОтветаJSON = СхемаJSON;
		Сценарий.КодОбработчика = "";
		Сценарий.Записать();
		Параметры.Промт = "SCHEMA_INVALID";
		Запуск = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		AI_АгентскиеОперацииСервер.ВыполнитьОперацию(Запуск.ИдентификаторОперации);
		AI_КонтрактыОпераций.ДоставитьРезультат(Запуск.ИдентификаторОперации);
		Результат = AI_ПубличныйAPI.ПолучитьРезультат(Запуск.ИдентификаторОперации);
		Проверить(Результат.Финальная И Не Результат.Успешно И Результат.ВходящиеТокены > 0,
			"Ответ с неверной схемой принят или потеряны токены.");
		Параметры.Промт = "SCHEMA_VALID";
		Параметры.ТипAPI = Перечисления.AI_ТипAPI.ChatCompletions;
		Запуск = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		AI_АгентскиеОперацииСервер.ВыполнитьОперацию(Запуск.ИдентификаторОперации);
		AI_КонтрактыОпераций.ДоставитьРезультат(Запуск.ИдентификаторОперации);
		Результат = AI_ПубличныйAPI.ПолучитьРезультат(Запуск.ИдентификаторОперации);
		Проверить(Результат.Успешно И Результат.Результат = "{""count"":37}", "Chat Completions schema: " + Результат.ТекстОшибки);
		Сценарий.КодОбработчика = "test.accept";
		Сценарий.Записать();
		Запуск = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		AI_АгентскиеОперацииСервер.ВыполнитьОперацию(Запуск.ИдентификаторОперации);
		AI_КонтрактыОпераций.ДоставитьРезультат(Запуск.ИдентификаторОперации);
		AI_КонтрактыОпераций.ДоставитьРезультат(Запуск.ИдентификаторОперации);
		Доставка = РегистрыСведений.LLMTestDeliveries.СоздатьМенеджерЗаписи();
		Доставка.OperationId = Запуск.ИдентификаторОперации;
		Доставка.Прочитать();
		Проверить(Доставка.DeliveryCount = 1, "Обработчик вызван не один раз или получил привилегии.");
		Сценарий.КодОбработчика = "test.rollback";
		Сценарий.Записать();
		Запуск = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		AI_АгентскиеОперацииСервер.ВыполнитьОперацию(Запуск.ИдентификаторОперации);
		AI_КонтрактыОпераций.ДоставитьРезультат(Запуск.ИдентификаторОперации);
		Доставка.OperationId = Запуск.ИдентификаторОперации;
		Доставка.Прочитать();
		Проверить(Не Доставка.Выбран(), "Ошибка обработчика не откатила прикладную запись.");
		Операция = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
		Операция.ИдентификаторОперации = Запуск.ИдентификаторОперации;
		Операция.Прочитать();
		Проверить(Операция.СтатусДоставки = "Ошибка", "Не сохранена ошибка callback.");
		Операция.КодОбработчика = "test.accept";
		Операция.Записать();
		AI_ПубличныйAPI.ПовторитьДоставку(Запуск.ИдентификаторОперации);
		AI_КонтрактыОпераций.ДоставитьРезультат(Запуск.ИдентификаторОперации);
		Операция.Прочитать();
		Доставка.OperationId = Запуск.ИдентификаторОперации;
		Доставка.Прочитать();
		Проверить(Операция.СтатусДоставки = "Доставлен" И Операция.КоличествоПопыток = 1
			И Доставка.DeliveryCount = 1, "Повтор доставки потерян или повторно вызвал модель.");
		ИДОценки = Новый УникальныйИдентификатор;
		AI_ПубличныйAPI.ОценитьРезультат(Запуск.ИдентификаторОперации, "Исправлено", "test", "{""count"":38}", ИДОценки);
		ПовторОценки = AI_ПубличныйAPI.ОценитьРезультат(Запуск.ИдентификаторОперации, "Исправлено", "test", "{""count"":38}", ИДОценки);
		Проверить(ПовторОценки = ИДОценки, "Повтор создал другую оценку.");
		Оценка = РегистрыСведений.AI_ОценкиРезультатов.СоздатьМенеджерЗаписи();
		Оценка.ИдентификаторОценки = ИДОценки;
		Оценка.Прочитать();
		Проверить(Оценка.ОтветМодели = "{""count"":37}" И Оценка.ИсправленныйОтвет = "{""count"":38}", "Оценка потеряла исходный/исправленный ответ.");
		КонфликтОтклонен = Ложь;
		Попытка
			AI_ПубличныйAPI.ОценитьРезультат(Запуск.ИдентификаторОперации, "Принято", "", "", ИДОценки);
		Исключение
			КонфликтОтклонен = Истина;
		КонецПопытки;
		Проверить(КонфликтОтклонен, "История оценок была перезаписана.");
		Проверить(СтрДлина(Операция.ХешСистемногоПромта) = 64 И ЗначениеЗаполнено(Операция.ДатаПервогоЗапуска), "Не сохранена версия промпта или время первого запуска.");
		Статистика = AI_ПубличныйAPI.ПолучитьСтатистику();
		Проверить(Статистика.Количество() > 0, "Статистика операций не возвращена.");
		ПоследниеОперации = AI_ПубличныйAPI.ПолучитьПоследниеОперации();
		Проверить(ПоследниеОперации.Найти(Запуск.ИдентификаторОперации, "ИдентификаторОперации") <> Неопределено,
			"Личный монитор не вернул завершенную операцию.");
		Проверить(AI_ПубличныйAPI.ПолучитьОшибкиДоставки().Количество() > 0, "Не возвращен отчет об ошибках доставки.");
		СрокОценок = Константы.AI_СрокХраненияОценокДней.Получить();
		Попытка
			Оценка.ДатаОценки = ТекущаяДатаСеанса() - 172800;
			Оценка.Записать();
			Константы.AI_СрокХраненияОценокДней.Установить(1);
			AI_ДиспетчерОпераций.ОбработатьОчередь();
			Оценка.Прочитать();
			Проверить(Оценка.ДанныеОчищены И Оценка.ОтветМодели = "" И Оценка.Решение = "Исправлено", "Очистка оценок потеряла вердикт или сохранила текст.");
		Исключение
			Константы.AI_СрокХраненияОценокДней.Установить(СрокОценок);
			ВызватьИсключение;
		КонецПопытки;
		Константы.AI_СрокХраненияОценокДней.Установить(СрокОценок);
		Возврат "OK|contracts|validation,snapshot,responses,chat,delivery,rollback,re-delivery,feedback,metrics,monitor,feedback-retention";
	Исключение
		Возврат "ERROR|" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция RunMigration() Экспорт
	Сценарий = Неопределено;
	Попытка
		Фикстуры = ПолучитьФикстуры();
		Сценарий = Справочники.AI_Сценарии.НайтиПоКоду("ATSCHEMA01").ПолучитьОбъект();
		Сценарий.ИспользоватьДляСтаройОчереди = Ложь;
		Сценарий.КодОбработчика = "";
		Сценарий.СхемаОтветаJSON = "";
		Сценарий.Записать();
		Промт = "MIGRATE_" + Строка(Новый УникальныйИдентификатор);
		РегистрыСведений.AI_ОчередьЗапросов.ПоставитьЗапросВОчередь(
			Фикстуры.Провайдер, Перечисления.AI_ТипAPI.Responses, Сценарий.Модель, Фикстуры.Агент, Промт);
		Запрос = Новый Запрос("ВЫБРАТЬ УникальныйИдентификатор ИЗ РегистрСведений.AI_ОчередьЗапросов ГДЕ ВЫРАЗИТЬ(Промт КАК СТРОКА(200)) = &Промт");
		Запрос.УстановитьПараметр("Промт", Промт);
		Строки = Запрос.Выполнить().Выбрать();
		Проверить(Строки.Следующий(), "Исходная запись legacy не создана.");
		ИДLegacy = Строки.УникальныйИдентификатор;
		ИДОперации = AI_МиграцияОчереди.ПеренестиЗапрос(ИДLegacy, Сценарий.Ссылка);
		Повтор = AI_МиграцияОчереди.ПеренестиЗапрос(ИДLegacy, Сценарий.Ссылка);
		Проверить(Повтор = ИДОперации, "Повтор миграции создал новую операцию.");
		Проверить(Не РегистрыСведений.AI_ОчередьЗапросов.ЗафиксироватьНачалоОбработки(ИДLegacy), "Старая очередь захватила перенесенную запись.");
		Операция = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
		Операция.ИдентификаторОперации = ИДОперации;
		Операция.Прочитать();
		AI_АгентскиеОперацииСервер.ВыполнитьОперацию(ИДОперации, Операция.ТокенВыполнения);
		Результат = AI_ПубличныйAPI.ПолучитьРезультат(ИДОперации);
		Проверить(Результат.Успешно И Результат.Результат = "MOCK_AGENT_OK", "Перенесенный запрос не выполнен: " + Результат.ТекстОшибки);
		Сценарий.ИспользоватьДляСтаройОчереди = Истина;
		Сценарий.Записать();
		Промт = "ROUTE_" + Строка(Новый УникальныйИдентификатор);
		РегистрыСведений.AI_ОчередьЗапросов.ПоставитьЗапросВОчередь(
			Фикстуры.Провайдер, Перечисления.AI_ТипAPI.Responses, Сценарий.Модель, Фикстуры.Агент, Промт);
		Запрос.УстановитьПараметр("Промт", Промт);
		Проверить(Запрос.Выполнить().Пустой(), "Opt-in создал запись старой очереди.");
		Запрос.Текст = "ВЫБРАТЬ ИдентификаторОперации ИЗ РегистрСведений.AI_АгентскиеОперации ГДЕ ВЫРАЗИТЬ(Промт КАК СТРОКА(200)) = &Промт";
		Строки = Запрос.Выполнить().Выбрать();
		Проверить(Строки.Следующий(), "Opt-in не создал операцию ядра.");
		Операция.ИдентификаторОперации = Строки.ИдентификаторОперации;
		Операция.Прочитать();
		AI_АгентскиеОперацииСервер.ВыполнитьОперацию(Строки.ИдентификаторОперации, Операция.ТокенВыполнения);
		Результат = AI_ПубличныйAPI.ПолучитьРезультат(Строки.ИдентификаторОперации);
		Проверить(Результат.Успешно, "Новый маршрут legacy не получил ответ модели.");
		Сценарий.ИспользоватьДляСтаройОчереди = Ложь;
		Сценарий.Записать();
		Занятая = РегистрыСведений.AI_ОчередьЗапросов.СоздатьМенеджерЗаписи();
		ИДЗанятой = Новый УникальныйИдентификатор;
		Занятая.УникальныйИдентификатор = ИДЗанятой;
		Занятая.ИдентификаторПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
		Занятая.Статус = Перечисления.AI_СтатусОчереди.Новый;
		Занятая.Записать();
		Проверить(РегистрыСведений.AI_ОчередьЗапросов.ЗафиксироватьНачалоОбработки(ИДЗанятой), "Legacy-захват новой записи не работает.");
		ПереносОтклонен = Ложь;
		Попытка
			AI_МиграцияОчереди.ПеренестиЗапрос(ИДЗанятой, Сценарий.Ссылка);
		Исключение
			ПереносОтклонен = Истина;
		КонецПопытки;
		Проверить(ПереносОтклонен, "Запись в обработке была перенесена.");
		РегистрыСведений.AI_ОчередьЗапросов.УдалитьЗапросИзОчереди(ИДЗанятой);
		Возврат "OK|migration|atomic-transfer,idempotency,no-double-worker,opt-in,model-response";
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если Сценарий <> Неопределено Тогда
			Сценарий.ИспользоватьДляСтаройОчереди = Ложь;
			Сценарий.Записать();
		КонецЕсли;
		Возврат "ERROR|" + ТекстОшибки;
	КонецПопытки;
КонецФункции

Функция RunQueue() Экспорт
	ИсходныйЛимит = Константы.AI_КоличествоПотоковОбработкиОчереди.Получить();
	ИсходныйСрок = Константы.AI_СрокХраненияОперацийДней.Получить();
	Попытка
		Фикстуры = ПолучитьФикстуры();
		Параметры = AI_ПубличныйAPI.ПараметрыВыполнения();
		Параметры.КодСценария = "functional.queue";
		Параметры.Провайдер = Фикстуры.Провайдер;
		Параметры.Модель = НайтиМодель(Фикстуры.Провайдер, "mock-agent");
		Параметры.Агент = Фикстуры.Агент;
		Параметры.ТипAPI = Перечисления.AI_ТипAPI.Responses;
		Параметры.Промт = "AGENT_COUNT_COUNTERPARTIES";
		Параметры.ЗапуститьНемедленно = Ложь;
		Константы.AI_КоличествоПотоковОбработкиОчереди.Установить(1);
		Первый = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		Второй = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		ЧужаяЗапись = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
		ЧужаяЗапись.ИдентификаторОперации = Второй.ИдентификаторОперации;
		ЧужаяЗапись.Прочитать();
		Владелец = ЧужаяЗапись.ИдентификаторПользователя;
		ЧужаяЗапись.ИдентификаторПользователя = Новый УникальныйИдентификатор;
		ЧужаяЗапись.Записать();
		ЧтениеЗапрещено = Ложь;
		Попытка
			AI_ПубличныйAPI.ПолучитьСостояние(Второй.ИдентификаторОперации);
		Исключение
			ЧтениеЗапрещено = Истина;
		КонецПопытки;
		ОтменаЗапрещена = Ложь;
		Попытка
			AI_ПубличныйAPI.Отменить(Второй.ИдентификаторОперации);
		Исключение
			ОтменаЗапрещена = Истина;
		КонецПопытки;
		ЧужаяЗапись.ИдентификаторПользователя = Владелец;
		ЧужаяЗапись.Записать();
		Проверить(ЧтениеЗапрещено И ОтменаЗапрещена, "Разрешено чтение или отмена чужой операции.");
		Токен = AI_ДиспетчерОпераций.Захватить(Первый.ИдентификаторОперации);
		Проверить(Токен <> Неопределено, "Первый слот не захвачен.");
		Проверить(AI_ДиспетчерОпераций.Захватить(Второй.ИдентификаторОперации) = Неопределено,
			"Превышен лимит параллелизма.");
		AI_ПубличныйAPI.Отменить(Первый.ИдентификаторОперации);
		Проверить(Не AI_ДиспетчерОпераций.НачатьПопытку(Первый.ИдентификаторОперации, Токен),
			"Отмененная операция запустилась со старым токеном.");
		ВторойТокен = AI_ДиспетчерОпераций.Захватить(Второй.ИдентификаторОперации);
		Проверить(ВторойТокен <> Неопределено, "Отмена не освободила слот.");
		Проверить(AI_ДиспетчерОпераций.НачатьПопытку(Второй.ИдентификаторОперации, ВторойТокен),
			"Попытка не начата.");
		Проверить(Не AI_ДиспетчерОпераций.НачатьПопытку(Второй.ИдентификаторОперации, ВторойТокен),
			"Дублирующий обработчик начал вторую попытку.");
		Запись = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторОперации = Второй.ИдентификаторОперации;
		Запись.Прочитать();
		Запись.АрендаДо = ТекущаяДатаСеанса() - 1;
		Запись.Записать();
		AI_ДиспетчерОпераций.ОбработатьОчередь();
		Запись.Прочитать();
		Проверить(Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.Ошибка,
			"Прерванная попытка с неизвестным результатом была перезапущена.");

		НачатьТранзакцию();
		Откаченная = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		ОтменитьТранзакцию();
		Запись.ИдентификаторОперации = Откаченная.ИдентификаторОперации;
		Запись.Прочитать();
		Проверить(Не Запись.Выбран(), "Откат транзакции оставил outbox-операцию.");

		Параметры.Промт = "FORCE_503";
		Параметры.ИдемпотентныйКлюч = Строка(Новый УникальныйИдентификатор);
		Параметры.РазрешитьПовтор = Истина;
		Параметры.МаксимумПопыток = 2;
		Повтор = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		AI_АгентскиеОперацииСервер.ВыполнитьОперацию(Повтор.ИдентификаторОперации);
		Запись.ИдентификаторОперации = Повтор.ИдентификаторОперации;
		Запись.Прочитать();
		Проверить(Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.ВОчереди,
			"HTTP 503 не поставлен на повтор: " + Запись.ТекстОшибки);
		Проверить(Запись.СледующаяПопытка > ТекущаяДатаСеанса(), "Нет задержки повтора.");
		Запись.СледующаяПопытка = Дата(1, 1, 1);
		Запись.Записать();
		AI_АгентскиеОперацииСервер.ВыполнитьОперацию(Повтор.ИдентификаторОперации);
		Запись.Прочитать();
		Проверить(Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.Ошибка
			И Запись.КоличествоПопыток = 2, "Не соблюден предел повторов.");
		Запись.ДатаЗавершения = ТекущаяДатаСеанса() - 172800;
		Запись.Записать();
		Константы.AI_СрокХраненияОперацийДней.Установить(1);
		AI_ДиспетчерОпераций.ОбработатьОчередь();
		Запись.Прочитать();
		Проверить(Запись.ДанныеОчищены И Запись.Промт = "", "Устаревшие данные не очищены.");
		ПослеОчистки = AI_ПубличныйAPI.НачатьВыполнение(Параметры);
		Проверить(ПослеОчистки.ИдентификаторОперации = Повтор.ИдентификаторОперации
			И ПослеОчистки.ПовторныйВызов, "Очистка нарушила идемпотентность.");
		Константы.AI_КоличествоПотоковОбработкиОчереди.Установить(ИсходныйЛимит);
		Константы.AI_СрокХраненияОперацийДней.Установить(ИсходныйСрок);
		Возврат "OK|queue|slots,cancel,fencing,recovery,outbox,retries,retention";
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Константы.AI_КоличествоПотоковОбработкиОчереди.Установить(ИсходныйЛимит);
		Константы.AI_СрокХраненияОперацийДней.Установить(ИсходныйСрок);
		Возврат "ERROR|" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьТестовыеДанные(Результаты)

	Провайдер = ОбеспечитьПровайдера();
	Профиль = ОбеспечитьПрофильДоступа();
	Агент = ОбеспечитьАгента(Профиль);
	КоличествоКонтрагентов = ОбеспечитьКонтрагентов();

	Константы.AI_ЛогироватьЗапросы.Установить(Истина);
	Константы.AI_ТаймаутЗапросаМоделиСекунд.Установить(15);
	Константы.AI_СрокХраненияДиалоговДней.Установить(30);
	Константы.AI_СрокХраненияЖурналаЗапросовДней.Установить(30);

	Проверить(ЗначениеЗаполнено(Провайдер), "Не создан тестовый провайдер.");
	Проверить(ЗначениеЗаполнено(Профиль), "Не создан профиль доступа.");
	Проверить(ЗначениеЗаполнено(Агент), "Не создан тестовый агент.");
	Проверить(КоличествоКонтрагентов = 37, "Создано неверное количество контрагентов.");
	ДобавитьРезультат(
		Результаты,
		"seed",
		Истина,
		"Провайдер, профиль, агент и 37 контрагентов подготовлены.");

КонецПроцедуры

Функция ОбеспечитьПровайдера()

	Ссылка = Справочники.AI_Провайдеры.НайтиПоКоду("ATPROV001", Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.AI_Провайдеры.СоздатьЭлемент();
		Объект.Код = "ATPROV001";
	КонецЕсли;

	Объект.Наименование = "Mock LLM Autotest";
	Объект.ТипПровайдера = Перечисления.AI_ТипПровайдера.OpenAIСовместимый;
	Объект.Активен = Истина;
	Объект.APIКлюч = Новый ХранилищеЗначения("mock-token");
	Объект.МаксКоличествоПотоков = 2;
	Объект.ЛимитRPM = 1000;
	Объект.ЛимитТокеновВСутки = 1000000;
	Объект.ТаймаутСек = 15;
	Объект.АдресаСервисов.Очистить();

	Адрес = Объект.АдресаСервисов.Добавить();
	Адрес.Тип = Перечисления.AI_ТипAPI.Responses;
	Адрес.БазовыйURL = "http://127.0.0.1:18081/";
	Адрес.Описание = "Local deterministic Responses mock";

	Адрес = Объект.АдресаСервисов.Добавить();
	Адрес.Тип = Перечисления.AI_ТипAPI.ChatCompletions;
	Адрес.БазовыйURL = "http://127.0.0.1:18081/";
	Адрес.Описание = "Local deterministic Chat Completions mock";

	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

