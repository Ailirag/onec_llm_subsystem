&НаКлиенте
Процедура ЗвуковоеСопровождение() Экспорт
	Если Элементы.ЗвуковоеОповещение.Пометка Тогда
		ГовориКлиент("Выполнено");
	Иначе
		ВыделенныйТекст = Элементы.ПроизвольныйКод.ВыделенныйТекст;
		ТекстВыполнения = ?(ЗначениеЗаполнено(ВыделенныйТекст), ВыделенныйТекст, ПроизвольныйКод.ПолучитьТекст());
		НачалоВхождения = СтрНайти(ТекстВыполнения, "говори(");
		Если НачалоВхождения Тогда
			КонецВхождения = СтрНайти(ТекстВыполнения, """);",, НачалоВхождения);
			ТекстОзвучки = Сред(ТекстВыполнения, НачалоВхождения + 7, КонецВхождения - НачалоВхождения - 7);
			ГовориКлиент(ТекстОзвучки);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

