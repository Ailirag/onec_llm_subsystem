{"#",fc01b5df-97fe-449b-83d4-218a090e681e,547be083-e67f-493b-958c-fc4f6eb49b34},
{"B",0},
{"S","Модель = СсылкаПоНавигации(""e1cib/data/Справочник.МоделиТМЦ?ref=aaf9a5173c99c0cc44a458209070b435"");

