КонецФункции

// Запускает агентский запрос в фоне и сразу возвращает идентификатор операции.
// В фон передается только UUID: все параметры уже сохранены в регистре.
Функция НачатьОперациюВнутренне(ПараметрыОперации, СоздаватьДиалог)

	ЗапуститьНемедленно = ПолучитьСвойство(ПараметрыОперации, "ЗапуститьНемедленно", Истина);
	Если ТранзакцияАктивна() И (СоздаватьДиалог Или ЗапуститьНемедленно) Тогда
		ВызватьИсключение "В транзакции допустима только отложенная прикладная операция.";
	КонецЕсли;
	Провайдер = ПолучитьСвойство(ПараметрыОперации, "Провайдер", Справочники.AI_Провайдеры.ПустаяСсылка());
	Модель = ПолучитьСвойство(ПараметрыОперации, "Модель", Справочники.AI_Модели.ПустаяСсылка());
	ТипAPI = ПолучитьСвойство(ПараметрыОперации, "ТипAPI", Неопределено);
	Промт = ОбрезатьКраяСтроки(ПолучитьСвойство(ПараметрыОперации, "Промт", ""));
	ИдентификаторПользователя = ИдентификаторТекущегоПользователя();
	Агент = ПолучитьСвойство(
		ПараметрыОперации,
		"Агент",
		Справочники.AI_Агенты.ПустаяСсылка());
	Если Не ЗначениеЗаполнено(Агент) Тогда
		ВызватьИсключение "Укажите агента для запуска операции.";
	КонецЕсли;
	РешениеОДоступе = AI_ДоступКАгентамСервер.ОпределитьДоступ(
		ИдентификаторПользователя,
		Агент);
	Если Не РешениеОДоступе.Разрешен Тогда
		ВызватьИсключение "Нет доступа к агенту: " + РешениеОДоступе.Причина;
	КонецЕсли;

	СистемныйПромт = Строка(ПолучитьСвойство(ПараметрыОперации, "СистемныйПромт", ""));
	Если Не ЗначениеЗаполнено(СистемныйПромт) Тогда
		СистемныйПромт = Строка(Агент.СистемнаяИнструкция);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Провайдер)
		Или Не ЗначениеЗаполнено(Модель)
		Или Не ЗначениеЗаполнено(ТипAPI)
		Или Не ЗначениеЗаполнено(Промт)
		Или Не ЗначениеЗаполнено(СистемныйПромт) Тогда
		ВызватьИсключение "Заполните провайдера, модель, тип API, системную инструкцию и сообщение.";
	КонецЕсли;

	КодСценария = ОбрезатьКраяСтроки(ПолучитьСвойство(ПараметрыОперации, "КодСценария", ""));
	ИдемпотентныйКлюч = ОбрезатьКраяСтроки(ПолучитьСвойство(ПараметрыОперации, "ИдемпотентныйКлюч", ""));
	ИдентификаторКорреляции = ПолучитьСвойство(
		ПараметрыОперации,
		"ИдентификаторКорреляции",
		Неопределено);
	Если Не ЗначениеЗаполнено(ИдентификаторКорреляции) Тогда
		ИдентификаторКорреляции = Новый УникальныйИдентификатор;
	КонецЕсли;
	Источник = ПолучитьСвойство(ПараметрыОперации, "Источник", Неопределено);
	ТипИсточника = ОбрезатьКраяСтроки(ПолучитьСвойство(ПараметрыОперации, "ТипИсточника", ""));
	Если Не ЗначениеЗаполнено(ТипИсточника) И ЗначениеЗаполнено(Источник) Тогда
		ТипИсточника = Строка(ТипЗнч(Источник));
	КонецЕсли;
	КлючИсточника = Строка(ПолучитьСвойство(ПараметрыОперации, "КлючИсточника", ""));
	Если Не ЗначениеЗаполнено(КлючИсточника) И ЗначениеЗаполнено(Источник) Тогда
		Попытка
			КлючИсточника = Строка(Источник.УникальныйИдентификатор());
		Исключение
			// Для нессылочных источников ключ задается вызывающим кодом.
		КонецПопытки;
	КонецЕсли;
	ПредставлениеИсточника = Строка(ПолучитьСвойство(ПараметрыОперации, "ПредставлениеИсточника", ""));
	Если Не ЗначениеЗаполнено(ПредставлениеИсточника) И ЗначениеЗаполнено(Источник) Тогда
		ПредставлениеИсточника = Лев(Строка(Источник), 250);
	КонецЕсли;
	ВерсияКонтекста = ПолучитьСвойство(ПараметрыОперации, "ВерсияКонтекста", 1);
	КонтекстJSON = ПроверитьКонтекстJSON(
		Строка(ПолучитьСвойство(ПараметрыОперации, "КонтекстJSON", "")),
		ВерсияКонтекста);
	Приоритет = ПолучитьСвойство(ПараметрыОперации, "Приоритет", 0);

	Если Не СоздаватьДиалог Тогда
		ПроверитьПрикладныеПараметры(
			КодСценария,
			ИдемпотентныйКлюч,
			ТипИсточника,
			ПредставлениеИсточника,
			ВерсияКонтекста,
			Приоритет);
	КонецЕсли;

	ИдентификаторДиалога = ПолучитьСвойство(
		ПараметрыОперации,
		"ИдентификаторДиалога",
		Неопределено);
	Если СоздаватьДиалог Тогда
		НастройкиДиалога = Новый Структура(
			"Провайдер,Модель,Агент,ТипAPI,СистемныйПромт,ДанныеКонтекста,Сценарий,КонтекстJSON,ВерсияКонтекста,ТипИсточника,КлючИсточника,ПредставлениеИсточника,ГлубинаДиалога,ПредыдущийIDОтвета",
			Провайдер,
			Модель,
			Агент,
			ТипAPI,
			СистемныйПромт,
			Строка(ПолучитьСвойство(ПараметрыОперации, "ДанныеКонтекста", "")),
			ПолучитьСвойство(ПараметрыОперации, "Сценарий", Справочники.AI_Сценарии.ПустаяСсылка()),
			КонтекстJSON,
			ВерсияКонтекста,
			ТипИсточника,
			КлючИсточника,
			ПредставлениеИсточника,
			ПолучитьСвойство(ПараметрыОперации, "ГлубинаДиалога", 20),
			Строка(ПолучитьСвойство(ПараметрыОперации, "ПредыдущийIDОтвета", "")));
		Если Не ЗначениеЗаполнено(ИдентификаторДиалога) Тогда
			ИдентификаторДиалога = AI_ДиалогиКлиентСервер.СоздатьДиалог(НастройкиДиалога);
		Иначе
			AI_ДиалогиКлиентСервер.ПроверитьДоступКИзменению(ИдентификаторДиалога);
			AI_ДиалогиКлиентСервер.ОбновитьНастройки(ИдентификаторДиалога, НастройкиДиалога);
		КонецЕсли;

		АктивнаяОперация = НайтиАктивнуюОперацию(
			ИдентификаторДиалога,
			ИдентификаторПользователя);
		Если ЗначениеЗаполнено(АктивнаяОперация) Тогда
			ВызватьИсключение "В этом диалоге уже выполняется запрос. Дождитесь его завершения или отмените.";
		КонецЕсли;
	Иначе
		// UUID сохраняется как технический ключ операции и не создает запись диалога.
		ИдентификаторДиалога = Новый УникальныйИдентификатор;
	КонецЕсли;

	ИдентификаторОперации = Новый УникальныйИдентификатор;
	ИдентификаторСообщения = Новый УникальныйИдентификатор;
	Вложения = ПолучитьСвойство(ПараметрыОперации, "Вложения", Новый Массив);
	ТекущийМомент = ТекущаяДатаСеанса();
	НачатьТранзакцию();
	Попытка
		Если Не СоздаватьДиалог И ЗначениеЗаполнено(ИдемпотентныйКлюч) Тогда
			ЗаблокироватьИдемпотентныйКлюч(
				ИдентификаторПользователя,
				КодСценария,
				ИдемпотентныйКлюч);
			ИдентификаторСуществующейОперации = НайтиОперациюПоИдемпотентномуКлючу(
				ИдентификаторПользователя,
				КодСценария,
				ИдемпотентныйКлюч);
			Если ЗначениеЗаполнено(ИдентификаторСуществующейОперации) Тогда
				ДанныеСуществующейОперации = ПолучитьДанныеОперации(ИдентификаторСуществующейОперации);
				ЗафиксироватьТранзакцию();
				Возврат СформироватьРезультатЗапуска(
					ИдентификаторСуществующейОперации,
					ДанныеСуществующейОперации.ИдентификаторДиалога,
					ДанныеСуществующейОперации.ИдентификаторКорреляции,
					Истина);
			КонецЕсли;
		КонецЕсли;

		Запись = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторОперации = ИдентификаторОперации;
		Запись.ИдентификаторДиалога = ИдентификаторДиалога;
		Запись.ИдентификаторСообщения = ИдентификаторСообщения;
		Запись.ИдентификаторПользователя = ИдентификаторПользователя;
		Запись.ДатаСоздания = ТекущийМомент;
		Запись.ДатаИзменения = ТекущийМомент;
		Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.ВОчереди;
		Запись.ТекущийЭтап = "Ожидание фонового задания";
		Запись.Провайдер = Провайдер;
		Запись.Модель = Модель;
		Запись.Агент = Агент;
		Запись.ПрофильДоступаКДанным = РешениеОДоступе.ПрофильДоступаКДанным;
		Запись.ТипAPI = ТипAPI;
		Запись.Промт = Промт;
		Запись.ТемператураМодели = ?(СоздаватьДиалог, 0.3, Агент.Температура);
		Запись.МаксТокеновМодели = ?(СоздаватьДиалог Или Агент.МаксТокенов <= 0, 50000, Агент.МаксТокенов);
		Запись.ХешСистемногоПромта = ПолучитьHexСтрокуИзДвоичныхДанных(
			OPI_Криптография.Хеш(ПолучитьДвоичныеДанныеИзСтроки(СистемныйПромт), ХешФункция.SHA256));
		Запись.СистемныйПромт = СистемныйПромт;
		Запись.ДанныеКонтекста = Строка(ПолучитьСвойство(ПараметрыОперации, "ДанныеКонтекста", ""));
		Запись.РежимДиалога = СоздаватьДиалог
			И ПолучитьСвойство(ПараметрыОперации, "РежимДиалога", Истина);
		Запись.ГлубинаДиалога = ПолучитьСвойство(ПараметрыОперации, "ГлубинаДиалога", 20);
		Запись.ПредыдущийIDОтвета = Строка(ПолучитьСвойство(ПараметрыОперации, "ПредыдущийIDОтвета", ""));
		Запись.КодСценария = КодСценария;
		Запись.ВерсияКонтракта = ПолучитьСвойство(ПараметрыОперации, "ВерсияКонтракта", 0);
		Запись.СхемаОтветаJSON = ПолучитьСвойство(ПараметрыОперации, "СхемаОтветаJSON", "");
		Запись.КодОбработчика = ПолучитьСвойство(ПараметрыОперации, "КодОбработчика", "");
		Если ЗначениеЗаполнено(Запись.СхемаОтветаJSON) Тогда
			AI_КонтрактыОпераций.ПроверитьСхему(Запись.СхемаОтветаJSON);
		КонецЕсли;
		Запись.ИдентификаторКорреляции = ИдентификаторКорреляции;
		Запись.ИдемпотентныйКлюч = ИдемпотентныйКлюч;
		Запись.ТипИсточника = ТипИсточника;
		Запись.КлючИсточника = КлючИсточника;
		Запись.ПредставлениеИсточника = ПредставлениеИсточника;
		Запись.ВерсияКонтекста = ВерсияКонтекста;
		Запись.КонтекстJSON = КонтекстJSON;
		Запись.Приоритет = Приоритет;
		Запись.РазрешитьПовтор = ПолучитьСвойство(ПараметрыОперации, "РазрешитьПовтор", Ложь);
		Запись.МаксимумПопыток = ПолучитьСвойство(ПараметрыОперации, "МаксимумПопыток", 1);
		Если Запись.МаксимумПопыток < 1 Или Запись.МаксимумПопыток > 10 Тогда
			ВызватьИсключение "Максимум попыток должен быть от 1 до 10.";
		КонецЕсли;
		Запись.ОтменаЗапрошена = Ложь;
		Запись.Версия = 1;
		Запись.ПоследнийНомерШага = 0;
		Запись.КоличествоВложений = AI_Вложения.ПривязатьКОперации(
			ИдентификаторОперации,
			ИдентификаторДиалога,
			ИдентификаторСообщения,
			Вложения);
		Запись.Записать();
		Если Не СоздаватьДиалог И ЗначениеЗаполнено(ИдемпотентныйКлюч) Тогда
			ЗаписатьИдемпотентныйКлюч(
				ИдентификаторПользователя,
				КодСценария,
				ИдемпотентныйКлюч,
				ИдентификаторОперации,
				ТекущийМомент);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если ЗапуститьНемедленно Тогда
		AI_ДиспетчерОпераций.ОбработатьОчередь();
	КонецЕсли;

	Возврат СформироватьРезультатЗапуска(
		ИдентификаторОперации,
		ИдентификаторДиалога,
		ИдентификаторКорреляции,
		Ложь);

