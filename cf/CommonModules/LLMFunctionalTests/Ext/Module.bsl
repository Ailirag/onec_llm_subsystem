		ДобавитьОшибкуТеста(Результаты, "fixtures");
	КонецПопытки;

КонецПроцедуры

Процедура ТестЗагрузкиМоделей(Результаты)

	Попытка
		Фикстуры = ПолучитьФикстуры();
		Доступные = Справочники.AI_Провайдеры.ПолучитьДоступныеМодели(Фикстуры.Провайдер);
		Проверить(Доступные.Модели.Количество() = 3, "Mock API должен вернуть три модели.");
		Коды = Новый Массив;
		Коды.Добавить("mock-responses");
		Коды.Добавить("mock-chat");
		Коды.Добавить("mock-agent");
		Загрузка = Справочники.AI_Провайдеры.ЗагрузитьВыбранныеМодели(
			Фикстуры.Провайдер,
			Коды);
		Проверить(Загрузка.Получено = 3, "Загружены не все выбранные модели.");
		Модель = НайтиМодель(Фикстуры.Провайдер, "mock-agent");
		Проверить(ЗначениеЗаполнено(Модель), "Модель mock-agent не создана.");
