
Функция ЗаписатьОценку(ИдентификаторОперации, Решение, Комментарий = "", ИсправленныйОтвет = "", ИдентификаторОценки = Неопределено) Экспорт
	Если Решение <> "Принято" И Решение <> "Отклонено" И Решение <> "Исправлено" Тогда
		ВызватьИсключение "Решение должно быть: Принято, Отклонено или Исправлено.";
	КонецЕсли;
	Если ТипЗнч(Комментарий) <> Тип("Строка") Или ТипЗнч(ИсправленныйОтвет) <> Тип("Строка") Тогда
		ВызватьИсключение "Комментарий и исправленный ответ должны быть строками.";
	КонецЕсли;
	Если СтрДлина(Комментарий) > 10000 Или СтрДлина(ИсправленныйОтвет) > 1000000 Тогда
		ВызватьИсключение "Превышен размер обратной связи.";
	КонецЕсли;
	Если Решение = "Исправлено" И Не ЗначениеЗаполнено(ИсправленныйОтвет) Тогда
		ВызватьИсключение "Укажите исправленный ответ.";
	КонецЕсли;
	Если ИдентификаторОценки = Неопределено Тогда
		ИдентификаторОценки = Новый УникальныйИдентификатор;
	КонецЕсли;
	Если ТипЗнч(ИдентификаторОценки) <> Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение "Идентификатор оценки должен быть UUID.";
	КонецЕсли;
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		AI_ДиспетчерОпераций.ЗаблокироватьОчередь();
		Операция = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
		Операция.ИдентификаторОперации = ИдентификаторОперации;
		Операция.Прочитать();
		Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
		Если Не Операция.Выбран() Или Операция.ИдентификаторПользователя <> Пользователь Тогда
			ВызватьИсключение "Операция недоступна текущему пользователю.";
		КонецЕсли;
		Если Операция.Статус <> Перечисления.AI_СтатусАгентскойОперации.Завершена Или Операция.ДанныеОчищены Тогда
			ВызватьИсключение "Оценить можно только сохраненный успешный результат.";
		КонецЕсли;
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.AI_ОценкиРезультатов");
		Элемент.УстановитьЗначение("ИдентификаторОценки", ИдентификаторОценки);
		Блокировка.Заблокировать();
		Оценка = РегистрыСведений.AI_ОценкиРезультатов.СоздатьМенеджерЗаписи();
		Оценка.ИдентификаторОценки = ИдентификаторОценки;
		Оценка.Прочитать();
		Если Оценка.Выбран() Тогда
			Если Оценка.ИдентификаторПользователя <> Пользователь Или Оценка.ИдентификаторОперации <> ИдентификаторОперации
				Или Оценка.Решение <> Решение Или Оценка.Комментарий <> Комментарий Или Оценка.ИсправленныйОтвет <> ИсправленныйОтвет Тогда
				ВызватьИсключение "Идентификатор оценки уже использован для других данных.";
			КонецЕсли;
		Иначе
			Оценка.ИдентификаторОценки = ИдентификаторОценки;
			Оценка.ИдентификаторОперации = ИдентификаторОперации;
			Оценка.ИдентификаторПользователя = Пользователь;
			Оценка.ДатаОценки = ТекущаяДатаСеанса();
			Оценка.Решение = Решение;
			Оценка.Комментарий = Комментарий;
			Оценка.ИсправленныйОтвет = ИсправленныйОтвет;
			Оценка.ОтветМодели = Операция.Результат;
			Оценка.КодСценария = Операция.КодСценария;
			Оценка.ВерсияКонтракта = Операция.ВерсияКонтракта;
			Оценка.Агент = Операция.Агент;
			Оценка.Модель = Операция.Модель;
			Оценка.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат ИдентификаторОценки;
КонецФункции

Функция ПолучитьСтатистику() Экспорт
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Статус, КОЛИЧЕСТВО(*) КАК Количество,
			| СУММА(ВходящиеТокены + ВходящиеТокеныВложений) КАК ВходящиеТокены,
			| СУММА(ВыходящиеТокены + ВыходящиеТокеныВложений) КАК ВыходящиеТокены,
			| СУММА(ВЫБОР КОГДА СтатусДоставки = ""Ошибка"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК ОшибокДоставки,
			| ЕСТЬNULL(СРЕДНЕЕ(ВЫБОР КОГДА ДатаПервогоЗапуска > &ПустаяДата
			| ТОГДА РАЗНОСТЬДАТ(ДатаСоздания, ДатаПервогоЗапуска, СЕКУНДА) ИНАЧЕ NULL КОНЕЦ), 0) КАК ОжиданиеСекунд
			|ИЗ РегистрСведений.AI_АгентскиеОперации
			|ГДЕ ИдентификаторПользователя = &Пользователь
			|СГРУППИРОВАТЬ ПО Статус");
		Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
		Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
		Выборка = Запрос.Выполнить().Выбрать();
		Результат = Новый Массив;
		Пока Выборка.Следующий() Цикл
			СтрокаСтатистики = Новый Структура("Статус,Количество,ВходящиеТокены,ВыходящиеТокены,ОшибокДоставки,ОжиданиеСекунд");
			ЗаполнитьЗначенияСвойств(СтрокаСтатистики, Выборка);
			Результат.Добавить(СтрокаСтатистики);
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Результат;
КонецФункции

Процедура ОчиститьТекстыОценок() Экспорт
	Дней = Константы.AI_СрокХраненияОценокДней.Получить();
	Если Дней <= 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 100 ИдентификаторОценки
		|ИЗ РегистрСведений.AI_ОценкиРезультатов
		|ГДЕ ИдентификаторПользователя = &Пользователь И НЕ ДанныеОчищены И ДатаОценки < &Граница");
	Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - Дней * 86400);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить("РегистрСведений.AI_ОценкиРезультатов");
			Элемент.УстановитьЗначение("ИдентификаторОценки", Выборка.ИдентификаторОценки);
			Блокировка.Заблокировать();
			Запись = РегистрыСведений.AI_ОценкиРезультатов.СоздатьМенеджерЗаписи();
			Запись.ИдентификаторОценки = Выборка.ИдентификаторОценки;
			Запись.Прочитать();
			Запись.Комментарий = "";
			Запись.ОтветМодели = "";
			Запись.ИсправленныйОтвет = "";
			Запись.ДанныеОчищены = Истина;
			Запись.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьОшибкиДоставки() Экспорт
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 100 ИдентификаторОперации, КодСценария, ОшибкаДоставки, ДатаЗавершения
			|ИЗ РегистрСведений.AI_АгентскиеОперации
			|ГДЕ ИдентификаторПользователя = &Пользователь И СтатусДоставки = ""Ошибка""
			|УПОРЯДОЧИТЬ ПО ДатаЗавершения УБЫВ");
		Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
		Выборка = Запрос.Выполнить().Выбрать();
		Результат = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ОшибкаДоставки = Новый Структура("ИдентификаторОперации,КодСценария,ОшибкаДоставки,ДатаЗавершения");
			ЗаполнитьЗначенияСвойств(ОшибкаДоставки, Выборка);
			Результат.Добавить(ОшибкаДоставки);
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Результат;
КонецФункции

Функция ПолучитьПоследниеОперации() Экспорт
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 100 ИдентификаторОперации, ДатаСоздания, ДатаЗавершения, КодСценария,
			| Статус, Результат, ТекстОшибки, СтатусДоставки, ОшибкаДоставки,
			| ВходящиеТокены + ВходящиеТокеныВложений КАК ВходящиеТокены,
			| ВыходящиеТокены + ВыходящиеТокеныВложений КАК ВыходящиеТокены
			|ИЗ РегистрСведений.AI_АгентскиеОперации
			|ГДЕ ИдентификаторПользователя = &Пользователь И КодСценария <> """"
			|УПОРЯДОЧИТЬ ПО ДатаСоздания УБЫВ");
		Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
		Результат = Запрос.Выполнить().Выгрузить();
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Результат;
КонецФункции
