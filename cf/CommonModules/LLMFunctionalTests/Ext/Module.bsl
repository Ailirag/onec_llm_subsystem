	Объект.ДоступГрупп.Очистить();
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ОбеспечитьКонтрагентов()

	Для Номер = 1 По 37 Цикл
		Суффикс = ?(Номер < 10, "0", "") + Строка(Номер);
		Код = "AT" + Прав("0000000" + Строка(Номер), 7);
		Ссылка = Справочники.Контрагенты.НайтиПоКоду(Код, Истина);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Объект = Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники.Контрагенты.СоздатьЭлемент();
			Объект.Код = Код;
		КонецЕсли;
		Объект.Наименование = "AT Компания " + Суффикс;
		Объект.Адрес = "г. Тестоград, ул. Проверочная, д. " + Строка(Номер);
		Если Номер = 37 Тогда
			Объект.Адрес = Объект.Адрес
				+ ", самый длинный тестовый адрес корпус корпус корпус корпус корпус корпус корпус корпус";
		КонецЕсли;
		Объект.ИНН = "7700000" + Прав("00" + Строка(Номер), 2);
		Объект.КПП = "770001001";
		Объект.ОГРН = "100000000" + Прав("0000" + Строка(Номер), 4);
		Объект.ОбластьДеятельностьКомпании =
			?(Номер % 2 = 0, "Производство тестовых данных", "Интеграционное тестирование");
		Объект.Комментарий = "AUTOTEST fixture " + Суффикс;
		Объект.Записать();
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Код ПОДОБНО ""AT%""");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

Процедура ВыполнитьДымовыеТесты(Результаты)

	ТестФикстур(Результаты);
	ТестИнтерфейсныхСценариев(Результаты);
	ТестИзвлеченияРеквизитов(Результаты);
	ТестДействийСРезультатом(Результаты);
	ТестМастераДействия(Результаты);
	ТестМаршрутаИДанныхОбъекта(Результаты);
	ТестЭтаповИАдаптера(Результаты);
	ТестПакетаСценария(Результаты);
	ОчиститьЖурналMockПровайдера();
	ТестЗагрузкиМоделей(Результаты);
	ТестМетаданныхИЗапросов(Результаты);
	ТестResponsesAPI(Результаты);
	ТестChatCompletionsAPI(Результаты);
	ТестОбработкиОшибкиAPI(Результаты);
	ТестВложенийAPI(Результаты);
	ТестАгентскогоЦикла(Результаты);
	ТестИзоляцииДиалогов(Результаты);
	ТестЖурналированияТокенов(Результаты);

КонецПроцедуры

Процедура ТестИнтерфейсныхСценариев(Результаты)

	Этап = "получение фикстур";
	Попытка
		Фикстуры = ПолучитьФикстуры();
		Модель = ОбеспечитьМодельАгента(Фикстуры.Провайдер);
		Проверить(ЗначениеЗаполнено(Модель), "Модель mock-agent не найдена.");

		Этап = "подготовка сценария";
		СсылкаСценария = Справочники.AI_Сценарии.НайтиПоКоду("ATUI00001");
		Если ЗначениеЗаполнено(СсылкаСценария) Тогда
			Сценарий = СсылкаСценария.ПолучитьОбъект();
		Иначе
			Сценарий = Справочники.AI_Сценарии.СоздатьЭлемент();
			Сценарий.Код = "ATUI00001";
		КонецЕсли;
		Сценарий.Наименование = "Autotest UI integration";
		Сценарий.Активен = Истина;
		Сценарий.ВерсияКонтракта = 1;
		Сценарий.МаксимумПопыток = 1;
		Сценарий.Агент = Фикстуры.Агент;
		Сценарий.Провайдер = Фикстуры.Провайдер;
		Сценарий.Модель = Модель;
		Сценарий.ТипAPI = Перечисления.AI_ТипAPI.Responses;
		Сценарий.СхемаОтветаJSON = "";
		Сценарий.КодОбработчика = "";
		Сценарий.Записать();

		Этап = "подготовка места запуска";
		СсылкаМеста = Справочники.AI_МестаЗапускаСценариев.НайтиПоКоду("ATUI00001");
		Если ЗначениеЗаполнено(СсылкаМеста) Тогда
			Место = СсылкаМеста.ПолучитьОбъект();
		Иначе
			Место = Справочники.AI_МестаЗапускаСценариев.СоздатьЭлемент();
			Место.Код = "ATUI00001";
		КонецЕсли;
		Место.Наименование = "Проверить контрагента";
		Место.Активно = Истина;
		Место.Сценарий = Сценарий.Ссылка;
		Место.ТипМеста = "Объект";
		Место.ПолноеИмяМетаданных = "Справочник.Контрагенты";
		Место.ПредставлениеКоманды = "Проверить контрагента";
		Место.Описание = "Сценарий серверного автотеста универсального запуска.";
		Место.НачальныйЗапрос = "Проверь выбранного контрагента";
		Место.Порядок = 10;
		Место.РазрешитьНесколькоОбъектов = Ложь;
		Место.Записать();

		Этап = "формирование контекста";
		Контрагент = Справочники.Контрагенты.НайтиПоКоду("AT0000001", Истина);
		Проверить(ЗначениеЗаполнено(Контрагент), "Тестовый контрагент AT0000001 не найден.");
		Контекст = AI_ИнтерфейсныеСценарии.СформироватьКонтекст(Контрагент, "Объект");
		Проверить(Контекст.ПолноеИмяМетаданных = "Справочник.Контрагенты",
			"Контекст потерял полное имя метаданных.");
		Проверить(Контекст.КлючИсточника = Строка(Контрагент.УникальныйИдентификатор()),
			"Контекст потерял ключ прикладного объекта.");
		СтруктураКонтекста = OPI_Инструменты.JsonВСтруктуру(Контекст.КонтекстJSON, Истина);
		Проверить(СтруктураКонтекста.Получить("version") = 1,
			"Контекст JSON не содержит версию контракта.");

		Этап = "получение доступных сценариев";
		ДоступныеСценарии = AI_ИнтерфейсныеСценарии.ПолучитьДоступныеСценарии(Контекст);
		СтрокиМеста = ДоступныеСценарии.НайтиСтроки(Новый Структура("МестоЗапуска", Место.Ссылка));
		Проверить(СтрокиМеста.Количество() = 1,
			"Зарегистрированное действие не найдено для прикладного объекта.");

		Этап = "глобальное действие вне карточки";
		// Глобальное действие ничего не знает о документе и ничего в него не
		// запишет: в карточке оно только путает, его место — без объекта.
		СсылкаГлобального = Справочники.AI_МестаЗапускаСценариев.НайтиПоКоду("ATUI00002");
		Если ЗначениеЗаполнено(СсылкаГлобального) Тогда
			Глобальное = СсылкаГлобального.ПолучитьОбъект();
		Иначе
			Глобальное = Справочники.AI_МестаЗапускаСценариев.СоздатьЭлемент();
			Глобальное.Код = "ATUI00002";
		КонецЕсли;
		Глобальное.Наименование = "Спросить без объекта";
		Глобальное.Активно = Истина;
		Глобальное.Сценарий = Сценарий.Ссылка;
		Глобальное.ТипМеста = "Глобально";
		Глобальное.ПредставлениеКоманды = "Спросить без объекта";
		Глобальное.НачальныйЗапрос = "Ответь на вопрос";
		Глобальное.Записать();
		ВКарточке = AI_ИнтерфейсныеСценарии.ПолучитьДоступныеСценарии(Контекст);
		Проверить(ВКарточке.НайтиСтроки(
				Новый Структура("МестоЗапуска", Глобальное.Ссылка)).Количество() = 0,
			"Глобальное действие не должно предлагаться в карточке объекта.");
		БезОбъекта = AI_ИнтерфейсныеСценарии.ПолучитьДоступныеСценарии(
			AI_ИнтерфейсныеСценарии.СформироватьКонтекст(Неопределено));
		Проверить(БезОбъекта.НайтиСтроки(
				Новый Структура("МестоЗапуска", Глобальное.Ссылка)).Количество() = 1,
			"Глобальное действие должно предлагаться без прикладного объекта.");
		Глобальное.Активно = Ложь;
		Глобальное.Записать();

		Этап = "подготовка параметров диалога";
		ПараметрыДиалога = AI_ИнтерфейсныеСценарии.ПодготовитьПараметрыДиалога(
			Место.Ссылка,
			Контекст);
		Проверить(ПараметрыДиалога.Сценарий = Сценарий.Ссылка,
			"Параметры диалога потеряли сценарий.");
		Проверить(ПараметрыДиалога.НачальныйЗапрос = Место.НачальныйЗапрос,
			"Не применен начальный запрос места запуска.");

		Этап = "сохранение контекста диалога";
		НастройкиДиалога = Новый Структура;
		Для Каждого Имя Из СтрРазделить(
			"Сценарий,КонтекстJSON,ВерсияКонтекста,ТипИсточника,КлючИсточника,ПредставлениеИсточника,ДанныеКонтекста",
			",") Цикл
			НастройкиДиалога.Вставить(Имя, ПараметрыДиалога[Имя]);
		КонецЦикла;
		НастройкиДиалога.Вставить("Провайдер", Сценарий.Провайдер);
		НастройкиДиалога.Вставить("Модель", Сценарий.Модель);
		НастройкиДиалога.Вставить("Агент", Сценарий.Агент);
		НастройкиДиалога.Вставить("ТипAPI", Сценарий.ТипAPI);
		ИдентификаторДиалога = AI_ДиалогиКлиентСервер.СоздатьДиалог(НастройкиДиалога);
		СохраненныеНастройки = AI_ДиалогиКлиентСервер.ПолучитьНастройки(ИдентификаторДиалога);
		Проверить(СохраненныеНастройки.Сценарий = Сценарий.Ссылка
			И СохраненныеНастройки.КлючИсточника = Контекст.КлючИсточника
			И СохраненныеНастройки.КонтекстJSON = Контекст.КонтекстJSON,
			"Заголовок диалога не сохранил сценарий и источник запуска.");
		AI_ДиалогиКлиентСервер.УстановитьАрхив(ИдентификаторДиалога, Истина);

		Этап = "фильтрация множественного выбора";
		НесколькоОбъектов = Новый Массив;
		НесколькоОбъектов.Добавить(Контрагент);
		НесколькоОбъектов.Добавить(Контрагент);
		КонтекстНескольких = AI_ИнтерфейсныеСценарии.СформироватьКонтекст(
			НесколькоОбъектов,
			"Объект");
		ДоступныеДляНескольких = AI_ИнтерфейсныеСценарии.ПолучитьДоступныеСценарии(
			КонтекстНескольких);
		СтрокиМеста = ДоступныеДляНескольких.НайтиСтроки(Новый Структура("МестоЗапуска", Место.Ссылка));
		Проверить(СтрокиМеста.Количество() = 0,
			"Одиночный сценарий доступен для нескольких объектов.");

		ДобавитьРезультат(
			Результаты,
			"universal_ui_integration",
			Истина,
			"Контекст, фильтрация сценариев и сохранение беседы работают.");
	Исключение
		ДобавитьРезультат(
			Результаты,
			"universal_ui_integration",
			Ложь,
			Этап + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Проверяет универсальный механизм извлечения: карту соответствий, вывод схемы
// ответа из нее, перенос схемы в сценарий, доп. отборы места запуска, варианты
// уточнения и разбор ответа модели по карте.
Процедура ТестИзвлеченияРеквизитов(Результаты)

	Этап = "подготовка карты";
	Попытка
		СсылкаКарты = Справочники.AI_КартыИзвлечения.НайтиПоКоду("ATMAP0001");
		Если ЗначениеЗаполнено(СсылкаКарты) Тогда
			Карта = СсылкаКарты.ПолучитьОбъект();
		Иначе
			Карта = Справочники.AI_КартыИзвлечения.СоздатьЭлемент();
			Карта.Код = "ATMAP0001";
		КонецЕсли;
		Карта.Наименование = "Autotest карта извлечения";
		Карта.Активна = Истина;
		Карта.ПолноеИмяМетаданных = "Справочник.Контрагенты";
		Карта.Поля.Очистить();

		ПолеСуммы = Карта.Поля.Добавить();
		ПолеСуммы.Ключ = "amount";
		ПолеСуммы.Представление = "Сумма";
		ПолеСуммы.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Число;
		ПолеСуммы.ПутьРеквизита = "Сумма";
		ПолеСуммы.Обязательное = Истина;

		ПолеДаты = Карта.Поля.Добавить();
		ПолеДаты.Ключ = "start_date";
		ПолеДаты.Представление = "Дата начала";
		ПолеДаты.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Дата;
		ПолеДаты.ПутьРеквизита = "ДатаНачала";

		ПолеФлага = Карта.Поля.Добавить();
		ПолеФлага.Ключ = "perpetual";
		ПолеФлага.Представление = "Бессрочный";
		ПолеФлага.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Булево;
		ПолеФлага.ПутьРеквизита = "Бессрочный";

		ПолеСсылки = Карта.Поля.Добавить();
		ПолеСсылки.Ключ = "counterparty";
		ПолеСсылки.Представление = "Контрагент";
		ПолеСсылки.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Ссылка;
		ПолеСсылки.ТипСсылки = "Справочник.Контрагенты";
		ПолеСсылки.ПоискПоНаименованию = Истина;
		ПолеСсылки.ПутьРеквизита = "Контрагент";
		Карта.Записать();

		Этап = "схема ответа из карты";
		Схема = AI_ИзвлечениеРеквизитов.СформироватьСхемуОтвета(Карта.Ссылка);
		СтруктураСхемы = OPI_Инструменты.JsonВСтруктуру(Схема, Истина);
		Проверить(СтруктураСхемы.Получить("type") = "object",
			"Корнем схемы должен быть object.");
		Свойства = СтруктураСхемы.Получить("properties");
		Проверить(Свойства.Количество() = 4, "Схема должна описывать четыре поля.");
		Проверить(Свойства.Получить("amount").Получить("type") = "number",
			"Числовое поле должно иметь тип number.");
		Проверить(Свойства.Получить("perpetual").Получить("type") = "boolean",
			"Логическое поле должно иметь тип boolean.");
		// Контракт операций требует строгую схему: все свойства в required.
		Обязательные = СтруктураСхемы.Получить("required");
		Проверить(Обязательные.Количество() = 4,
			"Строгая схема требует перечислить в required все свойства.");
		Проверить(СтруктураСхемы.Получить("additionalProperties") = Ложь,
			"Схема должна запрещать дополнительные свойства.");

		Этап = "перенос схемы в сценарий";
		Фикстуры = ПолучитьФикстуры();
		СсылкаСценария = Справочники.AI_Сценарии.НайтиПоКоду("ATMAP0001");
		Если ЗначениеЗаполнено(СсылкаСценария) Тогда
			Сценарий = СсылкаСценария.ПолучитьОбъект();
		Иначе
			Сценарий = Справочники.AI_Сценарии.СоздатьЭлемент();
			Сценарий.Код = "ATMAP0001";
		КонецЕсли;
		Сценарий.Наименование = "Autotest извлечение реквизитов";
		Сценарий.Активен = Истина;
		Сценарий.ВерсияКонтракта = 1;
		Сценарий.МаксимумПопыток = 1;
		Сценарий.Агент = Фикстуры.Агент;
		Сценарий.Провайдер = Фикстуры.Провайдер;
		// Сценарий потом служит образцом мастеру: без модели копировать нечего.
		Сценарий.Модель = ОбеспечитьМодельАгента(Фикстуры.Провайдер);
		Сценарий.ТипAPI = Перечисления.AI_ТипAPI.Responses;
		Сценарий.СхемаОтветаJSON = "";
		Сценарий.Записать();

		СсылкаМеста = Справочники.AI_МестаЗапускаСценариев.НайтиПоКоду("ATMAP0001");
		Если ЗначениеЗаполнено(СсылкаМеста) Тогда
			Место = СсылкаМеста.ПолучитьОбъект();
		Иначе
			Место = Справочники.AI_МестаЗапускаСценариев.СоздатьЭлемент();
			Место.Код = "ATMAP0001";
		КонецЕсли;
		Место.Наименование = "Autotest извлечение из карточки";
		Место.Активно = Истина;
		Место.Сценарий = Сценарий.Ссылка;
		Место.КартаИзвлечения = Карта.Ссылка;
		Место.ТипМеста = "Объект";
		Место.ПолноеИмяМетаданных = "Справочник.Контрагенты";
		Место.ПредставлениеКоманды = "Извлечь реквизиты";
		Место.НачальныйЗапрос = "Извлеки реквизиты договора из приложенного файла";
		Место.Уточнения.Очистить();
		Уточнение = Место.Уточнения.Добавить();
		Уточнение.Идентификатор = "source";
		Уточнение.Представление = "Источник данных";
		Уточнение.ВидУточнения = Перечисления.AI_ВидУточнения.ВыборИзСписка;
		Уточнение.ИсточникДанных = "Справочник.Контрагенты";
		Место.ОтборыКонтекста.Очистить();
		Место.Записать();

		Синхронизация = AI_ИзвлечениеРеквизитов.СинхронизироватьСхемуСценариев(Карта.Ссылка);
		Проверить(Синхронизация.Обновлено = 1,
			СтрШаблон("Схема должна быть записана ровно в один сценарий."
					+ " Обновлено: %1, пропущено: %2. Сообщения: %3",
				Синхронизация.Обновлено,
				Синхронизация.Пропущено,
				СтрСоединить(Синхронизация.Сообщения, "; ")));
		Проверить(Сценарий.Ссылка.СхемаОтветаJSON = Схема,
			"В сценарии оказалась не та схема, что выведена из карты.");
		ПовторнаяСинхронизация = AI_ИзвлечениеРеквизитов.СинхронизироватьСхемуСценариев(Карта.Ссылка);
		Проверить(ПовторнаяСинхронизация.Обновлено = 0 И ПовторнаяСинхронизация.Пропущено = 1,
			"Повторный перенос не должен переписывать совпадающую схему.");

		Этап = "длина начального запроса";
		Проверить(Место.Ссылка.НачальныйЗапрос = Место.НачальныйЗапрос,
			"Начальный запрос обрезан при записи — проверьте длину реквизита.");

		Этап = "доп. отборы контекста";
		Контрагент = Справочники.Контрагенты.НайтиПоКоду("AT0000001", Истина);
		Проверить(ЗначениеЗаполнено(Контрагент), "Тестовый контрагент AT0000001 не найден.");
		Контекст = AI_ИнтерфейсныеСценарии.СформироватьКонтекст(Контрагент, "Объект");
		Проверить(AI_ИзвлечениеРеквизитов.ПроверитьОтборыКонтекста(Место.Ссылка, Контекст),
			"Без отборов действие должно быть доступно.");

		Отбор = Место.ОтборыКонтекста.Добавить();
		Отбор.ПутьРеквизита = "Наименование";
		Отбор.ВидСравнения = Перечисления.AI_ВидСравненияОтбора.Равно;
		Отбор.Значение = "заведомо другое наименование";
		Место.Записать();
		Проверить(Не AI_ИзвлечениеРеквизитов.ПроверитьОтборыКонтекста(Место.Ссылка, Контекст),
			"Несовпадающий отбор должен скрывать действие.");
		ДоступныеСМешающимОтбором = AI_ИнтерфейсныеСценарии.ПолучитьДоступныеСценарии(Контекст);
		Проверить(ДоступныеСМешающимОтбором.НайтиСтроки(
				Новый Структура("МестоЗапуска", Место.Ссылка)).Количество() = 0,
			"Отбор не применился при формировании списка действий.");

		Отбор.Значение = Строка(Контрагент);
		Место.Записать();
		Проверить(AI_ИзвлечениеРеквизитов.ПроверитьОтборыКонтекста(Место.Ссылка, Контекст),
			"Совпадающий отбор должен оставлять действие доступным.");

		Этап = "варианты уточнения";
		Варианты = AI_ИзвлечениеРеквизитов.ПолучитьВариантыУточнения(
			Место.Ссылка.Уточнения[0],
			Контекст);
		Проверить(Варианты.Количество() > 0,
			"Уточнение вида ВыборИзСписка не вернуло ни одного варианта.");

		Этап = "разбор ответа по карте";
		ТекстОтвета = "{""amount"":""1 234,50"",""start_date"":""2026-03-01"","
			+ """perpetual"":""да"",""counterparty"":""" + Строка(Контрагент) + """}";
		Разобранное = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(Карта.Ссылка, ТекстОтвета);
		Проверить(Разобранное.Количество() = 4, "Ожидались рекомендации по четырем полям.");
		СтрокиСуммы = Разобранное.НайтиСтроки(Новый Структура("Ключ", "amount"));
		Проверить(СтрокиСуммы[0].Распознано И СтрокиСуммы[0].Значение = 1234.5,
			"Число с пробелом и запятой должно приводиться к 1234.5.");
		СтрокиДаты = Разобранное.НайтиСтроки(Новый Структура("Ключ", "start_date"));
		Проверить(СтрокиДаты[0].Распознано И СтрокиДаты[0].Значение = Дата(2026, 3, 1),
			"Дата в формате ISO должна распознаваться.");
		СтрокиФлага = Разобранное.НайтиСтроки(Новый Структура("Ключ", "perpetual"));
		Проверить(СтрокиФлага[0].Распознано И СтрокиФлага[0].Значение = Истина,
			"Значение «да» должно приводиться к Истина.");
		СтрокиСсылки = Разобранное.НайтиСтроки(Новый Структура("Ключ", "counterparty"));
		Проверить(СтрокиСсылки[0].Распознано И СтрокиСсылки[0].Значение = Контрагент,
			"Ссылка должна находиться по наименованию.");

		Этап = "нераспознанные значения";
		ПлохойОтвет = "{""amount"":""не число"",""counterparty"":""нет такого контрагента""}";
		Плохое = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(Карта.Ссылка, ПлохойОтвет);
		СтрокиПлохойСуммы = Плохое.НайтиСтроки(Новый Структура("Ключ", "amount"));
		Проверить(СтрокиПлохойСуммы.Количество() = 1
				И Не СтрокиПлохойСуммы[0].Распознано
				И ЗначениеЗаполнено(СтрокиПлохойСуммы[0].Комментарий),
			"Нераспознанное число должно помечаться с причиной, а не теряться.");

		Этап = "пустой ответ — не значение";
		// Строгая схема заставляет модель вернуть все ключи, и «в документе
		// этого нет» приходит пустой строкой или нулем. Распознанным такое
		// считать нельзя: применение затерло бы заполненный реквизит.
		ПустойОтвет = "{""amount"":0,""start_date"":"""",""perpetual"":false,""counterparty"":""""}";
		Пустое = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(Карта.Ссылка, ПустойОтвет);
		Для Каждого КлючПоля Из СтрРазделить("amount,start_date,counterparty", ",") Цикл
			СтрокиПустого = Пустое.НайтиСтроки(Новый Структура("Ключ", КлючПоля));
			Проверить(СтрокиПустого.Количество() = 1 И Не СтрокиПустого[0].Распознано,
				"Пустой ответ по полю " + КлючПоля + " не должен считаться распознанным.");
		КонецЦикла;
		СтрокиЛжи = Пустое.НайтиСтроки(Новый Структура("Ключ", "perpetual"));
		Проверить(СтрокиЛжи[0].Распознано И СтрокиЛжи[0].Значение = Ложь,
			"Ложь у логического поля — ответ, а не пустота.");

		Этап = "автовыбор файла по отбору";
		Варианты = Новый ТаблицаЗначений;
		Варианты.Колонки.Добавить("Ссылка");
		Варианты.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
		Варианты.Колонки.Добавить("Дополнительно", Новый ОписаниеТипов("Строка"));
		Для Каждого ОписаниеВарианта Из СтрРазделить("скан:png,договор:pdf,текст:txt", ",") Цикл
			Части = СтрРазделить(ОписаниеВарианта, ":");
			Вариант = Варианты.Добавить();
			Вариант.Представление = Части[0];
			Вариант.Дополнительно = Части[1];
		КонецЦикла;
		Выбранный = AI_ИзвлечениеРеквизитов.ВыбратьВариантАвтоматически(Варианты, "txt, pdf");
		Проверить(Выбранный <> Неопределено И Выбранный.Дополнительно = "txt",
			"Автовыбор должен брать файл по порядку расширений в отборе.");
		Проверить(AI_ИзвлечениеРеквизитов.ВыбратьВариантАвтоматически(
				Варианты.СкопироватьКолонки(), "txt") = Неопределено,
			"Без вариантов автовыбору выбирать нечего.");

		ДобавитьРезультат(
			Результаты,
			"extraction_map",
			Истина,
			"Схема, перенос в сценарий, отборы, уточнения и разбор ответа работают.");
	Исключение
		ДобавитьРезультат(
			Результаты,
			"extraction_map",
			Ложь,
			Этап + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Проверяет все виды действия с результатом: отказ без настройки, белый
// список карты, контроль типа, заполнение формы (база не меняется),
// запись объекта и прикладное действие через переопределяемый модуль.
Процедура ТестДействийСРезультатом(Результаты)

	Этап = "подготовка";
	Попытка
		Виды = Перечисления.AI_ВидДействия;
		Место = Справочники.AI_МестаЗапускаСценариев.НайтиПоКоду("ATMAP0001").ПолучитьОбъект();
		Проверить(Место <> Неопределено, "Место запуска ATMAP0001 не найдено.");
		Контрагент = Справочники.Контрагенты.НайтиПоКоду("AT0000001", Истина);
		Контекст = AI_ИнтерфейсныеСценарии.СформироватьКонтекст(Контрагент, "Объект");

		Значения = Новый ТаблицаЗначений;
		Значения.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
		Значения.Колонки.Добавить("Значение");

		Этап = "действие не настроено";
		Место.ВидДействия = Виды.ТолькоПоказать;
		Место.Записать();
		СтрокаЗначения = Значения.Добавить();
		СтрокаЗначения.Ключ = "counterparty";
		СтрокаЗначения.Значение = Контрагент;
		БезДействия = AI_ПрименениеРекомендаций.ВыполнитьДействие(
			Место.Ссылка, Контекст, Значения);
		Проверить(ЗначениеЗаполнено(БезДействия.Ошибка) И БезДействия.Обработано = 0,
			"Без настроенного вида действия применение должно отклоняться.");

		Этап = "белый список карты";
		Место.ВидДействия = Виды.ЗаполнитьФорму;
		Место.Записать();
		ЧужиеЗначения = Значения.Скопировать();
		ЧужиеЗначения.Очистить();
		ЧужаяСтрока = ЧужиеЗначения.Добавить();
		ЧужаяСтрока.Ключ = "поле_которого_нет_в_карте";
		ЧужаяСтрока.Значение = "диверсия";
		План = AI_ПрименениеРекомендаций.ПодготовитьПлан(Место.Ссылка, Контекст, ЧужиеЗначения);
		Проверить(План.Количество() = 1 И Не План[0].Применимо,
			"Поле вне карты извлечения не должно попадать в применение.");

		Этап = "карта под применение";
		// Берем Комментарий: он есть у тестового справочника и не участвует
		// в поиске контрагента по наименованию в соседних тестах.
		КартаОбъект = Справочники.AI_КартыИзвлечения.НайтиПоКоду("ATMAP0001").ПолучитьОбъект();
		КартаОбъект.Поля.Очистить();
		ПолеКомментария = КартаОбъект.Поля.Добавить();
		ПолеКомментария.Ключ = "comment";
		ПолеКомментария.Представление = "Комментарий";
		ПолеКомментария.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Строка;
		ПолеКомментария.ПутьРеквизита = "Комментарий";
		КартаОбъект.Записать();

		Этап = "контроль типа";
		НеверныйТип = Значения.Скопировать();
		НеверныйТип.Очистить();
		СтрокаТипа = НеверныйТип.Добавить();
		СтрокаТипа.Ключ = "comment";
		СтрокаТипа.Значение = 42;
		ПланТипа = AI_ПрименениеРекомендаций.ПодготовитьПлан(Место.Ссылка, Контекст, НеверныйТип);
		Проверить(ПланТипа.Количество() = 1 И Не ПланТипа[0].Применимо,
			"Значение неподходящего типа должно отклоняться.");
		Проверить(СтрНайти(ПланТипа[0].Причина, "Тип значения") > 0,
			"Причина отказа должна указывать на несовпадение типа, а получено: "
				+ ПланТипа[0].Причина);

		Этап = "пустое значение не применяется";
		ПустоеЗначение = Значения.Скопировать();
		ПустоеЗначение.Очистить();
		СтрокаПустого = ПустоеЗначение.Добавить();
		СтрокаПустого.Ключ = "comment";
		СтрокаПустого.Значение = "";
		ПланПустого = AI_ПрименениеРекомендаций.ПодготовитьПлан(Место.Ссылка, Контекст, ПустоеЗначение);
		Проверить(ПланПустого.Количество() = 1 И Не ПланПустого[0].Применимо,
			"Пустое значение не должно затирать реквизит объекта.");

		ИсходныйКомментарий = Контрагент.Комментарий;
		НовыйКомментарий = "Предложено помощником";

		Этап = "текущие значения объекта";
		// Человек должен видеть, что заменит результат. Совпадающее с объектом
		// значение изменением не считается и к применению не отмечается.
		Совпадающее = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(
			КартаОбъект.Ссылка,
			"{""comment"":""" + ИсходныйКомментарий + """}",
			Контекст);
		AI_ИзвлечениеРеквизитов.ДополнитьТекущимиЗначениями(Совпадающее, Контекст);
		Проверить(Совпадающее[0].ТекущееЗначение = ИсходныйКомментарий
				И Не Совпадающее[0].Изменится,
			"Совпадающее с объектом значение не должно помечаться изменением.");
		Новое = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(
			КартаОбъект.Ссылка,
			"{""comment"":""" + НовыйКомментарий + """}",
			Контекст);
		AI_ИзвлечениеРеквизитов.ДополнитьТекущимиЗначениями(Новое, Контекст);
		Проверить(Новое[0].Изменится,
			"Отличающееся от объекта значение должно помечаться изменением.");

		ЗначенияПрименения = Значения.Скопировать();
		ЗначенияПрименения.Очистить();
		СтрокаПрименения = ЗначенияПрименения.Добавить();
		СтрокаПрименения.Ключ = "comment";
		СтрокаПрименения.Значение = НовыйКомментарий;

		Этап = "заполнение формы не трогает базу";
		Заполнение = AI_ПрименениеРекомендаций.ВыполнитьДействие(
			Место.Ссылка, Контекст, ЗначенияПрименения);
		Проверить(Не ЗначениеЗаполнено(Заполнение.Ошибка) И Заполнение.План.Количество() = 1,
			"Ожидался план из одной строки. Ошибка: " + Заполнение.Ошибка);
		Проверить(Заполнение.План[0].ПутьРеквизита = "Комментарий",
			"План должен нести реквизит объекта из карты.");
		Проверить(Заполнение.План[0].Значение = НовыйКомментарий,
			"План должен нести типизированное значение.");
		Проверить(Заполнение.Обработано = 0,
			"Вид «Заполнить форму» ничего не применяет на сервере.");
		Проверить(Справочники.Контрагенты.НайтиПоКоду("AT0000001", Истина).Комментарий
				= ИсходныйКомментарий,
			"Заполнение формы не должно менять данные в базе.");

		Этап = "запись объекта";
		Место.ВидДействия = Виды.ЗаписатьОбъект;
		Место.Записать();
		Запись = AI_ПрименениеРекомендаций.ВыполнитьДействие(
			Место.Ссылка, Контекст, ЗначенияПрименения);
		Проверить(Запись.Обработано = 1,
			"Ожидалась запись одного реквизита. Ошибка: " + Запись.Ошибка);
		Проверить(Справочники.Контрагенты.НайтиПоКоду("AT0000001", Истина).Комментарий
				= НовыйКомментарий,
			"Значение не попало в объект.");

		Этап = "возврат исходного значения";
		ВозвратЗначений = ЗначенияПрименения.Скопировать();
		ВозвратЗначений[0].Значение = ИсходныйКомментарий;
		Возврат1 = AI_ПрименениеРекомендаций.ВыполнитьДействие(
			Место.Ссылка, Контекст, ВозвратЗначений);
		Проверить(Возврат1.Обработано = 1
				И Справочники.Контрагенты.НайтиПоКоду("AT0000001", Истина).Комментарий
					= ИсходныйКомментарий,
			"Не удалось вернуть исходный комментарий контрагента.");

		Этап = "прикладное действие без обработчика";
		Место.ВидДействия = Виды.ПользовательскоеДействие;
		Место.КлючДействия = "нет_такого_действия";
		Место.Записать();
		Пользовательское = AI_ПрименениеРекомендаций.ВыполнитьДействие(
			Место.Ссылка, Контекст, ЗначенияПрименения);
		Проверить(ЗначениеЗаполнено(Пользовательское.Ошибка),
			"Нереализованное прикладное действие должно давать внятный отказ.");
		Проверить(СтрНайти(Пользовательское.Ошибка, "AI_ДействияПереопределяемый") > 0,
			"Отказ должен указывать, где реализовать действие, а получено: "
				+ Пользовательское.Ошибка);

		Этап = "недопустимое имя метода";
		Место.ВидДействия = Виды.ВнешнийОбработчик;
		Место.Обработчик = "ЛюбаяОбработка";
		Место.МетодДействия = "Выполнить(""ВредныйКод"")";
		Место.Записать();
		ПлохойМетод = AI_ПрименениеРекомендаций.ВыполнитьДействие(
			Место.Ссылка, Контекст, ЗначенияПрименения);
		Проверить(ЗначениеЗаполнено(ПлохойМетод.Ошибка),
			"Имя метода не-идентификатор должно отклоняться до подстановки.");
		Место.МетодДействия = "";

		Этап = "параметры действия типизируются";
		Место.ПараметрыДействия.Очистить();
		СтрокаПараметра = Место.ПараметрыДействия.Добавить();
		СтрокаПараметра.Имя = "МинимумЗначений";
		СтрокаПараметра.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Число;
		СтрокаПараметра.Значение = "7";
		Место.Записать();
		// Проверка доступности без настроенного метода не должна ничего
		// запрещать, но и падать на параметрах не должна.
		Доступность = AI_ПрименениеРекомендаций.ПроверитьДоступность(
			Место.Ссылка, Контекст, "ПередДействием");
		Проверить(Доступность.Доступно,
			"Без настроенной внешней проверки действие должно оставаться доступным.");
		Место.ПараметрыДействия.Очистить();

		Этап = "внешний обработчик не указан";
		Место.Обработчик = "";
		Место.Записать();
		БезОбработчика = AI_ПрименениеРекомендаций.ВыполнитьДействие(
			Место.Ссылка, Контекст, ЗначенияПрименения);
		Проверить(ЗначениеЗаполнено(БезОбработчика.Ошибка),
			"Вид «Внешний обработчик» без указанной обработки должен отклоняться.");

		Этап = "внешний обработчик не зарегистрирован";
		// В конфигурации без подсистемы дополнительных обработок ядро обязано
		// дать внятный отказ, а не упасть на отсутствующем справочнике.
		Место.Обработчик = "НесуществующийОбработчик";
		Место.Записать();
		НетРегистрации = AI_ПрименениеРекомендаций.ВыполнитьДействие(
			Место.Ссылка, Контекст, ЗначенияПрименения);
		Проверить(ЗначениеЗаполнено(НетРегистрации.Ошибка)
				И СтрНайти(НетРегистрации.Ошибка, "НесуществующийОбработчик") > 0,
			"Отказ должен называть обработчик, а получено: " + НетРегистрации.Ошибка);
		Проверить(Справочники.Контрагенты.НайтиПоКоду("AT0000001", Истина).Комментарий
				= ИсходныйКомментарий,
			"Неудачный обработчик не должен менять данные.");

		Этап = "самоописание недоступной обработки";
		Методы = AI_ПрименениеРекомендаций.ПолучитьМетодыОбработчика("НетТакойОбработки");
		Проверить(Методы.Количество() = 0,
			"Для недоступной обработки список методов должен быть пустым, а не ошибкой.");

		Этап = "восстановление карты";
		ВосстановитьКартуИзвлечения();
		Место.ВидДействия = Виды.ТолькоПоказать;
		Место.КлючДействия = "";
		Место.Обработчик = "";
		Место.МетодДействия = "";
		Место.МетодПроверки = "";
		Место.Записать();

		ДобавитьРезультат(
			Результаты,
			"result_actions",
			Истина,
			"Отказ без настройки, белый список, контроль типа, заполнение формы,"
				+ " запись объекта, точка расширения и внешний обработчик работают.");
	Исключение
		ДобавитьРезультат(
			Результаты,
			"result_actions",
			Ложь,
			Этап + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Проверяет мастер нового действия: кандидатов в поля карты, отказ при
// неполных ответах и создание связанных карты, сценария и места запуска.
Процедура ТестМастераДействия(Результаты)

	Этап = "очистка прошлых запусков";
	Попытка
		УдалитьСозданноеМастером();

		Этап = "кандидаты полей карты";
		// У тестового справочника реквизиты шапки строковые: ИНН, КПП, адрес.
		// Плюс наименование — стандартный реквизит, нужный новому элементу.
		Кандидаты = AI_ИзвлечениеРеквизитов.КандидатыПолейКарты("Справочник.Контрагенты");
		Проверить(Кандидаты.Количество() = Метаданные.Справочники.Контрагенты.Реквизиты.Количество() + 1
				И Кандидаты.Найти("Наименование", "ПутьРеквизита") <> Неопределено,
			"Каждый строковый реквизит шапки и наименование должны предлагаться в карту.");
		КандидатИНН = Кандидаты.Найти("ИНН", "ПутьРеквизита");
		Проверить(КандидатИНН <> Неопределено
				И КандидатИНН.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Строка
				И Не ЗначениеЗаполнено(КандидатИНН.ДополнительныйРеквизит),
			"Реквизит «ИНН» должен предлагаться строкой шапки.");
		Проверить(AI_ИзвлечениеРеквизитов.КандидатыПолейКарты("Справочник.НетТакого").Количество() = 0,
			"Для несуществующего объекта кандидатов быть не должно.");

		Этап = "неполные ответы";
		Мастер = Обработки.AI_НовоеДействие;
		Описание = Мастер.НовоеОписание();
		Описание.ОбразецСценария = Справочники.AI_Сценарии.НайтиПоКоду("ATMAP0001");
		Проверка = Мастер.ПроверитьОписание(Описание);
		Проверить(Проверка.Ошибки.Количество() >= 3,
			"Без объекта, названия и реквизитов мастер не должен пускать дальше.");

		Описание.ПолноеИмяМетаданных = "Справочник.Контрагенты";
		Описание.Наименование = "Autotest мастер действия";
		Описание.НачальныйЗапрос = Мастер.ТекстЗапросаПоУмолчанию(Описание.ПолноеИмяМетаданных, "Нет");
		Для Каждого Кандидат Из Кандидаты Цикл
			Если Кандидат.ПутьРеквизита = "ИНН" Или Кандидат.ПутьРеквизита = "КПП" Тогда
				Поле = Новый Структура("Представление,ПутьРеквизита,ДополнительныйРеквизит,ТипЗначения,"
					+ "ТипСсылки,ПоискПоНаименованию,Подсказка,Обязательное");
				ЗаполнитьЗначенияСвойств(Поле, Кандидат);
				Поле.Обязательное = Ложь;
				Описание.Поля.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
		// Файлы тестовый справочник не хранит: вопрос о файле задать не из чего.
		Описание.ИсточникДанных = "Файл";
		Проверка = Мастер.ПроверитьОписание(Описание);
		Проверить(Проверка.Ошибки.Количество() = 1,
			"Без схемы хранения файлов мастер должен отказать только в вопросе о файле: "
				+ СтрСоединить(Проверка.Ошибки, "; "));
		Описание.ИсточникДанных = "Нет";

		Этап = "пачка с заполнением формы";
		Описание.РазрешитьПачку = Истина;
		Описание.ВидДействия = Перечисления.AI_ВидДействия.ЗаполнитьФорму;
		Проверка = Мастер.ПроверитьОписание(Описание);
		Проверить(Проверка.Ошибки.Количество() = 0 И Проверка.Предупреждения.Количество() = 1,
			"Пачка с «Заполнить форму» допустима, но должна предупреждать.");
		Описание.ВидДействия = Перечисления.AI_ВидДействия.ЗаписатьОбъект;

		Этап = "создание действия";
		Результат = Мастер.СоздатьДействие(Описание);
		Место = Результат.МестоЗапуска;
		Проверить(Место.КартаИзвлечения = Результат.КартаИзвлечения
				И Место.Сценарий = Результат.Сценарий,
			"Место запуска должно ссылаться на созданные карту и сценарий.");
		Проверить(Результат.КартаИзвлечения.Поля.Количество() = 2,
			"В карте должны оказаться два отмеченных реквизита.");
		Проверить(Результат.Сценарий <> Описание.ОбразецСценария
				И Результат.Сценарий.Агент = Описание.ОбразецСценария.Агент
				И Результат.Сценарий.Модель = Описание.ОбразецСценария.Модель,
			"Новый сценарий должен быть копией образца со своим кодом.");
		Проверить(Результат.Сценарий.СхемаОтветаJSON
				= AI_ИзвлечениеРеквизитов.СформироватьСхемуОтвета(Результат.КартаИзвлечения),
			"Схема ответа нового сценария должна совпадать с картой.");
		Проверить(Место.ПредставлениеКоманды = Описание.Наименование
				И Место.Наименование = Описание.Наименование
				И Место.РазрешитьНесколькоОбъектов
				И Место.Активно,
			"Место запуска должно называться как действие и допускать пачку.");
		Проверить(Результат.Проблемы.Количество() = 0,
			"У созданного мастером действия не должно быть проблем настройки: "
				+ СтрСоединить(Результат.Проблемы, "; "));
		Контрагент = Справочники.Контрагенты.НайтиПоКоду("AT0000001", Истина);
		Доступные = AI_ИнтерфейсныеСценарии.ПолучитьДоступныеСценарии(
			AI_ИнтерфейсныеСценарии.СформироватьКонтекст(Контрагент, "Объект"));
		Проверить(Доступные.НайтиСтроки(Новый Структура("МестоЗапуска", Место)).Количество() = 1,
			"Созданное действие должно сразу предлагаться в карточке объекта.");

		Этап = "готовая карта";
		Второе = Мастер.НовоеОписание();
		Второе.ПолноеИмяМетаданных = "Справочник.Контрагенты";
		Второе.Наименование = "Autotest мастер действия";
		Второе.КартаИзвлечения = Результат.КартаИзвлечения;
		Второе.ИсточникДанных = "Нет";
		Второе.Включить = Ложь;
		Второе.НачальныйЗапрос = Описание.НачальныйЗапрос;
		Проверка = Мастер.ПроверитьОписание(Второе);
		Проверить(Проверка.Предупреждения.Количество() = 1,
			"Второе действие с тем же названием должно предупреждать о дубле команды.");
		Второе.Наименование = "Autotest мастер действия: выключенное";
		РезультатВторого = Мастер.СоздатьДействие(Второе);
		Проверить(РезультатВторого.Сценарий = Результат.Сценарий,
			"Для готовой карты мастер должен взять ее сценарий, а не создавать новый.");
		Проверить(Не РезультатВторого.МестоЗапуска.Активно
				И РезультатВторого.Проблемы.Количество() = 1,
			"Выключенное действие должно создаваться выключенным и называть это проблемой: "
				+ СтрСоединить(РезультатВторого.Проблемы, "; "));

		Этап = "разговор и создание объекта без объекта";
		Третье = Мастер.НовоеОписание();
		Третье.ПолноеИмяМетаданных = "Справочник.ТестовыеМаршруты";
		Третье.ТипМеста = "Глобально";
		Третье.Наименование = "Autotest мастер действия: маршрут в разговоре";
		Третье.ИсточникДанных = "Файл";
		Третье.РежимДиалога = Истина;
		Третье.ВидДействия = Перечисления.AI_ВидДействия.ЗаполнитьФорму;
		Третье.ОбразецСценария = Описание.ОбразецСценария;
		Третье.НачальныйЗапрос = Мастер.ТекстЗапросаПоУмолчанию(Третье.ПолноеИмяМетаданных, "Нет", Истина, "СоздатьОбъект");
		Проверить(СтрНайти(Третье.НачальныйЗапрос, "новый объект «Тестовый маршрут»") > 0,
			"Запрос разговора должен говорить об одном объекте, а не о списке: " + Третье.НачальныйЗапрос);
		Проверка = Мастер.ПроверитьОписание(Третье);
		Проверить(Проверка.Ошибки.Количество() >= 3,
			"Без объекта мастер должен отказать и в файле, и в заполнении формы, и без полей: "
				+ СтрСоединить(Проверка.Ошибки, "; "));
		Третье.ИсточникДанных = "Нет";
		Третье.ВидДействия = Перечисления.AI_ВидДействия.СоздатьОбъект;
		Для Каждого Кандидат Из AI_ИзвлечениеРеквизитов.КандидатыПолейКарты(Третье.ПолноеИмяМетаданных, Истина) Цикл
			Если Кандидат.ПутьРеквизита = "Наименование" Или Кандидат.ТабличнаяЧасть = "Этапы" Тогда
				Поле = Новый Структура("Представление,ТабличнаяЧасть,ПутьРеквизита,ДополнительныйРеквизит,"
					+ "ТипЗначения,ТипСсылки,ПоискПоНаименованию,Подсказка,ВыбиратьИзСписка,Обязательное");
				ЗаполнитьЗначенияСвойств(Поле, Кандидат);
				Поле.Обязательное = Ложь;
				Третье.Поля.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
		РезультатТретьего = Мастер.СоздатьДействие(Третье);
		МестоТретьего = РезультатТретьего.МестоЗапуска;
		Проверить(МестоТретьего.ТипМеста = "Глобально"
				И МестоТретьего.РежимДиалога
				И Не ЗначениеЗаполнено(МестоТретьего.ПолноеИмяМетаданных)
				И МестоТретьего.ВидДействия = Перечисления.AI_ВидДействия.СоздатьОбъект
				И РезультатТретьего.КартаИзвлечения.ПолноеИмяМетаданных = "Справочник.ТестовыеМаршруты"
				И РезультатТретьего.КартаИзвлечения.Поля.Найти("Этапы", "ТабличнаяЧасть") <> Неопределено,
			"Мастер должен завести разговорное действие без объекта, создающее маршрут.");
		Проверить(РезультатТретьего.Проблемы.Количество() = 0,
			"У разговорного действия не должно быть проблем настройки: "
				+ СтрСоединить(РезультатТретьего.Проблемы, "; "));

		Этап = "ответ текстом";
		Четвертое = Мастер.НовоеОписание();
		Четвертое.ПолноеИмяМетаданных = "Справочник.Контрагенты";
		Четвертое.Наименование = "Autotest мастер действия: проверить карточку";
		Четвертое.ИсточникДанных = "Данные";
		Четвертое.ДанныеОбъекта.Добавить(Новый Структура("ТабличнаяЧасть,ПутьРеквизита", "", "*"));
		Четвертое.ОтветТекстом = Истина;
		Четвертое.ВидДействия = Перечисления.AI_ВидДействия.ТолькоПоказать;
		Четвертое.ОбразецСценария = Описание.ОбразецСценария;
		Четвертое.НачальныйЗапрос = Мастер.ТекстЗапросаПоУмолчанию(Четвертое.ПолноеИмяМетаданных, "Данные", Ложь, "Текст");
		РезультатЧетвертого = Мастер.СоздатьДействие(Четвертое);
		Проверить(Не ЗначениеЗаполнено(РезультатЧетвертого.КартаИзвлечения)
				И Не ЗначениеЗаполнено(РезультатЧетвертого.Сценарий.СхемаОтветаJSON)
				И РезультатЧетвертого.МестоЗапуска.ДанныеОбъекта.Количество() = 1,
			"Ответ текстом не должен заводить карту и схему ответа, а данные объекта — должен передавать.");

		ДобавитьРезультат(
			Результаты,
			"new_action_wizard",
			Истина,
			"Кандидаты полей, проверка ответов, создание карты, сценария и места, повторное использование карты работают.");
	Исключение
		ДобавитьРезультат(
			Результаты,
			"new_action_wizard",
			Ложь,
			Этап + ": " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		УдалитьСозданноеМастером();
	Исключение
		ДобавитьРезультат(Результаты, "new_action_wizard_cleanup", Ложь, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Проверяет сценарий «маршрут согласования»: перечисления и составные ссылки
// в карте, выбор из существующих значений, создание объекта по ответу модели,
// данные объекта для модели, обновление строк табличной части по номеру,
// задание разговора и новые проверки места запуска.
Процедура ТестМаршрутаИДанныхОбъекта(Результаты)

	Этап = "очистка прошлых запусков";
	Попытка
		УдалитьТестовыеМаршруты();
		Виды = Перечисления.AI_ТипЗначенияПоля;
		Варианты = Перечисления.ТестовыеВариантыСогласования;

		Этап = "кандидаты: перечисление, составная ссылка, колонки табличной части";
		Кандидаты = AI_ИзвлечениеРеквизитов.КандидатыПолейКарты("Справочник.ТестовыеМаршруты", Истина);
		Проверить(Кандидаты.Найти("Наименование", "ПутьРеквизита") <> Неопределено,
			"Наименование справочника должно предлагаться в карту.");
		КандидатВарианта = Кандидаты.Найти("Вариант", "ПутьРеквизита");
		Проверить(КандидатВарианта <> Неопределено
				И КандидатВарианта.ТипЗначения = Виды.Ссылка
				И КандидатВарианта.ТипСсылки = "Перечисление.ТестовыеВариантыСогласования",
			"Перечисление должно предлагаться ссылкой на себя.");
		Исполнители = Кандидаты.НайтиСтроки(Новый Структура("ТабличнаяЧасть,ПутьРеквизита", "Этапы", "Исполнитель"));
		Проверить(Исполнители.Количество() = 1 И Исполнители[0].ТипСсылки = "Справочник.Контрагенты",
			"Составной тип «контрагент или строка» должен дать ссылку на контрагентов.");

		Этап = "карта маршрута и схема ответа";
		Фикстуры = ПолучитьФикстуры();
		Сценарий = Справочники.AI_Сценарии.СоздатьЭлемент();
		Сценарий.Код = "ATROUTE01";
		Сценарий.Наименование = "Autotest маршрут: сценарий";
		Сценарий.Активен = Истина;
		Сценарий.ВерсияКонтракта = 1;
		Сценарий.МаксимумПопыток = 1;
		Сценарий.Агент = Фикстуры.Агент;
		Сценарий.Провайдер = Фикстуры.Провайдер;
		Сценарий.Модель = ОбеспечитьМодельАгента(Фикстуры.Провайдер);
		Сценарий.ТипAPI = Перечисления.AI_ТипAPI.Responses;
		Сценарий.Записать();

		Карта = Справочники.AI_КартыИзвлечения.СоздатьЭлемент();
		Карта.Наименование = "Autotest маршрут: карта";
		Карта.Активна = Истина;
		Карта.ПолноеИмяМетаданных = "Справочник.ТестовыеМаршруты";
		ДобавитьПолеКарты(Карта, "Наименование", "", "Наименование", Виды.Строка, "");
		ДобавитьПолеКарты(Карта, "Вариант", "", "Вариант", Виды.Ссылка, "Перечисление.ТестовыеВариантыСогласования");
		ДобавитьПолеКарты(Карта, "Исполнитель", "Этапы", "Исполнитель", Виды.Ссылка, "Справочник.Контрагенты", Истина);
		ДобавитьПолеКарты(Карта, "Порядок", "Этапы", "Порядок", Виды.Ссылка, "Перечисление.ТестовыеВариантыСогласования");
		ДобавитьПолеКарты(Карта, "Срок, дней", "Этапы", "СрокДней", Виды.Число, "");
		Карта.Записать();
		AI_ИзвлечениеРеквизитов.ЗаписатьСхемуВСценарий(Карта.Ссылка, Сценарий.Ссылка);

		Схема = OPI_Инструменты.JsonВСтруктуру(AI_ИзвлечениеРеквизитов.СформироватьСхемуОтвета(Карта.Ссылка), Истина);
		КлючВарианта = КлючПоляКарты(Карта.Ссылка, "", "Вариант");
		ПереченьВариантов = Схема.Получить("properties").Получить(КлючВарианта).Получить("enum");
		Проверить(ТипЗнч(ПереченьВариантов) = Тип("Массив") И ПереченьВариантов.Найти("Параллельно") <> Неопределено,
			"Перечисление должно попасть в схему перечнем значений.");
		СвойстваЭтапа = Схема.Получить("properties").Получить("Этапы").Получить("items").Получить("properties");
		Контрагент = Справочники.Контрагенты.НайтиПоКоду("AT0000001", Истина);
		ПереченьИсполнителей = СвойстваЭтапа.Получить(КлючПоляКарты(Карта.Ссылка, "Этапы", "Исполнитель")).Получить("enum");
		Проверить(ТипЗнч(ПереченьИсполнителей) = Тип("Массив")
				И ПереченьИсполнителей.Найти(Контрагент.Наименование) <> Неопределено,
			"При «Выбирать из существующих» контрагенты должны попасть в перечень схемы.");

		Этап = "разбор ответа: перечисления и ссылки в строках";
		Ответ = Новый Соответствие;
		Ответ.Вставить(КлючПоляКарты(Карта.Ссылка, "", "Наименование"), "Autotest маршрут: согласование договора");
		Ответ.Вставить(КлючВарианта, "Параллельно");
		Этапы = Новый Массив;
		Этапы.Добавить(ОписаниеЭтапаОтвета(Карта.Ссылка, Контрагент.Наименование, "Последовательно", 3));
		Этапы.Добавить(ОписаниеЭтапаОтвета(Карта.Ссылка, Контрагент.Наименование, "параллельно", 1));
		Ответ.Вставить("Этапы", Этапы);
		Разобранное = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(Карта.Ссылка, JSONСтрокой(Ответ));
		Порядок = Разобранное.НайтиСтроки(Новый Структура("ТабличнаяЧасть,НомерСтроки,ПутьРеквизита", "Этапы", 2, "Порядок"));
		Проверить(Порядок.Количество() = 1 И Порядок[0].Распознано И Порядок[0].Значение = Варианты.Параллельно,
			"Значение перечисления должно находиться по представлению без учета регистра.");
		Исполнитель = Разобранное.НайтиСтроки(Новый Структура("ТабличнаяЧасть,НомерСтроки,ПутьРеквизита", "Этапы", 1, "Исполнитель"));
		Проверить(Исполнитель.Количество() = 1 И Исполнитель[0].Значение = Контрагент,
			"Исполнитель должен находиться среди контрагентов.");
		Проверить(СтрНачинаетсяС(Исполнитель[0].Представление, "Этапы маршрута [1]"),
			"Строку табличной части пользователь должен видеть под ее синонимом: " + Исполнитель[0].Представление);

		Этап = "разбор ответа: значения нет";
		ОтветБезЗначения = Новый Соответствие;
		ОтветБезЗначения.Вставить(КлючВарианта, "");
		ОтветБезЗначения.Вставить("Этапы", Новый Массив);
		БезЗначения = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(Карта.Ссылка, JSONСтрокой(ОтветБезЗначения));
		ВариантБезЗначения = БезЗначения.НайтиСтроки(Новый Структура("ТабличнаяЧасть,ПутьРеквизита", "", "Вариант"));
		Проверить(ВариантБезЗначения.Количество() = 1
				И Не ВариантБезЗначения[0].Распознано
				И ВариантБезЗначения[0].Комментарий = "Модель не нашла значение.",
			"Пустой ответ модели не значение, и комментарий не должен ссылаться на документ.");

		Этап = "создание объекта";
		Место = Справочники.AI_МестаЗапускаСценариев.СоздатьЭлемент();
		Место.Наименование = "Autotest маршрут: создать";
		Место.Активно = Истина;
		Место.Сценарий = Сценарий.Ссылка;
		Место.КартаИзвлечения = Карта.Ссылка;
		Место.ТипМеста = "Глобально";
		Место.ВидДействия = Перечисления.AI_ВидДействия.СоздатьОбъект;
		Место.РежимДиалога = Истина;
		Место.НачальныйЗапрос = "Помоги собрать маршрут согласования.";
		Место.Записать();
		Проблемы = AI_ИнтерфейсныеСценарии.ПроблемыНастройкиМеста(Место.Ссылка).Проблемы;
		Проверить(Проблемы.Количество() = 0,
			"У места создания маршрута не должно быть проблем: " + СтрСоединить(Проблемы, "; "));
		Действие = AI_ПрименениеРекомендаций.ВыполнитьДействие(Место.Ссылка,
			AI_ИнтерфейсныеСценарии.СформироватьКонтекст(Неопределено), ЗначенияИзРазбора(Разобранное));
		Проверить(Не ЗначениеЗаполнено(Действие.Ошибка) И Действие.СозданныйОбъект <> Неопределено,
			"Действие «Создать объект» должно создать маршрут: " + Действие.Ошибка);
		Маршрут = Действие.СозданныйОбъект;
		Проверить(Маршрут.Наименование = "Autotest маршрут: согласование договора"
				И Маршрут.Вариант = Варианты.Параллельно
				И Маршрут.Этапы.Количество() = 2
				И Маршрут.Этапы[0].СрокДней = 3
				И Маршрут.Этапы[0].Исполнитель = Контрагент
				И Маршрут.Этапы[1].Порядок = Варианты.Параллельно,
			"Созданный маршрут должен получить шапку и обе строки этапов.");

		Этап = "задание разговора";
		Задание = AI_ИнтерфейсныеСценарии.ЗаданиеДиалога(Место.Ссылка);
		Проверить(СтрНайти(Задание, "Помоги собрать маршрут") > 0
				И СтрНайти(Задание, "Параллельно") > 0
				И СтрНайти(Задание, Контрагент.Наименование) > 0,
			"Задание разговора должно нести задачу и допустимые значения полей.");
		Проверить(СтрНайти(Задание, "список «Этапы маршрута»") > 0
				И СтрНайти(Задание, "остается в силе") > 0,
			"Задание разговора должно называть список как пользователь и держать уже сказанное: " + Задание);

		Этап = "данные объекта для модели";
		КартаОтметок = Справочники.AI_КартыИзвлечения.СоздатьЭлемент();
		КартаОтметок.Наименование = "Autotest маршрут: отметки";
		КартаОтметок.Активна = Истина;
		КартаОтметок.ПолноеИмяМетаданных = "Справочник.ТестовыеМаршруты";
		КартаОтметок.ОбновлятьСтрокиПоНомеру = Истина;
		ДобавитьПолеКарты(КартаОтметок, "Отметка", "Этапы", "Отметка", Виды.Строка, "");
		КартаОтметок.Записать();
		МестоОтметок = Справочники.AI_МестаЗапускаСценариев.СоздатьЭлемент();
		МестоОтметок.Наименование = "Autotest маршрут: отметить этапы";
		МестоОтметок.Активно = Истина;
		МестоОтметок.Сценарий = Сценарий.Ссылка;
		МестоОтметок.КартаИзвлечения = КартаОтметок.Ссылка;
		МестоОтметок.ТипМеста = "Объект";
		МестоОтметок.ПолноеИмяМетаданных = "Справочник.ТестовыеМаршруты";
		МестоОтметок.ВидДействия = Перечисления.AI_ВидДействия.ЗаписатьОбъект;
		СтрокаДанных = МестоОтметок.ДанныеОбъекта.Добавить();
		СтрокаДанных.ПутьРеквизита = "Вариант";
		СтрокаДанных = МестоОтметок.ДанныеОбъекта.Добавить();
		СтрокаДанных.ТабличнаяЧасть = "Этапы";
		СтрокаДанных.ПутьРеквизита = "*";
		МестоОтметок.Записать();
		КонтекстМаршрута = AI_ИнтерфейсныеСценарии.СформироватьКонтекст(Маршрут, "Объект");
		Данные = AI_ИнтерфейсныеСценарии.ДанныеОбъектаДляМодели(МестоОтметок.Ссылка, КонтекстМаршрута);
		Проверить(СтрНайти(Данные, "| № |") > 0
				И СтрНайти(Данные, "строк: 2") > 0
				И СтрНайти(Данные, "Параллельно") > 0
				И СтрНайти(Данные, "| 2 |") > 0,
			"Данные объекта должны нести реквизит и таблицу строк с номерами: " + Данные);

		Этап = "инструкция по настройке";
		Инструкция = AI_Инструкции.СформироватьHTML(Ложь);
		Проверить(СтрНайти(Инструкция, "Создать объект") > 0
				И СтрНайти(Инструкция, "Сначала разговор") > 0
				И СтрНайти(Инструкция, "Этапы: все колонки") > 0,
			"Инструкция должна описывать создание объекта, разговор и данные объекта для модели.");

		Этап = "обновление строки по номеру";
		СхемаОтметок = OPI_Инструменты.JsonВСтруктуру(
			AI_ИзвлечениеРеквизитов.СформироватьСхемуОтвета(КартаОтметок.Ссылка), Истина);
		ОбязательныеЭтапа = СхемаОтметок.Получить("properties").Получить("Этапы").Получить("items").Получить("required");
		Проверить(ОбязательныеЭтапа.Найти("row") <> Неопределено,
			"При обновлении по номеру строка ответа должна требовать номер строки.");
		ОтветОтметок = Новый Соответствие;
		СтрокиОтметок = Новый Массив;
		СтрокаОтметки = Новый Соответствие;
		СтрокаОтметки.Вставить("row", 2);
		СтрокаОтметки.Вставить(КлючПоляКарты(КартаОтметок.Ссылка, "Этапы", "Отметка"), "проверено");
		СтрокиОтметок.Добавить(СтрокаОтметки);
		ЛишняяСтрока = Новый Соответствие;
		ЛишняяСтрока.Вставить("row", 5);
		ЛишняяСтрока.Вставить(КлючПоляКарты(КартаОтметок.Ссылка, "Этапы", "Отметка"), "нет такой строки");
		СтрокиОтметок.Добавить(ЛишняяСтрока);
		ОтветОтметок.Вставить("Этапы", СтрокиОтметок);
		РазобранныеОтметки = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(
			КартаОтметок.Ссылка, JSONСтрокой(ОтветОтметок), КонтекстМаршрута);
		Проверить(РазобранныеОтметки.Количество() = 2 И РазобранныеОтметки[0].НомерСтроки = 2,
			"Номер строки должен браться из ответа модели, а не из порядка строк.");
		Запись = AI_ПрименениеРекомендаций.ВыполнитьДействие(МестоОтметок.Ссылка, КонтекстМаршрута,
			ЗначенияИзРазбора(РазобранныеОтметки));
		ОбъектМаршрута = Маршрут.ПолучитьОбъект();
		Проверить(Не ЗначениеЗаполнено(Запись.Ошибка)
				И Запись.Обработано = 1
				И Запись.Отклонено = 1
				И ОбъектМаршрута.Этапы.Количество() = 2
				И ОбъектМаршрута.Этапы[1].Отметка = "проверено"
				И Не ЗначениеЗаполнено(ОбъектМаршрута.Этапы[0].Отметка),
			"Обновление по номеру должно изменить вторую строку, не трогая первую и не добавляя пятую: "
				+ Запись.Ошибка + " " + СтрСоединить(Запись.Сообщения, "; "));

		Этап = "проверки настройки места";
		МестоОтметок.ДанныеОбъекта.Очистить();
		МестоОтметок.РежимДиалога = Истина;
		МестоОтметок.РазрешитьНесколькоОбъектов = Истина;
		МестоОтметок.Записать();
		Проблемы = СтрСоединить(AI_ИнтерфейсныеСценарии.ПроблемыНастройкиМеста(МестоОтметок.Ссылка).Проблемы, " ");
		Проверить(СтрНайти(Проблемы, "номеров строк она не узнает") > 0,
			"Проверка должна заметить обновление по номеру без табличной части в данных: " + Проблемы);
		Проверить(СтрНайти(Проблемы, "Диалог ведется по одному объекту") > 0,
			"Проверка должна запретить диалог в пачке: " + Проблемы);

		ДобавитьРезультат(
			Результаты,
			"route_and_object_data",
			Истина,
			"Перечисления и составные ссылки, создание объекта, данные объекта, обновление строк по номеру,"
				+ " задание разговора и проверки места работают.");
	Исключение
		ДобавитьРезультат(
			Результаты,
			"route_and_object_data",
			Ложь,
			Этап + ": " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		УдалитьТестовыеМаршруты();
	Исключение
		ДобавитьРезультат(Результаты, "route_and_object_data_cleanup", Ложь, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Этапы, на которых в ход действия вмешивается обработка, проверки кодом,
// видимость по ролям и группам доступа и адаптер конфигурации. Обработчик —
// обработка тестовой конфигурации: реестра БСП в тестовой базе нет.
Процедура ТестЭтаповИАдаптера(Результаты)

	Этап = "подготовка";
	Попытка
		Фикстуры = ПолучитьФикстуры();
		Виды = Перечисления.AI_ТипЗначенияПоля;
		Обработчик = "Обработка.ТестовыйОбработчикLLM";

		Этап = "обработчик конфигурации";
		Проверить(AI_ПрименениеРекомендаций.ОбработчикЗарегистрирован(Обработчик)
				И Не AI_ПрименениеРекомендаций.ОбработчикЗарегистрирован("Обработка.НетТакойОбработки"),
			"Обработку конфигурации «Обработка.<Имя>» ядро должно находить без реестра БСП.");
		Методы = AI_ПрименениеРекомендаций.ПолучитьМетодыОбработчика(Обработчик);
		Проверить(Методы.Найти("ПодготовкаЗапроса", "Назначение") <> Неопределено
				И Методы.Найти("ПослеОтвета", "Назначение") <> Неопределено,
			"Самоописание обработки должно отдавать методы этапов.");

		Сценарий = Справочники.AI_Сценарии.СоздатьЭлемент();
		Сценарий.Код = "ATSTAGE01";
		Сценарий.Наименование = "Autotest этапы: сценарий";
		Сценарий.Активен = Истина;
		Сценарий.ВерсияКонтракта = 1;
		Сценарий.МаксимумПопыток = 1;
		Сценарий.Агент = Фикстуры.Агент;
		Сценарий.Провайдер = Фикстуры.Провайдер;
		Сценарий.Модель = ОбеспечитьМодельАгента(Фикстуры.Провайдер);
		Сценарий.ТипAPI = Перечисления.AI_ТипAPI.Responses;
		Сценарий.Записать();

		Карта = Справочники.AI_КартыИзвлечения.СоздатьЭлемент();
		Карта.Наименование = "Autotest этапы: карта";
		Карта.Активна = Истина;
		Карта.ПолноеИмяМетаданных = "Справочник.ТестовыеМаршруты";
		ДобавитьПолеКарты(Карта, "Наименование", "", "Наименование", Виды.Строка, "");
		Карта.Записать();

		Место = Справочники.AI_МестаЗапускаСценариев.СоздатьЭлемент();
		Место.Наименование = "Autotest этапы: место";
		Место.Активно = Истина;
		Место.Сценарий = Сценарий.Ссылка;
		Место.КартаИзвлечения = Карта.Ссылка;
		Место.ТипМеста = "Глобально";
		Место.ВидДействия = Перечисления.AI_ВидДействия.СоздатьОбъект;
		Место.НачальныйЗапрос = "Собери маршрут.";
		Место.Обработчик = Обработчик;
		Место.МетодПроверки = "ПроверитьДоступность";
		Место.МетодПодготовкиЗапроса = "ПодготовитьЗапрос";
		Место.МетодПослеОтвета = "ОбработатьОтвет";
		Место.МетодПослеДействия = "ПослеДействия";
		Место.Записать();
		Контекст = AI_ИнтерфейсныеСценарии.СформироватьКонтекст(Неопределено, "Глобально");
		Проблемы = СтрСоединить(AI_ИнтерфейсныеСценарии.ПроблемыНастройкиМеста(Место.Ссылка).Проблемы, " ");
		Проверить(СтрНайти(Проблемы, "Обработка") = 0 И СтрНайти(Проблемы, "метод") = 0,
			"Обработка конфигурации с верными методами не должна давать проблем настройки: " + Проблемы);

		Этап = "проверка при выборе действия";
		Проверить(ДействиеВСписке(Место.Ссылка, Контекст), "Действие без запрета должно быть в списке.");
		УстановитьФлагМеста(Место, "Скрыть");
		Проверить(Не ДействиеВСписке(Место.Ссылка, Контекст),
			"Проверка кодом при выборе действия должна скрыть действие.");
		УстановитьФлагМеста(Место, "");

		Этап = "подготовка запроса";
		Подготовка = AI_ПрименениеРекомендаций.ПодготовитьЗапрос(Место.Ссылка, Контекст, ВходЗапроса());
		Проверить(Не ЗначениеЗаполнено(Подготовка.Ошибка)
				И Подготовка.Файлы.Количество() = 1
				И Подготовка.Файлы[0].ИмяФайла = "подано обработкой.txt"
				И СтрНайти(Подготовка.ДанныеКонтекста, "Проверено обработкой") > 0
				И СтрНайти(Подготовка.Промт, "режим: Запуск") > 0
				И Подготовка.Сообщения.Найти("Обработка подала файл.") <> Неопределено,
			"Обработка должна подать файл, дописать данные и запрос: " + Подготовка.Ошибка);
		УстановитьФлагМеста(Место, "ОтказатьВЗапросе");
		Отказ = AI_ПрименениеРекомендаций.ПодготовитьЗапрос(Место.Ссылка, Контекст, ВходЗапроса());
		Проверить(Отказ.Ошибка = "Тестовый отказ перед запросом.",
			"Отказ обработчика перед запросом должен дойти до человека: " + Отказ.Ошибка);
		УстановитьФлагМеста(Место, "");

		Этап = "после ответа";
		Ответ = Новый Соответствие;
		Ответ.Вставить(КлючПоляКарты(Карта.Ссылка, "", "Наименование"), "маршрут поставки");
		Обработка = AI_ПрименениеРекомендаций.ОбработатьОтветМодели(Место.Ссылка, Контекст, JSONСтрокой(Ответ));
		Разобранное = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(Карта.Ссылка, Обработка.ТекстОтвета);
		Проверить(Не ЗначениеЗаполнено(Обработка.Ошибка)
				И Разобранное.Количество() = 1
				И Разобранное[0].Значение = "МАРШРУТ ПОСТАВКИ"
				И Обработка.Сообщения.Найти("Обработка проверила ответ.") <> Неопределено,
			"Правка обработчика должна дойти до разбора ответа: " + Обработка.ТекстОтвета);
		УстановитьФлагМеста(Место, "ОтклонитьОтвет");
		Отклонено = AI_ПрименениеРекомендаций.ОбработатьОтветМодели(Место.Ссылка, Контекст, JSONСтрокой(Ответ));
		Проверить(Отклонено.Ошибка = "Тестовый отказ после ответа.",
			"Отказ обработчика после ответа должен дойти до человека: " + Отклонено.Ошибка);
		УстановитьФлагМеста(Место, "");

		Этап = "перед действием и после действия";
		УстановитьФлагМеста(Место, "ЗапретитьДействие");
		Запрет = AI_ПрименениеРекомендаций.ВыполнитьДействие(Место.Ссылка, Контекст, ЗначенияИзРазбора(Разобранное));
		Проверить(Запрет.Ошибка = "Запрещено тестовой проверкой." И Запрет.СозданныйОбъект = Неопределено,
			"Проверка перед действием должна его остановить: " + Запрет.Ошибка);
		УстановитьФлагМеста(Место, "");
		Действие = AI_ПрименениеРекомендаций.ВыполнитьДействие(Место.Ссылка, Контекст, ЗначенияИзРазбора(Разобранное));
		Проверить(Не ЗначениеЗаполнено(Действие.Ошибка)
				И Действие.СозданныйОбъект <> Неопределено
				И СтрНайти(СтрСоединить(Действие.Сообщения, " "), "После действия: применено 1, создан объект: да") > 0,
			"После действия обработка должна получить итог: " + Действие.Ошибка + " "
				+ СтрСоединить(Действие.Сообщения, "; "));

		Этап = "видимость по ролям и группам доступа";
		ОбъектМеста = Место.Ссылка.ПолучитьОбъект();
		Условие = ОбъектМеста.Видимость.Добавить();
		Условие.ВидУсловия = "Роль";
		Условие.Имя = "ПолныеПрава";
		ОбъектМеста.Записать();
		Проверить(AI_ИнтерфейсныеСценарии.МестоВидноПользователю(Место.Ссылка)
				И ДействиеВСписке(Место.Ссылка, Контекст),
			"Роль текущего пользователя должна открывать действие.");
		ОбъектМеста.Видимость.Очистить();
		Условие = ОбъектМеста.Видимость.Добавить();
		Условие.ВидУсловия = "ГруппаДоступа";
		Условие.Имя = "Бухгалтерия";
		Условие = ОбъектМеста.Видимость.Добавить();
		Условие.ВидУсловия = "Роль";
		Условие.Имя = "НетТакойРоли";
		ОбъектМеста.Записать();
		Проверить(Не AI_ИнтерфейсныеСценарии.МестоВидноПользователю(Место.Ссылка)
				И Не ДействиеВСписке(Место.Ссылка, Контекст),
			"Невыполнимые условия видимости должны скрыть действие.");
		Проблемы = СтрСоединить(AI_ИнтерфейсныеСценарии.ПроблемыНастройкиМеста(Место.Ссылка).Проблемы, " ");
		Проверить(СтрНайти(Проблемы, "нет групп доступа БСП") > 0
				И СтрНайти(Проблемы, "роли «НетТакойРоли»") > 0,
			"Проверка настройки должна объяснить, почему действие не увидит никто: " + Проблемы);
		Скрыто = Ложь;
		Попытка
			AI_ПрименениеРекомендаций.ПодготовитьПлан(Место.Ссылка, Контекст, ЗначенияИзРазбора(Разобранное));
		Исключение
			Скрыто = Истина;
		КонецПопытки;
		Проверить(Скрыто, "Скрытое действие не должно выполняться и в обход списка.");
		ОбъектМеста.Видимость.Очистить();
		ОбъектМеста.Записать();

		Этап = "адаптер конфигурации";
		Константы.AI_АдаптерКонфигурации.Установить(Обработчик);
		AI_ПрименениеРекомендаций.СброситьКэшАдаптераКонфигурации();
		Юрист = Справочники.ТестовыеРоли.СоздатьЭлемент();
		Юрист.Роль = "Юрист";
		Юрист.Записать();
		Кандидаты = AI_ИзвлечениеРеквизитов.КандидатыПолейКарты("Справочник.ТестовыеМаршруты", Истина);
		Исполнитель = Кандидаты.НайтиСтроки(Новый Структура("ТабличнаяЧасть,ПутьРеквизита", "Этапы", "Исполнитель"));
		Проверить(Исполнитель.Количество() = 1 И СтрНайти(Исполнитель[0].ТипСсылки, "ТестовыеРоли") > 0,
			"Тип, который знает адаптер, должен попасть в поле карты.");
		КартаРолей = Справочники.AI_КартыИзвлечения.СоздатьЭлемент();
		КартаРолей.Наименование = "Autotest этапы: роли";
		КартаРолей.Активна = Истина;
		КартаРолей.ПолноеИмяМетаданных = "Справочник.ТестовыеМаршруты";
		ДобавитьПолеКарты(КартаРолей, "Исполнитель", "Этапы", "Исполнитель", Виды.Ссылка,
			Исполнитель[0].ТипСсылки, Истина);
		КартаРолей.Записать();
		КлючИсполнителя = КлючПоляКарты(КартаРолей.Ссылка, "Этапы", "Исполнитель");
		Схема = OPI_Инструменты.JsonВСтруктуру(
			AI_ИзвлечениеРеквизитов.СформироватьСхемуОтвета(КартаРолей.Ссылка), Истина);
		Перечень = Схема.Получить("properties").Получить("Этапы").Получить("items")
			.Получить("properties").Получить(КлючИсполнителя).Получить("enum");
		Контрагент = Справочники.Контрагенты.НайтиПоКоду("AT0000001", Истина);
		Проверить(ТипЗнч(Перечень) = Тип("Массив")
				И Перечень.Найти("Юрист") <> Неопределено
				И Перечень.Найти(Контрагент.Наименование) <> Неопределено,
			"Перечень схемы должен соединять значения ядра и адаптера.");
		Проверить(СтрНайти(AI_ИзвлечениеРеквизитов.ОписаниеПолейДляДиалога(КартаРолей.Ссылка),
				"Юрист (тестовая роль)") > 0,
			"Задание разговора должно нести пояснения адаптера.");

		ОтветРолей = Новый Соответствие;
		Строки = Новый Массив;
		Для Каждого Текст Из СтрРазделить("Юрист|Юрист, Отдел договоров|" + Контрагент.Наименование
				+ "|Неизвестная роль", "|") Цикл
			СтрокаОтвета = Новый Соответствие;
			СтрокаОтвета.Вставить(КлючИсполнителя, Текст);
			Строки.Добавить(СтрокаОтвета);
		КонецЦикла;
		ОтветРолей.Вставить("Этапы", Строки);
		Роли = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(КартаРолей.Ссылка, JSONСтрокой(ОтветРолей));
		Проверить(Роли.Количество() = 4
				И Роли[0].Значение = Юрист.Ссылка
				И ТипЗнч(Роли[1].Значение) = Тип("СправочникСсылка.ТестовыеРоли")
				И Роли[1].Значение.Подразделение = "Отдел договоров"
				И Роли[1].Комментарий = "Роль заведена адаптером."
				И Роли[2].Значение = Контрагент
				И Не Роли[3].Распознано
				И СтрНайти(Роли[3].Комментарий, "Тестовый адаптер такой роли не знает") > 0,
			"Разбор должен отдавать адаптеру его типы, а остальное искать сам: " + ОписаниеРазбора(Роли));

		ДобавитьРезультат(
			Результаты,
			"stages_and_adapter",
			Истина,
			"Проверки кодом, подготовка запроса, ответ, после действия, видимость и адаптер работают.");
	Исключение
		ДобавитьРезультат(
			Результаты,
			"stages_and_adapter",
			Ложь,
			Этап + ": " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Константы.AI_АдаптерКонфигурации.Установить("");
		AI_ПрименениеРекомендаций.СброситьКэшАдаптераКонфигурации();
		УдалитьТестовыеОбъекты("Autotest этапы");
	Исключение
		ДобавитьРезультат(Результаты, "stages_and_adapter_cleanup", Ложь, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Пакет сценария схемы 2: круг выгрузки и загрузки не теряет разговор,
// данные объекта, видимость, методы этапов, обновление строк по номеру и
// выбор из существующих; голый manifest.json без технических полей и без
// сценария в базе загружается и становится рабочим.
Процедура ТестПакетаСценария(Результаты)

	Этап = "подготовка";
	Попытка
		Фикстуры = ПолучитьФикстуры();
		Виды = Перечисления.AI_ТипЗначенияПоля;

		Образец = Справочники.AI_Сценарии.СоздатьЭлемент();
		Образец.Код = "ATPACK001";
		Образец.Наименование = "Autotest пакет: сценарий";
		Образец.Активен = Истина;
		Образец.ВерсияКонтракта = 1;
		Образец.МаксимумПопыток = 1;
		Образец.Агент = Фикстуры.Агент;
		Образец.Провайдер = Фикстуры.Провайдер;
		Образец.Модель = ОбеспечитьМодельАгента(Фикстуры.Провайдер);
		Образец.ТипAPI = Перечисления.AI_ТипAPI.Responses;
		Образец.Записать();

		Карта = Справочники.AI_КартыИзвлечения.СоздатьЭлемент();
		Карта.Наименование = "Autotest пакет: карта";
		Карта.Активна = Истина;
		Карта.ПолноеИмяМетаданных = "Справочник.ТестовыеМаршруты";
		Карта.ОбновлятьСтрокиПоНомеру = Истина;
		ДобавитьПолеКарты(Карта, "Вариант", "", "Вариант", Виды.Ссылка,
			"Перечисление.ТестовыеВариантыСогласования", Истина);
		ДобавитьПолеКарты(Карта, "Отметка", "Этапы", "Отметка", Виды.Строка, "");
		Карта.Записать();

		Место = Справочники.AI_МестаЗапускаСценариев.СоздатьЭлемент();
		Место.Наименование = "Autotest пакет: место";
		Место.Активно = Истина;
		Место.Сценарий = Образец.Ссылка;
		Место.КартаИзвлечения = Карта.Ссылка;
		Место.ТипМеста = "Объект";
		Место.ПолноеИмяМетаданных = "Справочник.ТестовыеМаршруты";
		Место.ВидДействия = Перечисления.AI_ВидДействия.ЗаписатьОбъект;
		Место.РежимДиалога = Истина;
		Место.НачальныйЗапрос = "Отметь этапы.";
		Место.Обработчик = "Обработка.ТестовыйОбработчикLLM";
		Место.МетодПодготовкиЗапроса = "ПодготовитьЗапрос";
		Место.МетодПослеДействия = "ПослеДействия";
		СтрокаДанных = Место.ДанныеОбъекта.Добавить();
		СтрокаДанных.ПутьРеквизита = "Вариант";
		СтрокаДанных = Место.ДанныеОбъекта.Добавить();
		СтрокаДанных.ТабличнаяЧасть = "Этапы";
		СтрокаДанных.ПутьРеквизита = "*";
		Условие = Место.Видимость.Добавить();
		Условие.ВидУсловия = "Роль";
		Условие.Имя = "ПолныеПрава";
		Место.Записать();

		Этап = "выгрузка и загрузка";
		Пакет = AI_ПакетыСценариев.Выгрузить(Место.Ссылка);
		Итог = AI_ПакетыСценариев.Загрузить(Пакет.Данные);
		Проверить(Итог.Ошибки.Количество() = 0, "Свой пакет должен загружаться: " + СтрСоединить(Итог.Ошибки, "; "));
		Загруженное = Место.Ссылка.ПолучитьОбъект();
		КартаПосле = Карта.Ссылка.ПолучитьОбъект();
		Проверить(Не Загруженное.Активно
				И Загруженное.РежимДиалога
				И Загруженное.ДанныеОбъекта.Количество() = 2
				И Загруженное.Видимость.Количество() = 1
				И Загруженное.Видимость[0].Имя = "ПолныеПрава"
				И Загруженное.МетодПодготовкиЗапроса = "ПодготовитьЗапрос"
				И Загруженное.МетодПослеДействия = "ПослеДействия"
				И КартаПосле.ОбновлятьСтрокиПоНомеру
				И КартаПосле.Поля.Найти("Вариант", "ПутьРеквизита").ВыбиратьИзСписка,
			"Круг выгрузки и загрузки не должен терять новые настройки.");

		Этап = "голый манифест";
		ПолеНаименования = Новый Соответствие;
		ПолеНаименования.Вставить("attribute_path", "Наименование");
		ПолеВарианта = Новый Соответствие;
		ПолеВарианта.Вставить("attribute_path", "Вариант");
		ПолеСрока = Новый Соответствие;
		ПолеСрока.Вставить("tabular_section", "Этапы");
		ПолеСрока.Вставить("attribute_path", "СрокДней");
		Поля = Новый Массив;
		Поля.Добавить(ПолеНаименования);
		Поля.Добавить(ПолеВарианта);
		Поля.Добавить(ПолеСрока);
		ОписаниеКарты = Новый Соответствие;
		ОписаниеКарты.Вставить("name", "Autotest пакет: карта из JSON");
		ОписаниеКарты.Вставить("metadata_name", "Справочник.ТестовыеМаршруты");
		ОписаниеКарты.Вставить("fields", Поля);
		ОписаниеМеста = Новый Соответствие;
		ОписаниеМеста.Вставить("name", "Autotest пакет: из JSON");
		ОписаниеМеста.Вставить("scenario", "Autotest пакет: новый сценарий");
		ОписаниеМеста.Вставить("extraction_map", "Autotest пакет: карта из JSON");
		ОписаниеМеста.Вставить("place_type", "Глобально");
		ОписаниеМеста.Вставить("action_kind", "СоздатьОбъект");
		ОписаниеМеста.Вставить("dialog_mode", Истина);
		ОписаниеМеста.Вставить("initial_prompt", "Собери маршрут в разговоре.");
		ОписаниеСценария = Новый Соответствие;
		ОписаниеСценария.Вставить("name", "Autotest пакет: новый сценарий");
		ОписаниеСценария.Вставить("max_attempts", 2);
		Манифест = Новый Соответствие;
		Манифест.Вставить("schema", 2);
		Манифест.Вставить("launch_places", ОдинЭлемент(ОписаниеМеста));
		Манифест.Вставить("extraction_maps", ОдинЭлемент(ОписаниеКарты));
		Манифест.Вставить("scenarios", ОдинЭлемент(ОписаниеСценария));
		Итог = AI_ПакетыСценариев.Загрузить(ПолучитьДвоичныеДанныеИзСтроки(JSONСтрокой(Манифест)),
			Новый Структура("ОбразецСценария", Образец.Ссылка));
		Проверить(Итог.Ошибки.Количество() = 0 И Итог.Предупреждения.Количество() = 0,
			"Голый манифест должен загружаться без ошибок: " + СтрСоединить(Итог.Ошибки, "; ")
				+ СтрСоединить(Итог.Предупреждения, "; "));
		НовоеМесто = Справочники.AI_МестаЗапускаСценариев.НайтиПоНаименованию("Autotest пакет: из JSON", Истина);
		НовыйСценарий = Справочники.AI_Сценарии.НайтиПоНаименованию("Autotest пакет: новый сценарий", Истина);
		Проверить(ЗначениеЗаполнено(НовоеМесто) И Не НовоеМесто.Активно И НовоеМесто.РежимДиалога
				И ЗначениеЗаполнено(НовыйСценарий) И НовоеМесто.Сценарий = НовыйСценарий
				И НовыйСценарий.Агент = Образец.Агент И НовыйСценарий.МаксимумПопыток = 2,
			"Недостающий сценарий должен создаваться по образцу с настройками из пакета.");
		НоваяКарта = НовоеМесто.КартаИзвлечения;
		Вариант = НоваяКарта.Поля.Найти("Вариант", "ПутьРеквизита");
		Срок = НоваяКарта.Поля.Найти("СрокДней", "ПутьРеквизита");
		Проверить(Вариант <> Неопределено И Вариант.ТипЗначения = Виды.Ссылка
				И Вариант.ТипСсылки = "Перечисление.ТестовыеВариантыСогласования"
				И ЗначениеЗаполнено(Вариант.Ключ)
				И Срок <> Неопределено И Срок.ТипЗначения = Виды.Число И Срок.ТабличнаяЧасть = "Этапы",
			"Тип, тип ссылки и ключ поля должны выводиться из метаданных, как в мастере.");
		Проверить(СтрНайти(НовыйСценарий.СхемаОтветаJSON, Вариант.Ключ) > 0,
			"Схема ответа должна переноситься в сценарий при загрузке.");

		Этап = "неизвестная версия схемы";
		Манифест.Вставить("schema", 3);
		Итог = AI_ПакетыСценариев.Загрузить(ПолучитьДвоичныеДанныеИзСтроки(JSONСтрокой(Манифест)));
		Проверить(Итог.Ошибки.Количество() = 1 И СтрНайти(Итог.Ошибки[0], "не поддерживается") > 0,
			"Пакет новее базы должен отклоняться целиком.");

		Этап = "ошибки описания";
		Манифест.Вставить("schema", 2);
		ОписаниеМеста.Вставить("place_type", "Карточка");
		ОписаниеМеста.Вставить("action_kind", "Сделать");
		Итог = AI_ПакетыСценариев.Загрузить(ПолучитьДвоичныеДанныеИзСтроки(JSONСтрокой(Манифест)));
		Проверить(Итог.Ошибки.Количество() = 2
				И СтрНайти(Итог.Ошибки[0], "тип места «Карточка» неизвестен") > 0
				И СтрНайти(Итог.Ошибки[1], "ЗаписатьОбъект") > 0,
			"Неизвестные тип места и вид действия должны отклонять пакет до записи: "
				+ СтрСоединить(Итог.Ошибки, "; "));

		ДобавитьРезультат(
			Результаты,
			"scenario_package",
			Истина,
			"Схема 2 переносит новые настройки, голый манифест загружается, сценарий создается по образцу.");
	Исключение
		ДобавитьРезультат(
			Результаты,
			"scenario_package",
			Ложь,
			Этап + ": " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		УдалитьТестовыеОбъекты("Autotest пакет");
	Исключение
		ДобавитьРезультат(Результаты, "scenario_package_cleanup", Ложь, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

