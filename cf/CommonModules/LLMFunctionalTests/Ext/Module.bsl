		Клиент.СпроситьСФайлом("FILE_SMOKE", "fixture.txt", Данные);
		Проверить(Клиент.ИзвлеченныйОтвет = "MOCK_FILE_OK",
			"Files API не передал документ модели.");

		Клиент = Обработки.AI_Клиент.Создать();
		Клиент.Инициализировать(
			Фикстуры.Провайдер,
			Модель,
			Перечисления.AI_ТипAPI.Responses);
		Клиент.СпроситьСКартинкой("IMAGE_SMOKE", "fixture.png", Данные);
		Проверить(Клиент.ИзвлеченныйОтвет = "MOCK_IMAGE_OK",
			"Передача изображения модели не работает.");
		УдалитьФайлы(ИмяВременногоФайла);
		ДобавитьРезультат(Результаты, "attachments_api", Истина, "Файл и изображение обработаны.");
	Исключение
		Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;
		ДобавитьОшибкуТеста(Результаты, "attachments_api");
	КонецПопытки;

