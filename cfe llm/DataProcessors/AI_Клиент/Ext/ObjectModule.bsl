//			// В Responses API системный промт — это поле "instructions" в теле запроса,
//			// но его можно также передать как сообщение с ролью "system"
//			Сообщения.Добавить(OPI_OpenAI.ПолучитьСообщениеСистемы(СистемныйПромт));
//		КонецЕсли;
//		
