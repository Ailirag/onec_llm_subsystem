
#Область СобытияФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ДанныеИзОбъекта = ТекущийОбъект.ДанныеКонтекста.Получить();
	Если ЗначениеЗаполнено(ДанныеИзОбъекта) Тогда
		ДанныеКонтекста.УстановитьТекст(ДанныеИзОбъекта);
	КонецЕсли;
КонецПроцедуры

// Пустые сведения модели ничего не дают, а место в запросе занимают: такую
// запись не пропускаем.
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	ОчиститьСообщения();

	Текст = ДанныеКонтекста.ПолучитьТекст();

	Если Не ЗначениеЗаполнено(Текст) Тогда
		Сообщить("Заполните текст для модели.");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

// Дата обновления ставится по времени сеанса на сервере: время клиентского
// компьютера может расходиться с серверным.
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.ДатаАктуальности = ТекущаяДатаСеанса();
	ТекущийОбъект.ДанныеКонтекста = Новый ХранилищеЗначения(ДанныеКонтекста.ПолучитьТекст(), Новый СжатиеДанных(9));
КонецПроцедуры

#КонецОбласти