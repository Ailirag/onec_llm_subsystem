&НаКлиенте
Процедура СоздатьКонтрагентов(Команда)
	СоздатьКонтрагентовНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьКонтрагентовНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Ссылки = Обработка.СоздатьТестовыхКонтрагентов();

	ДобавитьВЛог(СтрШаблон("✓ Создано контрагентов: %1", Ссылки.Количество()));
	ДобавитьВЛог("  Они автоматически добавлены в AI_ОчередьПодготовкиКВекторизации");

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьВекторизацию(Команда)
	ЗапуститьВекторизациюНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗапуститьВекторизациюНаСервере()

	ДобавитьВЛог("→ Запускаю AI_ОбработкаОчередиПодготовкиКВекторизации...");

	Попытка
		AI_RAG.AI_ОбработкаОчередиПодготовкиКВекторизации();
		ДобавитьВЛог("✓ Подготовка завершена — данные записаны в AI_ОчередьВекторизации");
	Исключение
		ДобавитьВЛог("✗ Ошибка подготовки: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ДобавитьВЛог("→ Запускаю AI_ОбработкаОчередиВекторизации...");

	Попытка
		AI_RAG.AI_ОбработкаОчередиВекторизации();
		ДобавитьВЛог("✓ Векторизация завершена — данные отправлены в Qdrant");
	Исключение
		ДобавитьВЛог("✗ Ошибка векторизации: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПоиск(Команда)

	Если НЕ ЗначениеЗаполнено(КомпонентRAG) Тогда
		Сообщить("Выберите компонент RAG (справочник AI_RAG)");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Коллекция) Тогда
		Сообщить("Выберите коллекцию Qdrant");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТестЗапрос) Тогда
		Сообщить("Введите тестовый запрос");
		Возврат;
	КонецЕсли;

	ПроверитьПоискНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПроверитьПоискНаСервере()

	ДобавитьВЛог(СтрШаблон("→ Поиск: ""%1""", ТестЗапрос));

	Попытка

		КомпонентСтруктура = AI_RAG.ПолучитьСтруктуруКомпонентаRAG(КомпонентRAG);
		Коллекции = Справочники.AI_RAGКоллекции.ПолучитьЗначенияКоллекций(Коллекция);
		ИмяКол = Коллекции[Коллекция].Наименование;

		Обработка = РеквизитФормыВЗначение("Объект");
		ТЗ = Обработка.ВыполнитьТестовыйПоиск(КомпонентСтруктура, ИмяКол, ТестЗапрос);

		ЗначениеВРеквизитФормы(ТЗ, "РезТаблица");

		ДобавитьВЛог(СтрШаблон("✓ Найдено фрагментов: %1", ТЗ.Количество()));

		Для Каждого Строка Из ТЗ Цикл
			ДобавитьВЛог(СтрШаблон("  [Score: %1 | Заголовок: %2 | Полный текст: %3", Строка.Score, Строка.Заголовок, Строка.Текст));
		КонецЦикла;

	Исключение
		ДобавитьВЛог("✗ Ошибка поиска: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДанные(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ОчиститьДанныеПодтверждение", ЭтаФорма);
	
	ПоказатьВопрос(Оповещение, "Пометить на удаление все тестовые контрагенты ([AI_RAG_ТЕСТ])?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДанныеПодтверждение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьДанныеНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьДанныеНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Количество = Обработка.ОчиститьТестовыеДанные();
	ДобавитьВЛог(СтрШаблон("✓ Помечено на удаление: %1 контрагентов", Количество));

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтатус(Команда)

	Если НЕ ЗначениеЗаполнено(КомпонентRAG) Тогда
		Сообщить("Выберите компонент RAG");
		Возврат;
	КонецЕсли;

	ПроверитьСтатусНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПроверитьСтатусНаСервере()

	Попытка
		КомпонентСтруктура = AI_RAG.ПолучитьСтруктуруКомпонентаRAG(КомпонентRAG);
		Статус = AI_RAG.ПолучитьСтатусRAG(КомпонентСтруктура);

		ДобавитьВЛог("--- Статус компонентов ---");
		ДобавитьВЛог(СтрШаблон("Embedding: %1 (%2)",
			?(Статус.EmbeddingДоступен, "✓ ДОСТУПЕН", "✗ НЕДОСТУПЕН"),
			Статус.EmbeddingСтатус));
		ДобавитьВЛог(СтрШаблон("Qdrant:    %1 (%2)",
			?(Статус.QdrantДоступен, "✓ ДОСТУПЕН", "✗ НЕДОСТУПЕН"),
			Статус.QdrantСтатус));

	Исключение
		ДобавитьВЛог("✗ Ошибка проверки статуса: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ДобавитьВЛог(Текст)
	ЛогОпераций = ЛогОпераций
		+ Формат(ТекущаяДатаСеанса(), "ДФ=ЧЧ:мм:сс") + "  " + Текст + Символы.ПС;
КонецПроцедуры
