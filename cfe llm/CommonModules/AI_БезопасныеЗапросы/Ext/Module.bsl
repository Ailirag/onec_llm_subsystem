
Функция ПроверитьЗапрос(Знач ТекстЗапроса, Знач Параметры, Знач Политика) Экспорт

	Возврат ПроверитьЗапросПоПрофилю(ТекстЗапроса, Параметры, Политика, НовыйАнализЗапроса());

КонецФункции

// Проверяет запрос модели и заполняет Анализ тем, что нужно для выполнения:
// текстом, который собрала схема запроса, и перечнем проверенных колонок.
Функция ПроверитьЗапросПоПрофилю(Знач ТекстЗапроса, Знач Параметры, Знач Политика, Знач Анализ)

	Проверка = Новый Структура;
	Проверка.Вставить("ok", Ложь);
	Проверка.Вставить("error", "");
	Проверка.Вставить("sources", Новый Массив);
	Проверка.Вставить("row_limit", 0);
	Проверка.Вставить("aggregate", Ложь);

	Если Не AI_ПолитикиАгента.ДоступныЗапросы(Политика) Тогда
		Проверка.error = "Профиль не разрешает выполнение запросов к данным.";
		Возврат Проверка;
	КонецЕсли;

	ТекстЗапроса = СокрЛП(Строка(ТекстЗапроса));
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Проверка.error = "Текст запроса не заполнен.";
		Возврат Проверка;
	КонецЕсли;
	Если СтрДлина(ТекстЗапроса) > Политика.МаксимальнаяДлинаЗапроса Тогда
		Проверка.error = СтрШаблон(
			"Длина запроса превышает лимит профиля (%1).",
			Политика.МаксимальнаяДлинаЗапроса);
		Возврат Проверка;
	КонецЕсли;

	ТекстВерхний = ВРег(ТекстЗапроса);
	Если Не СтрНачинаетсяС(ТекстВерхний, "ВЫБРАТЬ") Тогда
		Проверка.error = "Разрешены только запросы, начинающиеся с ВЫБРАТЬ.";
		Возврат Проверка;
	КонецЕсли;
	Если СтрНайти(ТекстЗапроса, ";") > 0
			Или СтрНайти(ТекстЗапроса, "//") > 0
			Или СтрНайти(ТекстЗапроса, "/*") > 0 Тогда
		Проверка.error = "Пакетные запросы и комментарии запрещены.";
		Возврат Проверка;
	КонецЕсли;
	Если НайденоЗапрещенноеСлово(ТекстВерхний) Тогда
		Проверка.error = "В запросе обнаружена запрещенная конструкция.";
		Возврат Проверка;
	КонецЕсли;
	Попытка
		ОшибкаТекста = ПроверитьКонструкцииТекста(РазобратьНаЛексемы(ТекстЗапроса));
	Исключение
		ОшибкаТекста = "Синтаксическая ошибка запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если ЗначениеЗаполнено(ОшибкаТекста) Тогда
		Проверка.error = ОшибкаТекста;
		Возврат Проверка;
	КонецЕсли;

	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
	Исключение
		Проверка.error = "Синтаксическая ошибка запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Проверка;
	КонецПопытки;

	Если Схема.ПакетЗапросов.Количество() <> 1 Тогда
		Проверка.error = "Запрос должен содержать ровно один пакет.";
		Возврат Проверка;
	КонецЕсли;
	Пакет = Схема.ПакетЗапросов[0];
	Если ТипЗнч(Пакет) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
		Проверка.error = "Разрешен только запрос выборки.";
		Возврат Проверка;
	КонецЕсли;
	Если ЗначениеЗаполнено(Пакет.ТаблицаДляПомещения)
			Или ЗначениеЗаполнено(ТаблицаДляДобавления(Пакет)) Тогда
		Проверка.error = "Помещение результата во временную таблицу запрещено.";
		Возврат Проверка;
	КонецЕсли;

	ЛимитСтрок = ПолучитьЛимитСтрок(ТекстЗапроса);
	Если ЛимитСтрок = 0 Тогда
		Если ЭтоБезопасныйАгрегатныйЗапрос(ТекстЗапроса) Тогда
			ЛимитСтрок = 1;
			Проверка.aggregate = Истина;
		Иначе
			Проверка.error = "В верхнем SELECT требуется буквальный ограничитель ПЕРВЫЕ N. "
				+ "Без ПЕРВЫЕ разрешены только однострочные агрегаты без группировки, итогов и объединений.";
			Возврат Проверка;
		КонецЕсли;
	КонецЕсли;
	Если ЛимитСтрок > Политика.МаксимумСтрокРезультата Тогда
		Проверка.error = СтрШаблон(
			"ПЕРВЫЕ %1 превышает лимит профиля (%2).",
			ЛимитСтрок,
			Политика.МаксимумСтрокРезультата);
		Возврат Проверка;
	КонецЕсли;
	Проверка.row_limit = ЛимитСтрок;

	Для Каждого ОбъектМетаданных Из AI_МетаданныеСервер.ВсеОбъектыДляПроверкиЗапроса() Цикл
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Если Не СодержитПолноеИмя(ТекстЗапроса, ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Проверка.sources.Добавить(ПолноеИмя);
		Если Не AI_ПолитикиАгента.ОбъектРазрешен(Политика, ПолноеИмя) Тогда
			Проверка.error = "Объект не входит в белый список профиля: " + ПолноеИмя;
			Возврат Проверка;
		КонецЕсли;
	КонецЦикла;

	// Поиск по тексту выше видит только полные имена, записанные по-русски.
	// Разбор схемы находит и остальные источники: английские имена, вложенные
	// запросы, подзапросы в условиях, объекты, прочитанные через точку.
	Контекст = НовыйКонтекстПроверки(Политика);
	Попытка
		ПроанализироватьЗапросСхемы(Пакет, Контекст, Истина);
	Исключение
		Проверка.error = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Проверка;
	КонецПопытки;
	Для Каждого Источник Из Контекст.Источники Цикл
		Если Не МассивСодержитБезРегистра(Проверка.sources, Источник) Тогда
			Проверка.sources.Добавить(Источник);
		КонецЕсли;
	КонецЦикла;

	Если Проверка.sources.Количество() = 0 Тогда
		Проверка.error = "Не удалось определить источник данных запроса.";
		Возврат Проверка;
	КонецЕсли;

	ИменаПараметров = ПолучитьИменаПараметров(Параметры);
	Для Каждого Источник Из Проверка.sources Цикл
		Настройка = AI_ПолитикиАгента.НастройкаОбъекта(Политика, Источник);
		Если Настройка.ТребоватьПериод Тогда
			Если СтрНайти(ТекстВерхний, "&НАЧАЛОПЕРИОДА") = 0
					Или СтрНайти(ТекстВерхний, "&КОНЕЦПЕРИОДА") = 0
					Или ИменаПараметров.Получить("началопериода") = Неопределено
					Или ИменаПараметров.Получить("конецпериода") = Неопределено Тогда
				Проверка.error = "Для объекта " + Источник
					+ " профиль требует параметры &НачалоПериода и &КонецПериода.";
				Возврат Проверка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ОшибкаПараметров = ПроверитьПараметры(Параметры);
	Если ЗначениеЗаполнено(ОшибкаПараметров) Тогда
		Проверка.error = ОшибкаПараметров;
		Возврат Проверка;
	КонецЕсли;

	Проверка.ok = Истина;
	Анализ.ТекстДляВыполнения = Схема.ПолучитьТекстЗапроса();
	Анализ.КолонкиРезультата = Контекст.КолонкиРезультата;
	Анализ.ОграниченныеПредставления = Контекст.ОграниченныеПредставления;
	Возврат Проверка;

КонецФункции

Функция НовыйАнализЗапроса()

	Анализ = Новый Структура;
	Анализ.Вставить("ТекстДляВыполнения", "");
	Анализ.Вставить("КолонкиРезультата", Новый Соответствие);
	Анализ.Вставить("ОграниченныеПредставления", Новый Соответствие);
	Возврат Анализ;

КонецФункции

Функция ПосчитатьЗаписиСправочников(Знач Объекты, Знач МаксимумРезультатов, Знач ВключатьПустые, Знач Политика) Экспорт

	Если Не AI_ПолитикиАгента.ДоступныЗапросы(Политика) Тогда
		Возврат Новый Структура(
			"ok,error",
			Ложь,
			"Профиль не разрешает выполнение запросов к данным.");
	КонецЕсли;

	Попытка
		СписокСправочников = ПолучитьСправочникиДляПодсчета(Объекты, Политика);
	Исключение
		Возврат Новый Структура(
			"ok,error",
			Ложь,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если СписокСправочников.Количество() = 0 Тогда
		Возврат Новый Структура(
			"ok,error",
			Ложь,
			"В белом списке профиля нет справочников для подсчета.");
	КонецЕсли;

	МаксимумРезультатов = НормализоватьМаксимумРезультатов(МаксимумРезультатов);
	Результаты = Новый ТаблицаЗначений;
	Результаты.Колонки.Добавить("ПолноеИмя");
	Результаты.Колонки.Добавить("Представление");
	Результаты.Колонки.Добавить("Количество");
	Ошибки = Новый Массив;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Для Каждого Справочник Из СписокСправочников Цикл
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ"
				+ Символы.ПС + "    КОЛИЧЕСТВО(*) КАК Количество"
				+ Символы.ПС + "ИЗ"
				+ Символы.ПС + "    " + Справочник.ПолноеИмя;
			Выборка = Запрос.Выполнить().Выбрать();
			Количество = 0;
			Если Выборка.Следующий() Тогда
				Количество = Выборка.Количество;
			КонецЕсли;
			СтрокаРезультата = Результаты.Добавить();
			СтрокаРезультата.ПолноеИмя = Справочник.ПолноеИмя;
			СтрокаРезультата.Представление = Справочник.Представление;
			СтрокаРезультата.Количество = Количество;
		Исключение
			Ошибки.Добавить(Новый Структура(
				"object,error",
				Справочник.ПолноеИмя,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;

	Результаты.Сортировать("Количество Убыв, ПолноеИмя Возр");
	Элементы = Новый Массив;
	Для Каждого СтрокаРезультата Из Результаты Цикл
		Если Не ВключатьПустые И СтрокаРезультата.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Элементы.Количество() >= МаксимумРезультатов Тогда
			Прервать;
		КонецЕсли;
		Элементы.Добавить(Новый Структура(
			"object,presentation,count",
			СтрокаРезультата.ПолноеИмя,
			СтрокаРезультата.Представление,
			СтрокаРезультата.Количество));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("complete", Ошибки.Количество() = 0);
	Результат.Вставить("requested_count", СписокСправочников.Количество());
	Результат.Вставить("counted_count", Результаты.Количество());
	Результат.Вставить("duration_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	Результат.Вставить("items", Элементы);
	Результат.Вставить("errors", Ошибки);
	Если Элементы.Количество() > 0 Тогда
		Результат.Вставить("leader", Элементы[0]);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ВыполнитьЗапрос(Знач ТекстЗапроса, Знач Параметры, Знач Политика) Экспорт

	Анализ = НовыйАнализЗапроса();
	Проверка = ПроверитьЗапросПоПрофилю(ТекстЗапроса, Параметры, Политика, Анализ);
	Если Не Проверка.ok Тогда
		Возврат Проверка;
	КонецЕсли;

	// Выполняется текст, который схема запроса собрала из проверенной структуры:
	// проверяется и выполняется один и тот же запрос.
	Запрос = Новый Запрос;
	Запрос.Текст = Анализ.ТекстДляВыполнения;
	УстановитьПараметры(Запрос, Параметры);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		Возврат Новый Структура(
			"ok,error",
			Ложь,
			"Ошибка выполнения запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Таблица = РезультатЗапроса.Выгрузить();
	// Последний рубеж: модель получает только колонки, которые прошли проверку.
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Анализ.КолонкиРезультата.Получить(НРег(Колонка.Имя)) = Неопределено Тогда
			Возврат Новый Структура(
				"ok,error",
				Ложь,
				"Результат содержит колонку «" + Колонка.Имя
					+ "», которая не прошла проверку профиля доступа. Данные не переданы.");
		КонецЕсли;
	КонецЦикла;

	Колонки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Колонки.Добавить(Новый Структура(
			"name,type",
			Колонка.Имя,
			Строка(Колонка.ТипЗначения)));
	КонецЦикла;

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаРезультата = Новый Соответствие;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			СтрокаРезультата.Вставить(
				Колонка.Имя,
				ЗначениеДляJSON(СтрокаТаблицы[Колонка.Имя], Анализ.ОграниченныеПредставления));
		КонецЦикла;
		Строки.Добавить(СтрокаРезультата);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("sources", Проверка.sources);
	Результат.Вставить("row_limit", Проверка.row_limit);
	Результат.Вставить("row_count", Строки.Количество());
	Результат.Вставить("duration_ms", Длительность);
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Возврат Результат;

КонецФункции

Функция МассивСодержитБезРегистра(Знач МассивЗначений, Знач ИскомоеЗначение)

	ИскомоеЗначение = НРег(Строка(ИскомоеЗначение));
	Для Каждого ЗначениеМассива Из МассивЗначений Цикл
		Если НРег(Строка(ЗначениеМассива)) = ИскомоеЗначение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция НайденоЗапрещенноеСлово(Знач ТекстВерхний)

	Запрещенные = Новый Массив;
	Запрещенные.Добавить(" ПОМЕСТИТЬ ");
	Запрещенные.Добавить(" УНИЧТОЖИТЬ ");
	Запрещенные.Добавить(" ИЗМЕНИТЬ ");
	Запрещенные.Добавить(" ДЛЯ ИЗМЕНЕНИЯ ");
	Нормализованный = " " + НормализоватьПробелы(ТекстВерхний) + " ";
	Для Каждого Слово Из Запрещенные Цикл
		Если СтрНайти(Нормализованный, Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПолучитьЛимитСтрок(Знач ТекстЗапроса)

	Нормализованный = НормализоватьПробелы(ВРег(ТекстЗапроса));
	Если Не СтрНачинаетсяС(Нормализованный, "ВЫБРАТЬ ") Тогда
		Возврат 0;
	КонецЕсли;
	Хвост = СокрЛП(Сред(Нормализованный, СтрДлина("ВЫБРАТЬ ") + 1));
	Пока СтрНачинаетсяС(Хвост, "РАЗРЕШЕННЫЕ ")
			Или СтрНачинаетсяС(Хвост, "РАЗЛИЧНЫЕ ") Цикл
		Если СтрНачинаетсяС(Хвост, "РАЗРЕШЕННЫЕ ") Тогда
			Хвост = СокрЛП(Сред(Хвост, СтрДлина("РАЗРЕШЕННЫЕ ") + 1));
		Иначе
			Хвост = СокрЛП(Сред(Хвост, СтрДлина("РАЗЛИЧНЫЕ ") + 1));
		КонецЕсли;
	КонецЦикла;
	Если Не СтрНачинаетсяС(Хвост, "ПЕРВЫЕ ") Тогда
		Возврат 0;
	КонецЕсли;
	Хвост = Сред(Хвост, СтрДлина("ПЕРВЫЕ ") + 1);
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Цифры = Цифры + Символ;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Цифры) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Цифры);

КонецФункции

Функция ЭтоБезопасныйАгрегатныйЗапрос(Знач ТекстЗапроса)

	Нормализованный = НормализоватьПробелы(ВРег(ТекстЗапроса));
	ТекстДляПоиска = " " + Нормализованный + " ";
	Если СтрНайти(ТекстДляПоиска, " СГРУППИРОВАТЬ ПО ") > 0
			Или СтрНайти(ТекстДляПоиска, " ОБЪЕДИНИТЬ ") > 0
			Или СтрНайти(ТекстДляПоиска, " ИТОГИ ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	СписокПолей = ПолучитьСписокПолейВерхнегоВыбрать(Нормализованный);
	Если Не ЗначениеЗаполнено(СписокПолей) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Выражение Из РазделитьВерхнийУровень(СписокПолей) Цикл
		Если Не ЭтоАгрегатноеВыражение(Выражение) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ПолучитьСписокПолейВерхнегоВыбрать(Знач НормализованныйТекст)

	Если Не СтрНачинаетсяС(НормализованныйТекст, "ВЫБРАТЬ ") Тогда
		Возврат "";
	КонецЕсли;
	Хвост = СокрЛП(Сред(НормализованныйТекст, СтрДлина("ВЫБРАТЬ ") + 1));
	Пока СтрНачинаетсяС(Хвост, "РАЗРЕШЕННЫЕ ")
			Или СтрНачинаетсяС(Хвост, "РАЗЛИЧНЫЕ ") Цикл
		Если СтрНачинаетсяС(Хвост, "РАЗРЕШЕННЫЕ ") Тогда
			Хвост = СокрЛП(Сред(Хвост, СтрДлина("РАЗРЕШЕННЫЕ ") + 1));
		Иначе
			Хвост = СокрЛП(Сред(Хвост, СтрДлина("РАЗЛИЧНЫЕ ") + 1));
		КонецЕсли;
	КонецЦикла;

	Глубина = 0;
	ВСтроковомЛитерале = Ложь;
	Для Индекс = 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, Индекс, 1);
		Если Символ = """" Тогда
			ВСтроковомЛитерале = Не ВСтроковомЛитерале;
		ИначеЕсли Не ВСтроковомЛитерале Тогда
			Если Символ = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Символ = ")" Тогда
				Глубина = Макс(0, Глубина - 1);
			ИначеЕсли Глубина = 0 И Сред(Хвост, Индекс, 4) = " ИЗ " Тогда
				Возврат СокрЛП(Лев(Хвост, Индекс - 1));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция РазделитьВерхнийУровень(Знач СписокПолей)

	Результат = Новый Массив;
	НачалоВыражения = 1;
	Глубина = 0;
	ВСтроковомЛитерале = Ложь;
	Для Индекс = 1 По СтрДлина(СписокПолей) Цикл
		Символ = Сред(СписокПолей, Индекс, 1);
		Если Символ = """" Тогда
			ВСтроковомЛитерале = Не ВСтроковомЛитерале;
		ИначеЕсли Не ВСтроковомЛитерале Тогда
			Если Символ = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Символ = ")" Тогда
				Глубина = Макс(0, Глубина - 1);
			ИначеЕсли Символ = "," И Глубина = 0 Тогда
				Результат.Добавить(СокрЛП(Сред(СписокПолей, НачалоВыражения, Индекс - НачалоВыражения)));
				НачалоВыражения = Индекс + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Результат.Добавить(СокрЛП(Сред(СписокПолей, НачалоВыражения)));
	Возврат Результат;

КонецФункции

Функция ЭтоАгрегатноеВыражение(Знач Выражение)

	Выражение = СокрЛП(Выражение);
	Возврат СтрНачинаетсяС(Выражение, "КОЛИЧЕСТВО(")
		Или СтрНачинаетсяС(Выражение, "СУММА(")
		Или СтрНачинаетсяС(Выражение, "СРЕДНЕЕ(")
		Или СтрНачинаетсяС(Выражение, "МИНИМУМ(")
		Или СтрНачинаетсяС(Выражение, "МАКСИМУМ(");

КонецФункции

Функция ПолучитьСправочникиДляПодсчета(Знач ЗапрошенныеОбъекты, Знач Политика)

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;
	Если ЗапрошенныеОбъекты <> Неопределено И ЗапрошенныеОбъекты.Количество() > 0 Тогда
		Для Каждого ПолноеИмя Из ЗапрошенныеОбъекты Цикл
			ДобавитьСправочникДляПодсчета(Результат, Добавленные, ПолноеИмя, Политика);
		КонецЦикла;
	Иначе
		Для Каждого ЭлементПолитики Из Политика.РазрешенныеОбъекты Цикл
			Если СтрНачинаетсяС(НРег(ЭлементПолитики.Значение.ПолноеИмя), "справочник.") Тогда
				ДобавитьСправочникДляПодсчета(
					Результат,
					Добавленные,
					ЭлементПолитики.Значение.ПолноеИмя,
					Политика);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ДобавитьСправочникДляПодсчета(Знач Результат, Знач Добавленные, Знач ПолноеИмя, Знач Политика)

	ПолноеИмя = СокрЛП(Строка(ПолноеИмя));
	Если Не СтрНачинаетсяС(НРег(ПолноеИмя), "справочник.") Тогда
		ВызватьИсключение "Объект не является справочником: " + ПолноеИмя;
	КонецЕсли;
	Настройка = AI_ПолитикиАгента.НастройкаОбъекта(Политика, ПолноеИмя);
	Если Настройка = Неопределено Тогда
		ВызватьИсключение "Объект не входит в белый список профиля: " + ПолноеИмя;
	КонецЕсли;
	Если Настройка.ТребоватьПериод Тогда
		ВызватьИсключение "Для объекта профиль требует ограничение периода: " + ПолноеИмя;
	КонецЕсли;
	ОбъектМетаданных = AI_МетаданныеСервер.ПолучитьОбъектМетаданных(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение "Объект метаданных не найден: " + ПолноеИмя;
	КонецЕсли;

	Ключ = НРег(ОбъектМетаданных.ПолноеИмя());
	Если Добавленные.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Представление = СокрЛП(Строка(ОбъектМетаданных.Синоним));
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Представление = ОбъектМетаданных.Имя;
	КонецЕсли;
	Результат.Добавить(Новый Структура(
		"ПолноеИмя,Представление",
		ОбъектМетаданных.ПолноеИмя(),
		Представление));
	Добавленные.Вставить(Ключ, Истина);

КонецПроцедуры

Функция НормализоватьМаксимумРезультатов(Знач МаксимумРезультатов)

	Попытка
		МаксимумРезультатов = Цел(Число(МаксимумРезультатов));
	Исключение
		МаксимумРезультатов = 10;
	КонецПопытки;
	Возврат Макс(1, Мин(100, МаксимумРезультатов));

КонецФункции

Функция СодержитПолноеИмя(Знач ТекстЗапроса, Знач ПолноеИмя)

	Текст = НРег(ТекстЗапроса);
	Искомое = НРег(ПолноеИмя);
	Позиция = СтрНайти(Текст, Искомое);
	Пока Позиция > 0 Цикл
		СимволДо = ?(Позиция = 1, "", Сред(Текст, Позиция - 1, 1));
		СимволПосле = Сред(Текст, Позиция + СтрДлина(Искомое), 1);
		Если Не ЭтоСимволИдентификатора(СимволДо)
				И (Не ЭтоСимволИдентификатора(СимволПосле) Или СимволПосле = ".") Тогда
			Возврат Истина;
		КонецЕсли;
		СледующаяПозиция = СтрНайти(Сред(Текст, Позиция + 1), Искомое);
		Если СледующаяПозиция = 0 Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + СледующаяПозиция;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоСимволИдентификатора(Знач Символ)

	Если Не ЗначениеЗаполнено(Символ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Символ = НРег(Символ);
	Возврат СтрНайти("abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789_", Символ) > 0;

КонецФункции

Функция НормализоватьПробелы(Знач Текст)

	Результат = СтрЗаменить(Текст, Символы.ПС, " ");
	Результат = СтрЗаменить(Результат, Символы.ВК, " ");
	Результат = СтрЗаменить(Результат, Символы.Таб, " ");
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Результат);

КонецФункции

Функция ПроверитьПараметры(Знач Параметры)

	Если Параметры = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Параметр Из Параметры Цикл
		Имя = СокрЛП(Строка(ПолучитьСвойство(Параметр, "name", "")));
		Тип = НРег(СокрЛП(Строка(ПолучитьСвойство(Параметр, "type", "string"))));
		Если Не КорректноеИмяПараметра(Имя) Тогда
			Возврат "Некорректное имя параметра: " + Имя;
		КонецЕсли;
		Если СтрНайти(" string number boolean date ", " " + Тип + " ") = 0 Тогда
			Возврат "Неподдерживаемый тип параметра: " + Тип;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ПолучитьИменаПараметров(Знач Параметры)

	Результат = Новый Соответствие;
	Если Параметры = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Параметр Из Параметры Цикл
		Имя = НРег(СокрЛП(Строка(ПолучитьСвойство(Параметр, "name", ""))));
		Если ЗначениеЗаполнено(Имя) Тогда
			Результат.Вставить(Имя, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура УстановитьПараметры(Знач Запрос, Знач Параметры)

	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Параметр Из Параметры Цикл
		Имя = СокрЛП(Строка(ПолучитьСвойство(Параметр, "name", "")));
		Тип = НРег(СокрЛП(Строка(ПолучитьСвойство(Параметр, "type", "string"))));
		Значение = ПолучитьСвойство(Параметр, "value", Неопределено);
		Если Тип = "date" Тогда
			Значение = ДатаИзISOСтроки(Строка(Значение));
		ИначеЕсли Тип = "string" Тогда
			Значение = Строка(Значение);
		КонецЕсли;
		Запрос.УстановитьПараметр(Имя, Значение);
	КонецЦикла;

КонецПроцедуры

Функция ДатаИзISOСтроки(Знач СтрокаДаты)

	Цифры = СтрЗаменить(СтрокаДаты, "-", "");
	Цифры = СтрЗаменить(Цифры, ":", "");
	Цифры = СтрЗаменить(Цифры, "T", "");
	Цифры = СтрЗаменить(Цифры, "Z", "");
	Цифры = СтрЗаменить(Цифры, " ", "");
	Если СтрДлина(Цифры) < 8 Тогда
		ВызватьИсключение "Некорректная дата параметра: " + СтрокаДаты;
	КонецЕсли;
	Если СтрДлина(Цифры) = 8 Тогда
		Цифры = Цифры + "000000";
	КонецЕсли;
	Возврат Дата(Лев(Цифры, 14));

КонецФункции

Функция КорректноеИмяПараметра(Знач Имя)

	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Индекс, 1);
		Если Не ЭтоСимволИдентификатора(Символ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ПолучитьСвойство(Знач Объект, Знач ИмяСвойства, Знач ЗначениеПоУмолчанию)

	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Объект.Свойство(ИмяСвойства, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Значение = Объект.Получить(ИмяСвойства);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ЗначениеДляJSON(Знач Значение, Знач ОграниченныеПредставления = Неопределено)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
			Или ТипЗначения = Тип("Число")
			Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	КонецЕсли;
	Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Если ОграниченныеПредставления <> Неопределено И ОграниченныеПредставления.Количество() > 0 Тогда
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Если ОбъектМетаданных <> Неопределено
				И ОграниченныеПредставления.Получить(НРег(ОбъектМетаданных.ПолноеИмя())) <> Неопределено Тогда
			// Представление этой ссылки строится из поля, запрещенного профилем.
			Возврат Новый Структура(
				"type,presentation",
				Строка(ТипЗначения),
				"(скрыто профилем доступа)");
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура(
		"type,presentation",
		Строка(ТипЗначения),
		Строка(Значение));

КонецФункции

// Разбор запроса модели по схеме запроса.
//
// Схема запроса нормализует текст: раскрывает «*», дописывает имя таблицы
// к полю, переводит английские имена. Каждое выражение схемы разбирается на
// лексемы, и каждое обращение к полю проходит по доступным полям источника до
// конца цепочки, в том числе через точку от ссылки. Запрещенное профилем поле
// отклоняется в любой части запроса: в выборке, условиях, соединениях,
// группировке, сортировке и итогах, потому что отбор или сортировка по полю
// раскрывают его значение так же, как выборка. Что разобрать не удалось,
// отклоняется.

Функция НовыйКонтекстПроверки(Знач Политика)

	Контекст = Новый Структура;
	Контекст.Вставить("Политика", Политика);
	Контекст.Вставить("Ограничения", Новый Соответствие);
	Контекст.Вставить("ОграниченныеПредставления", Новый Соответствие);
	Контекст.Вставить("Источники", Новый Массив);
	Контекст.Вставить("ПоляОбъектов", Новый Соответствие);
	Контекст.Вставить("ПоляТаблиц", Новый Соответствие);
	Контекст.Вставить("КлючевыеСлова", КлючевыеСловаВыражений());
	Контекст.Вставить("КолонкиРезультата", Новый Соответствие);
	Контекст.Вставить("Глубина", 0);

	// Из этих полей платформа строит представление ссылки по умолчанию.
	ПоляПредставления = СтрРазделить("наименование,код,номер,дата", ",");
	Для Каждого Ограничение Из Политика.ОграниченныеПоля Цикл
		КлючОбъекта = НРег(СокрЛП(Ограничение.ПолноеИмяОбъекта));
		КлючПоля = НРег(СокрЛП(Ограничение.ИмяПоля));
		ПоляОбъекта = Контекст.Ограничения.Получить(КлючОбъекта);
		Если ПоляОбъекта = Неопределено Тогда
			ПоляОбъекта = Новый Соответствие;
			Контекст.Ограничения.Вставить(КлючОбъекта, ПоляОбъекта);
		КонецЕсли;
		ПоляОбъекта.Вставить(КлючПоля, Истина);
		Если ПоляПредставления.Найти(КлючПоля) <> Неопределено Тогда
			Контекст.ОграниченныеПредставления.Вставить(КлючОбъекта, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Контекст;

КонецФункции

Процедура ПроанализироватьЗапросСхемы(Знач ЗапросСхемы, Знач Контекст, Знач ЭтоВерхнийЗапрос)

	Контекст.Глубина = Контекст.Глубина + 1;
	Если Контекст.Глубина > 16 Тогда
		ВызватьИсключение "Слишком глубокая вложенность запросов.";
	КонецЕсли;
	Если КоличествоХарактеристик(ЗапросСхемы) > 0 Тогда
		ВызватьИсключение "Конструкция ХАРАКТЕРИСТИКИ в запросе агента запрещена.";
	КонецЕсли;

	ПсевдонимыПервогоОператора = Неопределено;
	Для Каждого Оператор Из ЗапросСхемы.Операторы Цикл
		Псевдонимы = Новый Соответствие;
		Для Каждого ИсточникСхемы Из Оператор.Источники Цикл
			Источник = ИсточникСхемы.Источник;
			Псевдонимы.Вставить(НРег(Источник.Псевдоним), ОписатьИсточник(Источник, Контекст));
		КонецЦикла;
		Окружение = НовоеОкружение(Псевдонимы);

		Для Каждого ИсточникСхемы Из Оператор.Источники Цикл
			Источник = ИсточникСхемы.Источник;
			Если ТипЗнч(Источник) = Тип("ТаблицаСхемыЗапроса") Тогда
				// Условие в параметрах виртуальной таблицы пишется от ее собственных полей.
				ОкружениеПараметров = НовоеОкружение();
				ОкружениеПараметров.НеявныйИсточник = Псевдонимы.Получить(НРег(Источник.Псевдоним));
				Для Каждого ПараметрТаблицы Из Источник.Параметры Цикл
					Если ЭтоПериодичностьВиртуальнойТаблицы(ПараметрТаблицы.Выражение) Тогда
						Продолжить;
					КонецЕсли;
					ПроверитьВыражение(ПараметрТаблицы.Выражение, Контекст, ОкружениеПараметров);
				КонецЦикла;
			КонецЕсли;
			Для Каждого Соединение Из ИсточникСхемы.Соединения Цикл
				ПроверитьВыражение(Соединение.Условие, Контекст, Окружение);
			КонецЦикла;
		КонецЦикла;

		Для Каждого ВыбираемоеПоле Из Оператор.ВыбираемыеПоля Цикл
			Если ТипЗнч(ВыбираемоеПоле) = Тип("ВложеннаяТаблицаСхемыЗапроса") Тогда
				Для Каждого ПолеТаблицы Из ВыбираемоеПоле.Поля Цикл
					ПроверитьВыражение(ПолеТаблицы, Контекст, Окружение);
				КонецЦикла;
			Иначе
				ПроверитьВыражение(ВыбираемоеПоле, Контекст, Окружение);
			КонецЕсли;
		КонецЦикла;
		// Отбор содержит и условия ГДЕ, и условия ИМЕЮЩИЕ.
		Для Каждого Условие Из Оператор.Отбор Цикл
			ПроверитьВыражение(Условие, Контекст, Окружение);
		КонецЦикла;
		// Группирующие наборы схема запроса не раскрывает, их поля не проверить.
		Если ТипЗнч(Оператор.Группировка) <> Тип("ВыраженияСхемыЗапроса") Тогда
			ВызватьИсключение "Группирующие наборы в запросе агента не поддерживаются.";
		КонецЕсли;
		Для Каждого ВыражениеГруппировки Из Оператор.Группировка Цикл
			ПроверитьВыражение(ВыражениеГруппировки, Контекст, Окружение);
		КонецЦикла;
		Если ПсевдонимыПервогоОператора = Неопределено Тогда
			ПсевдонимыПервогоОператора = Псевдонимы;
		КонецЕсли;
	КонецЦикла;

	// Сортировка и итоги ссылаются на колонки результата или на поля первого оператора.
	Колонки = Новый Соответствие;
	Для Каждого Колонка Из ЗапросСхемы.Колонки Цикл
		Колонки.Вставить(НРег(Колонка.Псевдоним), Истина);
	КонецЦикла;
	ОкружениеРезультата = НовоеОкружение(ПсевдонимыПервогоОператора);
	ОкружениеРезультата.Колонки = Колонки;
	Для Каждого ЭлементПорядка Из ЗапросСхемы.Порядок Цикл
		Если ТипЗнч(ЭлементПорядка.Элемент) = Тип("ВыражениеСхемыЗапроса") Тогда
			ПроверитьВыражение(ЭлементПорядка.Элемент, Контекст, ОкружениеРезультата);
		КонецЕсли;
	КонецЦикла;
	// Контрольная точка итогов по полю вне выборки добавляет в результат свою колонку.
	Для Каждого КонтрольнаяТочка Из ЗапросСхемы.КонтрольныеТочкиИтогов Цикл
		Если ТипЗнч(КонтрольнаяТочка.Выражение) = Тип("ВыражениеСхемыЗапроса") Тогда
			ПроверитьВыражение(КонтрольнаяТочка.Выражение, Контекст, ОкружениеРезультата);
		КонецЕсли;
		Колонки.Вставить(НРег(КонтрольнаяТочка.ИмяКолонки), Истина);
	КонецЦикла;
	Для Каждого ВыражениеИтога Из ЗапросСхемы.ВыраженияИтогов Цикл
		ПроверитьВыражение(ВыражениеИтога.Выражение, Контекст, ОкружениеРезультата);
	КонецЦикла;

	Если ЭтоВерхнийЗапрос Тогда
		Контекст.КолонкиРезультата = Колонки;
	КонецЕсли;
	Контекст.Глубина = Контекст.Глубина - 1;

КонецПроцедуры

Функция ОписатьИсточник(Знач Источник, Знач Контекст)

	Если ТипЗнч(Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
		ПроанализироватьЗапросСхемы(Источник.Запрос, Контекст, Ложь);
		// Колонки вложенного запроса уже проверены. Снаружи остается проверить
		// только обращения через точку от его ссылочных колонок.
		Возврат НовоеОписаниеИсточника(Источник.ДоступныеПоля, Новый Массив);
	КонецЕсли;
	Если ТипЗнч(Источник) <> Тип("ТаблицаСхемыЗапроса") Тогда
		ВызватьИсключение "Источник данных запроса не поддерживается: "
			+ "разрешены таблицы из белого списка профиля и вложенные запросы.";
	КонецЕсли;

	ИмяТаблицы = Источник.ИмяТаблицы;
	Части = СтрРазделить(ИмяТаблицы, ".");
	ОбъектМетаданных = Неопределено;
	Если Части.Количество() = 2 Или Части.Количество() = 3 Тогда
		ОбъектМетаданных = НайтиОбъектМетаданных(Части[0] + "." + Части[1]);
	КонецЕсли;
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение "Источник данных запроса не поддерживается: " + ИмяТаблицы;
	КонецЕсли;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Если Не AI_ПолитикиАгента.ОбъектРазрешен(Контекст.Политика, ПолноеИмя) Тогда
		ВызватьИсключение "Объект не входит в белый список профиля: " + ПолноеИмя;
	КонецЕсли;
	Если Не МассивСодержитБезРегистра(Контекст.Источники, ПолноеИмя) Тогда
		Контекст.Источники.Добавить(ПолноеИмя);
	КонецЕсли;

	Владелец = НовыйВладелецПолей(ОбъектМетаданных, Истина);
	Если Части.Количество() = 3 Тогда
		ТабличнаяЧасть = ИмяТабличнойЧасти(ОбъектМетаданных, Части[2]);
		Если ЗначениеЗаполнено(ТабличнаяЧасть) Тогда
			Владелец.ТабличнаяЧасть = ТабличнаяЧасть;
		Иначе
			Владелец.ВиртуальнаяТаблица = Части[2];
		КонецЕсли;
	КонецЕсли;
	Владельцы = Новый Массив;
	Владельцы.Добавить(Владелец);
	Возврат НовоеОписаниеИсточника(Источник.ДоступныеПоля, Владельцы);

КонецФункции

Процедура ПроанализироватьТекстПодзапроса(Знач Текст, Знач Контекст)

	Схема = Новый СхемаЗапроса;
	Попытка
		Схема.УстановитьТекстЗапроса(Текст);
	Исключение
		ВызватьИсключение "Не удалось разобрать вложенный запрос в условии: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Схема.ПакетЗапросов.Количество() <> 1
			Или ТипЗнч(Схема.ПакетЗапросов[0]) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
		ВызватьИсключение "Вложенный запрос в условии должен быть одним запросом выборки.";
	КонецЕсли;
	ПроанализироватьЗапросСхемы(Схема.ПакетЗапросов[0], Контекст, Ложь);

КонецПроцедуры

Процедура ПроверитьВыражение(Знач Выражение, Знач Контекст, Знач Окружение)

	Текст = Строка(Выражение);
	Разбор = Новый Структура;
	Разбор.Вставить("Текст", Текст);
	Разбор.Вставить("Лексемы", РазобратьНаЛексемы(Текст));
	Разбор.Вставить("Функции", Новый Массив);
	Разбор.Вставить("ТипыПриведения", Новый Массив);

	Индекс = 0;
	Пока Индекс < Разбор.Лексемы.Количество() Цикл
		Лексема = Разбор.Лексемы[Индекс];
		Если Лексема.Вид = "символ" Тогда
			Индекс = РазобратьСимвол(Разбор, Индекс, Контекст);
		ИначеЕсли Лексема.Вид = "идентификатор" Тогда
			Индекс = РазобратьИдентификатор(Разбор, Индекс, Контекст, Окружение);
		ИначеЕсли Лексема.Вид = "параметр" И ЭтоСимволЛексемы(Разбор.Лексемы, Индекс + 1, ".") Тогда
			ВызватьИсключение "Обращение к полям параметра запроса не поддерживается: " + Лексема.Значение;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Если Разбор.Функции.Количество() > 0 Тогда
		ВызватьИсключение "В выражении запроса не закрыта скобка: " + Текст;
	КонецЕсли;

КонецПроцедуры

Функция РазобратьСимвол(Знач Разбор, Знач Индекс, Знач Контекст)

	Лексемы = Разбор.Лексемы;
	Символ = Лексемы[Индекс].Значение;
	Если Символ = "(" Тогда
		Если ЭтоСловоЛексемы(Лексемы, Индекс + 1, "ВЫБРАТЬ,SELECT") Тогда
			Закрывающая = ИндексЗакрывающейСкобки(Лексемы, Индекс);
			Начало = Лексемы[Индекс + 1].Начало;
			ПроанализироватьТекстПодзапроса(
				Сред(Разбор.Текст, Начало, Лексемы[Закрывающая].Начало - Начало),
				Контекст);
			Возврат Закрывающая + 1;
		КонецЕсли;
		ИмяФункции = ИмяФункцииПередСкобкой(Лексемы, Индекс);
		Если ЗначениеЗаполнено(ИмяФункции) И СтрНайти(",ЗНАЧЕНИЕ,VALUE,ТИП,TYPE,", "," + ИмяФункции + ",") > 0 Тогда
			// В скобках имя метаданных или типа, а не поле.
			Закрывающая = ИндексЗакрывающейСкобки(Лексемы, Индекс);
			Если ЭтоСимволЛексемы(Лексемы, Закрывающая + 1, ".") Тогда
				ВызватьИсключение "Обращение к полям результата функции " + ИмяФункции + " не поддерживается.";
			КонецЕсли;
			Возврат Закрывающая + 1;
		КонецЕсли;
		Разбор.Функции.Добавить(ИмяФункции);
		Разбор.ТипыПриведения.Добавить("");
		Возврат Индекс + 1;
	КонецЕсли;

	Если Символ = ")" Тогда
		Если Разбор.Функции.Количество() = 0 Тогда
			ВызватьИсключение "В выражении запроса лишняя закрывающая скобка: " + Разбор.Текст;
		КонецЕсли;
		Последний = Разбор.Функции.ВГраница();
		ИмяФункции = Разбор.Функции[Последний];
		ТипПриведения = Разбор.ТипыПриведения[Последний];
		Разбор.Функции.Удалить(Последний);
		Разбор.ТипыПриведения.Удалить(Последний);
		Если Не ЭтоСимволЛексемы(Лексемы, Индекс + 1, ".") Тогда
			Возврат Индекс + 1;
		КонецЕсли;
		Если (ИмяФункции <> "ВЫРАЗИТЬ" И ИмяФункции <> "CAST") Или Не ЗначениеЗаполнено(ТипПриведения) Тогда
			ВызватьИсключение "Обращение к полю результата выражения поддерживается только "
				+ "для ВЫРАЗИТЬ(... КАК <ссылочный тип>).";
		КонецЕсли;
		Имена = Новый Массив;
		Следующий = ПрочитатьЦепочку(Лексемы, Индекс + 2, Имена);
		Если Имена.Количество() = 0 Или ЭтоСимволЛексемы(Лексемы, Следующий, ".") Тогда
			ВызватьИсключение "Не удалось разобрать обращение к полю после ВЫРАЗИТЬ: " + Разбор.Текст;
		КонецЕсли;
		ПроверитьЦепочкуПриведения(ТипПриведения, Имена, Контекст, ВнутриПредставления(Разбор));
		Возврат Следующий;
	КонецЕсли;

	Если СтрНайти(".{}[];", Символ) > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Не удалось разобрать выражение запроса: неожиданный символ «%1».",
			Символ);
	КонецЕсли;
	Возврат Индекс + 1;

КонецФункции

Функция РазобратьИдентификатор(Знач Разбор, Знач Индекс, Знач Контекст, Знач Окружение)

	Лексемы = Разбор.Лексемы;
	Слово = Лексемы[Индекс].Верх;
	Если ЭтоСимволЛексемы(Лексемы, Индекс + 1, "(") Тогда
		// Имя функции или ключевое слово перед скобкой; скобку разберет РазобратьСимвол.
		Возврат Индекс + 1;
	КонецЕсли;
	Если Не ЭтоСимволЛексемы(Лексемы, Индекс + 1, ".") Тогда
		Если Слово = "ССЫЛКА" Или Слово = "REFS" Тогда
			// После ССЫЛКА стоит имя таблицы, а не поле.
			Возврат ПрочитатьЦепочку(Лексемы, Индекс + 1, Новый Массив);
		КонецЕсли;
		Если Слово = "КАК" Или Слово = "AS" Тогда
			// После КАК в ВЫРАЗИТЬ стоит тип; ссылочный тип нужен для «ВЫРАЗИТЬ(...).Поле».
			ИменаТипа = Новый Массив;
			Следующий = ПрочитатьЦепочку(Лексемы, Индекс + 1, ИменаТипа);
			Если ИменаТипа.Количество() > 1 И Разбор.ТипыПриведения.Количество() > 0 Тогда
				Разбор.ТипыПриведения[Разбор.ТипыПриведения.ВГраница()] = СтрСоединить(ИменаТипа, ".");
			КонецЕсли;
			Возврат Следующий;
		КонецЕсли;
		Если Контекст.КлючевыеСлова.Получить(Слово) <> Неопределено Тогда
			Возврат Индекс + 1;
		КонецЕсли;
	КонецЕсли;

	Имена = Новый Массив;
	Следующий = ПрочитатьЦепочку(Лексемы, Индекс, Имена);
	Если ЭтоСимволЛексемы(Лексемы, Следующий, ".") Или ЭтоСимволЛексемы(Лексемы, Следующий, "(") Тогда
		ВызватьИсключение СтрШаблон(
			"Не удалось разобрать обращение к полю «%1» в выражении запроса.",
			СтрСоединить(Имена, "."));
	КонецЕсли;
	ПроверитьЦепочку(Имена, Контекст, Окружение, ВнутриПредставления(Разбор));
	Возврат Следующий;

КонецФункции

Процедура ПроверитьЦепочку(Знач Имена, Знач Контекст, Знач Окружение, Знач ВнутриПредставления)

	Обращение = СтрСоединить(Имена, ".");
	Первое = НРег(Имена[0]);
	Если Имена.Количество() = 1
			И Окружение.Колонки <> Неопределено
			И Окружение.Колонки.Получить(Первое) <> Неопределено Тогда
		// Колонка результата этого же запроса уже проверена.
		Возврат;
	КонецЕсли;

	Описание = Неопределено;
	Начало = 0;
	Если Окружение.Псевдонимы <> Неопределено Тогда
		Описание = Окружение.Псевдонимы.Получить(Первое);
	КонецЕсли;
	Если Описание <> Неопределено Тогда
		Начало = 1;
	Иначе
		Описание = Окружение.НеявныйИсточник;
	КонецЕсли;
	Если Описание = Неопределено Или Начало >= Имена.Количество() Тогда
		ВызватьИсключение СтрШаблон(
			"Не удалось определить источник поля «%1» в выражении запроса.",
			Обращение);
	КонецЕсли;
	ПройтиЦепочку(Описание, Имена, Начало, Обращение, Контекст, ВнутриПредставления);

КонецПроцедуры

Процедура ПроверитьЦепочкуПриведения(Знач ИмяТипа, Знач Имена, Знач Контекст, Знач ВнутриПредставления)

	Обращение = "ВЫРАЗИТЬ(... КАК " + ИмяТипа + ")." + СтрСоединить(Имена, ".");
	ОбъектМетаданных = НайтиОбъектМетаданных(ИмяТипа);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение "Не удалось определить тип в обращении «" + Обращение + "».";
	КонецЕсли;
	Владельцы = Новый Массив;
	Владельцы.Добавить(НовыйВладелецПолей(ОбъектМетаданных, Ложь));
	ПройтиЦепочку(
		НовоеОписаниеИсточника(ДоступныеПоляТаблицы(ОбъектМетаданных.ПолноеИмя(), Контекст), Владельцы),
		Имена,
		0,
		Обращение,
		Контекст,
		ВнутриПредставления);

КонецПроцедуры

// Проходит цепочку «Поле.Поле...» по доступным полям источника. На каждом шаге
// поле сверяется с запретами профиля у всех объектов, из которых оно может быть
// прочитано, а объект, достигнутый через точку от ссылки, — с белым списком.
Процедура ПройтиЦепочку(
		Знач Описание,
		Знач Имена,
		Знач Начало,
		Знач Обращение,
		Знач Контекст,
		Знач ВнутриПредставления)

	Поля = Описание.ДоступныеПоля;
	Владельцы = Описание.Владельцы;
	Типы = Неопределено;
	ТабличнаяЧасть = "";
	Для Индекс = Начало По Имена.ВГраница() Цикл
		Имя = Имена[Индекс];
		Если Индекс > Начало Тогда
			Если ЗначениеЗаполнено(ТабличнаяЧасть) Тогда
				Владельцы = ВладельцыКолонокТабличнойЧасти(Владельцы, ТабличнаяЧасть);
			Иначе
				Владельцы = ВладельцыПоляПоТипам(Типы, Имя, Контекст);
				Если Владельцы.Количество() = 0 И Не ЭтоСлужебноеПолеСсылки(Имя) Тогда
					ВызватьИсключение СтрШаблон(
						"Не удалось определить объект, из которого читается поле «%1».",
						Обращение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ПроверитьПолеВладельцев(Владельцы, Имя, Обращение, Контекст);

		ДоступноеПоле = НайтиДоступноеПоле(Поля, Имя);
		ТипыПоля = Неопределено;
		Если ДоступноеПоле = Неопределено И Индекс > Начало И Не ЗначениеЗаполнено(ТабличнаяЧасть) Тогда
			// Платформа раскрывает не каждую ссылку: у «Ссылка» основной таблицы
			// подполей нет. Тогда поле ищется в таблицах объектов, куда ведет ссылка.
			ДоступноеПоле = НайтиПолеВТаблицахВладельцев(Владельцы, Имя, Контекст, ТипыПоля);
		КонецЕсли;
		Если ДоступноеПоле = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Поле «%1» не найдено среди доступных полей источника.",
				Обращение);
		КонецЕсли;
		Если ТипЗнч(ДоступноеПоле) = Тип("ДоступнаяВложеннаяТаблицаСхемыЗапроса") Тогда
			ТабличнаяЧасть = ДоступноеПоле.Имя;
			Типы = Неопределено;
		Иначе
			ТабличнаяЧасть = "";
			Типы = ?(ТипыПоля = Неопределено, ДоступноеПоле.ТипЗначения, ТипыПоля);
		КонецЕсли;
		Поля = ДоступноеПоле.Поля;
	КонецЦикла;

	Если ВнутриПредставления И Типы <> Неопределено Тогда
		ПроверитьПредставлениеСсылок(Типы, Обращение, Контекст);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПолеВладельцев(Знач Владельцы, Знач Имя, Знач Обращение, Знач Контекст)

	ИмяНРег = НРег(Имя);
	Если ИмяНРег = "ссылка" Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Владелец Из Владельцы Цикл
		Если ИмяНРег = "представление" И Не ЗначениеЗаполнено(Владелец.ТабличнаяЧасть) Тогда
			// Представление ссылки модель получает и без обращения к полю, поэтому
			// белый список здесь не нужен, а запреты полей представления нужны.
			Если Контекст.ОграниченныеПредставления.Получить(НРег(Владелец.ПолноеИмя)) <> Неопределено Тогда
				ВызватьИсключение СтрШаблон(
					"Представление %1 строится из поля, запрещенного профилем доступа (обращение «%2»).",
					Владелец.ПолноеИмя,
					Обращение);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Не Владелец.БелыйСписокПроверен Тогда
			Если Не AI_ПолитикиАгента.ОбъектРазрешен(Контекст.Политика, Владелец.ПолноеИмя) Тогда
				ВызватьИсключение СтрШаблон(
					"Поле «%1» читает объект %2, которого нет в белом списке профиля.",
					Обращение,
					Владелец.ПолноеИмя);
			КонецЕсли;
			Владелец.БелыйСписокПроверен = Истина;
		КонецЕсли;
		ПоляОбъекта = Контекст.Ограничения.Получить(НРег(Владелец.ПолноеИмя));
		Если ПоляОбъекта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ключ Из КлючиОграниченияПоля(Владелец, Имя) Цикл
			Если ПоляОбъекта.Получить(НРег(Ключ)) <> Неопределено Тогда
				ВызватьИсключение СтрШаблон(
					"Поле %1.%2 запрещено профилем доступа и не может использоваться в запросе (обращение «%3»).",
					Владелец.ПолноеИмя,
					Ключ,
					Обращение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Имена, под которыми поле может стоять в запретах профиля: колонка табличной
// части записывается как «ТабличнаяЧасть.Колонка», поле виртуальной таблицы
// регистра («СуммаОстаток») наследует запрет поля регистра («Сумма»).
Функция КлючиОграниченияПоля(Знач Владелец, Знач Имя)

	Ключи = Новый Массив;
	Если ЗначениеЗаполнено(Владелец.ТабличнаяЧасть) Тогда
		Ключи.Добавить(Владелец.ТабличнаяЧасть + "." + Имя);
		Ключи.Добавить(Владелец.ТабличнаяЧасть);
	ИначеЕсли ЗначениеЗаполнено(Владелец.ВиртуальнаяТаблица) Тогда
		Ключи = ПоляРегистраДляВиртуальногоПоля(Владелец.ОбъектМетаданных, Имя);
	Иначе
		Ключи.Добавить(Имя);
	КонецЕсли;
	// Момент времени раскрывает дату документа или период записи регистра.
	Если НРег(Имя) = "моментвремени" Тогда
		Ключи.Добавить("Дата");
		Ключи.Добавить("Период");
	КонецЕсли;
	Возврат Ключи;

КонецФункции

Функция ПоляРегистраДляВиртуальногоПоля(Знач ОбъектМетаданных, Знач ИмяПоля)

	Результат = Новый Массив;
	Результат.Добавить(ИмяПоля);
	ИмяНРег = НРег(ИмяПоля);
	Подходящие = Новый Массив;
	СамоеДлинное = "";
	Для Каждого ИмяКоллекции Из СтрРазделить("Измерения,Ресурсы,Реквизиты,СтандартныеРеквизиты", ",") Цикл
		Попытка
			Коллекция = ОбъектМетаданных[ИмяКоллекции];
		Исключение
			Продолжить;
		КонецПопытки;
		Для Каждого Поле Из Коллекция Цикл
			ИмяБазы = НРег(Поле.Имя);
			Если ИмяБазы = ИмяНРег Или Не СтрНачинаетсяС(ИмяНРег, ИмяБазы) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрДлина(Поле.Имя) > СтрДлина(СамоеДлинное) Тогда
				СамоеДлинное = Поле.Имя;
			КонецЕсли;
			Если ЭтоСуффиксВиртуальногоПоля(Сред(ИмяНРег, СтрДлина(ИмяБазы) + 1)) Тогда
				Подходящие.Добавить(Поле.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	// Незнакомый суффикс: поле считается производным от самого длинного поля
	// регистра, с имени которого начинается.
	Если Подходящие.Количество() = 0 И ЗначениеЗаполнено(СамоеДлинное) Тогда
		Подходящие.Добавить(СамоеДлинное);
	КонецЕсли;
	Для Каждого ИмяБазы Из Подходящие Цикл
		Результат.Добавить(ИмяБазы);
	КонецЦикла;
	// Поля периодичности («МесяцПериод») строятся из периода записи.
	Если СтрЗаканчиваетсяНа(ИмяНРег, "период") И ИмяНРег <> "период" Тогда
		Результат.Добавить("Период");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЭтоСуффиксВиртуальногоПоля(Знач Суффикс)

	Суффиксы = ",остаток,начальныйостаток,конечныйостаток,оборот,приход,расход,"
		+ "остатокдт,остатоккт,развернутыйостатокдт,развернутыйостатоккт,"
		+ "начальныйостатокдт,начальныйостатоккт,"
		+ "начальныйразвернутыйостатокдт,начальныйразвернутыйостатоккт,"
		+ "конечныйостатокдт,конечныйостатоккт,"
		+ "конечныйразвернутыйостатокдт,конечныйразвернутыйостатоккт,"
		+ "оборотдт,обороткт,дт,кт,база,";
	Возврат СтрНайти(Суффиксы, "," + Суффикс + ",") > 0;

КонецФункции

Функция ВладельцыПоляПоТипам(Знач Типы, Знач Имя, Знач Контекст)

	Результат = Новый Массив;
	Если Типы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Все = Новый Массив;
	Для Каждого ТипЗначенияПоля Из Типы.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначенияПоля);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Владелец = НовыйВладелецПолей(ОбъектМетаданных, Ложь);
		Все.Добавить(Владелец);
		Если ОбъектСодержитПоле(ОбъектМетаданных, Имя, Контекст) Тогда
			Результат.Добавить(Владелец);
		КонецЕсли;
	КонецЦикла;
	// Служебного поля вроде «Порядок» нет в описании метаданных: тогда поле
	// считается прочитанным из каждого объекта составного типа.
	Если Результат.Количество() = 0 Тогда
		Возврат Все;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ВладельцыКолонокТабличнойЧасти(Знач Владельцы, Знач ТабличнаяЧасть)

	Результат = Новый Массив;
	Для Каждого Владелец Из Владельцы Цикл
		// Белый список объекта проверен на шаге табличной части.
		ВладелецКолонок = НовыйВладелецПолей(Владелец.ОбъектМетаданных, Истина);
		ВладелецКолонок.ТабличнаяЧасть = ТабличнаяЧасть;
		Результат.Добавить(ВладелецКолонок);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОбъектСодержитПоле(Знач ОбъектМетаданных, Знач Имя, Знач Контекст)

	Ключ = НРег(ОбъектМетаданных.ПолноеИмя() + "|" + Имя);
	Результат = Контекст.ПоляОбъектов.Получить(Ключ);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = Ложь;
	ИмяНРег = НРег(Имя);
	Коллекции = СтрРазделить(
		"СтандартныеРеквизиты,Реквизиты,ТабличныеЧасти,СтандартныеТабличныеЧасти,"
			+ "РеквизитыАдресации,ПризнакиУчета",
		",");
	Для Каждого ИмяКоллекции Из Коллекции Цикл
		Попытка
			Коллекция = ОбъектМетаданных[ИмяКоллекции];
		Исключение
			Продолжить;
		КонецПопытки;
		Для Каждого ЭлементКоллекции Из Коллекция Цикл
			Если НРег(ЭлементКоллекции.Имя) = ИмяНРег Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Результат Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Контекст.ПоляОбъектов.Вставить(Ключ, Результат);
	Возврат Результат;

КонецФункции

Процедура ПроверитьПредставлениеСсылок(Знач Типы, Знач Обращение, Знач Контекст)

	Для Каждого ТипЗначенияПоля Из Типы.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначенияПоля);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Если Контекст.ОграниченныеПредставления.Получить(НРег(ПолноеИмя)) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Представление %1 строится из поля, запрещенного профилем доступа (обращение «%2»).",
				ПолноеИмя,
				Обращение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Ищет поле в таблицах объектов, на которые ведет ссылка. Типы поля объединяются
// по всем объектам: дальше по цепочке проверяются все, из которых оно читается.
Функция НайтиПолеВТаблицахВладельцев(Знач Владельцы, Знач Имя, Знач Контекст, ТипыПоля)

	Найденное = Неопределено;
	ВсеТипы = Новый Массив;
	Для Каждого Владелец Из Владельцы Цикл
		ПолеВладельца = НайтиДоступноеПоле(ДоступныеПоляТаблицы(Владелец.ПолноеИмя, Контекст), Имя);
		Если ПолеВладельца = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Найденное = Неопределено Тогда
			Найденное = ПолеВладельца;
		КонецЕсли;
		Если ТипЗнч(ПолеВладельца) = Тип("ДоступноеПолеСхемыЗапроса") Тогда
			Для Каждого ТипЗначенияПоля Из ПолеВладельца.ТипЗначения.Типы() Цикл
				ВсеТипы.Добавить(ТипЗначенияПоля);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	ТипыПоля = Новый ОписаниеТипов(ВсеТипы);
	Возврат Найденное;

КонецФункции

// Доступные поля таблицы объекта дает вспомогательная схема запроса к ней.
Функция ДоступныеПоляТаблицы(Знач ПолноеИмя, Знач Контекст)

	Ключ = НРег(ПолноеИмя);
	Поля = Контекст.ПоляТаблиц.Получить(Ключ);
	Если Поля = Неопределено Тогда
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(СтрШаблон(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ %1 КАК Т",
			ПолноеИмя));
		Поля = Схема.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.ДоступныеПоля;
		Контекст.ПоляТаблиц.Вставить(Ключ, Поля);
	КонецЕсли;
	Возврат Поля;

КонецФункции

Функция НайтиДоступноеПоле(Знач Поля, Знач Имя)

	Если Поля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяНРег = НРег(Имя);
	Для Каждого Поле Из Поля Цикл
		Если НРег(Поле.Имя) = ИмяНРег Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ЭтоСлужебноеПолеСсылки(Знач Имя)

	ИмяНРег = НРег(Имя);
	Возврат ИмяНРег = "ссылка" Или ИмяНРег = "представление";

КонецФункции

Функция НовыйВладелецПолей(Знач ОбъектМетаданных, Знач БелыйСписокПроверен)

	Владелец = Новый Структура;
	Владелец.Вставить("ОбъектМетаданных", ОбъектМетаданных);
	Владелец.Вставить("ПолноеИмя", ОбъектМетаданных.ПолноеИмя());
	Владелец.Вставить("ТабличнаяЧасть", "");
	Владелец.Вставить("ВиртуальнаяТаблица", "");
	Владелец.Вставить("БелыйСписокПроверен", БелыйСписокПроверен);
	Возврат Владелец;

КонецФункции

Функция НовоеОписаниеИсточника(Знач ДоступныеПоля, Знач Владельцы)

	Возврат Новый Структура("ДоступныеПоля,Владельцы", ДоступныеПоля, Владельцы);

КонецФункции

Функция НовоеОкружение(Знач Псевдонимы = Неопределено)

	Возврат Новый Структура(
		"Псевдонимы,Колонки,НеявныйИсточник",
		Псевдонимы,
		Неопределено,
		Неопределено);

