
Функция ОбеспечитьСтандартныхПровайдеров() Экспорт

	Возврат Справочники.AI_Провайдеры.ОбеспечитьСтандартныхПровайдеров();

КонецФункции

Процедура ОчиститьУстаревшие() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	СрокЛогов    = Константы.AI_СрокХраненияЖурналаЗапросовДней.Получить();
	СрокДиалогов = Константы.AI_СрокХраненияДиалоговДней.Получить();

	УдаленоЛогов    = ОчиститьЖурналЗапросов(СрокЛогов);
	УдаленоДиалогов = ОчиститьДиалоги(СрокДиалогов);
	ОчищеноВложений = AI_Вложения.ОчиститьУстаревшиеДвоичныеДанные();

	ЗаписьЖурналаРегистрации(
		"AI_Обслуживание",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон(
			"Очистка: удалено %1 записей AI_ЖурналЗапросов (срок %2 дн.), "
			+ "%3 диалогов (срок %4 дн.), очищено двоичных данных вложений: %5",
			УдаленоЛогов, СрокЛогов, УдаленоДиалогов, СрокДиалогов,
			ОчищеноВложений));

КонецПроцедуры

Функция ОчиститьЖурналЗапросов(СрокДней) Экспорт

	Если СрокДней <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Граница = НачалоДня(ТекущаяДатаСеанса() - СрокДней * 86400);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	AI_ЖурналЗапросов.Период          КАК Период,
		|	AI_ЖурналЗапросов.Пользователь    КАК Пользователь,
		|	AI_ЖурналЗапросов.Провайдер       КАК Провайдер,
		|	AI_ЖурналЗапросов.Модель          КАК Модель,
		|	AI_ЖурналЗапросов.Агент           КАК Агент,
		|	AI_ЖурналЗапросов.ИДЗапроса       КАК ИДЗапроса
		|ИЗ
		|	РегистрСведений.AI_ЖурналЗапросов КАК AI_ЖурналЗапросов
		|ГДЕ
		|	AI_ЖурналЗапросов.Период < &Граница";
	Запрос.УстановитьПараметр("Граница", Граница);

	Выборка = Запрос.Выполнить().Выбрать();
	Удалено           = 0;
	ВПачке            = 0;
	РазмерПачки       = 200;
	ТранзакцияОткрыта = Ложь;

	Попытка
		Пока Выборка.Следующий() Цикл

			Если НЕ ТранзакцияОткрыта Тогда
				НачатьТранзакцию();
				ТранзакцияОткрыта = Истина;
				ВПачке = 0;
			КонецЕсли;

			Запись = РегистрыСведений.AI_ЖурналЗапросов.СоздатьМенеджерЗаписи();
			Запись.Период         = Выборка.Период;
			Запись.Пользователь   = Выборка.Пользователь;
			Запись.Провайдер      = Выборка.Провайдер;
			Запись.Модель         = Выборка.Модель;
			Запись.Агент          = Выборка.Агент;
			Запись.ИДЗапроса      = Выборка.ИДЗапроса;
			Запись.Удалить();

			Удалено = Удалено + 1;
			ВПачке  = ВПачке + 1;

			Если ВПачке >= РазмерПачки Тогда
				ЗафиксироватьТранзакцию();
				ТранзакцияОткрыта = Ложь;
			КонецЕсли;

		КонецЦикла;

		Если ТранзакцияОткрыта Тогда
			ЗафиксироватьТранзакцию();
			ТранзакцияОткрыта = Ложь;
		КонецЕсли;

	Исключение
		Если ТранзакцияОткрыта Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Возврат Удалено;

КонецФункции

Функция ОчиститьДиалоги(СрокДней) Экспорт

	Если СрокДней <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Граница = НачалоДня(ТекущаяДатаСеанса() - СрокДней * 86400);

	Возврат AI_ДиалогиСервер.УдалитьДиалогиДо(Граница);

КонецФункции
