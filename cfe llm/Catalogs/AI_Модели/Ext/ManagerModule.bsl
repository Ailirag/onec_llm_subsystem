
#Область ПрограммныйИнтерфейс

Функция НайтиПоИдентификаторуЛогики(ИдентификаторДляЛогики) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	AI_Модели.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.AI_Модели КАК AI_Модели
		|ГДЕ
		|	AI_Модели.ИдентификаторДляЛогики = &ИдентификаторДляЛогики";
	
	Запрос.УстановитьПараметр("ИдентификаторДляЛогики", ИдентификаторДляЛогики);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		НайденнаяМодель = Результат.Ссылка;
	Иначе
		ВызватьИсключение СтрШаблон("Не удалось найти модель по идентификатору логики [%1]. Продолжение невозможно.", ИдентификаторДляЛогики);
	КонецЕсли;
	
	Возврат НайденнаяМодель;
	
КонецФункции

#КонецОбласти