&НаКлиенте
Процедура СсылкаНаОбъектПриИзменении(Элемент)
	
	ЗаполнитьФормуСервер();
	
КонецПроцедуры


&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ЭтоКонсольКода				= ТекущаяСтраница.Имя = "КонсольКода";
	ЭтоВизуальныйКонструктор	= ТекущаяСтраница.Имя = "ГруппаСоединениеТаблиц";
	
	Элементы.ОтменаТранзакции.Видимость							= ЭтоКонсольКода;
	Элементы.ФормаСтатистика.Видимость							= ЭтоКонсольКода;
	Элементы.ЗвуковоеОповещение.Видимость						= ЭтоКонсольКода;
	
	Элементы.ВизуальныйКонструктор_ОтображатьЗапрос.Видимость	= ЭтоВизуальныйКонструктор;
	
	Если ЭтоКонсольКода И ПервоеОткрытиеКонсолиКода Тогда
		ФайлыПоследнегоИсполнения = НайтиФайлы(ПутьКПоследнемуВыполняемомуКоду);
		Если ФайлыПоследнегоИсполнения.Количество() > 0 Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеУтвержденияПодгрузкиПрошлогоКода", ЭтаФорма);
			ПоказатьВопрос(Оповещение, "Восстановить последний выполняемый запрос?", РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
		ПервоеОткрытиеКонсолиКода = Ложь;
	КонецЕсли;
	
	
КонецПроцедуры


&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не ЗавершениеРаботы И НЕ ЗакрытьФорму Тогда
		
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
		
		Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияЗакрытия", ЭтаФорма);
		
		ПоказатьВопрос(Оповещение, "Вы уверены что хотите закрыть обработку?", РежимДиалогаВопрос.ДаНет,,, "Необходимо подтверждение");
	
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте 
Процедура ПослеПодтвержденияЗакрытия(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗакрытьФорму = Истина;
		ЭтаФорма.Закрыть(Истина);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура НавигационнаяСсылкаПриИзменении(Элемент)
	
	Ссылка	=	СсылкаПоНавигации(НС);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект.СсылкаНаОбъект = Ссылка;
		История.Добавить(Ссылка, Строка(Ссылка));
	КонецЕсли;
	
	ЗаполнитьФормуСервер();
	
КонецПроцедуры


&НаКлиенте
Процедура ИсторияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
