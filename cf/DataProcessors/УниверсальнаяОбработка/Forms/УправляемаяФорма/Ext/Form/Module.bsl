&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователю(
		Знач ТекстСообщенияПользователю,
		Знач КлючДанных = Неопределено,
		Знач Поле = "",
		Знач ПутьКДанным = "",
		Отказ = Ложь) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщенияПользователю;
	Сообщение.Поле = Поле;
	
	ЭтоОбъект = Ложь;
	
	Если ЭтоОбъект Тогда
		Сообщение.УстановитьДанные(КлючДанных);
	Иначе
		Сообщение.КлючДанных = КлючДанных;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ПутьКДанным) Тогда
		Сообщение.ПутьКДанным = ПутьКДанным;
	КонецЕсли;
		
	Сообщение.Сообщить();
	
	Отказ = Истина;
	
КонецПроцедуры

#Область РЕДАКТОР_ОБЪЕКТОВ

&НаСервере
Процедура ЗаполнитьФормуСервер(СозданиеНового = Ложь, СозданиеГруппы = Ложь)
	
	ОчиститьФорму();
	
	Если НЕ СозданиеНового И Не ЗначениеЗаполнено(Объект.СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеОбъекта = Объект.СсылкаНаОбъект.Метаданные();
	ТипЗначения = ТипЗнч(Объект.СсылкаНаОбъект);
	
	Если СозданиеНового Тогда
		Если ЗначениеЗаполнено(Объект.СсылкаНаОбъект) Тогда
			Объект.СсылкаНаОбъект = Новый (ТипЗначения);
		КонецЕсли;
		
		Если Документы.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			РедактируемыйОбъект = Документы[МетаданныеОбъекта.имя].СоздатьДокумент();
		ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда	
			РедактируемыйОбъект = ПланыСчетов[МетаданныеОбъекта.имя].СоздатьСчет();
		ИначеЕсли ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда	
			РедактируемыйОбъект = ПланыВидовРасчета[МетаданныеОбъекта.имя].СоздатьВидРасчета();
		ИначеЕсли БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			РедактируемыйОбъект = БизнесПроцессы[МетаданныеОбъекта.имя].СоздатьБизнесПроцесс();
		ИначеЕсли Задачи.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			РедактируемыйОбъект = Задачи[МетаданныеОбъекта.имя].СоздатьЗадачу();
		ИначеЕсли ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			РедактируемыйОбъект = ПланыОбмена[МетаданныеОбъекта.имя].СоздатьУзел();
		Иначе //это справочник или ПВХ
			Менеджер = ?(Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения), Справочники[МетаданныеОбъекта.имя], ПланыВидовХарактеристик[МетаданныеОбъекта.имя]);
			РедактируемыйОбъект = ?(СозданиеГруппы, Менеджер.СоздатьГруппу(), Менеджер.СоздатьЭлемент());
		КонецЕсли;
		
	Иначе
		РедактируемыйОбъект = Объект.СсылкаНаОбъект.ПолучитьОбъект();
		GUID = Объект.СсылкаНаОбъект.УникальныйИдентификатор();
	КонецЕсли;
	
	ТипЗначенияОбъекта = Новый Массив;
	ТипЗначенияОбъекта.Добавить(ТипЗнч(РедактируемыйОбъект));
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"РедактируемыйОбъектФормы",
			Новый ОписаниеТипов(ТипЗначенияОбъекта)));
		
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ЗначениеВРеквизитФормы(РедактируемыйОбъект, "РедактируемыйОбъектФормы");
	
	// Убрал разделение на справочники и документы, вывожу все стандартные реквизиты объектов
	Для Каждого РеквизитОбъекта из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		
		ДобавитьПолеФормы(
		"Реквизит",
		РеквизитОбъекта.Имя,
		Элементы.СтраницаРеквизиты,
		Тип("ПолеФормы"),
		ВидПоляФормы.ПолеВвода);
		
	КонецЦикла;
	
	Для Каждого РеквизитОбъекта Из МетаданныеОбъекта.Реквизиты Цикл
		ДобавитьПолеФормы(
			"Реквизит",
			РеквизитОбъекта.Имя,
			Элементы.СтраницаРеквизиты,
			Тип("ПолеФормы"),
			ВидПоляФормы.ПолеВвода);
	КонецЦикла;
		
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		СтраницаПанели = ДобавитьПолеФормы(
						"СтраницаТабличнаяЧасть",
						ТабличнаяЧасть.Имя,
						Элементы.ГруппаТабличныеЧасти,
						Тип("ГруппаФормы"));
		СтраницаПанели.Заголовок = ТабличнаяЧасть.Представление();
		
		ЭлементТЧ = ДобавитьПолеФормы(
						"ТабличнаяЧасть",
						ТабличнаяЧасть.Имя,
						СтраницаПанели,
						Тип("ТаблицаФормы"));
			
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			ДобавитьПолеФормы(
				"РеквизитТЧ",
				ТабличнаяЧасть.Имя + "." + Реквизит.Имя,
				ЭлементТЧ,
				Тип("ПолеФормы"),
				ВидПоляФормы.ПолеВвода);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьПолеФормы(Префикс, Путь, Родитель, ТипПоля, ВидПоля = Неопределено)
	
	Если Префикс = "Реквизит" И НЕ ЭтаФорма["РедактируемыйОбъектФормы"].Свойство(Путь) Тогда
		Возврат Неопределено;
	ИначеЕсли Префикс = "РеквизитТЧ" Тогда
		ПутьКДанным			= "РедактируемыйОбъектФормы." + Путь;
		ПутьКДаннымРодителя	= Родитель.ПутьКДанным;
		ИмяКолонки	= СтрЗаменить(ПутьКДанным, ПутьКДаннымРодителя + ".", "");
		ИмяРодителя	= СтрЗаменить(ПутьКДаннымРодителя, "РедактируемыйОбъектФормы.", "");
		Если ЭтаФорма["РедактируемыйОбъектФормы"][ИмяРодителя].Выгрузить().Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ПолеФормы = Элементы.Добавить(
					Префикс + СтрЗаменить(Путь, ".", ""),
					ТипПоля,
					Родитель);
						
	Если ВидПоля <> Неопределено Тогда
		ПолеФормы.Вид = ВидПоля;
	КонецЕсли;
	
	Если ТипПоля = Тип("ПолеФормы") Или ТипПоля = Тип("ТаблицаФормы")Тогда
		ПолеФормы.ПутьКДанным = "РедактируемыйОбъектФормы." + Путь;
	КонецЕсли;
	
	Возврат ПолеФормы;
	
КонецФункции

&НаСервере
Процедура ОчиститьФорму()
	
	ЭлементыДляУдаления = Новый Массив;
	
	ДобавитьЭлементыГруппыВМассив(ЭлементыДляУдаления, Элементы.СтраницаРеквизиты);
	ДобавитьЭлементыГруппыВМассив(ЭлементыДляУдаления, Элементы.ГруппаТабличныеЧасти);
	
	Для Каждого Элемент Из ЭлементыДляУдаления Цикл
		Элементы.Удалить(Элемент);
	КонецЦикла;
	
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	
	РеквизитыДляУдаления = Новый Массив;
	
	Для Каждого Реквизит Из РеквизитыФормы Цикл
		Если Реквизит.Имя = "РедактируемыйОбъектФормы" Тогда
			РеквизитыДляУдаления.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если РеквизитыДляУдаления.Количество() > 0 Тогда
		ИзменитьРеквизиты(, РеквизитыДляУдаления);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыГруппыВМассив(МассивЭлементов, ГруппаФормы)
	
	Для Каждого Элемент Из ГруппаФормы.ПодчиненныеЭлементы Цикл
		МассивЭлементов.Добавить(Элемент);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьОбъектСервер()
	
	ЕстьРеквизит = Ложь;
	
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	Для Каждого Реквизит Из РеквизитыФормы Цикл
		Если Реквизит.Имя = "РедактируемыйОбъектФормы" Тогда
			ЕстьРеквизит = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьРеквизит Тогда
		СообщитьПользователю("Не выбран объект",, "Объект.СсылкаНаОбъект");
		Возврат;
	КонецЕсли;
	
	РедактируемыйОбъект = РеквизитФормыВЗначение("РедактируемыйОбъектФормы");
	
	Если Объект.ОбменДанными Тогда
		РедактируемыйОбъект.ОбменДанными.Загрузка = Истина;
	КонецЕсли;
	
	РедактируемыйОбъект.Записать();
	
	Объект.СсылкаНаОбъект = РедактируемыйОбъект.Ссылка;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьГруппы(Ссылка)
	
	Если Ссылка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипЗначенияСсылки = ТипЗнч(Ссылка);
	МетаданныеСсылки = Ссылка.Метаданные();
	
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗначенияСсылки) Тогда
		Если МетаданныеСсылки.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
			Возврат Истина;
		КонецЕсли;
	ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначенияСсылки) Тогда
		Возврат МетаданныеСсылки.Иерархический;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Хранимые файлы

&НаКлиенте
Процедура ХранимыеФайлы_Обновить(Команда)
	ХранимыеФайлы_ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ХранимыеФайлы_ОбновитьНаСервере()
	
	ХранимыеОбработки.Очистить();
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Для Каждого МетаданныеМакета Из ОбъектОбработки.Метаданные().Макеты Цикл
		Макет = ОбъектОбработки.ПолучитьМакет(МетаданныеМакета.Имя);
		Если ТипЗнч(Макет) = Тип("ДвоичныеДанные") Тогда
			НовыйЭлемент = ХранимыеОбработки.Добавить();
			НовыйЭлемент.Представление = МетаданныеМакета.Имя;
			НовыйЭлемент.Значение = Макет;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ХранимыеОбработки_ЗапускВнешнегоИнструмента(ДвоичныеДанные, ТипИнструмента)
	
	АдресВХД			= ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	Попытка 
		ОбъектОписанияЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
		ОбъектОписанияЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
		
		Если ТипИнструмента = "ВнешнийОтчет" Тогда
			АдресОтчета	= ВнешниеОтчеты.Подключить(АдресВХД,, Ложь, ОбъектОписанияЗащиты);
			Инструмент	= ВнешниеОтчеты.Создать(АдресОтчета, Ложь);
		Иначе
			АдресОбработки	= ВнешниеОбработки.Подключить(АдресВХД,, Ложь, ОбъектОписанияЗащиты);
			Инструмент		= ВнешниеОбработки.Создать(АдресОбработки, Ложь);
		КонецЕсли;
		
		СтруктураВозврата = Новый Структура("ИмяОбработки, ОсновнаяФорма", Инструмент.Метаданные().Имя, Инструмент.Метаданные().ОсновнаяФорма.Имя);
		Возврат СтруктураВозврата;
	Исключение
		Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ХранимыеОбработкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ХранимыеОбработки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИнформацияОФайле = РазобратьИнформациюПоХранимомуФайлу(ТекущиеДанные.Представление);
	
	Если ИнформацияОФайле.ЭтоВнешняяОбработка Тогда
		ДанныеОбработки		= ХранимыеОбработки_ЗапускВнешнегоИнструмента(ТекущиеДанные.Значение, ИнформацияОФайле.ТипВнешнейОбработки);
		ИмяФормыОбработки	= СтрШаблон("%1.%2.Форма.%3", ИнформацияОФайле.ТипВнешнейОбработки, ДанныеОбработки.ИмяОбработки, ДанныеОбработки.ОсновнаяФорма);
	
		ОткрытьФорму(ИмяФормыОбработки);
	Иначе
		ПараметрыФайла = Новый Структура("ИмяФайла, ТипФайла, ДД", ИнформацияОФайле.ИмяФайла, ИнформацияОФайле.ТипФайла, ТекущиеДанные.Значение);
		НачатьПолучениеКаталогаВременныхФайлов(Новый ОписаниеОповещения("ПослеПолученияКаталогаВременныхФайлов", ЭтаФорма, ПараметрыФайла));//ПолучитьИмяВременногоФайла(ТипФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция РазобратьИнформациюПоХранимомуФайлу(Представление)
	
	СоставноеИмя = СтрРазделить(Представление, "_", Ложь);
	
	ТипФайла = нрег(СоставноеИмя[0]);
	ИмяФайла = СоставноеИмя[1];
	
	ЭтоВнешняяОбработка	= Истина;
	ТипВнешнейОбработки		= "";
	
	Если ТипФайла = "отчет" Тогда
		ТипФайла = "erf";
		ТипВнешнейОбработки = "ВнешнийОтчет";
	ИначеЕсли ТипФайла = "обработка" Тогда
		ТипФайла = "epf";
		ТипВнешнейОбработки = "ВнешняяОбработка";
	Иначе // Нужно просто открыть файл, тип файла содержится в конце
		ТипФайла = СоставноеИмя[СоставноеИмя.ВГраница()];
		ЭтоВнешняяОбработка = Ложь;
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура("ИмяФайла, ТипФайла, ЭтоВнешняяОбработка, ТипВнешнейОбработки");
	СтруктураВозврата.ИмяФайла = ИмяФайла;
	СтруктураВозврата.ТипФайла = ТипФайла;
	СтруктураВозврата.ЭтоВнешняяОбработка = ЭтоВнешняяОбработка;
	СтруктураВозврата.ТипВнешнейОбработки = ТипВнешнейОбработки;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Процедура ПослеПолученияКаталогаВременныхФайлов(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяФайла = СтрШаблон("%1%2.%3", Результат, ДополнительныеПараметры.ИмяФайла, ДополнительныеПараметры.ТипФайла);
	ДополнительныеПараметры.ДД.Записать(ИмяФайла);
	НачатьЗапускПриложения(Новый ОписаниеОповещения, ИмяФайла);
	
