#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ЗаполнениеОбъекта");
	ПараметрыРегистрации.Вставить("Наименование", "AI-помощник: сценарии для объекта");
	ПараметрыРегистрации.Вставить("Версия", "1.0.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Истина);
	ПараметрыРегистрации.Вставить(
		"Информация",
		"Открывает универсальный список сценариев LLM для выбранных объектов.");
	ПараметрыРегистрации.Вставить("Назначение", ПолучитьНазначения());
	ПараметрыРегистрации.Вставить("Команды", ПолучитьТаблицуКоманд());

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "AI-помощник";
	НоваяКоманда.Идентификатор = "ОткрытьAIПомощник";
	НоваяКоманда.Использование = "ВызовКлиентскогоМетода";
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	НоваяКоманда.Модификатор = "";

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Назначение берется из настроенных мест запуска. Перечислять весь состав
// конфигурации нельзя: в прикладных решениях это сотни объектов, и команда
// появилась бы в меню заполнения у каждого из них.
// Полный перебор остается запасным вариантом, когда администратор намеренно
// разрешил место для любого метаданного (пустое имя или "*").
Функция ПолучитьНазначения()

	Назначения = Новый Массив;
	Попытка
		НуженПолныйПеребор = ЗаполнитьНазначенияПоМестамЗапуска(Назначения);
	Исключение
		// Подсистема не установлена или недоступна на чтение.
		НуженПолныйПеребор = Истина;
		Назначения = Новый Массив;
	КонецПопытки;

	Если НуженПолныйПеребор Или Назначения.Количество() = 0 Тогда
		Назначения = Новый Массив;
		ДобавитьНазначения(Назначения, Метаданные.Документы);
		ДобавитьНазначения(Назначения, Метаданные.Справочники);
		ДобавитьНазначения(Назначения, Метаданные.БизнесПроцессы);
		ДобавитьНазначения(Назначения, Метаданные.Задачи);
	КонецЕсли;
	Возврат Назначения;

КонецФункции

// Возвращает Истина, если хотя бы одно активное место разрешено для любого
// метаданного и перечислить назначение точечно нельзя.
Функция ЗаполнитьНазначенияПоМестамЗапуска(Назначения)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|  Места.ПолноеИмяМетаданных КАК ПолноеИмяМетаданных
		|ИЗ Справочник.AI_МестаЗапускаСценариев КАК Места
		|ГДЕ НЕ Места.ПометкаУдаления
		|  И Места.Активно
		|  И Места.ТипМеста В (""Объект"", ""Список"")");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПолноеИмя = СокрЛП(Выборка.ПолноеИмяМетаданных);
		Если Не ЗначениеЗаполнено(ПолноеИмя) Или ПолноеИмя = "*" Тогда
			Возврат Истина;
		КонецЕсли;
		Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Назначения.Найти(ПолноеИмя) = Неопределено Тогда
			Назначения.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ДобавитьНазначения(Назначения, КоллекцияМетаданных)
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		Назначения.Добавить(ОбъектМетаданных.ПолноеИмя());
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

#КонецОбласти
