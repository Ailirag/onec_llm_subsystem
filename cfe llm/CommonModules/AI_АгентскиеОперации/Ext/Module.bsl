
Функция НачатьОперацию(ПараметрыОперации) Экспорт

	ПараметрыЧата = Новый Структура;
	Для Каждого Поле Из ПараметрыОперации Цикл
		Если СтрНайти(",КодСценария,КодОбработчика,ВерсияКонтракта,СхемаОтветаJSON,", "," + Поле.Ключ + ",") = 0 Тогда
			ПараметрыЧата.Вставить(Поле.Ключ, Поле.Значение);
		КонецЕсли;
	КонецЦикла;
	Сценарий = ПолучитьСвойство(
		ПараметрыЧата,
		"Сценарий",
		Справочники.AI_Сценарии.ПустаяСсылка());
	Если ЗначениеЗаполнено(Сценарий) Тогда
		ПараметрыЧата = AI_КонтрактыОпераций.ПодготовитьПараметры(ПараметрыЧата);
	КонецЕсли;
	ИсходныйПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = НачатьОперациюВнутренне(ПараметрыЧата, Истина);
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
	Возврат Результат;

КонецФункции

// Запускает операцию из прикладной логики без создания пользовательского диалога.
Функция НачатьПрикладнуюОперацию(ПараметрыОперации) Экспорт

	ПодготовленныеПараметры = AI_КонтрактыОпераций.ПодготовитьПараметры(ПараметрыОперации);
	ИсходныйПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = НачатьОперациюВнутренне(ПодготовленныеПараметры, Ложь);
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
	Возврат Результат;

КонецФункции

