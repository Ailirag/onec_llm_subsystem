
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Активно = Истина;
	ТипМеста = "Объект";
	Порядок = 100;
КонецПроцедуры

// Проверки для формы: сообщения привязаны к полям, и администратор видит, что
// именно исправить. Жесткий запрет на запись — в ПередЗаписью.
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	ИмяОбъекта = СокрЛП(ПолноеИмяМетаданных);
	Если ТипМеста <> "Глобально" И ОбъектНеНайден(ИмяОбъекта) Тогда
		СообщитьОбОшибке(ТекстОбъектНеНайден(ИмяОбъекта), "ПолноеИмяМетаданных", Отказ);
	КонецЕсли;
	Если ВидДействия = Перечисления.AI_ВидДействия.ВнешнийОбработчик
		И Не ЗначениеЗаполнено(Обработчик) Тогда
		СообщитьОбОшибке("Выберите внешнюю обработку действия.", "Обработчик", Отказ);
	КонецЕсли;
	Если ВидДействия = Перечисления.AI_ВидДействия.ПользовательскоеДействие
		И Не ЗначениеЗаполнено(КлючДействия) Тогда
		СообщитьОбОшибке("Укажите ключ действия: по нему прикладной код узнает, что выполнять.",
			"КлючДействия", Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		ВызватьИсключение "Укажите сценарий.";
	КонецЕсли;
	Если СтрНайти(",Объект,Список,Раздел,Глобально,", "," + ТипМеста + ",") = 0 Тогда
		ВызватьИсключение "Тип места должен быть одним из значений: Объект, Список, Раздел, Глобально.";
	КонецЕсли;
	Если ТипМеста = "Глобально" Тогда
		ПолноеИмяМетаданных = "";
	КонецЕсли;
	// Опечатка в имени объекта молча прячет действие: его не найдет ни одна
	// карточка, и выяснится это только у пользователя.
	Если ОбъектНеНайден(СокрЛП(ПолноеИмяМетаданных)) Тогда
		ВызватьИсключение ТекстОбъектНеНайден(СокрЛП(ПолноеИмяМетаданных));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПредставлениеКоманды) Тогда
		ПредставлениеКоманды = Строка(Сценарий);
	КонецЕсли;
КонецПроцедуры

// Пустое имя и «*» — осознанное «любой объект», а не опечатка.
Функция ОбъектНеНайден(ИмяОбъекта)
	Возврат ЗначениеЗаполнено(ИмяОбъекта)
		И ИмяОбъекта <> "*"
		И Метаданные.НайтиПоПолномуИмени(ИмяОбъекта) = Неопределено;
КонецФункции

Функция ТекстОбъектНеНайден(ИмяОбъекта)
	Возврат СтрШаблон("Объект «%1» не найден в конфигурации. Выберите его из списка.", ИмяОбъекта);
КонецФункции

Процедура СообщитьОбОшибке(Текст, Поле, Отказ)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;
КонецПроцедуры
