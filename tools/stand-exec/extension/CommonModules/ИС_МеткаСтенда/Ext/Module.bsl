// Метка стенда: единственный признак, по которому исполнитель соглашается
// выполнять код.
//
// Расширение ставит на стенд комплект процесса, и он же сразу выставляет метку
// вызовом ВключитьИсполнение через COM. Расширение, попавшее в рабочую базу любым
// другим путём, метки не имеет и ничего не выполняет. Включить его там можно
// только умышленно — случайно, загрузив не тот файл, нельзя.
//
// Признаком не может служить вид базы: стенды бывают и серверными. Не может им
// быть и заголовок запроса: его пришлёт любой клиент, в том числе клиент комплекта,
// по ошибке направленный на рабочий адрес.
//
// Метка хранится в хранилище системных настроек, а не в константе. Конфигурации
// подписываются на запись ЛЮБОЙ константы (в УТ так делают, например, проверка
// удаляемых объектов и миграция приложений), и во внешнем соединении такой
// обработчик падает: общие модули без флага «Внешнее соединение» там не видны.
// Хранилище системных настроек конфигурация переопределить не может, подписок на
// нём нет, и копия базы уносит метку вместе с данными.
//
// Метка читается и пишется в привилегированном режиме: это настройки служебного
// владельца, а не текущего пользователя. Привилегированным сам модуль сделать
// нельзя — платформа запрещает такие модули в расширениях.
//
// Безопасный режим расширения защитой НЕ служит: проверено, что метка читается и
// пишется и под ним. Защита — только метка и право «Администрирование» у
// вызывающего (ИС_Исполнитель.ПричинаОтказа).

#Область ПрограммныйИнтерфейс

// Выставлена ли метка стенда в этой базе.
//
// Возвращаемое значение:
//  Булево
//
Функция ИсполнениеРазрешено() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Значение = ХранилищеСистемныхНастроек.Загрузить(КлючОбъекта(), КлючНастроек(), , ВладелецМетки());
	Возврат Значение = Истина;

КонецФункции

// Выставляет метку стенда. Вызывается комплектом через COM сразу после установки
// расширения на стенд.
//
// Возвращаемое значение:
//  Строка - "OK".
//
Функция ВключитьИсполнение() Экспорт

	ЗаписатьМетку(Истина);
	Возврат "OK";

КонецФункции

// Снимает метку стенда. Нужна, чтобы проверить отказ исполнителя без метки.
//
// Возвращаемое значение:
//  Строка - "OK".
//
Функция ВыключитьИсполнение() Экспорт

	ЗаписатьМетку(Ложь);
	Возврат "OK";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьМетку(Значение)

	УстановитьПривилегированныйРежим(Истина);
	ХранилищеСистемныхНастроек.Сохранить(КлючОбъекта(), КлючНастроек(), Значение, , ВладелецМетки());

КонецПроцедуры

Функция КлючОбъекта()

	Возврат "ИсполнительСтенда";

КонецФункции

Функция КлючНастроек()

	Возврат "МеткаСтенда";

КонецФункции

// Служебный владелец настроек, а не текущий пользователь: метка принадлежит базе.
// Иначе её видел бы только тот, кто её выставил.
Функция ВладелецМетки()

	Возврат "ИсполнительСтенда";

КонецФункции

#КонецОбласти
