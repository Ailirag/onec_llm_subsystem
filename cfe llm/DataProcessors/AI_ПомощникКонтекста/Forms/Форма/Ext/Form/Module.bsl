// Мастер помощника: действие -> уточнения -> рекомендации.
//
// Уточнения описаны декларативно в ТЧ Уточнения места запуска. Форма не знает,
// что именно уточняется: она идет по строкам ТЧ подряд и для каждой рисует
// страницу по виду уточнения. Шаг уточнения целиком пропускается, если строк нет.
//
// Анализ выполняется фоновой агентской операцией, форма опрашивает ее и
// показывает разобранные по карте рекомендации. В базу помощник не пишет
// ничего: подтвержденные значения он переносит в форму прикладного объекта,
// а записывает их человек обычной командой «Записать».

#Область ОписаниеПеременных

// Число шагов уточнения у выбранного действия. Держим на клиенте, чтобы
// перерисовка кнопок не ходила на сервер за одним числом.
&НаКлиенте
Перем ВсегоУточненийКэш;

// Вид действия выбранного места запуска, строкой: клиенту нужен он только
// для заголовка и видимости кнопки, настоящая проверка идет на сервере.
&НаКлиенте
Перем ВидДействияКлиент;

// Момент запуска обращения к модели — для счетчика ожидания.
&НаКлиенте
Перем НачалоОжидания;

// Состояние многошагового обработчика между шагами. Держим на клиенте, потому
// что шагами управляет клиентский цикл; требование к состоянию одно — оно
// должно переноситься между клиентом и сервером.
&НаКлиенте
Перем СостояниеДействияКлиент;

// Ждем ли сейчас, пока человек запишет объект. Обработчик вправе попросить
// такой шаг: связать что-либо с новым объектом до записи нельзя — ссылки у
// него еще нет, а выдать ее авансом значит оставить висящую связь, если
// человек передумает записывать.
&НаКлиенте
Перем ОжиданиеЗаписиАктивно;

// Момент начала ожидания записи — для счетчика и потолка ожидания.
&НаКлиенте
Перем НачалоОжиданияЗаписи;

// Идет ли разбор пачки объектов. Массовый режим — это N операций в очереди,
// по одной на объект: ответ модели по пачке применить построчно нельзя.
&НаКлиенте
Перем ПакетныйРежимКлиент;

// Пройденные звенья цепочки действий: сюда попадает каждое место запуска,
// которым уже продолжали. Нужен, чтобы цепочка не зациклилась и не ушла в
// бесконечную глубину — предложение приходит от прикладного кода, а он ошибается.
&НаКлиенте
Перем ЦепочкаДействийКлиент;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектыНазначения = Неопределено;
	Параметры.Свойство("ОбъектыНазначения", ОбъектыНазначения);
	ТипМестаИзПараметров = "Объект";
	Параметры.Свойство("ТипМеста", ТипМестаИзПараметров);

	Контекст = AI_ИнтерфейсныеСценарии.СформироватьКонтекст(
		ОбъектыНазначения,
		ТипМестаИзПараметров);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Контекст);
	КонтекстПредставление = Контекст.ПредставлениеИсточника;

	ПрочитатьСписокДействий();

	// Перенос настройки между базами — административное действие, и кнопки
	// пакета видны только тому, кто вправе его выполнить. Настоящая проверка
	// права живет в AI_ПакетыСценариев, здесь только видимость.
	ПакетыДоступны = AI_ПакетыСценариев.ПакетыДоступны();
	Элементы.ВыгрузитьПакет.Видимость = ПакетыДоступны;
	Элементы.ЗагрузитьПакет.Видимость = ПакетыДоступны;

	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДействия;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьСписокДействий()

	Контекст = КонтекстФормы();
	ТаблицаСценариев = AI_ИнтерфейсныеСценарии.ПолучитьДоступныеСценарии(Контекст);
	ЗначениеВРеквизитФормы(ТаблицаСценариев, "Сценарии");
	Если ТаблицаСценариев.Количество() = 0 Тогда
		КонтекстПредставление = Контекст.ПредставлениеИсточника
			+ ". Нет доступных действий для этого места запуска.";
	Иначе
		КонтекстПредставление = Контекст.ПредставлениеИсточника;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьОписаниеВыбранного();
	ОбновитьСостояниеИнтерфейса();
	Если ОперацияВыполняется Тогда
		ПодключитьОпросОперации();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	ОтключитьОпросОперации();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СценарииПриАктивизацииСтроки(Элемент)
	ОбновитьОписаниеВыбранного();
КонецПроцедуры

&НаКлиенте
Процедура СценарииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДалееОбработка(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ВариантыУточненияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДалееОбработка(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДалееОбработка(Команда)

	Если ОперацияВыполняется Тогда
		Возврат;
	КонецЕсли;

	Если Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДействия Тогда
		НачатьСценарий();
	ИначеЕсли Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаУточнение Тогда
		// Страница уточнения обслуживает два разных цикла: уточнения перед
		// запуском модели и шаги, которые запросил обработчик действия.
		Если ЗначениеЗаполнено(ВидПродолжения) Тогда
			ПродолжитьДействие();
		Иначе
			ПродолжитьУточнения();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НазадОбработка(Команда)

	// Из результата по одному объекту возвращаемся к списку пакета, а не к
	// выбору действия: пакет еще не разобран.
	Если Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат
		И ПакетныйРежимКлиент = Истина
		И Пакет.Количество() > 0 Тогда
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаПакет;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецЕсли;

	Если Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаУточнение
		И ИндексУточнения > 1 Тогда
		// Возвращаемся на предыдущее уточнение, а не к списку действий.
		УдалитьСобранноеУточнение(ИндексУточнения);
		ИндексУточнения = ИндексУточнения - 1;
		УдалитьСобранноеУточнение(ИндексУточнения);
		Если ПоказатьУточнение(ИндексУточнения) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДействия;
	ИндексУточнения = 0;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

// Действие выполняется только по явной команде пользователя и только по
// отмеченным строкам. Что именно произойдет, задано видом действия на месте
// запуска: заполнение формы, запись объекта или прикладное действие.
&НаКлиенте
Процедура ПрименитьРекомендацииОбработка(Команда)

	Если Не ЗначениеЗаполнено(ЗаголовокДействия()) Тогда
		Сообщить("Для этого действия применение результата не настроено.");
		Возврат;
	КонецЕсли;
	Если ВидДействияКлиент = "ЗаполнитьФорму" И ФормаОбъекта() = Неопределено Тогда
		Сообщить("Помощник открыт без формы объекта — заполнять нечего."
			+ " Откройте карточку объекта и вызовите помощника из нее.");
		Возврат;
	КонецЕсли;

	Отобрано = 0;
	Для Каждого СтрокаТаблицы Из Рекомендации Цикл
		Если СтрокаТаблицы.Применить Тогда
			Отобрано = Отобрано + 1;
		КонецЕсли;
	КонецЦикла;
	Если Отобрано = 0 Тогда
		Сообщить("Отметьте строки, к которым нужно применить действие.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПрименитьРекомендацииЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстПодтверждения(Отобрано), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьРекомендацииЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ШагДействия = 1;
	ВыполнитьШагДействия(Неопределено);

КонецПроцедуры

// Один шаг действия. Обработчик вправе не закончить, а попросить уточнение —
// тогда мастер показывает шаг и возвращается сюда с ответом пользователя.
&НаКлиенте
Процедура ВыполнитьШагДействия(ОтветПользователя)

	// Потолок шагов: кривой обработчик не должен зацикливать пользователя.
	Если ШагДействия > 20 Тогда
		СтатусОперации = "Действие превысило допустимое число шагов и остановлено.";
		Возврат;
	КонецЕсли;

	Действие = ВыполнитьДействиеНаСервере(ОтветПользователя, СостояниеДействияКлиент);
	СостояниеДействияКлиент = Действие.Состояние;
	Для Каждого Сообщение Из Действие.Сообщения Цикл
		Сообщить(Сообщение);
	КонецЦикла;
	Если ЗначениеЗаполнено(Действие.Ошибка) Тогда
		СтатусОперации = Действие.Ошибка;
		ЗавершитьДействие();
		Возврат;
	КонецЕсли;

	Если Действие.ЕстьПродолжение Тогда
		ШагДействия = ШагДействия + 1;
		ПоказатьПродолжениеДействия(Действие);
		Возврат;
	КонецЕсли;

	ЗавершитьДействие();

	Если ВидДействияКлиент = "ЗаполнитьФорму" Тогда
		СтатусОперации = ЗаполнитьФормуОбъекта(Действие.План);
		ПредложитьПродолжениеЦепочки(Действие);
		Возврат;
	КонецЕсли;

	СтатусОперации = СтрШаблон("Применено: %1, отклонено: %2.",
		Действие.Обработано,
		Действие.Отклонено);
	Если Действие.Обработано > 0 Тогда
		Оповестить("Запись_" + ПолноеИмяМетаданных, КлючИсточника);
	КонецЕсли;

	ПредложитьПродолжениеЦепочки(Действие);

КонецПроцедуры

// Одно действие естественно ведет к другому: проверка нашла несоответствие —
// значит, нужно другое действие. Цепочку предлагает прикладной код, а решает
// человек: молча запускать следующий сценарий и тратить его токены нельзя.
&НаКлиенте
Процедура ПредложитьПродолжениеЦепочки(Действие)

	Если Действие.СледующееМесто = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЦепочкаДействийКлиент = Неопределено Тогда
		ЦепочкаДействийКлиент = Новый Массив;
	КонецЕсли;

	// Потолок глубины и защита от петли. Оба случая — ошибка прикладного кода,
	// но расплачивается за нее пользователь, поэтому цепочка обрывается здесь.
	Если ЦепочкаДействийКлиент.Количество() >= 5 Тогда
		Сообщить("Цепочка действий уже прошла пять звеньев и остановлена.");
		Возврат;
	КонецЕсли;
	Если ЦепочкаДействийКлиент.Найти(Действие.СледующееМесто) <> Неопределено Тогда
		Сообщить("Цепочка вернулась к действию, которое уже выполнялось, и остановлена.");
		Возврат;
	КонецЕсли;

	Вопрос = СтрШаблон("Продолжить действием «%1»?", Действие.СледующееПредставление);
	Если ЗначениеЗаполнено(Действие.СледующаяПричина) Тогда
		Вопрос = Действие.СледующаяПричина + Символы.ПС + Вопрос;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПродолжитьЦепочкуЗавершение", ЭтотОбъект,
		Новый Структура("Место", Действие.СледующееМесто));
	ПоказатьВопрос(Оповещение, Вопрос, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЦепочкуЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Если ЦепочкаДействийКлиент = Неопределено Тогда
		ЦепочкаДействийКлиент = Новый Массив;
	КонецЕсли;
	ЦепочкаДействийКлиент.Добавить(ДополнительныеПараметры.Место);

	Переход = ПерейтиКДействиюНаСервере(ДополнительныеПараметры.Место);
	Если ЗначениеЗаполнено(Переход.Ошибка) Тогда
		СтатусОперации = Переход.Ошибка;
		Возврат;
	КонецЕсли;

	ВсегоУточненийКэш = Переход.Уточнений;
	ВидДействияКлиент = Переход.ВидДействия;
	ИндексУточнения = 0;
	Если Переход.Уточнений = 0 Тогда
		ЗапуститьАнализ();
		Возврат;
	КонецЕсли;

	ИндексУточнения = 1;
	Если Не ПоказатьУточнение(ИндексУточнения) Тогда
		СтатусОперации = "Следующее действие требует уточнения,"
			+ " которое помощник пока не умеет показывать.";
		Возврат;
	КонецЕсли;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПродолжениеДействия(Действие)

	Если ВидПродолжения = "ОжиданиеЗаписи" Тогда
		НачатьОжиданиеЗаписи(Действие);
		Возврат;
	КонецЕсли;

	Если ВидПродолжения = "Вопрос" Тогда
		// Да/Нет показываем диалогом: отдельная страница мастера тут лишняя.
		Оповещение = Новый ОписаниеОповещения("ПродолжениеВопросЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, Действие.ТекстПродолжения, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаУточнение;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ПродолжениеВопросЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Значение = (Ответ = КодВозвратаДиалога.Да);
	ВыполнитьШагДействия(Новый Структура("Ключ,Значение,Представление",
		"",
		Значение,
		?(Значение, "да", "нет")));

КонецПроцедуры

// Шаг, которого ждут от человека, а не от помощника: пока объект не записан,
// ссылки на него не существует, и связать с ним документ нечем.
//
// Помощник открыт окном поверх карточки и блокирует ее. Отпустить окно на ходу
// нельзя: присваивание РежимОткрытияОкна открытой форме проходит без ошибки,
// но блокировку не снимает — поверх карточки остается перехватывающий слой
// платформы, и до кнопки «Записать» человек не дотянется. Проверено в
// tests/ui/wait-for-write.mjs.
//
// Поэтому запись предлагается кнопкой самого помощника: нажимает ее человек, а
// выполняет ее форма объекта своим методом Записать() — со всеми проверками
// модуля формы. Помощник по-прежнему ничего не записывает сам.
&НаКлиенте
Процедура НачатьОжиданиеЗаписи(Действие)

	Форма = ФормаОбъекта();
	Если Форма = Неопределено Тогда
		ОтменитьОжиданиеЗаписи("Обработчик ждет записи объекта, но помощник открыт"
			+ " без формы объекта — ждать нечего.");
		Возврат;
	КонецЕсли;

	ОжиданиеЗаписиАктивно = Истина;
	НачалоОжиданияЗаписи = ТекущаяДата();
	СтатусОперации = ?(ЗначениеЗаполнено(Действие.ТекстПродолжения),
		Действие.ТекстПродолжения,
		"Запишите объект — действие продолжится после записи.");
	ОбновитьСостояниеИнтерфейса();
	// Опрос остается и при кнопке: объект могли записать и из другого места,
	// например открыв карточку второй раз.
	ПодключитьОбработчикОжидания("ПроверитьЗаписьОбъекта", 1, Истина);

КонецПроцедуры

// Признак записи — заполненная ссылка при немодифицированной форме. Оповещение
// «Запись_*» не годится: его шлет прикладная форма по соглашению конфигурации,
// а механизм обязан работать в любой.
//
// Уже записанный и неизмененный объект проходит проверку сразу: ждать нечего,
// ссылка есть.
&НаКлиенте
Процедура ПроверитьЗаписьОбъекта()

	Если Не ОжиданиеЗаписиАктивно = Истина Тогда
		Возврат;
	КонецЕсли;

	Форма = ФормаОбъекта();
	Если Форма = Неопределено Тогда
		ОтменитьОжиданиеЗаписи("Форма объекта закрыта — действие не продолжено.");
		Возврат;
	КонецЕсли;

	Ссылка = Неопределено;
	Попытка
		Ссылка = Форма.Объект.Ссылка;
	Исключение
		ОтменитьОжиданиеЗаписи("Форма объекта больше недоступна — действие не продолжено.");
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Ссылка) И Не Форма.Модифицированность Тогда
		ОжиданиеЗаписиАктивно = Ложь;
		ПринятьЗаписанныйОбъект(Ссылка);
		ВыполнитьШагДействия(Новый Структура("Ключ,Значение,Представление",
			"ОбъектЗаписан",
			Истина,
			Строка(Ссылка)));
		Возврат;
	КонецЕсли;

	// Потолок ожидания: помощник не должен висеть в опросе весь рабочий день,
	// если человек ушел от карточки, не записав.
	Если ТекущаяДата() - НачалоОжиданияЗаписи > 900 Тогда
		ОтменитьОжиданиеЗаписи("Объект не записан за 15 минут — действие остановлено.");
		Возврат;
	КонецЕсли;

	СтатусОперации = "Ожидание записи объекта" + ПрошлоВремени(НачалоОжиданияЗаписи);
	ПодключитьОбработчикОжидания("ПроверитьЗаписьОбъекта", 1, Истина);

КонецПроцедуры

// Запись выполняет форма объекта, а не помощник: ее метод Записать() проводит
// объект через ПередЗаписью, проверку заполнения и прочую логику модуля формы.
// Прямая запись объекта в обход формы все это обошла бы.
&НаКлиенте
Процедура ЗаписатьОбъектВладельцаОбработка(Команда)

	Если Не ОжиданиеЗаписиАктивно = Истина Тогда
		Возврат;
	КонецЕсли;

	Форма = ФормаОбъекта();
	Если Форма = Неопределено Тогда
		ОтменитьОжиданиеЗаписи("Форма объекта закрыта — действие не продолжено.");
		Возврат;
	КонецЕсли;

	Попытка
		Записано = Форма.Записать();
	Исключение
		СтатусОперации = "Не удалось записать объект: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Если Не Записано Тогда
		// Форма отказала сама — например, не заполнено обязательное поле.
		// Ожидание не снимаем: человек исправит и нажмет снова.
		СтатусОперации = "Форма объекта не приняла запись. Исправьте карточку и повторите.";
		Возврат;
	КонецЕсли;

	ПроверитьЗаписьОбъекта();

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОжиданиеЗаписи(Причина)

	ОжиданиеЗаписиАктивно = Ложь;
	СтатусОперации = Причина;
	ЗавершитьДействие();

КонецПроцедуры

// После записи объект наконец существует, и контекст шага переключается на
// настоящую ссылку. До записи ее в контексте просто нет: у нового объекта
// ссылка пустая, и ядру нечего было бы искать.
//
// КонтекстJSON не трогаем: он описывает источник для модели, а модель уже
// ответила. Обновляется то, по чему ядро находит объект.
&НаСервере
Процедура ПринятьЗаписанныйОбъект(Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяМетаданных = Ссылка.Метаданные().ПолноеИмя();
	ТипИсточника = ПолноеИмяМетаданных;
	КлючИсточника = Строка(Ссылка.УникальныйИдентификатор());
	ПредставлениеИсточника = Лев(Строка(Ссылка), 250);
	КоличествоОбъектов = 1;

КонецПроцедуры

// Кнопка «Далее» на шаге продолжения ведет не в анализ, а обратно в действие.
&НаКлиенте
Процедура ПродолжитьДействие()

	Ответ = СобратьОтветПродолжения();
	Если ТипЗнч(Ответ) = Тип("Строка") Тогда
		Сообщить(Ответ);
		Возврат;
	КонецЕсли;
	ВыполнитьШагДействия(Ответ);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьДействие()

	ОжиданиеЗаписиАктивно = Ложь;
	ОтключитьОбработчикОжидания("ПроверитьЗаписьОбъекта");
	ВидПродолжения = "";
	ШагДействия = 0;
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

// Заголовок кнопки действия. Пустая строка — действия нет, кнопку не показываем.
&НаКлиенте
Функция ЗаголовокДействия()

	Если ВидДействияКлиент = "ЗаполнитьФорму" Тогда
		Возврат "Заполнить форму";
	ИначеЕсли ВидДействияКлиент = "ЗаписатьОбъект" Тогда
		Возврат "Записать в объект";
	ИначеЕсли ВидДействияКлиент = "ПользовательскоеДействие"
		Или ВидДействияКлиент = "ВнешнийОбработчик" Тогда
		Возврат "Выполнить действие";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Функция ТекстПодтверждения(Отобрано)

	Если ВидДействияКлиент = "ЗаполнитьФорму" Тогда
		Возврат СтрШаблон(
			"Заполнить в форме «%1» реквизитов: %2?"
			+ " Объект не записывается — записать его нужно самостоятельно.",
			ПредставлениеИсточника,
			Отобрано);
	ИначеЕсли ВидДействияКлиент = "ЗаписатьОбъект" Тогда
		Возврат СтрШаблон(
			"Записать в объект «%1» реквизитов: %2? Объект будет изменен в базе.",
			ПредставлениеИсточника,
			Отобрано);
	КонецЕсли;
	Возврат СтрШаблон(
		"Выполнить действие для «%1» по отмеченным строкам (%2)?",
		ПредставлениеИсточника,
		Отобрано);

КонецФункции

// Переносит подготовленные значения в форму объекта. Форма остается
// измененной и незаписанной: записывает ее пользователь.
&НаКлиенте
Функция ЗаполнитьФормуОбъекта(План)

	Форма = ФормаОбъекта();
	Если Форма = Неопределено Тогда
		Возврат "Форма объекта закрыта — заполнять нечего.";
	КонецЕсли;

	Заполнено = 0;
	НеПринято = 0;
	Для Каждого Строка Из План Цикл
		Попытка
			Форма.Объект[Строка.ПутьРеквизита] = Строка.Значение;
			Заполнено = Заполнено + 1;
		Исключение
			// Реквизита может не быть на конкретной форме объекта, даже если
			// он есть у метаданных: форма вправе его не выводить.
			НеПринято = НеПринято + 1;
			Сообщить(СтрШаблон("%1: форма объекта не приняла значение (%2).",
				Строка.Представление,
				ОписаниеОшибки()));
		КонецПопытки;
	КонецЦикла;

	Если Заполнено > 0 Тогда
		Форма.Модифицированность = Истина;
	КонецЕсли;

	Возврат СтрШаблон(
		"Заполнено реквизитов в форме: %1, не принято: %2."
		+ " Проверьте значения и запишите объект.",
		Заполнено,
		НеПринято);

КонецФункции

// Форма прикладного объекта, из которой вызван помощник.
// БСП открывает обработку, передавая форму объекта владельцем, поэтому
// отдельного канала связи с прикладной формой не нужно.
&НаКлиенте
Функция ФормаОбъекта()

	Форма = ВладелецФормы;
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Если ТипЗнч(Форма.Объект) = Тип("Неопределено") Тогда
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		// У формы списка реквизита «Объект» нет — заполнять нечего.
		Возврат Неопределено;
	КонецПопытки;
	Возврат Форма;

КонецФункции

&НаКлиенте
Процедура ОткрытьДиалогОбработка(Команда)

	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите действие.");
		Возврат;
	КонецЕсли;
	Попытка
		ПараметрыДиалога = ПодготовитьПараметрыДиалогаНаСервере(ТекущиеДанные.МестоЗапуска);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	ОткрытьФорму(
		"Обработка.AI_ЧатПоДаннымБазы.Форма.ДиалогСАгентом",
		ПараметрыДиалога,
		ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбычныйДиалогОбработка(Команда)
	ОткрытьФорму(
		"Обработка.AI_ЧатПоДаннымБазы.Форма.ДиалогСАгентом",
		Новый Структура,
		ЭтотОбъект);
КонецПроцедуры

// Выгружает встроенную в расширение внешнюю обработку, чтобы администратор
// мог зарегистрировать ее в дополнительных отчетах и обработках БСП.
&НаКлиенте
Процедура СохранитьОбработкуБСПОбработка(Команда)

	// Вариант «с диалогом»: пользователь сам выбирает, куда сохранить файл,
	// и в веб-клиенте расширение работы с файлами не требуется.
	Файл = ПодготовитьОбработкуБСПНаСервере();
	НачатьПолучениеФайлаССервера(Файл.Адрес, Файл.Имя);

КонецПроцедуры

// Инструкция собирается из настроенных данных, а не пишется руками, поэтому
// не расходится с системой: что настроено — то и написано.
&НаКлиенте
Процедура СохранитьИнструкциюОбработка(Команда)

	Файл = ПодготовитьИнструкциюНаСервере();
	Если ЗначениеЗаполнено(Файл.Ошибка) Тогда
		Сообщить(Файл.Ошибка);
		Возврат;
	КонецЕсли;
	НачатьПолучениеФайлаССервера(Файл.Адрес, Файл.Имя);

КонецПроцедуры

&НаСервере
Функция ПодготовитьИнструкциюНаСервере()

	Результат = Новый Структура("Адрес,Имя,Ошибка", "", "", "");
	Попытка
		HTML = AI_Инструкции.СформироватьHTML();
		Данные = ПолучитьДвоичныеДанныеИзСтроки(HTML, "UTF-8", Ложь);
		Результат.Адрес = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
		Результат.Имя = AI_Инструкции.ИмяФайлаИнструкции();
	Исключение
		Результат.Ошибка = "Не удалось сформировать инструкцию: " + ОписаниеОшибки();
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область НавигацияМастера

&НаКлиенте
Процедура НачатьСценарий()

	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите действие.");
		Возврат;
	КонецЕсли;

	Попытка
		Подготовка = ВыбратьДействиеНаСервере(ТекущиеДанные.МестоЗапуска);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Подготовка.Отказ) Тогда
		Сообщить(Подготовка.Отказ);
		Возврат;
	КонецЕсли;

	ВсегоУточненийКэш = Подготовка.Уточнений;
	ВидДействияКлиент = Подготовка.ВидДействия;
	ПакетныйРежимКлиент = Подготовка.Пакетный;
	Количество = Подготовка.Уточнений;
	ИндексУточнения = 0;
	Если Количество = 0 Тогда
		ЗапуститьАнализ();
		Возврат;
	КонецЕсли;

	ИндексУточнения = 1;
	Если Не ПоказатьУточнение(ИндексУточнения) Тогда
		// Вид уточнения не поддержан интерфейсом — не притворяемся, что спросили.
		Сообщить("Действие требует уточнения, которое помощник пока не умеет показывать.");
		Возврат;
	КонецЕсли;
	// Заголовок кнопки зависит от того, последнее ли это уточнение.
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьУточнения()

	Ответ = СохранитьОтветУточнения(ИндексУточнения);
	Если ЗначениеЗаполнено(Ответ) Тогда
		Сообщить(Ответ);
		Возврат;
	КонецЕсли;

	Следующий = ИндексУточнения + 1;
	Пока Следующий <= ВсегоУточнений() Цикл
		Если ПоказатьУточнение(Следующий) Тогда
			ИндексУточнения = Следующий;
			ОбновитьСостояниеИнтерфейса();
			Возврат;
		КонецЕсли;
		// Неподдержанный вид пропускаем, но оставляем след в статусе.
		Следующий = Следующий + 1;
	КонецЦикла;

	ЗапуститьАнализ();

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьАнализ()

	Рекомендации.Очистить();
	ТекстОтвета = "";

	Если ПакетныйРежимКлиент = Истина Тогда
		ЗапуститьПакет();
		Возврат;
	КонецЕсли;

	// Серверная часть запуска не должна выбрасывать пользователю
	// «непредвиденную ошибку»: причина нужна ему прямо в мастере.
	Попытка
		Запуск = ЗапуститьНаСервере();
	Исключение
		СтатусОперации = "Не удалось запустить анализ: " + ОписаниеОшибки();
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		СтатусОперации = Запуск.Ошибка;
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецЕсли;

	ИдентификаторОперации = Запуск.ИдентификаторОперации;
	ОперацияВыполняется = Истина;
	НачалоОжидания = ТекущаяДата();
	СтатусОперации = "Анализ выполняется...";
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
	ОбновитьСостояниеИнтерфейса();
	ПодключитьОпросОперации();

КонецПроцедуры

// Пачка объектов обрабатывается по одному: на каждый объект своя агентская
// операция. Параллелизм, повторы и восстановление прерванных берет на себя
// очередь подсистемы — второй такой механизм помощнику не нужен.
// Перенос настройки между базами — работа администратора, и кнопки видны
// только ему. Проверка права живет на сервере, здесь только видимость.
&НаКлиенте
Процедура ВыгрузитьПакетОбработка(Команда)

	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите действие, которое нужно выгрузить.");
		Возврат;
	КонецЕсли;

	Пакет = ПодготовитьПакетНаСервере(ТекущиеДанные.МестоЗапуска);
	Для Каждого Сообщение Из Пакет.Сообщения Цикл
		Сообщить(Сообщение);
	КонецЦикла;
	Если ЗначениеЗаполнено(Пакет.Ошибка) Тогда
		Сообщить(Пакет.Ошибка);
		Возврат;
	КонецЕсли;

	ПолучитьФайл(Пакет.Адрес, Пакет.Имя, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПакетОбработка(Команда)

	Оповещение = Новый ОписаниеОповещения("ЗагрузитьПакетЗавершение", ЭтотОбъект);
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр = "Пакет сценария (*.zip)|*.zip";
	ПараметрыДиалога.Заголовок = "Выберите пакет сценария";
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор, ПараметрыДиалога);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПакетЗавершение(Помещен, Адрес, ВыбранноеИмя, ДополнительныеПараметры) Экспорт

	Если Не Помещен Тогда
		Возврат;
	КонецЕсли;

	Итог = ЗагрузитьПакетНаСервере(Адрес);
	// Загруженные места выключены, поэтому в списке их еще не будет: перечитать
	// нужно все равно — обновление существующего действия видно сразу.
	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Сообщить(Сообщение);
	КонецЦикла;
	Если Итог.Успешно Тогда
		ПрочитатьСписокДействий();
		ОбновитьОписаниеВыбранного();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПакет()

	Попытка
		Запуск = ЗапуститьПакетНаСервере();
	Исключение
		СтатусОперации = "Не удалось запустить пакет: " + ОписаниеОшибки();
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		СтатусОперации = Запуск.Ошибка;
		Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
		ОбновитьСостояниеИнтерфейса();
		Возврат;
	КонецЕсли;

	НачалоОжидания = ТекущаяДата();
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаПакет;
	ОбновитьСостояниеИнтерфейса();
	ПодключитьОпросПакета();

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОпросПакета()
	ПодключитьОбработчикОжидания("ПроверитьСостояниеПакета", 2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСостояниеПакета()

	Осталось = ОбновитьПакетНаСервере();
	Если Осталось > 0 Тогда
		ПодключитьОпросПакета();
	КонецЕсли;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

// Открывает результат одного объекта в обычной странице рекомендаций. Дальше
// работают те же кнопки, что и в одиночном режиме: человек проверяет значения
// и применяет действие к этому объекту.
&НаКлиенте
Процедура ОткрытьРезультатПакетаОбработка(Команда)

	ТекущиеДанные = Элементы.Пакет.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите объект в списке.");
		Возврат;
	КонецЕсли;
	Если Не ТекущиеДанные.Готово Тогда
		Сообщить("По этому объекту анализ еще идет.");
		Возврат;
	КонецЕсли;
	Если Не ТекущиеДанные.Успешно Тогда
		Сообщить("По этому объекту анализ завершился ошибкой: " + ТекущиеДанные.Состояние);
		Возврат;
	КонецЕсли;

	СтатусОперации = ОткрытьСтрокуПакетаНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОписаниеВыбранного()
	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОписаниеВыбранного = "";
		НачальныйЗапросВыбранного = "";
	Иначе
		ОписаниеВыбранного = ТекущиеДанные.Описание;
		НачальныйЗапросВыбранного = ТекущиеДанные.НачальныйЗапрос;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояниеИнтерфейса()

	НаДействиях = (Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаДействия);
	НаУточнении = (Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаУточнение);
	НаРезультате = (Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаРезультат);
	НаПакете = (Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаПакет);

	// Анимация крутится только пока ждем модель — она и есть признак жизни.
	Элементы.ИндикаторОжидания.Видимость = НаРезультате И ОперацияВыполняется;

	Элементы.Назад.Доступность = Не НаДействиях И Не ОперацияВыполняется;
	// На странице пакета «Далее» не при чем: следующий шаг выбирает человек,
	// открывая конкретный объект.
	Элементы.Далее.Видимость = Не НаРезультате И Не НаПакете;
	Элементы.Далее.Доступность = Не ОперацияВыполняется;
	Если НаУточнении И ЗначениеЗаполнено(ВидПродолжения) Тогда
		Элементы.Далее.Заголовок = "Продолжить";
	ИначеЕсли НаУточнении И ИндексУточнения >= ВсегоУточнений() Тогда
		Элементы.Далее.Заголовок = "Запустить анализ";
	Иначе
		Элементы.Далее.Заголовок = "Далее >";
	КонецЕсли;
	// Кнопку действия показываем только там, где действие настроено, а для
	// заполнения формы — еще и когда есть форма объекта.
	// Имя «Заголовок» в модуле формы занято заголовком самой формы —
	// локальная переменная с таким именем стирает заголовок окна.
	ЗаголовокКнопки = ЗаголовокДействия();
	Доступно = ЗначениеЗаполнено(ЗаголовокКнопки)
		И (ВидДействияКлиент <> "ЗаполнитьФорму" Или ФормаОбъекта() <> Неопределено);
	Элементы.ПрименитьРекомендации.Видимость = НаРезультате И Доступно;
	Если Доступно Тогда
		Элементы.ПрименитьРекомендации.Заголовок = ЗаголовокКнопки;
	КонецЕсли;
	Элементы.ПрименитьРекомендации.Доступность = Не ОперацияВыполняется
		И Рекомендации.Количество() > 0;

	// Кнопка записи живет ровно столько, сколько идет ожидание: в остальное
	// время объект записывают обычной командой карточки.
	Элементы.ЗаписатьОбъектВладельца.Видимость = (ОжиданиеЗаписиАктивно = Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОпросОперации()
	ПодключитьОбработчикОжидания("ПроверитьСостояниеОперации", 2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОпросОперации()
	ОтключитьОбработчикОжидания("ПроверитьСостояниеОперации");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСостояниеОперации()

	Если Не ОперацияВыполняется Тогда
		Возврат;
	КонецЕсли;

	Состояние = ПроверитьСостояниеНаСервере();
	Если Не Состояние.Финальная Тогда
		// Обращение к модели идет фоновым заданием, интерфейс не блокируется.
		// Пользователю показываем этап от операции и время ожидания, чтобы
		// длинный ответ модели не выглядел зависанием.
		СтатусОперации = Состояние.Статус + ПрошлоВремени();
		ПодключитьОпросОперации();
		Возврат;
	КонецЕсли;

	СтатусОперации = Состояние.Статус;
	ОперацияВыполняется = Ложь;
	ОбновитьСостояниеИнтерфейса();

КонецПроцедуры

// Сколько идет текущее обращение. Формат намеренно короткий: строка состояния
// и так несет текст этапа.
&НаКлиенте
Функция ПрошлоВремени(Начало = Неопределено)

	Отсчет = ?(Начало = Неопределено, НачалоОжидания, Начало);
	Если Не ЗначениеЗаполнено(Отсчет) Тогда
		Возврат "";
	КонецЕсли;
	Секунд = Цел(ТекущаяДата() - Отсчет);
	Если Секунд < 1 Тогда
		Возврат "";
	КонецЕсли;
	Если Секунд < 60 Тогда
		Возврат СтрШаблон(" (%1 с)", Секунд);
	КонецЕсли;
	Возврат СтрШаблон(" (%1 мин %2 с)", Цел(Секунд / 60), Секунд % 60);

КонецФункции

#КонецОбласти

#Область РаботаСУточнениями

&НаКлиенте
Функция ВсегоУточнений()
	Возврат ?(ВсегоУточненийКэш = Неопределено, 0, ВсегоУточненийКэш);
КонецФункции

// Готовит страницу под вид уточнения. Ложь — вид интерфейсом не поддержан.
&НаСервере
Функция ПоказатьУточнение(Номер)

	Описание = ОписаниеУточнения(Номер);
	Если Описание = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Виды = Перечисления.AI_ВидУточнения;
	Страница = Неопределено;
	ВариантыУточнения.Очистить();
	УточнениеСтрока = "";
	УточнениеЧисло = 0;
	УточнениеДата = '00010101';
	УточнениеФлаг = Ложь;

	Если Описание.ВидУточнения = Виды.ВыборИзПодчиненных
		Или Описание.ВидУточнения = Виды.ВыборИзСписка Тогда
		Страница = Элементы.ВидСписок;
		Список = AI_ИзвлечениеРеквизитов.ПолучитьВариантыУточнения(Описание, КонтекстФормы());
		Для Каждого СтрокаИсточника Из Список Цикл
			СтрокаТаблицы = ВариантыУточнения.Добавить();
			СтрокаТаблицы.Ключ = Строка(СтрокаИсточника.Ссылка.УникальныйИдентификатор());
			СтрокаТаблицы.Представление = СтрокаИсточника.Представление;
			СтрокаТаблицы.Дополнительно = СтрокаИсточника.Дополнительно;
		КонецЦикла;
	ИначеЕсли Описание.ВидУточнения = Виды.ВводСтроки Тогда
		Страница = Элементы.ВидСтрока;
	ИначеЕсли Описание.ВидУточнения = Виды.ВводЧисла Тогда
		Страница = Элементы.ВидЧисло;
	ИначеЕсли Описание.ВидУточнения = Виды.ВводДаты Тогда
		Страница = Элементы.ВидДата;
	ИначеЕсли Описание.ВидУточнения = Виды.Флаг Тогда
		Страница = Элементы.ВидФлаг;
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Страница;
	Элементы.СтраницыМастера.ТекущаяСтраница = Элементы.СтраницаУточнение;
	Элементы.ПояснениеУточнения.Заголовок = ТекстПояснения(Описание, Номер);
	Возврат Истина;

КонецФункции

// Проверяет и запоминает ответ. Возвращает текст ошибки либо пустую строку.
&НаСервере
Функция СохранитьОтветУточнения(Номер)

	Описание = ОписаниеУточнения(Номер);
	Если Описание = Неопределено Тогда
		Возврат "Уточнение больше не доступно.";
	КонецЕсли;

	Виды = Перечисления.AI_ВидУточнения;
	Ключ = "";
	ЗначениеТекстом = "";

	Если Описание.ВидУточнения = Виды.ВыборИзПодчиненных
		Или Описание.ВидУточнения = Виды.ВыборИзСписка Тогда
		НомерСтроки = Элементы.ВариантыУточнения.ТекущаяСтрока;
		ТекущаяСтрока = Неопределено;
		Для Каждого СтрокаТаблицы Из ВариантыУточнения Цикл
			Если СтрокаТаблицы.ПолучитьИдентификатор() = НомерСтроки Тогда
				ТекущаяСтрока = СтрокаТаблицы;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ТекущаяСтрока = Неопределено Тогда
			Возврат ?(ВариантыУточнения.Количество() = 0,
				"Подходящих значений не найдено.",
				"Выберите значение из списка.");
		КонецЕсли;
		Ключ = ТекущаяСтрока.Ключ;
		ЗначениеТекстом = ТекущаяСтрока.Представление;

	ИначеЕсли Описание.ВидУточнения = Виды.ВводСтроки Тогда
		Если Описание.Обязательное И Не ЗначениеЗаполнено(УточнениеСтрока) Тогда
			Возврат "Заполните значение.";
		КонецЕсли;
		ЗначениеТекстом = УточнениеСтрока;

	ИначеЕсли Описание.ВидУточнения = Виды.ВводЧисла Тогда
		Если Описание.Обязательное И Не ЗначениеЗаполнено(УточнениеЧисло) Тогда
			Возврат "Заполните значение.";
		КонецЕсли;
		ЗначениеТекстом = Формат(УточнениеЧисло, "ЧРД=.; ЧГ=0");

	ИначеЕсли Описание.ВидУточнения = Виды.ВводДаты Тогда
		Если Описание.Обязательное И Не ЗначениеЗаполнено(УточнениеДата) Тогда
			Возврат "Заполните дату.";
		КонецЕсли;
		ЗначениеТекстом = ?(ЗначениеЗаполнено(УточнениеДата),
			Формат(УточнениеДата, "ДФ=yyyy-MM-dd"), "");

	ИначеЕсли Описание.ВидУточнения = Виды.Флаг Тогда
		ЗначениеТекстом = ?(УточнениеФлаг, "да", "нет");

	Иначе
		Возврат "Вид уточнения не поддержан.";
	КонецЕсли;

	УдалитьСобранноеУточнениеНаСервере(Номер);
	СтрокаОтвета = СобранныеУточнения.Добавить();
	СтрокаОтвета.НомерСтрокиУточнения = Номер;
	СтрокаОтвета.Идентификатор = ?(ЗначениеЗаполнено(Описание.Идентификатор),
		Описание.Идентификатор, "уточнение_" + Формат(Номер, "ЧГ=0"));
	СтрокаОтвета.Представление = ?(ЗначениеЗаполнено(Описание.Представление),
		Описание.Представление, СтрокаОтвета.Идентификатор);
	СтрокаОтвета.Ключ = Ключ;
	СтрокаОтвета.ЗначениеТекстом = Лев(ЗначениеТекстом, 500);
	СтрокаОтвета.ПередаватьСодержимое = Описание.ПередаватьСодержимое;

	Возврат "";

КонецФункции

&НаКлиенте
Процедура УдалитьСобранноеУточнение(Номер)
	УдалитьСобранноеУточнениеНаСервере(Номер);
КонецПроцедуры

&НаСервере
Процедура УдалитьСобранноеУточнениеНаСервере(Номер)
	Отбор = Новый Структура("НомерСтрокиУточнения", Номер);
	Для Каждого СтрокаТаблицы Из СобранныеУточнения.НайтиСтроки(Отбор) Цикл
		СобранныеУточнения.Удалить(СтрокаТаблицы);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ОписаниеУточнения(Номер)

	Если Не ЗначениеЗаполнено(ТекущееМестоЗапуска) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Уточнения = ТекущееМестоЗапуска.Уточнения;
	Если Номер < 1 Или Номер > Уточнения.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Уточнения[Номер - 1];

КонецФункции

&НаСервереБезКонтекста
Функция ТекстПояснения(Описание, Номер)
	Текст = ?(ЗначениеЗаполнено(Описание.Подсказка),
		Описание.Подсказка,
		?(ЗначениеЗаполнено(Описание.Представление),
			Описание.Представление,
			"Уточните детали действия."));
	Возврат "Шаг " + Формат(Номер, "ЧГ=0") + ". " + Текст;
КонецФункции

#КонецОбласти

#Область СерверныеВызовы

&НаСервере
Функция ВыбратьДействиеНаСервере(МестоЗапуска)

	ТекущееМестоЗапуска = МестоЗапуска;
	СобранныеУточнения.Очистить();
	ВариантыУточнения.Очистить();
	Рекомендации.Очистить();
	Пакетный = КоличествоОбъектов > 1
		И AI_ИнтерфейсныеСценарии.РежимВыполненияОчередью(МестоЗапуска);

	// В пакете уточнение с источником данных разрешается по каждому объекту
	// отбором — спрашивать про файл тридцать раз бессмысленно. А уточнение без
	// источника задать нечем: один ответ на всю пачку означал бы, что человек
	// отвечает за объекты, которых он не видел. Такое действие честно
	// отклоняем, а не выполняем наполовину.
	Отказ = "";
	Если Пакетный Тогда
		Для Каждого Уточнение Из МестоЗапуска.Уточнения Цикл
			Если Не ЗначениеЗаполнено(Уточнение.ИсточникДанных) Тогда
				Отказ = "Действие спрашивает уточнение «" + Уточнение.Представление
					+ "», которое нельзя задать сразу для нескольких объектов."
					+ " Запустите его по одному объекту.";
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("Уточнений,ВидДействия,Пакетный,Отказ",
		?(Пакетный, 0, МестоЗапуска.Уточнения.Количество()),
		ВидДействияСтрокой(МестоЗапуска.ВидДействия),
		Пакетный,
		Отказ);

КонецФункции

// КонтекстЗапуска и АвтоВыборФайлов нужны массовому режиму: он запускает эту
// же процедуру по разу на объект, и файл у каждого объекта свой. Спрашивать про
// файл по каждому объекту бессмысленно — отбор уточнения и так однозначен.
&НаСервере
Функция ЗапуститьНаСервере(КонтекстЗапуска = Неопределено, АвтоВыборФайлов = Ложь)

	Результат = Новый Структура("ИдентификаторОперации,Ошибка",
		ПустойУникальныйИдентификатор(), "");

	Контекст = ?(КонтекстЗапуска = Неопределено, КонтекстФормы(), КонтекстЗапуска);

	Попытка
		ПараметрыДиалога = AI_ИнтерфейсныеСценарии.ПодготовитьПараметрыДиалога(
			ТекущееМестоЗапуска,
			Контекст,
			НачальныйЗапросВыбранного);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	ДанныеКонтекстаЗапуска = ПараметрыДиалога.ДанныеКонтекста;
	СписокВложений = Новый Массив;

	// Вложения подсистемы привязаны к диалогу, а прикладная операция диалога
	// не создает: ей выдается технический UUID без записи. Поэтому запуск идет
	// диалоговым путем — заодно пользователь может открыть переписку целиком.
	Попытка
		ИдентификаторДиалогаЗапуска = AI_ДиалогиКлиентСервер.СоздатьДиалог(
			НастройкиДиалогаЗапуска(ПараметрыДиалога));
	Исключение
		Результат.Ошибка = "Не удалось создать диалог запуска: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	// В пакете ответов от человека нет: уточнения с источником данных
	// разрешаются отбором по каждому объекту.
	Ответы = ?(АвтоВыборФайлов, АвтоответыУточнений(), СобранныеУточнения);

	Для Каждого Ответ Из Ответы Цикл
		ДанныеКонтекстаЗапуска = ДанныеКонтекстаЗапуска + Символы.ПС
			+ Ответ.Представление + ": " + Ответ.ЗначениеТекстом;
		Если Не Ответ.ПередаватьСодержимое Или Не ЗначениеЗаполнено(Ответ.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		// Файл уходит модели настоящим вложением через штатный конвейер
		// подсистемы: разбирать его средствами конфигурации не требуется.
		Подготовка = ПодготовитьВложениеОперации(
			Ответ,
			ПараметрыДиалога.Сценарий,
			ИдентификаторДиалогаЗапуска,
			Контекст,
			АвтоВыборФайлов);
		Если Не Подготовка.Успех Тогда
			Результат.Ошибка = Подготовка.Причина;
			Возврат Результат;
		КонецЕсли;
		Если Подготовка.Вложение <> Неопределено Тогда
			СписокВложений.Добавить(Подготовка.Вложение);
		КонецЕсли;
	КонецЦикла;

	// Имя «Параметры» в модуле формы занято параметрами самой формы:
	// присваивание в него валится с «Поле объекта недоступно для записи».
	ПараметрыОперации = AI_ПубличныйAPI.ПараметрыВыполнения();
	ПараметрыОперации.Сценарий = ПараметрыДиалога.Сценарий;
	ПараметрыОперации.Промт = ПараметрыДиалога.НачальныйЗапрос;
	ПараметрыОперации.ДанныеКонтекста = ДанныеКонтекстаЗапуска;
	ПараметрыОперации.Вложения = СписокВложений;
	ПараметрыОперации.КонтекстJSON = ПараметрыДиалога.КонтекстJSON;
	ПараметрыОперации.ВерсияКонтекста = ПараметрыДиалога.ВерсияКонтекста;
	ПараметрыОперации.ТипИсточника = ПараметрыДиалога.ТипИсточника;
	ПараметрыОперации.КлючИсточника = ПараметрыДиалога.КлючИсточника;
	ПараметрыОперации.ПредставлениеИсточника = ПараметрыДиалога.ПредставлениеИсточника;
	ПараметрыОперации.Вставить("ИдентификаторДиалога", ИдентификаторДиалогаЗапуска);

	Попытка
		Запуск = AI_АгентскиеОперации.НачатьОперацию(ПараметрыОперации);
		Результат.ИдентификаторОперации = Запуск.ИдентификаторОперации;
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Настройки беседы для запуска из мастера: их же увидит пользователь,
// если откроет диалог, чтобы посмотреть переписку целиком.
&НаСервере
Функция НастройкиДиалогаЗапуска(ПараметрыДиалога)

	Сценарий = ПараметрыДиалога.Сценарий;
	Возврат Новый Структура(
		"Сценарий,Провайдер,Модель,Агент,ТипAPI,ДанныеКонтекста,КонтекстJSON,ВерсияКонтекста,ТипИсточника,КлючИсточника,ПредставлениеИсточника",
		Сценарий,
		Сценарий.Провайдер,
		Сценарий.Модель,
		Сценарий.Агент,
		Сценарий.ТипAPI,
		ПараметрыДиалога.ДанныеКонтекста,
		ПараметрыДиалога.КонтекстJSON,
		ПараметрыДиалога.ВерсияКонтекста,
		ПараметрыДиалога.ТипИсточника,
		ПараметрыДиалога.КлючИсточника,
		ПараметрыДиалога.ПредставлениеИсточника);

КонецФункции

// Кладет выбранный прикладной файл во вложения подсистемы.
// Содержимое ядро получает само: из реквизита-хранилища либо через
// переопределяемый модуль. Разбор файла конфигурацией не нужен.
&НаСервере
Функция ПодготовитьВложениеОперации(Ответ, Сценарий, ИдентификаторДиалога,
		КонтекстОбъекта = Неопределено, АвтоВыбор = Ложь)

	Результат = Новый Структура("Успех,Вложение,Причина", Ложь, Неопределено, "");

	Описание = ОписаниеУточнения(Ответ.НомерСтрокиУточнения);
	Если Описание = Неопределено Тогда
		Результат.Причина = "Уточнение с файлом больше не доступно.";
		Возврат Результат;
	КонецЕсли;

	Выбранный = Неопределено;
	Контекст = ?(КонтекстОбъекта = Неопределено, КонтекстФормы(), КонтекстОбъекта);
	Попытка
		Список = AI_ИзвлечениеРеквизитов.ПолучитьВариантыУточнения(Описание, Контекст);
	Исключение
		Результат.Причина = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	Для Каждого СтрокаИсточника Из Список Цикл
		Если АвтоВыбор
			Или Строка(СтрокаИсточника.Ссылка.УникальныйИдентификатор()) = Ответ.Ключ Тогда
			Выбранный = СтрокаИсточника.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Выбранный = Неопределено Тогда
		Результат.Причина = ?(АвтоВыбор,
			"У объекта нет файла, подходящего под отбор уточнения.",
			"Выбранный файл больше не доступен.");
		Возврат Результат;
	КонецЕсли;

	Содержимое = AI_ИзвлечениеРеквизитов.ПолучитьСодержимоеВложения(Выбранный, Описание);
	Если Не Содержимое.Получено Тогда
		Результат.Причина = Содержимое.Причина;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Адрес = ПоместитьВоВременноеХранилище(Содержимое.Содержимое, УникальныйИдентификатор);
		// СохранитьВложение отдает описание для формы, а операция принимает
		// массив ссылок — берем из описания именно ссылку.
		Сохраненное = AI_Вложения.СохранитьВложение(
			Содержимое.ИмяФайла,
			Адрес,
			ИдентификаторДиалога,
			Сценарий.Провайдер);
		Результат.Вложение = Сохраненное.Ссылка;
		Результат.Успех = Истина;
	Исключение
		Результат.Причина = "Не удалось подготовить вложение: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выполняет действие, объявленное на месте запуска. Для вида «Заполнить форму»
// ядро только возвращает план — подставляет значения уже клиентская часть.
&НаСервере
Функция ВыполнитьДействиеНаСервере(ОтветПользователя, СостояниеШага)

	Результат = Новый Структура(
		"План,Обработано,Отклонено,Ошибка,Сообщения,ЕстьПродолжение,ТекстПродолжения,Состояние"
			+ ",СледующееМесто,СледующееПредставление,СледующаяПричина",
		Новый Массив, 0, 0, "", Новый Массив, Ложь, "", СостояниеШага,
		Неопределено, "", "");

	// Типизированные значения берем из свежего разбора ответа: на форме лежат
	// только представления. Разбираем один раз на все заполнение.
	Разобранное = Неопределено;
	Если ЗначениеЗаполнено(ТекущееМестоЗапуска.КартаИзвлечения) И ЗначениеЗаполнено(ТекстОтвета) Тогда
		Попытка
			Разобранное = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(
				ТекущееМестоЗапуска.КартаИзвлечения,
				ТекстОтвета);
		Исключение
			Результат.Ошибка = "Не удалось разобрать ответ модели: " + ОписаниеОшибки();
			Возврат Результат;
		КонецПопытки;
	КонецЕсли;
	Если Разобранное = Неопределено Тогда
		Результат.Ошибка = "Нет разобранного ответа модели — заполнять нечего.";
		Возврат Результат;
	КонецЕсли;

	Значения = Новый ТаблицаЗначений;
	Значения.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	Значения.Колонки.Добавить("Значение");
	// В ядро уходят только отмеченные и распознанные строки. Соответствие
	// «ключ -> реквизит» ядро берет из карты само, клиентский путь не в счет.
	Для Каждого СтрокаТаблицы Из Рекомендации Цикл
		Если Не СтрокаТаблицы.Применить Или Не СтрокаТаблицы.Распознано Тогда
			Продолжить;
		КонецЕсли;
		Строки = Разобранное.НайтиСтроки(Новый Структура("Ключ", СтрокаТаблицы.Ключ));
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЗначения = Значения.Добавить();
		СтрокаЗначения.Ключ = СтрокаТаблицы.Ключ;
		СтрокаЗначения.Значение = Строки[0].Значение;
	КонецЦикла;

	Попытка
		Действие = AI_ПрименениеРекомендаций.ВыполнитьДействие(
			ТекущееМестоЗапуска,
			КонтекстФормы(),
			Значения,
			ШагДействия,
			СостояниеШага,
			ОтветПользователя);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Результат.План = Действие.План;
	Результат.Обработано = Действие.Обработано;
	Результат.Отклонено = Действие.Отклонено;
	Результат.Ошибка = Действие.Ошибка;
	Для Каждого Сообщение Из Действие.Сообщения Цикл
		Результат.Сообщения.Добавить(Сообщение);
	КонецЦикла;

	Результат.Состояние = Действие.Состояние;

	Если Действие.СледующееДействие <> Неопределено Тогда
		Результат.СледующееМесто = Действие.СледующееДействие.МестоЗапуска;
		Результат.СледующееПредставление = Действие.СледующееДействие.Представление;
		Результат.СледующаяПричина = Действие.СледующееДействие.Причина;
	КонецЕсли;

	Если Действие.Продолжение <> Неопределено Тогда
		Результат.ЕстьПродолжение = ПоказатьПродолжениеНаСервере(Действие.Продолжение);
		Если Не Результат.ЕстьПродолжение Тогда
			Результат.Ошибка = "Обработчик запросил шаг, который помощник"
				+ " пока не умеет показывать: " + ВидПродолжения;
		Иначе
			Результат.ТекстПродолжения = Элементы.ПояснениеУточнения.Заголовок;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Готовит страницу под шаг, который запросил обработчик. Словарь видов тот же,
// что у декларативных уточнений, поэтому новых страниц не требуется.
&НаСервере
Функция ПоказатьПродолжениеНаСервере(Продолжение)

	ВидПродолжения = "";
	ПродолжениеОбязательное = Ложь;
	Если ТипЗнч(Продолжение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Вид = "";
	Продолжение.Свойство("ВидУточнения", Вид);
	ВидПродолжения = СокрЛП(Строка(Вид));
	Продолжение.Свойство("Обязательное", ПродолжениеОбязательное);

	ВариантыУточнения.Очистить();
	УточнениеСтрока = "";
	УточнениеЧисло = 0;
	УточнениеДата = '00010101';
	УточнениеФлаг = Ложь;

	Подсказка = "";
	Продолжение.Свойство("Подсказка", Подсказка);
	Если Не ЗначениеЗаполнено(Подсказка) Тогда
		Продолжение.Свойство("Представление", Подсказка);
	КонецЕсли;
	Элементы.ПояснениеУточнения.Заголовок = Строка(Подсказка);

	Если ВидПродолжения = "Вопрос" Тогда
		// Показывается диалогом, страница не нужна.
		Возврат Истина;
	КонецЕсли;

	Если ВидПродолжения = "ОжиданиеЗаписи" Тогда
		// Страницы нет: шаг ждет человека в форме объекта, а не в помощнике.
		Возврат Истина;
	КонецЕсли;

	Если ВидПродолжения = "ВыборИзВариантов" Тогда
		Варианты = Неопределено;
		Продолжение.Свойство("Варианты", Варианты);
		Если ТипЗнч(Варианты) <> Тип("Массив") Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого Вариант Из Варианты Цикл
			СтрокаТаблицы = ВариантыУточнения.Добавить();
			Ключ = "";
			Представление = "";
			Вариант.Свойство("Ключ", Ключ);
			Вариант.Свойство("Представление", Представление);
			СтрокаТаблицы.Ключ = Строка(Ключ);
			СтрокаТаблицы.Представление = ?(ЗначениеЗаполнено(Представление),
				Строка(Представление), Строка(Ключ));
		КонецЦикла;
		Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Элементы.ВидСписок;
	ИначеЕсли ВидПродолжения = "ВводСтроки" Тогда
		Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Элементы.ВидСтрока;
	ИначеЕсли ВидПродолжения = "ВводЧисла" Тогда
		Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Элементы.ВидЧисло;
	ИначеЕсли ВидПродолжения = "ВводДаты" Тогда
		Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Элементы.ВидДата;
	ИначеЕсли ВидПродолжения = "Флаг" Тогда
		Элементы.СтраницыВидаУточнения.ТекущаяСтраница = Элементы.ВидФлаг;
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Собирает ответ пользователя на шаг продолжения.
// Возвращает структуру ответа либо строку с текстом ошибки.
&НаКлиенте
Функция СобратьОтветПродолжения()

	Если ВидПродолжения = "ВыборИзВариантов" Тогда
		ТекущиеДанные = Элементы.ВариантыУточнения.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат ?(ВариантыУточнения.Количество() = 0,
				"Обработчик не предложил ни одного варианта.",
				"Выберите вариант.");
		КонецЕсли;
		Возврат Новый Структура("Ключ,Значение,Представление",
			ТекущиеДанные.Ключ, ТекущиеДанные.Ключ, ТекущиеДанные.Представление);
	КонецЕсли;

	Если ВидПродолжения = "ВводСтроки" Тогда
		Если ПродолжениеОбязательное И Не ЗначениеЗаполнено(УточнениеСтрока) Тогда
			Возврат "Заполните значение.";
		КонецЕсли;
		Возврат Новый Структура("Ключ,Значение,Представление",
			"", УточнениеСтрока, УточнениеСтрока);
	КонецЕсли;

	Если ВидПродолжения = "ВводЧисла" Тогда
		Если ПродолжениеОбязательное И Не ЗначениеЗаполнено(УточнениеЧисло) Тогда
			Возврат "Заполните значение.";
		КонецЕсли;
		Возврат Новый Структура("Ключ,Значение,Представление",
			"", УточнениеЧисло, Строка(УточнениеЧисло));
	КонецЕсли;

	Если ВидПродолжения = "ВводДаты" Тогда
		Если ПродолжениеОбязательное И Не ЗначениеЗаполнено(УточнениеДата) Тогда
			Возврат "Заполните дату.";
		КонецЕсли;
		Возврат Новый Структура("Ключ,Значение,Представление",
			"", УточнениеДата, Строка(УточнениеДата));
	КонецЕсли;

	Если ВидПродолжения = "Флаг" Тогда
		Возврат Новый Структура("Ключ,Значение,Представление",
			"", УточнениеФлаг, ?(УточнениеФлаг, "да", "нет"));
	КонецЕсли;

	Возврат "Неизвестный вид шага: " + ВидПродолжения;

КонецФункции

// Опрос состояния не должен ронять форму: любая ошибка становится статусом,
// иначе пользователь видит «непредвиденную ошибку» без единой подсказки.
&НаСервере
Функция ПроверитьСостояниеНаСервере()

	Результат = Новый Структура("Финальная,Статус", Истина, "");

	Попытка
		Состояние = AI_ПубличныйAPI.ПолучитьСостояние(ИдентификаторОперации);

		Результат.Финальная = Состояние.Финальная;
		Если Не Состояние.Финальная Тогда
			Результат.Статус = "Анализ выполняется: " + Состояние.ТекстСтатуса;
			Возврат Результат;
		КонецЕсли;

		Если Не Состояние.Успешно Тогда
			Результат.Статус = "Анализ завершился с ошибкой: " + Состояние.ТекстОшибки;
			Возврат Результат;
		КонецЕсли;

		ТекстОтвета = Строка(Состояние.Результат);
		Результат.Статус = ЗаполнитьРекомендации();
	Исключение
		Результат.Финальная = Истина;
		Результат.Статус = "Сбой при получении результата: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Ставит в очередь по операции на каждый объект контекста.
//
// Ошибка по одному объекту не отменяет остальные: строка помечается неуспешной
// с причиной. Иначе один недоступный файл из тридцати рушил бы весь пакет.
// Псевдоответы на уточнения для массового режима: сами значения подставит
// отбор по объекту, здесь важны только номер строки уточнения и признак
// «передавать содержимое».
// Переход по цепочке — тот же выбор действия, что и руками: место запуска
// перечитывается, доступ проверяется заново, состояние прошлого шага
// сбрасывается. Иначе следующий сценарий унаследовал бы чужие ответы.
&НаСервере
Функция ПерейтиКДействиюНаСервере(МестоЗапуска)

	Результат = Новый Структура("Уточнений,ВидДействия,Ошибка", 0, "", "");

	Попытка
		Подготовка = ВыбратьДействиеНаСервере(МестоЗапуска);
	Исключение
		Результат.Ошибка = "Не удалось перейти к следующему действию: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Подготовка.Отказ) Тогда
		Результат.Ошибка = Подготовка.Отказ;
		Возврат Результат;
	КонецЕсли;

	НачальныйЗапросВыбранного = МестоЗапуска.НачальныйЗапрос;
	Результат.Уточнений = Подготовка.Уточнений;
	Результат.ВидДействия = Подготовка.ВидДействия;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПодготовитьПакетНаСервере(МестоЗапуска)

	Результат = Новый Структура("Адрес,Имя,Ошибка,Сообщения", "", "", "", Новый Массив);

	Попытка
		Пакет = AI_ПакетыСценариев.Выгрузить(МестоЗапуска);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Для Каждого Строка Из Пакет.Состав Цикл
		Результат.Сообщения.Добавить("В пакет вошло — " + Строка);
	КонецЦикла;
	Для Каждого Строка Из Пакет.Предупреждения Цикл
		Результат.Сообщения.Добавить(Строка);
	КонецЦикла;

	Результат.Адрес = ПоместитьВоВременноеХранилище(Пакет.Данные, УникальныйИдентификатор);
	Результат.Имя = Пакет.Имя;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗагрузитьПакетНаСервере(Адрес)

	Результат = Новый Структура("Успешно,Сообщения", Ложь, Новый Массив);

	Попытка
		Итог = AI_ПакетыСценариев.Загрузить(Адрес);
	Исключение
		Результат.Сообщения.Добавить(ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Для Каждого Строка Из Итог.Загружено Цикл
		Результат.Сообщения.Добавить(Строка);
	КонецЦикла;
	Для Каждого Строка Из Итог.Предупреждения Цикл
		Результат.Сообщения.Добавить(Строка);
	КонецЦикла;
	Для Каждого Строка Из Итог.Ошибки Цикл
		Результат.Сообщения.Добавить("Отказ: " + Строка);
	КонецЦикла;

	Результат.Успешно = (Итог.Ошибки.Количество() = 0);
	Если Результат.Успешно Тогда
		Результат.Сообщения.Добавить(
			"Загруженные места запуска выключены: включите их после проверки.");
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Функция АвтоответыУточнений()

	Ответы = Новый ТаблицаЗначений;
	Ответы.Колонки.Добавить("НомерСтрокиУточнения", Новый ОписаниеТипов("Число"));
	Ответы.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	Ответы.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Ответы.Колонки.Добавить("ЗначениеТекстом", Новый ОписаниеТипов("Строка"));
	Ответы.Колонки.Добавить("ПередаватьСодержимое", Новый ОписаниеТипов("Булево"));

	Номер = 0;
	Для Каждого Уточнение Из ТекущееМестоЗапуска.Уточнения Цикл
		Номер = Номер + 1;
		Если Не ЗначениеЗаполнено(Уточнение.ИсточникДанных) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаОтвета = Ответы.Добавить();
		СтрокаОтвета.НомерСтрокиУточнения = Номер;
		СтрокаОтвета.Представление = Уточнение.Представление;
		СтрокаОтвета.ЗначениеТекстом = "выбрано отбором";
		СтрокаОтвета.ПередаватьСодержимое = Уточнение.ПередаватьСодержимое;
	КонецЦикла;

	Возврат Ответы;

КонецФункции

&НаСервере
Функция ЗапуститьПакетНаСервере()

	Результат = Новый Структура("Ошибка", "");
	Пакет.Очистить();

	Попытка
		Контексты = AI_ИнтерфейсныеСценарии.КонтекстыОбъектов(КонтекстФормы());
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если Контексты.Количество() = 0 Тогда
		Результат.Ошибка = "В контексте нет объектов, по которым можно запустить пакет.";
		Возврат Результат;
	КонецЕсли;

	Запущено = 0;
	Для Каждого КонтекстОбъекта Из Контексты Цикл
		СтрокаПакета = Пакет.Добавить();
		СтрокаПакета.Представление = КонтекстОбъекта.ПредставлениеИсточника;
		СтрокаПакета.ПолноеИмя = КонтекстОбъекта.ПолноеИмяМетаданных;
		СтрокаПакета.Ключ = КонтекстОбъекта.КлючИсточника;

		// Отбор места запуска проверяется по каждому объекту: в пачку могли
		// попасть и те, к которым действие не относится. Молча пропускать их
		// нельзя — человек должен видеть, почему объект не обработан.
		Если Не AI_ИзвлечениеРеквизитов.ПроверитьОтборыКонтекста(
				ТекущееМестоЗапуска, КонтекстОбъекта) Тогда
			СтрокаПакета.Готово = Истина;
			СтрокаПакета.Состояние = "Пропущен: объект не подходит под отбор действия";
			Продолжить;
		КонецЕсли;

		Попытка
			Запуск = ЗапуститьНаСервере(КонтекстОбъекта, Истина);
		Исключение
			СтрокаПакета.Готово = Истина;
			СтрокаПакета.Состояние = "Не удалось запустить: " + ОписаниеОшибки();
			Продолжить;
		КонецПопытки;

		Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
			СтрокаПакета.Готово = Истина;
			СтрокаПакета.Состояние = Запуск.Ошибка;
			Продолжить;
		КонецЕсли;

		СтрокаПакета.Идентификатор = Строка(Запуск.ИдентификаторОперации);
		СтрокаПакета.Состояние = "В очереди";
		Запущено = Запущено + 1;
	КонецЦикла;

	Если Запущено = 0 Тогда
		Результат.Ошибка = "Ни одну операцию пакета запустить не удалось."
			+ " Причины по объектам — в списке.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Опрашивает незавершенные операции пакета. Возвращает, сколько осталось.
//
// Опрос заодно двигает очередь: ПолучитьСостояние обслуживает очередь своего
// пользователя, поэтому пакет идет и там, где регламентное задание не работает.
&НаСервере
Функция ОбновитьПакетНаСервере()

	Осталось = 0;
	Для Каждого СтрокаПакета Из Пакет Цикл
		Если СтрокаПакета.Готово Или Не ЗначениеЗаполнено(СтрокаПакета.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Состояние = AI_ПубличныйAPI.ПолучитьСостояние(
				Новый УникальныйИдентификатор(СтрокаПакета.Идентификатор));
		Исключение
			СтрокаПакета.Готово = Истина;
			СтрокаПакета.Состояние = "Сбой при получении состояния: " + ОписаниеОшибки();
			Продолжить;
		КонецПопытки;

		Если Не Состояние.Финальная Тогда
			СтрокаПакета.Состояние = Состояние.ТекстСтатуса;
			Осталось = Осталось + 1;
			Продолжить;
		КонецЕсли;

		СтрокаПакета.Готово = Истина;
		Если Не Состояние.Успешно Тогда
			СтрокаПакета.Состояние = "Ошибка: " + Состояние.ТекстОшибки;
			Продолжить;
		КонецЕсли;

		СтрокаПакета.Успешно = Истина;
		СтрокаПакета.ТекстОтвета = Строка(Состояние.Результат);
		СтрокаПакета.Состояние = "Готово, результат можно проверить";
	КонецЦикла;

	Возврат Осталось;

КонецФункции

// Делает выбранный объект пакета текущим: контекст формы переключается на него,
// а рекомендации разбираются из его ответа. Дальше работает обычный одиночный
// путь — те же проверки и то же действие.
&НаСервере
Функция ОткрытьСтрокуПакетаНаСервере(ИдентификаторСтроки)

	СтрокаПакета = Пакет.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаПакета = Неопределено Тогда
		Возврат "Строка пакета не найдена.";
	КонецЕсли;

	ПолноеИмяМетаданных = СтрокаПакета.ПолноеИмя;
	ТипИсточника = СтрокаПакета.ПолноеИмя;
	КлючИсточника = СтрокаПакета.Ключ;
	ПредставлениеИсточника = СтрокаПакета.Представление;
	КонтекстПредставление = СтрокаПакета.Представление;
	КоличествоОбъектов = 1;
	ТекстОтвета = СтрокаПакета.ТекстОтвета;

	Возврат ЗаполнитьРекомендации();

КонецФункции

&НаСервере
Функция ЗаполнитьРекомендации()

	Рекомендации.Очистить();
	Карта = ТекущееМестоЗапуска.КартаИзвлечения;
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Возврат "Анализ завершен. У места запуска не задана карта извлечения,"
			+ " поэтому ответ модели показан только в диалоге.";
	КонецЕсли;

	Попытка
		Таблица = AI_ИзвлечениеРеквизитов.РазобратьРекомендации(Карта, ТекстОтвета);
	Исключение
		Возврат "Не удалось разобрать ответ модели: " + ОписаниеОшибки();
	КонецПопытки;

	Распознано = 0;
	Для Каждого СтрокаИсточника Из Таблица Цикл
		СтрокаТаблицы = Рекомендации.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаИсточника);
		СтрокаТаблицы.ЗначениеСтрокой = Лев(Строка(СтрокаИсточника.Значение), 500);
		// Отмечаем только распознанное, но записи без подтверждения все равно нет.
		СтрокаТаблицы.Применить = СтрокаИсточника.Распознано;
		Если СтрокаИсточника.Распознано Тогда
			Распознано = Распознано + 1;
		КонецЕсли;
	КонецЦикла;

	Виды = Перечисления.AI_ВидДействия;
	ВидДействия = ТекущееМестоЗапуска.ВидДействия;
	Если ВидДействия = Виды.ЗаполнитьФорму Тогда
		Хвост = " Проверьте значения и нажмите «Заполнить форму».";
	ИначеЕсли ВидДействия = Виды.ЗаписатьОбъект Тогда
		Хвост = " Проверьте значения и нажмите «Записать в объект».";
	ИначеЕсли ВидДействия = Виды.ПользовательскоеДействие
		Или ВидДействия = Виды.ВнешнийОбработчик Тогда
		Хвост = " Проверьте значения и нажмите «Выполнить действие».";
	Иначе
		Хвост = " Действие с результатом не настроено — значения только показаны.";
	КонецЕсли;

	Возврат СтрШаблон(
		"Анализ завершен. Распознано реквизитов: %1 из %2.%3",
		Распознано,
		Рекомендации.Количество(),
		Хвост);

КонецФункции

&НаСервере
Функция ПодготовитьПараметрыДиалогаНаСервере(МестоЗапуска)
	Возврат AI_ИнтерфейсныеСценарии.ПодготовитьПараметрыДиалога(
		МестоЗапуска,
		КонтекстФормы(),
		НачальныйЗапросВыбранного);
КонецФункции

&НаСервере
Функция ПодготовитьОбработкуБСПНаСервере()

	Возврат Новый Структура(
		"Адрес,Имя",
		AI_ИнтерфейсныеСценарии.АдресВстроеннойОбработкиБСП(УникальныйИдентификатор),
		AI_ИнтерфейсныеСценарии.ИмяФайлаВстроеннойОбработкиБСП());

КонецФункции

// Вид действия уходит на клиент строкой: сравнивать строки проще, чем
// вызывать ПредопределенноеЗначение на каждую перерисовку кнопки.
&НаСервереБезКонтекста
Функция ВидДействияСтрокой(ВидДействия)

	Виды = Перечисления.AI_ВидДействия;
	Если ВидДействия = Виды.ЗаполнитьФорму Тогда
		Возврат "ЗаполнитьФорму";
	ИначеЕсли ВидДействия = Виды.ЗаписатьОбъект Тогда
		Возврат "ЗаписатьОбъект";
	ИначеЕсли ВидДействия = Виды.ПользовательскоеДействие Тогда
		Возврат "ПользовательскоеДействие";
	ИначеЕсли ВидДействия = Виды.ВнешнийОбработчик Тогда
		Возврат "ВнешнийОбработчик";
	КонецЕсли;
	Возврат "ТолькоПоказать";

КонецФункции

&НаСервереБезКонтекста
Функция ПустойУникальныйИдентификатор()

	Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");

КонецФункции

&НаСервере
Функция КонтекстФормы()
	Возврат Новый Структура(
		"ТипМеста,ПолноеИмяМетаданных,ТипИсточника,КлючИсточника,ПредставлениеИсточника,КонтекстJSON,ДанныеКонтекста,КоличествоОбъектов",
		ТипМеста,
		ПолноеИмяМетаданных,
		ТипИсточника,
		КлючИсточника,
		ПредставлениеИсточника,
		КонтекстJSON,
		ДанныеКонтекста,
		КоличествоОбъектов);
КонецФункции

#КонецОбласти
