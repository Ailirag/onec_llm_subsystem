КонецФункции

Процедура ДополнитьИзвестныеМоделиYandex(Модели)

	Для Каждого ОписаниеМодели Из Модели Цикл
		Если СтрНайти(НРег(ОписаниеМодели.КодAPI), "qwen3.6-35b-a3b") > 0 Тогда
			ОписаниеМодели.Вставить("ПоддерживаетИзображения", Истина);
			ОписаниеМодели.Вставить("ПоддерживаетФайлы", Истина);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ДобавитьОписаниеМодели(
		Модели,
		"qwen3.6-35b-a3b",
		"Мультимодальная модель Yandex Model Gallery для анализа изображений и документов.",
		"YANDEX_QWEN_3_6_35B_A3B",
		Истина,
		Истина,
		Истина);

КонецПроцедуры

Процедура ДобавитьОписаниеМодели(Модели, КодAPI, Описание,
		ИдентификаторДляЛогики = "", ОбновлятьОписание = Истина,
		ПоддерживаетИзображения = Ложь, ПоддерживаетФайлы = Ложь)

	Модели.Добавить(Новый Структура(
		"КодAPI,Описание,ИдентификаторДляЛогики,ОбновлятьОписание,ПоддерживаетИзображения,ПоддерживаетФайлы",
		КодAPI, Описание, ИдентификаторДляЛогики, ОбновлятьОписание,
		ПоддерживаетИзображения, ПоддерживаетФайлы));

КонецПроцедуры

Функция ЗаписатьМодели(Провайдер, Модели)

	СуществующиеМодели = ПолучитьСуществующиеМодели(Провайдер);
	Результат = Новый Структура("Создано,Обновлено,БезИзменений", 0, 0, 0);
	МодельАнализаПоУмолчанию = Справочники.AI_Модели.ПустаяСсылка();

	Для Каждого ОписаниеМодели Из Модели Цикл
		КлючМодели = НРег(ОписаниеМодели.КодAPI);
		СсылкаМодели = СуществующиеМодели.Получить(КлючМодели);
		НоваяМодель = (СсылкаМодели = Неопределено);

		Если НоваяМодель Тогда
			ОбъектМодели = Справочники.AI_Модели.СоздатьЭлемент();
			Изменено = Истина;
		Иначе
			ОбъектМодели = СсылкаМодели.ПолучитьОбъект();
			Изменено = Ложь;
		КонецЕсли;

		Если ОбъектМодели.Владелец <> Провайдер Тогда
			ОбъектМодели.Владелец = Провайдер;
			Изменено = Истина;
		КонецЕсли;
		Если ОбъектМодели.Наименование <> ОписаниеМодели.КодAPI Тогда
			ОбъектМодели.Наименование = ОписаниеМодели.КодAPI;
			Изменено = Истина;
		КонецЕсли;
		ОбновитьОписание = НоваяМодель
			Или ОписаниеМодели.ОбновлятьОписание
			Или Не ЗначениеЗаполнено(ОбъектМодели.Описание);
		Если ОбновитьОписание
				И ОбъектМодели.Описание <> ОписаниеМодели.Описание Тогда
			ОбъектМодели.Описание = Лев(ОписаниеМодели.Описание, 150);
			Изменено = Истина;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОбъектМодели.ИдентификаторДляЛогики) Тогда
			ОбъектМодели.ИдентификаторДляЛогики =
				СформироватьИдентификаторЛогики(ОписаниеМодели.ИдентификаторДляЛогики);
			Изменено = Истина;
		КонецЕсли;

		Если Изменено Тогда
			ОбъектМодели.Записать();
			Если НоваяМодель Тогда
				Результат.Создано = Результат.Создано + 1;
			Иначе
				Результат.Обновлено = Результат.Обновлено + 1;
			КонецЕсли;
		Иначе
			Результат.БезИзменений = Результат.БезИзменений + 1;
		КонецЕсли;

		Если ОписаниеМодели.ПоддерживаетИзображения Тогда
			ЗаписатьВозможностьАнализаИзображений(ОбъектМодели.Ссылка);
			Если Не ЗначениеЗаполнено(МодельАнализаПоУмолчанию) Тогда
				МодельАнализаПоУмолчанию = ОбъектМодели.Ссылка;
			КонецЕсли;
		КонецЕсли;
		Если ОписаниеМодели.ПоддерживаетФайлы Тогда
			ЗаписатьВозможностьАнализаФайлов(ОбъектМодели.Ссылка);
		КонецЕсли;
	КонецЦикла;

	УстановитьМодельАнализаПоУмолчанию(Провайдер, МодельАнализаПоУмолчанию);

	Возврат Результат;

КонецФункции

Процедура ЗаписатьВозможностьАнализаИзображений(Модель)

	Запись = РегистрыСведений.AI_ВозможностиМоделей.СоздатьМенеджерЗаписи();
	Запись.Модель = Модель;
	Запись.Возможность = Перечисления.AI_ВозможностьМодели.ВводИзображений;
	Запись.ТипAPI = Перечисления.AI_ТипAPI.Responses;
	Запись.СпособПередачи = Перечисления.AI_СпособПередачиВложения.InlineBase64;
	Запись.MIMEТипы = "image/png,image/jpeg,image/webp";
	Запись.МаксимальныйРазмерБайт = 5 * 1024 * 1024;
	Запись.МаксимальноеКоличество = 5;
	Запись.Записать();

КонецПроцедуры

Процедура ЗаписатьВозможностьАнализаФайлов(Модель)

	Запись = РегистрыСведений.AI_ВозможностиМоделей.СоздатьМенеджерЗаписи();
	Запись.Модель = Модель;
	Запись.Возможность = Перечисления.AI_ВозможностьМодели.ВводФайлов;
	Запись.ТипAPI = Перечисления.AI_ТипAPI.Responses;
	Запись.СпособПередачи = Перечисления.AI_СпособПередачиВложения.FilesAPI;
	Запись.MIMEТипы =
		"application/pdf,application/msword,application/vnd.ms-excel,"
		+ "application/vnd.ms-powerpoint,application/rtf,"
		+ "application/vnd.openxmlformats-officedocument.wordprocessingml.document,"
		+ "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,"
		+ "application/vnd.openxmlformats-officedocument.presentationml.presentation,"
		+ "application/vnd.oasis.opendocument.text";
	Запись.МаксимальныйРазмерБайт = 20 * 1024 * 1024;
	Запись.МаксимальноеКоличество = 5;
	Запись.Записать();

КонецПроцедуры

Функция ЭтоМодельQwenДляАнализа(Модель)

	Возврат СтрНайти(НРег(Строка(Модель)), "qwen3.6-35b-a3b") > 0;

КонецФункции

Процедура УстановитьМодельАнализаПоУмолчанию(Провайдер, Модель)

	Если Не ЗначениеЗаполнено(Модель) Тогда
		Возврат;
	КонецЕсли;
	ОбъектПровайдера = Провайдер.ПолучитьОбъект();
	Если ЗначениеЗаполнено(ОбъектПровайдера.МодельАнализаВложений) Тогда
		Возврат;
	КонецЕсли;
	ОбъектПровайдера.МодельАнализаВложений = Модель;
	ОбъектПровайдера.Записать();

КонецПроцедуры

Функция ЭтоМультимодальнаяМодельYandex(Провайдер, КодМодели)

	Возврат Провайдер = Справочники.AI_Провайдеры.Yandex
		И СтрНайти(НРег(Строка(КодМодели)), "qwen3.6-35b-a3b") > 0;

КонецФункции

Функция ПолучитьСуществующиеМодели(Провайдер)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	AI_Модели.Ссылка КАК Ссылка,
		|	AI_Модели.Наименование КАК Наименование
		|ИЗ
		|	Справочник.AI_Модели КАК AI_Модели
		|ГДЕ
		|	AI_Модели.Владелец = &Провайдер";
	Запрос.УстановитьПараметр("Провайдер", Провайдер);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(НРег(Выборка.Наименование), Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СформироватьИдентификаторЛогики(ПредопределенныйИдентификатор)

	Если ЗначениеЗаполнено(ПредопределенныйИдентификатор) Тогда
		Возврат Лев(ПредопределенныйИдентификатор, 50);
	КонецЕсли;

	Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Возврат "MODEL_" + Идентификатор;

КонецФункции

#КонецОбласти
