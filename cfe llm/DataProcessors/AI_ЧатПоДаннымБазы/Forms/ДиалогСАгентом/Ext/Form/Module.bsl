&НаКлиенте
Функция СкриптыHTMLДиалога()

	Возврат
		"<script>
		|function copyMessage(id,button){
		| var node=document.getElementById(id);if(!node){return;}
		| var text=node.innerText||node.textContent||'';
		| var old=button.innerHTML,oldTitle=button.title;
		| function done(){button.innerHTML='&#10003;';button.title='Скопировано';setTimeout(function(){button.innerHTML=old;button.title=oldTitle;},900);}
		| function failed(){button.innerHTML='!';button.title='Не удалось скопировать';setTimeout(function(){button.innerHTML=old;button.title=oldTitle;},1200);}
		| function legacyCopy(){
		|  try{if(window.clipboardData&&window.clipboardData.setData&&window.clipboardData.setData('Text',text)){done();return;}}catch(ignore){}
		|  var area=document.createElement('textarea');area.value=text;area.setAttribute('readonly','');area.style.position='fixed';area.style.left='-10000px';area.style.top='0';document.body.appendChild(area);area.focus();area.select();
		|  try{if(area.setSelectionRange){area.setSelectionRange(0,area.value.length);}if(document.execCommand&&document.execCommand('copy')){document.body.removeChild(area);done();return;}}catch(ignore){}
		|  document.body.removeChild(area);failed();
		| }
		| if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(done,legacyCopy);return;}
		| legacyCopy();
		|}
		|function restoreChatScroll(){
		| var mode=document.body.getAttribute('data-scroll-mode');
		| if(mode==='preserve'){
		|  var top=parseInt(document.body.getAttribute('data-scroll-top')||'0',10);
		|  window.scrollTo(0,isNaN(top)?0:top);return;
		| }
		| var end=document.getElementById('chat-end');
		| if(end&&end.scrollIntoView){end.scrollIntoView(false);return;}
		| window.scrollTo(0,document.body.scrollHeight);
		|}
		|window.setTimeout(restoreChatScroll,0);
		|</script>";

КонецФункции

&НаКлиенте
Функция СформироватьHTMLСообщения(СообщениеДиалога, НомерСообщения)

	Роль = Строка(СообщениеДиалога.Роль);
	Если Роль = "Вы" Тогда
		КлассРоли = "user";
	ИначеЕсли Роль = "Система" Тогда
		КлассРоли = "system";
	Иначе
		КлассРоли = "assistant";
	КонецЕсли;

	ТекстСообщения = СтрЗаменить(
		Строка(СообщениеДиалога.Сообщение),
		Символы.ВК,
		"");
	ТекстВложений = "";
	МаркерВложений = Символы.ПС + "Вложения: ";
	ПозицияВложений = СтрНайти(ТекстСообщения, МаркерВложений);
	Если ПозицияВложений > 0 Тогда
		ТекстВложений = Сред(
			ТекстСообщения,
			ПозицияВложений + СтрДлина(МаркерВложений));
		ТекстСообщения = Лев(ТекстСообщения, ПозицияВложений - 1);
	КонецЕсли;

	ИдентификаторСодержимого = СтрШаблон("message-content-%1", НомерСообщения);
	ВремяСообщения = ?(
		ЗначениеЗаполнено(СообщениеДиалога.Время),
		Формат(СообщениеДиалога.Время, "ДФ=dd.MM.yyyy HH:mm"),
		"");
	Возврат СтрШаблон(
		"<article class='message %1'><div class='message-meta'>"
		+ "<span class='role'>%2</span><time>%3</time></div>"
		+ "<div class='bubble'><button class='copy-button' type='button' "
		+ "title='Копировать' aria-label='Копировать' onclick=""copyMessage('%4',this)"">"
		+ "&#10697;</button><div class='content' id='%4'>%5</div>%6</div></article>",
		КлассРоли,
		ЭкранироватьHTML(Роль),
		ЭкранироватьHTML(ВремяСообщения),
		ИдентификаторСодержимого,
		MarkdownВHTML(ТекстСообщения),
		СформироватьHTMLВложений(ТекстВложений));

КонецФункции

&НаКлиенте
Функция СформироватьHTMLВложений(ТекстВложений)

	Если Не ЗначениеЗаполнено(СокрЛП(ТекстВложений)) Тогда
		Возврат "";
	КонецЕсли;
	ВложенияHTML = Новый Массив;
	Для Каждого ИмяВложения Из СтрРазделить(ТекстВложений, ",", Ложь) Цикл
		ИмяВложения = СокрЛП(ИмяВложения);
		Если ЗначениеЗаполнено(ИмяВложения) Тогда
			ВложенияHTML.Добавить(
				"<span class='attachment'><span aria-hidden='true'>&#128206;</span>"
				+ ЭкранироватьHTML(ИмяВложения) + "</span>");
		КонецЕсли;
	КонецЦикла;
	Возврат ?(
		ВложенияHTML.Количество() = 0,
		"",
		"<div class='attachments'>" + СтрСоединить(ВложенияHTML, "") + "</div>");

КонецФункции

&НаКлиенте
Функция СформироватьHTMLИнструментов(ИнструментыРазвернуты)

	Если ШагиАгента.Количество() = 0 И Не ОперацияВыполняется Тогда
		Возврат "";
	КонецЕсли;
	ЕстьШаги = ШагиАгента.Количество() > 0;
	Если ЕстьШаги Тогда
		АтрибутРазвернуто = ?(ИнструментыРазвернуты, " open", "");
		HTML = СтрШаблон(
			"<details class='tools' id='tools-panel'%1><summary class='tools-header'>"
			+ "<span>Вызовы инструментов</span><span class='tool-count'>%2</span>"
			+ "</summary><div class='tools-content'>",
			АтрибутРазвернуто,
			ШагиАгента.Количество());
		Для Каждого Шаг Из ШагиАгента Цикл
			КлассСтатуса = "pending";
			СтатусНРег = НРег(Строка(Шаг.Статус));
			Если СтрНайти(СтатусНРег, "ошиб") > 0 Тогда
				КлассСтатуса = "error";
			ИначеЕсли СтрНайти(СтатусНРег, "выполн") > 0 Тогда
				КлассСтатуса = "success";
			КонецЕсли;
			Длительность = ?(
				Шаг.ДлительностьМс > 0,
				СтрШаблон("%1 мс", Шаг.ДлительностьМс),
				"");
			ТелоИнструмента = "";
			Если ЗначениеЗаполнено(Шаг.Аргументы) Тогда
				ТелоИнструмента = ТелоИнструмента
					+ "<div><div class='tool-label'>Аргументы</div><pre>"
					+ ЭкранироватьHTML(Шаг.Аргументы) + "</pre></div>";
			КонецЕсли;
			Если ЗначениеЗаполнено(Шаг.Результат) Тогда
				ТелоИнструмента = ТелоИнструмента
					+ "<div><div class='tool-label'>Результат</div><pre>"
					+ ЭкранироватьHTML(Шаг.Результат) + "</pre></div>";
			КонецЕсли;
			HTML = HTML + СтрШаблон(
				"<details class='tool'><summary><span class='tool-status %1'></span>"
				+ "<span>Шаг %2 · %3</span><span class='tool-duration'>%4</span></summary>"
				+ "<div class='tool-body'>%5</div></details>",
				КлассСтатуса,
				Шаг.ПорядковыйНомер,
				ЭкранироватьHTML(Шаг.Инструмент),
				ЭкранироватьHTML(Длительность),
				ТелоИнструмента);
		КонецЦикла;
	Иначе
		HTML = "<section class='tools'>";
	КонецЕсли;
	Если ОперацияВыполняется Тогда
		HTML = HTML + "<div class='activity'><span class='spinner'></span><span>"
			+ ЭкранироватьHTML(СтатусОперации) + "</span></div>";
	КонецЕсли;
	Если ЕстьШаги Тогда
		Возврат HTML + "</div></details>";
	КонецЕсли;
	Возврат HTML + "</section>";

КонецФункции

&НаКлиенте
Функция MarkdownВHTML(ТекстMarkdown)

	ТекстMarkdown = СтрЗаменить(Строка(ТекстMarkdown), Символы.ВК, "");
	Строки = Новый Массив;
	ОстатокТекста = ТекстMarkdown;
	Пока Истина Цикл
		ПозицияПереводаСтроки = СтрНайти(ОстатокТекста, Символы.ПС);
		Если ПозицияПереводаСтроки = 0 Тогда
			Строки.Добавить(ОстатокТекста);
			Прервать;
		КонецЕсли;
		Строки.Добавить(Лев(ОстатокТекста, ПозицияПереводаСтроки - 1));
		ОстатокТекста = Сред(ОстатокТекста, ПозицияПереводаСтроки + 1);
	КонецЦикла;
	Результат = "";
	Абзац = "";
	ТипСписка = "";
	ВБлокеКода = Ложь;
	ЯзыкКода = "";
	СтрокиКода = Новый Массив;
	ИндексСтроки = 0;

	Пока ИндексСтроки < Строки.Количество() Цикл
		ТекущаяСтрока = Строки[ИндексСтроки];
		СокращеннаяСтрока = ОбрезатьКраяСтроки(ТекущаяСтрока);

		Если СтрНачинаетсяС(СокращеннаяСтрока, "```") Тогда
			Если ВБлокеКода Тогда
				Результат = Результат + СформироватьБлокКода(СтрокиКода, ЯзыкКода);
				ВБлокеКода = Ложь;
				ЯзыкКода = "";
				СтрокиКода.Очистить();
			Иначе
				ЗакрытьАбзацMarkdown(Абзац, Результат);
				ЗакрытьСписокMarkdown(ТипСписка, Результат);
				ВБлокеКода = Истина;
				ЯзыкКода = ОбрезатьКраяСтроки(Сред(СокращеннаяСтрока, 4));
			КонецЕсли;
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;

		Если ВБлокеКода Тогда
			СтрокиКода.Добавить(ТекущаяСтрока);
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СокращеннаяСтрока) Тогда
			ЗакрытьАбзацMarkdown(Абзац, Результат);
			ЗакрытьСписокMarkdown(ТипСписка, Результат);
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;

		Если ИндексСтроки + 1 < Строки.Количество()
			И СтрНайти(ТекущаяСтрока, "|") > 0
			И ЭтоРазделительТаблицыMarkdown(Строки[ИндексСтроки + 1]) Тогда
			ЗакрытьАбзацMarkdown(Абзац, Результат);
			ЗакрытьСписокMarkdown(ТипСписка, Результат);
			Результат = Результат + "<table><thead>"
				+ СформироватьСтрокуТаблицыMarkdown(
					ПолучитьЯчейкиТаблицыMarkdown(ТекущаяСтрока),
					"th")
				+ "</thead><tbody>";
			ИндексСтроки = ИндексСтроки + 2;
			Пока ИндексСтроки < Строки.Количество() Цикл
				СтрокаТаблицы = Строки[ИндексСтроки];
				Если Не ЗначениеЗаполнено(ОбрезатьКраяСтроки(СтрокаТаблицы))
					Или СтрНайти(СтрокаТаблицы, "|") = 0 Тогда
					Прервать;
				КонецЕсли;
				Результат = Результат + СформироватьСтрокуТаблицыMarkdown(
					ПолучитьЯчейкиТаблицыMarkdown(СтрокаТаблицы),
					"td");
				ИндексСтроки = ИндексСтроки + 1;
			КонецЦикла;
			Результат = Результат + "</tbody></table>";
			Продолжить;
		КонецЕсли;

		УровеньЗаголовка = ПолучитьУровеньЗаголовкаMarkdown(СокращеннаяСтрока);
		Если УровеньЗаголовка > 0 Тогда
			ЗакрытьАбзацMarkdown(Абзац, Результат);
			ЗакрытьСписокMarkdown(ТипСписка, Результат);
			ТекстЗаголовка = Сред(СокращеннаяСтрока, УровеньЗаголовка + 2);
			Результат = Результат + СтрШаблон(
				"<h%1>%2</h%1>",
				УровеньЗаголовка,
				ФорматироватьСтрокуMarkdown(ТекстЗаголовка));
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;

		Если ЭтоГоризонтальнаяЛинияMarkdown(СокращеннаяСтрока) Тогда
			ЗакрытьАбзацMarkdown(Абзац, Результат);
			ЗакрытьСписокMarkdown(ТипСписка, Результат);
			Результат = Результат + "<hr>";
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(СокращеннаяСтрока, "> ") Тогда
			ЗакрытьАбзацMarkdown(Абзац, Результат);
			ЗакрытьСписокMarkdown(ТипСписка, Результат);
			Результат = Результат + "<blockquote>"
				+ ФорматироватьСтрокуMarkdown(Сред(СокращеннаяСтрока, 3))
				+ "</blockquote>";
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;

		Если ЭтоНенумерованныйПунктMarkdown(СокращеннаяСтрока) Тогда
			ЗакрытьАбзацMarkdown(Абзац, Результат);
			ОткрытьСписокMarkdown("ul", ТипСписка, Результат);
			Результат = Результат + "<li>"
				+ ФорматироватьСтрокуMarkdown(Сред(СокращеннаяСтрока, 3))
				+ "</li>";
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;

		ТекстНумерованногоПункта = ПолучитьНумерованныйПунктMarkdown(
			СокращеннаяСтрока);
		Если ТекстНумерованногоПункта <> Неопределено Тогда
			ЗакрытьАбзацMarkdown(Абзац, Результат);
			ОткрытьСписокMarkdown("ol", ТипСписка, Результат);
			Результат = Результат + "<li>"
				+ ФорматироватьСтрокуMarkdown(ТекстНумерованногоПункта)
				+ "</li>";
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;

		ЗакрытьСписокMarkdown(ТипСписка, Результат);
		Если ЗначениеЗаполнено(Абзац) Тогда
			Абзац = Абзац + "<br>";
		КонецЕсли;
		Абзац = Абзац + ФорматироватьСтрокуMarkdown(СокращеннаяСтрока);
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;

	Если ВБлокеКода Тогда
		Результат = Результат + СформироватьБлокКода(СтрокиКода, ЯзыкКода);
	КонецЕсли;
	ЗакрытьАбзацMarkdown(Абзац, Результат);
	ЗакрытьСписокMarkdown(ТипСписка, Результат);
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ЗакрытьАбзацMarkdown(Абзац, Результат)

	Если ЗначениеЗаполнено(Абзац) Тогда
		Результат = Результат + "<p>" + Абзац + "</p>";
		Абзац = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокMarkdown(НовыйТипСписка, ТипСписка, Результат)

	Если ТипСписка = НовыйТипСписка Тогда
		Возврат;
	КонецЕсли;
	ЗакрытьСписокMarkdown(ТипСписка, Результат);
	ТипСписка = НовыйТипСписка;
	Результат = Результат + "<" + ТипСписка + ">";

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьСписокMarkdown(ТипСписка, Результат)

	Если ЗначениеЗаполнено(ТипСписка) Тогда
		Результат = Результат + "</" + ТипСписка + ">";
		ТипСписка = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СформироватьБлокКода(СтрокиКода, ЯзыкКода)

	КлассЯзыка = ?(
		ЗначениеЗаполнено(ЯзыкКода),
		" class='language-" + ЭкранироватьHTML(ЯзыкКода) + "'",
		"");
	Возврат "<pre><code" + КлассЯзыка + ">"
		+ ЭкранироватьHTML(СтрСоединить(СтрокиКода, Символы.ПС))
		+ "</code></pre>";

КонецФункции

&НаКлиенте
Функция ПолучитьУровеньЗаголовкаMarkdown(СтрокаMarkdown)

	Уровень = 0;
	Пока Уровень < 6
		И Уровень < СтрДлина(СтрокаMarkdown)
		И Сред(СтрокаMarkdown, Уровень + 1, 1) = "#" Цикл
		Уровень = Уровень + 1;
	КонецЦикла;
	Если Уровень > 0
		И СтрДлина(СтрокаMarkdown) > Уровень
		И Сред(СтрокаMarkdown, Уровень + 1, 1) = " " Тогда
		Возврат Уровень;
	КонецЕсли;
	Возврат 0;

КонецФункции

&НаКлиенте
Функция ЭтоГоризонтальнаяЛинияMarkdown(СтрокаMarkdown)

	ПроверяемаяСтрока = СтрЗаменить(СтрокаMarkdown, " ", "");
	Если СтрДлина(ПроверяемаяСтрока) < 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	ПервыйСимвол = Лев(ПроверяемаяСтрока, 1);
	Если ПервыйСимвол <> "-" И ПервыйСимвол <> "*" И ПервыйСимвол <> "_" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ЗначениеЗаполнено(СтрЗаменить(
		ПроверяемаяСтрока,
		ПервыйСимвол,
		""));

КонецФункции

&НаКлиенте
Функция ЭтоНенумерованныйПунктMarkdown(СтрокаMarkdown)

	Возврат СтрНачинаетсяС(СтрокаMarkdown, "- ")
		Или СтрНачинаетсяС(СтрокаMarkdown, "* ")
		Или СтрНачинаетсяС(СтрокаMarkdown, "+ ");

КонецФункции

&НаКлиенте
Функция ПолучитьНумерованныйПунктMarkdown(СтрокаMarkdown)

	ПозицияРазделителя = СтрНайти(СтрокаMarkdown, ". ");
	Если ПозицияРазделителя <= 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	НомерПункта = Лев(СтрокаMarkdown, ПозицияРазделителя - 1);
	Для ИндексСимвола = 1 По СтрДлина(НомерПункта) Цикл
		Если СтрНайти("0123456789", Сред(НомерПункта, ИндексСимвола, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Сред(СтрокаMarkdown, ПозицияРазделителя + 2);

КонецФункции

&НаКлиенте
Функция ЭтоРазделительТаблицыMarkdown(СтрокаMarkdown)

	ПроверяемаяСтрока = ОбрезатьКраяСтроки(СтрокаMarkdown);
	Если СтрНайти(ПроверяемаяСтрока, "-") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ПроверяемаяСтрока = СтрЗаменить(ПроверяемаяСтрока, "|", "");
	ПроверяемаяСтрока = СтрЗаменить(ПроверяемаяСтрока, "-", "");
	ПроверяемаяСтрока = СтрЗаменить(ПроверяемаяСтрока, ":", "");
	ПроверяемаяСтрока = СтрЗаменить(ПроверяемаяСтрока, " ", "");
	ПроверяемаяСтрока = СтрЗаменить(
		ПроверяемаяСтрока,
		Символы.Таб,
		"");
	Возврат Не ЗначениеЗаполнено(ПроверяемаяСтрока);

КонецФункции

&НаКлиенте
Функция ПолучитьЯчейкиТаблицыMarkdown(СтрокаMarkdown)

	СтрокаТаблицы = ОбрезатьКраяСтроки(СтрокаMarkdown);
	Если СтрНачинаетсяС(СтрокаТаблицы, "|") Тогда
		СтрокаТаблицы = Сред(СтрокаТаблицы, 2);
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(СтрокаТаблицы, "|") Тогда
		СтрокаТаблицы = Лев(СтрокаТаблицы, СтрДлина(СтрокаТаблицы) - 1);
	КонецЕсли;
	Возврат СтрРазделить(СтрокаТаблицы, "|", Истина);

КонецФункции

&НаКлиенте
Функция СформироватьСтрокуТаблицыMarkdown(Ячейки, ТегЯчейки)

	HTML = "<tr>";
	Для Каждого Ячейка Из Ячейки Цикл
		HTML = HTML + "<" + ТегЯчейки + ">"
			+ ФорматироватьСтрокуMarkdown(ОбрезатьКраяСтроки(Ячейка))
			+ "</" + ТегЯчейки + ">";
	КонецЦикла;
	Возврат HTML + "</tr>";

КонецФункции

&НаКлиенте
Функция ОбрезатьКраяСтроки(Текст)

	Результат = Строка(Текст);
	Пока СтрДлина(Результат) > 0 Цикл
		ПервыйСимвол = Лев(Результат, 1);
		Если ПервыйСимвол <> " " И ПервыйСимвол <> Символ(9) Тогда
			Прервать;
		КонецЕсли;
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Пока СтрДлина(Результат) > 0 Цикл
		ПоследнийСимвол = Прав(Результат, 1);
		Если ПоследнийСимвол <> " " И ПоследнийСимвол <> Символ(9) Тогда
			Прервать;
		КонецЕсли;
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ФорматироватьСтрокуMarkdown(ТекстMarkdown)

	ЧастиКода = СтрРазделить(Строка(ТекстMarkdown), "`", Истина);
	Результат = "";
	ИндексЧасти = 0;
	Для Каждого ЧастьКода Из ЧастиКода Цикл
		БезопасныйТекст = ЭкранироватьHTML(ЧастьКода);
		Если Цел(ИндексЧасти / 2) * 2 = ИндексЧасти Тогда
			БезопасныйТекст = ЗаменитьПарныеМаркерыMarkdown(
				БезопасныйТекст, "**", "<strong>", "</strong>");
			БезопасныйТекст = ЗаменитьПарныеМаркерыMarkdown(
				БезопасныйТекст, "__", "<strong>", "</strong>");
			БезопасныйТекст = ЗаменитьПарныеМаркерыMarkdown(
				БезопасныйТекст, "~~", "<s>", "</s>");
			БезопасныйТекст = ЗаменитьПарныеМаркерыMarkdown(
				БезопасныйТекст, "*", "<em>", "</em>");
			Результат = Результат + БезопасныйТекст;
		Иначе
			Результат = Результат + "<code>" + БезопасныйТекст + "</code>";
		КонецЕсли;
		ИндексЧасти = ИндексЧасти + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ЗаменитьПарныеМаркерыMarkdown(
		ТекстMarkdown,
		Маркер,
		ОткрывающийТег,
		ЗакрывающийТег)

	Результат = "";
	ОстатокТекста = ТекстMarkdown;
	Пока ЗначениеЗаполнено(ОстатокТекста) Цикл
		ПозицияНачала = СтрНайти(ОстатокТекста, Маркер);
		Если ПозицияНачала = 0 Тогда
			Результат = Результат + ОстатокТекста;
			Прервать;
		КонецЕсли;
		ПослеНачала = Сред(
			ОстатокТекста,
			ПозицияНачала + СтрДлина(Маркер));
		ПозицияКонца = СтрНайти(ПослеНачала, Маркер);
		Если ПозицияКонца = 0 Тогда
			Результат = Результат + ОстатокТекста;
			Прервать;
		КонецЕсли;
		Результат = Результат
			+ Лев(ОстатокТекста, ПозицияНачала - 1)
			+ ОткрывающийТег
			+ Лев(ПослеНачала, ПозицияКонца - 1)
			+ ЗакрывающийТег;
		ОстатокТекста = Сред(
			ПослеНачала,
			ПозицияКонца + СтрДлина(Маркер));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ЭкранироватьHTML(Текст)

	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗагрузитьИсториюДиалога()

	Если Не РежимДиалога Или Не ЗначениеЗаполнено(ИдентификаторДиалога) Тогда
		Возврат;
	КонецЕсли;
	События = AI_ДиалогиКлиентСервер.ПолучитьСообщения(
		ИдентификаторДиалога,
		ГлубинаДиалога);
	Для Каждого Событие Из События Цикл
		Роль = ?(Событие.Роль = "user", "Вы", ПредставлениеАгентаНаСервере());
		СтрокаСообщения = Сообщения.Добавить();
		СтрокаСообщения.Время = Событие.Период;
		СтрокаСообщения.Роль = Роль;
		СтрокаСообщения.Сообщение = Событие.Сообщение;
	КонецЦикла;

