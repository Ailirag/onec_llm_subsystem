// Таблица значений для применения — из распознанных строк разбора, как ее
// собирает помощник по отмеченным строкам.
Функция ЗначенияИзРазбора(Разобранное)

	Значения = Новый ТаблицаЗначений;
	Значения.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	Значения.Колонки.Добавить("Значение");
	Значения.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Значения.Колонки.Добавить("ТабличнаяЧасть", Новый ОписаниеТипов("Строка"));
	Значения.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Для Каждого СтрокаРазбора Из Разобранное Цикл
		Если СтрокаРазбора.Распознано Тогда
			ЗаполнитьЗначенияСвойств(Значения.Добавить(), СтрокаРазбора);
		КонецЕсли;
	КонецЦикла;
	Возврат Значения;

КонецФункции

// «значение [тип] (комментарий)» по каждой строке — чтобы упавшая проверка
// разбора сразу показывала, что именно получилось.
Функция ОписаниеРазбора(Разобранное)

	Части = Новый Массив;
	Для Каждого СтрокаРазбора Из Разобранное Цикл
		Части.Добавить(СтрШаблон("%1 [%2]%3 (%4)", СтрокаРазбора.Значение, ТипЗнч(СтрокаРазбора.Значение),
			?(СтрокаРазбора.Распознано, "", " не распознано"), СтрокаРазбора.Комментарий));
	КонецЦикла;
	Возврат Формат(Разобранное.Количество(), "ЧГ=0") + ": " + СтрСоединить(Части, "; ");

