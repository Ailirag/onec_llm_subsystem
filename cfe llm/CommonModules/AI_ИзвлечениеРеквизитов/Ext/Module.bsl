// Универсальное извлечение реквизитов по карте соответствий.
//
// Карта (Справочник.AI_КартыИзвлечения) — единственное место, где описано,
// какие поля модель должна вернуть и куда они ложатся в прикладном объекте.
// Из нее выводится и схема ответа для модели, и таблица рекомендаций.
//
// Модуль не знает ни одного прикладного объекта: и источник вложений,
// и целевые реквизиты задаются полными именами метаданных и читаются
// рефлексией. Запись в прикладной объект здесь не выполняется — ядро
// остается только на чтение, писать должен адаптер после подтверждения.

#Область ПрограммныйИнтерфейс

// Возвращает JSON Schema для поля СхемаОтветаJSON сценария.
// Схема собирается по полям карты, чтобы ответ модели заведомо совпадал
// с тем, что потом раскладывается по реквизитам.
Функция СформироватьСхемуОтвета(Карта) Экспорт

	ПроверитьКарту(Карта);

	Свойства = Новый Соответствие;
	Обязательные = Новый Массив;
	// Поля табличной части собираются в один массив объектов: строк в документе
	// сколько угодно, и плоская схема их выразить не может.
	ГруппыТЧ = Новый Соответствие;
	ИмяОбъекта = ИмяОбъектаКарты(Карта);

	Для Каждого Поле Из Карта.Поля Цикл
		Ключ = СокрЛП(Поле.Ключ);
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеПоля = Новый Соответствие;
		ОписаниеПоля.Вставить("type", ТипСхемыПоля(Поле.ТипЗначения));
		// Значения свойства-списка модели по памяти не воспроизвести: корзину
		// вида «Закупки от 100 млн руб. до 500 млн руб. (или от 1 млн до 5 млн
		// долл/евро)» так пишут только в справочнике. Поэтому перечень уходит
		// в схему, и модель выбирает значение, а не сочиняет его.
		Перечень = ДопустимыеЗначенияПоля(Поле, ИмяОбъекта);
		Если Перечень.Количество() > 0 Тогда
			ОписаниеПоля.Вставить("enum", Перечень);
		КонецЕсли;
		Описание = ТекстОписанияПоля(Поле, Перечень.Количество() > 0, ИмяОбъекта);
		Если ЗначениеЗаполнено(Описание) Тогда
			ОписаниеПоля.Вставить("description", Описание);
		КонецЕсли;

		ИмяТЧ = СокрЛП(Поле.ТабличнаяЧасть);
		Если ЗначениеЗаполнено(ИмяТЧ) Тогда
			ГруппаПолей = ГруппыТЧ.Получить(НРег(ИмяТЧ));
			Если ГруппаПолей = Неопределено Тогда
				ГруппаПолей = Новый Структура("Имя,Свойства,Обязательные",
					ИмяТЧ, Новый Соответствие, Новый Массив);
				Если Карта.ОбновлятьСтрокиПоНомеру Тогда
					// Номер строки из данных объекта: по нему значения лягут в
					// существующую строку, а не в новую.
					ОписаниеНомера = Новый Соответствие;
					ОписаниеНомера.Вставить("type", "integer");
					ОписаниеНомера.Вставить("description", "Номер строки табличной части «" + ИмяТЧ
						+ "» из данных объекта (колонка №).");
					ГруппаПолей.Свойства.Вставить(КлючНомераСтроки(), ОписаниеНомера);
					ГруппаПолей.Обязательные.Добавить(КлючНомераСтроки());
				КонецЕсли;
				ГруппыТЧ.Вставить(НРег(ИмяТЧ), ГруппаПолей);
			КонецЕсли;
			ГруппаПолей.Свойства.Вставить(Ключ, ОписаниеПоля);
			ГруппаПолей.Обязательные.Добавить(Ключ);
			Продолжить;
		КонецЕсли;

		Свойства.Вставить(Ключ, ОписаниеПоля);
		// Контракт операций требует строгую схему: все свойства должны быть
		// перечислены в required. Необязательность выражается не схемой, а тем,
		// что модель вернет пустое значение — флаг Обязательное проверяется
		// уже при разборе рекомендаций.
		Обязательные.Добавить(Ключ);
	КонецЦикла;

	// Массив строк лежит под ключом, равным имени табличной части: отдельного
	// имени в карте нет намеренно, иначе настройщику пришлось бы держать в
	// голове два разных названия одного и того же.
	Для Каждого ЭлементГруппы Из ГруппыТЧ Цикл
		ГруппаПолей = ЭлементГруппы.Значение;
		ОписаниеСтроки = Новый Соответствие;
		ОписаниеСтроки.Вставить("type", "object");
		ОписаниеСтроки.Вставить("properties", ГруппаПолей.Свойства);
		ОписаниеСтроки.Вставить("required", ГруппаПолей.Обязательные);
		ОписаниеСтроки.Вставить("additionalProperties", Ложь);

		// В описании — название, которое модель слышит от пользователя и видит в
		// данных объекта; ключ массива остается именем.
		ОписаниеМассива = Новый Соответствие;
		ОписаниеМассива.Вставить("type", "array");
		ОписаниеМассива.Вставить("items", ОписаниеСтроки);
		ПредставлениеТЧ = ПредставлениеТабличнойЧасти(Карта, ГруппаПолей.Имя);
		Если Карта.ОбновлятьСтрокиПоНомеру Тогда
			ОписаниеМассива.Вставить("description", "Строки табличной части «" + ПредставлениеТЧ
				+ "», которые нужно заполнить: номер строки из данных объекта и новые значения."
				+ " Пустой массив, если менять нечего.");
		Иначе
			ОписаниеМассива.Вставить("description", "Строки табличной части «"
				+ ПредставлениеТЧ + "». Пустой массив, если в документе их нет.");
		КонецЕсли;

		Свойства.Вставить(ГруппаПолей.Имя, ОписаниеМассива);
		Обязательные.Добавить(ГруппаПолей.Имя);
	КонецЦикла;

	Если Свойства.Количество() = 0 Тогда
		ВызватьИсключение "В карте извлечения не заполнено ни одного поля.";
	КонецЕсли;

	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);
	Схема.Вставить("additionalProperties", Ложь);

	Возврат ЗаписатьJSONВСтроку(Схема);

КонецФункции

// Записывает схему, собранную по карте, в сценарии, которые используют эту карту.
//
// Контракт операции берет СхемаОтветаJSON из сценария и перетирает переданное
// извне — это правильно, сценарий должен оставаться единственным источником
// правды на момент выполнения. Поэтому схему переносим заранее и явно,
// отдельным действием администратора, а не молча при каждом запуске.
//
// Возвращает структуру: Обновлено, Пропущено, Сообщения (массив строк).
Функция СинхронизироватьСхемуСценариев(Карта) Экспорт

	Результат = Новый Структура("Обновлено,Пропущено,Сообщения", 0, 0, Новый Массив);
	// Пустая или выключенная карта — отказ сразу, до перебора сценариев.
	СформироватьСхемуОтвета(Карта);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|  Места.Сценарий КАК Сценарий
		|ИЗ Справочник.AI_МестаЗапускаСценариев КАК Места
		|ГДЕ Места.КартаИзвлечения = &Карта
		|  И НЕ Места.ПометкаУдаления
		|  И Места.Сценарий <> ЗНАЧЕНИЕ(Справочник.AI_Сценарии.ПустаяСсылка)");
	Запрос.УстановитьПараметр("Карта", Карта);
	Выборка = Запрос.Выполнить().Выбрать();
	НайденоСценариев = 0;

	Пока Выборка.Следующий() Цикл
		НайденоСценариев = НайденоСценариев + 1;
		Сценарий = Выборка.Сценарий;
		Попытка
			Если Не ЗаписатьСхемуВСценарий(Карта, Сценарий) Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Результат.Обновлено = Результат.Обновлено + 1;
			Результат.Сообщения.Добавить("Схема записана в сценарий: " + Строка(Сценарий));
		Исключение
			Результат.Сообщения.Добавить(
				"Не удалось записать схему в сценарий " + Строка(Сценарий)
				+ ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	// Сообщение про отсутствие мест запуска уместно только тогда, когда их
	// действительно нет: иначе оно маскирует настоящую ошибку записи.
	Если НайденоСценариев = 0 Тогда
		Результат.Сообщения.Добавить(
			"Ни одно место запуска не ссылается на эту карту — обновлять нечего.");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Переносит схему, собранную по карте, в один сценарий. Ложь — схема там уже
// такая же, писать нечего.
Функция ЗаписатьСхемуВСценарий(Карта, Сценарий) Экспорт

	Схема = СформироватьСхемуОтвета(Карта);
	Если Сценарий.СхемаОтветаJSON = Схема Тогда
		Возврат Ложь;
	КонецЕсли;
	ОбъектСценария = Сценарий.ПолучитьОбъект();
	ОбъектСценария.СхемаОтветаJSON = Схема;
	ОбъектСценария.Записать();
	Возврат Истина;

КонецФункции

// Возвращает варианты выбора для шага уточнения.
// Источник, связь с контекстным объектом и отбор заданы строками полных имен,
// поэтому ядро не зависит от конкретной конфигурации.
//
// Возвращает таблицу: Ссылка, Представление, Дополнительно.
Функция ПолучитьВариантыУточнения(Уточнение, Контекст) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка");
	Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Дополнительно", Новый ОписаниеТипов("Строка"));

	Источник = СокрЛП(Строка(Уточнение.ИсточникДанных));
	Если Не ЗначениеЗаполнено(Источник) Тогда
		Возврат Результат;
	КонецЕсли;
	Если Метаданные.НайтиПоПолномуИмени(Источник) = Неопределено Тогда
		ВызватьИсключение "Источник данных уточнения не найден в конфигурации: " + Источник;
	КонецЕсли;

	ПодчиненныеКонтексту = (Уточнение.ВидУточнения = Перечисления.AI_ВидУточнения.ВыборИзПодчиненных);
	РеквизитСвязи = СокрЛП(Строка(Уточнение.РеквизитСвязи));
	Владелец = Неопределено;
	Если ПодчиненныеКонтексту Тогда
		Если Не ЗначениеЗаполнено(РеквизитСвязи) Тогда
			ВызватьИсключение "Для выбора из подчиненных не задан реквизит связи.";
		КонецЕсли;
		Владелец = ПолучитьОбъектКонтекста(Контекст);
		Если Владелец = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	РеквизитПредставления = СокрЛП(Строка(Уточнение.РеквизитПредставления));
	ОтборРеквизит = СокрЛП(Строка(Уточнение.ОтборРеквизит));

	Поля = "Источник.Ссылка КАК Ссылка";
	Если ЗначениеЗаполнено(РеквизитПредставления) Тогда
		Поля = Поля + ", Источник." + РеквизитПредставления + " КАК Представление";
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборРеквизит) Тогда
		Поля = Поля + ", Источник." + ОтборРеквизит + " КАК ЗначениеОтбора";
	КонецЕсли;

	Условия = Новый Массив;
	Условия.Добавить("НЕ Источник.ПометкаУдаления");
	Если ПодчиненныеКонтексту Тогда
		Условия.Добавить("Источник." + РеквизитСвязи + " = &Владелец");
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ " + Поля + " ИЗ " + Источник + " КАК Источник"
		+ " ГДЕ " + СтрСоединить(Условия, " И "));
	Если ПодчиненныеКонтексту Тогда
		Запрос.УстановитьПараметр("Владелец", Владелец);
	КонецЕсли;

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ВызватьИсключение "Не удалось прочитать варианты уточнения из " + Источник
			+ ": " + ОписаниеОшибки();
	КонецПопытки;

	ОжидаемыеЗначения = РазобратьСписокЗначений(Уточнение.ОтборЗначение);

	Пока Выборка.Следующий() Цикл
		ЗначениеОтбора = "";
		Если ЗначениеЗаполнено(ОтборРеквизит) Тогда
			ЗначениеОтбора = НРег(СокрЛП(Строка(Выборка.ЗначениеОтбора)));
			Если ОжидаемыеЗначения.Количество() > 0
				И ОжидаемыеЗначения.Найти(ЗначениеОтбора) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		СтрокаТаблицы = Результат.Добавить();
		СтрокаТаблицы.Ссылка = Выборка.Ссылка;
		СтрокаТаблицы.Представление = Лев(?(ЗначениеЗаполнено(РеквизитПредставления),
			Строка(Выборка.Представление),
			Строка(Выборка.Ссылка)), 250);
		СтрокаТаблицы.Дополнительно = Лев(ЗначениеОтбора, 100);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает двоичное содержимое прикладного файла для передачи модели.
// Сначала пробуем реквизит-хранилище, заданный администратором: так устроено
// большинство конфигураций. Если его нет или он пуст — отдаем управление
// переопределяемому модулю, где интегратор описывает свой способ хранения
// (например, тома 1С:Документооборота).
//
// Возвращает структуру: Содержимое, ИмяФайла, Получено, Причина.
Функция ПолучитьСодержимоеВложения(Вложение, Уточнение) Экспорт

	Результат = Новый Структура("Содержимое,ИмяФайла,Получено,Причина",
		Неопределено, "", Ложь, "");

	Если Не ЗначениеЗаполнено(Вложение) Тогда
		Результат.Причина = "Не выбран файл.";
		Возврат Результат;
	КонецЕсли;

	Результат.ИмяФайла = СформироватьИмяФайла(Вложение, Уточнение);

	РеквизитСодержимого = СокрЛП(Строка(Уточнение.РеквизитСодержимого));
	Если ЗначениеЗаполнено(РеквизитСодержимого) Тогда
		Содержимое = ПрочитатьСодержимоеИзРеквизита(Вложение, РеквизитСодержимого);
		Если Содержимое <> Неопределено Тогда
			Результат.Содержимое = Содержимое;
			Результат.Получено = Истина;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Содержимое = Неопределено;
	ИмяИзОбработчика = Результат.ИмяФайла;
	Обработано = Ложь;
	Попытка
		AI_ВложенияПереопределяемый.ПриПолученииСодержимогоВложения(
			Вложение,
			Уточнение,
			Содержимое,
			ИмяИзОбработчика,
			Обработано);
	Исключение
		Результат.Причина = "Переопределяемый обработчик завершился с ошибкой: "
			+ ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если Обработано И ТипЗнч(Содержимое) = Тип("ДвоичныеДанные") Тогда
		Результат.Содержимое = Содержимое;
		Результат.ИмяФайла = ?(ЗначениеЗаполнено(ИмяИзОбработчика),
			ИмяИзОбработчика, Результат.ИмяФайла);
		Результат.Получено = Истина;
		Возврат Результат;
	КонецЕсли;

	// БСП хранит присоединенные файлы в томах или в регистре двоичных данных:
	// путь к содержимому реквизитом не выразить, а ее программный интерфейс
	// отдает его сам. Интегратор при этом главнее — поэтому после обработчика.
	Содержимое = ДвоичныеДанныеФайлаБСП(Вложение);
	Если Содержимое <> Неопределено Тогда
		Результат.Содержимое = Содержимое;
		Результат.Получено = Истина;
		Возврат Результат;
	КонецЕсли;

	Результат.Причина = "Не удалось получить содержимое файла."
		+ " Укажите реквизит хранилища в уточнении либо реализуйте"
		+ " AI_ВложенияПереопределяемый.ПриПолученииСодержимогоВложения.";
	Возврат Результат;

КонецФункции

// Заготовка уточнения «выбрать файл объекта» по тому, как конфигурация хранит
// присоединенные файлы. Пути к хранилищу — знание внутренностей конкретной
// конфигурации, набирать их руками администратору незачем: известные схемы
// хранения узнаются по метаданным.
//
// Возвращает структуру полей строки уточнения либо Неопределено, если объект
// не найден или схема хранения файлов не распознана.
Функция ШаблонУточненияФайлов(ПолноеИмяМетаданных) Экспорт

	ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(СокрЛП(Строка(ПолноеИмяМетаданных)));
	Если ОписаниеОбъекта = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ТипСсылки = ТипЗнч(МенеджерПоПолномуИмени(ОписаниеОбъекта.ПолноеИмя()).ПустаяСсылка());
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Шаблон = Новый Структура(
		"Идентификатор,Представление,Подсказка,ВидУточнения,ИсточникДанных,РеквизитСвязи,"
			+ "РеквизитПредставления,РеквизитСодержимого,РеквизитИмениФайла,ОтборРеквизит,"
			+ "ОтборЗначение,ПередаватьСодержимое,Обязательное",
		"file",
		"Файл",
		"Выберите файл: текст, PDF или скан.",
		Перечисления.AI_ВидУточнения.ВыборИзПодчиненных,
		"",
		"ВладелецФайла",
		"Наименование",
		"",
		"Наименование",
		"",
		"txt, pdf, png, jpg, jpeg, docx",
		Истина,
		Истина);

	// БСП 3: у каждого владельца свой справочник «<Имя>ПрисоединенныеФайлы»,
	// содержимое отдает программный интерфейс БСП.
	Справочник = Метаданные.Справочники.Найти(ОписаниеОбъекта.Имя + "ПрисоединенныеФайлы");
	Если Справочник <> Неопределено И ВладелецФайлаПодходит(Справочник, ТипСсылки) Тогда
		Шаблон.ИсточникДанных = Справочник.ПолноеИмя();
		Если Справочник.Реквизиты.Найти("Расширение") <> Неопределено Тогда
			Шаблон.ОтборРеквизит = "Расширение";
		КонецЕсли;
		Возврат Шаблон;
	КонецЕсли;

	// Документооборот и БСП 2: общий справочник «Файлы» с версиями.
	Справочник = Метаданные.Справочники.Найти("Файлы");
	Если Справочник <> Неопределено И ВладелецФайлаПодходит(Справочник, ТипСсылки) Тогда
		Шаблон.ИсточникДанных = Справочник.ПолноеИмя();
		Если Справочник.Реквизиты.Найти("ТекущаяВерсияРасширение") <> Неопределено Тогда
			Шаблон.ОтборРеквизит = "ТекущаяВерсияРасширение";
		ИначеЕсли Справочник.Реквизиты.Найти("Расширение") <> Неопределено Тогда
			Шаблон.ОтборРеквизит = "Расширение";
		КонецЕсли;
		Версии = Метаданные.Справочники.Найти("ВерсииФайлов");
		Если Справочник.Реквизиты.Найти("ТекущаяВерсия") <> Неопределено
			И Версии <> Неопределено
			И Версии.Реквизиты.Найти("ФайлХранилище") <> Неопределено Тогда
			Шаблон.РеквизитСодержимого = "ТекущаяВерсия.ФайлХранилище";
		КонецЕсли;
		Возврат Шаблон;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Истина, если схема ответа в сценарии отстает от карты: поле добавили в карту,
// а схему в сценарий не перенесли, и модель о нем просто не спросят.
Функция СхемаСценарияОтстает(Карта, Сценарий) Экспорт

	Если Не ЗначениеЗаполнено(Карта) Или Не ЗначениеЗаполнено(Сценарий) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Схема = СформироватьСхемуОтвета(Карта);
	Исключение
		// Карта выключена или пуста — об этом скажет своя проверка.
		Возврат Ложь;
	КонецПопытки;
	Возврат Сценарий.СхемаОтветаJSON <> Схема;

КонецФункции

// Ссылка на прикладной объект контекста по полному имени метаданных и UUID.
// Нужна и чтению, и записи, поэтому вынесена в программный интерфейс.
Функция ПолучитьОбъектПоКонтексту(Контекст) Экспорт

	Возврат ПолучитьОбъектКонтекста(Контекст);

КонецФункции

// Истина, если контекстный объект проходит дополнительные отборы места запуска.
// Отборы позволяют разделить действия внутри одного типа объекта:
// например, показывать проверку договора только документам вида «Договор».
Функция ПроверитьОтборыКонтекста(МестоЗапуска, Контекст) Экспорт

	Если МестоЗапуска.ОтборыКонтекста.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Объект = ПолучитьОбъектКонтекста(Контекст);
	Если Объект = Неопределено Тогда
		// Отбор задан, а объекта нет — действие к такому контексту не относится.
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Отбор Из МестоЗапуска.ОтборыКонтекста Цикл
		Путь = СокрЛП(Строка(Отбор.ПутьРеквизита));
		Если Не ЗначениеЗаполнено(Путь) Тогда
			Продолжить;
		КонецЕсли;
		Значение = ПрочитатьПоПути(Объект, Путь);
		Если Не ПроверитьУсловиеОтбора(Значение, Отбор) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Раскладывает ответ модели по полям карты.
// Возвращает таблицу рекомендаций для предпросмотра: адаптер показывает ее
// пользователю и только после подтверждения пишет значения в объект.
//
// Контекст — контекст объекта, как его передает помощник. Он нужен
// дополнительным реквизитам-спискам: одноименные свойства разных наборов
// различает только набор самого объекта. Без контекста разбор тоже работает,
// а окончательно свойство выберет применение.
//
// Колонки: Ключ, Представление, ПутьРеквизита, ТипЗначения, ЗначениеМодели,
//          Значение, Распознано, Комментарий.
Функция РазобратьРекомендации(Карта, ТекстОтвета, Контекст = Неопределено) Экспорт

	ПроверитьКарту(Карта);
	СсылкаОбъекта = ПолучитьОбъектКонтекста(Контекст);
	ИмяОбъекта = ИмяОбъектаКарты(Карта, СсылкаОбъекта);

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПутьРеквизита", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТабличнаяЧасть", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ДополнительныйРеквизит", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТипЗначения");
	Результат.Колонки.Добавить("ЗначениеМодели", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Значение");
	Результат.Колонки.Добавить("Распознано", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));

	Данные = ПрочитатьОтвет(ТекстОтвета);

	Для Каждого Поле Из Карта.Поля Цикл
		Ключ = СокрЛП(Поле.Ключ);
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(СокрЛП(Поле.ТабличнаяЧасть)) Тогда
			// Строки табличных частей разбираются ниже: у них свой обход.
			Продолжить;
		КонецЕсли;

		СтрокаТаблицы = Результат.Добавить();
		СтрокаТаблицы.Ключ = Ключ;
		СтрокаТаблицы.Представление = ?(ЗначениеЗаполнено(Поле.Представление), Поле.Представление, Ключ);
		СтрокаТаблицы.ПутьРеквизита = СокрЛП(Поле.ПутьРеквизита);
		СтрокаТаблицы.ДополнительныйРеквизит = СокрЛП(Поле.ДополнительныйРеквизит);
		СтрокаТаблицы.ТипЗначения = Поле.ТипЗначения;

		Сырое = Данные.Получить(Ключ);
		Если Сырое = Неопределено Или Сырое = Null Тогда
			// Схема строгая, поэтому пустое значение — штатный способ сказать
			// «в документе этого нет». Для обязательного поля это проблема.
			СтрокаТаблицы.Комментарий = ?(Поле.Обязательное,
				"Обязательное поле не заполнено моделью.",
				"Модель не вернула значение.");
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы.ЗначениеМодели = Лев(Строка(Сырое), 500);

		Преобразование = ПреобразоватьЗначение(Сырое, Поле, СсылкаОбъекта, ИмяОбъекта);
		СтрокаТаблицы.Значение = Преобразование.Значение;
		СтрокаТаблицы.Распознано = Преобразование.Успех;
		СтрокаТаблицы.Комментарий = Преобразование.Комментарий;
		Если Не Преобразование.Успех И Поле.Обязательное Тогда
			СтрокаТаблицы.Комментарий = "Обязательное поле. " + Преобразование.Комментарий;
		КонецЕсли;
	КонецЦикла;

	// Строки табличных частей идут после шапки: человек сверяет сначала
	// реквизиты документа, а уже потом его состав.
	РазобратьСтрокиТабличныхЧастей(Карта, Данные, Результат, ИмяОбъекта);

	Возврат Результат;

КонецФункции

// Дополняет разбор текущими значениями объекта. Человек должен видеть не только,
// что предлагает модель, но и что это значение заменит.
//
// Значения читаются из записанного объекта: незаписанные правки формы серверу
// не видны. Колонки: ТекущееЗначение и Изменится — распознанное значение
// отличается от текущего.
Процедура ДополнитьТекущимиЗначениями(Таблица, Контекст) Экспорт

	Таблица.Колонки.Добавить("ТекущееЗначение");
	Таблица.Колонки.Добавить("Изменится", Новый ОписаниеТипов("Булево"));

	Объект = Неопределено;
	Ссылка = ПолучитьОбъектКонтекста(Контекст);
	Если Ссылка <> Неопределено И Не Ссылка.Пустая() Тогда
		Попытка
			Объект = Ссылка.ПолучитьОбъект();
		Исключение
			// Нет прав на чтение или объект удален — текущих значений просто нет.
			Объект = Неопределено;
		КонецПопытки;
	КонецЕсли;

	ИмяВида = "";
	Если Объект <> Неопределено Тогда
		ИмяВида = ИмяВидаХарактеристикСвойств(Объект.Метаданные());
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Объект <> Неопределено Тогда
			СтрокаТаблицы.ТекущееЗначение = ТекущееЗначениеПоля(Объект, СтрокаТаблицы, ИмяВида);
		КонецЕсли;
		СтрокаТаблицы.Изменится = СтрокаТаблицы.Распознано
			И СтрокаТаблицы.ТекущееЗначение <> СтрокаТаблицы.Значение;
	КонецЦикла;

КонецПроцедуры

// Файл уточнения, который помощник берет сам, когда спросить человека нельзя:
// в пачке у каждого объекта свой файл, а вопросов по тридцати объектам никто
// отвечать не станет.
//
// Порядок расширений в отборе уточнения и есть приоритет: при отборе
// «txt, pdf» текстовая копия договора берется раньше скана. Внутри одного
// расширения — по представлению, чтобы выбор не зависел от порядка записей.
//
// Параметры:
//   Варианты      - ТаблицаЗначений - результат ПолучитьВариантыУточнения;
//   ОтборЗначение - Строка - значения отбора уточнения через запятую.
//
// Возвращает строку вариантов либо Неопределено, если выбирать не из чего.
Функция ВыбратьВариантАвтоматически(Варианты, ОтборЗначение) Экспорт

	Если Варианты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Приоритеты = РазобратьСписокЗначений(ОтборЗначение);
	Лучший = Неопределено;
	ЛучшийПриоритет = 0;
	Для Каждого Вариант Из Варианты Цикл
		Позиция = Приоритеты.Найти(НРег(СокрЛП(Вариант.Дополнительно)));
		Приоритет = ?(Позиция = Неопределено, Приоритеты.Количество(), Позиция);
		Если Лучший = Неопределено
			Или Приоритет < ЛучшийПриоритет
			Или Приоритет = ЛучшийПриоритет И Вариант.Представление < Лучший.Представление Тогда
			Лучший = Вариант;
			ЛучшийПриоритет = Приоритет;
		КонецЕсли;
	КонецЦикла;

	Возврат Лучший;

КонецФункции

// Что сказать человеку, когда подходящих вариантов уточнения нет. Для файлов
// причина почти всегда одна — к объекту не прикреплено файла нужного формата,
// и назвать формат полезнее, чем сообщить «ничего не найдено».
Функция ТекстНетВариантов(Уточнение) Экспорт

	Форматы = СтрСоединить(РазобратьСписокЗначений(Уточнение.ОтборЗначение), ", ");
	Если Уточнение.ВидУточнения = Перечисления.AI_ВидУточнения.ВыборИзПодчиненных Тогда
		Если ЗначениеЗаполнено(Форматы) Тогда
			Возврат СтрШаблон("К объекту не прикреплено подходящих файлов (%1)."
				+ " Прикрепите файл и запустите действие снова.", Форматы);
		КонецЕсли;
		Возврат "У объекта нет подходящих значений для этого шага."
			+ " Прикрепите файл или заполните данные и запустите действие снова.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Форматы) Тогда
		Возврат СтрШаблон("Подходящих файлов (%1) не найдено.", Форматы);
	КонецЕсли;
	Возврат "Подходящих значений не найдено.";

КонецФункции

// Находит свойство дополнительного реквизита по наименованию.
//
// Одноименных свойств в базе бывает несколько: каждое заведено в своем
// наборе, и какое из них относится к объекту, решают наборы самого объекта.
// Пока свойство одно, наборы не проверяются.
//
// Параметры:
//   ИмяВидаХарактеристик - Строка - план видов характеристик свойств;
//   ИмяСвойства          - Строка - наименование свойства, как в карте;
//   Ссылка               - ссылка на объект, среди наборов которого выбирать.
//                          Без нее одноименные свойства неразличимы.
//
// Возвращает структуру:
//   Свойство  - найденное свойство либо Неопределено;
//   Кандидаты - Массив - все одноименные свойства;
//   Причина   - Строка - почему свойство не определено.
Функция НайтиДополнительныйРеквизит(ИмяВидаХарактеристик, ИмяСвойства, Ссылка = Неопределено) Экспорт

	Результат = Новый Структура("Свойство,Кандидаты,Причина", Неопределено, Новый Массив, "");

	ОписаниеВида = Метаданные.ПланыВидовХарактеристик.Найти(ИмяВидаХарактеристик);
	Если ОписаниеВида = Неопределено Тогда
		Результат.Причина = "Не найден план видов характеристик: " + ИмяВидаХарактеристик;
		Возврат Результат;
	КонецЕсли;

	// Дополнительное сведение хранится не в объекте, а в регистре: писать его
	// в табличную часть нельзя, поэтому такие свойства — не кандидаты.
	Условия = "НЕ Свойства.ПометкаУдаления И Свойства.Наименование = &Имя";
	Если ОписаниеВида.Реквизиты.Найти("ЭтоДополнительноеСведение") <> Неопределено Тогда
		Условия = Условия + " И НЕ Свойства.ЭтоДополнительноеСведение";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Свойства.Ссылка КАК Ссылка
		|ИЗ " + ОписаниеВида.ПолноеИмя() + " КАК Свойства
		|ГДЕ " + Условия);
	Запрос.УстановитьПараметр("Имя", ИмяСвойства);
	Результат.Кандидаты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	Если Результат.Кандидаты.Количество() = 0 Тогда
		Результат.Причина = "Дополнительный реквизит не найден: " + ИмяСвойства;
		Возврат Результат;
	КонецЕсли;
	Если Результат.Кандидаты.Количество() = 1 Тогда
		Результат.Свойство = Результат.Кандидаты[0];
		Возврат Результат;
	КонецЕсли;

	// Одноименные свойства — реквизиты разных наборов, и выбрать за
	// настройщика можно, только если объект сам говорит, какие наборы его.
	Если Ссылка = Неопределено Тогда
		Результат.Причина = СтрШаблон(
			"Дополнительных реквизитов с наименованием «%1» несколько, а объект не указан.",
			ИмяСвойства);
		Возврат Результат;
	КонецЕсли;

	Свои = СвойстваНаборовОбъекта(ОписаниеВида, Ссылка, Результат.Кандидаты);
	Если Свои = Неопределено Тогда
		Результат.Причина = СтрШаблон(
			"Дополнительных реквизитов с наименованием «%1» несколько, а наборов свойств"
				+ " в конфигурации не найдено — уточните настройку.",
			ИмяСвойства);
	ИначеЕсли Свои.Количество() = 1 Тогда
		Результат.Свойство = Свои[0];
	ИначеЕсли Свои.Количество() = 0 Тогда
		Результат.Причина = СтрШаблон(
			"Дополнительных реквизитов с наименованием «%1» несколько, и ни один"
				+ " не входит в наборы свойств объекта.",
			ИмяСвойства);
	Иначе
		Результат.Причина = СтрШаблон(
			"В наборах свойств объекта несколько дополнительных реквизитов"
				+ " с наименованием «%1» — уточните настройку.",
			ИмяСвойства);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Приводит значение из списка к значению своего свойства.
//
// «Да» есть у многих свойств, а тип у чужого «Да» тот же — справочник значений
// один на всех, — поэтому проверка типа его не отличит. Сверяется владелец:
// чужое значение заменяется одноименным значением своего свойства, а если
// такого нет, применять нечего. Значения других типов возвращаются как есть.
//
// Возвращает структуру: Значение, Причина.
Функция СверитьЗначениеСвойства(Свойство, Значение) Экспорт

	Результат = Новый Структура("Значение,Причина", Значение, "");
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Результат;
	КонецЕсли;
	ОписаниеЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если ОписаниеЗначения = Неопределено
		Или Не Метаданные.Справочники.Содержит(ОписаниеЗначения)
		Или Не ОписаниеЗначения.Владельцы.Содержит(Свойство.Метаданные()) Тогда
		Возврат Результат;
	КонецЕсли;

	Владелец = ВладелецЗначенийСвойства(Свойство);
	Если Значение.Владелец = Владелец Тогда
		Возврат Результат;
	КонецЕсли;

	Владельцы = Новый Массив;
	Владельцы.Добавить(Владелец);
	Список = Новый Структура("ПолноеИмя,ИмяСвойства,Владельцы,Причина",
		ОписаниеЗначения.ПолноеИмя(), Строка(Свойство), Владельцы, "");
	Поиск = Новый Структура("Значение,Успех,Комментарий", Неопределено, Ложь, "");
	// Сравнивается наименование, а не представление: представление значения
	// БСП переводит на язык пользователя, а перечень строится по наименованию.
	Свое = НайтиЗначениеВСписке(Список, Значение.Наименование, Поиск);
	Если Свое = Неопределено Тогда
		Результат.Значение = Неопределено;
		Результат.Причина = СтрШаблон(
			"Значение «%1» относится к другому свойству, а у «%2» такого значения нет.",
			Строка(Значение),
			Строка(Свойство));
	Иначе
		Результат.Значение = Свое;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Что можно выбрать в карте для объекта: табличные части и дополнительные
// реквизиты. Нужно форме карты, чтобы наименования не набирались руками —
// опечатка в них всплывает только при применении.
//
// Возвращает структуру с массивами структур Имя, Представление:
//   ТабличныеЧасти, ДополнительныеРеквизиты.
Функция ВариантыНастройкиКарты(ПолноеИмя) Экспорт

	Результат = Новый Структура("ТабличныеЧасти,ДополнительныеРеквизиты", Новый Массив, Новый Массив);
	ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(СокрЛП(Строка(ПолноеИмя)));
	Если ОписаниеОбъекта = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		ТабличныеЧасти = ОписаниеОбъекта.ТабличныеЧасти;
	Исключение
		Возврат Результат;
	КонецПопытки;

	Для Каждого ОписаниеТЧ Из ТабличныеЧасти Цикл
		// Свойства задаются своей колонкой карты, а не строками табличной части;
		// «Удалить...» — устаревшие табличные части, писать в них нечего.
		Если ОписаниеТЧ.Имя = "ДополнительныеРеквизиты"
			Или СтрНачинаетсяС(ОписаниеТЧ.Имя, "Удалить") Тогда
			Продолжить;
		КонецЕсли;
		Результат.ТабличныеЧасти.Добавить(Новый Структура("Имя,Представление",
			ОписаниеТЧ.Имя, ОписаниеТЧ.Представление()));
	КонецЦикла;

	ИмяВидаХарактеристик = ИмяВидаХарактеристикСвойств(ОписаниеОбъекта);
	Если Не ЗначениеЗаполнено(ИмяВидаХарактеристик) Тогда
		Возврат Результат;
	КонецЕсли;
	ОписаниеВида = Метаданные.ПланыВидовХарактеристик[ИмяВидаХарактеристик];
	Поля = "Свойства.Наименование КАК Наименование";
	Если ОписаниеВида.Реквизиты.Найти("НаборСвойств") <> Неопределено Тогда
		Поля = Поля + ", ПРЕДСТАВЛЕНИЕ(Свойства.НаборСвойств) КАК Набор";
	Иначе
		Поля = Поля + ", """" КАК Набор";
	КонецЕсли;
	Условия = "НЕ Свойства.ПометкаУдаления";
	Если ОписаниеВида.Реквизиты.Найти("ЭтоДополнительноеСведение") <> Неопределено Тогда
		Условия = Условия + " И НЕ Свойства.ЭтоДополнительноеСведение";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ " + Поля + "
		|ИЗ " + ОписаниеВида.ПолноеИмя() + " КАК Свойства
		|ГДЕ " + Условия + "
		|УПОРЯДОЧИТЬ ПО Свойства.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// В карту пишется наименование, а одноименные свойства разных наборов
		// различает только набор — его и показываем рядом.
		Представление = ?(ЗначениеЗаполнено(Выборка.Набор),
			СтрШаблон("%1 (%2)", Выборка.Наименование, Выборка.Набор),
			Выборка.Наименование);
		Результат.ДополнительныеРеквизиты.Добавить(Новый Структура("Имя,Представление",
			Выборка.Наименование, Представление));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Что можно извлекать в объект: наименование, реквизиты шапки простых типов,
// ссылки на справочники и перечисления, дополнительные реквизиты, а по запросу —
// колонки табличных частей. Нужна мастеру нового действия: карта собирается
// галочками, а не набором имен.
//
// Ссылки на документы пропускаются: найти документ по тексту из файла ядро не
// умеет. Составной тип из нескольких справочников («пользователь или роль»)
// дает одно поле, которое ищет по всем по очереди.
//
// Возвращает таблицу: Представление, ТабличнаяЧасть, ПутьРеквизита,
// ДополнительныйРеквизит, ТипЗначения, ТипСсылки, ПоискПоНаименованию,
// Подсказка, ВыбиратьИзСписка.
Функция КандидатыПолейКарты(ПолноеИмя, СТабличнымиЧастями = Ложь) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТабличнаяЧасть", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПутьРеквизита", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ДополнительныйРеквизит", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТипЗначения");
	Результат.Колонки.Добавить("ТипСсылки", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПоискПоНаименованию", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Подсказка", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ВыбиратьИзСписка", Новый ОписаниеТипов("Булево"));

	ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(СокрЛП(Строка(ПолноеИмя)));
	Если ОписаниеОбъекта = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// Наименование — стандартный реквизит, среди Реквизиты его нет, а для
	// нового элемента справочника это первое, что нужно заполнить.
	Если Метаданные.Справочники.Содержит(ОписаниеОбъекта) И ОписаниеОбъекта.ДлинаНаименования > 0 Тогда
		Кандидат = Результат.Добавить();
		Кандидат.Представление = "Наименование";
		Кандидат.ПутьРеквизита = "Наименование";
		Кандидат.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Строка;
	КонецЕсли;

	Для Каждого Реквизит Из ОписаниеОбъекта.Реквизиты Цикл
		ДобавитьКандидата(Результат, Реквизит, "", "");
	КонецЦикла;

	ИмяВида = ИмяВидаХарактеристикСвойств(ОписаниеОбъекта);
	Если ЗначениеЗаполнено(ИмяВида) Тогда
		// План видов характеристик общий на всю конфигурацию: без отбора по
		// наборам в шаблон согласования попали бы свойства договоров.
		СвоиСвойства = НаименованияСвойствОбъекта(ОписаниеОбъекта);
		Имена = Новый Соответствие;
		Для Каждого Вариант Из ВариантыНастройкиКарты(ОписаниеОбъекта.ПолноеИмя()).ДополнительныеРеквизиты Цикл
			Если Имена.Получить(Вариант.Имя) <> Неопределено
				Или СвоиСвойства <> Неопределено И СвоиСвойства.Найти(Вариант.Имя) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Имена.Вставить(Вариант.Имя, Истина);
			Поиск = НайтиДополнительныйРеквизит(ИмяВида, Вариант.Имя);
			Если Поиск.Свойство = Неопределено И Поиск.Кандидаты.Количество() > 0 Тогда
				// Одноименные свойства разных наборов — тип берем у первого:
				// какое из них чье, решит применение по наборам объекта.
				Поиск.Свойство = Поиск.Кандидаты[0];
			КонецЕсли;
			Если Поиск.Свойство = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Вид = ВидПоляПоТипу(Поиск.Свойство.ТипЗначения);
			Если Вид = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Кандидат = Результат.Добавить();
			Кандидат.Представление = Вариант.Имя;
			Кандидат.ДополнительныйРеквизит = Вариант.Имя;
			ЗаполнитьЗначенияСвойств(Кандидат, Вид);
		КонецЦикла;
	КонецЕсли;

	Если СТабличнымиЧастями Тогда
		Для Каждого ОписаниеТЧ Из ОписаниеОбъекта.ТабличныеЧасти Цикл
			// Свойства задаются своей колонкой карты, «Удалить...» — устаревшие части.
			Если ОписаниеТЧ.Имя = "ДополнительныеРеквизиты"
				Или СтрНачинаетсяС(ОписаниеТЧ.Имя, "Удалить") Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Колонка Из ОписаниеТЧ.Реквизиты Цикл
				ДобавитьКандидата(Результат, Колонка, ОписаниеТЧ.Имя, ОписаниеТЧ.Представление());
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Что объекта можно передать модели как данные: реквизиты шапки и табличные
// части с колонками. Нужна форме места запуска и мастеру, чтобы имена не
// набирались руками.
//
// Возвращает структуру:
//   Реквизиты      - Массив из Структура - Имя, Представление;
//   ТабличныеЧасти - Массив из Структура - Имя, Представление,
//                    Колонки (Массив из Структура - Имя, Представление).
Функция ВариантыДанныхОбъекта(ПолноеИмя) Экспорт

	Результат = Новый Структура("Реквизиты,ТабличныеЧасти", Новый Массив, Новый Массив);
	ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(СокрЛП(Строка(ПолноеИмя)));
	Если ОписаниеОбъекта = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Для Каждого Стандартный Из ОписаниеОбъекта.СтандартныеРеквизиты Цикл
			Если СтрНайти(",Наименование,Код,Номер,Дата,Владелец,Родитель,", "," + Стандартный.Имя + ",") > 0 Тогда
				Результат.Реквизиты.Добавить(Новый Структура("Имя,Представление",
					Стандартный.Имя, Стандартный.Представление()));
			КонецЕсли;
		КонецЦикла;
	Исключение
		// У вида метаданных нет стандартных реквизитов — берем только свои.
	КонецПопытки;
	Для Каждого Реквизит Из ОписаниеОбъекта.Реквизиты Цикл
		Если Не СтрНачинаетсяС(Реквизит.Имя, "Удалить") Тогда
			Результат.Реквизиты.Добавить(Новый Структура("Имя,Представление",
				Реквизит.Имя, Реквизит.Представление()));
		КонецЕсли;
	КонецЦикла;

	Попытка
		ТабличныеЧасти = ОписаниеОбъекта.ТабличныеЧасти;
	Исключение
		Возврат Результат;
	КонецПопытки;
	Для Каждого ОписаниеТЧ Из ТабличныеЧасти Цикл
		Если ОписаниеТЧ.Имя = "ДополнительныеРеквизиты" Или СтрНачинаетсяС(ОписаниеТЧ.Имя, "Удалить") Тогда
			Продолжить;
		КонецЕсли;
		Колонки = Новый Массив;
		Для Каждого Колонка Из ОписаниеТЧ.Реквизиты Цикл
			Если Не СтрНачинаетсяС(Колонка.Имя, "Удалить") Тогда
				Колонки.Добавить(Новый Структура("Имя,Представление", Колонка.Имя, Колонка.Представление()));
			КонецЕсли;
		КонецЦикла;
		Результат.ТабличныеЧасти.Добавить(Новый Структура("Имя,Представление,Колонки",
			ОписаниеТЧ.Имя, ОписаниеТЧ.Представление(), Колонки));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Что собрать в разговоре: поля карты человеческими словами, с допустимыми
// значениями. Нужно диалоговому режиму — модель должна спрашивать именно то,
// что потом ляжет в объект, и называть существующих людей и значения, а не
// придумывать их.
Функция ОписаниеПолейДляДиалога(Карта) Экспорт

	Если Не ЗначениеЗаполнено(Карта) Тогда
		Возврат "";
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("Что нужно собрать в разговоре:");
	ТекущаяТЧ = "";
	ИмяОбъекта = ИмяОбъектаКарты(Карта);
	Для Каждого Поле Из Карта.Поля Цикл
		ИмяТЧ = СокрЛП(Поле.ТабличнаяЧасть);
		Отступ = "- ";
		Если ЗначениеЗаполнено(ИмяТЧ) Тогда
			Если ИмяТЧ <> ТекущаяТЧ Тогда
				// Список модель называет так, как его знает пользователь.
				Строки.Добавить(СтрШаблон("- список «%1», по строке на каждый элемент:",
					ПредставлениеТабличнойЧасти(Карта, ИмяТЧ)));
				ТекущаяТЧ = ИмяТЧ;
			КонецЕсли;
			Отступ = "  - ";
		Иначе
			ТекущаяТЧ = "";
		КонецЕсли;
		Название = ?(ЗначениеЗаполнено(Поле.Представление), Поле.Представление, Поле.Ключ);
		Текст = Отступ + Название;
		Перечень = ДопустимыеЗначенияПоля(Поле, ИмяОбъекта);
		// Пояснения адаптера («исполняет Петров И. С.») помогают модели понять,
		// что «юрист Петров» — это роль, а не пользователь.
		ЗначенияАдаптера = ЗначенияАдаптераПоля(Поле, ИмяОбъекта);
		Пояснения = Новый Соответствие;
		Для Каждого Значение Из ЗначенияАдаптера Цикл
			Если ЗначениеЗаполнено(Значение.Пояснение) Тогда
				Пояснения.Вставить(Значение.Представление, Значение.Пояснение);
			КонецЕсли;
		КонецЦикла;
		Значения = Новый Массив;
		Для Каждого Значение Из Перечень Цикл
			Если ЗначениеЗаполнено(Значение) Тогда
				Пояснение = Пояснения.Получить(Значение);
				Значения.Добавить(?(Пояснение = Неопределено, Значение,
					СтрШаблон("%1 (%2)", Значение, Пояснение)));
			КонецЕсли;
		КонецЦикла;
		Если Значения.Количество() > 0 Тогда
			Текст = Текст + ": одно из — " + СтрСоединить(Значения, "; ");
		ИначеЕсли ЗначенияАдаптера.Количество() > 0 Тогда
			Текст = Текст + ": например — " + ПереченьЗначенийАдаптера(ЗначенияАдаптера, 50)
				+ "; или другое значение по имени";
		ИначеЕсли Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Число Тогда
			Текст = Текст + " (число)";
		ИначеЕсли Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Дата Тогда
			Текст = Текст + " (дата)";
		ИначеЕсли Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Булево Тогда
			Текст = Текст + " (да или нет)";
		КонецЕсли;
		Если ЗначениеЗаполнено(Поле.Подсказка) Тогда
			Текст = Текст + ". " + СокрЛП(Поле.Подсказка);
		КонецЕсли;
		Строки.Добавить(Текст);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Полные имена типов ссылки поля: в карте их несколько через запятую, если
// реквизит составной.
Функция ИменаТиповСсылки(Поле) Экспорт

	Имена = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Строка(Поле.ТипСсылки), ",", Ложь) Цикл
		Имя = СокрЛП(Часть);
		Если ЗначениеЗаполнено(Имя) Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

// План видов характеристик дополнительных реквизитов объекта — по типу
// колонки «Свойство» его табличной части ДополнительныеРеквизиты: ссылаться
// на план из расширения значило бы привязаться к одной конфигурации.
// Пустая строка, если дополнительных реквизитов у объекта нет.
Функция ИмяВидаХарактеристикСвойств(ОписаниеОбъекта) Экспорт

	Попытка
		ОписаниеТЧ = ОписаниеОбъекта.ТабличныеЧасти.Найти("ДополнительныеРеквизиты");
	Исключение
		Возврат "";
	КонецПопытки;
	Если ОписаниеТЧ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	КолонкаСвойство = ОписаниеТЧ.Реквизиты.Найти("Свойство");
	Если КолонкаСвойство = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Тип Из КолонкаСвойство.Тип.Типы() Цикл
		ОписаниеВида = Метаданные.НайтиПоТипу(Тип);
		Если ОписаниеВида <> Неопределено
			И Метаданные.ПланыВидовХарактеристик.Содержит(ОписаниеВида) Тогда
			Возврат ОписаниеВида.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строка кандидатов по реквизиту шапки или колонке табличной части.
Процедура ДобавитьКандидата(Результат, Реквизит, ИмяТЧ, ПредставлениеТЧ)

	Если СтрНачинаетсяС(Реквизит.Имя, "Удалить") Тогда
		Возврат;
	КонецЕсли;
	Вид = ВидПоляПоТипу(Реквизит.Тип);
	Если Вид = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Кандидат = Результат.Добавить();
	Кандидат.Представление = ?(ЗначениеЗаполнено(ИмяТЧ),
		СтрШаблон("%1: %2", ПредставлениеТЧ, Реквизит.Представление()),
		Реквизит.Представление());
	Кандидат.ТабличнаяЧасть = ИмяТЧ;
	Кандидат.ПутьРеквизита = Реквизит.Имя;
	ЗаполнитьЗначенияСвойств(Кандидат, Вид);
	// Подсказка, повторяющая название («Адресат» у реквизита «Адресат»),
	// модели ничего не добавляет — пусть поле останется пустым для своей.
	Если НРег(СокрЛП(Реквизит.Подсказка)) <> НРег(СокрЛП(Реквизит.Представление())) Тогда
		Кандидат.Подсказка = Реквизит.Подсказка;
	КонецЕсли;

КонецПроцедуры

// Тип поля карты по типу реквизита. Неопределено — такой реквизит карта
// заполнить не сможет.
//
// Ссылки ищутся по тексту модели, поэтому годятся справочники с наименованием и
// перечисления. Строка в составном типе не мешает: значение из документа почти
// всегда элемент справочника. А тип значения свойства из десятков справочников
// поиском по тексту не угадать — такой пропускается.
Функция ВидПоляПоТипу(ОписаниеТипа)

	Виды = Перечисления.AI_ТипЗначенияПоля;
	Результат = Новый Структура("ТипЗначения,ТипСсылки,ПоискПоНаименованию",
		Неопределено, "", Ложь);

	Ссылочные = Новый Массив;
	Прочие = Новый Массив;
	Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
		ОписаниеСсылки = Метаданные.НайтиПоТипу(Тип);
		Если ОписаниеСсылки = Неопределено Тогда
			Прочие.Добавить(Тип);
		ИначеЕсли ИщетсяПоТексту(ОписаниеСсылки) Тогда
			Ссылочные.Добавить(ОписаниеСсылки.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;

	Если Ссылочные.Количество() > 0 Тогда
		Если Ссылочные.Количество() > 3 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат.ТипЗначения = Виды.Ссылка;
		Результат.ТипСсылки = СтрСоединить(Ссылочные, ", ");
		Результат.ПоискПоНаименованию = Истина;
		Возврат Результат;
	КонецЕсли;

	Если Прочие.Количество() <> 1 Или ОписаниеТипа.Типы().Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Прочие[0] = Тип("Строка") Тогда
		Результат.ТипЗначения = Виды.Строка;
	ИначеЕсли Прочие[0] = Тип("Число") Тогда
		Результат.ТипЗначения = Виды.Число;
	ИначеЕсли Прочие[0] = Тип("Дата") Тогда
		Результат.ТипЗначения = Виды.Дата;
	ИначеЕсли Прочие[0] = Тип("Булево") Тогда
		Результат.ТипЗначения = Виды.Булево;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Справочник с наименованием или перечисление: по тексту модели значение
// однозначно находится. Справочник без наименования (полные роли ДО) искать
// не по чему — если только его не знает адаптер конфигурации.
Функция ИщетсяПоТексту(ОписаниеСсылки)

	Если Метаданные.Перечисления.Содержит(ОписаниеСсылки) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Метаданные.Справочники.Содержит(ОписаниеСсылки) И ОписаниеСсылки.ДлинаНаименования > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ТипОбрабатываетАдаптер(ОписаниеСсылки);

КонецФункции

// Раскладывает массивы строк табличных частей в плоские строки результата.
//
// Модель возвращает их массивом под ключом, равным имени табличной части.
// Нумерация строк сквозная по массиву: по ней применение собирает строки
// обратно, поэтому терять ее нельзя.
Процедура РазобратьСтрокиТабличныхЧастей(Карта, Данные, Результат, ИмяОбъекта)

	ГруппыПолей = Новый Соответствие;
	Для Каждого Поле Из Карта.Поля Цикл
		ИмяТЧ = СокрЛП(Поле.ТабличнаяЧасть);
		Если Не ЗначениеЗаполнено(ИмяТЧ) Или Не ЗначениеЗаполнено(СокрЛП(Поле.Ключ)) Тогда
			Продолжить;
		КонецЕсли;
		СписокПолей = ГруппыПолей.Получить(НРег(ИмяТЧ));
		Если СписокПолей = Неопределено Тогда
			СписокПолей = Новый Массив;
			ГруппыПолей.Вставить(НРег(ИмяТЧ), СписокПолей);
		КонецЕсли;
		СписокПолей.Добавить(Поле);
	КонецЦикла;

	Для Каждого ЭлементГруппы Из ГруппыПолей Цикл
		СписокПолей = ЭлементГруппы.Значение;
		ИмяТЧ = СокрЛП(СписокПолей[0].ТабличнаяЧасть);
		ПредставлениеТЧ = ПредставлениеТабличнойЧасти(Карта, ИмяТЧ);

		СтрокиОтвета = ЗначениеПоКлючуБезРегистра(Данные, ИмяТЧ);
		Если ТипЗнч(СтрокиОтвета) <> Тип("Массив") Тогда
			// Массива нет — модель не нашла строк. Говорим об этом один раз на
			// табличную часть, а не по разу на каждое поле.
			СтрокаТаблицы = Результат.Добавить();
			СтрокаТаблицы.Ключ = ИмяТЧ;
			СтрокаТаблицы.Представление = "Табличная часть «" + ПредставлениеТЧ + "»";
			СтрокаТаблицы.ТабличнаяЧасть = ИмяТЧ;
			СтрокаТаблицы.Комментарий = "Модель не вернула строк табличной части.";
			Продолжить;
		КонецЕсли;

		// При обновлении по номеру строку объекта называет сама модель: номер
		// она видела в данных объекта. Без номера значение положить некуда.
		ПоНомеру = Карта.ОбновлятьСтрокиПоНомеру;
		Номер = 0;
		Для Каждого СтрокаОтвета Из СтрокиОтвета Цикл
			Номер = Номер + 1;
			НомерСтроки = Номер;
			ПричинаНомера = "";
			Если ПоНомеру Тогда
				НомерСтроки = НомерСтрокиОтвета(СтрокаОтвета);
				Если НомерСтроки <= 0 Тогда
					ПричинаНомера = "Модель не указала номер строки — неизвестно, какую строку менять.";
				КонецЕсли;
			КонецЕсли;
			Для Каждого Поле Из СписокПолей Цикл
				Ключ = СокрЛП(Поле.Ключ);
				СтрокаТаблицы = Результат.Добавить();
				СтрокаТаблицы.Ключ = Ключ;
				СтрокаТаблицы.ТабличнаяЧасть = ИмяТЧ;
				СтрокаТаблицы.НомерСтроки = НомерСтроки;
				СтрокаТаблицы.ПутьРеквизита = СокрЛП(Поле.ПутьРеквизита);
				СтрокаТаблицы.ТипЗначения = Поле.ТипЗначения;
				СтрокаТаблицы.Представление = СтрШаблон("%1 [%2]: %3",
					ПредставлениеТЧ,
					?(НомерСтроки > 0, НомерСтроки, "?"),
					?(ЗначениеЗаполнено(Поле.Представление), Поле.Представление, Ключ));
				Если ЗначениеЗаполнено(ПричинаНомера) Тогда
					СтрокаТаблицы.Комментарий = ПричинаНомера;
					Продолжить;
				КонецЕсли;

				Сырое = Неопределено;
				Если ТипЗнч(СтрокаОтвета) = Тип("Соответствие") Тогда
					Сырое = ЗначениеПоКлючуБезРегистра(СтрокаОтвета, Ключ);
				КонецЕсли;
				Если Сырое = Неопределено Или Сырое = Null Тогда
					СтрокаТаблицы.Комментарий = ?(Поле.Обязательное,
						"Обязательное поле строки не заполнено моделью.",
						"Модель не вернула значение.");
					Продолжить;
				КонецЕсли;

				СтрокаТаблицы.ЗначениеМодели = Лев(Строка(Сырое), 500);
				Преобразование = ПреобразоватьЗначение(Сырое, Поле, , ИмяОбъекта);
				СтрокаТаблицы.Значение = Преобразование.Значение;
				СтрокаТаблицы.Распознано = Преобразование.Успех;
				СтрокаТаблицы.Комментарий = Преобразование.Комментарий;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Табличная часть так, как ее видит пользователь в форме объекта: в ДО
// «Исполнители» шаблона согласования называются «Лист согласования».
Функция ПредставлениеТабличнойЧасти(Карта, ИмяТЧ)

	ОписаниеОбъекта = Метаданные.НайтиПоПолномуИмени(СокрЛП(Строка(Карта.ПолноеИмяМетаданных)));
	Если ОписаниеОбъекта = Неопределено Тогда
		Возврат ИмяТЧ;
	КонецЕсли;
	Попытка
		ОписаниеТЧ = ОписаниеОбъекта.ТабличныеЧасти.Найти(ИмяТЧ);
	Исключение
		// У вида метаданных нет табличных частей.
		ОписаниеТЧ = Неопределено;
	КонецПопытки;
	Возврат ?(ОписаниеТЧ = Неопределено, ИмяТЧ, ОписаниеТЧ.Представление());

КонецФункции

// Ключ номера строки в ответе для обновления строк по номеру. Латиница — как
// у остальных ключей схемы.
Функция КлючНомераСтроки()
	Возврат "row";
КонецФункции

// Номер строки из ответа модели; 0 — номера нет или он не число.
Функция НомерСтрокиОтвета(СтрокаОтвета)

	Если ТипЗнч(СтрокаОтвета) <> Тип("Соответствие") Тогда
		Возврат 0;
	КонецЕсли;
	Сырое = ЗначениеПоКлючуБезРегистра(СтрокаОтвета, КлючНомераСтроки());
	Если Сырое = Неопределено Или Сырое = Null Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Номер = Число(СтрЗаменить(Строка(Сырое), " ", ""));
	Исключение
		Возврат 0;
	КонецПопытки;
	Возврат ?(Номер > 0 И Номер = Цел(Номер), Номер, 0);

КонецФункции

// Ключи в ответе приходят как в схеме, но регистр модель иногда меняет.
Функция ЗначениеПоКлючуБезРегистра(Данные, Ключ)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Точное = Данные.Получить(Ключ);
	Если Точное <> Неопределено Тогда
		Возврат Точное;
	КонецЕсли;
	Искомый = НРег(Ключ);
	Для Каждого Элемент Из Данные Цикл
		Если НРег(Строка(Элемент.Ключ)) = Искомый Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Процедура ПроверитьКарту(Карта)
	Если ТипЗнч(Карта) <> Тип("СправочникСсылка.AI_КартыИзвлечения")
		Или Не ЗначениеЗаполнено(Карта) Тогда
		ВызватьИсключение "Не указана карта извлечения реквизитов.";
	КонецЕсли;
	Если Карта.ПометкаУдаления Или Не Карта.Активна Тогда
		ВызватьИсключение "Карта извлечения недоступна: " + Строка(Карта);
	КонецЕсли;
КонецПроцедуры

Функция ТипСхемыПоля(ТипЗначения)
	Если ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Число Тогда
		Возврат "number";
	ИначеЕсли ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Булево Тогда
		Возврат "boolean";
	КонецЕсли;
	// Дата и ссылка приходят строкой: дата в ISO, ссылка — представлением.
	Возврат "string";
КонецФункции

Функция ТекстОписанияПоля(Поле, ЕстьПеречень = Ложь, ИмяОбъекта = "")
	Части = Новый Массив;
	Если ЗначениеЗаполнено(Поле.Подсказка) Тогда
		Части.Добавить(СокрЛП(Поле.Подсказка));
	КонецЕсли;
	Если Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Дата Тогда
		Части.Добавить("Формат даты: ГГГГ-ММ-ДД.");
	КонецЕсли;
	Если Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Ссылка Тогда
		Если ЕстьПеречень Тогда
			Части.Добавить("Выбрать одно значение из перечня дословно;"
				+ " пустая строка — если в документе этого нет.");
		Иначе
			// Полного перечня нет (например, пользователей больше сотни), но
			// роли и автоподстановки модель по памяти не назовет — подсказываем.
			ЗначенияАдаптера = ЗначенияАдаптераПоля(Поле, ИмяОбъекта);
			Если ЗначенияАдаптера.Количество() > 0 Тогда
				Части.Добавить("Значения конфигурации: " + ПереченьЗначенийАдаптера(ЗначенияАдаптера, 50)
					+ ". Иначе — наименование как в документе.");
			Иначе
				Части.Добавить("Вернуть наименование как в документе.");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат СтрСоединить(Части, " ");
КонецФункции

// «Юрист (исполняет Петров И. С.); Автор процесса» — не больше Предел значений.
Функция ПереченьЗначенийАдаптера(ЗначенияАдаптера, Предел)

	Части = Новый Массив;
	Для Каждого Значение Из ЗначенияАдаптера Цикл
		Если Части.Количество() >= Предел Тогда
			Части.Добавить("и другие");
			Прервать;
		КонецЕсли;
		Части.Добавить(?(ЗначениеЗаполнено(Значение.Пояснение),
			СтрШаблон("%1 (%2)", Значение.Представление, Значение.Пояснение), Значение.Представление));
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

Функция ПолучитьОбъектКонтекста(Контекст)

	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПолноеИмя = "";
	Ключ = "";
	Контекст.Свойство("ПолноеИмяМетаданных", ПолноеИмя);
	Контекст.Свойство("КлючИсточника", Ключ);
	ПолноеИмя = СокрЛП(Строка(ПолноеИмя));
	Ключ = СокрЛП(Строка(Ключ));
	Если Не ЗначениеЗаполнено(ПолноеИмя) Или Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Описание = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Менеджер = МенеджерПоПолномуИмени(ПолноеИмя);
		Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Ключ));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Менеджер объекта по полному имени метаданных.
// Реализовано платформенными средствами, без ОбщегоНазначения БСП:
// расширение должно работать и в конфигурациях без БСП.
Функция МенеджерПоПолномуИмени(ПолноеИмя) Экспорт

	Части = СтрРазделить(ПолноеИмя, ".");
	Если Части.Количество() < 2 Тогда
		ВызватьИсключение "Некорректное полное имя метаданных: " + ПолноеИмя;
	КонецЕсли;
	Вид = ВРег(Части[0]);
	Имя = Части[1];

	Если Вид = ВРег("Справочник") Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Вид = ВРег("Документ") Тогда
		Возврат Документы[Имя];
	ИначеЕсли Вид = ВРег("Перечисление") Тогда
		Возврат Перечисления[Имя];
	ИначеЕсли Вид = ВРег("ПланВидовХарактеристик") Тогда
		Возврат ПланыВидовХарактеристик[Имя];
	ИначеЕсли Вид = ВРег("ПланСчетов") Тогда
		Возврат ПланыСчетов[Имя];
	ИначеЕсли Вид = ВРег("ПланВидовРасчета") Тогда
		Возврат ПланыВидовРасчета[Имя];
	ИначеЕсли Вид = ВРег("БизнесПроцесс") Тогда
		Возврат БизнесПроцессы[Имя];
	ИначеЕсли Вид = ВРег("Задача") Тогда
		Возврат Задачи[Имя];
	КонецЕсли;
	ВызватьИсключение "Неподдерживаемый вид метаданных: " + ПолноеИмя;

КонецФункции

// Читает значение по пути вида "Реквизит" или "Реквизит.Реквизит".
Функция ПрочитатьПоПути(Объект, Путь)
	Текущее = Объект;
	Для Каждого Часть Из СтрРазделить(Путь, ".") Цикл
		Часть = СокрЛП(Часть);
		Если Не ЗначениеЗаполнено(Часть) Или Текущее = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Попытка
			Текущее = Текущее[Часть];
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
	Возврат Текущее;
КонецФункции

Функция ПроверитьУсловиеОтбора(Значение, Отбор)

	Вид = Отбор.ВидСравнения;
	Если Вид = Перечисления.AI_ВидСравненияОтбора.Заполнено Тогда
		Возврат ЗначениеЗаполнено(Значение);
	ИначеЕсли Вид = Перечисления.AI_ВидСравненияОтбора.НеЗаполнено Тогда
		Возврат Не ЗначениеЗаполнено(Значение);
	КонецЕсли;

	// Сравнение идет по представлению: в отборе администратор пишет текст,
	// а не ссылку, иначе ядро зависело бы от типов прикладной конфигурации.
	Фактическое = НРег(СокрЛП(Строка(Значение)));
	Ожидаемые = РазобратьСписокЗначений(Отбор.Значение);
	Совпало = (Ожидаемые.Найти(Фактическое) <> Неопределено);

	Если Вид = Перечисления.AI_ВидСравненияОтбора.НеРавно Тогда
		Возврат Не Совпало;
	КонецЕсли;
	Возврат Совпало;

КонецФункции

// Разбирает перечисление значений через запятую в нижнем регистре.
Функция РазобратьСписокЗначений(Значение)
	Результат = Новый Массив;
	Текст = НРег(СокрЛП(Строка(Значение)));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Часть Из СтрРазделить(Текст, ",") Цикл
		Часть = СокрЛП(Часть);
		Если ЗначениеЗаполнено(Часть) И Результат.Найти(Часть) = Неопределено Тогда
			Результат.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СформироватьИмяФайла(Вложение, Уточнение)

	Имя = "";
	РеквизитИмени = СокрЛП(Строка(Уточнение.РеквизитИмениФайла));
	Если ЗначениеЗаполнено(РеквизитИмени) Тогда
		Имя = СокрЛП(Строка(ПрочитатьПоПути(Вложение, РеквизитИмени)));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Имя = СокрЛП(Строка(Вложение));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Имя = "attachment";
	КонецЕсли;

	// Расширение нужно модели, чтобы понять формат вложения.
	Если СтрНайти(Имя, ".") = 0 Тогда
		РеквизитРасширения = СокрЛП(Строка(Уточнение.ОтборРеквизит));
		Расширение = "";
		Если ЗначениеЗаполнено(РеквизитРасширения) Тогда
			Расширение = НРег(СокрЛП(Строка(ПрочитатьПоПути(Вложение, РеквизитРасширения))));
			Расширение = СтрЗаменить(Расширение, ".", "");
		КонецЕсли;
		Если ЗначениеЗаполнено(Расширение) Тогда
			Имя = Имя + "." + Расширение;
		КонецЕсли;
	КонецЕсли;
	Возврат Лев(Имя, 250);

КонецФункции

Функция ВладелецФайлаПодходит(ОписаниеСправочника, ТипСсылки)

	Реквизит = ОписаниеСправочника.Реквизиты.Найти("ВладелецФайла");
	Возврат Реквизит <> Неопределено И Реквизит.Тип.СодержитТип(ТипСсылки);

КонецФункции

// Содержимое присоединенного файла через программный интерфейс БСП. Модуль
// вычисляется по имени: ссылка на него из расширения привязала бы подсистему
// к конфигурациям с БСП. Неопределено — БСП нет или файл ей не принадлежит.
Функция ДвоичныеДанныеФайлаБСП(Файл)

	Если Метаданные.ОбщиеМодули.Найти("РаботаСФайлами") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Модуль = Вычислить("РаботаСФайлами");
		Данные = Модуль.ДвоичныеДанныеФайла(Файл, Ложь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(ТипЗнч(Данные) = Тип("ДвоичныеДанные"), Данные, Неопределено);

КонецФункции

Функция ПрочитатьСодержимоеИзРеквизита(Вложение, РеквизитСодержимого)

	Значение = ПрочитатьПоПути(Вложение, РеквизитСодержимого);
	Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
		Значение = Значение.Получить();
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		Возврат Значение;
	КонецЕсли;
	// Реквизит может хранить извлеченный текст — его тоже отдаем модели файлом.
	Если ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		Возврат ПолучитьДвоичныеДанныеИзСтроки(Значение);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ПрочитатьОтвет(ТекстОтвета)

	Текст = СокрЛП(Строка(ТекстОтвета));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		ВызватьИсключение "Модель вернула пустой ответ.";
	КонецЕсли;
	Если СтрДлина(Текст) > 1000000 Тогда
		ВызватьИсключение "Ответ модели превышает 1 МБ символов.";
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		ВызватьИсключение "Ответ модели не является корректным JSON: " + ОписаниеОшибки();
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Корнем ответа модели должен быть объект JSON.";
	КонецЕсли;
	Возврат Данные;

КонецФункции

Функция ПреобразоватьЗначение(Сырое, Поле, СсылкаОбъекта = Неопределено, ИмяОбъекта = "")

	Результат = Новый Структура("Значение,Успех,Комментарий", Неопределено, Ложь, "");

	// Строгая схема не дает модели промолчать: «в документе этого нет» она
	// говорит пустой строкой или нулем, как ее и просят. Это не значение.
	// Сочти его распознанным — и пустота затрет в объекте то, что там уже есть.
	Если ЭтоОтветНетЗначения(Сырое, Поле) Тогда
		Результат.Комментарий = ТекстЗначениеНеНайдено();
		Возврат Результат;
	КонецЕсли;

	Если Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Число Тогда
		Попытка
			Результат.Значение = Число(СтрЗаменить(СтрЗаменить(Строка(Сырое), " ", ""), ",", "."));
			Результат.Успех = Истина;
		Исключение
			Результат.Комментарий = "Не удалось преобразовать в число.";
		КонецПопытки;

	ИначеЕсли Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Булево Тогда
		Результат.Значение = ПреобразоватьВБулево(Сырое, Результат);

	ИначеЕсли Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Дата Тогда
		Результат.Значение = ПреобразоватьВДату(Сырое, Результат);

	ИначеЕсли Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Ссылка Тогда
		Результат.Значение = НайтиСсылку(Строка(Сырое), Поле, Результат, СсылкаОбъекта, ИмяОбъекта);

	Иначе
		Результат.Значение = Строка(Сырое);
		Результат.Успех = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Истина, если модель ответила «значения нет». Логическое поле так ответить не
// может: Ложь у него — такой же ответ, как Истина.
Функция ЭтоОтветНетЗначения(Сырое, Поле)

	Если Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Булево Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Сырое) = Тип("Число") Тогда
		Возврат Сырое = 0;
	КонецЕсли;

	Текст = НРег(СокрЛП(Строка(Сырое)));
	Если Не ЗначениеЗаполнено(Текст)
		Или СтрНайти(",null,none,n/a,-,—,", "," + Текст + ",") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Поле.ТипЗначения = Перечисления.AI_ТипЗначенияПоля.Число Тогда
		Попытка
			Возврат Число(СтрЗаменить(СтрЗаменить(Текст, " ", ""), ",", ".")) = 0;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Модель ищет значение не только в документе, но и в данных объекта и в
// разговоре: «в документе не найдено» после разговора сбивает с толку.
Функция ТекстЗначениеНеНайдено()
	Возврат "Модель не нашла значение.";
КонецФункции

// Текущее значение того, что заполняет строка разбора: реквизита шапки, ячейки
// табличной части или дополнительного реквизита. Неопределено — прочитать нечего.
Функция ТекущееЗначениеПоля(Объект, СтрокаРазбора, ИмяВида)

	Попытка
		Если ЗначениеЗаполнено(СтрокаРазбора.ТабличнаяЧасть) Тогда
			ТабличнаяЧасть = Объект[СтрокаРазбора.ТабличнаяЧасть];
			Если СтрокаРазбора.НомерСтроки < 1
				Или СтрокаРазбора.НомерСтроки > ТабличнаяЧасть.Количество()
				Или Не ЗначениеЗаполнено(СтрокаРазбора.ПутьРеквизита) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат ТабличнаяЧасть[СтрокаРазбора.НомерСтроки - 1][СтрокаРазбора.ПутьРеквизита];
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаРазбора.ДополнительныйРеквизит) Тогда
			Если Не ЗначениеЗаполнено(ИмяВида) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Поиск = НайтиДополнительныйРеквизит(ИмяВида,
				СтрокаРазбора.ДополнительныйРеквизит, Объект.Ссылка);
			Если Поиск.Свойство = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Найдена = Объект.ДополнительныеРеквизиты.Найти(Поиск.Свойство, "Свойство");
			Возврат ?(Найдена = Неопределено, Неопределено, Найдена.Значение);
		КонецЕсли;

		Путь = СтрокаРазбора.ПутьРеквизита;
		Если ЗначениеЗаполнено(Путь) И СтрНайти(Путь, ".") = 0 Тогда
			Возврат Объект[Путь];
		КонецЕсли;
	Исключение
		// Реквизита у объекта нет — ошибку карты покажет применение, а здесь
		// текущего значения просто нет.
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПреобразоватьВБулево(Сырое, Результат)
	Если ТипЗнч(Сырое) = Тип("Булево") Тогда
		Результат.Успех = Истина;
		Возврат Сырое;
	КонецЕсли;
	Текст = НРег(СокрЛП(Строка(Сырое)));
	Если СтрНайти(",да,истина,true,1,yes,", "," + Текст + ",") > 0 Тогда
		Результат.Успех = Истина;
		Возврат Истина;
	ИначеЕсли СтрНайти(",нет,ложь,false,0,no,", "," + Текст + ",") > 0 Тогда
		Результат.Успех = Истина;
		Возврат Ложь;
	КонецЕсли;
	Результат.Комментарий = "Не удалось определить логическое значение.";
	Возврат Неопределено;
КонецФункции

Функция ПреобразоватьВДату(Сырое, Результат)
	Если ТипЗнч(Сырое) = Тип("Дата") Тогда
		Результат.Успех = Истина;
		Возврат Сырое;
	КонецЕсли;
	Текст = СокрЛП(Строка(Сырое));
	// Ожидаем ISO ГГГГ-ММ-ДД: именно этот формат заявлен модели в схеме.
	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Цифры) < 8 Тогда
		Результат.Комментарий = СтрШаблон("Не удалось разобрать дату «%1».", Текст);
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Результат.Значение = Дата(Лев(Цифры, 8));
		Результат.Успех = Истина;
		Возврат Результат.Значение;
	Исключение
		Результат.Комментарий = СтрШаблон("Не удалось разобрать дату «%1».", Текст);
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Поиск ссылки идет по полному имени метаданных из карты — рефлексией,
// поэтому ядро не связано с конкретными справочниками конфигурации.
//
// Типов у поля бывает несколько («пользователь или роль»): ищем по очереди,
// первое найденное и есть значение. Перечисление находится по представлению
// значения — так его видит и называет человек.
Функция НайтиСсылку(Представление, Поле, Результат, СсылкаОбъекта = Неопределено, ИмяОбъекта = "")

	Имена = ИменаТиповСсылки(Поле);
	Текст = СокрЛП(Представление);
	Если Имена.Количество() = 0 Тогда
		Результат.Комментарий = "В карте не указан тип ссылки.";
		Возврат Неопределено;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Результат.Комментарий = ТекстЗначениеНеНайдено();
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ПолноеИмя Из Имена Цикл
		Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
			Результат.Комментарий = "Тип ссылки не найден в конфигурации: " + ПолноеИмя;
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если Не Поле.ПоискПоНаименованию Тогда
		Результат.Комментарий = "Поиск по наименованию отключен, значение требует ручного выбора.";
		Возврат Неопределено;
	КонецЕсли;

	// Типы, которые ядро искать не умеет (полные роли, автоподстановки ДО),
	// разбирает адаптер конфигурации — и первым: «Юрист» у него роль, а не
	// пользователь с такой фамилией.
	КомментарийАдаптера = "";
	ТипыАдаптера = ТипыПоляАдаптера(Поле);
	Если ТипыАдаптера.Количество() > 0 Тогда
		Найденное = НайтиЗначениеАдаптером(Поле, ТипыАдаптера, Текст, ИмяОбъекта);
		Если Найденное.Найдено Тогда
			Результат.Успех = Истина;
			Результат.Комментарий = Найденное.Комментарий;
			Возврат Найденное.Значение;
		КонецЕсли;
		КомментарийАдаптера = Найденное.Комментарий;
	КонецЕсли;

	// Значение дополнительного реквизита-списка ищется только среди значений
	// своего свойства: «Да» есть у многих свойств, и поиск по всему
	// справочнику нашел бы чужое.
	Список = ОписаниеСпискаЗначений(Поле, СсылкаОбъекта);
	Если Список <> Неопределено Тогда
		Возврат НайтиЗначениеВСписке(Список, Текст, Результат);
	КонецЕсли;

	Для Каждого ПолноеИмя Из Имена Цикл
		ОписаниеСсылки = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Ссылка = Неопределено;
		Если Метаданные.Перечисления.Содержит(ОписаниеСсылки) Тогда
			Ссылка = НайтиЗначениеПеречисления(ОписаниеСсылки, Текст);
		Иначе
			Попытка
				Менеджер = МенеджерПоПолномуИмени(ПолноеИмя);
				Ссылка = Менеджер.НайтиПоНаименованию(Текст, Истина);
			Исключение
				// Справочник без наименования — ищем в следующем типе поля.
				Ссылка = Неопределено;
			КонецПопытки;
		КонецЕсли;
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Результат.Успех = Истина;
			Результат.Комментарий = "";
			Возврат Ссылка;
		КонецЕсли;
	КонецЦикла;

	Результат.Комментарий = "Не найдено в " + СтрСоединить(Имена, ", ") + ": " + Текст
		+ ?(ЗначениеЗаполнено(КомментарийАдаптера), ". " + КомментарийАдаптера, "");
	Возврат Неопределено;

КонецФункции

// Типы поля, значения которых подбирает адаптер конфигурации. Пустой массив —
// адаптера нет или он этих типов не знает.
Функция ТипыПоляАдаптера(Поле)

	Типы = Новый Массив;
	ТипыАдаптера = AI_ПрименениеРекомендаций.ТипыАдаптераКонфигурации();
	Если ТипыАдаптера.Количество() = 0 Тогда
		Возврат Типы;
	КонецЕсли;
	Для Каждого ПолноеИмя Из ИменаТиповСсылки(Поле) Цикл
		ОписаниеСсылки = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если ОписаниеСсылки <> Неопределено И ТипОбрабатываетАдаптер(ОписаниеСсылки, ТипыАдаптера) Тогда
			Типы.Добавить(ОписаниеСсылки.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Возврат Типы;

КонецФункции

// Сравниваются объекты метаданных, а не строки: адаптер вправе назвать тип и
// «Справочник.ПолныеРоли», и «Catalog.ПолныеРоли».
Функция ТипОбрабатываетАдаптер(ОписаниеСсылки, ТипыАдаптера = Неопределено)

	Если ТипыАдаптера = Неопределено Тогда
		ТипыАдаптера = AI_ПрименениеРекомендаций.ТипыАдаптераКонфигурации();
	КонецЕсли;
	Для Каждого ИмяТипа Из ТипыАдаптера Цикл
		Если Метаданные.НайтиПоПолномуИмени(ИмяТипа) = ОписаниеСсылки Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Параметры обоих методов адаптера: какое поле какого объекта и какие его
// типы — адаптеру. Объект передается явно: строка табличной части карты не
// знает ни своей карты, ни ее объекта.
Функция ПараметрыАдаптера(Поле, ТипыАдаптера, ИмяОбъекта)

	Возврат Новый Структура("ПолноеИмяОбъекта,ТабличнаяЧасть,ПутьРеквизита,ТипыСсылки",
		ИмяОбъекта, СокрЛП(Поле.ТабличнаяЧасть), СокрЛП(Поле.ПутьРеквизита), ТипыАдаптера);

КонецФункции

// Объект, в реквизиты которого ложатся поля карты: карта называет его сама, а
// карта «для любого объекта» — через объект, с которым работает действие.
// Пустая строка — объект неизвестен, адаптер решит по типам поля.
Функция ИмяОбъектаКарты(Карта, СсылкаОбъекта = Неопределено)

	Имя = СокрЛП(Карта.ПолноеИмяМетаданных);
	Если (Не ЗначениеЗаполнено(Имя) Или Имя = "*") И ЗначениеЗаполнено(СсылкаОбъекта) Тогда
		Имя = СсылкаОбъекта.Метаданные().ПолноеИмя();
	КонецЕсли;
	Возврат ?(Имя = "*", "", Имя);

КонецФункции

Функция НайтиЗначениеАдаптером(Поле, ТипыАдаптера, Текст, ИмяОбъекта)

	Параметры = ПараметрыАдаптера(Поле, ТипыАдаптера, ИмяОбъекта);
	Параметры.Вставить("Текст", Текст);
	Параметры.Вставить("Значение", Неопределено);
	Параметры.Вставить("Найдено", Ложь);
	Параметры.Вставить("Комментарий", "");
	AI_ПрименениеРекомендаций.ВызватьАдаптерКонфигурации("НайтиЗначение", Параметры);
	Возврат Новый Структура("Найдено,Значение,Комментарий",
		Параметры.Найдено = Истина И ЗначениеЗаполнено(Параметры.Значение),
		Параметры.Значение,
		СокрЛП(Строка(Параметры.Комментарий)));

КонецФункции

// Что адаптер предлагает модели для поля: массив структур Представление,
// Пояснение. Кэшируется на вызов: схема и задание разговора спрашивают о
// каждом поле по разу.
Функция ЗначенияАдаптераПоля(Поле, ИмяОбъекта)

	Значения = Новый Массив;
	ТипыАдаптера = ТипыПоляАдаптера(Поле);
	Если ТипыАдаптера.Количество() = 0 Тогда
		Возврат Значения;
	КонецЕсли;
	Параметры = ПараметрыАдаптера(Поле, ТипыАдаптера, ИмяОбъекта);
	КлючКэша = СтрШаблон("Значения|%1|%2|%3|%4", Параметры.ПолноеИмяОбъекта, Параметры.ТабличнаяЧасть,
		Параметры.ПутьРеквизита, СтрСоединить(ТипыАдаптера, ","));
	Кэш = AI_ПовторноеИспользование.КэшАдаптераКонфигурации();
	Сохраненные = Кэш.Получить(КлючКэша);
	Если Сохраненные <> Неопределено Тогда
		Возврат Сохраненные;
	КонецЕсли;

	Параметры.Вставить("Значения", Новый Массив);
	AI_ПрименениеРекомендаций.ВызватьАдаптерКонфигурации("ЗначенияДляВыбора", Параметры);
	Если ТипЗнч(Параметры.Значения) = Тип("Массив") Тогда
		Для Каждого Значение Из Параметры.Значения Цикл
			Представление = "";
			Пояснение = "";
			Если ТипЗнч(Значение) = Тип("Структура") Тогда
				Значение.Свойство("Представление", Представление);
				Значение.Свойство("Пояснение", Пояснение);
			Иначе
				Представление = Значение;
			КонецЕсли;
			Представление = СокрЛП(Строка(Представление));
			Если ЗначениеЗаполнено(Представление) Тогда
				Значения.Добавить(Новый Структура("Представление,Пояснение",
					Представление, СокрЛП(Строка(Пояснение))));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Кэш.Вставить(КлючКэша, Значения);
	Возврат Значения;

КонецФункции

// Значение перечисления по тексту модели: по представлению значения, а на
// всякий случай — и по имени. Регистр и крайние пробелы не важны.
Функция НайтиЗначениеПеречисления(ОписаниеПеречисления, Текст)

	Искомое = НРег(СокрЛП(Текст));
	Менеджер = Перечисления[ОписаниеПеречисления.Имя];
	Для Каждого ОписаниеЗначения Из ОписаниеПеречисления.ЗначенияПеречисления Цикл
		Если НРег(ПредставлениеЗначенияПеречисления(ОписаниеЗначения)) = Искомое
			Или НРег(ОписаниеЗначения.Имя) = Искомое Тогда
			Возврат Менеджер[ОписаниеЗначения.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ПредставлениеЗначенияПеречисления(ОписаниеЗначения)

	Представление = СокрЛП(ОписаниеЗначения.Синоним);
	Возврат ?(ЗначениеЗаполнено(Представление), Представление, ОписаниеЗначения.Имя);

КонецФункции

// Перечень для enum схемы: наименования значений свойства-списка.
//
// Схема строится без объекта, поэтому одноименные свойства разных наборов
// дают общий перечень — какое из них относится к объекту, решит применение.
// Пустая строка в перечне оставляет модели право сказать «в документе этого
// нет»: иначе строгая схема заставила бы выбрать хоть что-то.
//
// Перечисление дает перечень всегда: значения закрыты, и модель должна назвать
// одно из них. Справочник — только если в карте отмечено «Выбирать из
// существующих»: для пользователей это правильно, а контрагента из договора в
// базе может не быть, и перечень заставил бы модель подменить его чужим.
//
// Возвращает пустой массив, если поле не список или значений так много, что
// перечень раздул бы запрос сильнее, чем помог бы.
Функция ДопустимыеЗначенияПоля(Поле, ИмяОбъекта)

	Перечень = Новый Массив;
	Наименования = Новый Массив;
	Список = ОписаниеСпискаЗначений(Поле, Неопределено);
	Если Список <> Неопределено Тогда
		Для Каждого Элемент Из ЗначенияСписка(Список) Цикл
			ДобавитьНаименование(Наименования, Элемент.Наименование);
		КонецЦикла;
	ИначеЕсли Поле.ТипЗначения <> Перечисления.AI_ТипЗначенияПоля.Ссылка
		Или Не НаименованияТиповСсылки(Поле, Наименования) Тогда
		Возврат Перечень;
	Иначе
		// Роли и автоподстановки ДО перечисляет адаптер: у ядра для них нет ни
		// наименований, ни способа их собрать.
		Для Каждого Значение Из ЗначенияАдаптераПоля(Поле, ИмяОбъекта) Цикл
			ДобавитьНаименование(Наименования, Значение.Представление);
		КонецЦикла;
	КонецЕсли;
	Если Наименования.Количество() = 0
		Или Наименования.Количество() > МаксимумЗначенийВПеречне() Тогда
		Возврат Перечень;
	КонецЕсли;

	Перечень.Добавить("");
	Для Каждого Наименование Из Наименования Цикл
		Перечень.Добавить(Наименование);
	КонецЦикла;
	Возврат Перечень;

КонецФункции

// Длинные списки (статьи КоАП, органы власти) выгоднее искать по
// наименованию: владелец значения при этом все равно проверяется.
Функция МаксимумЗначенийВПеречне()
	Возврат 100;
КонецФункции

// Собирает представления значений всех типов ссылки поля. Ложь — перечня не
// будет: у справочника не отмечен выбор из существующих либо значений больше
// предела. Неполный перечень хуже никакого: модель выбрала бы из того, что есть.
Функция НаименованияТиповСсылки(Поле, Наименования)

	ТипыАдаптера = AI_ПрименениеРекомендаций.ТипыАдаптераКонфигурации();
	Для Каждого ПолноеИмя Из ИменаТиповСсылки(Поле) Цикл
		ОписаниеСсылки = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если ОписаниеСсылки = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		// Значения этого типа перечислит адаптер конфигурации.
		Если ТипыАдаптера.Количество() > 0 И ТипОбрабатываетАдаптер(ОписаниеСсылки, ТипыАдаптера) Тогда
			Продолжить;
		КонецЕсли;
		Если Метаданные.Перечисления.Содержит(ОписаниеСсылки) Тогда
			Для Каждого ОписаниеЗначения Из ОписаниеСсылки.ЗначенияПеречисления Цикл
				ДобавитьНаименование(Наименования, ПредставлениеЗначенияПеречисления(ОписаниеЗначения));
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Если Не Поле.ВыбиратьИзСписка
			Или Не Метаданные.Справочники.Содержит(ОписаниеСсылки)
			Или ОписаниеСсылки.ДлинаНаименования = 0 Тогда
			Возврат Ложь;
		КонецЕсли;

		Условия = Новый Массив;
		Условия.Добавить("НЕ Значения.ПометкаУдаления");
		Если ЕстьГруппы(ОписаниеСсылки) Тогда
			Условия.Добавить("НЕ Значения.ЭтоГруппа");
		КонецЕсли;
		// Недействительные пользователи и прочие выключенные элементы — не варианты.
		Если ОписаниеСсылки.Реквизиты.Найти("Недействителен") <> Неопределено Тогда
			Условия.Добавить("НЕ Значения.Недействителен");
		КонецЕсли;
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ " + Формат(МаксимумЗначенийВПеречне() + 1, "ЧГ=0") + "
			|	Значения.Наименование КАК Наименование
			|ИЗ
			|	" + ОписаниеСсылки.ПолноеИмя() + " КАК Значения
			|ГДЕ
			|	" + СтрСоединить(Условия, " И ") + "
			|УПОРЯДОЧИТЬ ПО
			|	Значения.Наименование");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() > МаксимумЗначенийВПеречне() Тогда
			Возврат Ложь;
		КонецЕсли;
		Пока Выборка.Следующий() Цикл
			ДобавитьНаименование(Наименования, Выборка.Наименование);
		КонецЦикла;
	КонецЦикла;
	Возврат Наименования.Количество() <= МаксимумЗначенийВПеречне();

КонецФункции

Процедура ДобавитьНаименование(Наименования, Наименование)

	Текст = СокрЛП(Строка(Наименование));
	Если ЗначениеЗаполнено(Текст) И Наименования.Найти(Текст) = Неопределено Тогда
		Наименования.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

// Описание поля, значение которого — элемент списка значений свойства,
// то есть справочника, подчиненного плану видов характеристик свойств.
//
// Возвращает Неопределено для остальных полей, иначе структуру:
//   ПолноеИмя   - справочник значений из карты;
//   ИмяСвойства - наименование свойства из карты;
//   Владельцы   - Массив - чьи значения допустимы. Список бывает своим у
//                 свойства, а бывает общим с другим свойством — это
//                 ВладелецДополнительныхЗначений в БСП;
//   Причина     - почему свойство не определено однозначно.
Функция ОписаниеСпискаЗначений(Поле, СсылкаОбъекта)

	ИмяСвойства = СокрЛП(Поле.ДополнительныйРеквизит);
	Если Поле.ТипЗначения <> Перечисления.AI_ТипЗначенияПоля.Ссылка
		Или Не ЗначениеЗаполнено(ИмяСвойства) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Список — справочник, подчиненный плану видов характеристик. Типов у поля
	// бывает несколько (значения с иерархией и без), берем первый такой.
	ОписаниеСписка = Неопределено;
	ИмяВидаХарактеристик = "";
	Для Каждого ПолноеИмя Из ИменаТиповСсылки(Поле) Цикл
		Кандидат = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если Кандидат = Неопределено Или Не Метаданные.Справочники.Содержит(Кандидат) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Владелец Из Кандидат.Владельцы Цикл
			Если Метаданные.ПланыВидовХарактеристик.Содержит(Владелец) Тогда
				ОписаниеСписка = Кандидат;
				ИмяВидаХарактеристик = Владелец.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ОписаниеСписка <> Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ОписаниеСписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Если свойство однозначно не определилось, значение ищется среди всех
	// одноименных, а выбрать и проверить свойство предстоит применению.
	Поиск = НайтиДополнительныйРеквизит(ИмяВидаХарактеристик, ИмяСвойства, СсылкаОбъекта);
	Свойства = Поиск.Кандидаты;
	Если Поиск.Свойство <> Неопределено Тогда
		Свойства = Новый Массив;
		Свойства.Добавить(Поиск.Свойство);
	КонецЕсли;

	Владельцы = Новый Массив;
	Для Каждого Свойство Из Свойства Цикл
		ДобавитьБезПовтора(Владельцы, ВладелецЗначенийСвойства(Свойство));
	КонецЦикла;

	Возврат Новый Структура("ПолноеИмя,ИмяСвойства,Владельцы,Причина",
		ОписаниеСписка.ПолноеИмя(), ИмяСвойства, Владельцы, Поиск.Причина);

КонецФункции

// Значения списка, принадлежащие владельцам из описания.
// Возвращает таблицу: Ссылка, Наименование.
Функция ЗначенияСписка(Список)

	Если Список.Владельцы.Количество() = 0 Тогда
		Пустая = Новый ТаблицаЗначений;
		Пустая.Колонки.Добавить("Ссылка");
		Пустая.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
		Возврат Пустая;
	КонецЕсли;

	Условия = "Значения.Владелец В (&Владельцы) И НЕ Значения.ПометкаУдаления";
	Если ЕстьГруппы(Метаданные.НайтиПоПолномуИмени(Список.ПолноеИмя)) Тогда
		Условия = Условия + " И НЕ Значения.ЭтоГруппа";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Значения.Ссылка КАК Ссылка, Значения.Наименование КАК Наименование
		|ИЗ " + Список.ПолноеИмя + " КАК Значения
		|ГДЕ " + Условия + "
		|УПОРЯДОЧИТЬ ПО Наименование");
	Запрос.УстановитьПараметр("Владельцы", Список.Владельцы);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Значение списка по тексту модели: сначала дословно — так отвечает модель
// с перечнем в схеме, — потом без учета регистра и крайних пробелов.
Функция НайтиЗначениеВСписке(Список, Текст, Результат)

	Значения = ЗначенияСписка(Список);
	Найденное = Неопределено;
	Для Каждого Элемент Из Значения Цикл
		Если Элемент.Наименование = Текст Тогда
			Найденное = Элемент.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Найденное = Неопределено Тогда
		Искомое = НРег(СокрЛП(Текст));
		Для Каждого Элемент Из Значения Цикл
			Если НРег(СокрЛП(Элемент.Наименование)) = Искомое Тогда
				Найденное = Элемент.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Найденное <> Неопределено Тогда
		Результат.Успех = Истина;
		Возврат Найденное;
	КонецЕсли;
	Если Список.Владельцы.Количество() = 0 Тогда
		Результат.Комментарий = Список.Причина;
	Иначе
		Результат.Комментарий = СтрШаблон("Нет среди значений свойства «%1»: %2",
			Список.ИмяСвойства, Текст);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Кандидаты, входящие в наборы свойств объекта.
//
// Какие наборы у объекта, в БСП решает код конфигурации, а ядро общие модули
// БСП не вызывает. Поэтому наборы восстанавливаются по данным — так, как их
// заводит сама БСП:
//   - набор вида: реквизит объекта ссылается на вид, у вида свой набор
//     (ВидДокумента.НаборСвойств в Документообороте, ВидНоменклатуры
//     в Управлении торговлей);
//   - предопределенные наборы объекта: «Справочник_ВнутренниеДокументы» и
//     наборы с этим префиксом, например «Справочник_ВнутренниеДокументы_Общие».
// Группы наборов не в счет: на форму объекта свойства попадают только из
// наборов-элементов.
//
// Возвращает массив свойств либо Неопределено, если наборов в конфигурации нет.
Функция СвойстваНаборовОбъекта(ОписаниеВида, Ссылка, Кандидаты)

	РеквизитНабора = ОписаниеВида.Реквизиты.Найти("НаборСвойств");
	Если РеквизитНабора = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОписаниеНаборов = Неопределено;
	Для Каждого ТипНабора Из РеквизитНабора.Тип.Типы() Цикл
		ОписаниеТипа = Метаданные.НайтиПоТипу(ТипНабора);
		Если ОписаниеТипа <> Неопределено И Метаданные.Справочники.Содержит(ОписаниеТипа) Тогда
			ОписаниеНаборов = ОписаниеТипа;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ОписаниеНаборов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СоставНабора = ОписаниеНаборов.ТабличныеЧасти.Найти("ДополнительныеРеквизиты");
	Если СоставНабора = Неопределено Или СоставНабора.Реквизиты.Найти("Свойство") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Наборы = НаборыОбъекта(Ссылка, ОписаниеНаборов);
	Если Наборы.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Условия = Новый Массив;
	Условия.Добавить("Строки.Ссылка В (&Наборы)");
	Условия.Добавить("Строки.Свойство В (&Кандидаты)");
	Условия.Добавить("НЕ Строки.Ссылка.ПометкаУдаления");
	Если СоставНабора.Реквизиты.Найти("ПометкаУдаления") <> Неопределено Тогда
		// БСП не удаляет строку, когда свойство убирают из набора, а помечает.
		Условия.Добавить("НЕ Строки.ПометкаУдаления");
	КонецЕсли;
	Если ЕстьГруппы(ОписаниеНаборов) Тогда
		Условия.Добавить("НЕ Строки.Ссылка.ЭтоГруппа");
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Строки.Свойство КАК Свойство
		|ИЗ " + ОписаниеНаборов.ПолноеИмя() + ".ДополнительныеРеквизиты КАК Строки
		|ГДЕ " + СтрСоединить(Условия, " И "));
	Запрос.УстановитьПараметр("Наборы", Наборы);
	Запрос.УстановитьПараметр("Кандидаты", Кандидаты);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Свойство");

КонецФункции

// Наименования свойств, которые вообще бывают у объектов этого вида: из
// предопределенных наборов объекта и из наборов его видов (вид документа,
// вид номенклатуры) — то же, что НаборыОбъекта, но без конкретной ссылки.
//
// Возвращает массив наименований либо Неопределено, если наборов свойств в
// конфигурации нет и отбирать нечем.
Функция НаименованияСвойствОбъекта(ОписаниеОбъекта)

	ИмяВида = ИмяВидаХарактеристикСвойств(ОписаниеОбъекта);
	Если Не ЗначениеЗаполнено(ИмяВида) Тогда
		Возврат Неопределено;
	КонецЕсли;
	РеквизитНабора = Метаданные.ПланыВидовХарактеристик[ИмяВида].Реквизиты.Найти("НаборСвойств");
	Если РеквизитНабора = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОписаниеНаборов = Неопределено;
	Для Каждого ТипНабора Из РеквизитНабора.Тип.Типы() Цикл
		ОписаниеТипа = Метаданные.НайтиПоТипу(ТипНабора);
		Если ОписаниеТипа <> Неопределено И Метаданные.Справочники.Содержит(ОписаниеТипа) Тогда
			ОписаниеНаборов = ОписаниеТипа;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ОписаниеНаборов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СоставНабора = ОписаниеНаборов.ТабличныеЧасти.Найти("ДополнительныеРеквизиты");
	Если СоставНабора = Неопределено Или СоставНабора.Реквизиты.Найти("Свойство") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Наборы = Новый Массив;
	Префикс = СтрЗаменить(ОписаниеОбъекта.ПолноеИмя(), ".", "_");
	Менеджер = Справочники[ОписаниеНаборов.Имя];
	Для Каждого Имя Из ОписаниеНаборов.ПолучитьИменаПредопределенных() Цикл
		Если ЭтоИмяНабораОбъекта(Имя, Префикс) Тогда
			Попытка
				ДобавитьБезПовтора(Наборы, Менеджер[Имя]);
			Исключение
				// Предопределенного элемента может не оказаться в данных.
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Если ОписаниеНаборов.Реквизиты.Найти("ИмяПредопределенногоНабора") <> Неопределено Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Наборы.Ссылка КАК Ссылка, Наборы.ИмяПредопределенногоНабора КАК Имя
			|ИЗ " + ОписаниеНаборов.ПолноеИмя() + " КАК Наборы");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЭтоИмяНабораОбъекта(Выборка.Имя, Префикс) Тогда
				ДобавитьБезПовтора(Наборы, Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Наборы видов: у объекта бывают свойства любого из своих видов.
	ТипНабора = Тип("СправочникСсылка." + ОписаниеНаборов.Имя);
	Для Каждого Реквизит Из ОписаниеОбъекта.Реквизиты Цикл
		Для Каждого ТипВида Из Реквизит.Тип.Типы() Цикл
			ОписаниеВидаОбъекта = Метаданные.НайтиПоТипу(ТипВида);
			Если ОписаниеВидаОбъекта = Неопределено
				Или Не Метаданные.Справочники.Содержит(ОписаниеВидаОбъекта) Тогда
				Продолжить;
			КонецЕсли;
			НаборВида = ОписаниеВидаОбъекта.Реквизиты.Найти("НаборСвойств");
			Если НаборВида = Неопределено Или Не НаборВида.Тип.СодержитТип(ТипНабора) Тогда
				Продолжить;
			КонецЕсли;
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗЛИЧНЫЕ Виды.НаборСвойств КАК Набор
				|ИЗ " + ОписаниеВидаОбъекта.ПолноеИмя() + " КАК Виды
				|ГДЕ Виды.НаборСвойств <> &Пустой");
			Запрос.УстановитьПараметр("Пустой", Менеджер.ПустаяСсылка());
			Для Каждого Набор Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Набор") Цикл
				ДобавитьБезПовтора(Наборы, Набор);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Имена = Новый Массив;
	Если Наборы.Количество() = 0 Тогда
		Возврат Имена;
	КонецЕсли;
	Условия = Новый Массив;
	Условия.Добавить("Строки.Ссылка В (&Наборы)");
	Условия.Добавить("НЕ Строки.Ссылка.ПометкаУдаления");
	Если СоставНабора.Реквизиты.Найти("ПометкаУдаления") <> Неопределено Тогда
		Условия.Добавить("НЕ Строки.ПометкаУдаления");
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Строки.Свойство.Наименование КАК Наименование
		|ИЗ " + ОписаниеНаборов.ПолноеИмя() + ".ДополнительныеРеквизиты КАК Строки
		|ГДЕ " + СтрСоединить(Условия, " И "));
	Запрос.УстановитьПараметр("Наборы", Наборы);
	Для Каждого Наименование Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Наименование") Цикл
		ДобавитьБезПовтора(Имена, Наименование);
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Наборы свойств объекта, восстановленные по данным: см. СвойстваНаборовОбъекта.
Функция НаборыОбъекта(Ссылка, ОписаниеНаборов)

	Наборы = Новый Массив;
	ТипНабора = Тип("СправочникСсылка." + ОписаниеНаборов.Имя);
	ОписаниеОбъекта = Ссылка.Метаданные();

	Для Каждого Реквизит Из ОписаниеОбъекта.Реквизиты Цикл
		Для Каждого ТипВида Из Реквизит.Тип.Типы() Цикл
			ОписаниеВидаОбъекта = Метаданные.НайтиПоТипу(ТипВида);
			Если ОписаниеВидаОбъекта = Неопределено
				Или Не Метаданные.Справочники.Содержит(ОписаниеВидаОбъекта) Тогда
				Продолжить;
			КонецЕсли;
			НаборВида = ОписаниеВидаОбъекта.Реквизиты.Найти("НаборСвойств");
			Если НаборВида = Неопределено Или Не НаборВида.Тип.СодержитТип(ТипНабора) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Вид = Ссылка[Реквизит.Имя];
				Если ТипЗнч(Вид) = ТипВида И ЗначениеЗаполнено(Вид) Тогда
					ДобавитьБезПовтора(Наборы, Вид.НаборСвойств);
				КонецЕсли;
			Исключение
				// Объект еще не записан: вида, а с ним и набора вида, у него нет.
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	// Прежние версии БСП задают наборы объекта предопределенными элементами,
	// БСП 3 — реквизитом ИмяПредопределенногоНабора. Смотрим оба места.
	Префикс = СтрЗаменить(ОписаниеОбъекта.ПолноеИмя(), ".", "_");
	Менеджер = Справочники[ОписаниеНаборов.Имя];
	Для Каждого Имя Из ОписаниеНаборов.ПолучитьИменаПредопределенных() Цикл
		Если ЭтоИмяНабораОбъекта(Имя, Префикс) Тогда
			Попытка
				ДобавитьБезПовтора(Наборы, Менеджер[Имя]);
			Исключение
				// Предопределенного элемента может не оказаться в данных.
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Если ОписаниеНаборов.Реквизиты.Найти("ИмяПредопределенногоНабора") <> Неопределено Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ Наборы.Ссылка КАК Ссылка, Наборы.ИмяПредопределенногоНабора КАК Имя
			|ИЗ " + ОписаниеНаборов.ПолноеИмя() + " КАК Наборы");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЭтоИмяНабораОбъекта(Выборка.Имя, Префикс) Тогда
				ДобавитьБезПовтора(Наборы, Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Наборы;

КонецФункции

Функция ЭтоИмяНабораОбъекта(Имя, Префикс)
	Текст = ВРег(СокрЛП(Имя));
	Образец = ВРег(Префикс);
	Возврат Текст = Образец Или СтрНачинаетсяС(Текст, Образец + "_");
КонецФункции

Функция ЕстьГруппы(ОписаниеСправочника)
	Возврат ОписаниеСправочника <> Неопределено
		И ОписаниеСправочника.Иерархический
		И ОписаниеСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
КонецФункции

// Чьи значения выбирает свойство: свой список или общий с другим свойством.
Функция ВладелецЗначенийСвойства(Свойство)
	Если Свойство.Метаданные().Реквизиты.Найти("ВладелецДополнительныхЗначений") <> Неопределено
		И ЗначениеЗаполнено(Свойство.ВладелецДополнительныхЗначений) Тогда
		Возврат Свойство.ВладелецДополнительныхЗначений;
	КонецЕсли;
	Возврат Свойство;
КонецФункции

Процедура ДобавитьБезПовтора(Массив, Значение)
	Если ЗначениеЗаполнено(Значение) И Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

Функция ЗаписатьJSONВСтроку(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

#КонецОбласти
