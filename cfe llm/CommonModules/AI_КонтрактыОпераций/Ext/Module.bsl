
Функция ПрочитатьJSONТекст(Текст) Экспорт
	Если СтрДлина(Текст) > 1000000 Тогда
		ВызватьИсключение "Размер JSON превышает 1 МБ символов.";
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция ПроверитьСхему(Текст) Экспорт
	Если СтрДлина(Текст) > 100000 Тогда
		ВызватьИсключение "Схема ответа превышает 100000 символов.";
	КонецЕсли;
	Схема = ПрочитатьJSONТекст(Текст);
	ПроверитьУзелСхемы(Схема, 0);
	Если Схема.Получить("type") <> "object" Тогда
		ВызватьИсключение "Корнем схемы ответа должен быть object.";
	КонецЕсли;
	Возврат Схема;
КонецФункции

// Сценарий определяет контракт, но не предоставляет дополнительных прав к агенту.
Функция ПодготовитьПараметры(Исходные) Экспорт
	Параметры = Новый Структура;
	Для Каждого Поле Из Исходные Цикл
		Параметры.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	Параметры.Удалить("КодОбработчика");
	Параметры.Удалить("ВерсияКонтракта");
	Параметры.Удалить("СхемаОтветаJSON");
	Сценарий = Неопределено;
	Если Не Параметры.Свойство("Сценарий", Сценарий) Или Не ЗначениеЗаполнено(Сценарий) Тогда
		Возврат Параметры;
	КонецЕсли;
	Если ТипЗнч(Сценарий) <> Тип("СправочникСсылка.AI_Сценарии") Тогда
		ВызватьИсключение "Сценарий должен быть ссылкой справочника сценариев.";
	КонецЕсли;
	Если Сценарий.ПометкаУдаления Или Не Сценарий.Активен Тогда
		ВызватьИсключение "Сценарий недоступен для выполнения.";
	КонецЕсли;
	Если Сценарий.ВерсияКонтракта <= 0 Тогда
		ВызватьИсключение "Укажите положительную версию контракта сценария.";
	КонецЕсли;
	Параметры.Вставить("КодСценария", Сценарий.Код);
	Параметры.Вставить("ВерсияКонтракта", Сценарий.ВерсияКонтракта);
	Параметры.Вставить("СхемаОтветаJSON", Сценарий.СхемаОтветаJSON);
	Параметры.Вставить("КодОбработчика", Сценарий.КодОбработчика);
	Параметры.Вставить("РазрешитьПовтор", Сценарий.РазрешитьПовтор);
	Параметры.Вставить("МаксимумПопыток", Макс(1, Сценарий.МаксимумПопыток));
	Для Каждого Имя Из СтрРазделить("Агент,Провайдер,Модель,ТипAPI", ",") Цикл
		Значение = Неопределено;
		Если Не Параметры.Свойство(Имя, Значение) Или Не ЗначениеЗаполнено(Значение) Тогда
			Параметры.Вставить(Имя, Сценарий[Имя]);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Сценарий.СхемаОтветаJSON) Тогда
		ПроверитьСхему(Сценарий.СхемаОтветаJSON);
	КонецЕсли;
	Возврат Параметры;
КонецФункции

Процедура ПроверитьУзелСхемы(Схема, Глубина)
	Если Глубина > 16 Или ТипЗнч(Схема) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Недопустимая структура или глубина JSON Schema.";
	КонецЕсли;
	Для Каждого Поле Из Схема Цикл
		Если СтрНайти(",type,properties,required,additionalProperties,items,enum,description,", "," + Поле.Ключ + ",") = 0 Тогда
			ВызватьИсключение "Неподдерживаемое ключевое слово схемы: " + Поле.Ключ;
		КонецЕсли;
	КонецЦикла;
	Тип = Схема.Получить("type");
	Если ТипЗнч(Тип) <> Тип("Строка") Тогда
		ВызватьИсключение "type должен быть строкой.";
	КонецЕсли;
	Для Каждого Поле Из Схема Цикл
		Если (Поле.Ключ = "properties" Или Поле.Ключ = "required" Или Поле.Ключ = "additionalProperties") И Тип <> "object"
			Или Поле.Ключ = "items" И Тип <> "array" Тогда
			ВызватьИсключение "Ключевое слово не соответствует типу схемы: " + Поле.Ключ;
		КонецЕсли;
		Если Поле.Ключ = "description" И ТипЗнч(Поле.Значение) <> Тип("Строка") Тогда
			ВызватьИсключение "description должен быть строкой.";
		КонецЕсли;
		Если Поле.Ключ = "enum" И ТипЗнч(Поле.Значение) <> Тип("Массив") Тогда
			ВызватьИсключение "enum должен быть массивом.";
		КонецЕсли;
	КонецЦикла;
	Если Тип = "object" Тогда
		Свойства = Схема.Получить("properties");
		Обязательные = Схема.Получить("required");
		Если ТипЗнч(Свойства) <> Тип("Соответствие")
			Или ТипЗнч(Обязательные) <> Тип("Массив")
			Или Схема.Получить("additionalProperties") <> Ложь Тогда
			ВызватьИсключение "Для object нужны properties, required и additionalProperties=false.";
		КонецЕсли;
		Если Обязательные.Количество() <> Свойства.Количество() Тогда
			ВызватьИсключение "Строгая схема требует включить все свойства в required.";
		КонецЕсли;
		Для Каждого Свойство Из Свойства Цикл
			Если Обязательные.Найти(Свойство.Ключ) = Неопределено Тогда
				ВызватьИсключение "Свойство отсутствует в required: " + Свойство.Ключ;
			КонецЕсли;
			ПроверитьУзелСхемы(Свойство.Значение, Глубина + 1);
		КонецЦикла;
	ИначеЕсли Тип = "array" Тогда
		ПроверитьУзелСхемы(Схема.Получить("items"), Глубина + 1);
	ИначеЕсли СтрНайти(",string,number,integer,boolean,null,", "," + Тип + ",") = 0 Тогда
		ВызватьИсключение "Неподдерживаемый тип схемы: " + Тип;
	КонецЕсли;
	Варианты = Схема.Получить("enum");
	Если Варианты <> Неопределено Тогда
		Если ТипЗнч(Варианты) <> Тип("Массив") Тогда
			ВызватьИсключение "enum должен быть массивом.";
		КонецЕсли;
		Если Варианты.Количество() = 0 Или Тип = "object" Или Тип = "array" Тогда
			ВызватьИсключение "enum поддерживается только для непустого набора скалярных значений.";
		КонецЕсли;
		БазоваяСхема = Новый Соответствие;
		БазоваяСхема.Вставить("type", Тип);
		Для Каждого Вариант Из Варианты Цикл
			ПроверитьЗначение(Вариант, БазоваяСхема, "$schema.enum", Глубина);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ДоставитьРезультат(ИдентификаторОперации) Экспорт
	Если ПривилегированныйРежим() Или ТранзакцияАктивна() Тогда
		ВызватьИсключение "Доставка должна выполняться в отдельном непривилегированном контексте.";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Контракт = СлужебнаяЗаписьДоставки(ИдентификаторОперации);
		Если Контракт = Неопределено Тогда
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;
		Обработан = Ложь;
		AI_ОбработчикиРезультатовПереопределяемый.ОбработатьРезультат(Контракт.КодОбработчика, Контракт, Обработан);
		Если Не Обработан Тогда
			ВызватьИсключение "Код обработчика не зарегистрирован в интеграционном модуле.";
		КонецЕсли;
		СлужебнаяЗаписьДоставки(ИдентификаторОперации, "Доставлен");
		ЗафиксироватьТранзакцию();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОтменитьТранзакцию();
		НачатьТранзакцию();
		Попытка
			СлужебнаяЗаписьДоставки(ИдентификаторОперации, "Ошибка", ТекстОшибки);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецПопытки;
КонецПроцедуры

Функция СлужебнаяЗаписьДоставки(ИдентификаторОперации, Статус = "", Ошибка = "")
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.AI_АгентскиеОперации");
		Элемент.УстановитьЗначение("ИдентификаторОперации", ИдентификаторОперации);
		Блокировка.Заблокировать();
		Запись = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторОперации = ИдентификаторОперации;
		Запись.Прочитать();
		Контракт = Неопределено;
		Если Запись.Выбран()
			И Запись.ИдентификаторПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор
			И Запись.Статус = Перечисления.AI_СтатусАгентскойОперации.Завершена
			И Не Запись.ДанныеОчищены И Запись.СтатусДоставки = "Ожидает"
			И ЗначениеЗаполнено(Запись.КодОбработчика) Тогда
			Контракт = Новый Структура;
			Для Каждого Имя Из СтрРазделить("ИдентификаторОперации,ИдентификаторКорреляции,КодСценария,КодОбработчика,ВерсияКонтракта,Источник,ТипИсточника,КлючИсточника,КонтекстJSON,Результат", ",") Цикл
				Контракт.Вставить(Имя, Запись[Имя]);
			КонецЦикла;
			Если ЗначениеЗаполнено(Статус) Тогда
				Запись.СтатусДоставки = Статус;
				Запись.ОшибкаДоставки = Ошибка;
				Запись.Версия = Запись.Версия + 1;
				Запись.Записать();
			КонецЕсли;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	Возврат Контракт;
КонецФункции

Процедура ПовторитьДоставку(ИдентификаторОперации) Экспорт
	ИсходныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		AI_ДиспетчерОпераций.ЗаблокироватьОчередь();
		Запись = РегистрыСведений.AI_АгентскиеОперации.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторОперации = ИдентификаторОперации;
		Запись.Прочитать();
		Если Не Запись.Выбран()
			Или Запись.ИдентификаторПользователя <> ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор Тогда
			ВызватьИсключение "Операция недоступна текущему пользователю.";
		КонецЕсли;
		Если Запись.ДанныеОчищены Или Запись.СтатусДоставки <> "Ошибка"
			Или Запись.Статус <> Перечисления.AI_СтатусАгентскойОперации.Завершена Тогда
			ВызватьИсключение "Повтор доставки недоступен для текущего состояния.";
		КонецЕсли;
		Запись.СтатусДоставки = "Ожидает";
		Запись.ОшибкаДоставки = "";
		Запись.Версия = Запись.Версия + 1;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(ИсходныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйРежим);
	AI_ДиспетчерОпераций.ОбработатьОчередь();
КонецПроцедуры

Функция ПроверитьОтвет(Текст, СхемаJSON) Экспорт
	Схема = ПроверитьСхему(СхемаJSON);
	Данные = ПрочитатьJSONТекст(Текст);
	ПроверитьЗначение(Данные, Схема, "$", 0);
	Возврат Данные;
КонецФункции

Процедура ПроверитьЗначение(Данные, Схема, Путь, Глубина)
	Если Глубина > 16 Тогда
		ВызватьИсключение "Превышена глубина ответа: " + Путь;
	КонецЕсли;
	Тип = Схема.Получить("type");
	Корректно = Ложь;
	Если Тип = "object" Тогда
		Корректно = ТипЗнч(Данные) = Тип("Соответствие");
	ИначеЕсли Тип = "array" Тогда
		Корректно = ТипЗнч(Данные) = Тип("Массив");
	ИначеЕсли Тип = "string" Тогда
		Корректно = ТипЗнч(Данные) = Тип("Строка");
	ИначеЕсли Тип = "number" Или Тип = "integer" Тогда
		Корректно = ТипЗнч(Данные) = Тип("Число");
		Если Корректно И Тип = "integer" Тогда
			Корректно = Данные = Цел(Данные);
		КонецЕсли;
	ИначеЕсли Тип = "boolean" Тогда
		Корректно = ТипЗнч(Данные) = Тип("Булево");
	ИначеЕсли Тип = "null" Тогда
		Корректно = Данные = Неопределено Или ТипЗнч(Данные) = Тип("Null");
	КонецЕсли;
	Если Не Корректно Тогда
		ВызватьИсключение "Ответ не соответствует схеме: " + Путь + ", ожидается " + Тип;
	КонецЕсли;
	Если Тип = "object" Тогда
		Свойства = Схема.Получить("properties");
		Если Данные.Количество() <> Свойства.Количество() Тогда
			ВызватьИсключение "Набор свойств ответа не соответствует схеме: " + Путь;
		КонецЕсли;
		Для Каждого Поле Из Данные Цикл
			Узел = Свойства.Получить(Поле.Ключ);
			Если Узел = Неопределено Тогда
				ВызватьИсключение "Неизвестное свойство ответа: " + Путь + "." + Поле.Ключ;
			КонецЕсли;
			ПроверитьЗначение(Поле.Значение, Узел, Путь + "." + Поле.Ключ, Глубина + 1);
		КонецЦикла;
	ИначеЕсли Тип = "array" Тогда
		Для Каждого Элемент Из Данные Цикл
			ПроверитьЗначение(Элемент, Схема.Получить("items"), Путь + "[]", Глубина + 1);
		КонецЦикла;
	КонецЕсли;
	Варианты = Схема.Получить("enum");
	Если Варианты <> Неопределено И Варианты.Найти(Данные) = Неопределено Тогда
		ВызватьИсключение "Значение не входит в enum: " + Путь;
	КонецЕсли;
КонецПроцедуры
