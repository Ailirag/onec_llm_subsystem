{"Индикатор",0,0,"Индикатор","Перем мКоличествоИтерацийПроцесса;
Перем мНомерТекущейИтерацийПроцесса;

///////////////////////////////////////////////////////////////////////////////
// УПРАВЛЕНИЕ ИНДИКАТОРОМ

//<<НомерЗадачиСППР aliev_rs <?"""", ДатаВремя, ""ДФ='dd.MM.yyyy'"">
Процедура ИнициализироватьИндикатор(КоличествоИтерацийПроцесса)
		
	Если КоличествоИтерацийПроцесса = 0 Тогда 
		мКоличествоИтерацийПроцесса = 100;	
	Иначе
		мКоличествоИтерацийПроцесса	= КоличествоИтерацийПроцесса;
	КонецЕсли;
	
	мНомерТекущейИтерацийПроцесса = 0;
	
	ИндикаторВыполнения = 0;
	
КонецПроцедуры

//<<НомерЗадачиСППР aliev_rs <?"""", ДатаВремя, ""ДФ='dd.MM.yyyy'"">
Процедура ВыполнитьШагИндикации()
	
	мНомерТекущейИтерацийПроцесса = мНомерТекущейИтерацийПроцесса + 1;	
	
	ТекущийПроцентВыполенния =  Цел(мНомерТекущейИтерацийПроцесса / мКоличествоИтерацийПроцесса * 100);
	
	Если ТекущийПроцентВыполенния <> ИндикаторВыполнения И ТекущийПроцентВыполенния<=100 Тогда
		ИндикаторВыполнения = ТекущийПроцентВыполенния;	
	КонецЕсли;
	
КонецПроцедуры

//<<НомерЗадачиСППР aliev_rs <?"""", ДатаВремя, ""ДФ='dd.MM.yyyy'"">
Процедура СброситьИндикатор()
		
	ИндикаторВыполнения	 = 0;
	
	мНомерТекущейИтерацийПроцесса	 = 0;
	мКоличествоИтерацийПроцесса		 = 100;
	
КонецПроцедуры

//<<НомерЗадачиСППР aliev_rs <?"""", ДатаВремя, ""ДФ='dd.MM.yyyy'"">
Процедура УстановитьИндикаторВМаксимальноеЗначение()
	
	ИндикаторВыполнения = 100;	
	мНомерТекущейИтерацийПроцесса	 = 100;
	мКоличествоИтерацийПроцесса		 = 100;
	
КонецПроцедуры
"}
