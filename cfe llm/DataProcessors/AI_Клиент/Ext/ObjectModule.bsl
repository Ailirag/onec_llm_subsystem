//		ОбогатитьСообщенияДополнительнымКонтекстом(Сообщения);
//	КонецЕсли;
//	
//	// Сообщение пользователя — всегда
//	Сообщения.Добавить(OPI_OpenAI.ПолучитьСообщениеПользователя(_ТекстовыйЗапрос));
//	
