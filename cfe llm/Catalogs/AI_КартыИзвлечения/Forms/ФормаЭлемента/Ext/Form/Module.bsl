// Карта — единственное описание полей: из нее выводится и схема ответа модели,
// и раскладка значений по реквизитам.
//
// Схема ответа хранится в сценарии: на момент выполнения источник правды —
// сценарий. Поэтому при записи карты схема переносится в сценарии мест, которые
// ее используют, — забытая кнопка раньше молча оставляла модель без новых полей.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.СостояниеСхемы.РастягиватьПоГоризонтали = Истина;
	Элементы.СостояниеСхемы.АвтоМаксимальнаяШирина = Ложь;
	// Подсказка модели многострочная, и ячейка растягивает каждую строку карты
	// втрое: на экран влезает пять полей из двадцати. Полный текст виден при
	// редактировании ячейки.
	Элементы.Подсказка.МногострочныйРежим = Ложь;
	ОбновитьСпискиВыбора();
	ОбновитьСостояниеСхемы();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	Если ТекущийОбъект.Активна И Не ТекущийОбъект.ПометкаУдаления Тогда
		Попытка
			Синхронизация = AI_ИзвлечениеРеквизитов.СинхронизироватьСхемуСценариев(ТекущийОбъект.Ссылка);
			Если Синхронизация.Обновлено > 0 Тогда
				Сообщить(СтрШаблон("Схема ответа перенесена в сценарии: %1.", Синхронизация.Обновлено));
			КонецЕсли;
		Исключение
			Сообщить("Схема ответа не перенесена в сценарии: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	ОбновитьСостояниеСхемы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолноеИмяМетаданныхПриИзменении(Элемент)

	ОбновитьСпискиВыбора();

КонецПроцедуры

// Полное имя метаданных выбирается из объектов конфигурации: опечатка в нем
// оставила бы без подсказок табличные части и дополнительные реквизиты.
&НаКлиенте
Процедура ПолноеИмяМетаданныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Варианты = ВариантыОбъектовНаСервере();
	Варианты.ПоказатьВыборЭлемента(
		Новый ОписаниеОповещения("ВыборОбъектаЗавершение", ЭтотОбъект),
		"Выберите объект",
		Варианты.НайтиПоЗначению(Объект.ПолноеИмяМетаданных));

КонецПроцедуры

&НаКлиенте
Процедура ВыборОбъектаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.ПолноеИмяМетаданных = ВыбранныйЭлемент.Значение;
	Модифицированность = Истина;
	ОбновитьСпискиВыбора();

КонецПроцедуры

// Объектов в конфигурации сотни: по мере ввода подбираются подходящие по
// названию, в поле ложится полное имя выбранного.
&НаКлиенте
Процедура ПолноеИмяМетаданныхАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Если СтрДлина(СокрЛП(Текст)) < 2 Или СтрНайти(Текст, ".") > 0 Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = ПодходящиеОбъектыНаСервере(Текст);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодходящиеОбъектыНаСервере(Текст)

	Возврат AI_ИнтерфейсныеСценарии.ВариантыОбъектовМетаданных(Текст);

КонецФункции

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СинхронизироватьСхемуОбработка(Команда)

	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		Сообщить("Сначала запишите карту.");
		Возврат;
	КонецЕсли;

	Результат = СинхронизироватьСхемуНаСервере();
	Для Каждого Сообщение Из Результат.Сообщения Цикл
		Сообщить(Сообщение);
	КонецЦикла;
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Сообщить(Результат.Ошибка);
		Возврат;
	КонецЕсли;
	Сообщить(СтрШаблон(
		"Сценариев обновлено: %1, уже совпадало: %2.",
		Результат.Обновлено,
		Результат.Пропущено));

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСхемуОбработка(Команда)

	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		Сообщить("Сначала запишите карту.");
		Возврат;
	КонецЕсли;

	Схема = ПолучитьСхемуНаСервере();
	Если ЗначениеЗаполнено(Схема.Ошибка) Тогда
		Сообщить(Схема.Ошибка);
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, Схема.Текст);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СинхронизироватьСхемуНаСервере()

	Результат = Новый Структура("Обновлено,Пропущено,Сообщения,Ошибка",
		0, 0, Новый Массив, "");
	Попытка
		Синхронизация = AI_ИзвлечениеРеквизитов.СинхронизироватьСхемуСценариев(Объект.Ссылка);
		ЗаполнитьЗначенияСвойств(Результат, Синхронизация);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;
	ОбновитьСостояниеСхемы();
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ВариантыОбъектовНаСервере()

	Варианты = AI_ИнтерфейсныеСценарии.ВариантыОбъектовМетаданных();
	Варианты.Вставить(0, "*", "Любой объект (*)");
	Возврат Варианты;

КонецФункции

// Табличные части и свойства берутся у объекта, к которому применима карта.
// Список подсказывает, но не ограничивает ввод: объекта может еще не быть в
// этой базе, а карта переносится пакетом.
&НаСервере
Процедура ОбновитьСпискиВыбора()

	СписокТабличныхЧастей = Элементы.ТабличнаяЧасть.СписокВыбора;
	СписокСвойств = Элементы.ДополнительныйРеквизит.СписокВыбора;
	СписокТабличныхЧастей.Очистить();
	СписокСвойств.Очистить();

	Варианты = AI_ИзвлечениеРеквизитов.ВариантыНастройкиКарты(Объект.ПолноеИмяМетаданных);
	Для Каждого Вариант Из Варианты.ТабличныеЧасти Цикл
		СписокТабличныхЧастей.Добавить(Вариант.Имя, Вариант.Представление);
	КонецЦикла;
	Для Каждого Вариант Из Варианты.ДополнительныеРеквизиты Цикл
		СписокСвойств.Добавить(Вариант.Имя, Вариант.Представление);
	КонецЦикла;

КонецПроцедуры

// Совпадает ли схема ответа в сценариях с картой. Видно сразу при открытии:
// отставшая схема — это поля, о которых модель просто не узнает.
&НаСервере
Процедура ОбновитьСостояниеСхемы()

	Если Объект.Ссылка.Пустая() Тогда
		Элементы.СостояниеСхемы.Заголовок = "Схема ответа перенесется в сценарии при записи карты.";
		Элементы.СостояниеСхемы.ЦветТекста = Новый Цвет(90, 90, 90);
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Места.Сценарий КАК Сценарий
		|ИЗ
		|	Справочник.AI_МестаЗапускаСценариев КАК Места
		|ГДЕ
		|	Места.КартаИзвлечения = &Карта
		|	И НЕ Места.ПометкаУдаления
		|	И Места.Сценарий <> ЗНАЧЕНИЕ(Справочник.AI_Сценарии.ПустаяСсылка)");
	Запрос.УстановитьПараметр("Карта", Объект.Ссылка);
	Сценарии = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сценарий");
	Если Сценарии.Количество() = 0 Тогда
		Элементы.СостояниеСхемы.Заголовок = "Карту не использует ни одно место запуска.";
		Элементы.СостояниеСхемы.ЦветТекста = Новый Цвет(90, 90, 90);
		Возврат;
	КонецЕсли;

	Отстает = Новый Массив;
	Совпадает = Новый Массив;
	Для Каждого Сценарий Из Сценарии Цикл
		Если AI_ИзвлечениеРеквизитов.СхемаСценарияОтстает(Объект.Ссылка, Сценарий) Тогда
			Отстает.Добавить(Строка(Сценарий));
		Иначе
			Совпадает.Добавить(Строка(Сценарий));
		КонецЕсли;
	КонецЦикла;

	Если Отстает.Количество() = 0 Тогда
		Элементы.СостояниеСхемы.Заголовок = "Схема ответа совпадает со сценариями: "
			+ СтрСоединить(Совпадает, ", ") + ".";
		Элементы.СостояниеСхемы.ЦветТекста = Новый Цвет(0, 110, 40);
	Иначе
		Элементы.СостояниеСхемы.Заголовок = "Схема ответа отстает от карты в сценариях: "
			+ СтрСоединить(Отстает, ", ")
			+ ". Запишите карту или нажмите «Записать схему в сценарии».";
		Элементы.СостояниеСхемы.ЦветТекста = Новый Цвет(170, 40, 30);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьСхемуНаСервере()

	Результат = Новый Структура("Текст,Ошибка", "", "");
	Попытка
		Результат.Текст = AI_ИзвлечениеРеквизитов.СформироватьСхемуОтвета(Объект.Ссылка);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти
