Функция ВыполнитьИнструментСТрассировкой(Знач ИмяИнструмента, Знач Аргументы, Знач Состояние)

	Если ОтменаАгентскойОперацииЗапрошена() Тогда
		РезультатИнструмента = Новый Структура(
			"ok,error",
			Ложь,
			"Операция отменена пользователем.");
		ДобавитьШагАгента(Состояние, ИмяИнструмента, Аргументы, РезультатИнструмента, 0);
		Возврат РезультатИнструмента;
	КонецЕсли;

	ИдентификаторШагаОперации = Неопределено;
	Если ЗначениеЗаполнено(_ИдентификаторАгентскойОперации) Тогда
		Попытка
			ИдентификаторШагаОперации = AI_АгентскиеОперацииСервер.ЗафиксироватьНачалоШага(
				_ИдентификаторАгентскойОперации,
				Состояние.НомерШага,
				ИмяИнструмента,
				СериализоватьДляТрассы(Аргументы));
		Исключение
			// Сбой технической трассы не должен прерывать ответ модели.
		КонецПопытки;
	КонецЕсли;

	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		РезультатИнструмента = AI_ИнструментыАгента.ВыполнитьИнструмент(
			ИмяИнструмента,
			Аргументы,
			_ПрофильДоступаКДанным,
			Состояние);
	Исключение
		РезультатИнструмента = Новый Структура(
			"ok,error",
			Ложь,
			"Ошибка выполнения инструмента: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала;
	ДобавитьШагАгента(
		Состояние,
		ИмяИнструмента,
		Аргументы,
		РезультатИнструмента,
		ДлительностьМс,
		ИдентификаторШагаОперации);

	Возврат РезультатИнструмента;

КонецФункции

Процедура ДобавитьШагАгента(
		Знач Состояние,
		Знач ИмяИнструмента,
		Знач Аргументы,
		Знач РезультатИнструмента,
		Знач ДлительностьМс,
		Знач ИдентификаторШагаОперации = Неопределено)

	Успешно = Ложь;
	Попытка
		Успешно = РезультатИнструмента.ok;
	Исключение
	КонецПопытки;

	ТекстАргументов = СериализоватьДляТрассы(Аргументы);
	ТекстРезультата = СериализоватьДляТрассы(РезультатИнструмента);
	ШагиАгента.Добавить(Новый Структура(
		"НомерШага,Инструмент,Статус,ДлительностьМс,Запрос,Результат",
		Состояние.НомерШага,
		ИмяИнструмента,
		?(Успешно, "Выполнено", "Ошибка"),
		ДлительностьМс,
		ТекстАргументов,
		ТекстРезультата));

	Если ЗначениеЗаполнено(_ИдентификаторАгентскойОперации) Тогда
		Попытка
			Если ЗначениеЗаполнено(ИдентификаторШагаОперации) Тогда
				AI_АгентскиеОперацииСервер.ЗавершитьШаг(
					_ИдентификаторАгентскойОперации,
					ИдентификаторШагаОперации,
					Успешно,
					ДлительностьМс,
					ТекстРезультата);
			Иначе
				AI_АгентскиеОперацииСервер.ЗафиксироватьЗавершенныйШаг(
					_ИдентификаторАгентскойОперации,
					Состояние.НомерШага,
					ИмяИнструмента,
					Успешно,
					ДлительностьМс,
					ТекстАргументов,
					ТекстРезультата);
			КонецЕсли;
		Исключение
			// Сбой технической трассы не должен прерывать ответ модели.
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция ОтменаАгентскойОперацииЗапрошена()

	Если Не ЗначениеЗаполнено(_ИдентификаторАгентскойОперации) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат AI_АгентскиеОперацииСервер.ОтменаЗапрошена(
			_ИдентификаторАгентскойОперации);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Процедура ЗафиксироватьЭтапАгентскойОперации(ТекстЭтапа)

	Если Не ЗначениеЗаполнено(_ИдентификаторАгентскойОперации) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		AI_АгентскиеОперацииСервер.ЗафиксироватьЭтап(
			_ИдентификаторАгентскойОперации,
			ТекстЭтапа);
	Исключение
		// Сбой технической трассы не должен прерывать ответ модели.
	КонецПопытки;

КонецПроцедуры

