
Функция Получить(Знач ПрофильДоступа) Экспорт

	Политика = ПолитикаПоУмолчанию();
	Если Не ЗначениеЗаполнено(ПрофильДоступа) Тогда
		Возврат Политика;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|    Профили.РазрешитьВыполнениеЗапросов КАК РазрешитьВыполнениеЗапросов,
		|    Профили.МаксимумШагов КАК МаксимумШагов,
		|    Профили.МаксимумЗапросовКДанным КАК МаксимумЗапросовКДанным,
		|    Профили.МаксимумСтрокРезультата КАК МаксимумСтрокРезультата,
		|    Профили.МаксимальнаяДлинаЗапроса КАК МаксимальнаяДлинаЗапроса
		|ИЗ
		|    Справочник.AI_ПрофилиДоступаКДанным КАК Профили
		|ГДЕ
		|    Профили.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    РазрешенныеОбъекты.ПолноеИмя КАК ПолноеИмя,
		|    РазрешенныеОбъекты.ТребоватьПериод КАК ТребоватьПериод
		|ИЗ
		|    Справочник.AI_ПрофилиДоступаКДанным.РазрешенныеОбъекты КАК РазрешенныеОбъекты
		|ГДЕ
		|    РазрешенныеОбъекты.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    ОграниченныеПоля.ПолноеИмяОбъекта КАК ПолноеИмяОбъекта,
		|    ОграниченныеПоля.ИмяПоля КАК ИмяПоля
		|ИЗ
		|    Справочник.AI_ПрофилиДоступаКДанным.ОграниченныеПоля КАК ОграниченныеПоля
		|ГДЕ
		|    ОграниченныеПоля.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ПрофильДоступа);

	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[0].Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Политика;
	КонецЕсли;

	Политика.Профиль = ПрофильДоступа;
	Политика.РазрешитьВыполнениеЗапросов = Выборка.РазрешитьВыполнениеЗапросов;
	Политика.МаксимумШагов = Ограничить(Выборка.МаксимумШагов, 6, 1, 20);
	Политика.МаксимумЗапросовКДанным = Ограничить(Выборка.МаксимумЗапросовКДанным, 4, 1, 10);
	Политика.МаксимумСтрокРезультата = Ограничить(Выборка.МаксимумСтрокРезультата, 100, 1, 1000);
	Политика.МаксимальнаяДлинаЗапроса = Ограничить(Выборка.МаксимальнаяДлинаЗапроса, 10000, 100, 50000);

	ВыборкаОбъектов = Результаты[1].Выбрать();
	Пока ВыборкаОбъектов.Следующий() Цикл
		ПолноеИмя = СокрЛП(ВыборкаОбъектов.ПолноеИмя);
		Если Не ЗначениеЗаполнено(ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Настройка = Новый Структура(
			"ПолноеИмя,ТребоватьПериод",
			ПолноеИмя,
			ВыборкаОбъектов.ТребоватьПериод);
		Политика.РазрешенныеОбъекты.Вставить(НРег(ПолноеИмя), Настройка);
	КонецЦикла;

	ВыборкаПолей = Результаты[2].Выбрать();
	Пока ВыборкаПолей.Следующий() Цикл
		ПолноеИмяОбъекта = СокрЛП(ВыборкаПолей.ПолноеИмяОбъекта);
		ИмяПоля = СокрЛП(ВыборкаПолей.ИмяПоля);
		Если Не ЗначениеЗаполнено(ПолноеИмяОбъекта) Или Не ЗначениеЗаполнено(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Ограничение = Новый Структура(
			"ПолноеИмяОбъекта,ИмяПоля",
			ПолноеИмяОбъекта,
			ИмяПоля);
		Политика.ОграниченныеПоля.Добавить(Ограничение);
	КонецЦикла;

	Возврат Политика;

КонецФункции

Функция ОбъектРазрешен(Знач Политика, Знач ПолноеИмя) Экспорт

	Возврат Политика.РазрешенныеОбъекты.Получить(НРег(СокрЛП(ПолноеИмя))) <> Неопределено;

КонецФункции

Функция НастройкаОбъекта(Знач Политика, Знач ПолноеИмя) Экспорт

	Возврат Политика.РазрешенныеОбъекты.Получить(НРег(СокрЛП(ПолноеИмя)));

КонецФункции

Функция ДоступныЗапросы(Знач Политика) Экспорт

	Возврат Политика.РазрешитьВыполнениеЗапросов
		И Политика.РазрешенныеОбъекты.Количество() > 0
		И (РольДоступна("AI_АнализДанныхАгентом") Или РольДоступна("AI_ПолныеПрава"));

КонецФункции

Функция ПолитикаПоУмолчанию()

	Политика = Новый Структура;
	Политика.Вставить("Профиль", Справочники.AI_ПрофилиДоступаКДанным.ПустаяСсылка());
	Политика.Вставить("РазрешитьВыполнениеЗапросов", Ложь);
	Политика.Вставить("МаксимумШагов", 6);
	Политика.Вставить("МаксимумЗапросовКДанным", 4);
	Политика.Вставить("МаксимумСтрокРезультата", 100);
	Политика.Вставить("МаксимальнаяДлинаЗапроса", 10000);
	Политика.Вставить("РазрешенныеОбъекты", Новый Соответствие);
	Политика.Вставить("ОграниченныеПоля", Новый Массив);
	Возврат Политика;

КонецФункции

Функция Ограничить(Знач Значение, Знач ПоУмолчанию, Знач Минимум, Знач Максимум)

	Если ТипЗнч(Значение) <> Тип("Число") Или Значение = 0 Тогда
		Значение = ПоУмолчанию;
	КонецЕсли;
	Возврат Макс(Минимум, Мин(Цел(Значение), Максимум));

КонецФункции
