Процедура ТестЖурналированияТокенов(Результаты)

	Попытка
		Фикстуры = ПолучитьФикстуры();
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	СУММА(Журнал.ВходныеТокены) КАК ВходныеТокены,
			|	СУММА(Журнал.ВыходныеТокены) КАК ВыходныеТокены,
			|	СУММА(Журнал.ТулТокены) КАК ТулТокены,
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	РегистрСведений.AI_ЖурналЗапросов КАК Журнал
			|ГДЕ
			|	Журнал.Провайдер = &Провайдер
			|	И Журнал.Период >= &Начало");
		Запрос.УстановитьПараметр("Провайдер", Фикстуры.Провайдер);
		Запрос.УстановитьПараметр("Начало", НачалоДня(ТекущаяДатаСеанса()));
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Проверить(Выборка.Количество = 6,
			"Ожидалось шесть журналируемых модельных операций.");
		Проверить(Выборка.ВходныеТокены = 76
				И Выборка.ВыходныеТокены = 32
				И Выборка.ТулТокены = 18,
			"Журнал содержит неверные итоги токенов одного прогона.");
		ДобавитьРезультат(
			Результаты,
			"token_journal",
			Истина,
			СтрШаблон(
				"Записей: %1, токены: %2 вход / %3 выход / %4 tools.",
				Выборка.Количество,
				Выборка.ВходныеТокены,
				Выборка.ВыходныеТокены,
				Выборка.ТулТокены));
	Исключение
		ДобавитьОшибкуТеста(Результаты, "token_journal");
	КонецПопытки;

