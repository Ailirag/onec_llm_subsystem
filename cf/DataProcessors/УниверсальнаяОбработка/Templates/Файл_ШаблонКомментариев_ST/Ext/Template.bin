{0,
{"компоновщик",0,1,"","ОбработкаОбъект = РеквизитФормыВЗначение(""Объект"");
	СКД = ОбработкаОбъект.ПолучитьМакет(""СправкаРасчет"");
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
	
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(""ДатаВводаОстатков"", Объект.ДатаВводаОстатков);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(""ПодразделениеМХ"", Объект.ПодразделениеМХ);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(""ПодразделениеМХО"", ТиповыеПодразделенияМХ.МХО);
	
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.ПолучитьНастройки());
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить(""РекомендуемыеПеремещения"", ОбработкаОбъект.РекомендуемыеПеремещения);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных);
	
	РезультатОтчета = Новый ТабличныйДокумент;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(РезультатОтчета);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ПоместитьВоВременноеХранилище(РезультатОтчета, АдресХранилища);"}
},
