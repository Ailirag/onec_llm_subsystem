// HTTP-вход исполнителя кода стенда.
//
//  POST /hs/stand-exec/run  — выполнить код, см. ИС_Исполнитель.ВыполнитьКод;
//  GET  /hs/stand-exec/ping — состояние исполнителя, кода не выполняет.
//
// Коды ответа: 200 — запрос обработан (итог выполнения — в поле ok), 400 —
// запрос не разобран, 403 — исполнитель отказал (нет метки стенда или прав).

#Область ОбработчикиСобытий

Функция ВыполнениеВыполнить(Запрос)

	Отказ = ИС_Исполнитель.ПричинаОтказа();
	Если ЗначениеЗаполнено(Отказ) Тогда
		Возврат ОтветJSON(403, Новый Структура("ok, error", Ложь, Отказ));
	КонецЕсли;

	Попытка
		Задание = ИС_Исполнитель.РазобратьЗапрос(
			Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8),
			ЗначениеЗаголовка(Запрос, "Content-Type"),
			Запрос.ПараметрыЗапроса.Получить("mode"));
	Исключение
		Возврат ОтветJSON(400, Новый Структура("ok, error", Ложь,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат ОтветJSON(200, ИС_Исполнитель.ВыполнитьКод(Задание.Код, Задание.Параметры, Задание.Режим));

КонецФункции

Функция СостояниеПолучить(Запрос)

	Возврат ОтветJSON(200, ИС_Исполнитель.Состояние());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имена заголовков клиенты пишут в разном регистре.
Функция ЗначениеЗаголовка(Запрос, Имя)

	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = НРег(Имя) Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ОтветJSON(КодСостояния, Данные)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ИС_Исполнитель.ВJSON(ИС_Исполнитель.ЗначениеДляJSON(Данные)),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

#КонецОбласти
