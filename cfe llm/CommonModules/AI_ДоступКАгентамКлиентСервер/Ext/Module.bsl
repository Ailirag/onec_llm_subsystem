Функция ПолучитьПользователейИнформационнойБазы() Экспорт

	Список = Новый СписокЗначений;
	Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		ДанныеПользователя = Новый Структура(
			"ИдентификаторПользователя,Имя,ПолноеИмя",
			Пользователь.УникальныйИдентификатор,
			Пользователь.Имя,
			Пользователь.ПолноеИмя);
		Представление = Пользователь.ПолноеИмя;
		Если Не ЗначениеЗаполнено(Представление) Тогда
			Представление = Пользователь.Имя;
		ИначеЕсли Представление <> Пользователь.Имя Тогда
			Представление = Представление + " (" + Пользователь.Имя + ")";
		КонецЕсли;
		Список.Добавить(ДанныеПользователя, Представление);
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список;

КонецФункции
