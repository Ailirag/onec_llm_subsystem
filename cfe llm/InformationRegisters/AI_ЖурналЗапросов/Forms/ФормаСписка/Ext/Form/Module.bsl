// Журнал запросов — аудит: записи в нем только смотрят. Пишет журнал подсистема,
// удаляет — очистка по сроку хранения, поэтому команд создания и правки нет.

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьТекущуюЗапись();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьЗаписьОбработка(Команда)
	ОткрытьТекущуюЗапись();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьТекущуюЗапись()
	Ключ = Элементы.Список.ТекущаяСтрока;
	Если Ключ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьФорму("РегистрСведений.AI_ЖурналЗапросов.ФормаЗаписи",
		Новый Структура("Ключ", Ключ), ЭтотОбъект);
КонецПроцедуры

#КонецОбласти
