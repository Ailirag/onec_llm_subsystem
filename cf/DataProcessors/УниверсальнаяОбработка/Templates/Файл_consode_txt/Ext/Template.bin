{"S","ПроверкаТест"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,0cc398cb-3494-43c6-8523-6370069a9284},
{"B",0},
{"S","Функция ПроверкаТест(Фамилия, Имя, Отчество = ""Нету"")

	Возврат Фамилия + ""-"" + Имя + ""-"" + Отчество;

КонецФункции"},0},
{2,30,4,
{"S","ЗакодироватьИменованноеЗначение"},
{"#",fc01b5df-97fe-449b-83d4-218a090e681e,d84a5bb6-9cf7-46c4-b78e-a5023e5d9ed0},
{"B",0},
{"S","Процедура ЗакодироватьИменованноеЗначение(Идентификатор, Значение)
	
	Попытка
		
		НачатьТранзакцию();
		
		ИдентификаторЗначения = Справочники.ИдентификаторыЗначений.НайтиПоКоду(Идентификатор);
		
		Если ИдентификаторЗначения = Справочники.ИдентификаторыЗначений.ПустаяСсылка() Тогда		
			
			ЭлементСправочника = Справочники.ИдентификаторыЗначений.СоздатьЭлемент();
			ЭлементСправочника.Код = Идентификатор;
			ЭлементСправочника.Записать();
			
			ИдентификаторЗначения = ЭлементСправочника.Ссылка; 
			
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.ИменованныеЗначения.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период		 = '19800101';
		МенеджерЗаписи.Идентификатор = ИдентификаторЗначения;
		МенеджерЗаписи.Значение		 = Значение;
		МенеджерЗаписи.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
		
		Сообщить("" - Закодировано именованное значение: "" + Идентификатор + ""."", СтатусСообщения.Информация);
		
	Исключение
		
		ОтменитьТранзакцию();
		Сообщить("" - Ошибка кодировки именованного значения: "" + Идентификатор + ""."", СтатусСообщения.ОченьВажное);
		
	КонецПопытки;
	
КонецПроцедуры"},0}
}
}
},-1,30}
}
