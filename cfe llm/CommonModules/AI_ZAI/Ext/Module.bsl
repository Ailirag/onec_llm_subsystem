
#Область ПрограммныйИнтерфейс

// Выполняет запрос к OpenAI-совместимому Chat Completions API Z.AI.
Функция ПолучитьОтвет(Знач URL, Знач Токен, Знач Модель, Знач Сообщения,
		Знач ДопПараметры = "", Знач ДопЗаголовки = "") Экспорт

	Если Не ЗначениеЗаполнено(URL) Тогда
		URL = БазовыйURL();
	КонецЕсли;

	URL = ?(СтрЗаканчиваетсяНа(URL, "/"), URL, URL + "/") + "chat/completions";

	Параметры = Новый Структура;
	OPI_Инструменты.ДобавитьПоле("model", Модель, "Строка", Параметры);
	OPI_Инструменты.ДобавитьПоле("messages", Сообщения, "Массив", Параметры);
	OPI_Инструменты.ДобавитьПоле("stream", Ложь, "Булево", Параметры);
	ОбработатьПараметры(Параметры, ДопПараметры);

	Если Не ЗначениеЗаполнено(ДопЗаголовки) Тогда
		ДопЗаголовки = Новый Соответствие;
	Иначе
		OPI_ПреобразованиеТипов.ПолучитьКоллекциюКлючИЗначение(
			ДопЗаголовки, "Передана некорректная коллекция дополнительных заголовков.");
	КонецЕсли;

	Если ЗначениеЗаполнено(Токен) Тогда
		ДопЗаголовки.Вставить("Authorization", СтрШаблон("Bearer %1", Токен));
	КонецЕсли;
	ДопЗаголовки.Вставить("Accept-Language", "en-US,en");

	Возврат OPI_ЗапросыHTTP.PostСТелом(URL, Параметры, ДопЗаголовки);

КонецФункции

Функция БазовыйURL() Экспорт
	Возврат "https://api.z.ai/api/paas/v4";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьПараметры(Параметры, Знач ДопПараметры)

	Если Не ЗначениеЗаполнено(ДопПараметры) Тогда
		Возврат;
	КонецЕсли;

	OPI_ПреобразованиеТипов.ПолучитьКоллекциюКлючИЗначение(
		ДопПараметры, "Передана некорректная коллекция дополнительных параметров.");

	Для Каждого ДопПараметр Из ДопПараметры Цикл
		Параметры.Вставить(ДопПараметр.Ключ, ДопПараметр.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
