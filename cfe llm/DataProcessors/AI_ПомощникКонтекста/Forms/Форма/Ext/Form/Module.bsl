#Область СлужебныеПроцедурыИФункции

#КонецОбласти
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбъектыНазначения = Неопределено;
	Параметры.Свойство("ОбъектыНазначения", ОбъектыНазначения);
	ТипМестаИзПараметров = "Объект";
	Параметры.Свойство("ТипМеста", ТипМестаИзПараметров);
	Контекст = AI_ИнтерфейсныеСценарии.СформироватьКонтекст(
		ОбъектыНазначения,
		ТипМестаИзПараметров);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Контекст);
	КонтекстПредставление = Контекст.ПредставлениеИсточника;
	ТаблицаСценариев = AI_ИнтерфейсныеСценарии.ПолучитьДоступныеСценарии(Контекст);
	ЗначениеВРеквизитФормы(ТаблицаСценариев, "Сценарии");
	Если ТаблицаСценариев.Количество() = 0 Тогда
		КонтекстПредставление = КонтекстПредставление
			+ ". Нет доступных сценариев для этого места запуска.";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СценарииПриАктивизацииСтроки(Элемент)
	ОбновитьОписаниеВыбранного();
КонецПроцедуры

&НаКлиенте
Процедура СценарииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьДиалогОбработка(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДиалогОбработка(Команда)

	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите сценарий.");
		Возврат;
	КонецЕсли;
	Контекст = КонтекстФормыНаКлиенте();
	Попытка
		ПараметрыДиалога = ПодготовитьПараметрыДиалогаНаСервере(
			ТекущиеДанные.МестоЗапуска,
			Контекст,
			НачальныйЗапросВыбранного);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	ОткрытьФорму(
		"Обработка.AI_ЧатПоДаннымБазы.Форма.ДиалогСАгентом",
		ПараметрыДиалога,
		ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбычныйДиалогОбработка(Команда)
	ОткрытьФорму(
		"Обработка.AI_ЧатПоДаннымБазы.Форма.ДиалогСАгентом",
		Новый Структура,
		ЭтотОбъект);
КонецПроцедуры

&НаСервере
Функция ПодготовитьПараметрыДиалогаНаСервере(МестоЗапуска, Контекст, НачальныйЗапрос)
	Возврат AI_ИнтерфейсныеСценарии.ПодготовитьПараметрыДиалога(
		МестоЗапуска,
		Контекст,
		НачальныйЗапрос);
КонецФункции

&НаКлиенте
Процедура ОбновитьОписаниеВыбранного()
	ТекущиеДанные = Элементы.Сценарии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОписаниеВыбранного = "";
		НачальныйЗапросВыбранного = "";
	Иначе
		ОписаниеВыбранного = ТекущиеДанные.Описание;
		НачальныйЗапросВыбранного = ТекущиеДанные.НачальныйЗапрос;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция КонтекстФормыНаКлиенте()
	Возврат Новый Структура(
		"ТипМеста,ПолноеИмяМетаданных,ТипИсточника,КлючИсточника,ПредставлениеИсточника,КонтекстJSON,ДанныеКонтекста,КоличествоОбъектов",
		ТипМеста,
		ПолноеИмяМетаданных,
		ТипИсточника,
		КлючИсточника,
		ПредставлениеИсточника,
		КонтекстJSON,
		ДанныеКонтекста,
		0);
КонецФункции
