// Карточка одной агентской операции: что ушло модели, что она прочитала из
// файлов и что ответила. Нужна, чтобы разобрать «модель вернула пусто» без
// журнала запросов: ушел ли файл, что из него прочитано, какой ответ пришел.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Идентификатор = Неопределено;
	Параметры.Свойство("ИдентификаторОперации", Идентификатор);
	Если ТипЗнч(Идентификатор) = Тип("Строка") И ЗначениеЗаполнено(Идентификатор) Тогда
		Идентификатор = Новый УникальныйИдентификатор(Идентификатор);
	КонецЕсли;
	Если ТипЗнч(Идентификатор) <> Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение "Не указана операция.";
	КонецЕсли;

	Описание = AI_ПубличныйAPI.ПолучитьОписаниеОперации(Идентификатор);
	Если Описание = Неопределено Тогда
		ВызватьИсключение "Операция не найдена или недоступна.";
	КонецЕсли;

	ИдентификаторОперации = Идентификатор;
	ЗаполнитьКарточку(Описание);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Текст, прочитанный из файла, длинный — в ячейке таблицы он не поместится.
// Показываем его полем под таблицей для выбранного файла.
&НаКлиенте
Процедура ВложенияПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Вложения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ТекущийРезультатАнализа = "";
		Возврат;
	КонецЕсли;
	ТекущийРезультатАнализа = ?(ЗначениеЗаполнено(ТекущиеДанные.ТекстОшибки),
		"Ошибка: " + ТекущиеДанные.ТекстОшибки + Символы.ПС + Символы.ПС, "")
		+ ТекущиеДанные.РезультатАнализа;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьПерепискуОбработка(Команда)

	Если Строка(ИдентификаторДиалога) = "00000000-0000-0000-0000-000000000000" Тогда
		ПоказатьПредупреждение(, "У операции нет диалога: ее запускали без переписки.");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Обработка.AI_ЧатПоДаннымБазы.Форма.ДиалогСАгентом",
		Новый Структура("ИдентификаторДиалога", ИдентификаторДиалога),
		ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьКарточку(Описание)

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Описание,
		"Статус,ТекущийЭтап,ДатаСоздания,Модель,Агент,Провайдер,Промт,ДанныеКонтекста,"
			+ "Результат,ТекстОшибки,ВходящиеТокены,ВыходящиеТокены,ВходящиеТокеныВложений,"
			+ "ВыходящиеТокеныВложений,КоличествоПопыток,СтатусДоставки,ОшибкаДоставки");
	ОбъектОперации = Описание.Объект;
	Сценарий = ?(ЗначениеЗаполнено(Описание.Сценарий),
		СтрШаблон("%1 (%2)", Описание.Сценарий, Описание.КодСценария), Описание.КодСценария);
	Если ТипЗнч(Описание.ИдентификаторДиалога) = Тип("УникальныйИдентификатор") Тогда
		ИдентификаторДиалога = Описание.ИдентификаторДиалога;
	КонецЕсли;
	Длительность = ПредставлениеДлительности(Описание.ДатаСоздания, Описание.ДатаЗавершения);

	Вложения.Очистить();
	Для Каждого Файл Из Описание.Вложения Цикл
		СтрокаФайла = Вложения.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаФайла, Файл, "ИмяФайла,Статус,ТекстОшибки,Токены");
		СтрокаФайла.МодельАнализа = ?(ЗначениеЗаполнено(Файл.МодельАнализа),
			Строка(Файл.МодельАнализа), "без модели анализа");
		СтрокаФайла.Размер = ПредставлениеРазмера(Файл.РазмерБайт);
		СтрокаФайла.РезультатАнализа = ПредставлениеРазбора(Файл.РезультатАнализа);
	КонецЦикла;
	Если Вложения.Количество() > 0 Тогда
		ТекущийРезультатАнализа = Вложения[0].РезультатАнализа;
	КонецЕсли;

	Шаги.Очистить();
	Для Каждого Шаг Из Описание.Шаги Цикл
		СтрокаШага = Шаги.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаШага, Шаг, "Номер,Инструмент,ДлительностьМс,Аргументы,Результат");
		СтрокаШага.Статус = Строка(Шаг.Статус);
	КонецЦикла;
	Элементы.СтраницаШаги.Видимость = Шаги.Количество() > 0;

	Элементы.ПояснениеФайлов.Заголовок = ?(Вложения.Количество() = 0,
		"Модели не ушло ни одного файла: отвечала она только по тексту запроса и контексту.",
		СтрШаблон("Модели ушло файлов: %1. Выберите файл, чтобы увидеть, что из него прочитано.",
			Вложения.Количество()));

	ЭтаФорма.Заголовок = СтрШаблон("Операция: %1 от %2",
		?(ЗначениеЗаполнено(Описание.Сценарий), Описание.Сценарий, Описание.КодСценария),
		Формат(Описание.ДатаСоздания, "ДЛФ=DT"));
	Элементы.Итог.Заголовок = ИтогОперации(Описание);
	Если Описание.ДанныеОчищены Тогда
		Элементы.Итог.Заголовок = Элементы.Итог.Заголовок
			+ " Тексты запроса и ответа уже очищены по сроку хранения.";
	КонецЕсли;

КонецПроцедуры

// Одна фраза о главном: чем кончилось и сколько файлов ушло.
&НаСервереБезКонтекста
Функция ИтогОперации(Описание)

	Если ЗначениеЗаполнено(Описание.ТекстОшибки) Тогда
		Возврат "Операция завершилась ошибкой — подробности на вкладке «Ответ».";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Описание.Результат) Тогда
		Возврат СтрШаблон("Статус: %1. Ответа пока нет.", Описание.Статус);
	КонецЕсли;
	Если Описание.КоличествоВложений = 0 Тогда
		Возврат "Модель ответила без файлов: если она должна была читать документ, проверьте,"
			+ " нашелся ли файл у объекта.";
	КонецЕсли;
	Возврат СтрШаблон("Модель ответила, прочитав файлов: %1.", Описание.КоличествоВложений);

КонецФункции

// Разбор файла хранится JSON-ом для модели. Человеку нужно другое: получила ли
// модель файл, что она о нем сказала и какой текст из него извлекла.
&НаСервереБезКонтекста
Функция ПредставлениеРазбора(ТекстРазбора)

	Если Не ЗначениеЗаполнено(ТекстРазбора) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстРазбора);
		Разбор = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Возврат ТекстРазбора;
	КонецПопытки;
	Если ТипЗнч(Разбор) <> Тип("Соответствие") Тогда
		Возврат ТекстРазбора;
	КонецЕсли;

	Части = Новый Массив;
	Получен = Разбор.Получить("file_received");
	Если ТипЗнч(Получен) = Тип("Булево") Тогда
		Части.Добавить(?(Получен, "Файл дошел до модели.",
			"Файл до модели не дошел — она отвечала без него."));
	КонецЕсли;
	Кратко = Разбор.Получить("summary");
	Если ЗначениеЗаполнено(Кратко) Тогда
		Части.Добавить("Кратко: " + Кратко);
	КонецЕсли;
	Текст = Разбор.Получить("extracted_text");
	Если ЗначениеЗаполнено(Текст) Тогда
		Части.Добавить("Текст из файла:" + Символы.ПС + Текст);
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат ТекстРазбора;
	КонецЕсли;
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеДлительности(Начало, Окончание)

	Если Не ЗначениеЗаполнено(Окончание) Или Окончание < Начало Тогда
		Возврат "";
	КонецЕсли;
	Секунд = Окончание - Начало;
	Если Секунд < 60 Тогда
		Возврат СтрШаблон("%1 с", Секунд);
	КонецЕсли;
	Возврат СтрШаблон("%1 мин %2 с", Цел(Секунд / 60), Секунд % 60);

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеРазмера(Байт)

	Если Не ЗначениеЗаполнено(Байт) Тогда
		Возврат "";
	КонецЕсли;
	Если Байт < 1024 Тогда
		Возврат СтрШаблон("%1 Б", Байт);
	ИначеЕсли Байт < 1048576 Тогда
		Возврат Формат(Байт / 1024, "ЧДЦ=1") + " КБ";
	КонецЕсли;
	Возврат Формат(Байт / 1048576, "ЧДЦ=1") + " МБ";

КонецФункции

#КонецОбласти
