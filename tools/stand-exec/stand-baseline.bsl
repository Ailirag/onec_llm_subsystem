// Базовая подготовка стенда: то, без чего сценарии в веб-клиенте нестабильны на
// любой конфигурации. Выполняет исполнитель кода стенда (режим none — у каждого
// блока своя запись, отказ одного не откатывает остальные); запускает комплект
// (Invoke-WorkflowStandBaseline), настройки — раздел standBaseline в
// .1c-workflow.json.
//
// Комплект нейтрален к конфигурации, поэтому каждый блок сначала проверяет, есть
// ли в ней то, с чем он работает, и молча пропускается, если нет. Общие модули
// конфигурации вызываются только через Выполнить и только после такой проверки:
// прямой вызов не скомпилировался бы там, где модуля нет, и упал бы весь файл.
//
// Параметры:
//  ТолькоЗадания    - Булево - только блок регламентных заданий: после сида,
//                     который включил функциональные опции, а с ними и задания;
//  ВыключатьЗадания - Булево - выключать ли регламентные задания;
//  ОставитьЗадания  - Массив - имена заданий (метаданных), которые не трогать.
//
// Результат - Массив строк: что сделано, что пропущено и почему.

Протокол = Новый Массив;
Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
	Параметры = Новый Структура;
КонецЕсли;
ТолькоЗадания =Параметры.Свойство("ТолькоЗадания") И Параметры.ТолькоЗадания = Истина;
ВыключатьЗадания = Не Параметры.Свойство("ВыключатьЗадания") Или Параметры.ВыключатьЗадания = Истина;
ОставитьЗадания = Новый Массив;
Если Параметры.Свойство("ОставитьЗадания") И ТипЗнч(Параметры.ОставитьЗадания) = Тип("Массив") Тогда
	ОставитьЗадания = Параметры.ОставитьЗадания;
КонецЕсли;

Если Не ТолькоЗадания Тогда

	// 1. Предопределённые данные. Платформа создаёт недостающие элементы лениво,
	// при первом обращении. Если оно случилось в пробе с откатом, строки
	// откатываются, а кэш процесса веб-сервера помнит выданные ссылки: формы
	// показывают «<Объект не найден>», пока процесс не перезапущен. Поэтому —
	// явно и первым делом. Привилегированный режим: в часть классификаторов
	// добавлять не может даже администратор, их заполняет сама конфигурация.
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ИнициализироватьПредопределенныеДанные();
		УстановитьПривилегированныйРежим(Ложь);
		Протокол.Добавить("предопределённые данные: инициализированы");
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Протокол.Добавить("предопределённые данные: ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 2. БСП: решение по открытию внешних отчётов и обработок. Пока его нет,
	// администратору при входе показывается предупреждение безопасности, и оно
	// перекрывает первый шаг сценария. Решение принимается так же, как кнопкой
	// диалога; роли пользователей не меняются.
	Если Метаданные.ОбщиеМодули.Найти("СтандартныеПодсистемыСервер") <> Неопределено
		И Метаданные.ОбщиеФормы.Найти("ПредупреждениеБезопасности") <> Неопределено Тогда
		Попытка
			Выполнить(
				"ПараметрыАдминистрирования = СтандартныеПодсистемыСервер.ПараметрыАдминистрирования();
				|ПараметрыАдминистрирования.Вставить(""ПринятоРешениеПоОткрытиюВнешнихОтчетовИОбработок"", Истина);
				|СтандартныеПодсистемыСервер.УстановитьПараметрыАдминистрирования(ПараметрыАдминистрирования);
				|ОбновитьПовторноИспользуемыеЗначения();");
			Протокол.Добавить("БСП: решение по внешним отчётам и обработкам принято");
		Исключение
			Протокол.Добавить("БСП, решение по внешним отчётам: ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	Иначе
		Протокол.Добавить("БСП, решение по внешним отчётам: пропущено — нет предупреждения безопасности БСП");
	КонецЕсли;

	// 3. Предложение сервиса «Проверка контрагентов»: всплывает в первой форме с
	// контрагентом. Есть не во всех конфигурациях — только где подключена
	// подсистема проверки контрагентов.
	Если Метаданные.ОбщиеМодули.Найти("ПроверкаКонтрагентовВызовСервера") <> Неопределено Тогда
		Попытка
			Выполнить("ПроверкаКонтрагентовВызовСервера.ЗапомнитьЧтоБольшеНеНужноПоказыватьПредложениеИспользоватьСервис();");
			Протокол.Добавить("проверка контрагентов: предложение сервиса отключено");
		Исключение
			Протокол.Добавить("проверка контрагентов: ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	Иначе
		Протокол.Добавить("проверка контрагентов: пропущено — подсистемы нет");
	КонецЕсли;

	// 4. Новости Интернет-поддержки (БИП). Стенд с выходом в интернет успевает
	// скачать новости о новых версиях, важные всплывают при входе и попадают на
	// снимки. Справочник «Новости» признаётся новостями БИП только вместе с её
	// модулем: одноимённый справочник самой конфигурации не трогается.
	Если Метаданные.Справочники.Найти("Новости") <> Неопределено
		И Метаданные.ОбщиеМодули.Найти("ОбработкаНовостейСлужебный") <> Неопределено Тогда
		Удалено = 0;
		Попытка
			УстановитьПривилегированныйРежим(Истина);
			Выборка = Справочники["Новости"].Выбрать();
			Пока Выборка.Следующий() Цикл
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект = Неопределено Тогда
					Продолжить; // удалена вместе с группой
				КонецЕсли;
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Удалить();
				Удалено = Удалено + 1;
			КонецЦикла;
			УстановитьПривилегированныйРежим(Ложь);
			Протокол.Добавить("новости БИП: удалено " + Удалено);
		Исключение
			УстановитьПривилегированныйРежим(Ложь);
			Протокол.Добавить("новости БИП: ОШИБКА после " + Удалено + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	Иначе
		Протокол.Добавить("новости БИП: пропущено — БИП с новостями нет");
	КонецЕсли;

КонецЕсли;

// 5. Регламентные задания — последним. В файловой базе их выполняет сеанс
// клиента, то есть сеанс веб-клиента теста или сценария: обмены и оповещения
// запускаются посреди шагов, меняют данные и роняют сеанс. Последним — потому что
// блоки выше и сиды включают функциональные опции, а с ними и зависящие задания.
Если ВыключатьЗадания Тогда
	// Имена из настройки сверяются с метаданными: опечатка иначе молча оставила
	// бы задание выключенным. Сравнение дальше — по имени из метаданных, поэтому
	// регистр букв в настройке значения не имеет.
	Исключения = Новый Массив;
	НетВМетаданных = Новый Массив;
	Для Каждого Имя Из ОставитьЗадания Цикл
		ОбъектМетаданных = Метаданные.РегламентныеЗадания.Найти(СокрЛП(Имя));
		Если ОбъектМетаданных = Неопределено Тогда
			НетВМетаданных.Добавить(Имя);
		ИначеЕсли Исключения.Найти(ОбъектМетаданных.Имя) = Неопределено Тогда
			Исключения.Добавить(ОбъектМетаданных.Имя);
		КонецЕсли;
	КонецЦикла;
	Если НетВМетаданных.Количество() > 0 Тогда
		Протокол.Добавить("регламентные задания: в keepScheduledJobs нет таких заданий в метаданных — "
			+ СтрСоединить(НетВМетаданных, ", ") + "; нужно имя объекта метаданных, как в ScheduledJobs/<Имя>.xml");
	КонецЕсли;

	// Задание доставки серверных оповещений БСП включает сама при старте каждого
	// сеанса клиента (СерверныеОповещения): выключенным оно не останется — сеанс
	// теста включит его снова. Работает оно с оповещениями, а не с данными.
	// Подготовка его не трогает и говорит об этом, а не делает вид, что выключила.
	ВключаетКонфигурация = Новый Массив;
	Если Метаданные.ОбщиеМодули.Найти("СерверныеОповещения") <> Неопределено
		И Метаданные.РегламентныеЗадания.Найти("ОтправкаСерверныхОповещенийКлиентам") <> Неопределено Тогда
		ВключаетКонфигурация.Добавить("ОтправкаСерверныхОповещенийКлиентам");
	КонецЕсли;

	Выключено = 0;
	Оставлено = Новый Массив;
	ОставленоВыключенными = Новый Массив;
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
			ИмяЗадания = Задание.Метаданные.Имя;
			Если ВключаетКонфигурация.Найти(ИмяЗадания) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Исключения.Найти(ИмяЗадания) <> Неопределено Тогда
				// Настройка только не даёт выключить задание, но не включает его.
				Если Задание.Использование Тогда
					Если Оставлено.Найти(ИмяЗадания) = Неопределено Тогда
						Оставлено.Добавить(ИмяЗадания);
					КонецЕсли;
				ИначеЕсли ОставленоВыключенными.Найти(ИмяЗадания) = Неопределено Тогда
					ОставленоВыключенными.Добавить(ИмяЗадания);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если Не Задание.Использование Тогда
				Продолжить;
			КонецЕсли;
			Задание.Использование = Ложь;
			Задание.Записать();
			Выключено = Выключено + 1;
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
		Протокол.Добавить("регламентные задания: выключено " + Выключено
			+ ?(Оставлено.Количество() = 0, "", ", оставлены по настройке: " + СтрСоединить(Оставлено, ", ")));
		Если ВключаетКонфигурация.Количество() > 0 Тогда
			Протокол.Добавить("регламентные задания: не выключаются — их включает сама конфигурация при старте сеанса: "
				+ СтрСоединить(ВключаетКонфигурация, ", "));
		КонецЕсли;
		Если ОставленоВыключенными.Количество() > 0 Тогда
			Протокол.Добавить("регламентные задания: в keepScheduledJobs, но на стенде выключены — настройка их не включает: "
				+ СтрСоединить(ОставленоВыключенными, ", "));
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Протокол.Добавить("регламентные задания: ОШИБКА после " + Выключено + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
Иначе
	Протокол.Добавить("регламентные задания: не трогаются — standBaseline.disableScheduledJobs выключен");
КонецЕсли;

Результат = Протокол;
