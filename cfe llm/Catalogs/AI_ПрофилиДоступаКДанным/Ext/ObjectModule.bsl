
Процедура ПередЗаписью(Отказ)

	Если МаксимумШагов = 0 Тогда
		МаксимумШагов = 6;
	КонецЕсли;
	Если МаксимумЗапросовКДанным = 0 Тогда
		МаксимумЗапросовКДанным = 4;
	КонецЕсли;
	Если МаксимумСтрокРезультата = 0 Тогда
		МаксимумСтрокРезультата = 100;
	КонецЕсли;
	Если МаксимальнаяДлинаЗапроса = 0 Тогда
		МаксимальнаяДлинаЗапроса = 10000;
	КонецЕсли;

	Если МаксимумШагов > 20 Тогда
		ВызватьИсключение "Максимум шагов не может превышать 20.";
	КонецЕсли;
	Если МаксимумЗапросовКДанным > 10 Тогда
		ВызватьИсключение "Максимум запросов к данным не может превышать 10.";
	КонецЕсли;
	Если МаксимумСтрокРезультата > 1000 Тогда
		ВызватьИсключение "Максимум строк результата не может превышать 1000.";
	КонецЕсли;
	Если МаксимальнаяДлинаЗапроса > 50000 Тогда
		ВызватьИсключение "Максимальная длина запроса не может превышать 50000.";
	КонецЕсли;

	БелыйСписок = Новый Соответствие;
	Для Каждого СтрокаОбъекта Из РазрешенныеОбъекты Цикл
		СтрокаОбъекта.ПолноеИмя = СокрЛП(СтрокаОбъекта.ПолноеИмя);
		Если Не ЗначениеЗаполнено(СтрокаОбъекта.ПолноеИмя) Тогда
			ВызватьИсключение "В белом списке обнаружена строка без полного имени объекта.";
		КонецЕсли;
		Ключ = НРег(СтрокаОбъекта.ПолноеИмя);
		Если БелыйСписок.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение "Объект повторяется в белом списке: " + СтрокаОбъекта.ПолноеИмя;
		КонецЕсли;
		Если AI_МетаданныеСервер.ПолучитьОбъектМетаданных(СтрокаОбъекта.ПолноеИмя) = Неопределено Тогда
			ВызватьИсключение "Объект метаданных не найден: " + СтрокаОбъекта.ПолноеИмя;
		КонецЕсли;
		БелыйСписок.Вставить(Ключ, Истина);
	КонецЦикла;

	Если РазрешитьВыполнениеЗапросов И БелыйСписок.Количество() = 0 Тогда
		ВызватьИсключение "Для выполнения запросов заполните белый список объектов.";
	КонецЕсли;

	Ограничения = Новый Соответствие;
	Для Каждого СтрокаПоля Из ОграниченныеПоля Цикл
		СтрокаПоля.ПолноеИмяОбъекта = СокрЛП(СтрокаПоля.ПолноеИмяОбъекта);
		СтрокаПоля.ИмяПоля = СокрЛП(СтрокаПоля.ИмяПоля);
		Если Не ЗначениеЗаполнено(СтрокаПоля.ПолноеИмяОбъекта)
				Или Не ЗначениеЗаполнено(СтрокаПоля.ИмяПоля) Тогда
			ВызватьИсключение "В ограничениях полей заполните объект и имя поля.";
		КонецЕсли;
		Если БелыйСписок.Получить(НРег(СтрокаПоля.ПолноеИмяОбъекта)) = Неопределено Тогда
			ВызватьИсключение "Ограничение поля задано для объекта вне белого списка: "
				+ СтрокаПоля.ПолноеИмяОбъекта;
		КонецЕсли;
		Ключ = НРег(СтрокаПоля.ПолноеИмяОбъекта + "." + СтрокаПоля.ИмяПоля);
		Если Ограничения.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение "Ограничение поля повторяется: " + Ключ;
		КонецЕсли;
		Ограничения.Вставить(Ключ, Истина);
	КонецЦикла;

КонецПроцедуры
