{"S","// Помечает все усоды по документу
Ссылка = СсылкаПоНавигации(
""e1cib/data/Документ.ЗаказНаПоставкуТМЦ?ref=bb90bc97e1693b2011eb09f36da0d5d2""
);

Запрос = Новый Запрос;
Запрос.Текст =
	""ВЫБРАТЬ
	|	УстановкаСостоянийОбъектовДанных.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УстановкаСостоянийОбъектовДанных КАК УстановкаСостоянийОбъектовДанных
	|ГДЕ
	|	УстановкаСостоянийОбъектовДанных.СписокОбъектов.ОбъектДанных = &ОбъектДанных"";
Запрос.УстановитьПараметр(""ОбъектДанных"", Ссылка);

Результат = Запрос.Выполнить().Выбрать();

Пока Результат.Следующий() Цикл
	УСОД = Результат.Ссылка.ПолучитьОбъект();
	УСОД.УстановитьПометкуУдаления(Истина);
КонецЦикла;"},0},
