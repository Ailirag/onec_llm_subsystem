
#Область ОписаниеПеременных

// Приватные переменные
Перем _СистемныйПромт;
Перем _Провайдер;
Перем _ПровайдерСтрокой;
Перем _ДанныеПровайдера;
Перем _Модель;
Перем _МодельСтрокой;
Перем _Температура;
Перем _APIКлюч;
Перем _БазовыйURL;
Перем _МаксТокенов;
Перем _ТипAPI;
Перем _ТекстовыйЗапрос;
Перем _FolderID; // Для YandexAI
Перем _РежимДиалога;
Перем _ГлубинаДиалога;
Перем _НуженВебПоиск;
Перем _ДополнительныйКонтекст;
Перем _ДанныеRAG;
Перем _РазмерОкнаКонтекстаВебПоиска;
Перем _URLАдреса;
Перем _АгентскийРежим;
Перем _ПрофильДоступаКДанным;
Перем _ИдентификаторАгентскойОперации;

// Ссылка на агента для логирования (может быть пустой при произвольных вызовах из Песочницы/ЧатПоДаннымБазы)
Перем _Агент;

// Уникальный идентификатор запроса — пишется в журнал, связывает лог с очередью AI_ОчередьЗапросов
Перем _ИДЗапроса;

// Для Responses API: хранит ID последнего ответа сервера для передачи как previous_response_id
// Это позволяет вести диалог без передачи истории сообщениями (нативный механизм Responses API)
Перем _ПредыдущийIDОтвета;

// Экспортные переменные
Перем Ответ Экспорт;
Перем ИзвлеченныйОтвет Экспорт;
Перем СоответствиеФайловИдентификаторам Экспорт;
Перем ИдентификаторДиалога Экспорт;
Перем ВходящиеТокены Экспорт;
Перем ВыходящиеТокены Экспорт;
Перем ТулТокены Экспорт;
Перем ОшибкаОбработки Экспорт;
Перем ИзвлекатьОтветВСтруктуру Экспорт;
Перем ШагиАгента Экспорт;

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция Инициализировать(Знач Провайдер, Знач Модель, Знач ТипAPI, Знач РежимДиалога = Ложь, Знач ГлубинаДиалога = 0) Экспорт
	
	Ответ = Неопределено;
	СоответствиеФайловИдентификаторам = Новый Соответствие;
	ИзвлеченныйОтвет = Неопределено;
	ИдентификаторДиалога = Неопределено;
	ИзвлекатьОтветВСтруктуру = Ложь;
	ВходящиеТокены = 0;
	ВыходящиеТокены = 0;
	ТулТокены = 0;
	ШагиАгента = Новый Массив;
	
	_СистемныйПромт = "";
	_Провайдер = Неопределено;
	_ПровайдерСтрокой = Неопределено;
	_Модель = Неопределено;
	_Температура = 0.9;
	_APIКлюч = Неопределено;
	_БазовыйURL = Неопределено;
	_МаксТокенов = 150000;
	_ТипAPI = Неопределено;
	_ТекстовыйЗапрос = "";
	_РежимДиалога = РежимДиалога;
	_ГлубинаДиалога = ГлубинаДиалога;
	_ДополнительныйКонтекст = Новый Массив;
	_ПредыдущийIDОтвета = "";
	_ДанныеRAG = Неопределено;
	_АгентскийРежим = Ложь;
	_ПрофильДоступаКДанным = Справочники.AI_ПрофилиДоступаКДанным.ПустаяСсылка();
	_ИдентификаторАгентскойОперации = Неопределено;
	_Агент = Справочники.AI_Агенты.ПустаяСсылка();
	_ИДЗапроса = Новый УникальныйИдентификатор;

	_Провайдер = Провайдер;
	_Модель = Модель;
	_ДанныеПровайдера = Справочники.AI_Провайдеры.ВсеДанныеПровайдера(_Провайдер);
	_ТипAPI = ТипAPI;
	_МодельСтрокой = Строка(Модель);
	
	// Финт ушами для поддержки произвольных провайдеров апи которых построен на базовых
	Если ЗначениеЗаполнено(_ДанныеПровайдера.ПровайдерИсточникAPI) Тогда
		_Провайдер = _ДанныеПровайдера.ПровайдерИсточникAPI;
	КонецЕсли;
	
	ИнициализироватьЗначенияСущностей();
	
	Возврат ЭтотОбъект;
	
КонецФункции

Функция ИнициализироватьСистемныйПромт(Знач Агент) Экспорт

	_Агент = Агент;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	AI_Агенты.Ссылка КАК Ссылка,
		|	AI_Агенты.ПометкаУдаления КАК ПометкаУдаления,
		|	AI_Агенты.Наименование КАК Наименование,
		|	AI_Агенты.СистемнаяИнструкция КАК СистемнаяИнструкция,
		|	AI_Агенты.Температура КАК Температура,
		|	AI_Агенты.МаксТокенов КАК МаксТокенов,
		|	AI_Агенты.ИдентификаторДляЛогики КАК ИдентификаторДляЛогики,
		|	AI_Агенты.ОкноКонтекстаВебПоиска КАК ОкноКонтекстаВебПоиска,
		|	AI_Агенты.ИзвлекатьОтветВСтруктуру КАК ИзвлекатьОтветВСтруктуру,
		|	AI_Агенты.НуженВебПоиск КАК НуженВебПоиск,
		|	AI_Агенты.АгентскийРежим КАК АгентскийРежим,
		|	AI_Агенты.ПрофильДоступаКДанным КАК ПрофильДоступаКДанным
		|ИЗ
		|	Справочник.AI_Агенты КАК AI_Агенты
		|ГДЕ
		|	AI_Агенты.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	AI_ПромтыДополнительныйКонтекст.Контекст.ДанныеКонтекста КАК ДанныеКонтекста,
		|	AI_ПромтыДополнительныйКонтекст.Контекст.Наименование КАК Наименование,
		|	AI_ПромтыДополнительныйКонтекст.Контекст.ИдентификаторДляЛогики КАК ИдентификаторДляЛогики
		|ИЗ
		|	Справочник.AI_Агенты.ДополнительныйКонтекст КАК AI_ПромтыДополнительныйКонтекст
		|ГДЕ
		|	AI_ПромтыДополнительныйКонтекст.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	RAGКоллекции.ЛимитФрагментовQdrant КАК ЛимитФрагментовQdrant,
		|	RAGКоллекции.ВесКоллекции КАК ВесКоллекции,
		|	RAGКоллекции.МинПорогСхожестиВектора КАК МинПорогСхожестиВектора,
		|	AI_RAGКоллекции.Ссылка КАК Коллекция,
		|	AI_RAGКоллекции.Владелец КАК КомпонентRAG,
		|	AI_RAGКоллекции.Наименование КАК Наименование,
		|	AI_RAGКоллекции.КоллекцияИнициализирована КАК КоллекцияИнициализирована,
		|	AI_RAGКоллекции.ТипКоллекции КАК ТипКоллекции,
		|	AI_RAG.Наименование КАК КомпонентRAGНаименование,
		|	AI_RAG.Активен КАК КомпонентRAGАктивен,
		|	AI_RAG.EmbeddingURL КАК КомпонентRAGEmbeddingURL,
		|	AI_RAG.EmbeddingМодель КАК КомпонентRAGEmbeddingМодель,
		|	AI_RAG.EmbeddingРазмерность КАК КомпонентRAGEmbeddingРазмерность,
		|	AI_RAG.EmbeddingТаймаутСек КАК КомпонентRAGEmbeddingТаймаутСек,
		|	AI_RAG.QdrantURL КАК КомпонентRAGQdrantURL,
		|	AI_RAG.QdrantТаймаутСек КАК КомпонентRAGQdrantТаймаутСек,
		|	AI_RAG.EmbeddingAPIКлюч КАК КомпонентRAGEmbeddingAPIКлюч,
		|	AI_RAG.QdrantAPIКлюч КАК КомпонентRAGQdrantAPIКлюч
		|ИЗ
		|	Справочник.AI_Агенты.RAGКоллекции КАК RAGКоллекции
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.AI_RAGКоллекции КАК AI_RAGКоллекции
		|		ПО RAGКоллекции.Коллекция = AI_RAGКоллекции.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.AI_RAG КАК AI_RAG
		|		ПО (AI_RAGКоллекции.Владелец = AI_RAG.Ссылка)
		|ГДЕ
		|	RAGКоллекции.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	AI_RAGКоллекции.Владелец,
		|	AI_RAG.Наименование,
		|	AI_RAG.Активен,
		|	AI_RAG.EmbeddingURL,
		|	AI_RAG.EmbeddingМодель,
		|	AI_RAG.EmbeddingРазмерность,
		|	AI_RAG.EmbeddingТаймаутСек,
		|	AI_RAG.QdrantURL,
		|	AI_RAG.QdrantТаймаутСек,
		|	AI_RAG.EmbeddingAPIКлюч,
		|	AI_RAG.QdrantAPIКлюч,
		|	AI_RAGКоллекции.Ссылка,
		|	AI_RAGКоллекции.КоллекцияИнициализирована,
		|	AI_RAGКоллекции.Наименование,
		|	AI_RAGКоллекции.ТипКоллекции,
		|	RAGКоллекции.ЛимитФрагментовQdrant,
		|	RAGКоллекции.ВесКоллекции,
		|	RAGКоллекции.МинПорогСхожестиВектора
		|ИТОГИ ПО
		|	КомпонентRAG
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	AI_АгентыURLДляПоиска.URL КАК URL
		|ИЗ
		|	Справочник.AI_Агенты.URLДляПоиска КАК AI_АгентыURLДляПоиска";
	
	Запрос.УстановитьПараметр("Ссылка", Агент);
	РезультатПакет = Запрос.ВыполнитьПакет();
	
	ДанныеАгента = РезультатПакет[0].Выгрузить()[0];
	ДанныеДопКонтекстов = РезультатПакет[1].Выгрузить();
	ДанныеRAG = РезультатПакет[2];
	ОграниченияURL = РезультатПакет[3].Выгрузить().ВыгрузитьКолонку("URL");
	
	_СистемныйПромт = ДанныеАгента.СистемнаяИнструкция;
	_Температура = ДанныеАгента.Температура;
	_МаксТокенов = ДанныеАгента.МаксТокенов;
	_НуженВебПоиск = ДанныеАгента.НуженВебПоиск;
	_АгентскийРежим = ДанныеАгента.АгентскийРежим;
	_ПрофильДоступаКДанным = ДанныеАгента.ПрофильДоступаКДанным;
	_РазмерОкнаКонтекстаВебПоиска = нрег(ДанныеАгента.ОкноКонтекстаВебПоиска);
	_URLАдреса = ОграниченияURL;
	ИзвлекатьОтветВСтруктуру = ДанныеАгента.ИзвлекатьОтветВСтруктуру;
	
	
	// Дополнительный контекст
	_ДополнительныйКонтекст = Новый Массив;
	Для Каждого Контекст Из ДанныеДопКонтекстов Цикл
		_ДополнительныйКонтекст.Добавить(Контекст);
	КонецЦикла;
	
	// RAG данные
	МассивКомпонентRAG = Новый Массив;
	ДанныеRAGОбход = ДанныеRAG.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ДанныеRAGОбход.Следующий() Цикл
		
		Если НЕ ДанныеRAGОбход.КомпонентRAGАктивен Тогда
			ВызватьИсключение СтрШаблон("Компонент RAG [%1] не активен. Продолжение невозможно.", ДанныеRAGОбход.КомпонентRAGНаименование);
		КонецЕсли;
		
		СтруктураRAG = Новый Структура;
		СтруктураRAG.Вставить("КомпонентRAG", ДанныеRAGОбход.КомпонентRAG);
		СтруктураRAG.Вставить("Наименование", ДанныеRAGОбход.КомпонентRAGНаименование);
		СтруктураRAG.Вставить("Активен", ДанныеRAGОбход.КомпонентRAGАктивен);
		СтруктураRAG.Вставить("EmbeddingURL", ДанныеRAGОбход.КомпонентRAGEmbeddingURL);
		СтруктураRAG.Вставить("EmbeddingМодель", ДанныеRAGОбход.КомпонентRAGEmbeddingМодель);
		СтруктураRAG.Вставить("EmbeddingТаймаутСек", ДанныеRAGОбход.КомпонентRAGEmbeddingТаймаутСек);
		СтруктураRAG.Вставить("QdrantURL", ДанныеRAGОбход.КомпонентRAGQdrantURL);
		СтруктураRAG.Вставить("QdrantТаймаутСек", ДанныеRAGОбход.КомпонентRAGQdrantТаймаутСек);
		СтруктураRAG.Вставить("EmbeddingAPIКлюч", ДанныеRAGОбход.КомпонентRAGEmbeddingAPIКлюч);
		СтруктураRAG.Вставить("QdrantAPIКлюч", ДанныеRAGОбход.КомпонентRAGQdrantAPIКлюч);
		СтруктураRAG.Вставить("EmbeddingРазмерность", ДанныеRAGОбход.КомпонентRAGEmbeddingРазмерность);
		СтруктураRAG.Вставить("МассивКоллекций", Новый Массив);
		
		ВыборкаКоллекций = ДанныеRAGОбход.Выбрать();
		
		Пока ВыборкаКоллекций.Следующий() Цикл
			
			Если НЕ ВыборкаКоллекций.КоллекцияИнициализирована Тогда
				ВызватьИсключение СтрШаблон("Связка RAG [%1] и коллекции [%2] не инициализирована. Воспользуйтесь обработкой AI_RAG", ДанныеRAGОбход.КомпонентRAGНаименование, ВыборкаКоллекций.Наименование);
			КонецЕсли;
			
			СтруктураКоллекции = Новый Структура;
			СтруктураКоллекции.Вставить("ИмяКоллекции", ВыборкаКоллекций.Наименование);
			СтруктураКоллекции.Вставить("ТипКоллекции", ВыборкаКоллекций.ТипКоллекции);
			СтруктураКоллекции.Вставить("ЛимитФрагментовQdrant", ВыборкаКоллекций.ЛимитФрагментовQdrant);
			СтруктураКоллекции.Вставить("ВесКоллекции", ВыборкаКоллекций.ВесКоллекции);
			СтруктураКоллекции.Вставить("МинПорогСхожестиВектора", ВыборкаКоллекций.МинПорогСхожестиВектора);
			
			СтруктураRAG.МассивКоллекций.Добавить(СтруктураКоллекции);
		КонецЦикла;
		
		МассивКомпонентRAG.Добавить(СтруктураRAG);
	КонецЦикла;
	
	_ДанныеRAG = МассивКомпонентRAG;
	
	Возврат ЭтотОбъект;
	
КонецФункции

Функция ИнициализироватьСистемныйПромтПроизвольный(Знач Инструкция, Знач Температура,
		Знач МаксТокенов, Знач ДанныеВебПоиска = Неопределено,
		Знач ДанныеRAG = Неопределено, Знач ДопКонтекст = Неопределено,
		Знач Агент = Неопределено, Знач АгентскийРежим = Неопределено,
		Знач ПрофильДоступаКДанным = Неопределено) Экспорт

	_СистемныйПромт = Инструкция;
	Если Агент <> Неопределено Тогда
		_Агент = Агент;
	КонецЕсли;
	_Температура = Температура;
	_МаксТокенов = МаксТокенов;
	Если АгентскийРежим = Неопределено Тогда
		Если ЗначениеЗаполнено(Агент) Тогда
			_АгентскийРежим = Агент.АгентскийРежим;
		Иначе
			_АгентскийРежим = Ложь;
		КонецЕсли;
	Иначе
		_АгентскийРежим = АгентскийРежим;
	КонецЕсли;
	Если ПрофильДоступаКДанным <> Неопределено Тогда
		_ПрофильДоступаКДанным = ПрофильДоступаКДанным;
	ИначеЕсли ЗначениеЗаполнено(Агент) Тогда
		_ПрофильДоступаКДанным = Агент.ПрофильДоступаКДанным;
	КонецЕсли;
	
	Если Не ДанныеВебПоиска = Неопределено Тогда
		_НуженВебПоиск = ДанныеВебПоиска.ИспользоватьВебПоиск;
		_РазмерОкнаКонтекстаВебПоиска = нрег(ДанныеВебПоиска.РазмерОкнаКонтекстаВебПоиска);
		Если ДанныеВебПоиска.Свойство("URL") Тогда
			_URLАдреса = ДанныеВебПоиска.URL;
		Иначе
			_URLАдреса = Новый Массив;
		КонецЕсли;
	Иначе
		_НуженВебПоиск = Ложь;
		_РазмерОкнаКонтекстаВебПоиска = Неопределено;
		_URLАдреса = Новый Массив;
	КонецЕсли;
	
	_ДанныеRAG = ДанныеRAG;
	
	Если ЗначениеЗаполнено(ДопКонтекст) Тогда
		_ДополнительныйКонтекст = ДопКонтекст;
	КонецЕсли;
	
	Возврат ЭтотОбъект;
	
КонецФункции

// Спросить
// Отправляет текстовый запрос к модели.
// Для ChatCompletions: передаёт историю через массив сообщений.
// Для Responses API: использует нативный механизм previous_response_id для диалога.
// Для OllamaNative: использует нативный API Ollama.
Функция Спросить(Знач ТекстовыйЗапрос) Экспорт
	
	_ТекстовыйЗапрос = ТекстовыйЗапрос;
	ОшибкаОбработки = "";
	
	Если _ТипAPI = Перечисления.AI_ТипAPI.ChatCompletions Тогда
		СпроситьChatCompletions();
	ИначеЕсли _ТипAPI = Перечисления.AI_ТипAPI.Responses Тогда
		СпроситьResponses();
	ИначеЕсли _ТипAPI = Перечисления.AI_ТипAPI.OllamaNative Тогда
		ВызватьИсключение "OllamaNative не поддерживается в методе Спросить. Используйте прямой вызов OPI_Ollama.";
	Иначе
		ВызватьИсключение СтрШаблон("Тип API [%1] не поддерживается.", _ТипAPI);
	КонецЕсли;
	
	Возврат ЭтотОбъект;
	
КонецФункции

// СпроситьСКартинкой
// Загружает файл изображения через Files API нужного провайдера и запрашивает ответ.
// Yandex: добавляет заголовок x-project и использует OPI_YandexAI для загрузки файла.
// OpenAI / Responses: стандартная загрузка через OPI_OpenAI.
// После получения ответа файл удаляется.
Функция СпроситьСКартинкой(Знач ТекстовыйЗапрос, Знач ИмяФайла, Знач ДвоичныеДанные, Знач Назначение = "user_data") Экспорт
	
	// Поддерживаемый тип картинок
	СоставИмениФайла	= СтрРазделить(ИмяФайла, ".", Ложь);
	РасширениеФайла		= СоставИмениФайла[СоставИмениФайла.ВГраница()];
	ПоддерживаемыеТипы	= "png,jpeg,jpg,webp";

	СписокПоддерживаемыхФорматов = СтрРазделить(ПоддерживаемыеТипы, ",", Ложь);
	Если СписокПоддерживаемыхФорматов.Найти(РасширениеФайла) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неподдерживаемый тип файла. Поддерживаемые типы: %1", ПоддерживаемыеТипы);
	КонецЕсли;
	// Конец проверки типа картинки
	
	_ТекстовыйЗапрос = ТекстовыйЗапрос;
	ОшибкаОбработки = "";
	
	ДополнительныеЗаголовки = Новый Соответствие;
	Если _Провайдер = Справочники.AI_Провайдеры.Yandex Тогда
		ДополнительныеЗаголовки.Вставить("OpenAI-Project", _FolderID);
	Иначе
		ДополнительныеЗаголовки.Вставить("x-project", _FolderID);
	КонецЕсли;
	
	Сообщения = Новый Массив;
	Если ЗначениеЗаполнено(_СистемныйПромт) Тогда
		Сообщения.Добавить(OPI_OpenAI.ПолучитьСообщениеСистемы(_СистемныйПромт));
	КонецЕсли;
	
	Если _Провайдер = Справочники.AI_Провайдеры.Yandex Тогда
		
		ДанныеФайла = Base64Строка(ДвоичныеДанные);//ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные);
		ДанныеФайла = СтрЗаменить(ДанныеФайла, Символы.ВК, "");
		ДанныеФайла = СтрЗаменить(ДанныеФайла, Символы.ПС, "");
		ДанныеФайла = СтрЗаменить(ДанныеФайла, " ", "");
		
		СтрокаДляПередачи = СтрШаблон("data:image/%1;base64,%2", РасширениеФайла, ДанныеФайла);
		
		СообщениеКартинки = AI_YandexAI.ПолучитьСтруктуруСообщенияКартинкиBase64("user", СтрокаДляПередачи, _ТекстовыйЗапрос);
		Сообщения.Добавить(СообщениеКартинки);
		
	Иначе
	
		Ответ = OPI_OpenAI.ЗагрузитьФайл(_БазовыйURL, _APIКлюч, ИмяФайла, ДвоичныеДанные, Назначение, ДополнительныеЗаголовки);
		
		ИдентификаторФайла = Ответ["id"];
		Если Не ЗначениеЗаполнено(ИдентификаторФайла) Тогда
			// Попытка с заглавной буквы (ряд провайдеров возвращают "ID")
			ИдентификаторФайла = Ответ["ID"];
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ИдентификаторФайла) Тогда
			ПреобразоватьОтветВСтроку();
			ОшибкаОбработки = "Не удалось получить ID загруженного файла. Ответ сервера: " + Ответ;
			Возврат ЭтотОбъект;
		КонецЕсли;
		
		СоответствиеФайловИдентификаторам.Вставить(ИмяФайла, ИдентификаторФайла);
		
		// Структура сообщения с картинкой одинакова для Yandex и OpenAI (оба используют file_id)
		Сообщение = OPI_OpenAI.ПолучитьСтруктуруСообщенияКартинки("user", ИдентификаторФайла, _ТекстовыйЗапрос);
		Сообщения.Добавить(Сообщение);
		
	КонецЕсли;
	
	ДополнительныеПараметры = ИнициализироватьДополнительныеПараметрыИНавыки();
	
	// Для Yandex Responses при работе с файлами тоже используем Responses-эндпоинт
	Если _ТипAPI = Перечисления.AI_ТипAPI.Responses Тогда
		Ответ = OPI_OpenAI.ПолучитьОтветResponses(_БазовыйURL, _APIКлюч, _МодельСтрокой, Сообщения, ДополнительныеПараметры, ДополнительныеЗаголовки);
		Если ОтветСодержитОшибкуAPI(Ответ) Тогда
			ОшибкаОбработки = ПредставлениеОшибкиAPI(Ответ);
			ИзвлеченныйОтвет = ОшибкаОбработки;
		Иначе
			Попытка
				ИзвлечьОтветResponses();
				ЛогироватьЗапрос();
			Исключение
				ОшибкаОбработки = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
	Иначе
		ВызватьИсключение "Метод работы с файлами доступен только для Responses API.";
	КонецЕсли;
	
	// Удаляем файл после использования
	Попытка
		OPI_OpenAI.УдалитьФайл(_БазовыйURL, _APIКлюч, ИдентификаторФайла);
	Исключение
		// Не критично — игнорируем ошибку удаления
	КонецПопытки;
	
	Попытка
		// Responses API: usage.input_tokens / output_tokens
		ВходящиеТокены = Ответ["usage"]["input_tokens"];
		ВыходящиеТокены = Ответ["usage"]["output_tokens"];
		ТулТокены = Ответ["usage"]["input_tokens_details"]["tool_tokens"]
	Исключение
	КонецПопытки;
	
	ЛогироватьЗапрос();
	
	Возврат ЭтотОбъект;
	
КонецФункции

// Загружает документ в Files API и передает его модели как input_file.
Функция СпроситьСФайлом(Знач ТекстовыйЗапрос, Знач ИмяФайла,
		Знач ДвоичныеДанные, Знач Назначение = "user_data") Экспорт

	_ТекстовыйЗапрос = ТекстовыйЗапрос;
	ОшибкаОбработки = "";
	ИзвлеченныйОтвет = Неопределено;
	ИдентификаторФайла = "";

	Если _ТипAPI <> Перечисления.AI_ТипAPI.Responses Тогда
		ВызватьИсключение
			"Передача документов через Files API доступна только для Responses API.";
	КонецЕсли;

	ЗаголовкиФайлов = Новый Соответствие;
	ЗаголовкиОтвета = Новый Соответствие;
	Если _Провайдер = Справочники.AI_Провайдеры.Yandex Тогда
		ЗаголовкиФайлов.Вставить("OpenAI-Project", _FolderID);
		ЗаголовкиОтвета.Вставить("x-project", _FolderID);
	КонецЕсли;

	Попытка
		ОтветЗагрузки = OPI_OpenAI.ЗагрузитьФайл(
			_БазовыйURL,
			_APIКлюч,
			ИмяФайла,
			ДвоичныеДанные,
			Назначение,
			ЗаголовкиФайлов);
		ИдентификаторФайла = ПолучитьПолеОтветаAPI(ОтветЗагрузки, "id");
		Если Не ЗначениеЗаполнено(ИдентификаторФайла) Тогда
			Ответ = ОтветЗагрузки;
			ВызватьИсключение
				"Провайдер не вернул идентификатор загруженного файла.";
		КонецЕсли;
		СоответствиеФайловИдентификаторам.Вставить(ИмяФайла, ИдентификаторФайла);

		Сообщения = Новый Массив;
		Если ЗначениеЗаполнено(_СистемныйПромт) Тогда
			Сообщения.Добавить(OPI_OpenAI.ПолучитьСообщениеСистемы(_СистемныйПромт));
		КонецЕсли;
		Сообщения.Добавить(OPI_OpenAI.ПолучитьСтруктуруСообщенияФайла(
			"user", ИдентификаторФайла, _ТекстовыйЗапрос));

		ДополнительныеПараметры = ИнициализироватьДополнительныеПараметрыИНавыки();
		Ответ = OPI_OpenAI.ПолучитьОтветResponses(
			_БазовыйURL,
			_APIКлюч,
			_МодельСтрокой,
			Сообщения,
			ДополнительныеПараметры,
			ЗаголовкиОтвета);
		Если ОтветСодержитОшибкуAPI(Ответ) Тогда
			ОшибкаОбработки = ПредставлениеОшибкиAPI(Ответ);
			ИзвлеченныйОтвет = ОшибкаОбработки;
		Иначе
			УчестьТокеныResponses(Ответ);
			ИзвлечьОтветResponses();
			ЛогироватьЗапрос();
		КонецЕсли;
	Исключение
		ОшибкаОбработки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если ЗначениеЗаполнено(ИдентификаторФайла) Тогда
		Попытка
			OPI_OpenAI.УдалитьФайл(
				_БазовыйURL,
				_APIКлюч,
				ИдентификаторФайла,
				ЗаголовкиФайлов);
		Исключение
			// Срок жизни файла ограничен провайдером; ошибка очистки не отменяет ответ.
		КонецПопытки;
	КонецЕсли;

	Возврат ЭтотОбъект;

КонецФункции

// Распознает PDF штатным Yandex Vision OCR и возвращает компактный JSON-контекст
// с текстом и координатами строк. Модель анализа получает этот контекст следующим запросом.
Функция РаспознатьPDFYandexOCR(Знач ИмяФайла, Знач ДвоичныеДанные) Экспорт

	Если _Провайдер <> Справочники.AI_Провайдеры.Yandex Тогда
		ВызватьИсключение "Vision OCR доступен только для провайдера Yandex.";
	КонецЕсли;
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные")
		Или ДвоичныеДанные.Размер() = 0 Тогда
		ВызватьИсключение "Невозможно распознать пустой PDF-файл.";
	КонецЕсли;

	FolderID = _FolderID;
	Если Не ЗначениеЗаполнено(FolderID)
		И СтрНачинаетсяС(НРег(_МодельСтрокой), "gpt://") Тогда
		ЧастиURI = СтрРазделить(Сред(_МодельСтрокой, 7), "/", Ложь);
		Если ЧастиURI.Количество() > 0 Тогда
			FolderID = ЧастиURI[0];
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(FolderID) Тогда
		ВызватьИсключение
			"Для распознавания PDF через Yandex Vision OCR требуется FolderID модели.";
	КонецЕсли;

	ДанныеФайла = Base64Строка(ДвоичныеДанные);
	ДанныеФайла = СтрЗаменить(ДанныеФайла, Символы.ВК, "");
	ДанныеФайла = СтрЗаменить(ДанныеФайла, Символы.ПС, "");
	ДанныеФайла = СтрЗаменить(ДанныеФайла, " ", "");

	Языки = Новый Массив;
	Языки.Добавить("*");
	Параметры = Новый Структура;
	Параметры.Вставить("mimeType", "application/pdf");
	Параметры.Вставить("languageCodes", Языки);
	Параметры.Вставить("model", "page");
	Параметры.Вставить("content", ДанныеФайла);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", СтрШаблон("Api-Key %1", _APIКлюч));
	Заголовки.Вставить("x-folder-id", FolderID);
	Заголовки.Вставить("x-data-logging-enabled", "false");

	Попытка
		ОтветOCR = OPI_ЗапросыHTTP.PostСТелом(
			"https://ai.api.cloud.yandex.net/ocr/v1/recognizeText",
			Параметры,
			Заголовки);
	Исключение
		ВызватьИсключение СтрШаблон(
			"Ошибка обращения к Yandex Vision OCR для файла %1: %2",
			ИмяФайла,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	РезультатOCR = ПолучитьПолеОтветаAPI(ОтветOCR, "result");
	Если РезультатOCR = Неопределено Тогда
		ТекстОшибки = ПолучитьПолеОтветаAPI(ОтветOCR, "message");
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = ПредставлениеОшибкиAPI(ОтветOCR);
		КонецЕсли;
		ВызватьИсключение СтрШаблон(
			"Yandex Vision OCR не распознал файл %1: %2",
			ИмяФайла,
			ТекстОшибки);
	КонецЕсли;

	Возврат СформироватьКонтекстYandexOCR(РезультатOCR);

КонецФункции

Функция ПреобразоватьОтветВСтроку() Экспорт
	
	ПроверкаЗаполненияОтвета();
	Ответ = OPI_Инструменты.JSONСтрокой(Ответ);
	
КонецФункции

Функция ПреобразоватьОтветВСтруктуру() Экспорт
	
	ПроверкаЗаполненияОтвета();
	Ответ = OPI_Инструменты.JsonВСтруктуру(Ответ, Ложь);
	
КонецФункции

Функция ПреобразоватьОтветВСоответствие() Экспорт
	
	ПроверкаЗаполненияОтвета();
	Ответ = OPI_Инструменты.JsonВСтруктуру(Ответ, Истина);
	
КонецФункции

Функция ИзвлечьОтвет(ВСтруктуру = Ложь) Экспорт
	
	// Для Responses API — отдельный метод извлечения
	Если _ТипAPI = Перечисления.AI_ТипAPI.Responses Тогда
		ИзвлечьОтветResponses(ВСтруктуру);
		Возврат ИзвлеченныйОтвет;
	КонецЕсли;
	
	// ChatCompletions: choices[0].message.content
	ПреобразоватьОтветВСоответствие();
	
	ИзвлеченныйОтвет = Ответ["choices"][0]["message"]["content"];
	
	Если Лев(ИзвлеченныйОтвет, 3) = "```" Тогда
		ИзвлеченныйОтвет = Сред(ИзвлеченныйОтвет, 4, СтрДлина(ИзвлеченныйОтвет) - 4 - 3);
	КонецЕсли;
	
	Если ВСтруктуру Тогда
		ИзвлеченныйОтвет = OPI_Инструменты.JsonВСтруктуру(ИзвлеченныйОтвет, Ложь);
	КонецЕсли;
	
	Возврат ИзвлеченныйОтвет;
	
КонецФункции

// СброситьДиалогResponses
// Сбрасывает цепочку диалога для Responses API (обнуляет previous_response_id).
// Вызывать при необходимости начать новый диалог без создания нового экземпляра клиента.
Функция СброситьДиалогResponses() Экспорт
	_ПредыдущийIDОтвета = "";
	ИдентификаторДиалога = Неопределено;
	Возврат ЭтотОбъект;
КонецФункции

// УстановитьПредыдущийIDОтвета
// Восстанавливает ID предыдущего ответа для продолжения диалога в Responses API.
//
// Необходим потому, что объект AI_Клиент создаётся заново при каждом
// серверном вызове формы — _ПредыдущийIDОтвета теряется.
// Форма сохраняет этот ID в реквизите ИдентификаторДиалогаResponseApi
// и передаёт его через этот метод перед вызовом Спросить().
//
// Параметры:
//  ID - Строка - значение поля "id" из предыдущего ответа Responses API
//
// Возвращаемое значение:
//  ОбработкаОбъект.AI_Клиент - этот же объект
Функция УстановитьПредыдущийIDОтвета(Знач ID) Экспорт
	_ПредыдущийIDОтвета = ID;
	// Синхронизируем ИдентификаторДиалога — он виден снаружи и проверяется формой
	ИдентификаторДиалога = ID;
	Возврат ЭтотОбъект;
КонецФункции

// Подменяет автогенерируемый ИДЗапроса на внешний — нужно для связи лога
// с записью AI_ОчередьЗапросов.УникальныйИдентификатор.
Процедура УстановитьИДЗапроса(Знач ИД) Экспорт
	_ИДЗапроса = ИД;
КонецПроцедуры

