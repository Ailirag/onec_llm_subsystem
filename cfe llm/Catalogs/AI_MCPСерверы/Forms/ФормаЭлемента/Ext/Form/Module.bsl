#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Активен = Истина;
		Объект.ТаймаутСекунд = 60;
		Объект.МаксимальныйРазмерОтветаБайт = 5242880;
		Объект.ТипАвторизации = Перечисления.AI_ТипАвторизацииMCP.Нет;
	КонецЕсли;
	СекретАвторизации = "";

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	Если ЗначениеЗаполнено(СекретАвторизации) Тогда
		AI_MCPСекреты.Записать(ТекущийОбъект.Ссылка, СекретАвторизации);
		СекретАвторизации = "";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

// Проверка пишет статус в карточку отдельной записью, поэтому форму нужно
// перечитать: иначе на экране останется прежний статус, а следующая запись
// формы вернет его обратно.
&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	Если Модифицированность И Не Записать() Тогда
		Возврат;
	КонецЕсли;
	Результат = ПроверитьПодключениеНаСервере();
	Прочитать();
	Если Результат.ok Тогда
		Сообщить("Подключение к MCP-серверу установлено. Версия протокола: "
			+ Результат.protocolVersion);
	Иначе
		Сообщить("Ошибка подключения MCP: " + Результат.error, СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьИнструменты(Команда)

	Если Модифицированность И Не Записать() Тогда
		Возврат;
	КонецЕсли;
	Результат = СинхронизироватьИнструментыНаСервере();
	Прочитать();
	Если Результат.ok Тогда
		Сообщить(СтрШаблон(
			"Загружено инструментов: %1, совместимых: %2.",
			Результат.total,
			Результат.compatible));
	Иначе
		Сообщить("Ошибка синхронизации MCP: " + Результат.error, СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьПодключениеНаСервере()

	Возврат AI_MCPРеестрИнструментов.ПроверитьПодключение(Объект.Ссылка);

КонецФункции

&НаСервере
Функция СинхронизироватьИнструментыНаСервере()

	Возврат AI_MCPРеестрИнструментов.Синхронизировать(Объект.Ссылка);

КонецФункции

#КонецОбласти
