// Монитор своих агентских операций: что запускалось, по какому объекту, с
// какими файлами, чем закончилось. Двойной клик по операции или по ошибке
// доставки открывает карточку операции с запросом, вложениями и ответом модели.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Решение = "Принято";
	ОбновитьДанныеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокОперацийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьКарточкуТекущейОперации();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОшибокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьКарточкуТекущейОперации();
КонецПроцедуры

// Кнопки работают со строкой списка на текущей вкладке: «Операции» или
// «Ошибки доставки». На «Статистике» строк операций нет — прячем их.
&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	ЕстьОперации = (ТекущаяСтраница <> Элементы.Статистика);
	Элементы.КнопкаОткрытьОперацию.Видимость = ЕстьОперации;
	Элементы.КнопкаПовторитьДоставку.Видимость = ЕстьОперации;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьДанные(Команда)
	ОбновитьДанныеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОперацию(Команда)
	ОткрытьКарточкуТекущейОперации();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОценку(Команда)
	ТекущиеДанные = Элементы.СписокОпераций.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите завершенную операцию.");
		Возврат;
	КонецЕсли;
	ЗаписатьОценкуНаСервере(ТекущиеДанные.ИдентификаторОперации);
	Комментарий = "";
	ИсправленныйОтвет = "";
	Сообщить("Оценка сохранена.");
КонецПроцедуры

&НаКлиенте
Процедура ПовторитьДоставку(Команда)
	ИдентификаторОперации = ИдентификаторТекущейОперации();
	Если ИдентификаторОперации = Неопределено Тогда
		Сообщить("Выберите операцию с ошибкой доставки.");
		Возврат;
	КонецЕсли;
	ПовторитьДоставкуНаСервере(ИдентификаторОперации);
	ОбновитьДанныеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьКарточкуТекущейОперации()
	ИдентификаторОперации = ИдентификаторТекущейОперации();
	Если ИдентификаторОперации = Неопределено Тогда
		Сообщить("Выберите операцию.");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Обработка.AI_МониторАгентскихОпераций.Форма.ФормаОперации",
		Новый Структура("ИдентификаторОперации", ИдентификаторОперации),
		ЭтотОбъект,
		ИдентификаторОперации);
КонецПроцедуры

// Операция строки, выбранной на текущей вкладке: в списке операций или в
// таблице ошибок доставки.
&НаКлиенте
Функция ИдентификаторТекущейОперации()
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.Ошибки Тогда
		ТекущиеДанные = Элементы.ТаблицаОшибок.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.СписокОпераций.ТекущиеДанные;
	КонецЕсли;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ТекущиеДанные.ИдентификаторОперации;
КонецФункции

&НаСервере
Процедура ОбновитьДанныеНаСервере()
	ЗаполнитьТаблицуИзКоллекции("СписокОпераций", AI_ПубличныйAPI.ПолучитьПоследниеОперации());
	ЗаполнитьТаблицуИзКоллекции("ТаблицаСтатистики", AI_ПубличныйAPI.ПолучитьСтатистику());
	ЗаполнитьТаблицуИзКоллекции("ТаблицаОшибок", AI_ПубличныйAPI.ПолучитьОшибкиДоставки());
КонецПроцедуры

// Колонки реквизита формы и источника совпадают не полностью: заполняется то,
// что есть в обоих, поэтому новые поля источника форму не ломают.
&НаСервере
Процедура ЗаполнитьТаблицуИзКоллекции(ИмяРеквизита, Данные)
	Таблица = РеквизитФормыВЗначение(ИмяРеквизита);
	Таблица.Очистить();
	Для Каждого ЭлементДанных Из Данные Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементДанных);
	КонецЦикла;
	ЗначениеВРеквизитФормы(Таблица, ИмяРеквизита);
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОценкуНаСервере(ИдентификаторОперации)
	AI_ПубличныйAPI.ОценитьРезультат(ИдентификаторОперации, Решение, Комментарий, ИсправленныйОтвет);
КонецПроцедуры

&НаСервере
Процедура ПовторитьДоставкуНаСервере(ИдентификаторОперации)
	AI_ПубличныйAPI.ПовторитьДоставку(ИдентификаторОперации);
КонецПроцедуры

#КонецОбласти
