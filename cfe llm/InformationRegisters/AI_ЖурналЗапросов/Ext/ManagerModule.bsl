
#Область ПрограммныйИнтерфейс

Процедура ЛогироватьЗапрос(Агент, ИДЗапроса, Провайдер, Модель, СистемныйПромт,
                          ТекстЗапроса, ТекстОтвета,
                          ВходныеТокены, ВыходныеТокены, ТулТокены) Экспорт

	МенеджерЗаписи = РегистрыСведений.AI_ЖурналЗапросов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период          = ТекущаяДатаСеанса();
	МенеджерЗаписи.Пользователь    = ПользователиИнформационнойБазы.ТекущийПользователь();
	МенеджерЗаписи.Провайдер       = Провайдер;
	МенеджерЗаписи.Модель          = Модель;
	МенеджерЗаписи.Агент           = Агент;
	МенеджерЗаписи.ИДЗапроса       = ИДЗапроса;
	МенеджерЗаписи.СистемныйПромт  = СистемныйПромт;
	МенеджерЗаписи.ТекстЗапроса    = ТекстЗапроса;
	МенеджерЗаписи.ТекстОтвета     = ТекстОтвета;
	МенеджерЗаписи.ВходныеТокены   = ВходныеТокены;
	МенеджерЗаписи.ВыходныеТокены  = ВыходныеТокены;
	МенеджерЗаписи.ТулТокены       = ТулТокены;

	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

