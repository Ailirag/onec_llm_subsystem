
#Область ПрограммныйИнтерфейс

Функция ВсеДанныеПровайдера(Провайдер) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	AI_Провайдеры.Ссылка КАК Ссылка,
		|	AI_Провайдеры.Наименование КАК Наименование,
		|	AI_Провайдеры.Активен КАК Активен,
		|	AI_Провайдеры.APIКлюч КАК APIКлюч,
		|	AI_Провайдеры.ПровайдерИсточникAPI КАК ПровайдерИсточникAPI,
		|	AI_Провайдеры.МодельАнализаВложений КАК МодельАнализаВложений,
		|	AI_Провайдеры.МаксКоличествоПотоков КАК МаксКоличествоПотоков,
		|	AI_Провайдеры.ЛимитRPM КАК ЛимитRPM
		|ИЗ
		|	Справочник.AI_Провайдеры КАК AI_Провайдеры
		|ГДЕ
		|	AI_Провайдеры.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	AI_ПровайдерыАдресаСервисов.БазовыйURL КАК БазовыйURL,
		|	AI_ПровайдерыАдресаСервисов.Тип КАК Тип
		|ИЗ
		|	Справочник.AI_Провайдеры.АдресаСервисов КАК AI_ПровайдерыАдресаСервисов
		|ГДЕ
		|	AI_ПровайдерыАдресаСервисов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Провайдер);
	
	РезультатПакет = Запрос.ВыполнитьПакет();
	ДанныеПровайдера = РезультатПакет[0].Выбрать();
	ДанныеURL = РезультатПакет[1].Выбрать();
	
	ИтоговаяСтруктура = Новый Структура;
	
	Если ДанныеПровайдера.Следующий() Тогда
		ИтоговаяСтруктура.Вставить("Ссылка", ДанныеПровайдера.Ссылка);
		ИтоговаяСтруктура.Вставить("Активен", ДанныеПровайдера.Активен);
		ИтоговаяСтруктура.Вставить("APIКлюч", ДанныеПровайдера.APIКлюч.Получить());
		ИтоговаяСтруктура.Вставить("МаксКоличествоПотоков", ДанныеПровайдера.МаксКоличествоПотоков);
		ИтоговаяСтруктура.Вставить("ЛимитRPM", ДанныеПровайдера.ЛимитRPM);
		ИтоговаяСтруктура.Вставить("ПровайдерИсточникAPI", ДанныеПровайдера.ПровайдерИсточникAPI);
		ИтоговаяСтруктура.Вставить("МодельАнализаВложений", ДанныеПровайдера.МодельАнализаВложений);
		ИтоговаяСтруктура.Вставить("АдресаСервисов", Новый Соответствие);
	КонецЕсли;
	
	Пока ДанныеURL.Следующий() Цикл
		ИтоговаяСтруктура.АдресаСервисов.Вставить(ДанныеURL.Тип, ДанныеURL.БазовыйURL);
	КонецЦикла;
	
	Возврат ИтоговаяСтруктура;
	
КонецФункции

Функция ТипПоддерживается(Знач Провайдер, ТипАпи) Экспорт
	Если ТипЗнч(Провайдер) = Тип("СправочникСсылка.AI_Провайдеры") Тогда
		СтруктураДанныхПровайдера = ВсеДанныеПровайдера(Провайдер);
	Иначе
		СтруктураДанныхПровайдера = Провайдер;
	КонецЕсли;
	СсылкаПровайдера = Неопределено;
	СтруктураДанныхПровайдера.Свойство("Ссылка", СсылкаПровайдера);
	Если СсылкаПровайдера = Справочники.AI_Провайдеры.ZAI Тогда
		Возврат ТипАпи = Перечисления.AI_ТипAPI.ChatCompletions;
	КонецЕсли;
	Возврат НЕ СтруктураДанныхПровайдера.АдресаСервисов.Получить(ТипАпи) = Неопределено;
КонецФункции

#КонецОбласти

#Область СинхронизацияМоделей

// Загружает доступные модели и обновляет подчиненный справочник AI_Модели.
// Отсутствующие в ответе модели не удаляются.
Функция ЗагрузитьДоступныеМодели(Провайдер) Экспорт

	ДоступныеМодели = ПолучитьДоступныеМодели(Провайдер);
	Результат = ЗаписатьМодели(Провайдер, ДоступныеМодели.Модели);
	Результат.Вставить("Источник", ДоступныеМодели.Источник);
	Результат.Вставить("Получено", ДоступныеМодели.Модели.Количество());

	Возврат Результат;

КонецФункции

// Возвращает описания моделей провайдера без записи в справочник AI_Модели.
Функция ПолучитьДоступныеМодели(Провайдер) Экспорт

	Если Не ЗначениеЗаполнено(Провайдер) Тогда
		ВызватьИсключение "Не указан провайдер для загрузки моделей.";
	КонецЕсли;

	Если Провайдер = Справочники.AI_Провайдеры.ZAI Тогда
		Модели = ПолучитьМоделиZAI();
		Источник = "каталог Z.AI";
	Иначе
		Модели = ПолучитьМоделиЧерезAPI(Провайдер);
		Если Провайдер = Справочники.AI_Провайдеры.Yandex Тогда
			ДополнитьИзвестныеМоделиYandex(Модели);
		КонецЕсли;
		Источник = "API провайдера";
	КонецЕсли;

	Возврат Новый Структура("Модели,Источник", Модели, Источник);

КонецФункции

// Создает или обновляет только модели с переданными кодами API.
Функция ЗагрузитьВыбранныеМодели(Провайдер, КодыМоделей) Экспорт

	Если ТипЗнч(КодыМоделей) <> Тип("Массив")
			Или КодыМоделей.Количество() = 0 Тогда
		ВызватьИсключение "Не выбрана ни одна модель для загрузки.";
	КонецЕсли;

	ОтборКодов = Новый Соответствие;
	УникальныеКоды = Новый Массив;
	Для Каждого КодМодели Из КодыМоделей Цикл
		Если ЗначениеЗаполнено(КодМодели) Тогда
			КлючКода = НРег(Строка(КодМодели));
			Если ОтборКодов.Получить(КлючКода) = Неопределено Тогда
				ОтборКодов.Вставить(КлючКода, Истина);
				УникальныеКоды.Добавить(Строка(КодМодели));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если Провайдер = Справочники.AI_Провайдеры.ZAI Тогда
		ДоступныеМодели = Новый Структура(
			"Модели,Источник",
			ПолучитьМоделиZAI(),
			"каталог Z.AI");
	Иначе
		Модели = Новый Массив;
		Для Каждого КодМодели Из УникальныеКоды Цикл
			ДобавитьОписаниеМодели(
				Модели,
				КодМодели,
				"Модель, доступная через API провайдера " + Строка(Провайдер) + ".",
				"",
				Ложь,
				ЭтоМультимодальнаяМодельYandex(Провайдер, КодМодели));
		КонецЦикла;
		ДоступныеМодели = Новый Структура(
			"Модели,Источник",
			Модели,
			"API провайдера");
	КонецЕсли;

	ВыбранныеМодели = Новый Массив;
	Для Каждого ОписаниеМодели Из ДоступныеМодели.Модели Цикл
		Если ОтборКодов.Получить(НРег(ОписаниеМодели.КодAPI)) = Истина Тогда
			ВыбранныеМодели.Добавить(ОписаниеМодели);
		КонецЕсли;
	КонецЦикла;

	Если ВыбранныеМодели.Количество() = 0 Тогда
		ВызватьИсключение "Выбранные модели отсутствуют в актуальном списке провайдера.";
	КонецЕсли;

	Результат = ЗаписатьМодели(Провайдер, ВыбранныеМодели);
	Результат.Вставить("Источник", ДоступныеМодели.Источник);
	Результат.Вставить("Получено", ВыбранныеМодели.Количество());

	Возврат Результат;

КонецФункции

Функция БазовыйURLZAI() Экспорт
	Возврат AI_ZAI.БазовыйURL();
КонецФункции

// Возвращает настроенную модель анализа, выполняя мягкую миграцию для Yandex.
Функция ОбеспечитьМодельАнализаВложений(Провайдер) Экспорт

	Если Не ЗначениеЗаполнено(Провайдер) Тогда
		Возврат Справочники.AI_Модели.ПустаяСсылка();
	КонецЕсли;
	ОбъектПровайдера = Провайдер.ПолучитьОбъект();
	Если ЗначениеЗаполнено(ОбъектПровайдера.МодельАнализаВложений) Тогда
		ЗаписатьВозможностьАнализаИзображений(
			ОбъектПровайдера.МодельАнализаВложений);
		Если ЭтоМодельQwenДляАнализа(ОбъектПровайдера.МодельАнализаВложений) Тогда
			ЗаписатьВозможностьАнализаФайлов(
				ОбъектПровайдера.МодельАнализаВложений);
		КонецЕсли;
		Возврат ОбъектПровайдера.МодельАнализаВложений;
	КонецЕсли;
	Если Провайдер <> Справочники.AI_Провайдеры.Yandex Тогда
		Возврат Справочники.AI_Модели.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|  Модели.Ссылка КАК Ссылка,
		|  Модели.Наименование КАК Наименование,
		|  Модели.FolderID КАК FolderID
		|ИЗ
		|  Справочник.AI_Модели КАК Модели
		|ГДЕ
		|  Модели.Владелец = &Провайдер
		|  И НЕ Модели.ПометкаУдаления";
	Запрос.УстановитьПараметр("Провайдер", Провайдер);
	Выборка = Запрос.Выполнить().Выбрать();
	МодельАнализа = Справочники.AI_Модели.ПустаяСсылка();
	FolderID = "";
	Пока Выборка.Следующий() Цикл
		Если СтрНайти(НРег(Выборка.Наименование), "qwen3.6-35b-a3b") > 0 Тогда
			МодельАнализа = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(FolderID) Тогда
			FolderID = Строка(Выборка.FolderID);
			Если Не ЗначениеЗаполнено(FolderID) Тогда
				FolderID = ИзвлечьFolderIDИзURI(Выборка.Наименование);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(МодельАнализа)
		И ЗначениеЗаполнено(FolderID) Тогда
		ОбъектМодели = Справочники.AI_Модели.СоздатьЭлемент();
		ОбъектМодели.Владелец = Провайдер;
		ОбъектМодели.Наименование = "qwen3.6-35b-a3b";
		ОбъектМодели.FolderID = FolderID;
		ОбъектМодели.Описание =
			"Мультимодальная модель Yandex Model Gallery для анализа изображений и документов.";
		ОбъектМодели.ИдентификаторДляЛогики = "YANDEX_QWEN_3_6_35B_A3B";
		ОбъектМодели.Записать();
		МодельАнализа = ОбъектМодели.Ссылка;
	КонецЕсли;

	Если ЗначениеЗаполнено(МодельАнализа) Тогда
		ЗаписатьВозможностьАнализаИзображений(МодельАнализа);
		ЗаписатьВозможностьАнализаФайлов(МодельАнализа);
		ОбъектПровайдера.МодельАнализаВложений = МодельАнализа;
		ОбъектПровайдера.Записать();
	КонецЕсли;
	Возврат МодельАнализа;

КонецФункции

Функция ИзвлечьFolderIDИзURI(URI)

	URI = Строка(URI);
	Если Не СтрНачинаетсяС(НРег(URI), "gpt://") Тогда
		Возврат "";
	КонецЕсли;
	ЧастиURI = СтрРазделить(Сред(URI, 7), "/", Ложь);
	Если ЧастиURI.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ЧастиURI[0];

КонецФункции

Функция ПолучитьМоделиЧерезAPI(Провайдер)

	ДанныеПровайдера = ВсеДанныеПровайдера(Провайдер);
	БазовыйURL = ДанныеПровайдера.АдресаСервисов.Получить(
		Перечисления.AI_ТипAPI.ChatCompletions);

	Если Не ЗначениеЗаполнено(БазовыйURL) Тогда
		ВызватьИсключение "Для провайдера не заполнен базовый URL Chat Completions.";
	КонецЕсли;

	Ответ = OPI_OpenAI.ПолучитьСписокМоделей(
		БазовыйURL, ДанныеПровайдера.APIКлюч);

	ОшибкаAPI = OPI_Инструменты.ПолучитьИли(Ответ, "error", Неопределено);
	Если ЗначениеЗаполнено(ОшибкаAPI) Тогда
		ВызватьИсключение "API провайдера вернул ошибку: "
			+ OPI_Инструменты.JSONСтрокой(ОшибкаAPI);
	КонецЕсли;

	ДанныеМоделей = OPI_Инструменты.ПолучитьИли(Ответ, "data", Неопределено);
	Если ТипЗнч(ДанныеМоделей) <> Тип("Массив") Тогда
		ВызватьИсключение "Ответ API не содержит массив data со списком моделей.";
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого ДанныеМодели Из ДанныеМоделей Цикл
		КодМодели = OPI_Инструменты.ПолучитьИли(ДанныеМодели, "id", "");
		Если ЗначениеЗаполнено(КодМодели) Тогда
			ДобавитьОписаниеМодели(
				Результат,
				КодМодели,
				"Модель, доступная через API провайдера " + Строка(Провайдер) + ".",
				"",
				Ложь,
				ЭтоМультимодальнаяМодельYandex(Провайдер, КодМодели));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

