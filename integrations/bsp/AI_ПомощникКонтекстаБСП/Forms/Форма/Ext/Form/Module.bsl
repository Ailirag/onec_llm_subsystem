#КонецОбласти
&НаКлиенте
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначенияМассив) Экспорт

	Если ИдентификаторКоманды <> "ОткрытьAIПомощник" Тогда
		Возврат;
	КонецЕсли;
	// При виде «ЗаполнениеОбъекта» БСП открывает форму обработки, передавая
	// форму объекта владельцем. Пробрасываем ее дальше: помощник заполняет
	// реквизиты прямо в ней, а записывает объект пользователь.
	//
	AI_ИнтерфейсныеСценарииКлиент.ОткрытьПомощник(
		ОбъектыНазначенияМассив,
		"Объект",
		ВладелецФормы);

	// Из списка БСП сначала показывает свое окно «Команды заполнения
	// объектов». Владельцем обработки оно передает форму списка, а само после
	// клиентской команды остается открытым — и висит под помощником и после
	// его закрытия. Закрываем именно то окно, из которого запущены.
	ЗакрытьОкноКомандБСП(ВладелецФормы);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьОкноКомандБСП(ФормаСписка)

	Если ФормаСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Окна = ПолучитьОкна();
	Исключение
		Возврат;
	КонецПопытки;
	Если Окна = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// «Окно» в модуле формы — свойство самой формы, поэтому переменные
	// названы иначе: присваивание в «Окно» падает.
	Для Каждого ОкноПриложения Из Окна Цикл
		Попытка
			Содержимое = ОкноПриложения.Содержимое;
		Исключение
			Продолжить;
		КонецПопытки;
		Для Каждого ОткрытаяФорма Из Содержимое Цикл
			Если ЭтоОкноКомандБСП(ОткрытаяФорма)
				И ОткрытаяФорма.ВладелецФормы = ФормаСписка
				И ОткрытаяФорма.Открыта() Тогда
				ОткрытаяФорма.Закрыть();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ЭтоОкноКомандБСП(Форма)

	Если Форма = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат Форма.ИмяФормы = "ОбщаяФорма.ДополнительныеОтчетыИОбработки";
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции
